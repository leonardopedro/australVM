  $ wi ph (wcel (co (co P C c_x) (co M A2 c_x) (cfv G cplusg)) W) $ >
  $ wceq D (co C (co (co M P cdiv) A2 c_x) (cfv G cplusg)) $ >
  $ wi ph (wrex t (wa (wceq (cin S (cv t)) (csn c_0)) (wceq (co S (cv t) c_po) U)) (cfv G csubg)) $;

--| Lemma for ~ pgpfac1 . (Contributed by Mario Carneiro, 27-Apr-2016.)
theorem pgpfac1lem4 {w t: setvar} (ph: wff) (A2: class) (B2: class w) (C P c_po S c_x U: class) (E: class w t) (G K: class) (O: class w t) (W: class) (c_0: class w):
  $ wceq K (cfv (cfv G csubg) cmrc) $ >
  $ wceq S (cfv (csn A2) K) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wceq O (cfv G cod) $ >
  $ wceq E (cfv G cgex) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wceq c_po (cfv G clsm) $ >
  $ wi ph (wbr P G cpgp) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wceq (cfv A2 O) E) $ >
  $ wi ph (wcel U (cfv G csubg)) $ >
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel W (cfv G csubg)) $ >
  $ wi ph (wceq (cin S W) (csn c_0)) $ >
  $ wi ph (wss (co S W c_po) U) $ >
  $ wi ph (wral w (wi (wa (wpss (cv w) U) (wcel A2 (cv w))) (wn (wpss (co S W c_po) (cv w)))) (cfv G csubg)) $ >
  $ wi ph (wcel C (cdif U (co S W c_po))) $ >
  $ wceq c_x (cfv G cmg) $ >
  $ wi ph (wrex t (wa (wceq (cin S (cv t)) (csn c_0)) (wceq (co S (cv t) c_po) U)) (cfv G csubg)) $;

--| Lemma for ~ pgpfac1 . (Contributed by Mario Carneiro, 27-Apr-2016.)
theorem pgpfac1lem5 {t s1: setvar} (ph: wff) (A2 B2 P c_po S U: class) (E: class t s1) (G K: class) (O: class t s1) (c_0: class):
  $ wceq K (cfv (cfv G csubg) cmrc) $ >
  $ wceq S (cfv (csn A2) K) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wceq O (cfv G cod) $ >
  $ wceq E (cfv G cgex) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wceq c_po (cfv G clsm) $ >
  $ wi ph (wbr P G cpgp) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wceq (cfv A2 O) E) $ >
  $ wi ph (wcel U (cfv G csubg)) $ >
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wral s1 (wi (wa (wpss (cv s1) U) (wcel A2 (cv s1))) (wrex t (wa (wceq (cin S (cv t)) (csn c_0)) (wceq (co S (cv t) c_po) (cv s1))) (cfv G csubg))) (cfv G csubg)) $ >
  $ wi ph (wrex t (wa (wceq (cin S (cv t)) (csn c_0)) (wceq (co S (cv t) c_po) U)) (cfv G csubg)) $;

--| Factorization of a finite abelian p-group. There is a direct product decomposition of any abelian group of prime-power order where one of the factors is cyclic and generated by an element of maximal order. (Contributed by Mario Carneiro, 27-Apr-2016.)
theorem pgpfac1 {t: setvar} (ph: wff) (A2 B2 P c_po S: class) (E: class t) (G K: class) (O: class t) (c_0: class):
  $ wceq K (cfv (cfv G csubg) cmrc) $ >
  $ wceq S (cfv (csn A2) K) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wceq O (cfv G cod) $ >
  $ wceq E (cfv G cgex) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wceq c_po (cfv G clsm) $ >
  $ wi ph (wbr P G cpgp) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wceq (cfv A2 O) E) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wrex t (wa (wceq (cin S (cv t)) (csn c_0)) (wceq (co S (cv t) c_po) B2)) (cfv G csubg)) $;

--| Lemma for ~ pgpfac . (Contributed by Mario Carneiro, 27-Apr-2016.) (Revised by Mario Carneiro, 3-May-2016.)
theorem pgpfaclem1 {t s1 r: setvar} (ph: wff s1 r) (B2 C: class r) (P c_po S: class t s1 r) (T: class t r) (U: class) (E: class t s1 r) (G: class) (H: class t s1 r) (K: class t) (O: class t s1 r) (W: class r) (X: class t) (c_0: class t s1 r):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq C (crab r (wcel (co G (cv r) cress) (cin ccyg (crn cpgp))) (cfv G csubg)) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wbr P G cpgp) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wcel U (cfv G csubg)) $ >
  $ wi ph (wral t (wi (wpss (cv t) U) (wrex s1 (wa (wbr G (cv s1) (cdm cdprd)) (wceq (co G (cv s1) cdprd) (cv t))) (cword C))) (cfv G csubg)) $ >
  $ wceq H (co G U cress) $ >
  $ wceq K (cfv (cfv H csubg) cmrc) $ >
  $ wceq O (cfv H cod) $ >
  $ wceq E (cfv H cgex) $ >
  $ wceq c_0 (cfv H c0g) $ >
  $ wceq c_po (cfv H clsm) $ >
  $ wi ph (wne E c1) $ >
  $ wi ph (wcel X U) $ >
  $ wi ph (wceq (cfv X O) E) $ >
  $ wi ph (wcel W (cfv H csubg)) $ >
  $ wi ph (wceq (cin (cfv (csn X) K) W) (csn c_0)) $ >
  $ wi ph (wceq (co (cfv (csn X) K) W c_po) U) $ >
  $ wi ph (wcel S (cword C)) $ >
  $ wi ph (wbr G S (cdm cdprd)) $ >
  $ wi ph (wceq (co G S cdprd) W) $ >
  $ wceq T (co S (cs1 (cfv (csn X) K)) cconcat) $ >
  $ wi ph (wrex s1 (wa (wbr G (cv s1) (cdm cdprd)) (wceq (co G (cv s1) cdprd) U)) (cword C)) $;

--| Lemma for ~ pgpfac . (Contributed by Mario Carneiro, 27-Apr-2016.) (Revised by Mario Carneiro, 3-May-2016.)
theorem pgpfaclem2 {t s1 r: setvar} (ph: wff s1 r) (B2 C: class r) (P c_po: class t s1 r) (U: class) (E: class t s1 r) (G: class) (H: class t s1 r) (K: class t) (O: class t s1 r) (W: class r) (X: class t) (c_0: class t s1 r):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq C (crab r (wcel (co G (cv r) cress) (cin ccyg (crn cpgp))) (cfv G csubg)) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wbr P G cpgp) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wcel U (cfv G csubg)) $ >
  $ wi ph (wral t (wi (wpss (cv t) U) (wrex s1 (wa (wbr G (cv s1) (cdm cdprd)) (wceq (co G (cv s1) cdprd) (cv t))) (cword C))) (cfv G csubg)) $ >
  $ wceq H (co G U cress) $ >
  $ wceq K (cfv (cfv H csubg) cmrc) $ >
  $ wceq O (cfv H cod) $ >
  $ wceq E (cfv H cgex) $ >
  $ wceq c_0 (cfv H c0g) $ >
  $ wceq c_po (cfv H clsm) $ >
  $ wi ph (wne E c1) $ >
  $ wi ph (wcel X U) $ >
  $ wi ph (wceq (cfv X O) E) $ >
  $ wi ph (wcel W (cfv H csubg)) $ >
  $ wi ph (wceq (cin (cfv (csn X) K) W) (csn c_0)) $ >
  $ wi ph (wceq (co (cfv (csn X) K) W c_po) U) $ >
  $ wi ph (wrex s1 (wa (wbr G (cv s1) (cdm cdprd)) (wceq (co G (cv s1) cdprd) U)) (cword C)) $;

--| Lemma for ~ pgpfac . (Contributed by Mario Carneiro, 27-Apr-2016.) (Revised by Mario Carneiro, 3-May-2016.)
theorem pgpfaclem3 {t s1 r: setvar} (ph: wff s1 r) (B2 C: class r) (P: class t s1 r) (U G: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq C (crab r (wcel (co G (cv r) cress) (cin ccyg (crn cpgp))) (cfv G csubg)) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wbr P G cpgp) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wcel U (cfv G csubg)) $ >
  $ wi ph (wral t (wi (wpss (cv t) U) (wrex s1 (wa (wbr G (cv s1) (cdm cdprd)) (wceq (co G (cv s1) cdprd) (cv t))) (cword C))) (cfv G csubg)) $ >
  $ wi ph (wrex s1 (wa (wbr G (cv s1) (cdm cdprd)) (wceq (co G (cv s1) cdprd) U)) (cword C)) $;

--| Full factorization of a finite abelian p-group, by iterating ~ pgpfac1 . There is a direct product decomposition of any abelian group of prime-power order into cyclic subgroups. (Contributed by Mario Carneiro, 27-Apr-2016.) (Revised by Mario Carneiro, 3-May-2016.)
theorem pgpfac {s1 r: setvar} (ph: wff s1 r) (B2 C: class r) (P: class s1 r) (G: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq C (crab r (wcel (co G (cv r) cress) (cin ccyg (crn cpgp))) (cfv G csubg)) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wbr P G cpgp) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wrex s1 (wa (wbr G (cv s1) (cdm cdprd)) (wceq (co G (cv s1) cdprd) B2)) (cword C)) $;

--| Lemma for ~ ablfac . (Contributed by Mario Carneiro, 27-Apr-2016.) (Revised by Mario Carneiro, 3-May-2016.)
theorem ablfaclem1 {x3 w g2 s1 r p: setvar} (ph: wff g2 r) (A2: class w g2 r) (B2: class) (C: class r) (S: class x3 w p) (U: class x3 w r p) (G: class) (O: class w g2 s1 r) (W: class g2 s1 r):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq C (crab r (wcel (co G (cv r) cress) (cin ccyg (crn cpgp))) (cfv G csubg)) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wceq O (cfv G cod) $ >
  $ wceq A2 (crab w (wbr (cv w) (cfv B2 chash) cdvds) cprime) $ >
  $ wceq S (cmpt p A2 (crab x3 (wbr (cfv (cv x3) O) (co (cv p) (co (cv p) (cfv B2 chash) cpc) cexp) cdvds) B2)) $ >
  $ wceq W (cmpt g2 (cfv G csubg) (crab s1 (wa (wbr G (cv s1) (cdm cdprd)) (wceq (co G (cv s1) cdprd) (cv g2))) (cword C))) $ >
  $ wi (wcel U (cfv G csubg)) (wceq (cfv U W) (crab s1 (wa (wbr G (cv s1) (cdm cdprd)) (wceq (co G (cv s1) cdprd) U)) (cword C))) $;

--| Lemma for ~ ablfac . (Contributed by Mario Carneiro, 27-Apr-2016.) (Proof shortened by Mario Carneiro, 3-May-2016.)
theorem ablfaclem2 {x3 y1 w g2 s1 r p: setvar} (ph: wff g2 r) (A2: class w g2 r) (B2: class y1) (C: class r) (S: class x3 w p) (F: class x3 y1 w g2 r p) (G: class) (H: class x3 y1 w g2 r p) (L: class x3 y1 w g2 s1 r p) (O: class y1 w g2 s1 r) (W: class g2 s1 r):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq C (crab r (wcel (co G (cv r) cress) (cin ccyg (crn cpgp))) (cfv G csubg)) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wceq O (cfv G cod) $ >
  $ wceq A2 (crab w (wbr (cv w) (cfv B2 chash) cdvds) cprime) $ >
  $ wceq S (cmpt p A2 (crab x3 (wbr (cfv (cv x3) O) (co (cv p) (co (cv p) (cfv B2 chash) cpc) cexp) cdvds) B2)) $ >
  $ wceq W (cmpt g2 (cfv G csubg) (crab s1 (wa (wbr G (cv s1) (cdm cdprd)) (wceq (co G (cv s1) cdprd) (cv g2))) (cword C))) $ >
  $ wi ph (wf A2 (cword C) F) $ >
  $ wi ph (wral y1 (wcel (cfv (cv y1) F) (cfv (cfv (cv y1) S) W)) A2) $ >
  $ wceq L (ciun y1 A2 (cxp (csn (cv y1)) (cdm (cfv (cv y1) F)))) $ >
  $ wi ph (wf1o (co cc0 (cfv L chash) cfzo) L H) $ >
  $ wi ph (wne (cfv B2 W) c0) $;

--| Lemma for ~ ablfac . (Contributed by Mario Carneiro, 27-Apr-2016.) (Revised by Mario Carneiro, 3-May-2016.)
theorem ablfaclem3 {x3 w g2 s1 r p: setvar} (ph: wff g2 r) (A2: class w g2 r) (B2: class) (C: class r) (S: class x3 w p) (G: class) (O: class w g2 s1 r) (W: class g2 s1 r):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq C (crab r (wcel (co G (cv r) cress) (cin ccyg (crn cpgp))) (cfv G csubg)) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wceq O (cfv G cod) $ >
  $ wceq A2 (crab w (wbr (cv w) (cfv B2 chash) cdvds) cprime) $ >
  $ wceq S (cmpt p A2 (crab x3 (wbr (cfv (cv x3) O) (co (cv p) (co (cv p) (cfv B2 chash) cpc) cexp) cdvds) B2)) $ >
  $ wceq W (cmpt g2 (cfv G csubg) (crab s1 (wa (wbr G (cv s1) (cdm cdprd)) (wceq (co G (cv s1) cdprd) (cv g2))) (cword C))) $ >
  $ wi ph (wne (cfv B2 W) c0) $;

--| The Fundamental Theorem of (finite) Abelian Groups. Any finite abelian group is a direct product of cyclic p-groups. (Contributed by Mario Carneiro, 27-Apr-2016.) (Revised by Mario Carneiro, 3-May-2016.)
theorem ablfac {s1 r: setvar} (ph: wff r) (B2: class) (C: class r) (G: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq C (crab r (wcel (co G (cv r) cress) (cin ccyg (crn cpgp))) (cfv G csubg)) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wrex s1 (wa (wbr G (cv s1) (cdm cdprd)) (wceq (co G (cv s1) cdprd) B2)) (cword C)) $;

--| Choose generators for each cyclic group in ~ ablfac . (Contributed by Mario Carneiro, 28-Apr-2016.)
theorem ablfac2 {w k n r: setvar} (ph: wff r) (B2: class) (C: class r) (S: class w k n) (c_x: class n r) (G: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq C (crab r (wcel (co G (cv r) cress) (cin ccyg (crn cpgp))) (cfv G csubg)) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wceq c_x (cfv G cmg) $ >
  $ wceq S (cmpt k (cdm (cv w)) (crn (cmpt n cz (co (cv n) (cfv (cv k) (cv w)) c_x)))) $ >
  $ wi ph (wrex w (w3a (wf (cdm (cv w)) C S) (wbr G S (cdm cdprd)) (wceq (co G S cdprd) B2)) (cword B2)) $;

--| Extend class notation with the class of simple groups.
term csimpg: class;

--| Define class of all simple groups. A simple group is a group ( ~ df-grp ) with exactly two normal subgroups. These are always the subgroup of all elements and the subgroup containing only the identity ( ~ simpgnsgbid ). (Contributed by Rohan Ridenour, 3-Aug-2023.)
axiom df_simpg {g2: setvar}:
  $ wceq csimpg (crab g2 (wbr (cfv (cv g2) cnsg) c2o cen) cgrp) $;

--| The predicate "is a simple group". (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem issimpg (G: class):
  $ wb (wcel G csimpg) (wa (wcel G cgrp) (wbr (cfv G cnsg) c2o cen)) $;

--| Deduce a simple group from its properties. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem issimpgd (ph: wff) (G: class):
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wbr (cfv G cnsg) c2o cen) $ >
  $ wi ph (wcel G csimpg) $;

--| A simple group is a group. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem simpggrp (G: class):
  $ wi (wcel G csimpg) (wcel G cgrp) $;

--| A simple group is a group. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem simpggrpd (ph: wff) (G: class):
  $ wi ph (wcel G csimpg) $ >
  $ wi ph (wcel G cgrp) $;

--| A simple group has two normal subgroups. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem simpg2nsg (G: class):
  $ wi (wcel G csimpg) (wbr (cfv G cnsg) c2o cen) $;

--| Trivial groups are not simple. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem trivnsimpgd (ph: wff) (B2 G c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wceq B2 (csn c_0)) $ >
  $ wi ph (wn (wcel G csimpg)) $;

--| Simple groups are nontrivial. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem simpgntrivd (ph: wff) (B2 G c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi ph (wcel G csimpg) $ >
  $ wi ph (wn (wceq B2 (csn c_0))) $;

--| A simple group contains a nonidentity element. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem simpgnideld {x3: setvar} (ph: wff x3) (B2: class) (G: class x3) (c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi ph (wcel G csimpg) $ >
  $ wi ph (wrex x3 (wn (wceq (cv x3) c_0)) B2) $;

--| The only normal subgroups of a simple group are the group itself and the trivial group. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem simpgnsgd (ph: wff) (B2 G c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi ph (wcel G csimpg) $ >
  $ wi ph (wceq (cfv G cnsg) (cpr (csn c_0) B2)) $;

--| A normal subgroup of a simple group is either the whole group or the trivial subgroup. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem simpgnsgeqd (ph: wff) (A2 B2 G c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi ph (wcel G csimpg) $ >
  $ wi ph (wcel A2 (cfv G cnsg)) $ >
  $ wi ph (wo (wceq A2 (csn c_0)) (wceq A2 B2)) $;

--| If any normal subgroup of a nontrivial group is either the trivial subgroup or the whole group, the group is simple. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem _2nsgsimpgd {x3: setvar} (ph: wff) (B2 G c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wn (wceq (csn c_0) B2)) $ >
  $ wi (wa ph (wcel (cv x3) (cfv G cnsg))) (wo (wceq (cv x3) (csn c_0)) (wceq (cv x3) B2)) $ >
  $ wi ph (wcel G csimpg) $;

--| A nontrivial group is simple if and only if its normal subgroups are exactly the group itself and the trivial subgroup. (Contributed by Rohan Ridenour, 4-Aug-2023.)
theorem simpgnsgbid (ph: wff) (B2 G c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wn (wceq (csn c_0) B2)) $ >
  $ wi ph (wb (wcel G csimpg) (wceq (cfv G cnsg) (cpr (csn c_0) B2))) $;

--| A subgroup of an abelian simple group containing a nonidentity element is the whole group. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem ablsimpnosubgd (ph: wff) (A2 B2 S G c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wcel G csimpg) $ >
  $ wi ph (wcel S (cfv G csubg)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wn (wceq A2 c_0)) $ >
  $ wi ph (wceq S B2) $;

--| An abelian simple group is generated by any non-identity element. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem ablsimpg1gend {n: setvar} (ph: wff) (A2 B2 C c_x G: class) (c_0: class n):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wceq c_x (cfv G cmg) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wcel G csimpg) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wn (wceq A2 c_0)) $ >
  $ wi ph (wcel C B2) $ >
  $ wi ph (wrex n (wceq C (co (cv n) A2 c_x)) cz) $;

--| An abelian simple group is cyclic. (Contributed by Rohan Ridenour, 3-Aug-2023.) (Proof shortened by Rohan Ridenour, 31-Oct-2023.)
theorem ablsimpgcygd (ph: wff) (G: class):
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wcel G csimpg) $ >
  $ wi ph (wcel G ccyg) $;

--| Lemma for ~ ablsimpgfind . An element of an abelian finite simple group which doesn't square to the identity has finite order. (Contributed by Rohan Ridenour, 3-Aug-2023.) (Proof shortened by Rohan Ridenour, 31-Oct-2023.)
theorem ablsimpgfindlem1 (ph: wff) (x3: setvar) (B2 c_x G O c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wceq c_x (cfv G cmg) $ >
  $ wceq O (cfv G cod) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wcel G csimpg) $ >
  $ wi (wa (wa ph (wcel (cv x3) B2)) (wne (co c2 (cv x3) c_x) c_0)) (wne (cfv (cv x3) O) cc0) $;

--| Lemma for ~ ablsimpgfind . An element of an abelian finite simple group which squares to the identity has finite order. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem ablsimpgfindlem2 (ph: wff) (x3: setvar) (B2 c_x G O c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wceq c_x (cfv G cmg) $ >
  $ wceq O (cfv G cod) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wcel G csimpg) $ >
  $ wi (wa (wa ph (wcel (cv x3) B2)) (wceq (co c2 (cv x3) c_x) c_0)) (wne (cfv (cv x3) O) cc0) $;

--| Relationship between the order of a subgroup and the order of a generator of the subgroup. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem cycsubggenodd {n: setvar} (ph: wff n) (A2 B2: class) (C: class n) (c_x G O: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_x (cfv G cmg) $ >
  $ wceq O (cfv G cod) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wceq C (crn (cmpt n cz (co (cv n) A2 c_x)))) $ >
  $ wi ph (wceq (cfv A2 O) (cif (wcel C cfn) (cfv C chash) cc0)) $;

--| An abelian simple group is finite. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem ablsimpgfind (ph: wff) (B2 G: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wcel G csimpg) $ >
  $ wi ph (wcel B2 cfn) $;

--| The subgroup referenced in ~ fincygsubgodd is a subgroup. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem fincygsubgd {n: setvar} (ph: wff n) (A2 B2 C c_x G: class) (H: class n):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_x (cfv G cmg) $ >
  $ wceq H (cmpt n cz (co (cv n) (co C A2 c_x) c_x)) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wcel (crn H) (cfv G csubg)) $;

--| Calculate the order of a subgroup of a finite cyclic group. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem fincygsubgodd {n: setvar} (ph: wff n) (A2 B2 C: class) (D: class n) (c_x: class) (F: class n) (G: class) (H: class n):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_x (cfv G cmg) $ >
  $ wceq D (co (cfv B2 chash) C cdiv) $ >
  $ wceq F (cmpt n cz (co (cv n) A2 c_x)) $ >
  $ wceq H (cmpt n cz (co (cv n) (co C A2 c_x) c_x)) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wceq (crn F) B2) $ >
  $ wi ph (wbr C (cfv B2 chash) cdvds) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wceq (cfv (crn H) chash) D) $;

--| A finite cyclic group has subgroups of every possible order. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem fincygsubgodexd {x3: setvar} (ph: wff) (B2 C G: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wi ph (wcel G ccyg) $ >
  $ wi ph (wbr C (cfv B2 chash) cdvds) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wrex x3 (wceq (cfv (cv x3) chash) C) (cfv G csubg)) $;

--| A group of prime order is simple. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem prmgrpsimpgd (ph: wff) (B2 G: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel (cfv B2 chash) cprime) $ >
  $ wi ph (wcel G csimpg) $;

--| An abelian simple group has prime order. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem ablsimpgprmd (ph: wff) (B2 G: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wcel G csimpg) $ >
  $ wi ph (wcel (cfv B2 chash) cprime) $;

--| An abelian group is simple if and only if its order is prime. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem ablsimpgd (ph: wff) (B2 G: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wb (wcel G csimpg) (wcel (cfv B2 chash) cprime)) $;

--| Extend class notation with the class of all right ordered monoids.
term comnd: class;

--| Extend class notation with the class of all right ordered groups.
term cogrp: class;

--| Define class of all right ordered monoids. An ordered monoid is a monoid with a total ordering compatible with its operation. It is possible to use this definition also for left ordered monoids, by applying it to ` ( oppG `` M ) ` . (Contributed by Thierry Arnoux, 13-Mar-2018.)
axiom df_omnd {v g2 p a b c l: setvar}:
  $ wceq comnd (crab g2 (wsbc v (wsbc p (wsbc l (wa (wcel (cv g2) ctos) (wral a (wral b (wral c (wi (wbr (cv a) (cv b) (cv l)) (wbr (co (cv a) (cv c) (cv p)) (co (cv b) (cv c) (cv p)) (cv l))) (cv v)) (cv v)) (cv v))) (cfv (cv g2) cple)) (cfv (cv g2) cplusg)) (cfv (cv g2) cbs)) cmnd) $;

--| Define class of all ordered groups. An ordered group is a group with a total ordering compatible with its operation. (Contributed by Thierry Arnoux, 13-Mar-2018.)
axiom df_ogrp:
  $ wceq cogrp (cin cgrp comnd) $;

--| A (left) ordered monoid is a monoid with a total ordering compatible with its operation. (Contributed by Thierry Arnoux, 30-Jan-2018.)
theorem isomnd {a b c: setvar} (B2: class) (c_pl c_le: class a b c) (M: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq c_pl (cfv M cplusg) $ >
  $ wceq c_le (cfv M cple) $ >
  $ wb (wcel M comnd) (w3a (wcel M cmnd) (wcel M ctos) (wral a (wral b (wral c (wi (wbr (cv a) (cv b) c_le) (wbr (co (cv a) (cv c) c_pl) (co (cv b) (cv c) c_pl) c_le)) B2) B2) B2)) $;

--| A (left-)ordered group is a group with a total ordering compatible with its operations. (Contributed by Thierry Arnoux, 23-Mar-2018.)
theorem isogrp (G: class):
  $ wb (wcel G cogrp) (wa (wcel G cgrp) (wcel G comnd)) $;

--| A left-ordered group is a group. (Contributed by Thierry Arnoux, 9-Jul-2018.)
theorem ogrpgrp (G: class):
  $ wi (wcel G cogrp) (wcel G cgrp) $;

--| A left-ordered monoid is a monoid. (Contributed by Thierry Arnoux, 13-Mar-2018.)
theorem omndmnd (M: class):
  $ wi (wcel M comnd) (wcel M cmnd) $;

--| A left-ordered monoid is a totally ordered set. (Contributed by Thierry Arnoux, 13-Mar-2018.)
theorem omndtos (M: class):
  $ wi (wcel M comnd) (wcel M ctos) $;

--| In an ordered monoid, the ordering is compatible with group addition. (Contributed by Thierry Arnoux, 30-Jan-2018.)
theorem omndadd (B2 c_pl c_le M X Y Z: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq c_le (cfv M cple) $ >
  $ wceq c_pl (cfv M cplusg) $ >
  $ wi (w3a (wcel M comnd) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2)) (wbr X Y c_le)) (wbr (co X Z c_pl) (co Y Z c_pl) c_le) $;

--| In a right ordered monoid, the ordering is compatible with group addition. (Contributed by Thierry Arnoux, 30-Jan-2018.)
theorem omndaddr (B2 c_pl c_le M X Y Z: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq c_le (cfv M cple) $ >
  $ wceq c_pl (cfv M cplusg) $ >
  $ wi (w3a (wcel (cfv M coppg) comnd) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2)) (wbr X Y c_le)) (wbr (co Z X c_pl) (co Z Y c_pl) c_le) $;

--| In a commutative left ordered monoid, the ordering is compatible with monoid addition. Double addition version. (Contributed by Thierry Arnoux, 30-Jan-2018.)
theorem omndadd2d (ph: wff) (B2 c_pl c_le M W X Y Z: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq c_le (cfv M cple) $ >
  $ wceq c_pl (cfv M cplusg) $ >
  $ wi ph (wcel M comnd) $ >
  $ wi ph (wcel W B2) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wbr X Z c_le) $ >
  $ wi ph (wbr Y W c_le) $ >
  $ wi ph (wcel M ccmn) $ >
  $ wi ph (wbr (co X Y c_pl) (co Z W c_pl) c_le) $;

--| In a left- and right- ordered monoid, the ordering is compatible with monoid addition. Double addition version. (Contributed by Thierry Arnoux, 2-May-2018.)
theorem omndadd2rd (ph: wff) (B2 c_pl c_le M W X Y Z: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq c_le (cfv M cple) $ >
  $ wceq c_pl (cfv M cplusg) $ >
  $ wi ph (wcel M comnd) $ >
  $ wi ph (wcel W B2) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wbr X Z c_le) $ >
  $ wi ph (wbr Y W c_le) $ >
  $ wi ph (wcel (cfv M coppg) comnd) $ >
  $ wi ph (wbr (co X Y c_pl) (co Z W c_pl) c_le) $;

--| A submonoid of an ordered monoid is also ordered. (Contributed by Thierry Arnoux, 23-Mar-2018.)
theorem submomnd (A2 M: class):
  $ wi (wa (wcel M comnd) (wcel (co M A2 cress) cmnd)) (wcel (co M A2 cress) comnd) $;

--| In an ordered monoid, the ordering is compatible with group power. This version does not require the monoid to be commutative. (Contributed by Thierry Arnoux, 23-Mar-2018.)
theorem omndmul2 (B2 c_x c_le M N X c_0: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq c_le (cfv M cple) $ >
  $ wceq c_x (cfv M cmg) $ >
  $ wceq c_0 (cfv M c0g) $ >
  $ wi (w3a (wcel M comnd) (wa (wcel X B2) (wcel N cn0)) (wbr c_0 X c_le)) (wbr c_0 (co N X c_x) c_le) $;

--| In an ordered monoid, the ordering is compatible with group power. This version does not require the monoid to be commutative. (Contributed by Thierry Arnoux, 23-Mar-2018.)
theorem omndmul3 (ph: wff) (B2 P c_x c_le M N X c_0: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq c_le (cfv M cple) $ >
  $ wceq c_x (cfv M cmg) $ >
  $ wceq c_0 (cfv M c0g) $ >
  $ wi ph (wcel M comnd) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel P cn0) $ >
  $ wi ph (wbr N P cle) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wbr c_0 X c_le) $ >
  $ wi ph (wbr (co N X c_x) (co P X c_x) c_le) $;

--| In a commutative ordered monoid, the ordering is compatible with group power. (Contributed by Thierry Arnoux, 30-Jan-2018.)
theorem omndmul (ph: wff) (B2 c_x c_le M N X Y: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq c_le (cfv M cple) $ >
  $ wceq c_x (cfv M cmg) $ >
  $ wi ph (wcel M comnd) $ >
  $ wi ph (wcel M ccmn) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wbr X Y c_le) $ >
  $ wi ph (wbr (co N X c_x) (co N Y c_x) c_le) $;

--| In an ordered group, the ordering is compatible with group inverse. (Contributed by Thierry Arnoux, 3-Sep-2018.)
theorem ogrpinv0le (B2 G I c_le X c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_le (cfv G cple) $ >
  $ wceq I (cfv G cminusg) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi (wa (wcel G cogrp) (wcel X B2)) (wb (wbr c_0 X c_le) (wbr (cfv X I) c_0 c_le)) $;

--| In an ordered group, the ordering is compatible with group subtraction. (Contributed by Thierry Arnoux, 30-Jan-2018.)
theorem ogrpsub (B2 G c_le c_mi X Y Z: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_le (cfv G cple) $ >
  $ wceq c_mi (cfv G csg) $ >
  $ wi (w3a (wcel G cogrp) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2)) (wbr X Y c_le)) (wbr (co X Z c_mi) (co Y Z c_mi) c_le) $;

--| In an ordered group, strict ordering is compatible with group addition. (Contributed by Thierry Arnoux, 20-Jan-2018.)
theorem ogrpaddlt (B2 c_pl c_lt G X Y Z: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_lt (cfv G cplt) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi (w3a (wcel G cogrp) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2)) (wbr X Y c_lt)) (wbr (co X Z c_pl) (co Y Z c_pl) c_lt) $;

--| In a right ordered group, strict ordering is compatible with group addition. (Contributed by Thierry Arnoux, 3-Sep-2018.)
theorem ogrpaddltbi (B2 c_pl c_lt G X Y Z: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_lt (cfv G cplt) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi (wa (wcel G cogrp) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wb (wbr X Y c_lt) (wbr (co X Z c_pl) (co Y Z c_pl) c_lt)) $;

--| In a right ordered group, strict ordering is compatible with group addition. (Contributed by Thierry Arnoux, 3-Sep-2018.)
theorem ogrpaddltrd (ph: wff) (B2 c_pl c_lt G V X Y Z: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_lt (cfv G cplt) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wcel (cfv G coppg) cogrp) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wbr X Y c_lt) $ >
  $ wi ph (wbr (co Z X c_pl) (co Z Y c_pl) c_lt) $;

--| In a right ordered group, strict ordering is compatible with group addition. (Contributed by Thierry Arnoux, 4-Sep-2018.)
theorem ogrpaddltrbid (ph: wff) (B2 c_pl c_lt G V X Y Z: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_lt (cfv G cplt) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wcel (cfv G coppg) cogrp) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wb (wbr X Y c_lt) (wbr (co Z X c_pl) (co Z Y c_pl) c_lt)) $;

--| In an ordered group, strict ordering is compatible with group addition. (Contributed by Thierry Arnoux, 3-Sep-2018.)
theorem ogrpsublt (B2 c_lt G c_mi X Y Z: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_lt (cfv G cplt) $ >
  $ wceq c_mi (cfv G csg) $ >
  $ wi (w3a (wcel G cogrp) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2)) (wbr X Y c_lt)) (wbr (co X Z c_mi) (co Y Z c_mi) c_lt) $;

--| In an ordered group, the ordering is compatible with group inverse. (Contributed by Thierry Arnoux, 3-Sep-2018.)
theorem ogrpinv0lt (B2 c_lt G I X c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_lt (cfv G cplt) $ >
  $ wceq I (cfv G cminusg) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi (wa (wcel G cogrp) (wcel X B2)) (wb (wbr c_0 X c_lt) (wbr (cfv X I) c_0 c_lt)) $;

--| In an ordered group, the ordering is compatible with group inverse. (Contributed by Thierry Arnoux, 3-Sep-2018.)
theorem ogrpinvlt (B2 c_lt G I X Y: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_lt (cfv G cplt) $ >
  $ wceq I (cfv G cminusg) $ >
  $ wi (w3a (wa (wcel G cogrp) (wcel (cfv G coppg) cogrp)) (wcel X B2) (wcel Y B2)) (wb (wbr X Y c_lt) (wbr (cfv Y I) (cfv X I) c_lt)) $;

--| A finite sum in an ordered monoid is monotonic. This proof would be much easier in an ordered group, where an inverse element would be available. (Contributed by Thierry Arnoux, 13-Mar-2018.)
theorem gsumle (ph: wff) (A2 B2 F G c_le M: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq c_le (cfv M cple) $ >
  $ wi ph (wcel M comnd) $ >
  $ wi ph (wcel M ccmn) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf A2 B2 G) $ >
  $ wi ph (wbr F G (cofr c_le)) $ >
  $ wi ph (wbr (co M F cgsu) (co M G cgsu) c_le) $;

--| Multiplicative group.
term cmgp: class;

--| Define a structure that puts the multiplication operation of a ring in the addition slot. Note that this will not actually be a group for the average ring, or even for a field, but it will be a monoid, and ~ unitgrp shows that we get a group if we restrict to the elements that have inverses. This allows to formalize such notions as "the multiplication operation of a ring is a monoid" ( ~ ringmgp ) or "the multiplicative identity" in terms of the identity of a monoid ( ~ df-ur ). (Contributed by Mario Carneiro, 21-Dec-2014.)
axiom df_mgp {w: setvar}:
  $ wceq cmgp (cmpt w cvv (co (cv w) (cop (cfv cnx cplusg) (cfv (cv w) cmulr)) csts)) $;

--| The multiplicative group operator is a function. (Contributed by Mario Carneiro, 11-Mar-2015.)
theorem fnmgp:
  $ wfn cmgp cvv $;

--| Value of the multiplication group operation. (Contributed by Mario Carneiro, 21-Dec-2014.)
theorem mgpval (R c_x M: class):
  $ wceq M (cfv R cmgp) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq M (co R (cop (cfv cnx cplusg) c_x) csts) $;

--| Value of the group operation of the multiplication group. (Contributed by Mario Carneiro, 21-Dec-2014.)
theorem mgpplusg (R c_x M: class):
  $ wceq M (cfv R cmgp) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_x (cfv M cplusg) $;

--| Base set of the multiplication group. (Contributed by Mario Carneiro, 21-Dec-2014.) (Revised by Mario Carneiro, 5-Oct-2015.)
theorem mgpbas (B2 R M: class):
  $ wceq M (cfv R cmgp) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq B2 (cfv M cbs) $;

--| The multiplication monoid has the same (if any) scalars as the original ring. Mostly to simplify ~ pwsmgp . (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Mario Carneiro, 5-May-2015.)
theorem mgpsca (R S M: class):
  $ wceq M (cfv R cmgp) $ >
  $ wceq S (cfv R csca) $ >
  $ wceq S (cfv M csca) $;

--| Topology component of the multiplication group. (Contributed by Mario Carneiro, 5-Oct-2015.)
theorem mgptset (R M: class):
  $ wceq M (cfv R cmgp) $ >
  $ wceq (cfv R cts) (cfv M cts) $;

--| Topology of the multiplication group. (Contributed by Mario Carneiro, 5-Oct-2015.)
theorem mgptopn (R J M: class):
  $ wceq M (cfv R cmgp) $ >
  $ wceq J (cfv R ctopn) $ >
  $ wceq J (cfv M ctopn) $;

--| Distance function of the multiplication group. (Contributed by Mario Carneiro, 5-Oct-2015.)
theorem mgpds (B2 R M: class):
  $ wceq M (cfv R cmgp) $ >
  $ wceq B2 (cfv R cds) $ >
  $ wceq B2 (cfv M cds) $;

--| Subgroup commutes with the multiplicative group operator. (Contributed by Mario Carneiro, 10-Jan-2015.) (Proof shortened by AV, 18-Oct-2024.)
theorem mgpress (A2 R S M V W: class):
  $ wceq S (co R A2 cress) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wi (wa (wcel R V) (wcel A2 W)) (wceq (co M A2 cress) (cfv S cmgp)) $;

--| The multiplicative monoid of a product is the product of the multiplicative monoids of the factors. (Contributed by Mario Carneiro, 11-Mar-2015.)
theorem prdsmgp (ph: wff) (R S I M V W Y Z: class):
  $ wceq Y (co S R cprds) $ >
  $ wceq M (cfv Y cmgp) $ >
  $ wceq Z (co S (ccom cmgp R) cprds) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel S W) $ >
  $ wi ph (wfn R I) $ >
  $ wi ph (wa (wceq (cfv M cbs) (cfv Z cbs)) (wceq (cfv M cplusg) (cfv Z cplusg))) $;

--| Membership in a product of two subsets of a multiplication group. (Contributed by Thierry Arnoux, 20-Jan-2024.)
theorem elmgplsm {x3 y1: setvar} (ph: wff x3 y1) (B2: class) (R: class x3 y1) (c_x: class) (c_xp: class x3 y1) (E F G Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_xp (cfv G clsm) $ >
  $ wi ph (wss E B2) $ >
  $ wi ph (wss F B2) $ >
  $ wi ph (wb (wcel Z (co E F c_xp)) (wrex x3 (wrex y1 (wceq Z (co (cv x3) (cv y1) c_x)) F) E)) $;

--| Membership in a product of two subsets of a multiplication group, one direction. (Contributed by Thierry Arnoux, 13-Apr-2024.)
theorem elmgplsmd (ph: wff) (B2 R c_x c_xp E F G X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_xp (cfv G clsm) $ >
  $ wi ph (wss E B2) $ >
  $ wi ph (wss F B2) $ >
  $ wi ph (wcel X E) $ >
  $ wi ph (wcel Y F) $ >
  $ wi ph (wcel (co X Y c_x) (co E F c_xp)) $;

--| Extend class notation with class of all non-unital rings.
term crng: class;

--| Define the class of all non-unital rings. A _non-unital ring_ (or rng, or pseudoring) is a set equipped with two everywhere-defined internal operations, whose first one is an additive abelian group operation and the second one is a multiplicative semigroup operation, and where the addition is left- and right-distributive for the multiplication. Definition of a pseudo-ring in section I.8.1 of [BourbakiAlg1] p. 93 or the definition of a ring in part Preliminaries of [Roman] p. 18. As almost always in mathematics, "non-unital" means "not necessarily unital". Therefore, by talking about a ring (in general) or a non-unital ring the "unital" case is always included. In contrast to a unital ring, the commutativity of addition must be postulated and cannot be proven from the other conditions. (Contributed by AV, 6-Jan-2020.)
axiom df_rng {x3 y1 z t f2 p b: setvar}:
  $ wceq crng (crab f2 (wa (wcel (cfv (cv f2) cmgp) csgrp) (wsbc b (wsbc p (wsbc t (wral x3 (wral y1 (wral z (wa (wceq (co (cv x3) (co (cv y1) (cv z) (cv p)) (cv t)) (co (co (cv x3) (cv y1) (cv t)) (co (cv x3) (cv z) (cv t)) (cv p))) (wceq (co (co (cv x3) (cv y1) (cv p)) (cv z) (cv t)) (co (co (cv x3) (cv z) (cv t)) (co (cv y1) (cv z) (cv t)) (cv p)))) (cv b)) (cv b)) (cv b)) (cfv (cv f2) cmulr)) (cfv (cv f2) cplusg)) (cfv (cv f2) cbs))) cabl) $;

--| The predicate "is a non-unital ring." (Contributed by AV, 6-Jan-2020.)
theorem isrng {x3 y1 z: setvar} (B2 c_pl R c_x: class) (G: class x3 y1 z):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wb (wcel R crng) (w3a (wcel R cabl) (wcel G csgrp) (wral x3 (wral y1 (wral z (wa (wceq (co (cv x3) (co (cv y1) (cv z) c_pl) c_x) (co (co (cv x3) (cv y1) c_x) (co (cv x3) (cv z) c_x) c_pl)) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_x) (co (co (cv x3) (cv z) c_x) (co (cv y1) (cv z) c_x) c_pl))) B2) B2) B2)) $;

--| A non-unital ring is an (additive) abelian group. (Contributed by AV, 17-Feb-2020.)
theorem rngabl (R: class):
  $ wi (wcel R crng) (wcel R cabl) $;

--| A non-unital ring is a semigroup under multiplication. (Contributed by AV, 17-Feb-2020.)
theorem rngmgp (R G: class):
  $ wceq G (cfv R cmgp) $ >
  $ wi (wcel R crng) (wcel G csgrp) $;

--| Restricted functionality of the multiplicative group on non-unital rings ( ~ mgpf analog). (Contributed by AV, 22-Feb-2025.)
theorem rngmgpf:
  $ wf crng csgrp (cres cmgp crng) $;

--| A non-unital ring is a (additive) group. (Contributed by AV, 16-Feb-2025.)
theorem rnggrp (R: class):
  $ wi (wcel R crng) (wcel R cgrp) $;

--| Associative law for the multiplication operation of a non-unital ring. (Contributed by NM, 27-Aug-2011.) (Revised by AV, 13-Feb-2025.)
theorem rngass (B2 R c_x X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crng) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wceq (co (co X Y c_x) Z c_x) (co X (co Y Z c_x) c_x)) $;

--| Distributive law for the multiplication operation of a non-unital ring (left-distributivity). (Contributed by AV, 14-Feb-2025.)
theorem rngdi (B2 c_pl R c_x X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crng) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wceq (co X (co Y Z c_pl) c_x) (co (co X Y c_x) (co X Z c_x) c_pl)) $;

--| Distributive law for the multiplication operation of a non-unital ring (right-distributivity). (Contributed by AV, 17-Apr-2020.)
theorem rngdir (B2 c_pl R c_x X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crng) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wceq (co (co X Y c_pl) Z c_x) (co (co X Z c_x) (co Y Z c_x) c_pl)) $;

--| Closure of the addition operation of a non-unital ring. (Contributed by AV, 16-Feb-2025.)
theorem rngacl (B2 c_pl R X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (w3a (wcel R crng) (wcel X B2) (wcel Y B2)) (wcel (co X Y c_pl) B2) $;

--| The zero element of a non-unital ring belongs to its base set. (Contributed by AV, 16-Feb-2025.)
theorem rng0cl (B2 R c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R crng) (wcel c_0 B2) $;

--| Closure of the multiplication operation of a non-unital ring. (Contributed by AV, 17-Apr-2020.)
theorem rngcl (B2 R c_x X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R crng) (wcel X B2) (wcel Y B2)) (wcel (co X Y c_x) B2) $;

--| The zero of a non-unital ring is a left-absorbing element. (Contributed by FL, 31-Aug-2009.) Generalization of ~ ringlz . (Revised by AV, 17-Apr-2020.)
theorem rnglz (B2 R c_x X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R crng) (wcel X B2)) (wceq (co c_0 X c_x) c_0) $;

--| The zero of a non-unital ring is a right-absorbing element. (Contributed by FL, 31-Aug-2009.) Generalization of ~ ringrz . (Revised by AV, 16-Feb-2025.)
theorem rngrz (B2 R c_x X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R crng) (wcel X B2)) (wceq (co X c_0 c_x) c_0) $;

--| Negation of a product in a non-unital ring ( ~ mulneg1 analog). In contrast to ~ ringmneg1 , the proof does not (and cannot) make use of the existence of a ring unity. (Contributed by AV, 17-Feb-2025.)
theorem rngmneg1 (ph: wff) (B2 R c_x N X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co (cfv X N) Y c_x) (cfv (co X Y c_x) N)) $;

--| Negation of a product in a non-unital ring ( ~ mulneg2 analog). In contrast to ~ ringmneg2 , the proof does not (and cannot) make use of the existence of a ring unity. (Contributed by AV, 17-Feb-2025.)
theorem rngmneg2 (ph: wff) (B2 R c_x N X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co X (cfv Y N) c_x) (cfv (co X Y c_x) N)) $;

--| Double negation of a product in a non-unital ring ( ~ mul2neg analog). (Contributed by Mario Carneiro, 4-Dec-2014.) Generalization of ~ ringm2neg . (Revised by AV, 17-Feb-2025.)
theorem rngm2neg (ph: wff) (B2 R c_x N X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co (cfv X N) (cfv Y N) c_x) (co X Y c_x)) $;

--| Every additive subgroup of a non-unital ring is normal. (Contributed by AV, 25-Feb-2025.)
theorem rngansg (R: class):
  $ wi (wcel R crng) (wceq (cfv R cnsg) (cfv R csubg)) $;

--| Ring multiplication distributes over subtraction. ( ~ subdi analog.) (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by Mario Carneiro, 2-Jul-2014.) Generalization of ~ ringsubdi . (Revised by AV, 23-Feb-2025.)
theorem rngsubdi (ph: wff) (B2 R c_x c_mi X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wceq (co X (co Y Z c_mi) c_x) (co (co X Y c_x) (co X Z c_x) c_mi)) $;

--| Ring multiplication distributes over subtraction. ( ~ subdir analog.) (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by Mario Carneiro, 2-Jul-2014.) Generalization of ~ ringsubdir . (Revised by AV, 23-Feb-2025.)
theorem rngsubdir (ph: wff) (B2 R c_x c_mi X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wceq (co (co X Y c_mi) Z c_x) (co (co X Z c_x) (co Y Z c_x) c_mi)) $;

--| Properties that determine a non-unital ring. (Contributed by AV, 14-Feb-2025.)
theorem isrngd {x3 y1 z: setvar} (ph: wff) (B2: class) (c_pl: class x3 y1 z) (R: class) (c_x: class x3 y1 z):
  $ wi ph (wceq B2 (cfv R cbs)) $ >
  $ wi ph (wceq c_pl (cfv R cplusg)) $ >
  $ wi ph (wceq c_x (cfv R cmulr)) $ >
  $ wi ph (wcel R cabl) $ >
  $ wi (w3a ph (wcel (cv x3) B2) (wcel (cv y1) B2)) (wcel (co (cv x3) (cv y1) c_x) B2) $ >
  $ wi (wa ph (w3a (wcel (cv x3) B2) (wcel (cv y1) B2) (wcel (cv z) B2))) (wceq (co (co (cv x3) (cv y1) c_x) (cv z) c_x) (co (cv x3) (co (cv y1) (cv z) c_x) c_x)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) B2) (wcel (cv y1) B2) (wcel (cv z) B2))) (wceq (co (cv x3) (co (cv y1) (cv z) c_pl) c_x) (co (co (cv x3) (cv y1) c_x) (co (cv x3) (cv z) c_x) c_pl)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) B2) (wcel (cv y1) B2) (wcel (cv z) B2))) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_x) (co (co (cv x3) (cv z) c_x) (co (cv y1) (cv z) c_x) c_pl)) $ >
  $ wi ph (wcel R crng) $;

--| If two structures have the same base set, and the values of their group (addition) and ring (multiplication) operations are equal for all pairs of elements of the base set, one is a non-unital ring iff the other one is. (Contributed by AV, 15-Feb-2025.)
theorem rngpropd {x3 y1: setvar} (ph: wff) (B2 K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi ph (wb (wcel K crng) (wcel L crng)) $;

--| Closure of the multiplication in a structure product of non-unital rings. (Contributed by Mario Carneiro, 11-Mar-2015.) Generalization of ~ prdsmulrcl . (Revised by AV, 21-Feb-2025.)
theorem prdsmulrngcl (ph: wff) (B2 R S c_x F G I V W Y: class):
  $ wceq Y (co S R cprds) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq c_x (cfv Y cmulr) $ >
  $ wi ph (wcel S V) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wf I crng R) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wi ph (wcel (co F G c_x) B2) $;

--| A product of non-unital rings is a non-unital ring. (Contributed by AV, 22-Feb-2025.)
theorem prdsrngd (ph: wff) (R S I V W Y: class):
  $ wceq Y (co S R cprds) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel S V) $ >
  $ wi ph (wf I crng R) $ >
  $ wi ph (wcel Y crng) $;

--| The image structure of a non-unital ring is a non-unital ring ( ~ imasring analog). (Contributed by AV, 22-Feb-2025.)
theorem imasrng {q p a b: setvar} (ph: wff) (B2: class) (c_pl: class a b) (R: class) (c_x: class a b) (U F V: class):
  $ wi ph (wceq U (co F R cimas)) $ >
  $ wi ph (wceq V (cfv R cbs)) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wfo V B2 F) $ >
  $ wi (w3a ph (wa (wcel (cv a) V) (wcel (cv b) V)) (wa (wcel (cv p) V) (wcel (cv q) V))) (wi (wa (wceq (cfv (cv a) F) (cfv (cv p) F)) (wceq (cfv (cv b) F) (cfv (cv q) F))) (wceq (cfv (co (cv a) (cv b) c_pl) F) (cfv (co (cv p) (cv q) c_pl) F))) $ >
  $ wi (w3a ph (wa (wcel (cv a) V) (wcel (cv b) V)) (wa (wcel (cv p) V) (wcel (cv q) V))) (wi (wa (wceq (cfv (cv a) F) (cfv (cv p) F)) (wceq (cfv (cv b) F) (cfv (cv q) F))) (wceq (cfv (co (cv a) (cv b) c_x) F) (cfv (co (cv p) (cv q) c_x) F))) $ >
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel U crng) $;

--| The image of a non-unital ring under an injection is a non-unital ring ( ~ imasmndf1 analog). (Contributed by AV, 22-Feb-2025.)
theorem imasrngf1 (B2 R U F V: class):
  $ wceq U (co F R cimas) $ >
  $ wceq V (cfv R cbs) $ >
  $ wi (wa (wf1 V B2 F) (wcel R crng)) (wcel U crng) $;

--| A product of two non-unital rings is a non-unital ring ( ~ xpsmnd analog). (Contributed by AV, 22-Feb-2025.)
theorem xpsrngd (ph: wff) (R S Y: class):
  $ wceq Y (co S R cxps) $ >
  $ wi ph (wcel S crng) $ >
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel Y crng) $;

--| The quotient structure of a non-unital ring is a non-unital ring ( ~ qusring2 analog). (Contributed by AV, 23-Feb-2025.)
theorem qusrng {q p a b: setvar} (ph: wff) (c_pl: class a b) (c_sm R: class) (c_x: class a b) (U V: class):
  $ wi ph (wceq U (co R c_sm cqus)) $ >
  $ wi ph (wceq V (cfv R cbs)) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wer V c_sm) $ >
  $ wi ph (wi (wa (wbr (cv a) (cv p) c_sm) (wbr (cv b) (cv q) c_sm)) (wbr (co (cv a) (cv b) c_pl) (co (cv p) (cv q) c_pl) c_sm)) $ >
  $ wi ph (wi (wa (wbr (cv a) (cv p) c_sm) (wbr (cv b) (cv q) c_sm)) (wbr (co (cv a) (cv b) c_x) (co (cv p) (cv q) c_x) c_sm)) $ >
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel U crng) $;

--| Lemma for ~ rng1zr and ~ srg1zr . (Contributed by FL, 13-Feb-2010.) (Revised by AV, 18-Jun-2026.)
theorem rng1zrlem (B2 c_pl R c_as Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_as (cfv R cmulr) $ >
  $ wi (w3a (wa (wcel R cmgm) (wcel (cfv R cmgp) cmgm)) (wa (wfn c_pl (cxp B2 B2)) (wfn c_as (cxp B2 B2))) (wcel Z B2)) (wb (wceq B2 (csn Z)) (wa (wceq c_pl (csn (cop (cop Z Z) Z))) (wceq c_as (csn (cop (cop Z Z) Z))))) $;

--| The only ring with a base set consisting of one element is the zero ring (at least if its operations are internal binary operations). (Contributed by FL, 13-Feb-2010.) (Revised by AV, 18-Jun-2026.)
theorem rng1zr (B2 c_pl R c_as Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_as (cfv R cmulr) $ >
  $ wi (wa (w3a (wcel R crng) (wfn c_pl (cxp B2 B2)) (wfn c_as (cxp B2 B2))) (wcel Z B2)) (wb (wceq B2 (csn Z)) (wa (wceq c_pl (csn (cop (cop Z Z) Z))) (wceq c_as (csn (cop (cop Z Z) Z))))) $;

--| The only ring with one element is the zero ring (at least if its operations are internal binary operations). (Contributed by FL, 14-Feb-2010.) (Revised by AV, 18-Jun-2026.)
theorem rngen1zr (B2 c_pl R c_as Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_as (cfv R cmulr) $ >
  $ wi (wa (w3a (wcel R crng) (wfn c_pl (cxp B2 B2)) (wfn c_as (cxp B2 B2))) (wcel Z B2)) (wb (wbr B2 c1o cen) (wa (wceq c_pl (csn (cop (cop Z Z) Z))) (wceq c_as (csn (cop (cop Z Z) Z))))) $;

--| The only ring with one element is the zero ring (at least if its operations are internal binary operations). (Contributed by FL, 15-Feb-2010.) (Revised by AV, 18-Jun-2026.)
theorem rngen1zr0 (B2 c_pl R c_as c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_as (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel R crng) (wfn c_pl (cxp B2 B2)) (wfn c_as (cxp B2 B2))) (wb (wbr B2 c1o cen) (wa (wceq c_pl (csn (cop (cop c_0 c_0) c_0))) (wceq c_as (csn (cop (cop c_0 c_0) c_0))))) $;

--| Extend class notation with ring unity.
term cur: class;

--| Define the multiplicative identity, i.e., the monoid identity ( ~ df-0g ) of the multiplicative monoid ( ~ df-mgp ) of a ring-like structure. This multiplicative identity is also called "ring unity" or "unity element". This definition works by transferring the multiplicative operation from the ` .r ` slot to the ` +g ` slot and then looking at the element which is then the ` 0g ` element, that is an identity with respect to the operation which started out in the ` .r ` slot. See also ~ dfur2 , which derives the "traditional" definition as the unique element of a ring which is left- and right-neutral under multiplication. (Contributed by NM, 27-Aug-2011.) (Revised by Mario Carneiro, 27-Dec-2014.)
axiom df_ur:
  $ wceq cur (ccom c0g cmgp) $;

--| The value of the unity element of a ring. (Contributed by NM, 27-Aug-2011.) (Revised by Mario Carneiro, 27-Dec-2014.)
theorem ringidval (R c_1 G: class):
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_1 (cfv G c0g) $;

--| The multiplicative identity is the unique element of the ring that is left- and right-neutral on all elements under multiplication. (Contributed by Mario Carneiro, 10-Jan-2015.)
theorem dfur2 {x3 e: setvar} (B2 R: class) (c_x c_1: class x3 e):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_1 (cio e (wa (wcel (cv e) B2) (wral x3 (wa (wceq (co (cv e) (cv x3) c_x) (cv x3)) (wceq (co (cv x3) (cv e) c_x) (cv x3))) B2))) $;

--| Deduce the unity element of a ring from its properties. (Contributed by Thierry Arnoux, 6-Sep-2016.)
theorem ringurd {x3: setvar} (ph: wff) (B2 R c_x c_1: class):
  $ wi ph (wceq B2 (cfv R cbs)) $ >
  $ wi ph (wceq c_x (cfv R cmulr)) $ >
  $ wi ph (wcel c_1 B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wceq (co c_1 (cv x3) c_x) (cv x3)) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wceq (co (cv x3) c_1 c_x) (cv x3)) $ >
  $ wi ph (wceq c_1 (cfv R cur)) $;

--| Extend class notation with the class of all semirings.
term csrg: class;

--| Define class of all semirings. A semiring is a set equipped with two everywhere-defined internal operations, whose first one is an additive commutative monoid structure and the second one is a multiplicative monoid structure, and where multiplication is (left- and right-) distributive over addition. Like with rings ( ~ df-ring ), the additive identity is an absorbing element of the multiplicative law, but in the case of semirings, this has to be part of the definition, as it cannot be deduced from distributivity alone. Definition of [Golan] p. 1. Note that our semirings are unital. Such semirings are sometimes called "rigs", being "rings without negatives". (Contributed by Thierry Arnoux, 21-Mar-2018.)
axiom df_srg {x3 y1 z t f2 n r p: setvar}:
  $ wceq csrg (crab f2 (wa (wcel (cfv (cv f2) cmgp) cmnd) (wsbc r (wsbc p (wsbc t (wsbc n (wral x3 (wa (wral y1 (wral z (wa (wceq (co (cv x3) (co (cv y1) (cv z) (cv p)) (cv t)) (co (co (cv x3) (cv y1) (cv t)) (co (cv x3) (cv z) (cv t)) (cv p))) (wceq (co (co (cv x3) (cv y1) (cv p)) (cv z) (cv t)) (co (co (cv x3) (cv z) (cv t)) (co (cv y1) (cv z) (cv t)) (cv p)))) (cv r)) (cv r)) (wa (wceq (co (cv n) (cv x3) (cv t)) (cv n)) (wceq (co (cv x3) (cv n) (cv t)) (cv n)))) (cv r)) (cfv (cv f2) c0g)) (cfv (cv f2) cmulr)) (cfv (cv f2) cplusg)) (cfv (cv f2) cbs))) ccmn) $;

--| The predicate "is a semiring". (Contributed by Thierry Arnoux, 21-Mar-2018.)
theorem issrg {x3 y1 z: setvar} (B2 c_pl R c_x: class) (G: class x3 y1 z) (c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wb (wcel R csrg) (w3a (wcel R ccmn) (wcel G cmnd) (wral x3 (wa (wral y1 (wral z (wa (wceq (co (cv x3) (co (cv y1) (cv z) c_pl) c_x) (co (co (cv x3) (cv y1) c_x) (co (cv x3) (cv z) c_x) c_pl)) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_x) (co (co (cv x3) (cv z) c_x) (co (cv y1) (cv z) c_x) c_pl))) B2) B2) (wa (wceq (co c_0 (cv x3) c_x) c_0) (wceq (co (cv x3) c_0 c_x) c_0))) B2)) $;

--| A semiring is a commutative monoid. (Contributed by Thierry Arnoux, 21-Mar-2018.)
theorem srgcmn (R: class):
  $ wi (wcel R csrg) (wcel R ccmn) $;

--| A semiring is a monoid. (Contributed by Thierry Arnoux, 21-Mar-2018.)
theorem srgmnd (R: class):
  $ wi (wcel R csrg) (wcel R cmnd) $;

--| A semiring is a monoid under multiplication. (Contributed by Thierry Arnoux, 21-Mar-2018.)
theorem srgmgp (R G: class):
  $ wceq G (cfv R cmgp) $ >
  $ wi (wcel R csrg) (wcel G cmnd) $;

--| Lemma for ~ srgdi and ~ srgdir . (Contributed by NM, 26-Aug-2011.) (Revised by Mario Carneiro, 6-Jan-2015.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem srgdilem (B2 c_pl R c_x X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R csrg) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wa (wceq (co X (co Y Z c_pl) c_x) (co (co X Y c_x) (co X Z c_x) c_pl)) (wceq (co (co X Y c_pl) Z c_x) (co (co X Z c_x) (co Y Z c_x) c_pl))) $;

--| Closure of the multiplication operation of a semiring. (Contributed by NM, 26-Aug-2011.) (Revised by Mario Carneiro, 6-Jan-2015.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem srgcl (B2 R c_x X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R csrg) (wcel X B2) (wcel Y B2)) (wcel (co X Y c_x) B2) $;

--| Associative law for the multiplication operation of a semiring. (Contributed by NM, 27-Aug-2011.) (Revised by Mario Carneiro, 6-Jan-2015.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem srgass (B2 R c_x X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R csrg) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wceq (co (co X Y c_x) Z c_x) (co X (co Y Z c_x) c_x)) $;

--| The unity element of a semiring is unique. (Contributed by NM, 27-Aug-2011.) (Revised by Mario Carneiro, 6-Jan-2015.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem srgideu {x3 u: setvar} (B2 R c_x: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wcel R csrg) (wreu u (wral x3 (wa (wceq (co (cv u) (cv x3) c_x) (cv x3)) (wceq (co (cv x3) (cv u) c_x) (cv x3))) B2) B2) $;

--| Functionality of the multiplication operation of a ring. (Contributed by Steve Rodriguez, 9-Sep-2007.) (Revised by AV, 24-Aug-2021.)
theorem srgfcl (B2 R c_x: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R csrg) (wfn c_x (cxp B2 B2))) (wf (cxp B2 B2) B2 c_x) $;

--| Distributive law for the multiplication operation of a semiring. (Contributed by Steve Rodriguez, 9-Sep-2007.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem srgdi (B2 c_pl R c_x X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R csrg) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wceq (co X (co Y Z c_pl) c_x) (co (co X Y c_x) (co X Z c_x) c_pl)) $;

--| Distributive law for the multiplication operation of a semiring. (Contributed by Steve Rodriguez, 9-Sep-2007.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem srgdir (B2 c_pl R c_x X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R csrg) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wceq (co (co X Y c_pl) Z c_x) (co (co X Z c_x) (co Y Z c_x) c_pl)) $;

--| The unity element of a semiring belongs to the base set of the semiring. (Contributed by NM, 27-Aug-2011.) (Revised by Mario Carneiro, 27-Dec-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem srgidcl (B2 R c_1: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R csrg) (wcel c_1 B2) $;

--| The zero element of a semiring belongs to its base set. (Contributed by Mario Carneiro, 12-Jan-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem srg0cl (B2 R c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R csrg) (wcel c_0 B2) $;

--| Lemma for ~ srglidm and ~ srgridm . (Contributed by NM, 15-Sep-2011.) (Revised by Mario Carneiro, 27-Dec-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem srgidmlem (B2 R c_x c_1 X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R csrg) (wcel X B2)) (wa (wceq (co c_1 X c_x) X) (wceq (co X c_1 c_x) X)) $;

--| The unity element of a semiring is a left multiplicative identity. (Contributed by NM, 15-Sep-2011.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem srglidm (B2 R c_x c_1 X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R csrg) (wcel X B2)) (wceq (co c_1 X c_x) X) $;

--| The unity element of a semiring is a right multiplicative identity. (Contributed by NM, 15-Sep-2011.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem srgridm (B2 R c_x c_1 X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R csrg) (wcel X B2)) (wceq (co X c_1 c_x) X) $;

--| Properties showing that an element ` I ` is the unity element of a semiring. (Contributed by NM, 7-Aug-2013.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem issrgid {x3: setvar} (B2 R c_x c_1 I: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R csrg) (wb (wa (wcel I B2) (wral x3 (wa (wceq (co I (cv x3) c_x) (cv x3)) (wceq (co (cv x3) I c_x) (cv x3))) B2)) (wceq c_1 I)) $;

--| Closure of the addition operation of a semiring. (Contributed by Mario Carneiro, 14-Jan-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem srgacl (B2 c_pl R X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (w3a (wcel R csrg) (wcel X B2) (wcel Y B2)) (wcel (co X Y c_pl) B2) $;

--| Commutativity of the additive group of a semiring. (Contributed by Thierry Arnoux, 1-Apr-2018.)
theorem srgcom (B2 c_pl R X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (w3a (wcel R csrg) (wcel X B2) (wcel Y B2)) (wceq (co X Y c_pl) (co Y X c_pl)) $;

--| The zero of a semiring is a right-absorbing element. (Contributed by Thierry Arnoux, 1-Apr-2018.)
theorem srgrz (B2 R c_x X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R csrg) (wcel X B2)) (wceq (co X c_0 c_x) c_0) $;

--| The zero of a semiring is a left-absorbing element. (Contributed by AV, 23-Aug-2019.)
theorem srglz (B2 R c_x X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R csrg) (wcel X B2)) (wceq (co c_0 X c_x) c_0) $;

--| In a semiring, the only left-absorbing element is the additive identity. Remark in [Golan] p. 1. (Contributed by Thierry Arnoux, 1-May-2018.)
theorem srgisid {x3: setvar} (ph: wff) (B2 R c_x c_0 Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R csrg) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wceq (co Z (cv x3) c_x) Z) $ >
  $ wi ph (wceq Z c_0) $;

--| An element of a ring-like structure plus itself is two times the element. "Two" in such a structure is the sum of the unity element with itself. This (formerly) part of the proof for ~ ringcom depends on the (right) distributivity and the existence of a (left) multiplicative identity only. (Contributed by G&eacute;rard Lang, 4-Dec-2014.) (Revised by AV, 1-Feb-2025.)
theorem o2timesd {x3 y1 z: setvar} (ph: wff x3 y1 z) (B2 c_pl c_x c_1 X: class):
  $ wi ph (wral x3 (wral y1 (wral z (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_x) (co (co (cv x3) (cv z) c_x) (co (cv y1) (cv z) c_x) c_pl)) B2) B2) B2) $ >
  $ wi ph (wcel c_1 B2) $ >
  $ wi ph (wral x3 (wceq (co c_1 (cv x3) c_x) (cv x3)) B2) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (co X X c_pl) (co (co c_1 c_1 c_pl) X c_x)) $;

--| Restricted commutativity of the addition in a ring-like structure. This (formerly) part of the proof for ~ ringcom depends on the closure of the addition, the (left and right) distributivity and the existence of a (left) multiplicative identity only. (Contributed by G&eacute;rard Lang, 4-Dec-2014.) (Revised by AV, 1-Feb-2025.)
theorem rglcom4d {x3 y1 z: setvar} (ph: wff x3 y1 z) (B2 c_pl c_x c_1 X Y: class):
  $ wi ph (wral x3 (wral y1 (wral z (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_x) (co (co (cv x3) (cv z) c_x) (co (cv y1) (cv z) c_x) c_pl)) B2) B2) B2) $ >
  $ wi ph (wcel c_1 B2) $ >
  $ wi ph (wral x3 (wceq (co c_1 (cv x3) c_x) (cv x3)) B2) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) c_pl) B2) B2) B2) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wceq (co (cv x3) (co (cv y1) (cv z) c_pl) c_x) (co (co (cv x3) (cv y1) c_x) (co (cv x3) (cv z) c_x) c_pl)) B2) B2) B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co (co X X c_pl) (co Y Y c_pl) c_pl) (co (co X Y c_pl) (co X Y c_pl) c_pl)) $;

--| A semiring element plus itself is two times the element. "Two" in an arbitrary (unital) semiring is the sum of the unity element with itself. (Contributed by AV, 24-Aug-2021.) Variant of ~ o2timesd for semirings. (Revised by AV, 1-Feb-2025.)
theorem srgo2times (A2 B2 c_pl R c_x c_1: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R csrg) (wcel A2 B2)) (wceq (co A2 A2 c_pl) (co (co c_1 c_1 c_pl) A2 c_x)) $;

--| Lemma for ~ srgcom4 . This (formerly) part of the proof for ~ ringcom is applicable for semirings (without using the commutativity of the addition given per definition of a semiring). (Contributed by G&eacute;rard Lang, 4-Dec-2014.) (Revised by AV, 1-Feb-2025.) (Proof modification is discouraged.)
theorem srgcom4lem (B2 c_pl R X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (w3a (wcel R csrg) (wcel X B2) (wcel Y B2)) (wceq (co (co X X c_pl) (co Y Y c_pl) c_pl) (co (co X Y c_pl) (co X Y c_pl) c_pl)) $;

--| Restricted commutativity of the addition in semirings (without using the commutativity of the addition given per definition of a semiring). (Contributed by AV, 1-Feb-2025.) (Proof modification is discouraged.)
theorem srgcom4 (B2 c_pl R X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (w3a (wcel R csrg) (wcel X B2) (wcel Y B2)) (wceq (co (co X (co X Y c_pl) c_pl) Y c_pl) (co (co X (co Y X c_pl) c_pl) Y c_pl)) $;

--| The only semiring with a base set consisting of one element is the zero ring (at least if its operations are internal binary operations). (Contributed by FL, 13-Feb-2010.) (Revised by AV, 25-Jan-2020.) (Proof shortened by AV, 19-Jun-2026.)
theorem srg1zr (B2 c_pl R c_as Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_as (cfv R cmulr) $ >
  $ wi (wa (w3a (wcel R csrg) (wfn c_pl (cxp B2 B2)) (wfn c_as (cxp B2 B2))) (wcel Z B2)) (wb (wceq B2 (csn Z)) (wa (wceq c_pl (csn (cop (cop Z Z) Z))) (wceq c_as (csn (cop (cop Z Z) Z))))) $;

--| The only semiring with one element is the zero ring (at least if its operations are internal binary operations). (Contributed by FL, 14-Feb-2010.) (Revised by AV, 25-Jan-2020.)
theorem srgen1zr0 (B2 c_pl R c_as Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_as (cfv R cmulr) $ >
  $ wceq Z (cfv R c0g) $ >
  $ wi (w3a (wcel R csrg) (wfn c_pl (cxp B2 B2)) (wfn c_as (cxp B2 B2))) (wb (wbr B2 c1o cen) (wa (wceq c_pl (csn (cop (cop Z Z) Z))) (wceq c_as (csn (cop (cop Z Z) Z))))) $;

--| An associative property between group multiple and ring multiplication for semirings. (Contributed by AV, 23-Aug-2019.)
theorem srgmulgass (B2 R c_x c_xp N X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wi (wa (wcel R csrg) (w3a (wcel N cn0) (wcel X B2) (wcel Y B2))) (wceq (co (co N X c_x) Y c_xp) (co N (co X Y c_xp) c_x)) $;

--| If two elements of a semiring commute, they also commute if one of the elements is raised to a higher power. (Contributed by AV, 23-Aug-2019.)
theorem srgpcomp (ph: wff) (A2 B2 R S c_xp c_ex G K: class):
  $ wceq S (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel R csrg) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel K cn0) $ >
  $ wi ph (wceq (co A2 B2 c_xp) (co B2 A2 c_xp)) $ >
  $ wi ph (wceq (co (co K B2 c_ex) A2 c_xp) (co A2 (co K B2 c_ex) c_xp)) $;

--| If two elements of a semiring commute, they also commute if the elements are raised to a higher power. (Contributed by AV, 23-Aug-2019.)
theorem srgpcompp (ph: wff) (A2 B2 R S c_xp c_ex G K N: class):
  $ wceq S (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel R csrg) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel K cn0) $ >
  $ wi ph (wceq (co A2 B2 c_xp) (co B2 A2 c_xp)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co (co (co N A2 c_ex) (co K B2 c_ex) c_xp) A2 c_xp) (co (co (co N c1 caddc) A2 c_ex) (co K B2 c_ex) c_xp)) $;

--| If two elements of a semiring commute, they also commute if the elements are raised to a higher power and a scalar multiplication is involved. (Contributed by AV, 23-Aug-2019.)
theorem srgpcomppsc (ph: wff) (A2 B2 C R S c_x c_xp c_ex G K N: class):
  $ wceq S (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel R csrg) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel K cn0) $ >
  $ wi ph (wceq (co A2 B2 c_xp) (co B2 A2 c_xp)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wi ph (wcel C cn0) $ >
  $ wi ph (wceq (co (co C (co (co N A2 c_ex) (co K B2 c_ex) c_xp) c_x) A2 c_xp) (co C (co (co (co N c1 caddc) A2 c_ex) (co K B2 c_ex) c_xp) c_x)) $;

--| Left-multiplication in a semiring by a fixed element of the ring is a monoid homomorphism, analogous to ~ ringlghm . (Contributed by AV, 23-Aug-2019.)
theorem srglmhm {x3: setvar} (B2 R c_x X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R csrg) (wcel X B2)) (wcel (cmpt x3 B2 (co X (cv x3) c_x)) (co R R cmhm)) $;

--| Right-multiplication in a semiring by a fixed element of the ring is a monoid homomorphism, analogous to ~ ringrghm . (Contributed by AV, 23-Aug-2019.)
theorem srgrmhm {x3: setvar} (B2 R c_x X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R csrg) (wcel X B2)) (wcel (cmpt x3 B2 (co (cv x3) X c_x)) (co R R cmhm)) $;

--| A finite semiring sum multiplied by a constant, analogous to ~ gsummulc1 . (Contributed by AV, 23-Aug-2019.)
theorem srgsummulcr {k: setvar} (ph: wff) (A2 B2: class) (c_pl R: class k) (c_x: class) (V X: class k) (Y: class) (c_0: class k):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R csrg) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel X B2) $ >
  $ wi ph (wbr (cmpt k A2 X) c_0 cfsupp) $ >
  $ wi ph (wceq (co R (cmpt k A2 (co X Y c_x)) cgsu) (co (co R (cmpt k A2 X) cgsu) Y c_x)) $;

--| A finite semiring sum multiplied by a constant, analogous to ~ gsummulc2 . (Contributed by AV, 23-Aug-2019.)
theorem sgsummulcl {k: setvar} (ph: wff) (A2 B2: class) (c_pl R: class k) (c_x: class) (V X: class k) (Y: class) (c_0: class k):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R csrg) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel X B2) $ >
  $ wi ph (wbr (cmpt k A2 X) c_0 cfsupp) $ >
  $ wi ph (wceq (co R (cmpt k A2 (co Y X c_x)) cgsu) (co Y (co R (cmpt k A2 X) cgsu) c_x)) $;

--| The exponentiation (by a nonnegative integer) of the multiplicative identity of a semiring, analogous to ~ mulgnn0z . (Contributed by AV, 25-Nov-2019.)
theorem srg1expzeq1 (R c_x c_1 G N: class):
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_x (cfv G cmg) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R csrg) (wcel N cn0)) (wceq (co N c_1 c_x) c_1) $;

--| Lemma 1 for ~ srgbinomlem . (Contributed by AV, 23-Aug-2019.)
theorem srgbinomlem1 (ph: wff) (A2 B2 D c_pl R S c_x c_xp E c_ex G N: class):
  $ wceq S (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel R csrg) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wceq (co A2 B2 c_xp) (co B2 A2 c_xp)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi (wa ph (wa (wcel D cn0) (wcel E cn0))) (wcel (co (co D A2 c_ex) (co E B2 c_ex) c_xp) S) $;

--| Lemma 2 for ~ srgbinomlem . (Contributed by AV, 23-Aug-2019.)
theorem srgbinomlem2 (ph: wff) (A2 B2 C D c_pl R S c_x c_xp E c_ex G N: class):
  $ wceq S (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel R csrg) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wceq (co A2 B2 c_xp) (co B2 A2 c_xp)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi (wa ph (w3a (wcel C cn0) (wcel D cn0) (wcel E cn0))) (wcel (co C (co (co D A2 c_ex) (co E B2 c_ex) c_xp) c_x) S) $;

--| Lemma 3 for ~ srgbinomlem . (Contributed by AV, 23-Aug-2019.) (Proof shortened by AV, 27-Oct-2019.)
theorem srgbinomlem3 {k: setvar} (ph: wff) (ps: wff k) (A2 B2: class) (c_pl: class k) (R S c_x c_xp c_ex: class) (G: class k) (N: class):
  $ wceq S (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel R csrg) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wceq (co A2 B2 c_xp) (co B2 A2 c_xp)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ps (wceq (co N (co A2 B2 c_pl) c_ex) (co R (cmpt k (co cc0 N cfz) (co (co N (cv k) cbc) (co (co (co N (cv k) cmin) A2 c_ex) (co (cv k) B2 c_ex) c_xp) c_x)) cgsu)) $ >
  $ wi (wa ph ps) (wceq (co (co N (co A2 B2 c_pl) c_ex) A2 c_xp) (co R (cmpt k (co cc0 (co N c1 caddc) cfz) (co (co N (cv k) cbc) (co (co (co (co N c1 caddc) (cv k) cmin) A2 c_ex) (co (cv k) B2 c_ex) c_xp) c_x)) cgsu)) $;

--| Lemma 4 for ~ srgbinomlem . (Contributed by AV, 24-Aug-2019.) (Proof shortened by AV, 19-Nov-2019.)
theorem srgbinomlem4 {k: setvar} (ph: wff) (ps: wff k) (A2 B2: class) (c_pl: class k) (R S c_x c_xp c_ex: class) (G: class k) (N: class):
  $ wceq S (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel R csrg) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wceq (co A2 B2 c_xp) (co B2 A2 c_xp)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ps (wceq (co N (co A2 B2 c_pl) c_ex) (co R (cmpt k (co cc0 N cfz) (co (co N (cv k) cbc) (co (co (co N (cv k) cmin) A2 c_ex) (co (cv k) B2 c_ex) c_xp) c_x)) cgsu)) $ >
  $ wi (wa ph ps) (wceq (co (co N (co A2 B2 c_pl) c_ex) B2 c_xp) (co R (cmpt k (co cc0 (co N c1 caddc) cfz) (co (co N (co (cv k) c1 cmin) cbc) (co (co (co (co N c1 caddc) (cv k) cmin) A2 c_ex) (co (cv k) B2 c_ex) c_xp) c_x)) cgsu)) $;

--| Lemma for ~ srgbinom . Inductive step, analogous to ~ binomlem . (Contributed by AV, 24-Aug-2019.)
theorem srgbinomlem {k: setvar} (ph: wff) (ps: wff k) (A2 B2 c_pl R S c_x c_xp c_ex: class) (G: class k) (N: class):
  $ wceq S (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel R csrg) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wceq (co A2 B2 c_xp) (co B2 A2 c_xp)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ps (wceq (co N (co A2 B2 c_pl) c_ex) (co R (cmpt k (co cc0 N cfz) (co (co N (cv k) cbc) (co (co (co N (cv k) cmin) A2 c_ex) (co (cv k) B2 c_ex) c_xp) c_x)) cgsu)) $ >
  $ wi (wa ph ps) (wceq (co (co N c1 caddc) (co A2 B2 c_pl) c_ex) (co R (cmpt k (co cc0 (co N c1 caddc) cfz) (co (co (co N c1 caddc) (cv k) cbc) (co (co (co (co N c1 caddc) (cv k) cmin) A2 c_ex) (co (cv k) B2 c_ex) c_xp) c_x)) cgsu)) $;

--| The binomial theorem for commuting elements of a semiring: ` ( A + B ) ^ N ` is the sum from ` k = 0 ` to ` N ` of ` ( N _C k ) x. ( ( A ^ k ) x. ( B ^ ( N - k ) ) ` (generalization of ~ binom ). (Contributed by AV, 24-Aug-2019.)
theorem srgbinom {k: setvar} (A2 B2 c_pl R S c_x c_xp c_ex: class) (G: class k) (N: class):
  $ wceq S (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi (wa (wa (wcel R csrg) (wcel N cn0)) (w3a (wcel A2 S) (wcel B2 S) (wceq (co A2 B2 c_xp) (co B2 A2 c_xp)))) (wceq (co N (co A2 B2 c_pl) c_ex) (co R (cmpt k (co cc0 N cfz) (co (co N (cv k) cbc) (co (co (co N (cv k) cmin) A2 c_ex) (co (cv k) B2 c_ex) c_xp) c_x)) cgsu)) $;

--| The binomial theorem for commutative semirings. (Contributed by AV, 24-Aug-2019.)
theorem csrgbinom {k: setvar} (A2 B2 c_pl R S c_x c_xp c_ex: class) (G: class k) (N: class):
  $ wceq S (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi (wa (w3a (wcel R csrg) (wcel G ccmn) (wcel N cn0)) (wa (wcel A2 S) (wcel B2 S))) (wceq (co N (co A2 B2 c_pl) c_ex) (co R (cmpt k (co cc0 N cfz) (co (co N (cv k) cbc) (co (co (co N (cv k) cmin) A2 c_ex) (co (cv k) B2 c_ex) c_xp) c_x)) cgsu)) $;

--| Extend class notation with class of all (unital) rings.
term crg: class;

--| Extend class notation with class of all (unital) commutative rings.
term ccrg: class;

--| Define class of all (unital) rings. A unital ring is a set equipped with two everywhere-defined internal operations, whose first one is an additive group structure and the second one is a multiplicative monoid structure, and where the addition is left- and right-distributive for the multiplication. Definition 1 in [BourbakiAlg1] p. 92 or definition of a ring with identity in part Preliminaries of [Roman] p. 19. So that the additive structure must be abelian (see ~ ringcom ), care must be taken that in the case of a non-unital ring, the commutativity of addition must be postulated and cannot be proved from the other conditions. Therefore, it can be shown that a unital ring is a non-unital ring ( ~ ringrng ) only after ~ ringabl was proven. (Contributed by NM, 18-Oct-2012.) (Revised by Mario Carneiro, 27-Dec-2014.)
axiom df_ring {x3 y1 z t f2 r p: setvar}:
  $ wceq crg (crab f2 (wa (wcel (cfv (cv f2) cmgp) cmnd) (wsbc r (wsbc p (wsbc t (wral x3 (wral y1 (wral z (wa (wceq (co (cv x3) (co (cv y1) (cv z) (cv p)) (cv t)) (co (co (cv x3) (cv y1) (cv t)) (co (cv x3) (cv z) (cv t)) (cv p))) (wceq (co (co (cv x3) (cv y1) (cv p)) (cv z) (cv t)) (co (co (cv x3) (cv z) (cv t)) (co (cv y1) (cv z) (cv t)) (cv p)))) (cv r)) (cv r)) (cv r)) (cfv (cv f2) cmulr)) (cfv (cv f2) cplusg)) (cfv (cv f2) cbs))) cgrp) $;

--| Define class of all commutative rings. (Contributed by Mario Carneiro, 7-Jan-2015.)
axiom df_cring {f2: setvar}:
  $ wceq ccrg (crab f2 (wcel (cfv (cv f2) cmgp) ccmn) crg) $;

--| The predicate "is a (unital) ring". Definition of "ring with unit" in [Schechter] p. 187. (Contributed by NM, 18-Oct-2012.) (Revised by Mario Carneiro, 6-Jan-2015.)
theorem isring {x3 y1 z: setvar} (B2 c_pl R c_x: class) (G: class x3 y1 z):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wb (wcel R crg) (w3a (wcel R cgrp) (wcel G cmnd) (wral x3 (wral y1 (wral z (wa (wceq (co (cv x3) (co (cv y1) (cv z) c_pl) c_x) (co (co (cv x3) (cv y1) c_x) (co (cv x3) (cv z) c_x) c_pl)) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_x) (co (co (cv x3) (cv z) c_x) (co (cv y1) (cv z) c_x) c_pl))) B2) B2) B2)) $;

--| A ring is a group. (Contributed by Steve Rodriguez, 9-Sep-2007.) (Revised by NM, 15-Sep-2011.)
theorem ringgrp (R: class):
  $ wi (wcel R crg) (wcel R cgrp) $;

--| A ring is a monoid under multiplication. (Contributed by Mario Carneiro, 6-Jan-2015.)
theorem ringmgp (R G: class):
  $ wceq G (cfv R cmgp) $ >
  $ wi (wcel R crg) (wcel G cmnd) $;

--| A commutative ring is a ring whose multiplication is a commutative monoid. (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem iscrng (R G: class):
  $ wceq G (cfv R cmgp) $ >
  $ wb (wcel R ccrg) (wa (wcel R crg) (wcel G ccmn)) $;

--| A commutative ring's multiplication operation is commutative. (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem crngmgp (R G: class):
  $ wceq G (cfv R cmgp) $ >
  $ wi (wcel R ccrg) (wcel G ccmn) $;

--| The base set of a ring is not empty. (Contributed by FL, 24-Jan-2010.) (Revised by AV, 25-Aug-2011.)
theorem ringbn0 (B2 G: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wi (wcel G crg) (wne B2 c0) $;

--| A ring is a group. (Contributed by SN, 16-May-2024.)
theorem ringgrpd (ph: wff) (R: class):
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel R cgrp) $;

--| A ring is a monoid under addition. (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem ringmnd (R: class):
  $ wi (wcel R crg) (wcel R cmnd) $;

--| A ring is a magma. (Contributed by AV, 31-Jan-2020.)
theorem ringmgm (R: class):
  $ wi (wcel R crg) (wcel R cmgm) $;

--| A commutative ring is a ring. (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem crngring (R: class):
  $ wi (wcel R ccrg) (wcel R crg) $;

--| A commutative ring is a ring. (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by SN, 16-May-2024.)
theorem crngringd (ph: wff) (R: class):
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel R crg) $;

--| A commutative ring is a group. (Contributed by SN, 16-May-2024.)
theorem crnggrpd (ph: wff) (R: class):
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel R cgrp) $;

--| Restricted functionality of the multiplicative group on rings. (Contributed by Mario Carneiro, 11-Mar-2015.)
theorem mgpf:
  $ wf crg cmnd (cres cmgp crg) $;

--| Properties of a unital ring. (Contributed by NM, 26-Aug-2011.) (Revised by Mario Carneiro, 6-Jan-2015.)
theorem ringdilem (B2 c_pl R c_x X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crg) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wa (wceq (co X (co Y Z c_pl) c_x) (co (co X Y c_x) (co X Z c_x) c_pl)) (wceq (co (co X Y c_pl) Z c_x) (co (co X Z c_x) (co Y Z c_x) c_pl))) $;

--| Closure of the multiplication operation of a ring. (Contributed by Steve Rodriguez, 9-Sep-2007.) (Revised by NM, 26-Aug-2011.) (Revised by Mario Carneiro, 6-Jan-2015.)
theorem ringcl (B2 R c_x X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R crg) (wcel X B2) (wcel Y B2)) (wcel (co X Y c_x) B2) $;

--| A commutative ring's multiplication operation is commutative. (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem crngcom (B2 R c_x X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R ccrg) (wcel X B2) (wcel Y B2)) (wceq (co X Y c_x) (co Y X c_x)) $;

--| A commutative ring is a ring whose multiplication is a commutative monoid. (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem iscrng2 {x3 y1: setvar} (B2 R: class) (c_x: class x3 y1):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wb (wcel R ccrg) (wa (wcel R crg) (wral x3 (wral y1 (wceq (co (cv x3) (cv y1) c_x) (co (cv y1) (cv x3) c_x)) B2) B2)) $;

--| Associative law for multiplication in a ring. (Contributed by Steve Rodriguez, 9-Sep-2007.) (Revised by NM, 27-Aug-2011.) (Revised by Mario Carneiro, 6-Jan-2015.)
theorem ringass (B2 R c_x X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crg) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wceq (co (co X Y c_x) Z c_x) (co X (co Y Z c_x) c_x)) $;

--| The unity element of a ring is unique. (Contributed by NM, 4-Apr-2009.) (Revised by NM, 27-Aug-2011.) (Revised by Mario Carneiro, 6-Jan-2015.)
theorem ringideu {x3 u: setvar} (B2 R c_x: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wcel R crg) (wreu u (wral x3 (wa (wceq (co (cv u) (cv x3) c_x) (cv x3)) (wceq (co (cv x3) (cv u) c_x) (cv x3))) B2) B2) $;

--| Multiplication is commutative in a commutative ring. (Contributed by SN, 8-Mar-2025.)
theorem crngcomd (ph: wff) (B2 R c_x X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co X Y c_x) (co Y X c_x)) $;

--| The base set of a commutative ring is its center. (Contributed by SN, 21-Mar-2025.)
theorem crngbascntr (B2 G Z: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq Z (cfv (cfv G cmgp) ccntr) $ >
  $ wi (wcel G ccrg) (wceq B2 Z) $;

--| Closure of the multiplication operation of a ring. (Contributed by SN, 29-Jul-2024.)
theorem ringcld (ph: wff) (B2 R c_x X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel (co X Y c_x) B2) $;

--| Associative law for multiplication in a ring. (Contributed by SN, 14-Aug-2024.)
theorem ringassd (ph: wff) (B2 R c_x X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wceq (co (co X Y c_x) Z c_x) (co X (co Y Z c_x) c_x)) $;

--| Commutative/associative law that swaps the first two factors in a triple product in a commutative ring. See also ~ mul12d . (Contributed by SN, 8-Mar-2025.)
theorem crng12d (ph: wff) (B2 R c_x X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wceq (co X (co Y Z c_x) c_x) (co Y (co X Z c_x) c_x)) $;

--| Commutative/associative law that swaps the last two factors in a triple product in a commutative ring. See also ~ mul32d . (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by Thierry Arnoux, 4-May-2025.)
theorem crng32d (ph: wff) (B2 R c_x X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wceq (co (co X Y c_x) Z c_x) (co (co X Z c_x) Y c_x)) $;

--| Commutative/associative law for commutative rings. See also ~ mul4d . (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by AV, 20-Jul-2026.)
theorem crng4 (ph: wff) (B2 R c_x U X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wceq (co (co X Y c_x) (co Z U c_x) c_x) (co (co X Z c_x) (co Y U c_x) c_x)) $;

--| Distributive law for the multiplication operation of a ring (left-distributivity). (Contributed by Steve Rodriguez, 9-Sep-2007.)
theorem ringdi (B2 c_pl R c_x X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crg) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wceq (co X (co Y Z c_pl) c_x) (co (co X Y c_x) (co X Z c_x) c_pl)) $;

--| Distributive law for the multiplication operation of a ring (right-distributivity). (Contributed by Steve Rodriguez, 9-Sep-2007.)
theorem ringdir (B2 c_pl R c_x X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crg) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wceq (co (co X Y c_pl) Z c_x) (co (co X Z c_x) (co Y Z c_x) c_pl)) $;

--| Distributive law for the multiplication operation of a ring (left-distributivity). (Contributed by Thierry Arnoux, 4-May-2025.)
theorem ringdid (ph: wff) (B2 c_pl R c_x X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wceq (co X (co Y Z c_pl) c_x) (co (co X Y c_x) (co X Z c_x) c_pl)) $;

--| Distributive law for the multiplication operation of a ring (right-distributivity). (Contributed by Thierry Arnoux, 4-May-2025.)
theorem ringdird (ph: wff) (B2 c_pl R c_x X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wceq (co (co X Y c_pl) Z c_x) (co (co X Z c_x) (co Y Z c_x) c_pl)) $;

--| Expand the product of two sums in a ring. (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem ringdi22 (ph: wff) (B2 c_pl R T c_x X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel T B2) $ >
  $ wi ph (wceq (co (co X Y c_pl) (co Z T c_pl) c_x) (co (co (co X Z c_x) (co Y Z c_x) c_pl) (co (co X T c_x) (co Y T c_x) c_pl) c_pl)) $;

--| The unity element of a ring belongs to the base set of the ring. (Contributed by FL, 12-Feb-2010.) (Revised by NM, 27-Aug-2011.) (Revised by Mario Carneiro, 27-Dec-2014.)
theorem ringidcl (B2 R c_1: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R crg) (wcel c_1 B2) $;

--| The unity element of a ring belongs to the base set of the ring, deduction version. (Contributed by SN, 16-Oct-2025.)
theorem ringidcld (ph: wff) (B2 R c_1: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel c_1 B2) $;

--| The zero element of a ring belongs to its base set. (Contributed by Mario Carneiro, 12-Jan-2014.)
theorem ring0cl (B2 R c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R crg) (wcel c_0 B2) $;

--| Lemma for ~ ringlidm and ~ ringridm . (Contributed by FL, 18-Feb-2010.) (Revised by NM, 15-Sep-2011.) (Revised by Mario Carneiro, 27-Dec-2014.)
theorem ringidmlem (B2 R c_x c_1 X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wcel X B2)) (wa (wceq (co c_1 X c_x) X) (wceq (co X c_1 c_x) X)) $;

--| The unity element of a ring is a left multiplicative identity. (Contributed by FL, 18-Apr-2010.) (Revised by NM, 15-Sep-2011.)
theorem ringlidm (B2 R c_x c_1 X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wcel X B2)) (wceq (co c_1 X c_x) X) $;

--| The unity element of a ring is a right multiplicative identity. (Contributed by FL, 18-Apr-2010.) (Revised by NM, 15-Sep-2011.)
theorem ringridm (B2 R c_x c_1 X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wcel X B2)) (wceq (co X c_1 c_x) X) $;

--| Properties showing that an element ` I ` is the unity element of a ring. (Contributed by NM, 7-Aug-2013.)
theorem isringid {x3: setvar} (B2 R c_x c_1 I: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R crg) (wb (wa (wcel I B2) (wral x3 (wa (wceq (co I (cv x3) c_x) (cv x3)) (wceq (co (cv x3) I c_x) (cv x3))) B2)) (wceq c_1 I)) $;

--| The unity element of a ring is a left multiplicative identity. (Contributed by SN, 14-Aug-2024.)
theorem ringlidmd (ph: wff) (B2 R c_x c_1 X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (co c_1 X c_x) X) $;

--| The unity element of a ring is a right multiplicative identity. (Contributed by SN, 14-Aug-2024.)
theorem ringridmd (ph: wff) (B2 R c_x c_1 X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (co X c_1 c_x) X) $;

--| The multiplication operation of a unital ring has (one or more) identity elements. (Contributed by Steve Rodriguez, 9-Sep-2007.) (Revised by Mario Carneiro, 22-Dec-2013.) (Revised by AV, 24-Aug-2021.)
theorem ringid {u: setvar} (B2 R c_x X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crg) (wcel X B2)) (wrex u (wa (wceq (co (cv u) X c_x) X) (wceq (co X (cv u) c_x) X)) B2) $;

--| A ring element plus itself is two times the element. "Two" in an arbitrary unital ring is the sum of the unity element with itself. (Contributed by AV, 24-Aug-2021.) Variant of ~ o2timesd for rings. (Revised by AV, 5-Feb-2025.)
theorem ringo2times (A2 B2 c_pl R c_x c_1: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wcel A2 B2)) (wceq (co A2 A2 c_pl) (co (co c_1 c_1 c_pl) A2 c_x)) $;

--| A ring element plus itself is two times the element. (Contributed by Steve Rodriguez, 9-Sep-2007.) (Revised by Mario Carneiro, 22-Dec-2013.) (Revised by AV, 24-Aug-2021.) (Proof shortened by AV, 1-Feb-2025.)
theorem ringadd2 {x3: setvar} (B2 c_pl R c_x X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crg) (wcel X B2)) (wrex x3 (wceq (co X X c_pl) (co (co (cv x3) (cv x3) c_pl) X c_x)) B2) $;

--| A subset of the multiplicative group has the multiplicative identity as its identity if the identity is in the subset. (Contributed by Mario Carneiro, 27-Dec-2014.) (Revised by Mario Carneiro, 30-Apr-2015.)
theorem ringidss (A2 B2 R c_1 M: class):
  $ wceq M (co (cfv R cmgp) A2 cress) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (w3a (wcel R crg) (wss A2 B2) (wcel c_1 A2)) (wceq c_1 (cfv M c0g)) $;

--| Closure of the addition operation of a ring. (Contributed by Mario Carneiro, 14-Jan-2014.)
theorem ringacl (B2 c_pl R X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (w3a (wcel R crg) (wcel X B2) (wcel Y B2)) (wcel (co X Y c_pl) B2) $;

--| Lemma for ~ ringcom . This (formerly) part of the proof for ~ ringcom is also applicable for semirings (without using the commutativity of the addition given per definition of a semiring), see ~ srgcom4lem . (Contributed by G&eacute;rard Lang, 4-Dec-2014.) Variant of ~ rglcom4d for rings. (Revised by AV, 5-Feb-2025.)
theorem ringcomlem (B2 c_pl R X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (w3a (wcel R crg) (wcel X B2) (wcel Y B2)) (wceq (co (co X X c_pl) (co Y Y c_pl) c_pl) (co (co X Y c_pl) (co X Y c_pl) c_pl)) $;

--| Commutativity of the additive group of a ring. (See also ~ lmodcom .) (Contributed by Steve Rodriguez, 9-Sep-2007.) This theorem followed originally from the definition immediately, but now is derived from other properties of a ring. This proof requires the existence of a multiplicative identity, and the existence of additive inverses. Therefore, this proof is not applicable for semirings. (Revised by G&eacute;rard Lang, 4-Dec-2014.) (Proof shortened by AV, 1-Feb-2025.)
theorem ringcom (B2 c_pl R X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (w3a (wcel R crg) (wcel X B2) (wcel Y B2)) (wceq (co X Y c_pl) (co Y X c_pl)) $;

--| A ring is an Abelian group. (Contributed by Steve Rodriguez, 9-Sep-2007.) (Revised by NM, 26-Aug-2011.)
theorem ringabl (R: class):
  $ wi (wcel R crg) (wcel R cabl) $;

--| A ring is a commutative monoid. (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem ringcmn (R: class):
  $ wi (wcel R crg) (wcel R ccmn) $;

--| A ring is an Abelian group. (Contributed by SN, 1-Jun-2024.)
theorem ringabld (ph: wff) (R: class):
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel R cabl) $;

--| A ring is a commutative monoid. (Contributed by SN, 1-Jun-2024.)
theorem ringcmnd (ph: wff) (R: class):
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel R ccmn) $;

--| A unital ring is a non-unital ring. (Contributed by AV, 6-Jan-2020.)
theorem ringrng (R: class):
  $ wi (wcel R crg) (wcel R crng) $;

--| The unital rings are non-unital rings. (Contributed by AV, 20-Mar-2020.)
theorem ringssrng:
  $ wss crg crng $;

--| The predicate "is a unital ring" as extension of the predicate "is a non-unital ring". (Contributed by AV, 17-Feb-2020.)
theorem isringrng {x3 y1: setvar} (B2 R c_x: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wb (wcel R crg) (wa (wcel R crng) (wrex x3 (wral y1 (wa (wceq (co (cv x3) (cv y1) c_x) (cv y1)) (wceq (co (cv y1) (cv x3) c_x) (cv y1))) B2) B2)) $;

--| The predicate "is a unital ring" based on a ring being abelian. Definition of "ring with unit" in [Lang] p. 83. (Contributed by Jeff Hankins, 21-Nov-2006.) (Revised by AV, 8-Aug-2026.)
theorem dfring2 {x3 y1 z: setvar} (B2 c_pl R c_x: class) (G: class x3 y1 z):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wb (wcel R crg) (w3a (wcel R cabl) (wcel G cmnd) (wral x3 (wral y1 (wral z (wa (wceq (co (cv x3) (co (cv y1) (cv z) c_pl) c_x) (co (co (cv x3) (cv y1) c_x) (co (cv x3) (cv z) c_x) c_pl)) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_x) (co (co (cv x3) (cv z) c_x) (co (cv y1) (cv z) c_x) c_pl))) B2) B2) B2)) $;

--| The predicate "is a (unital) ring" based on a ring being abelian and with the definition of a monoid expanded. (Contributed by Jeff Hankins, 21-Nov-2006.) (Revised by AV, 24-Aug-2026.)
theorem dfring3 {x3 y1 z: setvar} (B2 c_pl R c_x G: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wb (wcel R crg) (w3a (wa (wcel R cabl) (wcel G cmgm)) (wral x3 (wral y1 (wral z (w3a (wceq (co (co (cv x3) (cv y1) c_x) (cv z) c_x) (co (cv x3) (co (cv y1) (cv z) c_x) c_x)) (wceq (co (cv x3) (co (cv y1) (cv z) c_pl) c_x) (co (co (cv x3) (cv y1) c_x) (co (cv x3) (cv z) c_x) c_pl)) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_x) (co (co (cv x3) (cv z) c_x) (co (cv y1) (cv z) c_x) c_pl))) B2) B2) B2) (wrex x3 (wral y1 (wa (wceq (co (cv x3) (cv y1) c_x) (cv y1)) (wceq (co (cv y1) (cv x3) c_x) (cv y1))) B2) B2)) $;

--| If two structures have the same base set, and the values of their group (addition) and ring (multiplication) operations are equal for all pairs of elements of the base set, one is a ring iff the other one is. (Contributed by Mario Carneiro, 6-Dec-2014.) (Revised by Mario Carneiro, 6-Jan-2015.)
theorem ringpropd {x3 y1: setvar} (ph: wff) (B2 K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi ph (wb (wcel K crg) (wcel L crg)) $;

--| If two structures have the same group components (properties), one is a commutative ring iff the other one is. (Contributed by Mario Carneiro, 8-Feb-2015.)
theorem crngpropd {x3 y1: setvar} (ph: wff) (B2 K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi ph (wb (wcel K ccrg) (wcel L ccrg)) $;

--| If two structures have the same ring components (properties), one is a ring iff the other one is. (Contributed by Mario Carneiro, 11-Oct-2013.)
theorem ringprop (K L: class):
  $ wceq (cfv K cbs) (cfv L cbs) $ >
  $ wceq (cfv K cplusg) (cfv L cplusg) $ >
  $ wceq (cfv K cmulr) (cfv L cmulr) $ >
  $ wb (wcel K crg) (wcel L crg) $;

--| Properties that determine a ring. (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by NM, 2-Aug-2013.)
theorem isringd {x3 y1 z: setvar} (ph: wff) (B2: class) (c_pl: class x3 y1 z) (R: class) (c_x: class x3 y1 z) (c_1: class y1 z):
  $ wi ph (wceq B2 (cfv R cbs)) $ >
  $ wi ph (wceq c_pl (cfv R cplusg)) $ >
  $ wi ph (wceq c_x (cfv R cmulr)) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wi (w3a ph (wcel (cv x3) B2) (wcel (cv y1) B2)) (wcel (co (cv x3) (cv y1) c_x) B2) $ >
  $ wi (wa ph (w3a (wcel (cv x3) B2) (wcel (cv y1) B2) (wcel (cv z) B2))) (wceq (co (co (cv x3) (cv y1) c_x) (cv z) c_x) (co (cv x3) (co (cv y1) (cv z) c_x) c_x)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) B2) (wcel (cv y1) B2) (wcel (cv z) B2))) (wceq (co (cv x3) (co (cv y1) (cv z) c_pl) c_x) (co (co (cv x3) (cv y1) c_x) (co (cv x3) (cv z) c_x) c_pl)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) B2) (wcel (cv y1) B2) (wcel (cv z) B2))) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_x) (co (co (cv x3) (cv z) c_x) (co (cv y1) (cv z) c_x) c_pl)) $ >
  $ wi ph (wcel c_1 B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wceq (co c_1 (cv x3) c_x) (cv x3)) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wceq (co (cv x3) c_1 c_x) (cv x3)) $ >
  $ wi ph (wcel R crg) $;

--| Properties that determine a commutative ring. (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem iscrngd {x3 y1 z: setvar} (ph: wff) (B2: class) (c_pl: class x3 y1 z) (R: class) (c_x: class x3 y1 z) (c_1: class y1 z):
  $ wi ph (wceq B2 (cfv R cbs)) $ >
  $ wi ph (wceq c_pl (cfv R cplusg)) $ >
  $ wi ph (wceq c_x (cfv R cmulr)) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wi (w3a ph (wcel (cv x3) B2) (wcel (cv y1) B2)) (wcel (co (cv x3) (cv y1) c_x) B2) $ >
  $ wi (wa ph (w3a (wcel (cv x3) B2) (wcel (cv y1) B2) (wcel (cv z) B2))) (wceq (co (co (cv x3) (cv y1) c_x) (cv z) c_x) (co (cv x3) (co (cv y1) (cv z) c_x) c_x)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) B2) (wcel (cv y1) B2) (wcel (cv z) B2))) (wceq (co (cv x3) (co (cv y1) (cv z) c_pl) c_x) (co (co (cv x3) (cv y1) c_x) (co (cv x3) (cv z) c_x) c_pl)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) B2) (wcel (cv y1) B2) (wcel (cv z) B2))) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_x) (co (co (cv x3) (cv z) c_x) (co (cv y1) (cv z) c_x) c_pl)) $ >
  $ wi ph (wcel c_1 B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wceq (co c_1 (cv x3) c_x) (cv x3)) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wceq (co (cv x3) c_1 c_x) (cv x3)) $ >
  $ wi (w3a ph (wcel (cv x3) B2) (wcel (cv y1) B2)) (wceq (co (cv x3) (cv y1) c_x) (co (cv y1) (cv x3) c_x)) $ >
  $ wi ph (wcel R ccrg) $;

--| The zero of a unital ring is a left-absorbing element. (Contributed by FL, 31-Aug-2009.) (Proof shortened by AV, 30-Mar-2025.)
theorem ringlz (B2 R c_x X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R crg) (wcel X B2)) (wceq (co c_0 X c_x) c_0) $;

--| The zero of a unital ring is a right-absorbing element. (Contributed by FL, 31-Aug-2009.) (Proof shortened by AV, 30-Mar-2025.)
theorem ringrz (B2 R c_x X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R crg) (wcel X B2)) (wceq (co X c_0 c_x) c_0) $;

--| The zero of a unital ring is a left-absorbing element. (Contributed by SN, 7-Mar-2025.)
theorem ringlzd (ph: wff) (B2 R c_x X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (co c_0 X c_x) c_0) $;

--| The zero of a unital ring is a right-absorbing element. (Contributed by SN, 7-Mar-2025.)
theorem ringrzd (ph: wff) (B2 R c_x X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (co X c_0 c_x) c_0) $;

--| Any ring is also a semiring. (Contributed by Thierry Arnoux, 1-Apr-2018.)
theorem ringsrg (R: class):
  $ wi (wcel R crg) (wcel R csrg) $;

--| If one and zero are equal, then any two elements of a ring are equal. Alternately, every ring has one distinct from zero except the zero ring containing the single element ` { 0 } ` . (Contributed by Mario Carneiro, 10-Sep-2014.)
theorem ring1eq0 (B2 R c_1 X Y c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel R crg) (wcel X B2) (wcel Y B2)) (wi (wceq c_1 c_0) (wceq X Y)) $;

--| If a ring has at least two elements, its one and zero are different. (Contributed by AV, 13-Apr-2019.)
theorem ring1ne0 (B2 R c_1 c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R crg) (wbr c1 (cfv B2 chash) clt)) (wne c_1 c_0) $;

--| In a unital ring, a left invertible element is different from zero iff ` .1. =/= .0. ` . (Contributed by FL, 18-Apr-2010.) (Revised by AV, 24-Aug-2021.)
theorem ringinvnz1ne0 {a: setvar} (ph: wff) (B2 R: class a) (c_x c_1 X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wrex a (wceq (co (cv a) X c_x) c_1) B2) $ >
  $ wi ph (wb (wne X c_0) (wne c_1 c_0)) $;

--| In a unital ring, a left invertible element is not a zero divisor. (Contributed by FL, 18-Apr-2010.) (Revised by Jeff Madsen, 18-Apr-2010.) (Revised by AV, 24-Aug-2021.)
theorem ringinvnzdiv {a: setvar} (ph: wff) (B2 R: class a) (c_x c_1 X Y c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wrex a (wceq (co (cv a) X c_x) c_1) B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wb (wceq (co X Y c_x) c_0) (wceq Y c_0)) $;

--| Negation in a ring is the same as left multiplication by -1. ( ~ rngonegmn1l analog.) (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by Mario Carneiro, 2-Jul-2014.)
theorem ringnegl (ph: wff) (B2 R c_x c_1 N X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (co (cfv c_1 N) X c_x) (cfv X N)) $;

--| Negation in a ring is the same as right multiplication by -1. ( ~ rngonegmn1r analog.) (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by Mario Carneiro, 2-Jul-2014.)
theorem ringnegr (ph: wff) (B2 R c_x c_1 N X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (co X (cfv c_1 N) c_x) (cfv X N)) $;

--| Negation of a product in a ring. ( ~ mulneg1 analog.) Compared with ~ rngmneg1 , the proof is shorter making use of the existence of a ring unity. (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by Mario Carneiro, 2-Jul-2014.)
theorem ringmneg1 (ph: wff) (B2 R c_x N X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co (cfv X N) Y c_x) (cfv (co X Y c_x) N)) $;

--| Negation of a product in a ring. ( ~ mulneg2 analog.) Compared with ~ rngmneg2 , the proof is shorter making use of the existence of a ring unity. (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by Mario Carneiro, 2-Jul-2014.)
theorem ringmneg2 (ph: wff) (B2 R c_x N X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co X (cfv Y N) c_x) (cfv (co X Y c_x) N)) $;

--| Double negation of a product in a ring. ( ~ mul2neg analog.) (Contributed by Mario Carneiro, 4-Dec-2014.) (Proof shortened by AV, 30-Mar-2025.)
theorem ringm2neg (ph: wff) (B2 R c_x N X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co (cfv X N) (cfv Y N) c_x) (co X Y c_x)) $;

--| Ring multiplication distributes over subtraction. ( ~ subdi analog.) (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by Mario Carneiro, 2-Jul-2014.)
theorem ringsubdi (ph: wff) (B2 R c_x c_mi X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wceq (co X (co Y Z c_mi) c_x) (co (co X Y c_x) (co X Z c_x) c_mi)) $;

--| Ring multiplication distributes over subtraction. ( ~ subdir analog.) (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by Mario Carneiro, 2-Jul-2014.)
theorem ringsubdir (ph: wff) (B2 R c_x c_mi X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wceq (co (co X Y c_mi) Z c_x) (co (co X Z c_x) (co Y Z c_x) c_mi)) $;

--| An associative property between group multiple and ring multiplication. (Contributed by Mario Carneiro, 14-Jun-2015.)
theorem mulgass2 (B2 R c_x c_xp N X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wi (wa (wcel R crg) (w3a (wcel N cz) (wcel X B2) (wcel Y B2))) (wceq (co (co N X c_x) Y c_xp) (co N (co X Y c_xp) c_x)) $;

--| The (smallest) structure representing a _zero ring_. (Contributed by AV, 28-Apr-2019.)
theorem ring1 (M V Z: class):
  $ wceq M (ctp (cop (cfv cnx cbs) (csn Z)) (cop (cfv cnx cplusg) (csn (cop (cop Z Z) Z))) (cop (cfv cnx cmulr) (csn (cop (cop Z Z) Z)))) $ >
  $ wi (wcel Z V) (wcel M crg) $;

--| Rings exist. (Contributed by AV, 29-Apr-2019.)
theorem ringn0:
  $ wne crg c0 $;

--| Left-multiplication in a ring by a fixed element of the ring is a group homomorphism. (It is not usually a ring homomorphism.) (Contributed by Mario Carneiro, 4-May-2015.)
theorem ringlghm {x3: setvar} (B2 R c_x X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crg) (wcel X B2)) (wcel (cmpt x3 B2 (co X (cv x3) c_x)) (co R R cghm)) $;

--| Right-multiplication in a ring by a fixed element of the ring is a group homomorphism. (It is not usually a ring homomorphism.) (Contributed by Mario Carneiro, 4-May-2015.)
theorem ringrghm {x3: setvar} (B2 R c_x X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crg) (wcel X B2)) (wcel (cmpt x3 B2 (co (cv x3) X c_x)) (co R R cghm)) $;

--| A finite ring sum multiplied by a constant. (Contributed by Mario Carneiro, 19-Dec-2014.) (Revised by AV, 10-Jul-2019.) Remove unused hypothesis. (Revised by SN, 7-Mar-2025.)
theorem gsummulc1 {k: setvar} (ph: wff) (A2 B2: class) (R: class k) (c_x: class) (V X: class k) (Y: class) (c_0: class k):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel X B2) $ >
  $ wi ph (wbr (cmpt k A2 X) c_0 cfsupp) $ >
  $ wi ph (wceq (co R (cmpt k A2 (co X Y c_x)) cgsu) (co (co R (cmpt k A2 X) cgsu) Y c_x)) $;

--| A finite ring sum multiplied by a constant. (Contributed by Mario Carneiro, 19-Dec-2014.) (Revised by AV, 10-Jul-2019.) Remove unused hypothesis. (Revised by SN, 7-Mar-2025.)
theorem gsummulc2 {k: setvar} (ph: wff) (A2 B2: class) (R: class k) (c_x: class) (V X: class k) (Y: class) (c_0: class k):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel X B2) $ >
  $ wi ph (wbr (cmpt k A2 X) c_0 cfsupp) $ >
  $ wi ph (wceq (co R (cmpt k A2 (co Y X c_x)) cgsu) (co Y (co R (cmpt k A2 X) cgsu) c_x)) $;

--| If one factor in a finite group sum of the multiplicative group of a commutative ring is 0, the whole "sum" (i.e. product) is 0. (Contributed by AV, 3-Jan-2019.)
theorem gsummgp0 {i n: setvar} (ph: wff) (A2: class n) (B2 R: class i) (G N c_0: class):
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi (wa ph (wcel (cv n) N)) (wcel A2 (cfv R cbs)) $ >
  $ wi (wa ph (wceq (cv n) (cv i))) (wceq A2 B2) $ >
  $ wi ph (wrex i (wceq B2 c_0) N) $ >
  $ wi ph (wceq (co G (cmpt n N A2) cgsu) c_0) $;

--| Distribute a binary product of sums to a sum of binary products in a ring. (Contributed by Mario Carneiro, 8-Mar-2015.) (Revised by AV, 10-Jul-2019.)
theorem gsumdixp {x3 y1: setvar} (ph: wff) (B2: class) (R: class y1) (c_x I J: class) (V W: class x3 y1) (X: class x3) (Y: class y1) (c_0: class x3 y1):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel J W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi (wa ph (wcel (cv x3) I)) (wcel X B2) $ >
  $ wi (wa ph (wcel (cv y1) J)) (wcel Y B2) $ >
  $ wi ph (wbr (cmpt x3 I X) c_0 cfsupp) $ >
  $ wi ph (wbr (cmpt y1 J Y) c_0 cfsupp) $ >
  $ wi ph (wceq (co (co R (cmpt x3 I X) cgsu) (co R (cmpt y1 J Y) cgsu) c_x) (co R (cmpo x3 y1 I J (co X Y c_x)) cgsu)) $;

--| A structure product of rings has closed binary operation. (Contributed by Mario Carneiro, 11-Mar-2015.) (Proof shortened by AV, 30-Mar-2025.)
theorem prdsmulrcl (ph: wff) (B2 R S c_x F G I V W Y: class):
  $ wceq Y (co S R cprds) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq c_x (cfv Y cmulr) $ >
  $ wi ph (wcel S V) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wf I crg R) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wi ph (wcel (co F G c_x) B2) $;

--| A product of rings is a ring. (Contributed by Mario Carneiro, 11-Mar-2015.)
theorem prdsringd (ph: wff) (R S I V W Y: class):
  $ wceq Y (co S R cprds) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel S V) $ >
  $ wi ph (wf I crg R) $ >
  $ wi ph (wcel Y crg) $;

--| A product of commutative rings is a commutative ring. Since the resulting ring will have zero divisors in all nontrivial cases, this cannot be strengthened much further. (Contributed by Mario Carneiro, 11-Mar-2015.)
theorem prdscrngd (ph: wff) (R S I V W Y: class):
  $ wceq Y (co S R cprds) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel S V) $ >
  $ wi ph (wf I ccrg R) $ >
  $ wi ph (wcel Y ccrg) $;

--| Value of the ring unity in a structure family product. (Contributed by Mario Carneiro, 11-Mar-2015.)
theorem prds1 (ph: wff) (R S I V W Y: class):
  $ wceq Y (co S R cprds) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel S V) $ >
  $ wi ph (wf I crg R) $ >
  $ wi ph (wceq (ccom cur R) (cfv Y cur)) $;

--| A structure power of a ring is a ring. (Contributed by Mario Carneiro, 11-Mar-2015.)
theorem pwsring (R I V Y: class):
  $ wceq Y (co R I cpws) $ >
  $ wi (wa (wcel R crg) (wcel I V)) (wcel Y crg) $;

--| Value of the ring unity in a structure power. (Contributed by Mario Carneiro, 11-Mar-2015.)
theorem pws1 (R c_1 I V Y: class):
  $ wceq Y (co R I cpws) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wcel I V)) (wceq (cxp I (csn c_1)) (cfv Y cur)) $;

--| A structure power of a commutative ring is a commutative ring. (Contributed by Mario Carneiro, 11-Mar-2015.)
theorem pwscrng (R I V Y: class):
  $ wceq Y (co R I cpws) $ >
  $ wi (wa (wcel R ccrg) (wcel I V)) (wcel Y ccrg) $;

--| The multiplicative group of the power structure resembles the power of the multiplicative group. (Contributed by Mario Carneiro, 12-Mar-2015.)
theorem pwsmgp (B2 C c_pl c_pb R I M N V W Y Z: class):
  $ wceq Y (co R I cpws) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq Z (co M I cpws) $ >
  $ wceq N (cfv Y cmgp) $ >
  $ wceq B2 (cfv N cbs) $ >
  $ wceq C (cfv Z cbs) $ >
  $ wceq c_pl (cfv N cplusg) $ >
  $ wceq c_pb (cfv Z cplusg) $ >
  $ wi (wa (wcel R V) (wcel I W)) (wa (wceq B2 C) (wceq c_pl c_pb)) $;

--| The projection given by ~ pwspjmhm is also a monoid homomorphism between the respective multiplicative groups. (Contributed by SN, 30-Jul-2024.)
theorem pwspjmhmmgpd {x3: setvar} (ph: wff) (A2 B2 R: class) (T I M V: class x3) (Y: class):
  $ wceq Y (co R I cpws) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq M (cfv Y cmgp) $ >
  $ wceq T (cfv R cmgp) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel A2 I) $ >
  $ wi ph (wcel (cmpt x3 B2 (cfv A2 (cv x3))) (co M T cmhm)) $;

--| Value of a group exponentiation in a structure power. Compare ~ pwsmulg . (Contributed by SN, 30-Jul-2024.)
theorem pwsexpg (ph: wff) (A2 B2 R c_xb T c_x I M N V X Y: class):
  $ wceq Y (co R I cpws) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq M (cfv Y cmgp) $ >
  $ wceq T (cfv R cmgp) $ >
  $ wceq c_xb (cfv M cmg) $ >
  $ wceq c_x (cfv T cmg) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel A2 I) $ >
  $ wi ph (wceq (cfv A2 (co N X c_xb)) (co N (cfv A2 X) c_x)) $;

--| Finite products in a power structure are taken componentwise. Compare ~ pwsgsum . (Contributed by SN, 30-Jul-2024.)
theorem pwsgprod {x3 y1: setvar} (ph: wff) (B2: class y1) (R T U c_1: class x3 y1) (I J: class) (M: class y1) (V W: class x3 y1) (Y: class x3):
  $ wceq Y (co R I cpws) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv Y cur) $ >
  $ wceq M (cfv Y cmgp) $ >
  $ wceq T (cfv R cmgp) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel J W) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi (wa ph (wa (wcel (cv x3) I) (wcel (cv y1) J))) (wcel U B2) $ >
  $ wi ph (wbr (cmpt y1 J (cmpt x3 I U)) c_1 cfsupp) $ >
  $ wi ph (wceq (co M (cmpt y1 J (cmpt x3 I U)) cgsu) (cmpt x3 I (co T (cmpt y1 J U) cgsu))) $;

--| The image structure of a ring is a ring. (Contributed by Mario Carneiro, 14-Jun-2015.)
theorem imasring {q p a b: setvar} (ph: wff) (B2 c_pl R c_x: class a b) (U: class) (c_1: class a b) (F V: class):
  $ wi ph (wceq U (co F R cimas)) $ >
  $ wi ph (wceq V (cfv R cbs)) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wfo V B2 F) $ >
  $ wi (w3a ph (wa (wcel (cv a) V) (wcel (cv b) V)) (wa (wcel (cv p) V) (wcel (cv q) V))) (wi (wa (wceq (cfv (cv a) F) (cfv (cv p) F)) (wceq (cfv (cv b) F) (cfv (cv q) F))) (wceq (cfv (co (cv a) (cv b) c_pl) F) (cfv (co (cv p) (cv q) c_pl) F))) $ >
  $ wi (w3a ph (wa (wcel (cv a) V) (wcel (cv b) V)) (wa (wcel (cv p) V) (wcel (cv q) V))) (wi (wa (wceq (cfv (cv a) F) (cfv (cv p) F)) (wceq (cfv (cv b) F) (cfv (cv q) F))) (wceq (cfv (co (cv a) (cv b) c_x) F) (cfv (co (cv p) (cv q) c_x) F))) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wa (wcel U crg) (wceq (cfv c_1 F) (cfv U cur))) $;

--| The image of a ring under an injection is a ring ( ~ imasmndf1 analog). (Contributed by AV, 27-Feb-2025.)
theorem imasringf1 (B2 R U F V: class):
  $ wceq U (co F R cimas) $ >
  $ wceq V (cfv R cbs) $ >
  $ wi (wa (wf1 V B2 F) (wcel R crg)) (wcel U crg) $;

--| A product of two rings is a ring ( ~ xpsmnd analog). (Contributed by AV, 28-Feb-2025.)
theorem xpsringd (ph: wff) (R S Y: class):
  $ wceq Y (co S R cxps) $ >
  $ wi ph (wcel S crg) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel Y crg) $;

--| The multiplicative identity element of a binary product of rings. (Contributed by AV, 16-Mar-2025.)
theorem xpsring1d (ph: wff) (R S Y: class):
  $ wceq Y (co S R cxps) $ >
  $ wi ph (wcel S crg) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wceq (cfv Y cur) (cop (cfv S cur) (cfv R cur))) $;

--| The quotient structure of a ring is a ring. (Contributed by Mario Carneiro, 14-Jun-2015.)
theorem qusring2 {q p a b: setvar} (ph: wff) (c_pl: class a b) (c_sm: class) (R c_x: class a b) (U: class) (c_1: class a b) (V: class):
  $ wi ph (wceq U (co R c_sm cqus)) $ >
  $ wi ph (wceq V (cfv R cbs)) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wer V c_sm) $ >
  $ wi ph (wi (wa (wbr (cv a) (cv p) c_sm) (wbr (cv b) (cv q) c_sm)) (wbr (co (cv a) (cv b) c_pl) (co (cv p) (cv q) c_pl) c_sm)) $ >
  $ wi ph (wi (wa (wbr (cv a) (cv p) c_sm) (wbr (cv b) (cv q) c_sm)) (wbr (co (cv a) (cv b) c_x) (co (cv p) (cv q) c_x) c_sm)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wa (wcel U crg) (wceq (cec c_1 c_sm) (cfv U cur))) $;

--| The binomial theorem for commutative rings (special case of ~ csrgbinom ): ` ( A + B ) ^ N ` is the sum from ` k = 0 ` to ` N ` of ` ( N _C k ) x. ( ( A ^ k ) x. ( B ^ ( N - k ) ) ` . (Contributed by AV, 24-Aug-2019.)
theorem crngbinom {k: setvar} (A2 B2 c_pl R S c_x c_xp c_ex: class) (G: class k) (N: class):
  $ wceq S (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi (wa (wa (wcel R ccrg) (wcel N cn0)) (wa (wcel A2 S) (wcel B2 S))) (wceq (co N (co A2 B2 c_pl) c_ex) (co R (cmpt k (co cc0 N cfz) (co (co N (cv k) cbc) (co (co (co N (cv k) cmin) A2 c_ex) (co (cv k) B2 c_ex) c_xp) c_x)) cgsu)) $;

--| The opposite ring operation.
term coppr: class;

--| Define an opposite ring, which is the same as the original ring but with multiplication written the other way around. (Contributed by Mario Carneiro, 1-Dec-2014.)
axiom df_oppr {f2: setvar}:
  $ wceq coppr (cmpt f2 cvv (co (cv f2) (cop (cfv cnx cmulr) (ctpos (cfv (cv f2) cmulr))) csts)) $;

--| Value of the opposite ring. (Contributed by Mario Carneiro, 1-Dec-2014.)
theorem opprval (B2 R c_x O: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq O (cfv R coppr) $ >
  $ wceq O (co R (cop (cfv cnx cmulr) (ctpos c_x)) csts) $;

--| Value of the multiplication operation of an opposite ring. (Contributed by Mario Carneiro, 1-Dec-2014.)
theorem opprmulfval (B2 R c_xb c_x O: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq O (cfv R coppr) $ >
  $ wceq c_xb (cfv O cmulr) $ >
  $ wceq c_xb (ctpos c_x) $;

--| Value of the multiplication operation of an opposite ring. Hypotheses eliminated by a suggestion of Stefan O'Rear, 30-Aug-2015. (Contributed by Mario Carneiro, 1-Dec-2014.) (Revised by Mario Carneiro, 30-Aug-2015.)
theorem opprmul (B2 R c_xb c_x O X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq O (cfv R coppr) $ >
  $ wceq c_xb (cfv O cmulr) $ >
  $ wceq (co X Y c_xb) (co Y X c_x) $;

--| In a commutative ring, the opposite ring is equivalent to the original ring (for theorems like ~ unitpropd ). (Contributed by Mario Carneiro, 14-Jun-2015.)
theorem crngoppr (B2 R c_xb c_x O X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq O (cfv R coppr) $ >
  $ wceq c_xb (cfv O cmulr) $ >
  $ wi (w3a (wcel R ccrg) (wcel X B2) (wcel Y B2)) (wceq (co X Y c_x) (co X Y c_xb)) $;

--| Lemma for ~ opprbas and ~ oppradd . (Contributed by Mario Carneiro, 1-Dec-2014.) (Revised by AV, 6-Nov-2024.)
theorem opprlem (R E O: class):
  $ wceq O (cfv R coppr) $ >
  $ wceq E (cslot (cfv cnx E)) $ >
  $ wne (cfv cnx E) (cfv cnx cmulr) $ >
  $ wceq (cfv R E) (cfv O E) $;

--| Base set of an opposite ring. (Contributed by Mario Carneiro, 1-Dec-2014.) (Proof shortened by AV, 6-Nov-2024.)
theorem opprbas (B2 R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq B2 (cfv O cbs) $;

--| Addition operation of an opposite ring. (Contributed by Mario Carneiro, 1-Dec-2014.) (Proof shortened by AV, 6-Nov-2024.)
theorem oppradd (c_pl R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_pl (cfv O cplusg) $;

--| An opposite non-unital ring is a non-unital ring. (Contributed by AV, 15-Feb-2025.)
theorem opprrng (R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wi (wcel R crng) (wcel O crng) $;

--| A class is a non-unital ring if and only if its opposite is a non-unital ring. Bidirectional form of ~ opprrng . (Contributed by AV, 15-Feb-2025.)
theorem opprrngb (R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wb (wcel R crng) (wcel O crng) $;

--| An opposite ring is a ring. (Contributed by Mario Carneiro, 1-Dec-2014.) (Revised by Mario Carneiro, 30-Aug-2015.) (Proof shortened by AV, 30-Mar-2025.)
theorem opprring (R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wi (wcel R crg) (wcel O crg) $;

--| Bidirectional form of ~ opprring . (Contributed by Mario Carneiro, 6-Dec-2014.)
theorem opprringb (R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wb (wcel R crg) (wcel O crg) $;

--| Additive identity of an opposite ring. (Contributed by Mario Carneiro, 1-Dec-2014.)
theorem oppr0 (R O c_0: class):
  $ wceq O (cfv R coppr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_0 (cfv O c0g) $;

--| Multiplicative identity of an opposite ring. (Contributed by Mario Carneiro, 1-Dec-2014.)
theorem oppr1 (R c_1 O: class):
  $ wceq O (cfv R coppr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_1 (cfv O cur) $;

--| The negative function in an opposite ring. (Contributed by Mario Carneiro, 5-Dec-2014.) (Revised by Mario Carneiro, 2-Oct-2015.)
theorem opprneg (R N O: class):
  $ wceq O (cfv R coppr) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wceq N (cfv O cminusg) $;

--| Being a subgroup is a symmetric property. (Contributed by Mario Carneiro, 6-Dec-2014.)
theorem opprsubg (R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wceq (cfv R csubg) (cfv O csubg) $;

--| An associative property between group multiple and ring multiplication. (Contributed by Mario Carneiro, 14-Jun-2015.)
theorem mulgass3 (B2 R c_x c_xp N X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wi (wa (wcel R crg) (w3a (wcel N cz) (wcel X B2) (wcel Y B2))) (wceq (co X (co N Y c_x) c_xp) (co N (co X Y c_xp) c_x)) $;

--| Ring divisibility relation.
term cdsr: class;

--| Units in a ring.
term cui: class;

--| Ring irreducibles.
term cir: class;

--| Define the (right) divisibility relation in a ring. Access to the left divisibility relation is available through ` ( ||r `` ( oppR `` R ) ) ` . (Contributed by Mario Carneiro, 1-Dec-2014.)
axiom df_dvdsr {x3 y1 z w: setvar}:
  $ wceq cdsr (cmpt w cvv (copab x3 y1 (wa (wcel (cv x3) (cfv (cv w) cbs)) (wrex z (wceq (co (cv z) (cv x3) (cfv (cv w) cmulr)) (cv y1)) (cfv (cv w) cbs))))) $;

--| Define the set of units in a ring, that is, all elements with a left and right multiplicative inverse. (Contributed by Mario Carneiro, 1-Dec-2014.)
axiom df_unit {w: setvar}:
  $ wceq cui (cmpt w cvv (cima (ccnv (cin (cfv (cv w) cdsr) (cfv (cfv (cv w) coppr) cdsr))) (csn (cfv (cv w) cur)))) $;

--| Define the set of irreducible elements in a ring. (Contributed by Mario Carneiro, 4-Dec-2014.)
axiom df_irred {x3 y1 z w b: setvar}:
  $ wceq cir (cmpt w cvv (csb b (cdif (cfv (cv w) cbs) (cfv (cv w) cui)) (crab z (wral x3 (wral y1 (wne (co (cv x3) (cv y1) (cfv (cv w) cmulr)) (cv z)) (cv b)) (cv b)) (cv b)))) $;

--| The divides relation is a relation. (Contributed by Mario Carneiro, 1-Dec-2014.)
theorem reldvdsr (c_pa R: class):
  $ wceq c_pa (cfv R cdsr) $ >
  $ wrel c_pa $;

--| Value of the divides relation. (Contributed by Mario Carneiro, 1-Dec-2014.) (Revised by Mario Carneiro, 6-Jan-2015.)
theorem dvdsrval {x3 y1 z: setvar} (B2: class) (c_pa: class z) (R c_x: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_pa (copab x3 y1 (wa (wcel (cv x3) B2) (wrex z (wceq (co (cv z) (cv x3) c_x) (cv y1)) B2))) $;

--| Value of the divides relation. (Contributed by Mario Carneiro, 1-Dec-2014.)
theorem dvdsr {z: setvar} (B2: class) (c_pa: class z) (R c_x X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wb (wbr X Y c_pa) (wa (wcel X B2) (wrex z (wceq (co (cv z) X c_x) Y) B2)) $;

--| Value of the divides relation. (Contributed by Mario Carneiro, 1-Dec-2014.)
theorem dvdsr2 {z: setvar} (B2: class) (c_pa: class z) (R c_x X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wcel X B2) (wb (wbr X Y c_pa) (wrex z (wceq (co (cv z) X c_x) Y) B2)) $;

--| A left-multiple of ` X ` is divisible by ` X ` . (Contributed by Mario Carneiro, 1-Dec-2014.)
theorem dvdsrmul (B2 c_pa R c_x X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel X B2) (wcel Y B2)) (wbr X (co Y X c_x) c_pa) $;

--| Closure of a dividing element. (Contributed by Mario Carneiro, 5-Dec-2014.)
theorem dvdsrcl (B2 c_pa R X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi (wbr X Y c_pa) (wcel X B2) $;

--| Closure of a dividing element. (Contributed by Mario Carneiro, 5-Dec-2014.)
theorem dvdsrcl2 (B2 c_pa R X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi (wa (wcel R crg) (wbr X Y c_pa)) (wcel Y B2) $;

--| An element in a (unital) ring divides itself. (Contributed by Mario Carneiro, 1-Dec-2014.) (Revised by Mario Carneiro, 30-Apr-2015.)
theorem dvdsrid (B2 c_pa R X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi (wa (wcel R crg) (wcel X B2)) (wbr X X c_pa) $;

--| Divisibility is transitive. (Contributed by Mario Carneiro, 1-Dec-2014.)
theorem dvdsrtr (B2 c_pa R X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi (w3a (wcel R crg) (wbr Y Z c_pa) (wbr Z X c_pa)) (wbr Y X c_pa) $;

--| The divisibility relation is preserved under right-multiplication. (Contributed by Mario Carneiro, 1-Dec-2014.)
theorem dvdsrmul1 (B2 c_pa R c_x X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R crg) (wcel Z B2) (wbr X Y c_pa)) (wbr (co X Z c_x) (co Y Z c_x) c_pa) $;

--| An element divides its negative. (Contributed by Mario Carneiro, 1-Dec-2014.)
theorem dvdsrneg (B2 c_pa R N X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wi (wa (wcel R crg) (wcel X B2)) (wbr X (cfv X N) c_pa) $;

--| In a ring, zero is divisible by all elements. ("Zero divisor" as a term has a somewhat different meaning, see ~ df-rlreg .) (Contributed by Stefan O'Rear, 29-Mar-2015.)
theorem dvdsr01 (B2 c_pa R X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R crg) (wcel X B2)) (wbr X c_0 c_pa) $;

--| Only zero is divisible by zero. (Contributed by Stefan O'Rear, 29-Mar-2015.)
theorem dvdsr02 (B2 c_pa R X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R crg) (wcel X B2)) (wb (wbr c_0 X c_pa) (wceq X c_0)) $;

--| Property of being a unit of a ring. A unit is an element that left- and right-divides one. (Contributed by Mario Carneiro, 1-Dec-2014.) (Revised by Mario Carneiro, 8-Dec-2015.)
theorem isunit (c_pa R S U c_1 E X: class):
  $ wceq U (cfv R cui) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wceq S (cfv R coppr) $ >
  $ wceq E (cfv S cdsr) $ >
  $ wb (wcel X U) (wa (wbr X c_1 c_pa) (wbr X c_1 E)) $;

--| The multiplicative identity is a unit. (Contributed by Mario Carneiro, 1-Dec-2014.)
theorem _1unit (R U c_1: class):
  $ wceq U (cfv R cui) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R crg) (wcel c_1 U) $;

--| A unit is an element of the base set. (Contributed by Mario Carneiro, 1-Dec-2014.)
theorem unitcl (B2 R U X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wi (wcel X U) (wcel X B2) $;

--| The set of units is contained in the base set. (Contributed by Mario Carneiro, 5-Oct-2015.)
theorem unitss (B2 R U: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wss U B2 $;

--| Being a unit is a symmetric property, so it transfers to the opposite ring. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem opprunit (R S U: class):
  $ wceq U (cfv R cui) $ >
  $ wceq S (cfv R coppr) $ >
  $ wceq U (cfv S cui) $;

--| Property of being a unit in a commutative ring. (Contributed by Mario Carneiro, 18-Apr-2016.)
theorem crngunit (c_pa R U c_1 X: class):
  $ wceq U (cfv R cui) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi (wcel R ccrg) (wb (wcel X U) (wbr X c_1 c_pa)) $;

--| A divisor of a unit is a unit. (Contributed by Mario Carneiro, 18-Apr-2016.)
theorem dvdsunit (c_pa R U X Y: class):
  $ wceq U (cfv R cui) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi (w3a (wcel R ccrg) (wbr Y X c_pa) (wcel X U)) (wcel Y U) $;

--| The product of units is a unit. (Contributed by Mario Carneiro, 2-Dec-2014.)
theorem unitmulcl (R c_x U X Y: class):
  $ wceq U (cfv R cui) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R crg) (wcel X U) (wcel Y U)) (wcel (co X Y c_x) U) $;

--| Reversal of ~ unitmulcl in a commutative ring. (Contributed by Mario Carneiro, 18-Apr-2016.)
theorem unitmulclb (B2 R c_x U X Y: class):
  $ wceq U (cfv R cui) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (w3a (wcel R ccrg) (wcel X B2) (wcel Y B2)) (wb (wcel (co X Y c_x) U) (wa (wcel X U) (wcel Y U))) $;

--| The base set of the group of units. (Contributed by Mario Carneiro, 25-Dec-2014.)
theorem unitgrpbas (R U G: class):
  $ wceq U (cfv R cui) $ >
  $ wceq G (co (cfv R cmgp) U cress) $ >
  $ wceq U (cfv G cbs) $;

--| The group of units is a group under multiplication. (Contributed by Mario Carneiro, 2-Dec-2014.)
theorem unitgrp (R U G: class):
  $ wceq U (cfv R cui) $ >
  $ wceq G (co (cfv R cmgp) U cress) $ >
  $ wi (wcel R crg) (wcel G cgrp) $;

--| The group of units of a commutative ring is abelian. (Contributed by Mario Carneiro, 19-Apr-2016.)
theorem unitabl (R U G: class):
  $ wceq U (cfv R cui) $ >
  $ wceq G (co (cfv R cmgp) U cress) $ >
  $ wi (wcel R ccrg) (wcel G cabl) $;

--| The identity of the group of units of a ring is the ring unity. (Contributed by Mario Carneiro, 2-Dec-2014.)
theorem unitgrpid (R U c_1 G: class):
  $ wceq U (cfv R cui) $ >
  $ wceq G (co (cfv R cmgp) U cress) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R crg) (wceq c_1 (cfv G c0g)) $;

--| The group of units is a submonoid of the multiplicative monoid of the ring. (Contributed by Mario Carneiro, 18-Jun-2015.)
theorem unitsubm (R U M: class):
  $ wceq U (cfv R cui) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wi (wcel R crg) (wcel U (cfv M csubmnd)) $;

--| Extend class notation with multiplicative inverse.
term cinvr: class;

--| Define multiplicative inverse. (Contributed by NM, 21-Sep-2011.)
axiom df_invr {r: setvar}:
  $ wceq cinvr (cmpt r cvv (cfv (co (cfv (cv r) cmgp) (cfv (cv r) cui) cress) cminusg)) $;

--| Multiplicative inverse function for a division ring. (Contributed by NM, 21-Sep-2011.) (Revised by Mario Carneiro, 25-Dec-2014.)
theorem invrfval (R U G I: class):
  $ wceq U (cfv R cui) $ >
  $ wceq G (co (cfv R cmgp) U cress) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wceq I (cfv G cminusg) $;

--| The inverse of a unit exists and is a unit. (Contributed by Mario Carneiro, 2-Dec-2014.)
theorem unitinvcl (R U I X: class):
  $ wceq U (cfv R cui) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wi (wa (wcel R crg) (wcel X U)) (wcel (cfv X I) U) $;

--| The inverse of the inverse of a unit is the same element. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem unitinvinv (R U I X: class):
  $ wceq U (cfv R cui) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wi (wa (wcel R crg) (wcel X U)) (wceq (cfv (cfv X I) I) X) $;

--| The inverse of a unit is an element of the ring. (Contributed by Mario Carneiro, 2-Dec-2014.)
theorem ringinvcl (B2 R U I X: class):
  $ wceq U (cfv R cui) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wa (wcel R crg) (wcel X U)) (wcel (cfv X I) B2) $;

--| A unit times its inverse is the ring unity. (Contributed by Mario Carneiro, 2-Dec-2014.)
theorem unitlinv (R c_x U c_1 I X: class):
  $ wceq U (cfv R cui) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wcel X U)) (wceq (co (cfv X I) X c_x) c_1) $;

--| A unit times its inverse is the ring unity. (Contributed by Mario Carneiro, 2-Dec-2014.)
theorem unitrinv (R c_x U c_1 I X: class):
  $ wceq U (cfv R cui) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wcel X U)) (wceq (co X (cfv X I) c_x) c_1) $;

--| The inverse of the ring unity is the ring unity. (Contributed by Mario Carneiro, 18-Jun-2015.)
theorem _1rinv (R c_1 I: class):
  $ wceq I (cfv R cinvr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R crg) (wceq (cfv c_1 I) c_1) $;

--| The additive identity is a unit if and only if ` 1 = 0 ` , i.e. we are in the zero ring. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem _0unit (R U c_1 c_0: class):
  $ wceq U (cfv R cui) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R crg) (wb (wcel c_0 U) (wceq c_1 c_0)) $;

--| The negative of a unit is a unit. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem unitnegcl (R U N X: class):
  $ wceq U (cfv R cui) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wi (wa (wcel R crg) (wcel X U)) (wcel (cfv X N) U) $;

--| In a unitary ring, a unit is not a zero divisor. (Contributed by AV, 7-Mar-2025.)
theorem ringunitnzdiv (ph: wff) (B2 R c_x X Y c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel X (cfv R cui)) $ >
  $ wi ph (wb (wceq (co X Y c_x) c_0) (wceq Y c_0)) $;

--| In a unitary ring, the ring unity is not a zero divisor. (Contributed by AV, 7-Mar-2025.)
theorem ring1nzdiv (ph: wff) (B2 R c_x c_1 Y c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wb (wceq (co c_1 Y c_x) c_0) (wceq Y c_0)) $;

--| Extend class notation with ring division.
term cdvr: class;

--| Define ring division. (Contributed by Mario Carneiro, 2-Jul-2014.)
axiom df_dvr {x3 y1 r: setvar}:
  $ wceq cdvr (cmpt r cvv (cmpo x3 y1 (cfv (cv r) cbs) (cfv (cv r) cui) (co (cv x3) (cfv (cv y1) (cfv (cv r) cinvr)) (cfv (cv r) cmulr)))) $;

--| Division operation in a ring. (Contributed by Mario Carneiro, 2-Jul-2014.) (Revised by Mario Carneiro, 2-Dec-2014.) (Proof shortened by AV, 2-Mar-2024.)
theorem dvrfval {x3 y1: setvar} (B2: class) (c_dv: class x3 y1) (R c_x U I: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wceq c_dv (cmpo x3 y1 B2 U (co (cv x3) (cfv (cv y1) I) c_x)) $;

--| Division operation in a ring. (Contributed by Mario Carneiro, 2-Jul-2014.) (Revised by Mario Carneiro, 2-Dec-2014.)
theorem dvrval (B2 c_dv R c_x U I X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wi (wa (wcel X B2) (wcel Y U)) (wceq (co X Y c_dv) (co X (cfv Y I) c_x)) $;

--| Closure of division operation. (Contributed by Mario Carneiro, 2-Jul-2014.)
theorem dvrcl (B2 c_dv R U X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wi (w3a (wcel R crg) (wcel X B2) (wcel Y U)) (wcel (co X Y c_dv) B2) $;

--| The units are closed under division. (Contributed by Mario Carneiro, 2-Jul-2014.)
theorem unitdvcl (c_dv R U X Y: class):
  $ wceq U (cfv R cui) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wi (w3a (wcel R crg) (wcel X U) (wcel Y U)) (wcel (co X Y c_dv) U) $;

--| A ring element divided by itself is the ring unity. ( ~ divid analog.) (Contributed by Mario Carneiro, 18-Jun-2015.)
theorem dvrid (c_dv R U c_1 X: class):
  $ wceq U (cfv R cui) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wcel X U)) (wceq (co X X c_dv) c_1) $;

--| A ring element divided by the ring unity is itself. ( ~ div1 analog.) (Contributed by Mario Carneiro, 18-Jun-2015.)
theorem dvr1 (B2 c_dv R c_1 X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wcel X B2)) (wceq (co X c_1 c_dv) X) $;

--| An associative law for division. ( ~ divass analog.) (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem dvrass (B2 c_dv R c_x U X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crg) (w3a (wcel X B2) (wcel Y B2) (wcel Z U))) (wceq (co (co X Y c_x) Z c_dv) (co X (co Y Z c_dv) c_x)) $;

--| A cancellation law for division. ( ~ divcan1 analog.) (Contributed by Mario Carneiro, 2-Jul-2014.) (Revised by Mario Carneiro, 2-Dec-2014.)
theorem dvrcan1 (B2 c_dv R c_x U X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R crg) (wcel X B2) (wcel Y U)) (wceq (co (co X Y c_dv) Y c_x) X) $;

--| A cancellation law for division. ( ~ divcan3 analog.) (Contributed by Mario Carneiro, 2-Jul-2014.) (Revised by Mario Carneiro, 18-Jun-2015.)
theorem dvrcan3 (B2 c_dv R c_x U X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R crg) (wcel X B2) (wcel Y U)) (wceq (co (co X Y c_x) Y c_dv) X) $;

--| Equality in terms of ratio equal to ring unity. ( ~ diveq1 analog.) (Contributed by Mario Carneiro, 28-Apr-2016.)
theorem dvreq1 (B2 c_dv R U c_1 X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (w3a (wcel R crg) (wcel X B2) (wcel Y U)) (wb (wceq (co X Y c_dv) c_1) (wceq X Y)) $;

--| Distributive law for the division operation of a ring. (Contributed by Thierry Arnoux, 30-Oct-2017.)
theorem dvrdir (B2 c_dv c_pl R U X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wi (wa (wcel R crg) (w3a (wcel X B2) (wcel Y B2) (wcel Z U))) (wceq (co (co X Y c_pl) Z c_dv) (co (co X Z c_dv) (co Y Z c_dv) c_pl)) $;

--| Multiplication of two ratios. Theorem I.14 of [Apostol] p. 18. (Contributed by Thierry Arnoux, 30-Oct-2017.)
theorem rdivmuldivd (ph: wff) (B2 c_dv c_pl R c_x U W X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y U) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel W U) $ >
  $ wi ph (wceq (co (co X Y c_dv) (co Z W c_dv) c_x) (co (co X Z c_x) (co Y W c_x) c_dv)) $;

--| Write the inverse function in terms of division. (Contributed by Mario Carneiro, 2-Jul-2014.)
theorem ringinvdv (B2 c_dv R U c_1 I X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wi (wa (wcel R crg) (wcel X U)) (wceq (cfv X I) (co c_1 X c_dv)) $;

--| The ring unity depends only on the ring's base set and multiplication operation. (Contributed by Mario Carneiro, 26-Dec-2014.)
theorem rngidpropd {x3 y1: setvar} (ph: wff) (B2 K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi ph (wceq (cfv K cur) (cfv L cur)) $;

--| The divisibility relation depends only on the ring's base set and multiplication operation. (Contributed by Mario Carneiro, 26-Dec-2014.)
theorem dvdsrpropd {x3 y1: setvar} (ph: wff) (B2 K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi ph (wceq (cfv K cdsr) (cfv L cdsr)) $;

--| The set of units depends only on the ring's base set and multiplication operation. (Contributed by Mario Carneiro, 26-Dec-2014.)
theorem unitpropd {x3 y1: setvar} (ph: wff) (B2 K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi ph (wceq (cfv K cui) (cfv L cui)) $;

--| The ring inverse function depends only on the ring's base set and multiplication operation. (Contributed by Mario Carneiro, 26-Dec-2014.) (Revised by Mario Carneiro, 5-Oct-2015.)
theorem invrpropd {x3 y1: setvar} (ph: wff) (B2 K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi ph (wceq (cfv K cinvr) (cfv L cinvr)) $;

--| An irreducible element of a ring is a non-unit that is not the product of two non-units. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem isirred {x3 y1: setvar} (B2: class x3 y1) (R: class) (c_x U I: class x3 y1) (N X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq I (cfv R cir) $ >
  $ wceq N (cdif B2 U) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wb (wcel X I) (wa (wcel X N) (wral x3 (wral y1 (wne (co (cv x3) (cv y1) c_x) X) N) N)) $;

--| The property of being a non-irreducible (reducible) element in a ring. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem isnirred {x3 y1: setvar} (B2: class x3 y1) (R: class) (c_x U I: class x3 y1) (N X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq I (cfv R cir) $ >
  $ wceq N (cdif B2 U) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wcel X B2) (wb (wn (wcel X I)) (wo (wcel X U) (wrex x3 (wrex y1 (wceq (co (cv x3) (cv y1) c_x) X) N) N))) $;

--| Expand out the class difference from ~ isirred . (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem isirred2 {x3 y1: setvar} (B2 R: class) (c_x: class x3 y1) (U: class) (I: class x3 y1) (X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq I (cfv R cir) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wb (wcel X I) (w3a (wcel X B2) (wn (wcel X U)) (wral x3 (wral y1 (wi (wceq (co (cv x3) (cv y1) c_x) X) (wo (wcel (cv x3) U) (wcel (cv y1) U))) B2) B2)) $;

--| Irreducibility is symmetric, so the irreducible elements of the opposite ring are the same as the original ring. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem opprirred (R S I: class):
  $ wceq S (cfv R coppr) $ >
  $ wceq I (cfv R cir) $ >
  $ wceq I (cfv S cir) $;

--| The additive identity is not irreducible. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem irredn0 (R I X c_0: class):
  $ wceq I (cfv R cir) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R crg) (wcel X I)) (wne X c_0) $;

--| An irreducible element is in the ring. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem irredcl (B2 R I X: class):
  $ wceq I (cfv R cir) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel X I) (wcel X B2) $;

--| An irreducible element is not a unit. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem irrednu (R U I X: class):
  $ wceq I (cfv R cir) $ >
  $ wceq U (cfv R cui) $ >
  $ wi (wcel X I) (wn (wcel X U)) $;

--| The multiplicative identity is not irreducible. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem irredn1 (R c_1 I X: class):
  $ wceq I (cfv R cir) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wcel X I)) (wne X c_1) $;

--| The product of an irreducible element and a unit is irreducible. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem irredrmul (R c_x U I X Y: class):
  $ wceq I (cfv R cir) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R crg) (wcel X I) (wcel Y U)) (wcel (co X Y c_x) I) $;

--| The product of a unit and an irreducible element is irreducible. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem irredlmul (R c_x U I X Y: class):
  $ wceq I (cfv R cir) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R crg) (wcel X U) (wcel Y I)) (wcel (co X Y c_x) I) $;

--| If product of two elements is irreducible, then one of the elements must be a unit. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem irredmul (B2 R c_x U I X Y: class):
  $ wceq I (cfv R cir) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel X B2) (wcel Y B2) (wcel (co X Y c_x) I)) (wo (wcel X U) (wcel Y U)) $;

--| The negative of an irreducible element is irreducible. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem irredneg (R I N X: class):
  $ wceq I (cfv R cir) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wi (wa (wcel R crg) (wcel X I)) (wcel (cfv X N) I) $;

--| An element is irreducible iff its negative is. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem irrednegb (B2 R I N X: class):
  $ wceq I (cfv R cir) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wa (wcel R crg) (wcel X B2)) (wb (wcel X I) (wcel (cfv X N) I)) $;

--| Syntax for the ring primes function.
term crpm: class;

--| Define the function associating with a ring its set of prime elements. A prime element is a nonzero non-unit that satisfies an equivalent of Euclid's lemma ~ euclemma . Prime elements are closely related to irreducible elements (see ~ df-irred ). (Contributed by Mario Carneiro, 17-Feb-2015.)
axiom df_rprm {x3 y1 w p b d: setvar}:
  $ wceq crpm (cmpt w cvv (csb b (cfv (cv w) cbs) (crab p (wral x3 (wral y1 (wsbc d (wi (wbr (cv p) (co (cv x3) (cv y1) (cfv (cv w) cmulr)) (cv d)) (wo (wbr (cv p) (cv x3) (cv d)) (wbr (cv p) (cv y1) (cv d)))) (cfv (cv w) cdsr)) (cv b)) (cv b)) (cdif (cv b) (cun (cfv (cv w) cui) (csn (cfv (cv w) c0g))))))) $;

--| non-unital ring homomorphisms.
term crnghm: class;

--| non-unital ring isomorphisms.
term crngim: class;

--| Define the set of non-unital ring homomorphisms from ` r ` to ` s ` . (Contributed by AV, 20-Feb-2020.)
axiom df_rnghm {x3 y1 w v f2 s1 r: setvar}:
  $ wceq crnghm (cmpo r s1 crng crng (csb v (cfv (cv r) cbs) (csb w (cfv (cv s1) cbs) (crab f2 (wral x3 (wral y1 (wa (wceq (cfv (co (cv x3) (cv y1) (cfv (cv r) cplusg)) (cv f2)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) (cfv (cv s1) cplusg))) (wceq (cfv (co (cv x3) (cv y1) (cfv (cv r) cmulr)) (cv f2)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) (cfv (cv s1) cmulr)))) (cv v)) (cv v)) (co (cv w) (cv v) cmap))))) $;

--| Define the set of non-unital ring isomorphisms from ` r ` to ` s ` . (Contributed by AV, 20-Feb-2020.)
axiom df_rngim {f2 s1 r: setvar}:
  $ wceq crngim (cmpo r s1 cvv cvv (crab f2 (wcel (ccnv (cv f2)) (co (cv s1) (cv r) crnghm)) (co (cv r) (cv s1) crnghm))) $;

--| Reverse closure of a non-unital ring homomorphism. (Contributed by AV, 22-Feb-2020.)
theorem rnghmrcl (R S F: class):
  $ wi (wcel F (co R S crnghm)) (wa (wcel R crng) (wcel S crng)) $;

--| The mapping of two non-unital rings to the non-unital ring homomorphisms between them is a function. (Contributed by AV, 1-Mar-2020.)
theorem rnghmfn:
  $ wfn crnghm (cxp crng crng) $;

--| The set of the non-unital ring homomorphisms between two non-unital rings. (Contributed by AV, 22-Feb-2020.)
theorem rnghmval {x3 y1 f2: setvar} (B2: class) (C: class x3 y1) (c_pl c_pb: class x3 y1 f2) (R S: class) (c_x c_as: class x3 y1 f2):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_as (cfv S cmulr) $ >
  $ wceq C (cfv S cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_pb (cfv S cplusg) $ >
  $ wi (wa (wcel R crng) (wcel S crng)) (wceq (co R S crnghm) (crab f2 (wral x3 (wral y1 (wa (wceq (cfv (co (cv x3) (cv y1) c_pl) (cv f2)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) c_pb)) (wceq (cfv (co (cv x3) (cv y1) c_x) (cv f2)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) c_as))) B2) B2) (co C B2 cmap))) $;

--| A function is a non-unital ring homomorphism iff it is a group homomorphism and preserves multiplication. (Contributed by AV, 22-Feb-2020.)
theorem isrnghm {x3 y1: setvar} (B2 R S: class) (c_x: class x3 y1) (F: class) (c_as: class x3 y1):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_as (cfv S cmulr) $ >
  $ wb (wcel F (co R S crnghm)) (wa (wa (wcel R crng) (wcel S crng)) (wa (wcel F (co R S cghm)) (wral x3 (wral y1 (wceq (cfv (co (cv x3) (cv y1) c_x) F) (co (cfv (cv x3) F) (cfv (cv y1) F) c_as)) B2) B2))) $;

--| A function is a non-unital ring homomorphism iff it preserves both addition and multiplication. (Contributed by AV, 27-Feb-2020.)
theorem isrnghmmul (R S F M N: class):
  $ wceq M (cfv R cmgp) $ >
  $ wceq N (cfv S cmgp) $ >
  $ wb (wcel F (co R S crnghm)) (wa (wa (wcel R crng) (wcel S crng)) (wa (wcel F (co R S cghm)) (wcel F (co M N cmgmhm)))) $;

--| A non-unital ring homomorphism is a homomorphism of multiplicative magmas. (Contributed by AV, 27-Feb-2020.)
theorem rnghmmgmhm (R S F M N: class):
  $ wceq M (cfv R cmgp) $ >
  $ wceq N (cfv S cmgp) $ >
  $ wi (wcel F (co R S crnghm)) (wcel F (co M N cmgmhm)) $;

--| The non-unital ring homomorphisms between two non-unital rings. (Contributed by AV, 1-Mar-2020.)
theorem rnghmval2 (R S: class):
  $ wi (wa (wcel R crng) (wcel S crng)) (wceq (co R S crnghm) (cin (co R S cghm) (co (cfv R cmgp) (cfv S cmgp) cmgmhm))) $;

--| An isomorphism of non-unital rings is a homomorphism whose converse is also a homomorphism. (Contributed by AV, 22-Feb-2020.)
theorem isrngim (R S F V W: class):
  $ wi (wa (wcel R V) (wcel S W)) (wb (wcel F (co R S crngim)) (wa (wcel F (co R S crnghm)) (wcel (ccnv F) (co S R crnghm)))) $;

--| Reverse closure for an isomorphism of non-unital rings. (Contributed by AV, 22-Feb-2020.)
theorem rngimrcl (R S F: class):
  $ wi (wcel F (co R S crngim)) (wa (wcel R cvv) (wcel S cvv)) $;

--| A non-unital ring homomorphism is an additive group homomorphism. (Contributed by AV, 23-Feb-2020.)
theorem rnghmghm (R S F: class):
  $ wi (wcel F (co R S crnghm)) (wcel F (co R S cghm)) $;

--| A ring homomorphism is a function. (Contributed by AV, 23-Feb-2020.)
theorem rnghmf (B2 C R S F: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wi (wcel F (co R S crnghm)) (wf B2 C F) $;

--| A homomorphism of non-unital rings preserves multiplication. (Contributed by AV, 23-Feb-2020.)
theorem rnghmmul (A2 B2 R S c_x c_xp F X: class):
  $ wceq X (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_xp (cfv S cmulr) $ >
  $ wi (w3a (wcel F (co R S crnghm)) (wcel A2 X) (wcel B2 X)) (wceq (cfv (co A2 B2 c_x) F) (co (cfv A2 F) (cfv B2 F) c_xp)) $;

--| Demonstration of non-unital ring homomorphism. (Contributed by AV, 23-Feb-2020.)
theorem isrnghm2d {x3 y1: setvar} (ph: wff) (B2 R S: class) (c_x c_xp: class x3 y1) (F: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_xp (cfv S cmulr) $ >
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel S crng) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (cfv (co (cv x3) (cv y1) c_x) F) (co (cfv (cv x3) F) (cfv (cv y1) F) c_xp)) $ >
  $ wi ph (wcel F (co R S cghm)) $ >
  $ wi ph (wcel F (co R S crnghm)) $;

--| Demonstration of non-unital ring homomorphism. (Contributed by AV, 23-Feb-2020.)
theorem isrnghmd {x3 y1: setvar} (ph: wff) (B2 C c_pl c_pd R S: class) (c_x c_xp: class x3 y1) (F: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_xp (cfv S cmulr) $ >
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel S crng) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (cfv (co (cv x3) (cv y1) c_x) F) (co (cfv (cv x3) F) (cfv (cv y1) F) c_xp)) $ >
  $ wceq C (cfv S cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_pd (cfv S cplusg) $ >
  $ wi ph (wf B2 C F) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (cfv (co (cv x3) (cv y1) c_pl) F) (co (cfv (cv x3) F) (cfv (cv y1) F) c_pd)) $ >
  $ wi ph (wcel F (co R S crnghm)) $;

--| A non-unital ring homomorphism is bijective iff its converse is also a non-unital ring homomorphism. (Contributed by AV, 27-Feb-2020.)
theorem rnghmf1o (B2 C R S F: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wi (wcel F (co R S crnghm)) (wb (wf1o B2 C F) (wcel (ccnv F) (co S R crnghm))) $;

--| An isomorphism of non-unital rings is a bijective homomorphism. (Contributed by AV, 23-Feb-2020.)
theorem isrngim2 (B2 C R S F V W: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wi (wa (wcel R V) (wcel S W)) (wb (wcel F (co R S crngim)) (wa (wcel F (co R S crnghm)) (wf1o B2 C F))) $;

--| An isomorphism of non-unital rings is a bijection. (Contributed by AV, 23-Feb-2020.)
theorem rngimf1o (B2 C R S F: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wi (wcel F (co R S crngim)) (wf1o B2 C F) $;

--| An isomorphism of non-unital rings is a homomorphism. (Contributed by AV, 23-Feb-2020.)
theorem rngimrnghm (B2 C R S F: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wi (wcel F (co R S crngim)) (wcel F (co R S crnghm)) $;

--| The converse of an isomorphism of non-unital rings is an isomorphism of non-unital rings. (Contributed by AV, 27-Feb-2025.)
theorem rngimcnv (S T F: class):
  $ wi (wcel F (co S T crngim)) (wcel (ccnv F) (co T S crngim)) $;

--| The composition of non-unital ring homomorphisms is a homomorphism. (Contributed by AV, 27-Feb-2020.)
theorem rnghmco (S T U F G: class):
  $ wi (wa (wcel F (co T U crnghm)) (wcel G (co S T crnghm))) (wcel (ccom F G) (co S U crnghm)) $;

--| The identity homomorphism on a non-unital ring. (Contributed by AV, 27-Feb-2020.)
theorem idrnghm (B2 R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R crng) (wcel (cres cid B2) (co R R crnghm)) $;

--| The constant mapping to zero is a magma homomorphism into a monoid. Remark: Instead of the assumption that T is a monoid, it would be sufficient that T is a magma with a right or left identity. (Contributed by AV, 17-Apr-2020.)
theorem c0mgm {x3: setvar} (B2 S T: class) (H: class x3) (c_0: class):
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_0 (cfv T c0g) $ >
  $ wceq H (cmpt x3 B2 c_0) $ >
  $ wi (wa (wcel S cmgm) (wcel T cmnd)) (wcel H (co S T cmgmhm)) $;

--| The constant mapping to zero is a monoid homomorphism. (Contributed by AV, 16-Apr-2020.)
theorem c0mhm {x3: setvar} (B2 S T: class) (H: class x3) (c_0: class):
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_0 (cfv T c0g) $ >
  $ wceq H (cmpt x3 B2 c_0) $ >
  $ wi (wa (wcel S cmnd) (wcel T cmnd)) (wcel H (co S T cmhm)) $;

--| The constant mapping to zero is a group homomorphism. (Contributed by AV, 16-Apr-2020.)
theorem c0ghm {x3: setvar} (B2 S T: class) (H: class x3) (c_0: class):
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_0 (cfv T c0g) $ >
  $ wceq H (cmpt x3 B2 c_0) $ >
  $ wi (wa (wcel S cgrp) (wcel T cgrp)) (wcel H (co S T cghm)) $;

--| The constant mapping to zero is a magma homomorphism from a magma with one element to any monoid. (Contributed by AV, 17-Apr-2020.)
theorem c0snmgmhm {x3: setvar} (B2 S T: class) (H: class x3) (c_0: class):
  $ wceq B2 (cfv T cbs) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq H (cmpt x3 B2 c_0) $ >
  $ wi (w3a (wcel S cmnd) (wcel T cmgm) (wceq (cfv B2 chash) c1)) (wcel H (co T S cmgmhm)) $;

--| The constant mapping to zero is a monoid homomorphism from the trivial monoid (consisting of the zero only) to any monoid. (Contributed by AV, 17-Apr-2020.)
theorem c0snmhm {x3: setvar} (B2 S T: class) (H: class x3) (c_0 Z: class):
  $ wceq B2 (cfv T cbs) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq H (cmpt x3 B2 c_0) $ >
  $ wceq Z (cfv T c0g) $ >
  $ wi (w3a (wcel S cmnd) (wcel T cmnd) (wceq B2 (csn Z))) (wcel H (co T S cmhm)) $;

--| The constant mapping to zero is a group homomorphism from the trivial group (consisting of the zero only) to any group. (Contributed by AV, 17-Apr-2020.)
theorem c0snghm {x3: setvar} (B2 S T: class) (H: class x3) (c_0 Z: class):
  $ wceq B2 (cfv T cbs) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq H (cmpt x3 B2 c_0) $ >
  $ wceq Z (cfv T c0g) $ >
  $ wi (w3a (wcel S cgrp) (wcel T cgrp) (wceq B2 (csn Z))) (wcel H (co T S cghm)) $;

--| If there is a non-unital ring isomorphism between a unital ring and a non-unital ring, then the function value of the ring unity of the unital ring is an element of the base set of the non-unital ring. (Contributed by AV, 27-Feb-2025.)
theorem rngisomfv1 (B2 R S c_1 F: class):
  $ wceq c_1 (cfv R cur) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi (wa (wcel R crg) (wcel F (co R S crngim))) (wcel (cfv c_1 F) B2) $;

--| If there is a non-unital ring isomorphism between a unital ring and a non-unital ring, then the function value of the ring unity of the unital ring is a ring unity of the non-unital ring. (Contributed by AV, 27-Feb-2025.)
theorem rngisom1 {x3: setvar} (B2: class x3) (R S: class) (c_x c_1: class x3) (F: class):
  $ wceq c_1 (cfv R cur) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi (w3a (wcel R crg) (wcel S crng) (wcel F (co R S crngim))) (wral x3 (wa (wceq (co (cfv c_1 F) (cv x3) c_x) (cv x3)) (wceq (co (cv x3) (cfv c_1 F) c_x) (cv x3))) B2) $;

--| If there is a non-unital ring isomorphism between a unital ring and a non-unital ring, then both rings are unital. (Contributed by AV, 27-Feb-2025.)
theorem rngisomring (R S F: class):
  $ wi (w3a (wcel R crg) (wcel S crng) (wcel F (co R S crngim))) (wcel S crg) $;

--| If there is a non-unital ring isomorphism between a unital ring and a non-unital ring, then the ring unity of the second ring is the function value of the ring unity of the first ring for the isomorphism. (Contributed by AV, 16-Mar-2025.)
theorem rngisomring1 (R S F: class):
  $ wi (w3a (wcel R crg) (wcel S crng) (wcel F (co R S crngim))) (wceq (cfv S cur) (cfv (cfv R cur) F)) $;

--| Extend class notation with the ring homomorphisms.
term crh: class;

--| Extend class notation with the ring isomorphisms.
term crs: class;

--| Extend class notation with the ring isomorphism relation.
term cric: class;

--| Define the set of ring homomorphisms from ` r ` to ` s ` . (Contributed by Stefan O'Rear, 7-Mar-2015.)
axiom df_rhm {x3 y1 w v f2 s1 r: setvar}:
  $ wceq crh (cmpo r s1 crg crg (csb v (cfv (cv r) cbs) (csb w (cfv (cv s1) cbs) (crab f2 (wa (wceq (cfv (cfv (cv r) cur) (cv f2)) (cfv (cv s1) cur)) (wral x3 (wral y1 (wa (wceq (cfv (co (cv x3) (cv y1) (cfv (cv r) cplusg)) (cv f2)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) (cfv (cv s1) cplusg))) (wceq (cfv (co (cv x3) (cv y1) (cfv (cv r) cmulr)) (cv f2)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) (cfv (cv s1) cmulr)))) (cv v)) (cv v))) (co (cv w) (cv v) cmap))))) $;

--| Define the set of ring isomorphisms from ` r ` to ` s ` . (Contributed by Stefan O'Rear, 7-Mar-2015.)
axiom df_rim {f2 s1 r: setvar}:
  $ wceq crs (cmpo r s1 cvv cvv (crab f2 (wcel (ccnv (cv f2)) (co (cv s1) (cv r) crh)) (co (cv r) (cv s1) crh))) $;

--| The property of a ring homomorphism can be decomposed into separate homomorphic conditions for addition and multiplication. (Contributed by Stefan O'Rear, 7-Mar-2015.)
theorem dfrhm2 {s1 r: setvar}:
  $ wceq crh (cmpo r s1 crg crg (cin (co (cv r) (cv s1) cghm) (co (cfv (cv r) cmgp) (cfv (cv s1) cmgp) cmhm))) $;

--| The set of ring homomorphisms. (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by Mario Carneiro, 22-Sep-2015.) (Revised by AV, 24-Jul-2026.)
theorem rhmval0 {x3 y1 f2: setvar} (B2: class) (C c_pl c_pd: class x3 y1) (R S: class) (c_x c_xp c_1 N: class x3 y1):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq N (cfv S cur) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_xp (cfv S cmulr) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_pd (cfv S cplusg) $ >
  $ wi (wa (wcel R crg) (wcel S crg)) (wceq (co R S crh) (crab f2 (wa (wceq (cfv c_1 (cv f2)) N) (wral x3 (wral y1 (wa (wceq (cfv (co (cv x3) (cv y1) c_pl) (cv f2)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) c_pd)) (wceq (cfv (co (cv x3) (cv y1) c_x) (cv f2)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) c_xp))) B2) B2)) (co C B2 cmap))) $;

--| The predicate "is a ring homomorphism from ` R ` to ` S ` ". (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by AV, 24-Jul-2026.)
theorem isrhm0 {x3 y1: setvar} (B2: class) (C c_pl c_pd: class x3 y1) (R S: class) (c_x c_xp c_1: class x3 y1) (F: class) (N: class x3 y1):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq N (cfv S cur) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_xp (cfv S cmulr) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_pd (cfv S cplusg) $ >
  $ wi (wa (wcel R crg) (wcel S crg)) (wb (wcel F (co R S crh)) (w3a (wf B2 C F) (wceq (cfv c_1 F) N) (wral x3 (wral y1 (wa (wceq (cfv (co (cv x3) (cv y1) c_pl) F) (co (cfv (cv x3) F) (cfv (cv y1) F) c_pd)) (wceq (cfv (co (cv x3) (cv y1) c_x) F) (co (cfv (cv x3) F) (cfv (cv y1) F) c_xp))) B2) B2))) $;

--| Reverse closure of a ring homomorphism. (Contributed by Stefan O'Rear, 7-Mar-2015.)
theorem rhmrcl1 (R S F: class):
  $ wi (wcel F (co R S crh)) (wcel R crg) $;

--| Reverse closure of a ring homomorphism. (Contributed by Stefan O'Rear, 7-Mar-2015.)
theorem rhmrcl2 (R S F: class):
  $ wi (wcel F (co R S crh)) (wcel S crg) $;

--| A function is a ring homomorphism iff it preserves both addition and multiplication. (Contributed by Stefan O'Rear, 7-Mar-2015.)
theorem isrhm (R S F M N: class):
  $ wceq M (cfv R cmgp) $ >
  $ wceq N (cfv S cmgp) $ >
  $ wb (wcel F (co R S crh)) (wa (wa (wcel R crg) (wcel S crg)) (wa (wcel F (co R S cghm)) (wcel F (co M N cmhm)))) $;

--| A ring homomorphism is a homomorphism of multiplicative monoids. (Contributed by Stefan O'Rear, 7-Mar-2015.)
theorem rhmmhm (R S F M N: class):
  $ wceq M (cfv R cmgp) $ >
  $ wceq N (cfv S cmgp) $ >
  $ wi (wcel F (co R S crh)) (wcel F (co M N cmhm)) $;

--| Each unital ring homomorphism is a non-unital ring homomorphism. (Contributed by AV, 29-Feb-2020.)
theorem rhmisrnghm (R S F: class):
  $ wi (wcel F (co R S crh)) (wcel F (co R S crnghm)) $;

--| Reverse closure for an isomorphism of rings. (Contributed by AV, 22-Oct-2019.)
theorem rimrcl (R S F: class):
  $ wi (wcel F (co R S crs)) (wa (wcel R cvv) (wcel S cvv)) $;

--| A ring isomorphism is a homomorphism whose converse is also a homomorphism. Compare ~ isgim2 . (Contributed by AV, 22-Oct-2019.) Remove sethood antecedent. (Revised by SN, 10-Jan-2025.)
theorem isrim0 (R S F: class):
  $ wb (wcel F (co R S crs)) (wa (wcel F (co R S crh)) (wcel (ccnv F) (co S R crh))) $;

--| A ring homomorphism is an additive group homomorphism. (Contributed by Stefan O'Rear, 7-Mar-2015.)
theorem rhmghm (R S F: class):
  $ wi (wcel F (co R S crh)) (wcel F (co R S cghm)) $;

--| A ring homomorphism is a function. (Contributed by Stefan O'Rear, 8-Mar-2015.)
theorem rhmf (B2 C R S F: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wi (wcel F (co R S crh)) (wf B2 C F) $;

--| Closure law for a ring homomorphism. (Contributed by Jeff Madsen, 3-Jan-2011.) (Revised by AV, 10-Jan-2025.)
theorem rhmcl (A2 B2 C R S F: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wi (wa (w3a (wcel R crg) (wcel S crg) (wcel F (co R S crh))) (wcel A2 B2)) (wcel (cfv A2 F) C) $;

--| The converse of a ring isomorphism is a ring isomorphism. (Contributed by Jeff Madsen, 16-Jun-2011.) (Revised by SN, 10-Jan-2025.)
theorem rimcnv (R S F: class):
  $ wi (wcel F (co R S crs)) (wcel (ccnv F) (co S R crs)) $;

--| Ring homomorphisms preserve addition. (Contributed by Jeff Madsen, 3-Jan-2011.) (Revised by AV, 10-Jan-2025.)
theorem rhmadd (A2 B2 c_pl c_pd R S F X: class):
  $ wceq X (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_pd (cfv S cplusg) $ >
  $ wi (w3a (wcel F (co R S crh)) (wcel A2 X) (wcel B2 X)) (wceq (cfv (co A2 B2 c_pl) F) (co (cfv A2 F) (cfv B2 F) c_pd)) $;

--| Ring homomorphisms preserve subtraction. (Contributed by Jeff Madsen, 15-Jun-2011.) (Revised by AV, 10-Jan-2025.)
theorem rhmsub (A2 B2 R S F c_mi N X: class):
  $ wceq X (cfv R cbs) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wceq N (cfv S csg) $ >
  $ wi (w3a (wcel F (co R S crh)) (wcel A2 X) (wcel B2 X)) (wceq (cfv (co A2 B2 c_mi) F) (co (cfv A2 F) (cfv B2 F) N)) $;

--| A homomorphism of rings preserves multiplication. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem rhmmul (A2 B2 R S c_x c_xp F X: class):
  $ wceq X (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_xp (cfv S cmulr) $ >
  $ wi (w3a (wcel F (co R S crh)) (wcel A2 X) (wcel B2 X)) (wceq (cfv (co A2 B2 c_x) F) (co (cfv A2 F) (cfv B2 F) c_xp)) $;

--| Demonstration of ring homomorphism. (Contributed by Mario Carneiro, 13-Jun-2015.)
theorem isrhm2d {x3 y1: setvar} (ph: wff) (B2 R S: class) (c_x c_xp c_1: class x3 y1) (F: class) (N: class x3 y1):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq N (cfv S cur) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_xp (cfv S cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel S crg) $ >
  $ wi ph (wceq (cfv c_1 F) N) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (cfv (co (cv x3) (cv y1) c_x) F) (co (cfv (cv x3) F) (cfv (cv y1) F) c_xp)) $ >
  $ wi ph (wcel F (co R S cghm)) $ >
  $ wi ph (wcel F (co R S crh)) $;

--| Demonstration of ring homomorphism. (Contributed by Stefan O'Rear, 8-Mar-2015.)
theorem isrhmd {x3 y1: setvar} (ph: wff) (B2 C c_pl c_pd R S: class) (c_x c_xp c_1: class x3 y1) (F: class) (N: class x3 y1):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq N (cfv S cur) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_xp (cfv S cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel S crg) $ >
  $ wi ph (wceq (cfv c_1 F) N) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (cfv (co (cv x3) (cv y1) c_x) F) (co (cfv (cv x3) F) (cfv (cv y1) F) c_xp)) $ >
  $ wceq C (cfv S cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_pd (cfv S cplusg) $ >
  $ wi ph (wf B2 C F) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (cfv (co (cv x3) (cv y1) c_pl) F) (co (cfv (cv x3) F) (cfv (cv y1) F) c_pd)) $ >
  $ wi ph (wcel F (co R S crh)) $;

--| A ring homomorphism preserves ` 0 ` . (Contributed by Jeff Madsen, 2-Jan-2011.) (Revised by AV, 23-Jul-2026.)
theorem rhm0 (R S F c_0 Z: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq Z (cfv S c0g) $ >
  $ wi (wcel F (co R S crh)) (wceq (cfv c_0 F) Z) $;

--| Ring homomorphisms are required to fix 1. (Contributed by Stefan O'Rear, 8-Mar-2015.)
theorem rhm1 (R S c_1 F N: class):
  $ wceq c_1 (cfv R cur) $ >
  $ wceq N (cfv S cur) $ >
  $ wi (wcel F (co R S crh)) (wceq (cfv c_1 F) N) $;

--| The identity homomorphism on a ring. (Contributed by AV, 14-Feb-2020.)
theorem idrhm (B2 R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R crg) (wcel (cres cid B2) (co R R crh)) $;

--| The image of a surjective homomorphism from a commutative ring is commutative. (Contributed by Jeff Madsen, 4-Jan-2011.) (Revised by AV, 19-Jul-2026.)
theorem crngrhmfo (B2 R S F: class):
  $ wceq B2 (cfv S cbs) $ >
  $ wi (w3a (wcel R ccrg) (wcel F (co R S crh)) (wfo (cdm F) B2 F)) (wcel S ccrg) $;

--| A ring homomorphism is bijective iff its converse is also a ring homomorphism. (Contributed by AV, 22-Oct-2019.)
theorem rhmf1o (B2 C R S F: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wi (wcel F (co R S crh)) (wb (wf1o B2 C F) (wcel (ccnv F) (co S R crh))) $;

--| An isomorphism of rings is a bijective homomorphism. (Contributed by Jeff Madsen, 16-Jun-2011.) (Revised by AV, 22-Oct-2019.) Remove sethood antecedent. (Revised by SN, 12-Jan-2025.)
theorem isrim (B2 C R S F: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wb (wcel F (co R S crs)) (wa (wcel F (co R S crh)) (wf1o B2 C F)) $;

--| An isomorphism of rings is a bijection. (Contributed by Jeff Madsen, 16-Jun-2011.) (Revised by AV, 22-Oct-2019.)
theorem rimf1o (B2 C R S F: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wi (wcel F (co R S crs)) (wf1o B2 C F) $;

--| The set of ring isomorphisms. (Contributed by Jeff Madsen, 16-Jun-2011.) (Revised by AV, 24-Jul-2026.)
theorem rimval {f2: setvar} (B2 C R S: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wceq (co R S crs) (crab f2 (wf1o B2 C (cv f2)) (co R S crh)) $;

--| A ring isomorphism is a homomorphism. Compare ~ gimghm . (Contributed by Jeff Madsen, 16-Jun-2011.) (Revised by AV, 22-Oct-2019.) Remove hypotheses. (Revised by SN, 10-Jan-2025.)
theorem rimrhm (R S F: class):
  $ wi (wcel F (co R S crs)) (wcel F (co R S crh)) $;

--| Reverse closure of a ring isomorphism. (Contributed by SN, 19-Feb-2025.)
theorem rimrcl1 (R S F: class):
  $ wi (wcel F (co R S crs)) (wcel R crg) $;

--| Reverse closure of a ring isomorphism. (Contributed by SN, 19-Feb-2025.)
theorem rimrcl2 (R S F: class):
  $ wi (wcel F (co R S crs)) (wcel S crg) $;

--| An isomorphism of rings is an isomorphism of their additive groups. (Contributed by AV, 24-Dec-2019.)
theorem rimgim (R S F: class):
  $ wi (wcel F (co R S crs)) (wcel F (co R S cgim)) $;

--| Each unital ring isomorphism is a non-unital ring isomorphism. (Contributed by AV, 30-Mar-2025.)
theorem rimisrngim (R S F: class):
  $ wi (wcel F (co R S crs)) (wcel F (co R S crngim)) $;

--| The mapping of two rings to the ring homomorphisms between them is a function. (Contributed by AV, 1-Mar-2020.)
theorem rhmfn:
  $ wfn crh (cxp crg crg) $;

--| The mapping of two rings to the ring isomorphisms between them is a function. (Contributed by AV, 24-Jul-2025.)
theorem rimfn:
  $ wfn crs (cxp cvv cvv) $;

--| The ring homomorphisms between two rings. (Contributed by AV, 1-Mar-2020.)
theorem rhmval (R S: class):
  $ wi (wa (wcel R crg) (wcel S crg)) (wceq (co R S crh) (cin (co R S cghm) (co (cfv R cmgp) (cfv S cmgp) cmhm))) $;

--| The composition of ring homomorphisms is a homomorphism. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem rhmco (S T U F G: class):
  $ wi (wa (wcel F (co T U crh)) (wcel G (co S T crh))) (wcel (ccom F G) (co S U crh)) $;

--| A ring homomorphism is injective if and only if its kernel is zero. (Contributed by Jeff Madsen, 16-Jun-2011.) (Revised by AV, 24-Jul-2026.)
theorem rhmkerinj (B2 C R S F c_0 Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq Z (cfv S c0g) $ >
  $ wi (wcel F (co R S crh)) (wb (wf1 B2 C F) (wceq (cima (ccnv F) (csn Z)) (csn c_0))) $;

--| Right composition with a function on the index sets yields a ring homomorphism of structure powers. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem pwsco1rhm {g2: setvar} (ph: wff) (A2 B2 C R F: class) (V W: class g2) (Y Z: class):
  $ wceq Y (co R A2 cpws) $ >
  $ wceq Z (co R B2 cpws) $ >
  $ wceq C (cfv Z cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wcel (cmpt g2 C (ccom (cv g2) F)) (co Z Y crh)) $;

--| Left composition with a ring homomorphism yields a ring homomorphism of structure powers. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem pwsco2rhm {g2: setvar} (ph: wff) (A2 B2 R S F: class) (V: class g2) (Y Z: class):
  $ wceq Y (co R A2 cpws) $ >
  $ wceq Z (co S A2 cpws) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel F (co R S crh)) $ >
  $ wi ph (wcel (cmpt g2 B2 (ccom F (cv g2))) (co Y Z crh)) $;

--| Define the ring isomorphism relation, analogous to ~ df-gic : Two (unital) rings are said to be _isomorphic_ iff they are connected by at least one isomorphism. Isomorphic rings share all global ring properties, but to relate local properties requires knowledge of a specific isomorphism. (Contributed by Jeff Madsen, 16-Jun-2011.) Adapted to ~ df-gic . (Revised by AV, 24-Dec-2019.)
axiom df_ric:
  $ wceq cric (cima (ccnv crs) (cdif cvv c1o)) $;

--| The domain of the ring isomorphism relation is a relation. (Contributed by AV, 24-Jul-2026.)
theorem ricrel:
  $ wrel cric $;

--| The relation "is isomorphic to" for (unital) rings. (Contributed by AV, 24-Dec-2019.)
theorem brric (R S: class):
  $ wb (wbr R S cric) (wne (co R S crs) c0) $;

--| Prove isomorphic by an explicit isomorphism. (Contributed by Jeff Madsen, 16-Jun-2011.) (Revised by SN, 10-Jan-2025.)
theorem brrici (R S F: class):
  $ wi (wcel F (co R S crs)) (wbr R S cric) $;

--| The composition of ring isomorphisms is a ring isomorphism. (Contributed by Jeff Madsen, 16-Jun-2011.) (Revised by SN, 17-Jan-2025.)
theorem rimco (R S T F G: class):
  $ wi (wa (wcel F (co S T crs)) (wcel G (co R S crs))) (wcel (ccom F G) (co R T crs)) $;

--| Ring isomorphism is reflexive. (Contributed by by AV, 24-Jul-2026.)
theorem ricref (R: class):
  $ wi (wcel R crg) (wbr R R cric) $;

--| Ring isomorphism implies the left side is a ring. (Contributed by AV, 23-Jul-2026.)
theorem riclcl (R S: class):
  $ wi (wbr R S cric) (wcel R crg) $;

--| Ring isomorphism implies the right side is a ring. (Contributed by AV, 23-Jul-2026.)
theorem ricrcl (R S: class):
  $ wi (wbr R S cric) (wcel S crg) $;

--| Ring isomorphism is symmetric. (Contributed by SN, 10-Jan-2025.)
theorem ricsym (R S: class):
  $ wi (wbr R S cric) (wbr S R cric) $;

--| Ring isomorphism is transitive. (Contributed by SN, 17-Jan-2025.)
theorem rictr (R S T: class):
  $ wi (wa (wbr R S cric) (wbr S T cric)) (wbr R T cric) $;

--| The relation "is isomorphic to" for (unital) rings. (Contributed by Jeff Madsen, 16-Jun-2011.) (Revised by AV, 24-Dec-2019.)
theorem isbrric2 {f2: setvar} (R S: class):
  $ wb (wbr R S cric) (wa (wa (wcel R crg) (wcel S crg)) (wex f2 (wcel (cv f2) (co R S crs)))) $;

--| The ring isomorphism relation. (Contributed by Jeff Madsen, 16-Jun-2011.) (Revised by AV, 23-Jul-2026.)
theorem brric2 {f2: setvar} (R S: class):
  $ wi (wa (wcel R crg) (wcel S crg)) (wb (wbr R S cric) (wex f2 (wcel (cv f2) (co R S crs)))) $;

--| If two rings are (ring) isomorphic, their additive groups are (group) isomorphic. (Contributed by AV, 24-Dec-2019.)
theorem ricgic (R S: class):
  $ wi (wbr R S cric) (wbr R S cgic) $;

--| Ring isomorphism is an equivalence relation. (Contributed by Jeff Madsen, 16-Jun-2011.) (Revised by Mario Carneiro, 12-Aug-2015.) (Revised by AV, 24-Jul-2026.)
theorem ricer:
  $ wer crg cric $;

--| Alternate definition of the ring isomorphism relation. (Contributed by Jeff Madsen, 16-Jun-2011.) (Revised by AV, 23-Aug-2026.)
theorem dfric2 {f2 s1 r: setvar}:
  $ wceq cric (copab r s1 (wa (wa (wcel (cv r) crg) (wcel (cv s1) crg)) (wex f2 (wcel (cv f2) (co (cv r) (cv s1) crs))))) $;

--| A ring homomorphism preserves the divisibility relation. (Contributed by Thierry Arnoux, 22-Oct-2017.)
theorem rhmdvdsr (A2 B2 c_pa c_dv R S F X: class):
  $ wceq X (cfv R cbs) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wceq c_dv (cfv S cdsr) $ >
  $ wi (wa (w3a (wcel F (co R S crh)) (wcel A2 X) (wcel B2 X)) (wbr A2 B2 c_pa)) (wbr (cfv A2 F) (cfv B2 F) c_dv) $;

--| A ring homomorphism is also a ring homomorphism for the opposite rings. (Contributed by Thierry Arnoux, 27-Oct-2017.)
theorem rhmopp (R S F: class):
  $ wi (wcel F (co R S crh)) (wcel F (co (cfv R coppr) (cfv S coppr) crh)) $;

--| Ring homomorphisms preserve unit elements. (Contributed by Thierry Arnoux, 23-Oct-2017.)
theorem elrhmunit (A2 R S F: class):
  $ wi (wa (wcel F (co R S crh)) (wcel A2 (cfv R cui))) (wcel (cfv A2 F) (cfv S cui)) $;

--| Ring homomorphisms preserve the inverse of unit elements. (Contributed by Thierry Arnoux, 23-Oct-2017.)
theorem rhmunitinv (A2 R S F: class):
  $ wi (wa (wcel F (co R S crh)) (wcel A2 (cfv R cui))) (wceq (cfv (cfv A2 (cfv R cinvr)) F) (cfv (cfv A2 F) (cfv S cinvr))) $;

--| The class of nonzero rings.
term cnzr: class;

--| A nonzero or nontrivial ring is a ring with at least two values, or equivalently where 1 and 0 are different. (Contributed by Stefan O'Rear, 24-Feb-2015.)
axiom df_nzr {r: setvar}:
  $ wceq cnzr (crab r (wne (cfv (cv r) cur) (cfv (cv r) c0g)) crg) $;

--| Property of a nonzero ring. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem isnzr (R c_1 c_0: class):
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wb (wcel R cnzr) (wa (wcel R crg) (wne c_1 c_0)) $;

--| One and zero are different in a nonzero ring. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem nzrnz (R c_1 c_0: class):
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R cnzr) (wne c_1 c_0) $;

--| A nonzero ring is a ring. (Contributed by Stefan O'Rear, 24-Feb-2015.) (Proof shortened by SN, 23-Feb-2025.)
theorem nzrring (R: class):
  $ wi (wcel R cnzr) (wcel R crg) $;

--| Obsolete version of ~ nzrring as of 23-Feb-2025. (Contributed by Stefan O'Rear, 24-Feb-2015.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem nzrringOLD (R: class):
  $ wi (wcel R cnzr) (wcel R crg) $;

--| Equivalent characterization of nonzero rings: they have at least two elements. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem isnzr2 (B2 R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wb (wcel R cnzr) (wa (wcel R crg) (wbr c2o B2 cdom)) $;

--| In a nonzero ring, the zero ideal is different from the unit ideal. (Contributed by Thierry Arnoux, 16-Mar-2025.)
theorem drnglidl1ne0 (B2 R c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R cnzr) (wne B2 (csn c_0)) $;

--| Equivalent characterization of nonzero rings: they have at least two elements. Analogous to ~ isnzr2 . (Contributed by AV, 14-Apr-2019.)
theorem isnzr2hash (B2 R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wb (wcel R cnzr) (wa (wcel R crg) (wbr c1 (cfv B2 chash) clt)) $;

--| If two structures have the same components (properties), one is a nonzero ring iff the other one is. (Contributed by SN, 21-Jun-2025.)
theorem nzrpropd {x3 y1: setvar} (ph: wff) (B2 K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi ph (wb (wcel K cnzr) (wcel L cnzr)) $;

--| The opposite of a nonzero ring is nonzero, bidirectional form of ~ opprnzr . (Contributed by SN, 20-Jun-2025.)
theorem opprnzrb (R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wb (wcel R cnzr) (wcel O cnzr) $;

--| The opposite of a nonzero ring is nonzero. (Contributed by Mario Carneiro, 17-Jun-2015.)
theorem opprnzr (R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wi (wcel R cnzr) (wcel O cnzr) $;

--| A ring is nonzero if it has a nonzero element. (Contributed by Stefan O'Rear, 6-Feb-2015.) (Revised by Mario Carneiro, 13-Jun-2015.)
theorem ringelnzr (B2 R X c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wa (wcel R crg) (wcel X (cdif B2 (csn c_0)))) (wcel R cnzr) $;

--| A unit is nonzero in any nonzero ring. (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem nzrunit (A2 R U c_0: class):
  $ wceq U (cfv R cui) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R cnzr) (wcel A2 U)) (wne A2 c_0) $;

--| A ring is a zero ring iff it is not a nonzero ring. (Contributed by AV, 14-Apr-2019.)
theorem _0ringnnzr (R: class):
  $ wi (wcel R crg) (wb (wceq (cfv (cfv R cbs) chash) c1) (wn (wcel R cnzr))) $;

--| If a ring has only one element, it is the zero ring. According to Wikipedia ("Zero ring", 14-Apr-2019, ~ https://en.wikipedia.org/wiki/Zero_ring): "The zero ring, denoted {0} or simply 0, consists of the one-element set {0} with the operations + and * defined so that 0 + 0 = 0 and 0 * 0 = 0.". (Contributed by AV, 14-Apr-2019.)
theorem _0ring (B2 R c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R crg) (wceq (cfv B2 chash) c1)) (wceq B2 (csn c_0)) $;

--| A zero ring is a ring which is not a nonzero ring. (Contributed by AV, 17-Apr-2020.)
theorem _0ringdif (B2 R c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wb (wcel R (cdif crg cnzr)) (wa (wcel R crg) (wceq B2 (csn c_0))) $;

--| The base set of a zero ring, a ring which is not a nonzero ring, is the singleton of the zero element. (Contributed by AV, 17-Apr-2020.)
theorem _0ringbas (B2 R c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R (cdif crg cnzr)) (wceq B2 (csn c_0)) $;

--| In a ring with only one element, i.e. a zero ring, the zero and the identity element are the same. (Contributed by AV, 14-Apr-2019.)
theorem _0ring01eq (B2 R c_1 c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wceq (cfv B2 chash) c1)) (wceq c_0 c_1) $;

--| If the zero and the identity element of a ring are the same, the ring is the zero ring. (Contributed by AV, 16-Apr-2019.) (Proof shortened by SN, 23-Feb-2025.)
theorem _01eq0ring (B2 R c_1 c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wceq c_0 c_1)) (wceq B2 (csn c_0)) $;

--| Obsolete version of ~ 01eq0ring as of 23-Feb-2025. (Contributed by AV, 16-Apr-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem _01eq0ringOLD (B2 R c_1 c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wceq c_0 c_1)) (wceq B2 (csn c_0)) $;

--| In a ring, ` 0 = 1 ` iff the ring contains only ` 0 ` . (Contributed by Jeff Madsen, 6-Jan-2011.) (Revised by AV, 27-Jun-2026.)
theorem _0ring01eqbi2 (B2 R c_1 c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R crg) (wb (wceq B2 (csn c_0)) (wceq c_1 c_0)) $;

--| In a unital ring the zero equals the unity iff the ring is the zero ring. (Contributed by FL, 14-Feb-2010.) (Revised by AV, 23-Jan-2020.)
theorem _0ring01eqbi (B2 R c_1 c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R crg) (wb (wbr B2 c1o cen) (wceq c_1 c_0)) $;

--| In a zero ring, a ring which is not a nonzero ring, the ring unity equals the zero element. (Contributed by AV, 17-Apr-2020.)
theorem _0ring1eq0 (B2 R c_1 c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R (cdif crg cnzr)) (wceq c_1 c_0) $;

--| The constant mapping to zero is a ring homomorphism from any ring to the zero ring. (Contributed by AV, 17-Apr-2020.)
theorem c0rhm {x3: setvar} (B2 S T: class) (H: class x3) (c_0: class):
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_0 (cfv T c0g) $ >
  $ wceq H (cmpt x3 B2 c_0) $ >
  $ wi (wa (wcel S crg) (wcel T (cdif crg cnzr))) (wcel H (co S T crh)) $;

--| The constant mapping to zero is a non-unital ring homomorphism from any non-unital ring to the zero ring. (Contributed by AV, 17-Apr-2020.)
theorem c0rnghm {x3: setvar} (B2 S T: class) (H: class x3) (c_0: class):
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_0 (cfv T c0g) $ >
  $ wceq H (cmpt x3 B2 c_0) $ >
  $ wi (wa (wcel S crng) (wcel T (cdif crg cnzr))) (wcel H (co S T crnghm)) $;

--| The constant mapping to zero is a non-unital ring homomorphism from the zero ring to any non-unital ring. (Contributed by AV, 17-Apr-2020.)
theorem zrrnghm {x3: setvar} (B2 S T: class) (H: class x3) (c_0: class):
  $ wceq B2 (cfv T cbs) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq H (cmpt x3 B2 c_0) $ >
  $ wi (wa (wcel S crng) (wcel T (cdif crg cnzr))) (wcel H (co T S crnghm)) $;

--| There is no ring homomorphism from the zero ring into a nonzero ring. (Contributed by AV, 18-Apr-2020.)
theorem nrhmzr (R Z: class):
  $ wi (wa (wcel Z (cdif crg cnzr)) (wcel R cnzr)) (wceq (co Z R crh) c0) $;

--| Extend class notation with class of all local rings.
term clring: class;

--| A local ring is a nonzero ring where for any two elements summing to one, at least one is invertible. Any field is a local ring; the ring of integers is an example of a ring which is not a local ring. (Contributed by Jim Kingdon, 18-Feb-2025.) (Revised by SN, 23-Feb-2025.)
axiom df_lring {x3 y1 r: setvar}:
  $ wceq clring (crab r (wral x3 (wral y1 (wi (wceq (co (cv x3) (cv y1) (cfv (cv r) cplusg)) (cfv (cv r) cur)) (wo (wcel (cv x3) (cfv (cv r) cui)) (wcel (cv y1) (cfv (cv r) cui)))) (cfv (cv r) cbs)) (cfv (cv r) cbs)) cnzr) $;

--| The predicate "is a local ring". (Contributed by SN, 23-Feb-2025.)
theorem islring {x3 y1: setvar} (B2 c_pl: class x3 y1) (R: class) (U c_1: class x3 y1):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq U (cfv R cui) $ >
  $ wb (wcel R clring) (wa (wcel R cnzr) (wral x3 (wral y1 (wi (wceq (co (cv x3) (cv y1) c_pl) c_1) (wo (wcel (cv x3) U) (wcel (cv y1) U))) B2) B2)) $;

--| A local ring is a nonzero ring. (Contributed by SN, 23-Feb-2025.)
theorem lringnzr (R: class):
  $ wi (wcel R clring) (wcel R cnzr) $;

--| A local ring is a ring. (Contributed by Jim Kingdon, 20-Feb-2025.) (Revised by SN, 23-Feb-2025.)
theorem lringring (R: class):
  $ wi (wcel R clring) (wcel R crg) $;

--| A local ring is a nonzero ring. (Contributed by Jim Kingdon, 20-Feb-2025.) (Revised by SN, 23-Feb-2025.)
theorem lringnz (R c_1 c_0: class):
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R clring) (wne c_1 c_0) $;

--| If the sum of two elements of a local ring is invertible, then at least one of the summands must be invertible. (Contributed by Jim Kingdon, 18-Feb-2025.) (Revised by SN, 23-Feb-2025.)
theorem lringuplu (ph: wff) (B2 c_pl R U X Y: class):
  $ wi ph (wceq B2 (cfv R cbs)) $ >
  $ wi ph (wceq U (cfv R cui)) $ >
  $ wi ph (wceq c_pl (cfv R cplusg)) $ >
  $ wi ph (wcel R clring) $ >
  $ wi ph (wcel (co X Y c_pl) U) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wo (wcel X U) (wcel Y U)) $;

--| Extend class notation with all subrings of a non-unital ring.
term csubrng: class;

--| Define a subring of a non-unital ring as a set of elements that is a non-unital ring in its own right. In this section, a subring of a non-unital ring is simply called "subring", unless it causes any ambiguity with ` SubRing ` . (Contributed by AV, 14-Feb-2025.)
axiom df_subrng {w s1: setvar}:
  $ wceq csubrng (cmpt w crng (crab s1 (wcel (co (cv w) (cv s1) cress) crng) (cpw (cfv (cv w) cbs)))) $;

--| The subring of non-unital ring predicate. (Contributed by AV, 14-Feb-2025.)
theorem issubrng (A2 B2 R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wb (wcel A2 (cfv R csubrng)) (w3a (wcel R crng) (wcel (co R A2 cress) crng) (wss A2 B2)) $;

--| A subring is a subset. (Contributed by AV, 14-Feb-2025.)
theorem subrngss (A2 B2 R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel A2 (cfv R csubrng)) (wss A2 B2) $;

--| Every non-unital ring is a subring of itself. (Contributed by AV, 14-Feb-2025.)
theorem subrngid (B2 R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R crng) (wcel B2 (cfv R csubrng)) $;

--| A subring is a non-unital ring. (Contributed by AV, 14-Feb-2025.)
theorem subrngrng (A2 R S: class):
  $ wceq S (co R A2 cress) $ >
  $ wi (wcel A2 (cfv R csubrng)) (wcel S crng) $;

--| Reverse closure for a subring predicate. (Contributed by AV, 14-Feb-2025.)
theorem subrngrcl (A2 R: class):
  $ wi (wcel A2 (cfv R csubrng)) (wcel R crng) $;

--| A subring is a subgroup. (Contributed by AV, 14-Feb-2025.)
theorem subrngsubg (A2 R: class):
  $ wi (wcel A2 (cfv R csubrng)) (wcel A2 (cfv R csubg)) $;

--| A subring is a normal subgroup. (Contributed by AV, 25-Feb-2025.)
theorem subrngringnsg (A2 R: class):
  $ wi (wcel A2 (cfv R csubrng)) (wcel A2 (cfv R cnsg)) $;

--| Base set of a subring structure. (Contributed by AV, 14-Feb-2025.)
theorem subrngbas (A2 R S: class):
  $ wceq S (co R A2 cress) $ >
  $ wi (wcel A2 (cfv R csubrng)) (wceq A2 (cfv S cbs)) $;

--| A subring always has the same additive identity. (Contributed by AV, 14-Feb-2025.)
theorem subrng0 (A2 R S c_0: class):
  $ wceq S (co R A2 cress) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel A2 (cfv R csubrng)) (wceq c_0 (cfv S c0g)) $;

--| A subring is closed under addition. (Contributed by AV, 14-Feb-2025.)
theorem subrngacl (A2 c_pl R X Y: class):
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (w3a (wcel A2 (cfv R csubrng)) (wcel X A2) (wcel Y A2)) (wcel (co X Y c_pl) A2) $;

--| A subring is closed under multiplication. (Contributed by Mario Carneiro, 2-Dec-2014.) Generalization of ~ subrgmcl . (Revised by AV, 14-Feb-2025.)
theorem subrngmcl (A2 R c_x X Y: class):
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel A2 (cfv R csubrng)) (wcel X A2) (wcel Y A2)) (wcel (co X Y c_x) A2) $;

--| Characterize the subrings of a ring by closure properties. (Contributed by AV, 15-Feb-2025.)
theorem issubrng2 {x3 y1: setvar} (A2: class) (B2: class x3 y1) (R c_x: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wcel R crng) (wb (wcel A2 (cfv R csubrng)) (wa (wcel A2 (cfv R csubg)) (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) c_x) A2) A2) A2))) $;

--| Being a subring is a symmetric property. (Contributed by AV, 15-Feb-2025.)
theorem opprsubrng (R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wceq (cfv R csubrng) (cfv O csubrng) $;

--| The intersection of a nonempty collection of subrings is a subring. (Contributed by AV, 15-Feb-2025.)
theorem subrngint (R S: class):
  $ wi (wa (wss S (cfv R csubrng)) (wne S c0)) (wcel (cint S) (cfv R csubrng)) $;

--| The intersection of two subrings is a subring. (Contributed by AV, 15-Feb-2025.)
theorem subrngin (A2 B2 R: class):
  $ wi (wa (wcel A2 (cfv R csubrng)) (wcel B2 (cfv R csubrng))) (wcel (cin A2 B2) (cfv R csubrng)) $;

--| The subrings of a non-unital ring are a Moore system. (Contributed by AV, 15-Feb-2025.)
theorem subrngmre (B2 R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R crng) (wcel (cfv R csubrng) (cfv B2 cmre)) $;

--| A subring of a subring is a subring. (Contributed by AV, 15-Feb-2025.)
theorem subsubrng (A2 B2 R S: class):
  $ wceq S (co R A2 cress) $ >
  $ wi (wcel A2 (cfv R csubrng)) (wb (wcel B2 (cfv S csubrng)) (wa (wcel B2 (cfv R csubrng)) (wss B2 A2))) $;

--| The set of subrings of a subring are the smaller subrings. (Contributed by AV, 15-Feb-2025.)
theorem subsubrng2 (A2 R S: class):
  $ wceq S (co R A2 cress) $ >
  $ wi (wcel A2 (cfv R csubrng)) (wceq (cfv S csubrng) (cin (cfv R csubrng) (cpw A2))) $;

--| Lemma for ~ rhmimasubrng : Modified part of ~ mhmima . (Contributed by Mario Carneiro, 10-Mar-2015.) (Revised by AV, 16-Feb-2025.)
theorem rhmimasubrnglem {x3 y1: setvar} (R: class y1) (F: class) (M: class y1) (N X: class):
  $ wceq M (cfv R cmgp) $ >
  $ wi (wa (wcel F (co M N cmhm)) (wcel X (cfv R csubrng))) (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) (cfv N cplusg)) (cima F X)) (cima F X)) (cima F X)) $;

--| The homomorphic image of a subring is a subring. (Contributed by AV, 16-Feb-2025.)
theorem rhmimasubrng (F M N X: class):
  $ wi (wa (wcel F (co M N crh)) (wcel X (cfv M csubrng))) (wcel (cima F X) (cfv N csubrng)) $;

--| Centralizers in a non-unital ring are subrings. (Contributed by AV, 17-Feb-2025.)
theorem cntzsubrng (B2 R S M Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq Z (cfv M ccntz) $ >
  $ wi (wa (wcel R crng) (wss S B2)) (wcel (cfv S Z) (cfv R csubrng)) $;

--| If two structures have the same ring components (properties), they have the same set of subrings. (Contributed by AV, 17-Feb-2025.)
theorem subrngpropd {x3 y1: setvar} (ph: wff) (B2 K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi ph (wceq (cfv K csubrng) (cfv L csubrng)) $;

--| Extend class notation with all subrings of a ring.
term csubrg: class;

--| Define a subring of a ring as a set of elements that is a ring in its own right and contains the multiplicative identity. The additional constraint is necessary because the multiplicative identity of a ring, unlike the additive identity of a ring/group or the multiplicative identity of a field, cannot be identified by a local property. Thus, it is possible for a subset of a ring to be a ring while not containing the true identity if it contains a false identity. For instance, the subset ` ( ZZ X. { 0 } ) ` of ` ( ZZ X. ZZ ) ` (where multiplication is componentwise) contains the false identity ` <. 1 , 0 >. ` which preserves every element of the subset and thus appears to be the identity of the subset, but is not the identity of the larger ring. (Contributed by Stefan O'Rear, 27-Nov-2014.)
axiom df_subrg {w s1: setvar}:
  $ wceq csubrg (cmpt w crg (crab s1 (wa (wcel (co (cv w) (cv s1) cress) crg) (wcel (cfv (cv w) cur) (cv s1))) (cpw (cfv (cv w) cbs)))) $;

--| The subring predicate. (Contributed by Stefan O'Rear, 27-Nov-2014.) (Proof shortened by AV, 12-Oct-2020.)
theorem issubrg (A2 B2 R c_1: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wb (wcel A2 (cfv R csubrg)) (wa (wa (wcel R crg) (wcel (co R A2 cress) crg)) (wa (wss A2 B2) (wcel c_1 A2))) $;

--| A subring is a subset. (Contributed by Stefan O'Rear, 27-Nov-2014.)
theorem subrgss (A2 B2 R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel A2 (cfv R csubrg)) (wss A2 B2) $;

--| Every ring is a subring of itself. (Contributed by Stefan O'Rear, 30-Nov-2014.)
theorem subrgid (B2 R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R crg) (wcel B2 (cfv R csubrg)) $;

--| A subring is a ring. (Contributed by Stefan O'Rear, 27-Nov-2014.)
theorem subrgring (A2 R S: class):
  $ wceq S (co R A2 cress) $ >
  $ wi (wcel A2 (cfv R csubrg)) (wcel S crg) $;

--| A subring of a commutative ring is a commutative ring. (Contributed by Mario Carneiro, 10-Jan-2015.)
theorem subrgcrng (A2 R S: class):
  $ wceq S (co R A2 cress) $ >
  $ wi (wa (wcel R ccrg) (wcel A2 (cfv R csubrg))) (wcel S ccrg) $;

--| Reverse closure for a subring predicate. (Contributed by Mario Carneiro, 3-Dec-2014.)
theorem subrgrcl (A2 R: class):
  $ wi (wcel A2 (cfv R csubrg)) (wcel R crg) $;

--| A subring is a subgroup. (Contributed by Mario Carneiro, 3-Dec-2014.)
theorem subrgsubg (A2 R: class):
  $ wi (wcel A2 (cfv R csubrg)) (wcel A2 (cfv R csubg)) $;

--| A subring of a unital ring is a subring of a non-unital ring. (Contributed by AV, 30-Mar-2025.)
theorem subrgsubrng (A2 R: class):
  $ wi (wcel A2 (cfv R csubrg)) (wcel A2 (cfv R csubrng)) $;

--| A subring always has the same additive identity. (Contributed by Stefan O'Rear, 27-Nov-2014.)
theorem subrg0 (A2 R S c_0: class):
  $ wceq S (co R A2 cress) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel A2 (cfv R csubrg)) (wceq c_0 (cfv S c0g)) $;

--| A subring contains the multiplicative identity. (Contributed by Stefan O'Rear, 27-Nov-2014.)
theorem subrg1cl (A2 R c_1: class):
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel A2 (cfv R csubrg)) (wcel c_1 A2) $;

--| Base set of a subring structure. (Contributed by Stefan O'Rear, 27-Nov-2014.)
theorem subrgbas (A2 R S: class):
  $ wceq S (co R A2 cress) $ >
  $ wi (wcel A2 (cfv R csubrg)) (wceq A2 (cfv S cbs)) $;

--| A subring always has the same multiplicative identity. (Contributed by Stefan O'Rear, 27-Nov-2014.)
theorem subrg1 (A2 R S c_1: class):
  $ wceq S (co R A2 cress) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel A2 (cfv R csubrg)) (wceq c_1 (cfv S cur)) $;

--| A subring is closed under addition. (Contributed by Mario Carneiro, 2-Dec-2014.)
theorem subrgacl (A2 c_pl R X Y: class):
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (w3a (wcel A2 (cfv R csubrg)) (wcel X A2) (wcel Y A2)) (wcel (co X Y c_pl) A2) $;

--| A subring is closed under multiplication. (Contributed by Mario Carneiro, 2-Dec-2014.) (Proof shortened by AV, 30-Mar-2025.)
theorem subrgmcl (A2 R c_x X Y: class):
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel A2 (cfv R csubrg)) (wcel X A2) (wcel Y A2)) (wcel (co X Y c_x) A2) $;

--| A subring is a submonoid of the multiplicative monoid. (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem subrgsubm (A2 R M: class):
  $ wceq M (cfv R cmgp) $ >
  $ wi (wcel A2 (cfv R csubrg)) (wcel A2 (cfv M csubmnd)) $;

--| If an element divides another in a subring, then it also divides the other in the parent ring. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem subrgdvds (A2 c_pa R S E: class):
  $ wceq S (co R A2 cress) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wceq E (cfv S cdsr) $ >
  $ wi (wcel A2 (cfv R csubrg)) (wss E c_pa) $;

--| A unit of a subring is a unit of the parent ring. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem subrguss (A2 R S U V: class):
  $ wceq S (co R A2 cress) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq V (cfv S cui) $ >
  $ wi (wcel A2 (cfv R csubrg)) (wss V U) $;

--| A subring always has the same inversion function, for elements that are invertible. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem subrginv (A2 R S U I J X: class):
  $ wceq S (co R A2 cress) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wceq U (cfv S cui) $ >
  $ wceq J (cfv S cinvr) $ >
  $ wi (wa (wcel A2 (cfv R csubrg)) (wcel X U)) (wceq (cfv X I) (cfv X J)) $;

--| A subring always has the same division function, for elements that are invertible. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem subrgdv (A2 c_dv R S U E X Y: class):
  $ wceq S (co R A2 cress) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wceq U (cfv S cui) $ >
  $ wceq E (cfv S cdvr) $ >
  $ wi (w3a (wcel A2 (cfv R csubrg)) (wcel X A2) (wcel Y U)) (wceq (co X Y c_dv) (co X Y E)) $;

--| An element of a ring is a unit of a subring iff it is a unit of the parent ring and both it and its inverse are in the subring. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem subrgunit (A2 R S U I V X: class):
  $ wceq S (co R A2 cress) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq V (cfv S cui) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wi (wcel A2 (cfv R csubrg)) (wb (wcel X V) (w3a (wcel X U) (wcel X A2) (wcel (cfv X I) A2))) $;

--| The units of a subring form a subgroup of the unit group of the original ring. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem subrgugrp (A2 R S U G V: class):
  $ wceq S (co R A2 cress) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq V (cfv S cui) $ >
  $ wceq G (co (cfv R cmgp) U cress) $ >
  $ wi (wcel A2 (cfv R csubrg)) (wcel V (cfv G csubg)) $;

--| Characterize the subrings of a ring by closure properties. (Contributed by Mario Carneiro, 3-Dec-2014.)
theorem issubrg2 {x3 y1: setvar} (A2: class) (B2: class x3 y1) (R c_x: class) (c_1: class x3 y1):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wcel R crg) (wb (wcel A2 (cfv R csubrg)) (w3a (wcel A2 (cfv R csubg)) (wcel c_1 A2) (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) c_x) A2) A2) A2))) $;

--| Being a subring is a symmetric property. (Contributed by Mario Carneiro, 6-Dec-2014.)
theorem opprsubrg (R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wceq (cfv R csubrg) (cfv O csubrg) $;

--| A subring of a nonzero ring is nonzero. (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem subrgnzr (A2 R S: class):
  $ wceq S (co R A2 cress) $ >
  $ wi (wa (wcel R cnzr) (wcel A2 (cfv R csubrg))) (wcel S cnzr) $;

--| The intersection of a nonempty collection of subrings is a subring. (Contributed by Stefan O'Rear, 30-Nov-2014.) (Revised by Mario Carneiro, 7-Dec-2014.)
theorem subrgint (R S: class):
  $ wi (wa (wss S (cfv R csubrg)) (wne S c0)) (wcel (cint S) (cfv R csubrg)) $;

--| The intersection of two subrings is a subring. (Contributed by Stefan O'Rear, 30-Nov-2014.) (Revised by Mario Carneiro, 7-Dec-2014.)
theorem subrgin (A2 B2 R: class):
  $ wi (wa (wcel A2 (cfv R csubrg)) (wcel B2 (cfv R csubrg))) (wcel (cin A2 B2) (cfv R csubrg)) $;

--| The subrings of a ring are a Moore system. (Contributed by Stefan O'Rear, 9-Mar-2015.)
theorem subrgmre (B2 R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R crg) (wcel (cfv R csubrg) (cfv B2 cmre)) $;

--| A subring of a subring is a subring. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem subsubrg (A2 B2 R S: class):
  $ wceq S (co R A2 cress) $ >
  $ wi (wcel A2 (cfv R csubrg)) (wb (wcel B2 (cfv S csubrg)) (wa (wcel B2 (cfv R csubrg)) (wss B2 A2))) $;

--| The set of subrings of a subring are the smaller subrings. (Contributed by Stefan O'Rear, 9-Mar-2015.)
theorem subsubrg2 (A2 R S: class):
  $ wceq S (co R A2 cress) $ >
  $ wi (wcel A2 (cfv R csubrg)) (wceq (cfv S csubrg) (cin (cfv R csubrg) (cpw A2))) $;

--| A subring is an additive subgroup which is also a multiplicative submonoid. (Contributed by Mario Carneiro, 7-Mar-2015.)
theorem issubrg3 (R S M: class):
  $ wceq M (cfv R cmgp) $ >
  $ wi (wcel R crg) (wb (wcel S (cfv R csubrg)) (wa (wcel S (cfv R csubg)) (wcel S (cfv M csubmnd)))) $;

--| Restriction of a ring homomorphism to a subring is a homomorphism. (Contributed by Mario Carneiro, 12-Mar-2015.)
theorem resrhm (S T U F X: class):
  $ wceq U (co S X cress) $ >
  $ wi (wa (wcel F (co S T crh)) (wcel X (cfv S csubrg))) (wcel (cres F X) (co U T crh)) $;

--| Restriction of the codomain of a (ring) homomorphism. ~ resghm2b analog. (Contributed by SN, 7-Feb-2025.)
theorem resrhm2b (S T U F X: class):
  $ wceq U (co T X cress) $ >
  $ wi (wa (wcel X (cfv T csubrg)) (wss (crn F) X)) (wb (wcel F (co S T crh)) (wcel F (co S U crh))) $;

--| The equalizer of two ring homomorphisms is a subring. (Contributed by Stefan O'Rear, 7-Mar-2015.) (Revised by Mario Carneiro, 6-May-2015.)
theorem rhmeql (S T F G: class):
  $ wi (wa (wcel F (co S T crh)) (wcel G (co S T crh))) (wcel (cdm (cin F G)) (cfv S csubrg)) $;

--| The homomorphic image of a subring is a subring. (Contributed by Stefan O'Rear, 10-Mar-2015.) (Revised by Mario Carneiro, 6-May-2015.)
theorem rhmima (F M N X: class):
  $ wi (wa (wcel F (co M N crh)) (wcel X (cfv M csubrg))) (wcel (cima F X) (cfv N csubrg)) $;

--| The range of a ring homomorphism is a subring. (Contributed by SN, 18-Nov-2023.)
theorem rnrhmsubrg (F M N: class):
  $ wi (wcel F (co M N crh)) (wcel (crn F) (cfv N csubrg)) $;

--| Centralizers in a ring are subrings. (Contributed by Stefan O'Rear, 6-Sep-2015.) (Revised by Mario Carneiro, 19-Apr-2016.)
theorem cntzsubr (B2 R S M Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq Z (cfv M ccntz) $ >
  $ wi (wa (wcel R crg) (wss S B2)) (wcel (cfv S Z) (cfv R csubrg)) $;

--| Diagonal homomorphism into a structure power (Rings). (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Mario Carneiro, 6-May-2015.)
theorem pwsdiagrhm {x3: setvar} (B2 R: class) (F: class x3) (I W Y: class):
  $ wceq Y (co R I cpws) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq F (cmpt x3 B2 (cxp I (csn (cv x3)))) $ >
  $ wi (wa (wcel R crg) (wcel I W)) (wcel F (co R Y crh)) $;

--| If two structures have the same group components (properties), they have the same set of subrings. (Contributed by Mario Carneiro, 9-Feb-2015.)
theorem subrgpropd {x3 y1: setvar} (ph: wff) (B2 K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi ph (wceq (cfv K csubrg) (cfv L csubrg)) $;

--| Ring homomorphism depends only on the ring attributes of structures. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem rhmpropd {x3 y1: setvar} (ph: wff) (B2 C J K L M: class):
  $ wi ph (wceq B2 (cfv J cbs)) $ >
  $ wi ph (wceq C (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi ph (wceq C (cfv M cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv J cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) C) (wcel (cv y1) C))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv M cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv J cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi (wa ph (wa (wcel (cv x3) C) (wcel (cv y1) C))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv M cmulr))) $ >
  $ wi ph (wceq (co J K crh) (co L M crh)) $;

--| Extend class notation with span of a set of elements over a ring.
term crgspn: class;

--| The ring-span of a set of elements in a ring is the smallest subring which contains all of them. (Contributed by Stefan O'Rear, 7-Dec-2014.)
axiom df_rgspn {w t s1: setvar}:
  $ wceq crgspn (cmpt w cvv (cmpt s1 (cpw (cfv (cv w) cbs)) (cint (crab t (wss (cv s1) (cv t)) (cfv (cv w) csubrg))))) $;

--| Value of the ring-span of a set of elements in a ring. (Contributed by Stefan O'Rear, 7-Dec-2014.)
theorem rgspnval {t: setvar} (ph: wff) (A2 B2 R: class) (U N: class t):
  $ wi ph (wcel R crg) $ >
  $ wi ph (wceq B2 (cfv R cbs)) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq N (cfv R crgspn)) $ >
  $ wi ph (wceq U (cfv A2 N)) $ >
  $ wi ph (wceq U (cint (crab t (wss A2 (cv t)) (cfv R csubrg)))) $;

--| The ring-span of a set is a subring. (Contributed by Stefan O'Rear, 7-Dec-2014.)
theorem rgspncl (ph: wff) (A2 B2 R U N: class):
  $ wi ph (wcel R crg) $ >
  $ wi ph (wceq B2 (cfv R cbs)) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq N (cfv R crgspn)) $ >
  $ wi ph (wceq U (cfv A2 N)) $ >
  $ wi ph (wcel U (cfv R csubrg)) $;

--| The ring-span of a set contains the set. (Contributed by Stefan O'Rear, 30-Nov-2014.)
theorem rgspnssid (ph: wff) (A2 B2 R U N: class):
  $ wi ph (wcel R crg) $ >
  $ wi ph (wceq B2 (cfv R cbs)) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq N (cfv R crgspn)) $ >
  $ wi ph (wceq U (cfv A2 N)) $ >
  $ wi ph (wss A2 U) $;

--| The ring-span is contained in all subrings which contain all the generators. (Contributed by Stefan O'Rear, 30-Nov-2014.)
theorem rgspnmin (ph: wff) (A2 B2 R S U N: class):
  $ wi ph (wcel R crg) $ >
  $ wi ph (wceq B2 (cfv R cbs)) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq N (cfv R crgspn)) $ >
  $ wi ph (wceq U (cfv A2 N)) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wss A2 S) $ >
  $ wi ph (wss U S) $;

--| Extend class notation to include the category Rng.
term crngc: class;

--| Definition of the category Rng, relativized to a subset ` u ` . This is the category of all non-unital rings in ` u ` and homomorphisms between these rings. Generally, we will take ` u ` to be a weak universe or Grothendieck universe, because these sets have closure properties as good as the real thing. (Contributed by AV, 27-Feb-2020.) (Revised by AV, 8-Mar-2020.)
axiom df_rngc {u: setvar}:
  $ wceq crngc (cmpt u cvv (co (cfv (cv u) cestrc) (cres crnghm (cxp (cin (cv u) crng) (cin (cv u) crng))) cresc)) $;

--| Value of the category of non-unital rings (in a universe). (Contributed by AV, 27-Feb-2020.) (Revised by AV, 8-Mar-2020.)
theorem rngcval (ph: wff) (B2 C U H V: class):
  $ wceq C (cfv U crngc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq B2 (cin U crng)) $ >
  $ wi ph (wceq H (cres crnghm (cxp B2 B2))) $ >
  $ wi ph (wceq C (co (cfv U cestrc) H cresc)) $;

--| The class of non-unital ring homomorphisms restricted to subsets of non-unital rings is a function. (Contributed by AV, 4-Mar-2020.)
theorem rnghmresfn (ph: wff) (B2 U H: class):
  $ wi ph (wceq B2 (cin U crng)) $ >
  $ wi ph (wceq H (cres crnghm (cxp B2 B2))) $ >
  $ wi ph (wfn H (cxp B2 B2)) $;

--| An element of the non-unital ring homomorphisms restricted to a subset of non-unital rings is a non-unital ring homomorphisms. (Contributed by AV, 9-Mar-2020.)
theorem rnghmresel (ph: wff) (B2 F H X Y: class):
  $ wi ph (wceq H (cres crnghm (cxp B2 B2))) $ >
  $ wi (w3a ph (wa (wcel X B2) (wcel Y B2)) (wcel F (co X Y H))) (wcel F (co X Y crnghm)) $;

--| Set of objects of the category of non-unital rings (in a universe). (Contributed by AV, 27-Feb-2020.) (Revised by AV, 8-Mar-2020.)
theorem rngcbas (ph: wff) (B2 C U V: class):
  $ wceq C (cfv U crngc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq B2 (cin U crng)) $;

--| Set of arrows of the category of non-unital rings (in a universe). (Contributed by AV, 27-Feb-2020.) (Revised by AV, 8-Mar-2020.)
theorem rngchomfval (ph: wff) (B2 C U H V: class):
  $ wceq C (cfv U crngc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wceq H (cres crnghm (cxp B2 B2))) $;

--| Set of arrows of the category of non-unital rings (in a universe). (Contributed by AV, 27-Feb-2020.)
theorem rngchom (ph: wff) (B2 C U H V X Y: class):
  $ wceq C (cfv U crngc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co X Y H) (co X Y crnghm)) $;

--| A morphism of non-unital rings is a function. (Contributed by AV, 27-Feb-2020.)
theorem elrngchom (ph: wff) (B2 C U F H V X Y: class):
  $ wceq C (cfv U crngc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wi (wcel F (co X Y H)) (wf (cfv X cbs) (cfv Y cbs) F)) $;

--| The functionalized Hom-set operation equals the Hom-set operation in the category of non-unital rings (in a universe). (Contributed by AV, 9-Mar-2020.)
theorem rngchomfeqhom (ph: wff) (B2 C U V: class):
  $ wceq C (cfv U crngc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq (cfv C chomf) (cfv C chom)) $;

--| Composition in the category of non-unital rings. (Contributed by AV, 27-Feb-2020.) (Revised by AV, 8-Mar-2020.)
theorem rngccofval (ph: wff) (C c_x U V: class):
  $ wceq C (cfv U crngc) $ >
  $ wi ph (wcel U V) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wi ph (wceq c_x (cfv (cfv U cestrc) cco)) $;

--| Composition in the category of non-unital rings. (Contributed by AV, 27-Feb-2020.) (Revised by AV, 8-Mar-2020.)
theorem rngcco (ph: wff) (C c_x U F G V X Y Z: class):
  $ wceq C (cfv U crngc) $ >
  $ wi ph (wcel U V) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wi ph (wcel X U) $ >
  $ wi ph (wcel Y U) $ >
  $ wi ph (wcel Z U) $ >
  $ wi ph (wf (cfv X cbs) (cfv Y cbs) F) $ >
  $ wi ph (wf (cfv Y cbs) (cfv Z cbs) G) $ >
  $ wi ph (wceq (co G F (co (cop X Y) Z c_x)) (ccom G F)) $;

--| Alternate definition of the category of non-unital rings (in a universe). (Contributed by AV, 16-Mar-2020.)
theorem dfrngc2 (ph: wff) (B2 C c_x U H V: class):
  $ wceq C (cfv U crngc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq B2 (cin U crng)) $ >
  $ wi ph (wceq H (cres crnghm (cxp B2 B2))) $ >
  $ wi ph (wceq c_x (cfv (cfv U cestrc) cco)) $ >
  $ wi ph (wceq C (ctp (cop (cfv cnx cbs) B2) (cop (cfv cnx chom) H) (cop (cfv cnx cco) c_x))) $;

--| The non-unital ring homomorphisms between non-unital rings (in a universe) are a subcategory subset of the mappings between base sets of non-unital rings (in the same universe). (Contributed by AV, 6-Mar-2020.)
theorem rnghmsscmap2 {x3 y1: setvar} (ph: wff x3 y1) (R: class) (U V: class x3 y1):
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq R (cin crng U)) $ >
  $ wi ph (wbr (cres crnghm (cxp R R)) (cmpo x3 y1 R R (co (cfv (cv y1) cbs) (cfv (cv x3) cbs) cmap)) cssc) $;

--| The non-unital ring homomorphisms between non-unital rings (in a universe) are a subcategory subset of the mappings between base sets of extensible structures (in the same universe). (Contributed by AV, 9-Mar-2020.)
theorem rnghmsscmap {x3 y1: setvar} (ph: wff) (R U: class) (V: class x3 y1):
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq R (cin crng U)) $ >
  $ wi ph (wbr (cres crnghm (cxp R R)) (cmpo x3 y1 U U (co (cfv (cv y1) cbs) (cfv (cv x3) cbs) cmap)) cssc) $;

--| Lemma 1 for ~ rnghmsubcsetc . (Contributed by AV, 9-Mar-2020.)
theorem rnghmsubcsetclem1 (ph: wff) (x3: setvar) (B2 C U H V: class):
  $ wceq C (cfv U cestrc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq B2 (cin crng U)) $ >
  $ wi ph (wceq H (cres crnghm (cxp B2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wcel (cfv (cv x3) (cfv C ccid)) (co (cv x3) (cv x3) H)) $;

--| Lemma 2 for ~ rnghmsubcsetc . (Contributed by AV, 9-Mar-2020.)
theorem rnghmsubcsetclem2 {y1 z f2 g2: setvar} (ph: wff) (x3: setvar) (B2 C: class) (U: class z f2 g2) (H: class) (V: class y1 z f2 g2):
  $ wceq C (cfv U cestrc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq B2 (cin crng U)) $ >
  $ wi ph (wceq H (cres crnghm (cxp B2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wral y1 (wral z (wral f2 (wral g2 (wcel (co (cv g2) (cv f2) (co (cop (cv x3) (cv y1)) (cv z) (cfv C cco))) (co (cv x3) (cv z) H)) (co (cv y1) (cv z) H)) (co (cv x3) (cv y1) H)) B2) B2) $;

--| The non-unital ring homomorphisms between non-unital rings (in a universe) are a subcategory of the category of extensible structures. (Contributed by AV, 9-Mar-2020.)
theorem rnghmsubcsetc (ph: wff) (B2 C U H V: class):
  $ wceq C (cfv U cestrc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq B2 (cin crng U)) $ >
  $ wi ph (wceq H (cres crnghm (cxp B2 B2))) $ >
  $ wi ph (wcel H (cfv C csubc)) $;

--| The category of non-unital rings is a category. (Contributed by AV, 27-Feb-2020.) (Revised by AV, 9-Mar-2020.)
theorem rngccat (C U V: class):
  $ wceq C (cfv U crngc) $ >
  $ wi (wcel U V) (wcel C ccat) $;

--| The identity arrow in the category of non-unital rings is the identity function. (Contributed by AV, 27-Feb-2020.) (Revised by AV, 10-Mar-2020.)
theorem rngcid (ph: wff) (B2 C S U c_1 V X: class):
  $ wceq C (cfv U crngc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq c_1 (cfv C ccid) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel X B2) $ >
  $ wceq S (cfv X cbs) $ >
  $ wi ph (wceq (cfv X c_1) (cres cid S)) $;

--| A section in the category of non-unital rings, written out. (Contributed by AV, 28-Feb-2020.)
theorem rngcsect (ph: wff) (B2 C S U E F G V X Y: class):
  $ wceq C (cfv U crngc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq E (cfv X cbs) $ >
  $ wceq S (cfv C csect) $ >
  $ wi ph (wb (wbr F G (co X Y S)) (w3a (wcel F (co X Y crnghm)) (wcel G (co Y X crnghm)) (wceq (ccom G F) (cres cid E)))) $;

--| An inverse in the category of non-unital rings is the converse operation. (Contributed by AV, 28-Feb-2020.)
theorem rngcinv (ph: wff) (B2 C U F G N V X Y: class):
  $ wceq C (cfv U crngc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq N (cfv C cinv) $ >
  $ wi ph (wb (wbr F G (co X Y N)) (wa (wcel F (co X Y crngim)) (wceq G (ccnv F)))) $;

--| An isomorphism in the category of non-unital rings is a bijection. (Contributed by AV, 28-Feb-2020.)
theorem rngciso (ph: wff) (B2 C U F I V X Y: class):
  $ wceq C (cfv U crngc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq I (cfv C ciso) $ >
  $ wi ph (wb (wcel F (co X Y I)) (wcel F (co X Y crngim))) $;

--| The "inclusion functor" from the category of non-unital rings into the category of extensible structures. (Contributed by AV, 30-Mar-2020.)
theorem rngcifuestrc {x3 y1: setvar} (ph: wff) (B2: class x3 y1) (R U: class) (E F G V: class x3 y1):
  $ wceq R (cfv U crngc) $ >
  $ wceq E (cfv U cestrc) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq F (cres cid B2)) $ >
  $ wi ph (wceq G (cmpo x3 y1 B2 B2 (cres cid (co (cv x3) (cv y1) crnghm)))) $ >
  $ wi ph (wbr F G (co R E cfunc)) $;

--| The "natural forgetful functor" from the category of non-unital rings into the category of sets which sends each non-unital ring to its underlying set (base set) and the morphisms (non-unital ring homomorphisms) to mappings of the corresponding base sets. An alternate proof is provided in ~ funcrngcsetcALT , using ~ cofuval2 to construct the "natural forgetful functor" from the category of non-unital rings into the category of sets by composing the "inclusion functor" from the category of non-unital rings into the category of extensible structures, see ~ rngcifuestrc , and the "natural forgetful functor" from the category of extensible structures into the category of sets, see ~ funcestrcsetc . (Contributed by AV, 26-Mar-2020.)
theorem funcrngcsetc {x3 y1: setvar} (ph: wff) (B2 R: class) (S: class y1) (U: class) (F G: class x3 y1):
  $ wceq R (cfv U crngc) $ >
  $ wceq S (cfv U csetc) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel U cwun) $ >
  $ wi ph (wceq F (cmpt x3 B2 (cfv (cv x3) cbs))) $ >
  $ wi ph (wceq G (cmpo x3 y1 B2 B2 (cres cid (co (cv x3) (cv y1) crnghm)))) $ >
  $ wi ph (wbr F G (co R S cfunc)) $;

--| Alternate proof of ~ funcrngcsetc , using ~ cofuval2 to construct the "natural forgetful functor" from the category of non-unital rings into the category of sets by composing the "inclusion functor" from the category of non-unital rings into the category of extensible structures, see ~ rngcifuestrc , and the "natural forgetful functor" from the category of extensible structures into the category of sets, see ~ funcestrcsetc . Surprisingly, this proof is longer than the direct proof given in ~ funcrngcsetc . (Contributed by AV, 30-Mar-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem funcrngcsetcALT {x3 y1: setvar} (ph: wff) (B2 R: class) (S: class x3 y1) (U: class) (F G: class x3 y1):
  $ wceq R (cfv U crngc) $ >
  $ wceq S (cfv U csetc) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel U cwun) $ >
  $ wi ph (wceq F (cmpt x3 B2 (cfv (cv x3) cbs))) $ >
  $ wi ph (wceq G (cmpo x3 y1 B2 B2 (cres cid (co (cv x3) (cv y1) crnghm)))) $ >
  $ wi ph (wbr F G (co R S cfunc)) $;

--| The zero ring is an initial object in the category of non-unital rings. (Contributed by AV, 18-Apr-2020.)
theorem zrinitorngc (ph: wff) (C U V Z: class):
  $ wi ph (wcel U V) $ >
  $ wceq C (cfv U crngc) $ >
  $ wi ph (wcel Z (cdif crg cnzr)) $ >
  $ wi ph (wcel Z U) $ >
  $ wi ph (wcel Z (cfv C cinito)) $;

--| The zero ring is a terminal object in the category of non-unital rings. (Contributed by AV, 17-Apr-2020.)
theorem zrtermorngc (ph: wff) (C U V Z: class):
  $ wi ph (wcel U V) $ >
  $ wceq C (cfv U crngc) $ >
  $ wi ph (wcel Z (cdif crg cnzr)) $ >
  $ wi ph (wcel Z U) $ >
  $ wi ph (wcel Z (cfv C ctermo)) $;

--| The zero ring is a zero object in the category of non-unital rings. (Contributed by AV, 18-Apr-2020.)
theorem zrzeroorngc (ph: wff) (C U V Z: class):
  $ wi ph (wcel U V) $ >
  $ wceq C (cfv U crngc) $ >
  $ wi ph (wcel Z (cdif crg cnzr)) $ >
  $ wi ph (wcel Z U) $ >
  $ wi ph (wcel Z (cfv C czeroo)) $;

--| Extend class notation to include the category Ring.
term cringc: class;

--| Definition of the category Ring, relativized to a subset ` u ` . See also the note in [Lang] p. 91, and the item Rng in [Adamek] p. 478. This is the category of all unital rings in ` u ` and homomorphisms between these rings. Generally, we will take ` u ` to be a weak universe or Grothendieck universe, because these sets have closure properties as good as the real thing. (Contributed by AV, 13-Feb-2020.) (Revised by AV, 8-Mar-2020.)
axiom df_ringc {u: setvar}:
  $ wceq cringc (cmpt u cvv (co (cfv (cv u) cestrc) (cres crh (cxp (cin (cv u) crg) (cin (cv u) crg))) cresc)) $;

--| Value of the category of unital rings (in a universe). (Contributed by AV, 13-Feb-2020.) (Revised by AV, 8-Mar-2020.)
theorem ringcval (ph: wff) (B2 C U H V: class):
  $ wceq C (cfv U cringc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq B2 (cin U crg)) $ >
  $ wi ph (wceq H (cres crh (cxp B2 B2))) $ >
  $ wi ph (wceq C (co (cfv U cestrc) H cresc)) $;

--| The class of unital ring homomorphisms restricted to subsets of unital rings is a function. (Contributed by AV, 10-Mar-2020.)
theorem rhmresfn (ph: wff) (B2 U H: class):
  $ wi ph (wceq B2 (cin U crg)) $ >
  $ wi ph (wceq H (cres crh (cxp B2 B2))) $ >
  $ wi ph (wfn H (cxp B2 B2)) $;

--| An element of the unital ring homomorphisms restricted to a subset of unital rings is a unital ring homomorphism. (Contributed by AV, 10-Mar-2020.)
theorem rhmresel (ph: wff) (B2 F H X Y: class):
  $ wi ph (wceq H (cres crh (cxp B2 B2))) $ >
  $ wi (w3a ph (wa (wcel X B2) (wcel Y B2)) (wcel F (co X Y H))) (wcel F (co X Y crh)) $;

--| Set of objects of the category of unital rings (in a universe). (Contributed by AV, 13-Feb-2020.) (Revised by AV, 8-Mar-2020.)
theorem ringcbas (ph: wff) (B2 C U V: class):
  $ wceq C (cfv U cringc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq B2 (cin U crg)) $;

--| Set of arrows of the category of unital rings (in a universe). (Contributed by AV, 14-Feb-2020.) (Revised by AV, 8-Mar-2020.)
theorem ringchomfval (ph: wff) (B2 C U H V: class):
  $ wceq C (cfv U cringc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wceq H (cres crh (cxp B2 B2))) $;

--| Set of arrows of the category of unital rings (in a universe). (Contributed by AV, 14-Feb-2020.)
theorem ringchom (ph: wff) (B2 C U H V X Y: class):
  $ wceq C (cfv U cringc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co X Y H) (co X Y crh)) $;

--| A morphism of unital rings is a function. (Contributed by AV, 14-Feb-2020.)
theorem elringchom (ph: wff) (B2 C U F H V X Y: class):
  $ wceq C (cfv U cringc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wi (wcel F (co X Y H)) (wf (cfv X cbs) (cfv Y cbs) F)) $;

--| The functionalized Hom-set operation equals the Hom-set operation in the category of unital rings (in a universe). (Contributed by AV, 9-Mar-2020.)
theorem ringchomfeqhom (ph: wff) (B2 C U V: class):
  $ wceq C (cfv U cringc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq (cfv C chomf) (cfv C chom)) $;

--| Composition in the category of unital rings. (Contributed by AV, 14-Feb-2020.) (Revised by AV, 8-Mar-2020.)
theorem ringccofval (ph: wff) (C c_x U V: class):
  $ wceq C (cfv U cringc) $ >
  $ wi ph (wcel U V) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wi ph (wceq c_x (cfv (cfv U cestrc) cco)) $;

--| Composition in the category of unital rings. (Contributed by AV, 14-Feb-2020.) (Revised by AV, 8-Mar-2020.)
theorem ringcco (ph: wff) (C c_x U F G V X Y Z: class):
  $ wceq C (cfv U cringc) $ >
  $ wi ph (wcel U V) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wi ph (wcel X U) $ >
  $ wi ph (wcel Y U) $ >
  $ wi ph (wcel Z U) $ >
  $ wi ph (wf (cfv X cbs) (cfv Y cbs) F) $ >
  $ wi ph (wf (cfv Y cbs) (cfv Z cbs) G) $ >
  $ wi ph (wceq (co G F (co (cop X Y) Z c_x)) (ccom G F)) $;

--| Alternate definition of the category of unital rings (in a universe). (Contributed by AV, 16-Mar-2020.)
theorem dfringc2 (ph: wff) (B2 C c_x U H V: class):
  $ wceq C (cfv U cringc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq B2 (cin U crg)) $ >
  $ wi ph (wceq H (cres crh (cxp B2 B2))) $ >
  $ wi ph (wceq c_x (cfv (cfv U cestrc) cco)) $ >
  $ wi ph (wceq C (ctp (cop (cfv cnx cbs) B2) (cop (cfv cnx chom) H) (cop (cfv cnx cco) c_x))) $;

--| The unital ring homomorphisms between unital rings (in a universe) are a subcategory subset of the mappings between base sets of unital rings (in the same universe). (Contributed by AV, 6-Mar-2020.)
theorem rhmsscmap2 {x3 y1: setvar} (ph: wff x3 y1) (R: class) (U V: class x3 y1):
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq R (cin crg U)) $ >
  $ wi ph (wbr (cres crh (cxp R R)) (cmpo x3 y1 R R (co (cfv (cv y1) cbs) (cfv (cv x3) cbs) cmap)) cssc) $;

--| The unital ring homomorphisms between unital rings (in a universe) are a subcategory subset of the mappings between base sets of extensible structures (in the same universe). (Contributed by AV, 9-Mar-2020.)
theorem rhmsscmap {x3 y1: setvar} (ph: wff) (R U: class) (V: class x3 y1):
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq R (cin crg U)) $ >
  $ wi ph (wbr (cres crh (cxp R R)) (cmpo x3 y1 U U (co (cfv (cv y1) cbs) (cfv (cv x3) cbs) cmap)) cssc) $;

--| Lemma 1 for ~ rhmsubcsetc . (Contributed by AV, 9-Mar-2020.)
theorem rhmsubcsetclem1 (ph: wff) (x3: setvar) (B2 C U H V: class):
  $ wceq C (cfv U cestrc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq B2 (cin crg U)) $ >
  $ wi ph (wceq H (cres crh (cxp B2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wcel (cfv (cv x3) (cfv C ccid)) (co (cv x3) (cv x3) H)) $;

--| Lemma 2 for ~ rhmsubcsetc . (Contributed by AV, 9-Mar-2020.)
theorem rhmsubcsetclem2 {y1 z f2 g2: setvar} (ph: wff) (x3: setvar) (B2 C: class) (U: class z f2 g2) (H: class) (V: class y1 z f2 g2):
  $ wceq C (cfv U cestrc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq B2 (cin crg U)) $ >
  $ wi ph (wceq H (cres crh (cxp B2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wral y1 (wral z (wral f2 (wral g2 (wcel (co (cv g2) (cv f2) (co (cop (cv x3) (cv y1)) (cv z) (cfv C cco))) (co (cv x3) (cv z) H)) (co (cv y1) (cv z) H)) (co (cv x3) (cv y1) H)) B2) B2) $;

--| The unital ring homomorphisms between unital rings (in a universe) are a subcategory of the category of extensible structures. (Contributed by AV, 9-Mar-2020.)
theorem rhmsubcsetc (ph: wff) (B2 C U H V: class):
  $ wceq C (cfv U cestrc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq B2 (cin crg U)) $ >
  $ wi ph (wceq H (cres crh (cxp B2 B2))) $ >
  $ wi ph (wcel H (cfv C csubc)) $;

--| The category of unital rings is a category. (Contributed by AV, 14-Feb-2020.) (Revised by AV, 9-Mar-2020.)
theorem ringccat (C U V: class):
  $ wceq C (cfv U cringc) $ >
  $ wi (wcel U V) (wcel C ccat) $;

--| The identity arrow in the category of unital rings is the identity function. (Contributed by AV, 14-Feb-2020.) (Revised by AV, 10-Mar-2020.)
theorem ringcid (ph: wff) (B2 C S U c_1 V X: class):
  $ wceq C (cfv U cringc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq c_1 (cfv C ccid) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel X B2) $ >
  $ wceq S (cfv X cbs) $ >
  $ wi ph (wceq (cfv X c_1) (cres cid S)) $;

--| The unital ring homomorphisms between unital rings (in a universe) are a subcategory subset of the non-unital ring homomorphisms between non-unital rings (in the same universe). (Contributed by AV, 1-Mar-2020.)
theorem rhmsscrnghm (ph: wff) (R S U V: class):
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq R (cin crg U)) $ >
  $ wi ph (wceq S (cin crng U)) $ >
  $ wi ph (wbr (cres crh (cxp R R)) (cres crnghm (cxp S S)) cssc) $;

--| Lemma 1 for ~ rhmsubcrngc . (Contributed by AV, 9-Mar-2020.)
theorem rhmsubcrngclem1 (ph: wff) (x3: setvar) (B2 C U H V: class):
  $ wceq C (cfv U crngc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq B2 (cin crg U)) $ >
  $ wi ph (wceq H (cres crh (cxp B2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wcel (cfv (cv x3) (cfv C ccid)) (co (cv x3) (cv x3) H)) $;

--| Lemma 2 for ~ rhmsubcrngc . (Contributed by AV, 12-Mar-2020.)
theorem rhmsubcrngclem2 {y1 z f2 g2: setvar} (ph: wff) (x3: setvar) (B2 C: class) (U: class z f2 g2) (H: class) (V: class y1 z f2 g2):
  $ wceq C (cfv U crngc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq B2 (cin crg U)) $ >
  $ wi ph (wceq H (cres crh (cxp B2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wral y1 (wral z (wral f2 (wral g2 (wcel (co (cv g2) (cv f2) (co (cop (cv x3) (cv y1)) (cv z) (cfv C cco))) (co (cv x3) (cv z) H)) (co (cv y1) (cv z) H)) (co (cv x3) (cv y1) H)) B2) B2) $;

--| The unital ring homomorphisms between unital rings (in a universe) are a subcategory of the category of non-unital rings. (Contributed by AV, 12-Mar-2020.)
theorem rhmsubcrngc (ph: wff) (B2 C U H V: class):
  $ wceq C (cfv U crngc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq B2 (cin crg U)) $ >
  $ wi ph (wceq H (cres crh (cxp B2 B2))) $ >
  $ wi ph (wcel H (cfv C csubc)) $;

--| The restriction of the category of non-unital rings to the set of unital ring homomorphisms is the category of unital rings. (Contributed by AV, 16-Mar-2020.)
theorem rngcresringcat (ph: wff) (B2 C U H V: class):
  $ wceq C (cfv U crngc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wceq B2 (cin crg U)) $ >
  $ wi ph (wceq H (cres crh (cxp B2 B2))) $ >
  $ wi ph (wceq (co C H cresc) (cfv U cringc)) $;

--| A section in the category of unital rings, written out. (Contributed by AV, 14-Feb-2020.)
theorem ringcsect (ph: wff) (B2 C S U E F G V X Y: class):
  $ wceq C (cfv U cringc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq E (cfv X cbs) $ >
  $ wceq S (cfv C csect) $ >
  $ wi ph (wb (wbr F G (co X Y S)) (w3a (wcel F (co X Y crh)) (wcel G (co Y X crh)) (wceq (ccom G F) (cres cid E)))) $;

--| An inverse in the category of unital rings is the converse operation. (Contributed by AV, 14-Feb-2020.)
theorem ringcinv (ph: wff) (B2 C U F G N V X Y: class):
  $ wceq C (cfv U cringc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq N (cfv C cinv) $ >
  $ wi ph (wb (wbr F G (co X Y N)) (wa (wcel F (co X Y crs)) (wceq G (ccnv F)))) $;

--| An isomorphism in the category of unital rings is a bijection. (Contributed by AV, 14-Feb-2020.)
theorem ringciso (ph: wff) (B2 C U F I V X Y: class):
  $ wceq C (cfv U cringc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq I (cfv C ciso) $ >
  $ wi ph (wb (wcel F (co X Y I)) (wcel F (co X Y crs))) $;

--| An element of the base set of the base set of the category of unital rings (i.e. the base set of a ring) belongs to the considered weak universe. (Contributed by AV, 15-Feb-2020.)
theorem ringcbasbas (ph: wff) (B2 C R U: class):
  $ wceq C (cfv U cringc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U cwun) $ >
  $ wi (wa ph (wcel R B2)) (wcel (cfv R cbs) U) $;

--| The "natural forgetful functor" from the category of unital rings into the category of sets which sends each ring to its underlying set (base set) and the morphisms (ring homomorphisms) to mappings of the corresponding base sets. (Contributed by AV, 26-Mar-2020.)
theorem funcringcsetc {x3 y1: setvar} (ph: wff) (B2: class) (R S: class y1) (U: class) (F G: class x3 y1):
  $ wceq R (cfv U cringc) $ >
  $ wceq S (cfv U csetc) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel U cwun) $ >
  $ wi ph (wceq F (cmpt x3 B2 (cfv (cv x3) cbs))) $ >
  $ wi ph (wceq G (cmpo x3 y1 B2 B2 (cres cid (co (cv x3) (cv y1) crh)))) $ >
  $ wi ph (wbr F G (co R S cfunc)) $;

--| The zero ring is a terminal object in the category of unital rings. (Contributed by AV, 17-Apr-2020.)
theorem zrtermoringc (ph: wff) (C U V Z: class):
  $ wi ph (wcel U V) $ >
  $ wceq C (cfv U cringc) $ >
  $ wi ph (wcel Z (cdif crg cnzr)) $ >
  $ wi ph (wcel Z U) $ >
  $ wi ph (wcel Z (cfv C ctermo)) $;

--| The zero ring is not an initial object in the category of unital rings (if the universe contains at least one unital ring different from the zero ring). (Contributed by AV, 18-Apr-2020.)
theorem zrninitoringc {r: setvar} (ph: wff) (C: class) (U V: class r) (Z: class):
  $ wi ph (wcel U V) $ >
  $ wceq C (cfv U cringc) $ >
  $ wi ph (wcel Z (cdif crg cnzr)) $ >
  $ wi ph (wcel Z U) $ >
  $ wi ph (wrex r (wcel (cv r) cnzr) (cfv C cbs)) $ >
  $ wi ph (wnel Z (cfv C cinito)) $;

--| Lemma 1 for ~ srhmsubc . (Contributed by AV, 19-Feb-2020.)
theorem srhmsubclem1 {r: setvar} (C: class r) (S: class) (U: class r) (X: class):
  $ wral r (wcel (cv r) crg) S $ >
  $ wceq C (cin U S) $ >
  $ wi (wcel X C) (wcel X (cin U crg)) $;

--| Lemma 2 for ~ srhmsubc . (Contributed by AV, 19-Feb-2020.)
theorem srhmsubclem2 {r: setvar} (C: class r) (S: class) (U V: class r) (X: class):
  $ wral r (wcel (cv r) crg) S $ >
  $ wceq C (cin U S) $ >
  $ wi (wa (wcel U V) (wcel X C)) (wcel X (cfv (cfv U cringc) cbs)) $;

--| Lemma 3 for ~ srhmsubc . (Contributed by AV, 19-Feb-2020.)
theorem srhmsubclem3 {s1 r: setvar} (C: class) (S: class s1) (U: class) (J: class s1 r) (V X Y: class):
  $ wral r (wcel (cv r) crg) S $ >
  $ wceq C (cin U S) $ >
  $ wceq J (cmpo r s1 C C (co (cv r) (cv s1) crh)) $ >
  $ wi (wa (wcel U V) (wa (wcel X C) (wcel Y C))) (wceq (co X Y J) (co X Y (cfv (cfv U cringc) chom))) $;

--| According to ~ df-subc , the subcategories ` ( Subcat `` C ) ` of a category ` C ` are subsets of the homomorphisms of ` C ` (see ~ subcssc and ~ subcss2 ). Therefore, the set of special ring homomorphisms (i.e., ring homomorphisms from a special ring to another ring of that kind) is a subcategory of the category of (unital) rings. (Contributed by AV, 19-Feb-2020.)
theorem srhmsubc {s1 r: setvar} (C: class) (S: class s1) (U: class) (J: class s1 r) (V: class):
  $ wral r (wcel (cv r) crg) S $ >
  $ wceq C (cin U S) $ >
  $ wceq J (cmpo r s1 C C (co (cv r) (cv s1) crh)) $ >
  $ wi (wcel U V) (wcel J (cfv (cfv U cringc) csubc)) $;

--| The restriction of the category of (unital) rings to the set of special ring homomorphisms is a category. (Contributed by AV, 19-Feb-2020.)
theorem sringcat {s1 r: setvar} (C: class) (S: class s1) (U: class) (J: class s1 r) (V: class):
  $ wral r (wcel (cv r) crg) S $ >
  $ wceq C (cin U S) $ >
  $ wceq J (cmpo r s1 C C (co (cv r) (cv s1) crh)) $ >
  $ wi (wcel U V) (wcel (co (cfv U cringc) J cresc) ccat) $;

--| According to ~ df-subc , the subcategories ` ( Subcat `` C ) ` of a category ` C ` are subsets of the homomorphisms of ` C ` (see ~ subcssc and ~ subcss2 ). Therefore, the set of commutative ring homomorphisms (i.e. ring homomorphisms from a commutative ring to a commutative ring) is a "subcategory" of the category of (unital) rings. (Contributed by AV, 19-Feb-2020.)
theorem crhmsubc {s1 r: setvar} (C U: class) (J: class s1 r) (V: class):
  $ wceq C (cin U ccrg) $ >
  $ wceq J (cmpo r s1 C C (co (cv r) (cv s1) crh)) $ >
  $ wi (wcel U V) (wcel J (cfv (cfv U cringc) csubc)) $;

--| The restriction of the category of (unital) rings to the set of commutative ring homomorphisms is a category, the "category of commutative rings". (Contributed by AV, 19-Feb-2020.)
theorem cringcat {s1 r: setvar} (C U: class) (J: class s1 r) (V: class):
  $ wceq C (cin U ccrg) $ >
  $ wceq J (cmpo r s1 C C (co (cv r) (cv s1) crh)) $ >
  $ wi (wcel U V) (wcel (co (cfv U cringc) J cresc) ccat) $;

--| The category of non-unital rings (in a universe) restricted to the ring homomorphisms between unital rings (in the same universe). (Contributed by AV, 1-Mar-2020.)
theorem rngcrescrhm (ph: wff) (C R U H V: class):
  $ wi ph (wcel U V) $ >
  $ wceq C (cfv U crngc) $ >
  $ wi ph (wceq R (cin crg U)) $ >
  $ wceq H (cres crh (cxp R R)) $ >
  $ wi ph (wceq (co C H cresc) (co (co C R cress) (cop (cfv cnx chom) H) csts)) $;

--| Lemma 1 for ~ rhmsubc . (Contributed by AV, 2-Mar-2020.)
theorem rhmsubclem1 (ph: wff) (C R U H V: class):
  $ wi ph (wcel U V) $ >
  $ wceq C (cfv U crngc) $ >
  $ wi ph (wceq R (cin crg U)) $ >
  $ wceq H (cres crh (cxp R R)) $ >
  $ wi ph (wfn H (cxp R R)) $;

--| Lemma 2 for ~ rhmsubc . (Contributed by AV, 2-Mar-2020.)
theorem rhmsubclem2 (ph: wff) (C R U H V X Y: class):
  $ wi ph (wcel U V) $ >
  $ wceq C (cfv U crngc) $ >
  $ wi ph (wceq R (cin crg U)) $ >
  $ wceq H (cres crh (cxp R R)) $ >
  $ wi (w3a ph (wcel X R) (wcel Y R)) (wceq (co X Y H) (co X Y crh)) $;

--| Lemma 3 for ~ rhmsubc . (Contributed by AV, 2-Mar-2020.)
theorem rhmsubclem3 (ph: wff) (x3: setvar) (C R U H V: class):
  $ wi ph (wcel U V) $ >
  $ wceq C (cfv U crngc) $ >
  $ wi ph (wceq R (cin crg U)) $ >
  $ wceq H (cres crh (cxp R R)) $ >
  $ wi (wa ph (wcel (cv x3) R)) (wcel (cfv (cv x3) (cfv (cfv U crngc) ccid)) (co (cv x3) (cv x3) H)) $;

--| Lemma 4 for ~ rhmsubc . (Contributed by AV, 2-Mar-2020.)
theorem rhmsubclem4 (ph: wff) (x3 y1 z: setvar) (C R U: class) (f2 g2: setvar) (H V: class):
  $ wi ph (wcel U V) $ >
  $ wceq C (cfv U crngc) $ >
  $ wi ph (wceq R (cin crg U)) $ >
  $ wceq H (cres crh (cxp R R)) $ >
  $ wi (wa (wa (wa ph (wcel (cv x3) R)) (wa (wcel (cv y1) R) (wcel (cv z) R))) (wa (wcel (cv f2) (co (cv x3) (cv y1) H)) (wcel (cv g2) (co (cv y1) (cv z) H)))) (wcel (co (cv g2) (cv f2) (co (cop (cv x3) (cv y1)) (cv z) (cfv (cfv U crngc) cco))) (co (cv x3) (cv z) H)) $;

--| According to ~ df-subc , the subcategories ` ( Subcat `` C ) ` of a category ` C ` are subsets of the homomorphisms of ` C ` (see ~ subcssc and ~ subcss2 ). Therefore, the set of unital ring homomorphisms is a "subcategory" of the category of non-unital rings. (Contributed by AV, 2-Mar-2020.)
theorem rhmsubc (ph: wff) (C R U H V: class):
  $ wi ph (wcel U V) $ >
  $ wceq C (cfv U crngc) $ >
  $ wi ph (wceq R (cin crg U)) $ >
  $ wceq H (cres crh (cxp R R)) $ >
  $ wi ph (wcel H (cfv (cfv U crngc) csubc)) $;

--| The restriction of the category of non-unital rings to the set of unital ring homomorphisms is a category. (Contributed by AV, 4-Mar-2020.)
theorem rhmsubccat (ph: wff) (C R U H V: class):
  $ wi ph (wcel U V) $ >
  $ wceq C (cfv U crngc) $ >
  $ wi ph (wceq R (cin crg U)) $ >
  $ wceq H (cres crh (cxp R R)) $ >
  $ wi ph (wcel (co (cfv U crngc) H cresc) ccat) $;

--| Set of left-regular elements in a ring.
term crlreg: class;

--| Class of (ring theoretic) domains.
term cdomn: class;

--| Class of integral domains.
term cidom: class;

--| Define the set of _left-regular elements_ in a ring as those elements which are not left zero divisors, meaning that multiplying a nonzero element on the left by a left-regular element gives a nonzero product. (Contributed by Stefan O'Rear, 22-Mar-2015.)
axiom df_rlreg {x3 y1 r: setvar}:
  $ wceq crlreg (cmpt r cvv (crab x3 (wral y1 (wi (wceq (co (cv x3) (cv y1) (cfv (cv r) cmulr)) (cfv (cv r) c0g)) (wceq (cv y1) (cfv (cv r) c0g))) (cfv (cv r) cbs)) (cfv (cv r) cbs))) $;

--| A _domain_ is a nonzero ring in which there are no nontrivial zero divisors. (Contributed by Mario Carneiro, 28-Mar-2015.)
axiom df_domn {x3 y1 z r b: setvar}:
  $ wceq cdomn (crab r (wsbc b (wsbc z (wral x3 (wral y1 (wi (wceq (co (cv x3) (cv y1) (cfv (cv r) cmulr)) (cv z)) (wo (wceq (cv x3) (cv z)) (wceq (cv y1) (cv z)))) (cv b)) (cv b)) (cfv (cv r) c0g)) (cfv (cv r) cbs)) cnzr) $;

--| An _integral domain_ is a commutative domain. (Contributed by Mario Carneiro, 17-Jun-2015.)
axiom df_idom:
  $ wceq cidom (cin ccrg cdomn) $;

--| Value of the set or left-regular elements in a ring. (Contributed by Stefan O'Rear, 22-Mar-2015.)
theorem rrgval {x3 y1: setvar} (B2 R: class) (c_x E c_0: class x3 y1):
  $ wceq E (cfv R crlreg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq E (crab x3 (wral y1 (wi (wceq (co (cv x3) (cv y1) c_x) c_0) (wceq (cv y1) c_0)) B2) B2) $;

--| Membership in the set of left-regular elements. (Contributed by Stefan O'Rear, 22-Mar-2015.)
theorem isrrg {y1: setvar} (B2 R: class) (c_x E: class y1) (X: class) (c_0: class y1):
  $ wceq E (cfv R crlreg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wb (wcel X E) (wa (wcel X B2) (wral y1 (wi (wceq (co X (cv y1) c_x) c_0) (wceq (cv y1) c_0)) B2)) $;

--| Property of a left-regular element. (Contributed by Stefan O'Rear, 22-Mar-2015.)
theorem rrgeq0i (B2 R c_x E X Y c_0: class):
  $ wceq E (cfv R crlreg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel X E) (wcel Y B2)) (wi (wceq (co X Y c_x) c_0) (wceq Y c_0)) $;

--| Left-multiplication by a left regular element does not change zeroness. (Contributed by Stefan O'Rear, 28-Mar-2015.)
theorem rrgeq0 (B2 R c_x E X Y c_0: class):
  $ wceq E (cfv R crlreg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel R crg) (wcel X E) (wcel Y B2)) (wb (wceq (co X Y c_x) c_0) (wceq Y c_0)) $;

--| Left multiplication by a left regular element does not change the support set of a vector. (Contributed by Stefan O'Rear, 28-Mar-2015.) (Revised by AV, 20-Jul-2019.)
theorem rrgsupp (ph: wff) (B2 R c_x E I V X Y c_0: class):
  $ wceq E (cfv R crlreg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X E) $ >
  $ wi ph (wf I B2 Y) $ >
  $ wi ph (wceq (co (co (cxp I (csn X)) Y (cof c_x)) c_0 csupp) (co Y c_0 csupp)) $;

--| Left-regular elements are a subset of the base set. (Contributed by Stefan O'Rear, 22-Mar-2015.)
theorem rrgss (B2 R E: class):
  $ wceq E (cfv R crlreg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wss E B2 $;

--| Units are regular elements. (Contributed by Stefan O'Rear, 22-Mar-2015.)
theorem unitrrg (R U E: class):
  $ wceq E (cfv R crlreg) $ >
  $ wceq U (cfv R cui) $ >
  $ wi (wcel R crg) (wss U E) $;

--| In a nonzero ring, the zero is a left zero divisor (that is, not a left-regular element). (Contributed by Thierry Arnoux, 6-May-2025.)
theorem rrgnz (R E c_0: class):
  $ wceq E (cfv R crlreg) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R cnzr) (wn (wcel c_0 E)) $;

--| Expand definition of a domain. (Contributed by Mario Carneiro, 28-Mar-2015.)
theorem isdomn {x3 y1: setvar} (B2 R: class) (c_x: class x3 y1) (c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wb (wcel R cdomn) (wa (wcel R cnzr) (wral x3 (wral y1 (wi (wceq (co (cv x3) (cv y1) c_x) c_0) (wo (wceq (cv x3) c_0) (wceq (cv y1) c_0))) B2) B2)) $;

--| A domain is a nonzero ring. (Contributed by Mario Carneiro, 28-Mar-2015.)
theorem domnnzr (R: class):
  $ wi (wcel R cdomn) (wcel R cnzr) $;

--| A domain is a ring. (Contributed by Mario Carneiro, 28-Mar-2015.)
theorem domnring (R: class):
  $ wi (wcel R cdomn) (wcel R crg) $;

--| In a domain, a product is zero iff it has a zero factor. (Contributed by Mario Carneiro, 28-Mar-2015.)
theorem domneq0 (B2 R c_x X Y c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel R cdomn) (wcel X B2) (wcel Y B2)) (wb (wceq (co X Y c_x) c_0) (wo (wceq X c_0) (wceq Y c_0))) $;

--| In a domain, a product of nonzero elements is nonzero. (Contributed by Mario Carneiro, 6-May-2015.)
theorem domnmuln0 (B2 R c_x X Y c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel R cdomn) (wa (wcel X B2) (wne X c_0)) (wa (wcel Y B2) (wne Y c_0))) (wne (co X Y c_x) c_0) $;

--| The equivalence between the right conjuncts in the right hand sides of ~ isdomn and ~ isdomn2 , in predicate calculus form. (Contributed by SN, 16-Sep-2024.)
theorem isdomn5 {a b: setvar} (B2 c_x: class a b) (c_0: class):
  $ wb (wral a (wral b (wi (wceq (co (cv a) (cv b) c_x) c_0) (wo (wceq (cv a) c_0) (wceq (cv b) c_0))) B2) B2) (wral a (wral b (wi (wceq (co (cv a) (cv b) c_x) c_0) (wceq (cv b) c_0)) B2) (cdif B2 (csn c_0))) $;

--| A ring is a domain iff all nonzero elements are regular elements. (Contributed by Mario Carneiro, 28-Mar-2015.) (Proof shortened by SN, 21-Jun-2025.)
theorem isdomn2 (B2 R E c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq E (cfv R crlreg) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wb (wcel R cdomn) (wa (wcel R cnzr) (wss (cdif B2 (csn c_0)) E)) $;

--| In a domain, a nonzero element is a regular element. (Contributed by Mario Carneiro, 28-Mar-2015.)
theorem domnrrg (B2 R E X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq E (cfv R crlreg) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel R cdomn) (wcel X B2) (wne X c_0)) (wcel X E) $;

--| A ring is a domain iff the regular elements are the nonzero elements. Compare ~ isdomn2 , ~ domnrrg . (Contributed by Thierry Arnoux, 6-May-2025.)
theorem isdomn6 (B2 R E c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq E (cfv R crlreg) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wb (wcel R cdomn) (wa (wcel R cnzr) (wceq (cdif B2 (csn c_0)) E)) $;

--| Nonzero elements form a multiplicative submonoid of any domain. (Contributed by Stefan O'Rear, 11-Sep-2015.)
theorem isdomn3 (B2 R U c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq U (cfv R cmgp) $ >
  $ wb (wcel R cdomn) (wa (wcel R crg) (wcel (cdif B2 (csn c_0)) (cfv U csubmnd))) $;

--| A ring is a domain iff it is nonzero and the left cancellation law for multiplication holds. (Contributed by SN, 15-Sep-2024.)
theorem isdomn4 {a b c: setvar} (B2 R: class) (c_x: class a b) (c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wb (wcel R cdomn) (wa (wcel R cnzr) (wral a (wral b (wral c (wi (wceq (co (cv a) (cv b) c_x) (co (cv a) (cv c) c_x)) (wceq (cv b) (cv c))) B2) B2) (cdif B2 (csn c_0)))) $;

--| A class is a domain if and only if its opposite is a domain, biconditional form of ~ opprdomn . (Contributed by SN, 15-Jun-2015.)
theorem opprdomnb (R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wb (wcel R cdomn) (wcel O cdomn) $;

--| The opposite of a domain is also a domain. (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem opprdomn (R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wi (wcel R cdomn) (wcel O cdomn) $;

--| A ring is a domain iff it is nonzero and the right cancellation law for multiplication holds. (Contributed by SN, 20-Jun-2025.)
theorem isdomn4r {a b c: setvar} (B2 R: class) (c_x: class a b c) (c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wb (wcel R cdomn) (wa (wcel R cnzr) (wral a (wral b (wral c (wi (wceq (co (cv a) (cv c) c_x) (co (cv b) (cv c) c_x)) (wceq (cv a) (cv b))) (cdif B2 (csn c_0))) B2) B2)) $;

--| Left-cancellation law for domains, biconditional version of ~ domnlcan . (Contributed by Thierry Arnoux, 8-Jun-2025.) Shorten this theorem and ~ domnlcan overall. (Revised by SN, 21-Jun-2025.)
theorem domnlcanb (ph: wff) (B2 R c_x X Y c_0 Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel X (cdif B2 (csn c_0))) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel R cdomn) $ >
  $ wi ph (wb (wceq (co X Y c_x) (co X Z c_x)) (wceq Y Z)) $;

--| Left-cancellation law for domains. (Contributed by Thierry Arnoux, 22-Mar-2025.) (Proof shortened by SN, 21-Jun-2025.)
theorem domnlcan (ph: wff) (B2 R c_x X Y c_0 Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel X (cdif B2 (csn c_0))) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel R cdomn) $ >
  $ wi ph (wceq (co X Y c_x) (co X Z c_x)) $ >
  $ wi ph (wceq Y Z) $;

--| Right-cancellation law for domains, biconditional version of ~ domnrcan . (Contributed by SN, 21-Jun-2025.)
theorem domnrcanb (ph: wff) (B2 R c_x X Y c_0 Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z (cdif B2 (csn c_0))) $ >
  $ wi ph (wcel R cdomn) $ >
  $ wi ph (wb (wceq (co X Z c_x) (co Y Z c_x)) (wceq X Y)) $;

--| Right-cancellation law for domains. (Contributed by SN, 21-Jun-2025.)
theorem domnrcan (ph: wff) (B2 R c_x X Y c_0 Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z (cdif B2 (csn c_0))) $ >
  $ wi ph (wcel R cdomn) $ >
  $ wi ph (wceq (co X Z c_x) (co Y Z c_x)) $ >
  $ wi ph (wceq X Y) $;

--| Right multiplication by a nonzero element does not change zeroness in a domain. Compare ~ rrgeq0 . (Contributed by SN, 21-Jun-2025.)
theorem domneq0r (ph: wff) (B2 R c_x X Y c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y (cdif B2 (csn c_0))) $ >
  $ wi ph (wcel R cdomn) $ >
  $ wi ph (wb (wceq (co X Y c_x) c_0) (wceq X c_0)) $;

--| An integral domain is a commutative domain. (Contributed by Mario Carneiro, 17-Jun-2015.)
theorem isidom (R: class):
  $ wb (wcel R cidom) (wa (wcel R ccrg) (wcel R cdomn)) $;

--| An integral domain is a domain. (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem idomdomd (ph: wff) (R: class):
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel R cdomn) $;

--| An integral domain is a commutative ring with unity. (Contributed by Jeff Madsen, 6-Jan-2011.) (Revised by Thierry Arnoux, 4-May-2025.) Formerly subproof of ~ idomringd . (Proof shortened by SN, 14-May-2025.)
theorem idomcringd (ph: wff) (R: class):
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel R ccrg) $;

--| An integral domain is a ring. (Contributed by Jeff Madsen, 6-Jan-2011.) (Revised by Thierry Arnoux, 22-Mar-2025.)
theorem idomringd (ph: wff) (R: class):
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel R crg) $;

--| Extend class notation with class of all division rings.
term cdr: class;

--| Class of fields.
term cfield: class;

--| Define class of all division rings. A division ring is a ring in which the set of units is exactly the nonzero elements of the ring. (Contributed by NM, 4-Apr-2009.) (Revised by NM, 18-Oct-2012.)
axiom df_drng {r: setvar}:
  $ wceq cdr (crab r (wceq (cfv (cv r) cui) (cdif (cfv (cv r) cbs) (csn (cfv (cv r) c0g)))) crg) $;

--| A _field_ is a commutative division ring. (Contributed by Mario Carneiro, 17-Jun-2015.)
axiom df_field:
  $ wceq cfield (cin cdr ccrg) $;

--| The predicate "is a division ring". (Contributed by NM, 18-Oct-2012.) (Revised by Mario Carneiro, 2-Dec-2014.)
theorem isdrng (B2 R U c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wb (wcel R cdr) (wa (wcel R crg) (wceq U (cdif B2 (csn c_0)))) $;

--| Elementhood in the set of units when ` R ` is a division ring. (Contributed by Mario Carneiro, 2-Dec-2014.)
theorem drngunit (B2 R U X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R cdr) (wb (wcel X U) (wa (wcel X B2) (wne X c_0))) $;

--| The set of units of a division ring. (Contributed by Mario Carneiro, 2-Dec-2014.)
theorem drngui (B2 R c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wcel R cdr $ >
  $ wceq (cdif B2 (csn c_0)) (cfv R cui) $;

--| A division ring is a ring. (Contributed by NM, 8-Sep-2011.)
theorem drngring (R: class):
  $ wi (wcel R cdr) (wcel R crg) $;

--| A division ring is a ring. (Contributed by SN, 16-May-2024.)
theorem drngringd (ph: wff) (R: class):
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wcel R crg) $;

--| A division ring is a group (deduction form). (Contributed by SN, 16-May-2024.)
theorem drnggrpd (ph: wff) (R: class):
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wcel R cgrp) $;

--| A division ring is a group (closed form). (Contributed by NM, 8-Sep-2011.)
theorem drnggrp (R: class):
  $ wi (wcel R cdr) (wcel R cgrp) $;

--| If a ring unit element ` X ` admits both a left inverse ` Y ` and a right inverse ` Z ` , they are equal. (Contributed by Thierry Arnoux, 9-Mar-2025.)
theorem ringinveu (ph: wff) (B2 R c_x U c_1 X Y c_0 Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq U (cfv R cui) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wceq (co Y X c_x) c_1) $ >
  $ wi ph (wceq (co X Z c_x) c_1) $ >
  $ wi ph (wceq Z Y) $;

--| A division ring is a ring in which ` 1 =/= 0 ` and every nonzero element has a left and right inverse. (Contributed by Thierry Arnoux, 2-Mar-2025.)
theorem isdrng4 {x3 y1: setvar} (ph: wff) (B2 R c_x U c_1: class) (c_0: class y1):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq U (cfv R cui) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wb (wcel R cdr) (wa (wne c_1 c_0) (wral x3 (wrex y1 (wa (wceq (co (cv x3) (cv y1) c_x) c_1) (wceq (co (cv y1) (cv x3) c_x) c_1)) B2) (cdif B2 (csn c_0))))) $;

--| A field is a commutative division ring. (Contributed by Mario Carneiro, 17-Jun-2015.)
theorem isfld (R: class):
  $ wb (wcel R cfield) (wa (wcel R cdr) (wcel R ccrg)) $;

--| A field is a division ring. (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by SN, 17-Jan-2025.)
theorem flddrngd (ph: wff) (R: class):
  $ wi ph (wcel R cfield) $ >
  $ wi ph (wcel R cdr) $;

--| A field is a commutative ring. (Contributed by Jeff Madsen, 8-Jun-2010.) (Revised by SN, 23-Nov-2024.)
theorem fldcrngd (ph: wff) (R: class):
  $ wi ph (wcel R cfield) $ >
  $ wi ph (wcel R ccrg) $;

--| Properties of a division ring. (Contributed by NM, 4-Apr-2009.) (Revised by AV, 26-Aug-2026.)
theorem drngprops (B2 R G c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq G (co (cfv R cmgp) (cdif B2 (csn c_0)) cress) $ >
  $ wi (wcel R cdr) (wa (wcel R crg) (wcel G cgrp)) $;

--| A division ring can equivalently be defined as a ring such that the nonzero elements form a group under multiplication (from which it follows that this is the same group as the group of units). (Contributed by Mario Carneiro, 2-Dec-2014.) (Proof shortened by AV, 12-Sep-2026.)
theorem isdrng2 (B2 R G c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq G (co (cfv R cmgp) (cdif B2 (csn c_0)) cress) $ >
  $ wb (wcel R cdr) (wa (wcel R crg) (wcel G cgrp)) $;

--| If two structures have the same ring components (properties), one is a division ring iff the other one is. (Contributed by Mario Carneiro, 11-Oct-2013.) (Revised by Mario Carneiro, 28-Dec-2014.)
theorem drngprop (K L: class):
  $ wceq (cfv K cbs) (cfv L cbs) $ >
  $ wceq (cfv K cplusg) (cfv L cplusg) $ >
  $ wceq (cfv K cmulr) (cfv L cmulr) $ >
  $ wb (wcel K cdr) (wcel L cdr) $;

--| A division ring contains a multiplicative group. (Contributed by NM, 8-Sep-2011.)
theorem drngmgp (B2 R G c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq G (co (cfv R cmgp) (cdif B2 (csn c_0)) cress) $ >
  $ wi (wcel R cdr) (wcel G cgrp) $;

--| A division ring's unity is the identity element of its multiplicative group. (Contributed by NM, 7-Sep-2011.)
theorem drngid (B2 R c_1 G c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq G (co (cfv R cmgp) (cdif B2 (csn c_0)) cress) $ >
  $ wi (wcel R cdr) (wceq c_1 (cfv G c0g)) $;

--| A division ring's unity is different from its zero. (Contributed by FL, 14-Feb-2010.) (Revised by NM, 8-Sep-2011.)
theorem drngunz (R c_1 c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R cdr) (wne c_1 c_0) $;

--| A division ring is a nonzero ring. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem drngnzr (R: class):
  $ wi (wcel R cdr) (wcel R cnzr) $;

--| A division ring is a domain. (Contributed by Mario Carneiro, 29-Mar-2015.)
theorem drngdomn (R: class):
  $ wi (wcel R cdr) (wcel R cdomn) $;

--| Lemma for ~ isdrng3 : The base set of a multipication group restricted to a subset of the original base set. (Contributed by AV, 22-Jul-2026.)
theorem isdrng3lem0 (B2 R X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq (cfv (co (cfv R cmgp) (cdif B2 X) cress) cbs) (cdif B2 X) $;

--| Lemma for ~ isdrng3 (for the left to right implication). Formerly part of proof for ~ isdrng3 . (Contributed by Jeff Madsen, 8-Jun-2010.) (Revised by AV, 22-Jul-2026.)
theorem isdrng3lem1 {x3 y1: setvar} (B2 R: class) (c_x c_1: class x3) (c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crg) (wcel (co (cfv R cmgp) (cdif B2 (csn c_0)) cress) cgrp)) (wral x3 (wrex y1 (wceq (co (cv y1) (cv x3) c_x) c_1) (cdif B2 (csn c_0))) (cdif B2 (csn c_0))) $;

--| Lemma for ~ isdrng3 (for the right to left implication). Formerly part of proof for ~ isdrng3 . (Contributed by Jeff Madsen, 8-Jun-2010.) (Revised by AV, 22-Jul-2026.)
theorem isdrng3lem2 {x3 y1: setvar} (B2 R c_x c_1 c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R crg) (wne c_1 c_0) (wral x3 (wrex y1 (wceq (co (cv y1) (cv x3) c_x) c_1) (cdif B2 (csn c_0))) (cdif B2 (csn c_0)))) (wcel (co (cfv R cmgp) (cdif B2 (csn c_0)) cress) cgrp) $;

--| A division ring is a ring in which ` 1 =/= 0 ` and every nonzero element is invertible. (Contributed by Jeff Madsen, 8-Jun-2010.) (Revised by AV, 22-Jul-2026.)
theorem isdrng3 {x3 y1: setvar} (B2 R c_x c_1 c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wb (wcel R cdr) (w3a (wcel R crg) (wne c_1 c_0) (wral x3 (wrex y1 (wceq (co (cv y1) (cv x3) c_x) c_1) (cdif B2 (csn c_0))) (cdif B2 (csn c_0)))) $;

--| A division ring is a ring in which ` 1 =/= 0 ` and every nonzero element is invertible. (Contributed by Jeff Madsen, 8-Jun-2010.) (Revised by AV, 23-Jul-2026.)
theorem isdrng5 {x3 y1: setvar} (B2 R c_x c_1 c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wb (wcel R cdr) (w3a (wcel R crg) (wne c_1 c_0) (wral x3 (wrex y1 (wceq (co (cv y1) (cv x3) c_x) c_1) B2) (cdif B2 (csn c_0)))) $;

--| The product of two nonzero elements of a division ring is nonzero. (Contributed by Jeff Madsen, 9-Jun-2010.) (Revised by NM, 7-Sep-2011.) (Proof shortened by SN, 25-Jun-2025.)
theorem drngmcl (B2 R c_x X Y c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel R cdr) (wcel X (cdif B2 (csn c_0))) (wcel Y (cdif B2 (csn c_0)))) (wcel (co X Y c_x) (cdif B2 (csn c_0))) $;

--| Properties showing that an element ` I ` is the identity element of a division ring. (Contributed by Mario Carneiro, 11-Oct-2013.)
theorem drngid2 (B2 R c_x c_1 I c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R cdr) (wb (w3a (wcel I B2) (wne I c_0) (wceq (co I I c_x) I)) (wceq c_1 I)) $;

--| Closure of the multiplicative inverse in a division ring. ( ~ reccl analog). (Contributed by NM, 19-Apr-2014.)
theorem drnginvrcl (B2 R I X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wi (w3a (wcel R cdr) (wcel X B2) (wne X c_0)) (wcel (cfv X I) B2) $;

--| The multiplicative inverse in a division ring is nonzero. ( ~ recne0 analog). (Contributed by NM, 19-Apr-2014.)
theorem drnginvrn0 (B2 R I X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wi (w3a (wcel R cdr) (wcel X B2) (wne X c_0)) (wne (cfv X I) c_0) $;

--| Closure of the multiplicative inverse in a division ring. ( ~ reccld analog). (Contributed by SN, 14-Aug-2024.)
theorem drnginvrcld (ph: wff) (B2 R I X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wcel (cfv X I) B2) $;

--| Property of the multiplicative inverse in a division ring. ( ~ recid2 analog). (Contributed by NM, 19-Apr-2014.)
theorem drnginvrl (B2 R c_x c_1 I X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wi (w3a (wcel R cdr) (wcel X B2) (wne X c_0)) (wceq (co (cfv X I) X c_x) c_1) $;

--| Property of the multiplicative inverse in a division ring. ( ~ recid analog). (Contributed by NM, 19-Apr-2014.)
theorem drnginvrr (B2 R c_x c_1 I X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wi (w3a (wcel R cdr) (wcel X B2) (wne X c_0)) (wceq (co X (cfv X I) c_x) c_1) $;

--| Property of the multiplicative inverse in a division ring. ( ~ recid2d analog). (Contributed by SN, 14-Aug-2024.)
theorem drnginvrld (ph: wff) (B2 R c_x c_1 I X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wceq (co (cfv X I) X c_x) c_1) $;

--| Property of the multiplicative inverse in a division ring. ( ~ recidd analog). (Contributed by SN, 14-Aug-2024.)
theorem drnginvrrd (ph: wff) (B2 R c_x c_1 I X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wceq (co X (cfv X I) c_x) c_1) $;

--| A product is zero iff one of its factors is zero. (Contributed by NM, 8-Oct-2014.) (Proof shortened by SN, 25-Jun-2025.)
theorem drngmul0or (ph: wff) (B2 R c_x X Y c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wb (wceq (co X Y c_x) c_0) (wo (wceq X c_0) (wceq Y c_0))) $;

--| A product is nonzero iff both its factors are nonzero. (Contributed by NM, 18-Oct-2014.)
theorem drngmulne0 (ph: wff) (B2 R c_x X Y c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wb (wne (co X Y c_x) c_0) (wa (wne X c_0) (wne Y c_0))) $;

--| An element is zero iff its product with a nonzero element is zero. (Contributed by NM, 8-Oct-2014.)
theorem drngmuleq0 (ph: wff) (B2 R c_x X Y c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wne Y c_0) $ >
  $ wi ph (wb (wceq (co X Y c_x) c_0) (wceq X c_0)) $;

--| The opposite of a division ring is also a division ring. (Contributed by NM, 18-Oct-2014.)
theorem opprdrng (R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wb (wcel R cdr) (wcel O cdr) $;

--| Properties that characterize a division ring among rings: it should be nonzero, have no nonzero zero-divisors, and every nonzero element ` x ` should have a left-inverse ` I ( x ) ` . See ~ isdrngrd for the characterization using right-inverses. (Contributed by NM, 2-Aug-2013.) Remove hypothesis. (Revised by SN, 19-Feb-2025.)
theorem isdrngd {x3 y1: setvar} (ph: wff) (B2 R c_x c_1: class) (I: class x3) (c_0: class):
  $ wi ph (wceq B2 (cfv R cbs)) $ >
  $ wi ph (wceq c_x (cfv R cmulr)) $ >
  $ wi ph (wceq c_0 (cfv R c0g)) $ >
  $ wi ph (wceq c_1 (cfv R cur)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi (w3a ph (wa (wcel (cv x3) B2) (wne (cv x3) c_0)) (wa (wcel (cv y1) B2) (wne (cv y1) c_0))) (wne (co (cv x3) (cv y1) c_x) c_0) $ >
  $ wi ph (wne c_1 c_0) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wne (cv x3) c_0))) (wcel I B2) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wne (cv x3) c_0))) (wceq (co I (cv x3) c_x) c_1) $ >
  $ wi ph (wcel R cdr) $;

--| Properties that characterize a division ring among rings: it should be nonzero, have no nonzero zero-divisors, and every nonzero element ` x ` should have a right-inverse ` I ( x ) ` . See ~ isdrngd for the characterization using left-inverses. (Contributed by NM, 10-Aug-2013.) Remove hypothesis. (Revised by SN, 19-Feb-2025.)
theorem isdrngrd {x3 y1: setvar} (ph: wff) (B2 R c_x c_1: class) (I: class x3) (c_0: class):
  $ wi ph (wceq B2 (cfv R cbs)) $ >
  $ wi ph (wceq c_x (cfv R cmulr)) $ >
  $ wi ph (wceq c_0 (cfv R c0g)) $ >
  $ wi ph (wceq c_1 (cfv R cur)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi (w3a ph (wa (wcel (cv x3) B2) (wne (cv x3) c_0)) (wa (wcel (cv y1) B2) (wne (cv y1) c_0))) (wne (co (cv x3) (cv y1) c_x) c_0) $ >
  $ wi ph (wne c_1 c_0) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wne (cv x3) c_0))) (wcel I B2) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wne (cv x3) c_0))) (wceq (co (cv x3) I c_x) c_1) $ >
  $ wi ph (wcel R cdr) $;

--| Obsolete version of ~ isdrngd as of 19-Feb-2025. (Contributed by NM, 2-Aug-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem isdrngdOLD {x3 y1: setvar} (ph: wff) (B2 R c_x c_1: class) (I: class x3) (c_0: class):
  $ wi ph (wceq B2 (cfv R cbs)) $ >
  $ wi ph (wceq c_x (cfv R cmulr)) $ >
  $ wi ph (wceq c_0 (cfv R c0g)) $ >
  $ wi ph (wceq c_1 (cfv R cur)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi (w3a ph (wa (wcel (cv x3) B2) (wne (cv x3) c_0)) (wa (wcel (cv y1) B2) (wne (cv y1) c_0))) (wne (co (cv x3) (cv y1) c_x) c_0) $ >
  $ wi ph (wne c_1 c_0) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wne (cv x3) c_0))) (wcel I B2) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wne (cv x3) c_0))) (wne I c_0) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wne (cv x3) c_0))) (wceq (co I (cv x3) c_x) c_1) $ >
  $ wi ph (wcel R cdr) $;

--| Obsolete version of ~ isdrngrd as of 19-Feb-2025. (Contributed by NM, 10-Aug-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem isdrngrdOLD {x3 y1: setvar} (ph: wff) (B2 R c_x c_1: class) (I: class x3) (c_0: class):
  $ wi ph (wceq B2 (cfv R cbs)) $ >
  $ wi ph (wceq c_x (cfv R cmulr)) $ >
  $ wi ph (wceq c_0 (cfv R c0g)) $ >
  $ wi ph (wceq c_1 (cfv R cur)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi (w3a ph (wa (wcel (cv x3) B2) (wne (cv x3) c_0)) (wa (wcel (cv y1) B2) (wne (cv y1) c_0))) (wne (co (cv x3) (cv y1) c_x) c_0) $ >
  $ wi ph (wne c_1 c_0) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wne (cv x3) c_0))) (wcel I B2) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wne (cv x3) c_0))) (wne I c_0) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wne (cv x3) c_0))) (wceq (co (cv x3) I c_x) c_1) $ >
  $ wi ph (wcel R cdr) $;

--| A zero ring is not a division ring. (Contributed by FL, 24-Jan-2010.) (Revised by AV, 22-Jul-2026.)
theorem zrdrng (R c_1 c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wceq c_0 c_1) (wn (wcel R cdr)) $;

--| If two structures have the same group components (properties), one is a division ring iff the other one is. (Contributed by Mario Carneiro, 27-Jun-2015.)
theorem drngpropd {x3 y1: setvar} (ph: wff) (B2 K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi ph (wb (wcel K cdr) (wcel L cdr)) $;

--| If two structures have the same group components (properties), one is a field iff the other one is. (Contributed by Mario Carneiro, 8-Feb-2015.)
theorem fldpropd {x3 y1: setvar} (ph: wff) (B2 K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi ph (wb (wcel K cfield) (wcel L cfield)) $;

--| A field is an integral domain. (Contributed by Mario Carneiro, 29-Mar-2015.) (Proof shortened by SN, 11-Nov-2024.)
theorem fldidom (R: class):
  $ wi (wcel R cfield) (wcel R cidom) $;

--| Lemma for ~ fidomndrng . (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem fidomndrnglem {x3: setvar} (ph: wff x3) (A2 B2: class) (c_pa: class x3) (R c_x: class) (c_1 F c_0: class x3):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R cdomn) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wcel A2 (cdif B2 (csn c_0))) $ >
  $ wceq F (cmpt x3 B2 (co (cv x3) A2 c_x)) $ >
  $ wi ph (wbr A2 c_1 c_pa) $;

--| A finite domain is a division ring. Note that Wedderburn's little theorem (not proved) states that finite division rings are fields. (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem fidomndrng (B2 R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel B2 cfn) (wb (wcel R cdomn) (wcel R cdr)) $;

--| A finite integral domain is a field. (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem fiidomfld (B2 R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel B2 cfn) (wb (wcel R cidom) (wcel R cfield)) $;

--| The (smallest) structure representing a zero ring is not a nonzero ring. (Contributed by AV, 29-Apr-2019.)
theorem rng1nnzr (M V Z: class):
  $ wceq M (ctp (cop (cfv cnx cbs) (csn Z)) (cop (cfv cnx cplusg) (csn (cop (cop Z Z) Z))) (cop (cfv cnx cmulr) (csn (cop (cop Z Z) Z)))) $ >
  $ wi (wcel Z V) (wnel M cnzr) $;

--| The only unital ring with a base set consisting of one element is the zero ring (at least if its operations are internal binary operations). This holds already for nonunital rings, see ~ rng1zr , and semirings, see ~ srg1zr . (Contributed by FL, 13-Feb-2010.) (Revised by AV, 25-Jan-2020.) (Proof shortened by AV, 7-Feb-2020.)
theorem ring1zr (B2 c_pl R c_as Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_as (cfv R cmulr) $ >
  $ wi (wa (w3a (wcel R crg) (wfn c_pl (cxp B2 B2)) (wfn c_as (cxp B2 B2))) (wcel Z B2)) (wb (wceq B2 (csn Z)) (wa (wceq c_pl (csn (cop (cop Z Z) Z))) (wceq c_as (csn (cop (cop Z Z) Z))))) $;

--| The only unital ring with one element is the zero ring (at least if its operations are internal binary operations). This holds already for nonunital rings, see ~ rngen1zr0 , and semirings, see ~ srgen1zr0 . (Contributed by FL, 15-Feb-2010.) (Revised by AV, 25-Jan-2020.) (Proof shortened by AV, 19-Jun-2026.)
theorem ringen1zr0 (B2 c_pl R c_as Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_as (cfv R cmulr) $ >
  $ wceq Z (cfv R c0g) $ >
  $ wi (w3a (wcel R crg) (wfn c_pl (cxp B2 B2)) (wfn c_as (cxp B2 B2))) (wb (wbr B2 c1o cen) (wa (wceq c_pl (csn (cop (cop Z Z) Z))) (wceq c_as (csn (cop (cop Z Z) Z))))) $;

--| The zero ring is not a field. (Contributed by AV, 29-Apr-2019.)
theorem rng1nfld (M V Z: class):
  $ wceq M (ctp (cop (cfv cnx cbs) (csn Z)) (cop (cfv cnx cplusg) (csn (cop (cop Z Z) Z))) (cop (cfv cnx cmulr) (csn (cop (cop Z Z) Z)))) $ >
  $ wi (wcel Z V) (wnel M cfield) $;

--| Characterize the subfields of a division ring. (Contributed by Mario Carneiro, 3-Dec-2014.)
theorem issubdrg {x3: setvar} (A2 R S: class) (I: class x3) (c_0: class):
  $ wceq S (co R A2 cress) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wi (wa (wcel R cdr) (wcel A2 (cfv R csubrg))) (wb (wcel S cdr) (wral x3 (wcel (cfv (cv x3) I) A2) (cdif A2 (csn c_0)))) $;

--| According to ~ df-subc , the subcategories ` ( Subcat `` C ) ` of a category ` C ` are subsets of the homomorphisms of ` C ` (see ~ subcssc and ~ subcss2 ). Therefore, the set of division ring homomorphisms is a "subcategory" of the category of (unital) rings. (Contributed by AV, 20-Feb-2020.)
theorem drhmsubc {s1 r: setvar} (C U: class) (J: class s1 r) (V: class):
  $ wceq C (cin U cdr) $ >
  $ wceq J (cmpo r s1 C C (co (cv r) (cv s1) crh)) $ >
  $ wi (wcel U V) (wcel J (cfv (cfv U cringc) csubc)) $;

--| The restriction of the category of (unital) rings to the set of division ring homomorphisms is a category, the "category of division rings". (Contributed by AV, 20-Feb-2020.)
theorem drngcat {s1 r: setvar} (C U: class) (J: class s1 r) (V: class):
  $ wceq C (cin U cdr) $ >
  $ wceq J (cmpo r s1 C C (co (cv r) (cv s1) crh)) $ >
  $ wi (wcel U V) (wcel (co (cfv U cringc) J cresc) ccat) $;

--| The restriction of the category of (unital) rings to the set of field homomorphisms is a category, the "category of fields". (Contributed by AV, 20-Feb-2020.)
theorem fldcat {s1 r: setvar} (C D U: class) (F J: class s1 r) (V: class):
  $ wceq C (cin U cdr) $ >
  $ wceq J (cmpo r s1 C C (co (cv r) (cv s1) crh)) $ >
  $ wceq D (cin U cfield) $ >
  $ wceq F (cmpo r s1 D D (co (cv r) (cv s1) crh)) $ >
  $ wi (wcel U V) (wcel (co (cfv U cringc) F cresc) ccat) $;

--| The restriction of the category of division rings to the set of field homomorphisms is a category, the "category of fields". (Contributed by AV, 20-Feb-2020.)
theorem fldc {s1 r: setvar} (C D U: class) (F J: class s1 r) (V: class):
  $ wceq C (cin U cdr) $ >
  $ wceq J (cmpo r s1 C C (co (cv r) (cv s1) crh)) $ >
  $ wceq D (cin U cfield) $ >
  $ wceq F (cmpo r s1 D D (co (cv r) (cv s1) crh)) $ >
  $ wi (wcel U V) (wcel (co (co (cfv U cringc) J cresc) F cresc) ccat) $;

--| According to ~ df-subc , the subcategories ` ( Subcat `` C ) ` of a category ` C ` are subsets of the homomorphisms of ` C ` (see ~ subcssc and ~ subcss2 ). Therefore, the set of field homomorphisms is a "subcategory" of the category of division rings. (Contributed by AV, 20-Feb-2020.)
theorem fldhmsubc {s1 r: setvar} (C D U: class) (F J: class s1 r) (V: class):
  $ wceq C (cin U cdr) $ >
  $ wceq J (cmpo r s1 C C (co (cv r) (cv s1) crh)) $ >
  $ wceq D (cin U cfield) $ >
  $ wceq F (cmpo r s1 D D (co (cv r) (cv s1) crh)) $ >
  $ wi (wcel U V) (wcel F (cfv (co (cfv U cringc) J cresc) csubc)) $;

--| Syntax for subfields (sub-division-rings).
term csdrg: class;

--| Define the function associating with a ring the set of its sub-division-rings. A sub-division-ring of a ring is a subset of its base set which is a division ring when equipped with the induced structure (sum, multiplication, zero, and unity). If a ring is commutative (resp., a field), then its sub-division-rings are commutative (resp., are fields) ( ~ fldsdrgfld ), so we do not make a specific definition for subfields. (Contributed by Stefan O'Rear, 3-Oct-2015.) TODO: extend this definition to a function with domain ` _V ` or at least ` Ring ` and not only ` DivRing ` .
axiom df_sdrg {w s1: setvar}:
  $ wceq csdrg (cmpt w cdr (crab s1 (wcel (co (cv w) (cv s1) cress) cdr) (cfv (cv w) csubrg))) $;

--| Property of a division subring. (Contributed by Stefan O'Rear, 3-Oct-2015.)
theorem issdrg (R S: class):
  $ wb (wcel S (cfv R csdrg)) (w3a (wcel R cdr) (wcel S (cfv R csubrg)) (wcel (co R S cress) cdr)) $;

--| Reverse closure for a sub-division-ring predicate. (Contributed by SN, 19-Feb-2025.)
theorem sdrgrcl (A2 R: class):
  $ wi (wcel A2 (cfv R csdrg)) (wcel R cdr) $;

--| A sub-division-ring is a division ring. (Contributed by SN, 19-Feb-2025.)
theorem sdrgdrng (A2 R S: class):
  $ wceq S (co R A2 cress) $ >
  $ wi (wcel A2 (cfv R csdrg)) (wcel S cdr) $;

--| A sub-division-ring is a subring. (Contributed by SN, 19-Feb-2025.)
theorem sdrgsubrg (A2 R: class):
  $ wi (wcel A2 (cfv R csdrg)) (wcel A2 (cfv R csubrg)) $;

--| Every division ring is a division subring of itself. (Contributed by Thierry Arnoux, 21-Aug-2023.)
theorem sdrgid (B2 R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R cdr) (wcel B2 (cfv R csdrg)) $;

--| A division subring is a subset of the base set. (Contributed by Thierry Arnoux, 21-Aug-2023.)
theorem sdrgss (B2 R S: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel S (cfv R csdrg)) (wss S B2) $;

--| Base set of a sub-division-ring structure. (Contributed by SN, 19-Feb-2025.)
theorem sdrgbas (A2 R S: class):
  $ wceq S (co R A2 cress) $ >
  $ wi (wcel A2 (cfv R csdrg)) (wceq A2 (cfv S cbs)) $;

--| Property of a division subring (closure version). (Contributed by Mario Carneiro, 3-Oct-2015.)
theorem issdrg2 {x3: setvar} (R S: class) (I: class x3) (c_0: class):
  $ wceq I (cfv R cinvr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wb (wcel S (cfv R csdrg)) (w3a (wcel R cdr) (wcel S (cfv R csubrg)) (wral x3 (wcel (cfv (cv x3) I) S) (cdif S (csn c_0)))) $;

--| A unit of a sub-division-ring is a nonzero element of the subring. (Contributed by SN, 19-Feb-2025.)
theorem sdrgunit (A2 R S U X c_0: class):
  $ wceq S (co R A2 cress) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq U (cfv S cui) $ >
  $ wi (wcel A2 (cfv R csdrg)) (wb (wcel X U) (wa (wcel X A2) (wne X c_0))) $;

--| The image of a (nontrivial) division ring homomorphism is a division ring. (Contributed by SN, 17-Feb-2025.)
theorem imadrhmcl (ph: wff) (R S F M N c_0: class):
  $ wceq R (co N (cima F S) cress) $ >
  $ wceq c_0 (cfv N c0g) $ >
  $ wi ph (wcel F (co M N crh)) $ >
  $ wi ph (wcel S (cfv M csdrg)) $ >
  $ wi ph (wne (crn F) (csn c_0)) $ >
  $ wi ph (wcel R cdr) $;

--| A sub-division-ring of a field is itself a field, so it is a subfield. We can therefore use ` SubDRing ` to express subfields. (Contributed by Thierry Arnoux, 11-Jan-2025.)
theorem fldsdrgfld (A2 F: class):
  $ wi (wa (wcel F cfield) (wcel A2 (cfv F csdrg))) (wcel (co F A2 cress) cfield) $;

--| Construction of a closure rule from a one-parameter _partial_ operation. (Contributed by Stefan O'Rear, 12-Sep-2015.)
theorem acsfn1p {a b: setvar} (E: class b) (V X Y: class):
  $ wi (wa (wcel X V) (wral b (wcel E X) Y)) (wcel (crab a (wral b (wcel E (cv a)) (cin (cv a) Y)) (cpw X)) (cfv X cacs)) $;

--| Closure property of subrings. (Contributed by Stefan O'Rear, 12-Sep-2015.)
theorem subrgacs (B2 R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R crg) (wcel (cfv R csubrg) (cfv B2 cacs)) $;

--| Closure property of division subrings. (Contributed by Mario Carneiro, 3-Oct-2015.)
theorem sdrgacs (B2 R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R cdr) (wcel (cfv R csdrg) (cfv B2 cacs)) $;

--| Centralizers in division rings/fields are subfields. (Contributed by Mario Carneiro, 3-Oct-2015.)
theorem cntzsdrg (B2 R S M Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq Z (cfv M ccntz) $ >
  $ wi (wa (wcel R cdr) (wss S B2)) (wcel (cfv S Z) (cfv R csdrg)) $;

--| The intersection of a nonempty collection of sub division rings is a sub division ring. (Contributed by Thierry Arnoux, 21-Aug-2023.)
theorem subdrgint {s1: setvar} (ph: wff) (R S L: class):
  $ wceq L (co R (cint S) cress) $ >
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wss S (cfv R csubrg)) $ >
  $ wi ph (wne S c0) $ >
  $ wi (wa ph (wcel (cv s1) S)) (wcel (co R (cv s1) cress) cdr) $ >
  $ wi ph (wcel L cdr) $;

--| The intersection of a nonempty collection of sub division rings is a sub division ring. (Contributed by Thierry Arnoux, 21-Aug-2023.)
theorem sdrgint (R S: class):
  $ wi (w3a (wcel R cdr) (wss S (cfv R csdrg)) (wne S c0)) (wcel (cint S) (cfv R csdrg)) $;

--| The smallest sub division ring of a division ring, here named ` P ` , is a field, called the _Prime Field_ of ` R ` . (Suggested by GL, 4-Aug-2023.) (Contributed by Thierry Arnoux, 21-Aug-2023.)
theorem primefld (P R: class):
  $ wceq P (co R (cint (cfv R csdrg)) cress) $ >
  $ wi (wcel R cdr) (wcel P cfield) $;

--| The prime field contains the zero element of the division ring. (Contributed by Thierry Arnoux, 22-Aug-2023.)
theorem primefld0cl (R c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R cdr) (wcel c_0 (cint (cfv R csdrg))) $;

--| The prime field contains the unity element of the division ring. (Contributed by Thierry Arnoux, 22-Aug-2023.)
theorem primefld1cl (R c_1: class):
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R cdr) (wcel c_1 (cint (cfv R csdrg))) $;

--| The set of absolute values on a ring.
term cabv: class;

--| Define the set of absolute values on a ring. An absolute value is a generalization of the usual absolute value function ~ df-abs to arbitrary rings. (Contributed by Mario Carneiro, 8-Sep-2014.)
axiom df_abv {x3 y1 f2 r: setvar}:
  $ wceq cabv (cmpt r crg (crab f2 (wral x3 (wa (wb (wceq (cfv (cv x3) (cv f2)) cc0) (wceq (cv x3) (cfv (cv r) c0g))) (wral y1 (wa (wceq (cfv (co (cv x3) (cv y1) (cfv (cv r) cmulr)) (cv f2)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) cmul)) (wbr (cfv (co (cv x3) (cv y1) (cfv (cv r) cplusg)) (cv f2)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) caddc) cle)) (cfv (cv r) cbs))) (cfv (cv r) cbs)) (co (co cc0 cpnf cico) (cfv (cv r) cbs) cmap))) $;

--| Value of the set of absolute values. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem abvfval {x3 y1 f2: setvar} (A2: class x3 y1 f2) (B2: class) (c_pl: class x3 y1) (R: class) (c_x c_0: class x3 y1):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R crg) (wceq A2 (crab f2 (wral x3 (wa (wb (wceq (cfv (cv x3) (cv f2)) cc0) (wceq (cv x3) c_0)) (wral y1 (wa (wceq (cfv (co (cv x3) (cv y1) c_x) (cv f2)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) cmul)) (wbr (cfv (co (cv x3) (cv y1) c_pl) (cv f2)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) caddc) cle)) B2)) B2) (co (co cc0 cpnf cico) B2 cmap))) $;

--| Elementhood in the set of absolute values. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem isabv {x3 y1: setvar} (A2: class x3 y1) (B2: class) (c_pl: class x3 y1) (R: class) (c_x: class x3 y1) (F: class) (c_0: class x3 y1):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R crg) (wb (wcel F A2) (wa (wf B2 (co cc0 cpnf cico) F) (wral x3 (wa (wb (wceq (cfv (cv x3) F) cc0) (wceq (cv x3) c_0)) (wral y1 (wa (wceq (cfv (co (cv x3) (cv y1) c_x) F) (co (cfv (cv x3) F) (cfv (cv y1) F) cmul)) (wbr (cfv (co (cv x3) (cv y1) c_pl) F) (co (cfv (cv x3) F) (cfv (cv y1) F) caddc) cle)) B2)) B2))) $;

--| Properties that determine an absolute value. (Contributed by Mario Carneiro, 8-Sep-2014.) (Revised by Mario Carneiro, 4-Dec-2014.)
theorem isabvd {x3 y1: setvar} (ph: wff) (A2 B2 c_pl: class x3 y1) (R: class) (c_x: class x3 y1) (F: class) (c_0: class x3 y1):
  $ wi ph (wceq A2 (cfv R cabv)) $ >
  $ wi ph (wceq B2 (cfv R cbs)) $ >
  $ wi ph (wceq c_pl (cfv R cplusg)) $ >
  $ wi ph (wceq c_x (cfv R cmulr)) $ >
  $ wi ph (wceq c_0 (cfv R c0g)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wf B2 cr F) $ >
  $ wi ph (wceq (cfv c_0 F) cc0) $ >
  $ wi (w3a ph (wcel (cv x3) B2) (wne (cv x3) c_0)) (wbr cc0 (cfv (cv x3) F) clt) $ >
  $ wi (w3a ph (wa (wcel (cv x3) B2) (wne (cv x3) c_0)) (wa (wcel (cv y1) B2) (wne (cv y1) c_0))) (wceq (cfv (co (cv x3) (cv y1) c_x) F) (co (cfv (cv x3) F) (cfv (cv y1) F) cmul)) $ >
  $ wi (w3a ph (wa (wcel (cv x3) B2) (wne (cv x3) c_0)) (wa (wcel (cv y1) B2) (wne (cv y1) c_0))) (wbr (cfv (co (cv x3) (cv y1) c_pl) F) (co (cfv (cv x3) F) (cfv (cv y1) F) caddc) cle) $ >
  $ wi ph (wcel F A2) $;

--| Reverse closure for the absolute value set. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem abvrcl (A2 R F: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wi (wcel F A2) (wcel R crg) $;

--| An absolute value is a function from the ring to the nonnegative real numbers. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem abvfge0 (A2 B2 R F: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel F A2) (wf B2 (co cc0 cpnf cico) F) $;

--| An absolute value is a function from the ring to the real numbers. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem abvf (A2 B2 R F: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel F A2) (wf B2 cr F) $;

--| An absolute value is a function from the ring to the real numbers. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem abvcl (A2 B2 R F X: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wa (wcel F A2) (wcel X B2)) (wcel (cfv X F) cr) $;

--| The absolute value of a number is greater than or equal to zero. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem abvge0 (A2 B2 R F X: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wa (wcel F A2) (wcel X B2)) (wbr cc0 (cfv X F) cle) $;

--| The value of an absolute value is zero iff the argument is zero. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem abveq0 (A2 B2 R F X c_0: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel F A2) (wcel X B2)) (wb (wceq (cfv X F) cc0) (wceq X c_0)) $;

--| The absolute value of a nonzero number is nonzero. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem abvne0 (A2 B2 R F X c_0: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel F A2) (wcel X B2) (wne X c_0)) (wne (cfv X F) cc0) $;

--| The absolute value of a nonzero number is strictly positive. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem abvgt0 (A2 B2 R F X c_0: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel F A2) (wcel X B2) (wne X c_0)) (wbr cc0 (cfv X F) clt) $;

--| An absolute value distributes under multiplication. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem abvmul (A2 B2 R c_x F X Y: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel F A2) (wcel X B2) (wcel Y B2)) (wceq (cfv (co X Y c_x) F) (co (cfv X F) (cfv Y F) cmul)) $;

--| An absolute value satisfies the triangle inequality. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem abvtri (A2 B2 c_pl R F X Y: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (w3a (wcel F A2) (wcel X B2) (wcel Y B2)) (wbr (cfv (co X Y c_pl) F) (co (cfv X F) (cfv Y F) caddc) cle) $;

--| The absolute value of zero is zero. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem abv0 (A2 R F c_0: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel F A2) (wceq (cfv c_0 F) cc0) $;

--| The absolute value of one is one in a non-trivial ring. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem abv1z (A2 R c_1 F c_0: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel F A2) (wne c_1 c_0)) (wceq (cfv c_1 F) c1) $;

--| The absolute value of one is one in a division ring. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem abv1 (A2 R c_1 F: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R cdr) (wcel F A2)) (wceq (cfv c_1 F) c1) $;

--| The absolute value of a negative is the same as that of the positive. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem abvneg (A2 B2 R F N X: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wi (wa (wcel F A2) (wcel X B2)) (wceq (cfv (cfv X N) F) (cfv X F)) $;

--| An absolute value satisfies the triangle inequality. (Contributed by Mario Carneiro, 4-Oct-2015.)
theorem abvsubtri (A2 B2 R F c_mi X Y: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wi (w3a (wcel F A2) (wcel X B2) (wcel Y B2)) (wbr (cfv (co X Y c_mi) F) (co (cfv X F) (cfv Y F) caddc) cle) $;

--| The absolute value distributes under reciprocal. (Contributed by Mario Carneiro, 10-Sep-2014.)
theorem abvrec (A2 B2 R F I X c_0: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wi (wa (wa (wcel R cdr) (wcel F A2)) (wa (wcel X B2) (wne X c_0))) (wceq (cfv (cfv X I) F) (co c1 (cfv X F) cdiv)) $;

--| The absolute value distributes under division. (Contributed by Mario Carneiro, 10-Sep-2014.)
theorem abvdiv (A2 B2 c_dv R F X Y c_0: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wi (wa (wa (wcel R cdr) (wcel F A2)) (w3a (wcel X B2) (wcel Y B2) (wne Y c_0))) (wceq (cfv (co X Y c_dv) F) (co (cfv X F) (cfv Y F) cdiv)) $;

--| Any ring with an absolute value is a domain, which is to say that it contains no zero divisors. (Contributed by Mario Carneiro, 10-Sep-2014.)
theorem abvdom (A2 B2 R c_x F X Y c_0: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel F A2) (wa (wcel X B2) (wne X c_0)) (wa (wcel Y B2) (wne Y c_0))) (wne (co X Y c_x) c_0) $;

--| The restriction of an absolute value to a subring is an absolute value. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem abvres (A2 B2 C R S F: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq S (co R C cress) $ >
  $ wceq B2 (cfv S cabv) $ >
  $ wi (wa (wcel F A2) (wcel C (cfv R csubrg))) (wcel (cres F C) B2) $;

--| The trivial absolute value. (Contributed by Mario Carneiro, 6-May-2015.)
theorem abvtrivd {x3 y1 z: setvar} (ph: wff) (A2: class x3 y1 z) (B2: class y1 z) (R: class) (c_x: class y1 z) (F: class x3) (c_0: class y1 z):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq F (cmpt x3 B2 (cif (wceq (cv x3) c_0) cc0 c1)) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi (w3a ph (wa (wcel (cv y1) B2) (wne (cv y1) c_0)) (wa (wcel (cv z) B2) (wne (cv z) c_0))) (wne (co (cv y1) (cv z) c_x) c_0) $ >
  $ wi ph (wcel F A2) $;

--| The trivial absolute value. This theorem is not true for rings with zero divisors, which violate the multiplication axiom; ~ abvdom is the converse of this theorem. (Contributed by SN, 25-Jun-2025.)
theorem abvtrivg {x3: setvar} (A2: class x3) (B2 R: class) (F: class x3) (c_0: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq F (cmpt x3 B2 (cif (wceq (cv x3) c_0) cc0 c1)) $ >
  $ wi (wcel R cdomn) (wcel F A2) $;

--| The trivial absolute value. (Contributed by Mario Carneiro, 8-Sep-2014.) (Revised by Mario Carneiro, 6-May-2015.)
theorem abvtriv {x3: setvar} (A2: class x3) (B2 R: class) (F: class x3) (c_0: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq F (cmpt x3 B2 (cif (wceq (cv x3) c_0) cc0 c1)) $ >
  $ wi (wcel R cdr) (wcel F A2) $;

--| If two structures have the same ring components, they have the same collection of absolute values. (Contributed by Mario Carneiro, 4-Oct-2015.)
theorem abvpropd {x3 y1: setvar} (ph: wff) (B2 K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi ph (wceq (cfv K cabv) (cfv L cabv)) $;

--| Another characterization of domains, hinted at in ~ abvtrivg : a nonzero ring is a domain iff it has an absolute value. (Contributed by Mario Carneiro, 6-May-2015.)
theorem abvn0b (A2 R: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wb (wcel R cdomn) (wa (wcel R cnzr) (wne A2 c0)) $;

--| Extend class notation with the functionalization of the *-ring involution.
term cstf: class;

--| Extend class notation with class of all *-rings.
term csr: class;

--| Define the functionalization of the involution in a star ring. This is not strictly necessary but by having ` *r ` as an actual function we can state the principal properties of an involution much more cleanly. (Contributed by Mario Carneiro, 6-Oct-2015.)
axiom df_staf {x3 f2: setvar}:
  $ wceq cstf (cmpt f2 cvv (cmpt x3 (cfv (cv f2) cbs) (cfv (cv x3) (cfv (cv f2) cstv)))) $;

--| Define class of all star rings. A star ring is a ring with an involution (conjugation) function. Involution (unlike say the ring zero) is not unique and therefore must be added as a new component to the ring. For example, two possible involutions for complex numbers are the identity function and complex conjugation. Definition of involution in [Holland95] p. 204. (Contributed by NM, 22-Sep-2011.) (Revised by Mario Carneiro, 6-Oct-2015.)
axiom df_srng {f2 i: setvar}:
  $ wceq csr (cab f2 (wsbc i (wa (wcel (cv i) (co (cv f2) (cfv (cv f2) coppr) crh)) (wceq (cv i) (ccnv (cv i)))) (cfv (cv f2) cstf))) $;

--| The functionalization of the involution component of a structure. (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem staffval {x3: setvar} (B2 R: class) (c_xb: class x3) (c_as: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_as (cfv R cstv) $ >
  $ wceq c_xb (cfv R cstf) $ >
  $ wceq c_xb (cmpt x3 B2 (cfv (cv x3) c_as)) $;

--| The functionalization of the involution component of a structure. (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem stafval (A2 B2 R c_xb c_as: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_as (cfv R cstv) $ >
  $ wceq c_xb (cfv R cstf) $ >
  $ wi (wcel A2 B2) (wceq (cfv A2 c_xb) (cfv A2 c_as)) $;

--| The functionalization is equal to the original function, if it is a function on the right base set. (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem staffn (B2 R c_xb c_as: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_as (cfv R cstv) $ >
  $ wceq c_xb (cfv R cstf) $ >
  $ wi (wfn c_as B2) (wceq c_xb c_as) $;

--| The predicate "is a star ring". (Contributed by NM, 22-Sep-2011.) (Revised by Mario Carneiro, 6-Oct-2015.)
theorem issrng (R c_as O: class):
  $ wceq O (cfv R coppr) $ >
  $ wceq c_as (cfv R cstf) $ >
  $ wb (wcel R csr) (wa (wcel c_as (co R O crh)) (wceq c_as (ccnv c_as))) $;

--| The involution function in a star ring is an antiautomorphism. (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem srngrhm (R c_as O: class):
  $ wceq O (cfv R coppr) $ >
  $ wceq c_as (cfv R cstf) $ >
  $ wi (wcel R csr) (wcel c_as (co R O crh)) $;

--| A star ring is a ring. (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem srngring (R: class):
  $ wi (wcel R csr) (wcel R crg) $;

--| The involution function in a star ring is its own inverse function. (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem srngcnv (R c_as: class):
  $ wceq c_as (cfv R cstf) $ >
  $ wi (wcel R csr) (wceq c_as (ccnv c_as)) $;

--| The involution function in a star ring is a bijection. (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem srngf1o (B2 R c_as: class):
  $ wceq c_as (cfv R cstf) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R csr) (wf1o B2 B2 c_as) $;

--| The involution function in a star ring is closed in the ring. (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem srngcl (B2 R c_as X: class):
  $ wceq c_as (cfv R cstv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wa (wcel R csr) (wcel X B2)) (wcel (cfv X c_as) B2) $;

--| The involution function in a star ring is an involution. (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem srngnvl (B2 R c_as X: class):
  $ wceq c_as (cfv R cstv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wa (wcel R csr) (wcel X B2)) (wceq (cfv (cfv X c_as) c_as) X) $;

--| The involution function in a star ring distributes over addition. (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem srngadd (B2 c_pl R c_as X Y: class):
  $ wceq c_as (cfv R cstv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (w3a (wcel R csr) (wcel X B2) (wcel Y B2)) (wceq (cfv (co X Y c_pl) c_as) (co (cfv X c_as) (cfv Y c_as) c_pl)) $;

--| The involution function in a star ring distributes over multiplication, with a change in the order of the factors. (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem srngmul (B2 R c_x c_as X Y: class):
  $ wceq c_as (cfv R cstv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R csr) (wcel X B2) (wcel Y B2)) (wceq (cfv (co X Y c_x) c_as) (co (cfv Y c_as) (cfv X c_as) c_x)) $;

--| The conjugate of the ring identity is the identity. (This is sometimes taken as an axiom, and indeed the proof here follows because we defined ` *r ` to be a ring homomorphism, which preserves 1; nevertheless, it is redundant, as can be seen from the proof of ~ issrngd .) (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem srng1 (R c_1 c_as: class):
  $ wceq c_as (cfv R cstv) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R csr) (wceq (cfv c_1 c_as) c_1) $;

--| The conjugate of the ring zero is zero. (Contributed by Mario Carneiro, 7-Oct-2015.)
theorem srng0 (R c_as c_0: class):
  $ wceq c_as (cfv R cstv) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R csr) (wceq (cfv c_0 c_as) c_0) $;

--| Properties that determine a star ring. (Contributed by Mario Carneiro, 18-Nov-2013.) (Revised by Mario Carneiro, 6-Oct-2015.)
theorem issrngd {x3 y1: setvar} (ph: wff) (c_pl: class x3 y1) (R: class) (c_x c_as: class x3 y1) (K: class):
  $ wi ph (wceq K (cfv R cbs)) $ >
  $ wi ph (wceq c_pl (cfv R cplusg)) $ >
  $ wi ph (wceq c_x (cfv R cmulr)) $ >
  $ wi ph (wceq c_as (cfv R cstv)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi (wa ph (wcel (cv x3) K)) (wcel (cfv (cv x3) c_as) K) $ >
  $ wi (w3a ph (wcel (cv x3) K) (wcel (cv y1) K)) (wceq (cfv (co (cv x3) (cv y1) c_pl) c_as) (co (cfv (cv x3) c_as) (cfv (cv y1) c_as) c_pl)) $ >
  $ wi (w3a ph (wcel (cv x3) K) (wcel (cv y1) K)) (wceq (cfv (co (cv x3) (cv y1) c_x) c_as) (co (cfv (cv y1) c_as) (cfv (cv x3) c_as) c_x)) $ >
  $ wi (wa ph (wcel (cv x3) K)) (wceq (cfv (cfv (cv x3) c_as) c_as) (cv x3)) $ >
  $ wi ph (wcel R csr) $;

--| A commutative ring is a star ring when the conjugate operation is the identity. (Contributed by Thierry Arnoux, 19-Apr-2019.)
theorem idsrngd {x3: setvar} (ph: wff) (B2 R c_as: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_as (cfv R cstv) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wceq (cfv (cv x3) c_as) (cv x3)) $ >
  $ wi ph (wcel R csr) $;

--| Extend class notation with the class of all ordered rings.
term corng: class;

--| Extend class notation with the class of all ordered fields.
term cofld: class;

--| Define class of all ordered rings. An ordered ring is a ring with a total ordering compatible with its operations. (Contributed by Thierry Arnoux, 23-Mar-2018.)
axiom df_orng {z v t r a b l: setvar}:
  $ wceq corng (crab r (wsbc v (wsbc z (wsbc t (wsbc l (wral a (wral b (wi (wa (wbr (cv z) (cv a) (cv l)) (wbr (cv z) (cv b) (cv l))) (wbr (cv z) (co (cv a) (cv b) (cv t)) (cv l))) (cv v)) (cv v)) (cfv (cv r) cple)) (cfv (cv r) cmulr)) (cfv (cv r) c0g)) (cfv (cv r) cbs)) (cin crg cogrp)) $;

--| Define class of all ordered fields. An ordered field is a field with a total ordering compatible with its operations. (Contributed by Thierry Arnoux, 18-Jan-2018.)
axiom df_ofld:
  $ wceq cofld (cin cfield corng) $;

--| An ordered ring is a ring with a total ordering compatible with its operations. (Contributed by Thierry Arnoux, 18-Jan-2018.)
theorem isorng {a b: setvar} (B2 R: class) (c_x c_le c_0: class a b):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_le (cfv R cple) $ >
  $ wb (wcel R corng) (w3a (wcel R crg) (wcel R cogrp) (wral a (wral b (wi (wa (wbr c_0 (cv a) c_le) (wbr c_0 (cv b) c_le)) (wbr c_0 (co (cv a) (cv b) c_x) c_le)) B2) B2)) $;

--| An ordered ring is a ring. (Contributed by Thierry Arnoux, 23-Mar-2018.)
theorem orngring (R: class):
  $ wi (wcel R corng) (wcel R crg) $;

--| An ordered ring is an ordered group. (Contributed by Thierry Arnoux, 23-Mar-2018.)
theorem orngogrp (R: class):
  $ wi (wcel R corng) (wcel R cogrp) $;

--| An ordered field is a field with a total ordering compatible with its operations. (Contributed by Thierry Arnoux, 23-Mar-2018.)
theorem isofld (F: class):
  $ wb (wcel F cofld) (wa (wcel F cfield) (wcel F corng)) $;

--| In an ordered ring, the ordering is compatible with the ring multiplication operation. (Contributed by Thierry Arnoux, 20-Jan-2018.)
theorem orngmul (B2 R c_x c_le X Y c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_le (cfv R cple) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R corng) (wa (wcel X B2) (wbr c_0 X c_le)) (wa (wcel Y B2) (wbr c_0 Y c_le))) (wbr c_0 (co X Y c_x) c_le) $;

--| In an ordered ring, all squares are positive. (Contributed by Thierry Arnoux, 20-Jan-2018.)
theorem orngsqr (B2 R c_x c_le X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_le (cfv R cple) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R corng) (wcel X B2)) (wbr c_0 (co X X c_x) c_le) $;

--| In an ordered ring, multiplication with a positive does not change comparison. (Contributed by Thierry Arnoux, 10-Apr-2018.)
theorem ornglmulle (ph: wff) (B2 R c_x c_le X Y c_0 Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R corng) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wceq c_le (cfv R cple) $ >
  $ wi ph (wbr X Y c_le) $ >
  $ wi ph (wbr c_0 Z c_le) $ >
  $ wi ph (wbr (co Z X c_x) (co Z Y c_x) c_le) $;

--| In an ordered ring, multiplication with a positive does not change comparison. (Contributed by Thierry Arnoux, 10-Apr-2018.)
theorem orngrmulle (ph: wff) (B2 R c_x c_le X Y c_0 Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R corng) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wceq c_le (cfv R cple) $ >
  $ wi ph (wbr X Y c_le) $ >
  $ wi ph (wbr c_0 Z c_le) $ >
  $ wi ph (wbr (co X Z c_x) (co Y Z c_x) c_le) $;

--| In an ordered ring, multiplication with a positive does not change strict comparison. (Contributed by Thierry Arnoux, 9-Apr-2018.)
theorem ornglmullt (ph: wff) (B2 R c_lt c_x X Y c_0 Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R corng) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wceq c_lt (cfv R cplt) $ >
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wbr X Y c_lt) $ >
  $ wi ph (wbr c_0 Z c_lt) $ >
  $ wi ph (wbr (co Z X c_x) (co Z Y c_x) c_lt) $;

--| In an ordered ring, multiplication with a positive does not change strict comparison. (Contributed by Thierry Arnoux, 9-Apr-2018.)
theorem orngrmullt (ph: wff) (B2 R c_lt c_x X Y c_0 Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R corng) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wceq c_lt (cfv R cplt) $ >
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wbr X Y c_lt) $ >
  $ wi ph (wbr c_0 Z c_lt) $ >
  $ wi ph (wbr (co X Z c_x) (co Y Z c_x) c_lt) $;

--| In an ordered ring, the strict ordering is compatible with the ring multiplication operation. (Contributed by Thierry Arnoux, 9-Sep-2018.)
theorem orngmullt (ph: wff) (B2 R c_lt c_x X Y c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_lt (cfv R cplt) $ >
  $ wi ph (wcel R corng) $ >
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wbr c_0 X c_lt) $ >
  $ wi ph (wbr c_0 Y c_lt) $ >
  $ wi ph (wbr c_0 (co X Y c_x) c_lt) $;

--| An ordered field is a field. (Contributed by Thierry Arnoux, 20-Jan-2018.)
theorem ofldfld (F: class):
  $ wi (wcel F cofld) (wcel F cfield) $;

--| An ordered field is a totally ordered set. (Contributed by Thierry Arnoux, 20-Jan-2018.)
theorem ofldtos (F: class):
  $ wi (wcel F cofld) (wcel F ctos) $;

--| In an ordered ring, the ring unity is positive. (Contributed by Thierry Arnoux, 21-Jan-2018.)
theorem orng0le1 (c_1 F c_le c_0: class):
  $ wceq c_0 (cfv F c0g) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ wceq c_le (cfv F cple) $ >
  $ wi (wcel F corng) (wbr c_0 c_1 c_le) $;

--| In an ordered field, the ring unity is strictly positive. (Contributed by Thierry Arnoux, 21-Jan-2018.)
theorem ofldlt1 (c_lt c_1 F c_0: class):
  $ wceq c_0 (cfv F c0g) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ wceq c_lt (cfv F cplt) $ >
  $ wi (wcel F cofld) (wbr c_0 c_1 c_lt) $;

--| Every subring of an ordered ring is also an ordered ring. (Contributed by Thierry Arnoux, 21-Jan-2018.)
theorem suborng (A2 R: class):
  $ wi (wa (wcel R corng) (wcel (co R A2 cress) crg)) (wcel (co R A2 cress) corng) $;

--| Every subfield of an ordered field is also an ordered field. (Contributed by Thierry Arnoux, 21-Jan-2018.)
theorem subofld (A2 F: class):
  $ wi (wa (wcel F cofld) (wcel (co F A2 cress) cfield)) (wcel (co F A2 cress) cofld) $;

--| Extend class notation with class of all left modules.
term clmod: class;

--| The functionalization of the scalar multiplication operation.
term cscaf: class;

--| Define the class of all left modules, which are generalizations of left vector spaces. A left module over a ring is an (Abelian) group (vectors) together with a ring (scalars) and a left scalar product connecting them. (Contributed by NM, 4-Nov-2013.)
axiom df_lmod {x3 w v t f2 g2 k s1 r q p a: setvar}:
  $ wceq clmod (crab g2 (wsbc v (wsbc a (wsbc f2 (wsbc s1 (wsbc k (wsbc p (wsbc t (wa (wcel (cv f2) crg) (wral q (wral r (wral x3 (wral w (wa (w3a (wcel (co (cv r) (cv w) (cv s1)) (cv v)) (wceq (co (cv r) (co (cv w) (cv x3) (cv a)) (cv s1)) (co (co (cv r) (cv w) (cv s1)) (co (cv r) (cv x3) (cv s1)) (cv a))) (wceq (co (co (cv q) (cv r) (cv p)) (cv w) (cv s1)) (co (co (cv q) (cv w) (cv s1)) (co (cv r) (cv w) (cv s1)) (cv a)))) (wa (wceq (co (co (cv q) (cv r) (cv t)) (cv w) (cv s1)) (co (cv q) (co (cv r) (cv w) (cv s1)) (cv s1))) (wceq (co (cfv (cv f2) cur) (cv w) (cv s1)) (cv w)))) (cv v)) (cv v)) (cv k)) (cv k))) (cfv (cv f2) cmulr)) (cfv (cv f2) cplusg)) (cfv (cv f2) cbs)) (cfv (cv g2) cvsca)) (cfv (cv g2) csca)) (cfv (cv g2) cplusg)) (cfv (cv g2) cbs)) cgrp) $;

--| Define the functionalization of the ` .s ` operator. This restricts the value of ` .s ` to the stated domain, which is necessary when working with restricted structures, whose operations may be defined on a larger set than the true base. (Contributed by Mario Carneiro, 5-Oct-2015.)
axiom df_scaf {x3 y1 g2: setvar}:
  $ wceq cscaf (cmpt g2 cvv (cmpo x3 y1 (cfv (cfv (cv g2) csca) cbs) (cfv (cv g2) cbs) (co (cv x3) (cv y1) (cfv (cv g2) cvsca)))) $;

--| The predicate "is a left module". (Contributed by NM, 4-Nov-2013.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem islmod {x3 w r q: setvar} (c_pl c_pd c_x c_xp c_1 F K V: class) (W: class x3 w r q):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_pd (cfv F cplusg) $ >
  $ wceq c_xp (cfv F cmulr) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ wb (wcel W clmod) (w3a (wcel W cgrp) (wcel F crg) (wral q (wral r (wral x3 (wral w (wa (w3a (wcel (co (cv r) (cv w) c_x) V) (wceq (co (cv r) (co (cv w) (cv x3) c_pl) c_x) (co (co (cv r) (cv w) c_x) (co (cv r) (cv x3) c_x) c_pl)) (wceq (co (co (cv q) (cv r) c_pd) (cv w) c_x) (co (co (cv q) (cv w) c_x) (co (cv r) (cv w) c_x) c_pl))) (wa (wceq (co (co (cv q) (cv r) c_xp) (cv w) c_x) (co (cv q) (co (cv r) (cv w) c_x) c_x)) (wceq (co c_1 (cv w) c_x) (cv w)))) V) V) K) K)) $;

--| Lemma for properties of a left module. (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodlema (c_pl c_pd Q R c_x c_xp c_1 F K V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_pd (cfv F cplusg) $ >
  $ wceq c_xp (cfv F cmulr) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ wi (w3a (wcel W clmod) (wa (wcel Q K) (wcel R K)) (wa (wcel X V) (wcel Y V))) (wa (w3a (wcel (co R Y c_x) V) (wceq (co R (co Y X c_pl) c_x) (co (co R Y c_x) (co R X c_x) c_pl)) (wceq (co (co Q R c_pd) Y c_x) (co (co Q Y c_x) (co R Y c_x) c_pl))) (wa (wceq (co (co Q R c_xp) Y c_x) (co Q (co R Y c_x) c_x)) (wceq (co c_1 Y c_x) Y))) $;

--| Properties that determine a left module. See note in ~ isgrpd2 regarding the ` ph ` on hypotheses that name structure components. (Contributed by Mario Carneiro, 22-Jun-2014.)
theorem islmodd {x3 y1 z: setvar} (ph: wff) (B2 c_pl: class) (c_pd: class x3) (c_x: class) (c_xp: class x3) (c_1: class y1 z) (F: class x3 y1 z) (V: class) (W: class y1 z):
  $ wi ph (wceq V (cfv W cbs)) $ >
  $ wi ph (wceq c_pl (cfv W cplusg)) $ >
  $ wi ph (wceq F (cfv W csca)) $ >
  $ wi ph (wceq c_x (cfv W cvsca)) $ >
  $ wi ph (wceq B2 (cfv F cbs)) $ >
  $ wi ph (wceq c_pd (cfv F cplusg)) $ >
  $ wi ph (wceq c_xp (cfv F cmulr)) $ >
  $ wi ph (wceq c_1 (cfv F cur)) $ >
  $ wi ph (wcel F crg) $ >
  $ wi ph (wcel W cgrp) $ >
  $ wi (w3a ph (wcel (cv x3) B2) (wcel (cv y1) V)) (wcel (co (cv x3) (cv y1) c_x) V) $ >
  $ wi (wa ph (w3a (wcel (cv x3) B2) (wcel (cv y1) V) (wcel (cv z) V))) (wceq (co (cv x3) (co (cv y1) (cv z) c_pl) c_x) (co (co (cv x3) (cv y1) c_x) (co (cv x3) (cv z) c_x) c_pl)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) B2) (wcel (cv y1) B2) (wcel (cv z) V))) (wceq (co (co (cv x3) (cv y1) c_pd) (cv z) c_x) (co (co (cv x3) (cv z) c_x) (co (cv y1) (cv z) c_x) c_pl)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) B2) (wcel (cv y1) B2) (wcel (cv z) V))) (wceq (co (co (cv x3) (cv y1) c_xp) (cv z) c_x) (co (cv x3) (co (cv y1) (cv z) c_x) c_x)) $ >
  $ wi (wa ph (wcel (cv x3) V)) (wceq (co c_1 (cv x3) c_x) (cv x3)) $ >
  $ wi ph (wcel W clmod) $;

--| A left module is a group. (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 25-Jun-2014.)
theorem lmodgrp (W: class):
  $ wi (wcel W clmod) (wcel W cgrp) $;

--| The scalar component of a left module is a ring. (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodring (F W: class):
  $ wceq F (cfv W csca) $ >
  $ wi (wcel W clmod) (wcel F crg) $;

--| The scalar component of a left module is an additive group. (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodfgrp (F W: class):
  $ wceq F (cfv W csca) $ >
  $ wi (wcel W clmod) (wcel F cgrp) $;

--| A left module is a group. (Contributed by SN, 16-May-2024.)
theorem lmodgrpd (ph: wff) (W: class):
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel W cgrp) $;

--| The base set of a left module is nonempty. (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodbn0 (B2 W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wi (wcel W clmod) (wne B2 c0) $;

--| Closure of ring addition for a left module. (Contributed by NM, 14-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodacl (c_pl F K W X Y: class):
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_pl (cfv F cplusg) $ >
  $ wi (w3a (wcel W clmod) (wcel X K) (wcel Y K)) (wcel (co X Y c_pl) K) $;

--| Closure of ring multiplication for a left module. (Contributed by NM, 14-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodmcl (c_x F K W X Y: class):
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_x (cfv F cmulr) $ >
  $ wi (w3a (wcel W clmod) (wcel X K) (wcel Y K)) (wcel (co X Y c_x) K) $;

--| The set of scalars in a left module is nonempty. (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodsn0 (B2 F W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi (wcel W clmod) (wne B2 c0) $;

--| Closure of vector addition for a left module. (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodvacl (c_pl V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wi (w3a (wcel W clmod) (wcel X V) (wcel Y V)) (wcel (co X Y c_pl) V) $;

--| Left module vector sum is associative. (Contributed by NM, 10-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodass (c_pl V W X Y Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wi (wa (wcel W clmod) (w3a (wcel X V) (wcel Y V) (wcel Z V))) (wceq (co (co X Y c_pl) Z c_pl) (co X (co Y Z c_pl) c_pl)) $;

--| Left cancellation law for vector sum. (Contributed by NM, 12-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodlcan (c_pl V W X Y Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wi (wa (wcel W clmod) (w3a (wcel X V) (wcel Y V) (wcel Z V))) (wb (wceq (co Z X c_pl) (co Z Y c_pl)) (wceq X Y)) $;

--| Closure of scalar product for a left module. ( ~ hvmulcl analog.) (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodvscl (R c_x F K V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wi (w3a (wcel W clmod) (wcel R K) (wcel X V)) (wcel (co R X c_x) V) $;

--| Closure of scalar product for a left module. (Contributed by SN, 15-Mar-2025.)
theorem lmodvscld (ph: wff) (R c_x F K V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel R K) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel (co R X c_x) V) $;

--| The scalar multiplication operation as a function. (Contributed by Mario Carneiro, 5-Oct-2015.) (Proof shortened by AV, 2-Mar-2024.)
theorem scaffval {x3 y1: setvar} (B2: class) (c_xb: class x3 y1) (c_x: class) (F: class x3 y1) (K W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_xb (cfv W cscaf) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_xb (cmpo x3 y1 K B2 (co (cv x3) (cv y1) c_x)) $;

--| The scalar multiplication operation as a function. (Contributed by Mario Carneiro, 5-Oct-2015.)
theorem scafval (B2 c_xb c_x F K W X Y: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_xb (cfv W cscaf) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wi (wa (wcel X K) (wcel Y B2)) (wceq (co X Y c_xb) (co X Y c_x)) $;

--| If the scalar multiplication operation is already a function, the functionalization of it is equal to the original operation. (Contributed by Mario Carneiro, 5-Oct-2015.)
theorem scafeq (B2 c_xb c_x F K W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_xb (cfv W cscaf) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wi (wfn c_x (cxp K B2)) (wceq c_xb c_x) $;

--| The scalar multiplication operation is a function. (Contributed by Mario Carneiro, 5-Oct-2015.)
theorem scaffn (B2 c_xb F K W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_xb (cfv W cscaf) $ >
  $ wfn c_xb (cxp K B2) $;

--| The scalar multiplication operation is a function. (Contributed by Mario Carneiro, 5-Oct-2015.)
theorem lmodscaf (B2 c_xb F K W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_xb (cfv W cscaf) $ >
  $ wi (wcel W clmod) (wf (cxp K B2) B2 c_xb) $;

--| Distributive law for scalar product (left-distributivity). ( ~ ax-hvdistr1 analog.) (Contributed by NM, 10-Jan-2014.) (Revised by Mario Carneiro, 22-Sep-2015.)
theorem lmodvsdi (c_pl R c_x F K V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wi (wa (wcel W clmod) (w3a (wcel R K) (wcel X V) (wcel Y V))) (wceq (co R (co X Y c_pl) c_x) (co (co R X c_x) (co R Y c_x) c_pl)) $;

--| Distributive law for scalar product (right-distributivity). ( ~ ax-hvdistr1 analog.) (Contributed by NM, 10-Jan-2014.) (Revised by Mario Carneiro, 22-Sep-2015.)
theorem lmodvsdir (c_pl c_pd Q R c_x F K V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_pd (cfv F cplusg) $ >
  $ wi (wa (wcel W clmod) (w3a (wcel Q K) (wcel R K) (wcel X V))) (wceq (co (co Q R c_pd) X c_x) (co (co Q X c_x) (co R X c_x) c_pl)) $;

--| In a module, scalar multiplication is a semigroup action. ( ~ ax-hvmulass analog.) (Contributed by NM, 10-Jan-2014.) (Revised by Mario Carneiro, 22-Sep-2015.)
theorem lmodvsass (Q R c_x c_xp F K V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_xp (cfv F cmulr) $ >
  $ wi (wa (wcel W clmod) (w3a (wcel Q K) (wcel R K) (wcel X V))) (wceq (co (co Q R c_xp) X c_x) (co Q (co R X c_x) c_x)) $;

--| The ring zero in a left module belongs to the set of scalars. (Contributed by NM, 11-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmod0cl (F K W c_0: class):
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wi (wcel W clmod) (wcel c_0 K) $;

--| The ring unity in a left module belongs to the set of scalars. (Contributed by NM, 11-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmod1cl (c_1 F K W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ wi (wcel W clmod) (wcel c_1 K) $;

--| Scalar product with the ring unity. ( ~ ax-hvmulid analog.) (Contributed by NM, 10-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodvs1 (c_x c_1 F V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ wi (wa (wcel W clmod) (wcel X V)) (wceq (co c_1 X c_x) X) $;

--| The zero vector is a vector. ( ~ ax-hv0cl analog.) (Contributed by NM, 10-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmod0vcl (V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wcel W clmod) (wcel c_0 V) $;

--| Left identity law for the zero vector. ( ~ hvaddlid analog.) (Contributed by NM, 10-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmod0vlid (c_pl V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wa (wcel W clmod) (wcel X V)) (wceq (co c_0 X c_pl) X) $;

--| Right identity law for the zero vector. ( ~ ax-hvaddid analog.) (Contributed by NM, 10-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmod0vrid (c_pl V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wa (wcel W clmod) (wcel X V)) (wceq (co X c_0 c_pl) X) $;

--| Identity equivalent to the value of the zero vector. Provides a convenient way to compute the value. (Contributed by NM, 9-Mar-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmod0vid (c_pl V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wa (wcel W clmod) (wcel X V)) (wb (wceq (co X X c_pl) X) (wceq c_0 X)) $;

--| Zero times a vector is the zero vector. Equation 1a of [Kreyszig] p. 51. ( ~ ax-hvmul0 analog.) (Contributed by NM, 12-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmod0vs (c_x F O V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq O (cfv F c0g) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wa (wcel W clmod) (wcel X V)) (wceq (co O X c_x) c_0) $;

--| Anything times the zero vector is the zero vector. Equation 1b of [Kreyszig] p. 51. ( ~ hvmul0 analog.) (Contributed by NM, 12-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodvs0 (c_x F K W X c_0: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wa (wcel W clmod) (wcel X K)) (wceq (co X c_0 c_x) c_0) $;

--| Distributive law for a group multiple of a scalar multiplication. (Contributed by AV, 2-Sep-2019.)
theorem lmodvsmmulgdi (C c_x E c_ex F K N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_ex (cfv W cmg) $ >
  $ wceq E (cfv F cmg) $ >
  $ wi (wa (wcel W clmod) (w3a (wcel C K) (wcel N cn0) (wcel X V))) (wceq (co N (co C X c_x) c_ex) (co (co N C E) X c_x)) $;

--| Lemma 1 for ~ lmodfopne . (Contributed by AV, 2-Oct-2021.)
theorem lmodfopnelem1 (c_pl S c_x K V W: class):
  $ wceq c_x (cfv W cscaf) $ >
  $ wceq c_pl (cfv W cplusf) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W csca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wi (wa (wcel W clmod) (wceq c_pl c_x)) (wceq V K) $;

--| Lemma 2 for ~ lmodfopne . (Contributed by AV, 2-Oct-2021.)
theorem lmodfopnelem2 (c_pl S c_x c_1 K V W c_0: class):
  $ wceq c_x (cfv W cscaf) $ >
  $ wceq c_pl (cfv W cplusf) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W csca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq c_1 (cfv S cur) $ >
  $ wi (wa (wcel W clmod) (wceq c_pl c_x)) (wa (wcel c_0 V) (wcel c_1 V)) $;

--| The (functionalized) operations of a left module (over a nonzero ring) cannot be identical. (Contributed by NM, 31-May-2008.) (Revised by AV, 2-Oct-2021.)
theorem lmodfopne (c_pl S c_x c_1 K V W c_0: class):
  $ wceq c_x (cfv W cscaf) $ >
  $ wceq c_pl (cfv W cplusf) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W csca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq c_1 (cfv S cur) $ >
  $ wi (wa (wcel W clmod) (wne c_1 c_0)) (wne c_pl c_x) $;

--| A linear-combination sum is a function. (Contributed by Stefan O'Rear, 28-Feb-2015.)
theorem lcomf (ph: wff) (B2 c_x F G H I K V W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wf I K G) $ >
  $ wi ph (wf I B2 H) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wf I B2 (co G H (cof c_x))) $;

--| A linear-combination sum is finitely supported if the coefficients are. (Contributed by Stefan O'Rear, 28-Feb-2015.) (Revised by AV, 15-Jul-2019.)
theorem lcomfsupp (ph: wff) (B2 c_x F G H I K V W Y c_0: class):
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wf I K G) $ >
  $ wi ph (wf I B2 H) $ >
  $ wi ph (wcel I V) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq Y (cfv F c0g) $ >
  $ wi ph (wbr G Y cfsupp) $ >
  $ wi ph (wbr (co G H (cof c_x)) c_0 cfsupp) $;

--| Closure of vector negative. (Contributed by NM, 18-Apr-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodvnegcl (N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W cminusg) $ >
  $ wi (wa (wcel W clmod) (wcel X V)) (wcel (cfv X N) V) $;

--| Addition of a vector with its negative. (Contributed by NM, 18-Apr-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodvnegid (c_pl N V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W cminusg) $ >
  $ wi (wa (wcel W clmod) (wcel X V)) (wceq (co X (cfv X N) c_pl) c_0) $;

--| Minus 1 times a vector is the negative of the vector. Equation 2 of [Kreyszig] p. 51. (Contributed by NM, 18-Apr-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodvneg1 (c_x c_1 F M N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W cminusg) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ wceq M (cfv F cminusg) $ >
  $ wi (wa (wcel W clmod) (wcel X V)) (wceq (co (cfv c_1 M) X c_x) (cfv X N)) $;

--| Multiplication of a vector by a negated scalar. (Contributed by Stefan O'Rear, 28-Feb-2015.)
theorem lmodvsneg (ph: wff) (B2 R c_x F K M N W X: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq N (cfv W cminusg) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq M (cfv F cminusg) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel R K) $ >
  $ wi ph (wceq (cfv (co R X c_x) N) (co (cfv R M) X c_x)) $;

--| Closure of vector subtraction. ( ~ hvsubcl analog.) (Contributed by NM, 31-Mar-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodvsubcl (c_mi V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wi (w3a (wcel W clmod) (wcel X V) (wcel Y V)) (wcel (co X Y c_mi) V) $;

--| Left module vector sum is commutative. (Contributed by G&eacute;rard Lang, 25-Jun-2014.)
theorem lmodcom (c_pl V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wi (w3a (wcel W clmod) (wcel X V) (wcel Y V)) (wceq (co X Y c_pl) (co Y X c_pl)) $;

--| A left module is an abelian group (of vectors, under addition). (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 25-Jun-2014.)
theorem lmodabl (W: class):
  $ wi (wcel W clmod) (wcel W cabl) $;

--| A left module is a commutative monoid under addition. (Contributed by NM, 7-Jan-2015.)
theorem lmodcmn (W: class):
  $ wi (wcel W clmod) (wcel W ccmn) $;

--| Distribute negation through addition of scalar products. (Contributed by NM, 9-Apr-2015.)
theorem lmodnegadd (ph: wff) (A2 B2 c_pl R c_x I K N V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq N (cfv W cminusg) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq I (cfv R cminusg) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wcel B2 K) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wceq (cfv (co (co A2 X c_x) (co B2 Y c_x) c_pl) N) (co (co (cfv A2 I) X c_x) (co (cfv B2 I) Y c_x) c_pl)) $;

--| Commutative/associative law for left module vector sum. (Contributed by NM, 4-Feb-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmod4 (c_pl U V W X Y Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wi (w3a (wcel W clmod) (wa (wcel X V) (wcel Y V)) (wa (wcel Z V) (wcel U V))) (wceq (co (co X Y c_pl) (co Z U c_pl) c_pl) (co (co X Z c_pl) (co Y U c_pl) c_pl)) $;

--| Relationship between vector subtraction and addition. ( ~ hvsubadd analog.) (Contributed by NM, 31-Mar-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodvsubadd (A2 B2 C c_pl c_mi V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wi (wa (wcel W clmod) (w3a (wcel A2 V) (wcel B2 V) (wcel C V))) (wb (wceq (co A2 B2 c_mi) C) (wceq (co B2 C c_pl) A2)) $;

--| Vector addition/subtraction law. (Contributed by NM, 31-Mar-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodvaddsub4 (A2 B2 C D c_pl c_mi V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wi (w3a (wcel W clmod) (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) (wb (wceq (co A2 B2 c_pl) (co C D c_pl)) (wceq (co A2 C c_mi) (co D B2 c_mi))) $;

--| Addition/subtraction cancellation law for vectors. ( ~ hvpncan analog.) (Contributed by NM, 16-Apr-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodvpncan (A2 B2 c_pl c_mi V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wi (w3a (wcel W clmod) (wcel A2 V) (wcel B2 V)) (wceq (co (co A2 B2 c_pl) B2 c_mi) A2) $;

--| Cancellation law for vector subtraction ( ~ npcan analog). (Contributed by NM, 19-Apr-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodvnpcan (A2 B2 c_pl c_mi V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wi (w3a (wcel W clmod) (wcel A2 V) (wcel B2 V)) (wceq (co (co A2 B2 c_mi) B2 c_pl) A2) $;

--| Value of vector subtraction in terms of addition. ( ~ hvsubval analog.) (Contributed by NM, 31-Mar-2014.) (Proof shortened by Mario Carneiro, 19-Jun-2014.)
theorem lmodvsubval2 (A2 B2 c_pl c_x c_1 F c_mi N V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq N (cfv F cminusg) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ wi (w3a (wcel W clmod) (wcel A2 V) (wcel B2 V)) (wceq (co A2 B2 c_mi) (co A2 (co (cfv c_1 N) B2 c_x) c_pl)) $;

--| Subtraction of a scalar product in terms of addition. (Contributed by NM, 9-Apr-2015.)
theorem lmodsubvs (ph: wff) (A2 c_pl c_x F K c_mi N V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq N (cfv F cminusg) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wceq (co X (co A2 Y c_x) c_mi) (co X (co (cfv A2 N) Y c_x) c_pl)) $;

--| Scalar multiplication distributive law for subtraction. ( ~ hvsubdistr1 analogue, with longer proof since our scalar multiplication is not commutative.) (Contributed by NM, 2-Jul-2014.)
theorem lmodsubdi (ph: wff) (A2 c_x F K c_mi V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wceq (co A2 (co X Y c_mi) c_x) (co (co A2 X c_x) (co A2 Y c_x) c_mi)) $;

--| Scalar multiplication distributive law for subtraction. ( ~ hvsubdistr2 analog.) (Contributed by NM, 2-Jul-2014.)
theorem lmodsubdir (ph: wff) (A2 B2 S c_x F K c_mi V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wceq S (cfv F csg) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wcel B2 K) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (co (co A2 B2 S) X c_x) (co (co A2 X c_x) (co B2 X c_x) c_mi)) $;

--| If the difference between two vectors is zero, they are equal. ( ~ hvsubeq0 analog.) (Contributed by NM, 31-Mar-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodsubeq0 (A2 B2 c_mi V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wi (w3a (wcel W clmod) (wcel A2 V) (wcel B2 V)) (wb (wceq (co A2 B2 c_mi) c_0) (wceq A2 B2)) $;

--| Subtraction of a vector from itself. ( ~ hvsubid analog.) (Contributed by NM, 16-Apr-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lmodsubid (A2 c_mi V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wi (wa (wcel W clmod) (wcel A2 V)) (wceq (co A2 A2 c_mi) c_0) $;

--| Scalar multiplication of the vector space by a fixed scalar is an endomorphism of the additive group of vectors. (Contributed by Mario Carneiro, 5-May-2015.)
theorem lmodvsghm {x3: setvar} (R c_x: class) (F: class x3) (K V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wi (wa (wcel W clmod) (wcel R K)) (wcel (cmpt x3 V (co R (cv x3) c_x)) (co W W cghm)) $;

--| If two structures have the same components (properties), one is a left module iff the other one is. This version of ~ lmodpropd also breaks up the components of the scalar ring. (Contributed by Mario Carneiro, 27-Jun-2015.)
theorem lmodprop2d {x3 y1: setvar} (ph: wff) (B2 P F G K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wceq F (cfv K csca) $ >
  $ wceq G (cfv L csca) $ >
  $ wi ph (wceq P (cfv F cbs)) $ >
  $ wi ph (wceq P (cfv G cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) P))) (wceq (co (cv x3) (cv y1) (cfv F cplusg)) (co (cv x3) (cv y1) (cfv G cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) P))) (wceq (co (cv x3) (cv y1) (cfv F cmulr)) (co (cv x3) (cv y1) (cfv G cmulr))) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cvsca)) (co (cv x3) (cv y1) (cfv L cvsca))) $ >
  $ wi ph (wb (wcel K clmod) (wcel L clmod)) $;

--| If two structures have the same components (properties), one is a left module iff the other one is. (Contributed by Mario Carneiro, 8-Feb-2015.) (Revised by Mario Carneiro, 27-Jun-2015.)
theorem lmodpropd {x3 y1: setvar} (ph: wff) (B2 P: class) (F: class x3 y1) (K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi ph (wceq F (cfv K csca)) $ >
  $ wi ph (wceq F (cfv L csca)) $ >
  $ wceq P (cfv F cbs) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cvsca)) (co (cv x3) (cv y1) (cfv L cvsca))) $ >
  $ wi ph (wb (wcel K clmod) (wcel L clmod)) $;

--| Pull a scalar multiplication out of a sum of vectors. This theorem properly generalizes ~ gsummulc2 , since every ring is a left module over itself. (Contributed by Stefan O'Rear, 6-Feb-2015.) (Revised by Mario Carneiro, 5-May-2015.) (Revised by AV, 10-Jul-2019.)
theorem gsumvsmul {k: setvar} (ph: wff) (A2 B2: class) (c_pl R: class k) (S c_x K: class) (V: class k) (X: class) (Y: class k) (c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq S (cfv R csca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cvsca) $ >
  $ wi ph (wcel R clmod) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel X K) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel Y B2) $ >
  $ wi ph (wbr (cmpt k A2 Y) c_0 cfsupp) $ >
  $ wi ph (wceq (co R (cmpt k A2 (co X Y c_x)) cgsu) (co X (co R (cmpt k A2 Y) cgsu) c_x)) $;

--| A mapping to a scalar product is finitely supported if the mapping to the scalar is finitely supported. (Contributed by AV, 5-Oct-2019.)
theorem mptscmfsupp0 {k: setvar} (ph: wff) (B2 D: class) (Q R S: class k) (c_as K: class) (V W c_0 Z: class k):
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel Q clmod) $ >
  $ wi ph (wceq R (cfv Q csca)) $ >
  $ wceq K (cfv Q cbs) $ >
  $ wi (wa ph (wcel (cv k) D)) (wcel S B2) $ >
  $ wi (wa ph (wcel (cv k) D)) (wcel W K) $ >
  $ wceq c_0 (cfv Q c0g) $ >
  $ wceq Z (cfv R c0g) $ >
  $ wceq c_as (cfv Q cvsca) $ >
  $ wi ph (wbr (cmpt k D S) Z cfsupp) $ >
  $ wi ph (wbr (cmpt k D (co S W c_as)) c_0 cfsupp) $;

--| A function mapping to a scalar product in which one factor is finitely supported is finitely supported. Formerly part of proof for ~ ply1coe . (Contributed by Stefan O'Rear, 21-Mar-2015.) (Revised by AV, 8-Aug-2019.) (Proof shortened by AV, 18-Oct-2019.)
theorem mptscmfsuppd {k: setvar} (ph: wff) (A2 B2 P S c_x: class) (V: class k) (X: class) (Y Z: class k):
  $ wceq B2 (cfv P cbs) $ >
  $ wceq S (cfv P csca) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wi ph (wcel P clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel Z B2) $ >
  $ wi ph (wf X Y A2) $ >
  $ wi ph (wbr A2 (cfv S c0g) cfsupp) $ >
  $ wi ph (wbr (cmpt k X (co (cfv (cv k) A2) Z c_x)) (cfv P c0g) cfsupp) $;

--| Lemma for ~ rmodislmod . This is the part of the proof of ~ rmodislmod which requires the scalar ring to be commutative. (Contributed by AV, 3-Dec-2021.)
theorem rmodislmodlem {x3 w v s1 r q: setvar} (c_pl c_pd R: class x3 w v s1 r q) (c_x c_xp: class) (c_1 F c_as: class x3 w v s1 r q) (K: class w) (L: class x3 w v s1 r q) (V: class) (a b c: setvar):
  $ wceq V (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cvsca) $ >
  $ wceq F (cfv R csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_pd (cfv F cplusg) $ >
  $ wceq c_xp (cfv F cmulr) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ w3a (wcel R cgrp) (wcel F crg) (wral q (wral r (wral x3 (wral w (wa (w3a (wcel (co (cv w) (cv r) c_x) V) (wceq (co (co (cv w) (cv x3) c_pl) (cv r) c_x) (co (co (cv w) (cv r) c_x) (co (cv x3) (cv r) c_x) c_pl)) (wceq (co (cv w) (co (cv q) (cv r) c_pd) c_x) (co (co (cv w) (cv q) c_x) (co (cv w) (cv r) c_x) c_pl))) (wa (wceq (co (cv w) (co (cv q) (cv r) c_xp) c_x) (co (co (cv w) (cv q) c_x) (cv r) c_x)) (wceq (co (cv w) c_1 c_x) (cv w)))) V) V) K) K) $ >
  $ wceq c_as (cmpo s1 v K V (co (cv v) (cv s1) c_x)) $ >
  $ wceq L (co R (cop (cfv cnx cvsca) c_as) csts) $ >
  $ wi (wa (wcel F ccrg) (w3a (wcel (cv a) K) (wcel (cv b) K) (wcel (cv c) V))) (wceq (co (co (cv a) (cv b) c_xp) (cv c) c_as) (co (cv a) (co (cv b) (cv c) c_as) c_as)) $;

--| The right module ` R ` induces a left module ` L ` by replacing the scalar multiplication with a reversed multiplication if the scalar ring is commutative. The hypothesis "rmodislmod.r" is a definition of a right module analogous to Definition ~ df-lmod of a left module, see also ~ islmod . (Contributed by AV, 3-Dec-2021.) (Proof shortened by AV, 18-Oct-2024.)
theorem rmodislmod {x3 w v s1 r q: setvar} (c_pl c_pd: class) (R: class x3 w v s1 r q) (c_x c_xp c_1: class) (F: class x3 w r q) (c_as: class x3 w v s1 r q) (K: class w) (L: class x3 w v s1 r q) (V: class):
  $ wceq V (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cvsca) $ >
  $ wceq F (cfv R csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_pd (cfv F cplusg) $ >
  $ wceq c_xp (cfv F cmulr) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ w3a (wcel R cgrp) (wcel F crg) (wral q (wral r (wral x3 (wral w (wa (w3a (wcel (co (cv w) (cv r) c_x) V) (wceq (co (co (cv w) (cv x3) c_pl) (cv r) c_x) (co (co (cv w) (cv r) c_x) (co (cv x3) (cv r) c_x) c_pl)) (wceq (co (cv w) (co (cv q) (cv r) c_pd) c_x) (co (co (cv w) (cv q) c_x) (co (cv w) (cv r) c_x) c_pl))) (wa (wceq (co (cv w) (co (cv q) (cv r) c_xp) c_x) (co (co (cv w) (cv q) c_x) (cv r) c_x)) (wceq (co (cv w) c_1 c_x) (cv w)))) V) V) K) K) $ >
  $ wceq c_as (cmpo s1 v K V (co (cv v) (cv s1) c_x)) $ >
  $ wceq L (co R (cop (cfv cnx cvsca) c_as) csts) $ >
  $ wi (wcel F ccrg) (wcel L clmod) $;

--| Extend class notation with linear subspaces of a left module or left vector space.
term clss: class;

--| Define the set of linear subspaces of a left module or left vector space: a linear subspace of a left module or left vector space is a non-empty subset of the base set of the left module/vector space with a closure condition on vector addition and scalar multiplication. (Contributed by NM, 8-Dec-2013.)
axiom df_lss {x3 w s1 a b: setvar}:
  $ wceq clss (cmpt w cvv (crab s1 (wral x3 (wral a (wral b (wcel (co (co (cv x3) (cv a) (cfv (cv w) cvsca)) (cv b) (cfv (cv w) cplusg)) (cv s1)) (cv s1)) (cv s1)) (cfv (cfv (cv w) csca) cbs)) (cdif (cpw (cfv (cv w) cbs)) (csn c0)))) $;

--| The set of all (not necessarily closed) linear subspaces of a left module or left vector space. (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 15-Jul-2014.)
theorem lssset {x3 s1 a b: setvar} (B2: class a b) (c_pl: class x3 a b) (S: class x3 s1 a b) (c_x: class x3 a b) (F: class x3 s1 a b) (V: class x3 a b) (W: class) (X: class x3 s1 a b):
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wcel W X) (wceq S (crab s1 (wral x3 (wral a (wral b (wcel (co (co (cv x3) (cv a) c_x) (cv b) c_pl) (cv s1)) (cv s1)) (cv s1)) B2) (cdif (cpw V) (csn c0)))) $;

--| The predicate "is a subspace" (of a left module or left vector space). (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 8-Jan-2015.)
theorem islss {x3 a b: setvar} (B2: class a b) (c_pl S c_x: class x3 a b) (U: class) (F V: class x3 a b) (W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq S (cfv W clss) $ >
  $ wb (wcel U S) (w3a (wss U V) (wne U c0) (wral x3 (wral a (wral b (wcel (co (co (cv x3) (cv a) c_x) (cv b) c_pl) U) U) U) B2)) $;

--| Properties that determine a subspace of a left module or left vector space. (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 8-Jan-2015.)
theorem islssd {x3 a b: setvar} (ph: wff) (B2: class x3) (c_pl S c_x: class x3 a b) (U: class) (F V: class x3 a b) (W: class):
  $ wi ph (wceq F (cfv W csca)) $ >
  $ wi ph (wceq B2 (cfv F cbs)) $ >
  $ wi ph (wceq V (cfv W cbs)) $ >
  $ wi ph (wceq c_pl (cfv W cplusg)) $ >
  $ wi ph (wceq c_x (cfv W cvsca)) $ >
  $ wi ph (wceq S (cfv W clss)) $ >
  $ wi ph (wss U V) $ >
  $ wi ph (wne U c0) $ >
  $ wi (wa ph (w3a (wcel (cv x3) B2) (wcel (cv a) U) (wcel (cv b) U))) (wcel (co (co (cv x3) (cv a) c_x) (cv b) c_pl) U) $ >
  $ wi ph (wcel U S) $;

--| A subspace is a set of vectors. (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 8-Jan-2015.)
theorem lssss (S U V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wcel U S) (wss U V) $;

--| A subspace member is a vector. (Contributed by NM, 11-Jan-2014.) (Revised by Mario Carneiro, 8-Jan-2015.)
theorem lssel (S U V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wa (wcel U S) (wcel X U)) (wcel X V) $;

--| The set of vectors in a left module is a subspace. (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lss1 (S V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wcel W clmod) (wcel V S) $;

--| The union of all subspaces is the vector space. (Contributed by NM, 13-Mar-2015.)
theorem lssuni (ph: wff) (S V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wceq (cuni S) V) $;

--| A subspace is not empty. (Contributed by NM, 12-Jan-2014.) (Revised by Mario Carneiro, 8-Jan-2015.)
theorem lssn0 (S U W: class):
  $ wceq S (cfv W clss) $ >
  $ wi (wcel U S) (wne U c0) $;

--| The empty structure has no subspaces (for use with ~ fvco4i ). (Contributed by Stefan O'Rear, 31-Mar-2015.)
theorem _00lss:
  $ wceq c0 (cfv c0 clss) $;

--| Closure property of a subspace. (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 8-Jan-2015.)
theorem lsscl (B2 c_pl S c_x U F W X Y Z: class):
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wa (wcel U S) (w3a (wcel Z B2) (wcel X U) (wcel Y U))) (wcel (co (co Z X c_x) Y c_pl) U) $;

--| Closure of vector addition in a subspace. (Contributed by NM, 11-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lssvacl (c_pl S U W X Y: class):
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wa (wa (wcel W clmod) (wcel U S)) (wa (wcel X U) (wcel Y U))) (wcel (co X Y c_pl) U) $;

--| Closure of vector subtraction in a subspace. (Contributed by NM, 31-Mar-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lssvsubcl (S U c_mi W X Y: class):
  $ wceq c_mi (cfv W csg) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wa (wa (wcel W clmod) (wcel U S)) (wa (wcel X U) (wcel Y U))) (wcel (co X Y c_mi) U) $;

--| Non-closure: if one vector belongs to a subspace but another does not, their sum does not belong. Useful for obtaining a new vector not in a subspace. TODO: notice similarity to ~ lspindp3 . Can it be used along with ~ lspsnne1 , ~ lspsnne2 to shorten this proof? (Contributed by NM, 14-May-2015.)
theorem lssvancl1 (ph: wff) (c_pl S U V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq S (cfv W clss) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X U) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wn (wcel Y U)) $ >
  $ wi ph (wn (wcel (co X Y c_pl) U)) $;

--| Non-closure: if one vector belongs to a subspace but another does not, their sum does not belong. Useful for obtaining a new vector not in a subspace. (Contributed by NM, 20-May-2015.)
theorem lssvancl2 (ph: wff) (c_pl S U V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq S (cfv W clss) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X U) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wn (wcel Y U)) $ >
  $ wi ph (wn (wcel (co Y X c_pl) U)) $;

--| The zero vector belongs to every subspace. (Contributed by NM, 12-Jan-2014.) (Proof shortened by Mario Carneiro, 19-Jun-2014.)
theorem lss0cl (S U W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wa (wcel W clmod) (wcel U S)) (wcel c_0 U) $;

--| The singleton of the zero vector is a subspace. (Contributed by NM, 13-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lsssn0 (S W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wcel W clmod) (wcel (csn c_0) S) $;

--| The zero subspace is included in every subspace. ( ~ sh0le analog.) (Contributed by NM, 27-Mar-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lss0ss (S W X c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wa (wcel W clmod) (wcel X S)) (wss (csn c_0) X) $;

--| No subspace is smaller than the zero subspace. ( ~ shle0 analog.) (Contributed by NM, 20-Apr-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lssle0 (S W X c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wa (wcel W clmod) (wcel X S)) (wb (wss X (csn c_0)) (wceq X (csn c_0))) $;

--| A nonzero subspace has a nonzero vector. ( ~ shne0i analog.) (Contributed by NM, 20-Apr-2014.) (Proof shortened by Mario Carneiro, 8-Jan-2015.)
theorem lssne0 {y1: setvar} (S W: class y1) (X c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wcel X S) (wb (wne X (csn c_0)) (wrex y1 (wne (cv y1) c_0) X)) $;

--| A vector ` X ` which doesn't belong to a subspace ` U ` is nonzero. (Contributed by NM, 14-May-2015.) (Revised by AV, 19-Jul-2022.)
theorem lssvneln0 (ph: wff) (S U W X c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq S (cfv W clss) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wn (wcel X U)) $ >
  $ wi ph (wne X c_0) $;

--| A vector ` X ` which doesn't belong to a subspace ` U ` is nonzero. (Contributed by NM, 14-May-2015.) (Revised by AV, 17-Jul-2022.) (Proof shortened by AV, 19-Jul-2022.)
theorem lssneln0 (ph: wff) (S U V W X c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq S (cfv W clss) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wn (wcel X U)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $;

--| Conclude subspace ordering from nonzero vector membership. ( ~ ssrdv analog.) (Contributed by NM, 17-Aug-2014.) (Revised by AV, 13-Jul-2022.)
theorem lssssr {x3: setvar} (ph: wff) (S: class x3) (T U: class) (V W c_0: class x3):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq S (cfv W clss) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wss T V) $ >
  $ wi ph (wcel U S) $ >
  $ wi (wa ph (wcel (cv x3) (cdif V (csn c_0)))) (wi (wcel (cv x3) T) (wcel (cv x3) U)) $ >
  $ wi ph (wss T U) $;

--| Closure of scalar product in a subspace. (Contributed by NM, 11-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lssvscl (B2 S c_x U F W X Y: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wa (wa (wcel W clmod) (wcel U S)) (wa (wcel X B2) (wcel Y U))) (wcel (co X Y c_x) U) $;

--| Closure of negative vectors in a subspace. (Contributed by Stefan O'Rear, 11-Dec-2014.)
theorem lssvnegcl (S U N W X: class):
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W cminusg) $ >
  $ wi (w3a (wcel W clmod) (wcel U S) (wcel X U)) (wcel (cfv X N) U) $;

--| All subspaces are subgroups. (Contributed by Stefan O'Rear, 11-Dec-2014.)
theorem lsssubg (S U W: class):
  $ wceq S (cfv W clss) $ >
  $ wi (wa (wcel W clmod) (wcel U S)) (wcel U (cfv W csubg)) $;

--| All subspaces are subgroups. (Contributed by Mario Carneiro, 19-Apr-2016.)
theorem lsssssubg (S W: class):
  $ wceq S (cfv W clss) $ >
  $ wi (wcel W clmod) (wss S (cfv W csubg)) $;

--| A linear subspace of a module is a subset which is a module in its own right. (Contributed by Stefan O'Rear, 6-Dec-2014.) (Revised by Mario Carneiro, 30-Apr-2015.)
theorem islss3 (S U V W X: class):
  $ wceq X (co W U cress) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wcel W clmod) (wb (wcel U S) (wa (wss U V) (wcel X clmod))) $;

--| A submodule is a module. (Contributed by Stefan O'Rear, 12-Dec-2014.)
theorem lsslmod (S U W X: class):
  $ wceq X (co W U cress) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wa (wcel W clmod) (wcel U S)) (wcel X clmod) $;

--| The subspaces of a subspace are the smaller subspaces. (Contributed by Stefan O'Rear, 12-Dec-2014.)
theorem lsslss (S T U V W X: class):
  $ wceq X (co W U cress) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq T (cfv X clss) $ >
  $ wi (wa (wcel W clmod) (wcel U S)) (wb (wcel V T) (wa (wcel V S) (wss V U))) $;

--| A linear subspace is a subgroup which respects scalar multiplication. (Contributed by Stefan O'Rear, 11-Dec-2014.) (Revised by Mario Carneiro, 19-Apr-2016.)
theorem islss4 {a b: setvar} (B2 S c_x U F V W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wcel W clmod) (wb (wcel U S) (wa (wcel U (cfv W csubg)) (wral a (wral b (wcel (co (cv a) (cv b) c_x) U) U) B2))) $;

--| One-dimensional subspace (or zero-dimensional if ` X ` is the zero vector). (Contributed by NM, 14-Jan-2014.) (Proof shortened by Mario Carneiro, 19-Jun-2014.)
theorem lss1d {v k: setvar} (S: class v k) (c_x: class) (F: class v) (K V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wa (wcel W clmod) (wcel X V)) (wcel (cab v (wrex k (wceq (cv v) (co (cv k) X c_x)) K)) S) $;

--| The intersection of a nonempty set of subspaces is a subspace. (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lssintcl (A2 S W: class):
  $ wceq S (cfv W clss) $ >
  $ wi (w3a (wcel W clmod) (wss A2 S) (wne A2 c0)) (wcel (cint A2) S) $;

--| The intersection of two subspaces is a subspace. (Contributed by NM, 7-Mar-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lssincl (S T U W: class):
  $ wceq S (cfv W clss) $ >
  $ wi (w3a (wcel W clmod) (wcel T S) (wcel U S)) (wcel (cin T U) S) $;

--| The subspaces of a module comprise a Moore system on the vectors of the module. (Contributed by Stefan O'Rear, 31-Jan-2015.)
theorem lssmre (B2 S W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wcel W clmod) (wcel S (cfv B2 cmre)) $;

--| Submodules are an algebraic closure system. (Contributed by Stefan O'Rear, 4-Apr-2015.)
theorem lssacs (B2 S W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wcel W clmod) (wcel S (cfv B2 cacs)) $;

--| Pointwise scalar multiplication is closed in products of modules. (Contributed by Stefan O'Rear, 10-Jan-2015.)
theorem prdsvscacl {x3: setvar} (ph: wff) (B2 R S: class) (c_x: class x3) (F G I K W Y: class):
  $ wceq Y (co S R cprds) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq c_x (cfv Y cvsca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wi ph (wcel S crg) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wf I clmod R) $ >
  $ wi ph (wcel F K) $ >
  $ wi ph (wcel G B2) $ >
  $ wi (wa ph (wcel (cv x3) I)) (wceq (cfv (cfv (cv x3) R) csca) S) $ >
  $ wi ph (wcel (co F G c_x) B2) $;

--| The product of a family of left modules is a left module. (Contributed by Stefan O'Rear, 10-Jan-2015.)
theorem prdslmodd {y1: setvar} (ph: wff) (R S I: class) (V: class y1) (Y: class):
  $ wceq Y (co S R cprds) $ >
  $ wi ph (wcel S crg) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wf I clmod R) $ >
  $ wi (wa ph (wcel (cv y1) I)) (wceq (cfv (cfv (cv y1) R) csca) S) $ >
  $ wi ph (wcel Y clmod) $;

--| A structure power of a left module is a left module. (Contributed by Mario Carneiro, 11-Jan-2015.)
theorem pwslmod (R I V Y: class):
  $ wceq Y (co R I cpws) $ >
  $ wi (wa (wcel R clmod) (wcel I V)) (wcel Y clmod) $;

--| Extend class notation with span of a set of vectors.
term clspn: class;

--| Define span of a set of vectors of a left module or left vector space. (Contributed by NM, 8-Dec-2013.)
axiom df_lsp {w t s1: setvar}:
  $ wceq clspn (cmpt w cvv (cmpt s1 (cpw (cfv (cv w) cbs)) (cint (crab t (wss (cv s1) (cv t)) (cfv (cv w) clss))))) $;

--| The span function for a left vector space (or a left module). ( ~ df-span analog.) (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lspfval {t s1: setvar} (S: class) (N: class t s1) (V: class) (W: class t) (X: class t s1):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wcel W X) (wceq N (cmpt s1 (cpw V) (cint (crab t (wss (cv s1) (cv t)) S)))) $;

--| The span function on a left module maps subsets to subspaces. (Contributed by Stefan O'Rear, 12-Dec-2014.)
theorem lspf (S N V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wcel W clmod) (wf (cpw V) S N) $;

--| The span of a set of vectors (in a left module). ( ~ spanval analog.) (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lspval {t: setvar} (S U: class) (N: class t) (V: class) (W: class t):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (wcel W clmod) (wss U V)) (wceq (cfv U N) (cint (crab t (wss U (cv t)) S))) $;

--| The span of a set of vectors is a subspace. ( ~ spancl analog.) (Contributed by NM, 9-Dec-2013.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lspcl (S U N V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (wcel W clmod) (wss U V)) (wcel (cfv U N) S) $;

--| The span of a singleton is a subspace (frequently used special case of ~ lspcl ). (Contributed by NM, 17-Jul-2014.)
theorem lspsncl (S N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (wcel W clmod) (wcel X V)) (wcel (cfv (csn X) N) S) $;

--| The span of a pair is a subspace (frequently used special case of ~ lspcl ). (Contributed by NM, 11-Apr-2015.)
theorem lspprcl (ph: wff) (S N V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel (cfv (cpr X Y) N) S) $;

--| The span of an unordered triple is a subspace (frequently used special case of ~ lspcl ). (Contributed by NM, 22-May-2015.)
theorem lsptpcl (ph: wff) (S N V W X Y Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wcel (cfv (ctp X Y Z) N) S) $;

--| The span of a singleton is an additive subgroup (frequently used special case of ~ lspcl ). (Contributed by Mario Carneiro, 21-Apr-2016.)
theorem lspsnsubg (N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (wcel W clmod) (wcel X V)) (wcel (cfv (csn X) N) (cfv W csubg)) $;

--| ~ fvco4i lemma for linear spans. (Contributed by Stefan O'Rear, 4-Apr-2015.)
theorem _00lsp:
  $ wceq c0 (cfv c0 clspn) $;

--| The span of a subspace is itself. ( ~ spanid analog.) (Contributed by NM, 15-Dec-2013.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lspid (S U N W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (wcel W clmod) (wcel U S)) (wceq (cfv U N) U) $;

--| A span is a set of vectors. (Contributed by NM, 22-Feb-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lspssv (U N V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (wcel W clmod) (wss U V)) (wss (cfv U N) V) $;

--| Span preserves subset ordering. ( ~ spanss analog.) (Contributed by NM, 11-Dec-2013.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lspss (T U N V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (w3a (wcel W clmod) (wss U V) (wss T U)) (wss (cfv T N) (cfv U N)) $;

--| A set of vectors is a subset of its span. ( ~ spanss2 analog.) (Contributed by NM, 6-Feb-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lspssid (U N V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (wcel W clmod) (wss U V)) (wss U (cfv U N)) $;

--| The span of a set of vectors is idempotent. (Contributed by NM, 22-Feb-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lspidm (U N V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (wcel W clmod) (wss U V)) (wceq (cfv (cfv U N) N) (cfv U N)) $;

--| The span of union is the span of the union of spans. (Contributed by NM, 22-Feb-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lspun (T U N V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (w3a (wcel W clmod) (wss T V) (wss U V)) (wceq (cfv (cun T U) N) (cfv (cun (cfv T N) (cfv U N)) N)) $;

--| If a set of vectors is a subset of a subspace, then the span of those vectors is also contained in the subspace. (Contributed by Mario Carneiro, 4-Sep-2014.)
theorem lspssp (S T U N W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (w3a (wcel W clmod) (wcel U S) (wss T U)) (wss (cfv T N) U) $;

--| Moore closure generalizes module span. (Contributed by Stefan O'Rear, 31-Jan-2015.)
theorem mrclsp (U F K W: class):
  $ wceq U (cfv W clss) $ >
  $ wceq K (cfv W clspn) $ >
  $ wceq F (cfv U cmrc) $ >
  $ wi (wcel W clmod) (wceq K F) $;

--| The span of the singleton of a subspace member is included in the subspace. ( ~ spansnss analog.) (Contributed by NM, 9-Apr-2014.) (Revised by Mario Carneiro, 4-Sep-2014.)
theorem lspsnss (S U N W X: class):
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (w3a (wcel W clmod) (wcel U S) (wcel X U)) (wss (cfv (csn X) N) U) $;

--| A member of the span of the singleton of a vector is a member of a subspace containing the vector. ( ~ elspansn3 analog.) (Contributed by NM, 4-Jul-2014.)
theorem ellspsn3 (ph: wff) (S U N W X Y: class):
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X U) $ >
  $ wi ph (wcel Y (cfv (csn X) N)) $ >
  $ wi ph (wcel Y U) $;

--| The span of a pair of vectors in a subspace belongs to the subspace. (Contributed by NM, 12-Jan-2015.)
theorem lspprss (ph: wff) (S U N W X Y: class):
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X U) $ >
  $ wi ph (wcel Y U) $ >
  $ wi ph (wss (cfv (cpr X Y) N) U) $;

--| A vector belongs to the span of its singleton. ( ~ spansnid analog.) (Contributed by NM, 9-Apr-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lspsnid (N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (wcel W clmod) (wcel X V)) (wcel X (cfv (csn X) N)) $;

--| Relationship between a vector and the 1-dim (or 0-dim) subspace it generates. (Contributed by NM, 8-Aug-2014.) (Revised by Mario Carneiro, 8-Jan-2015.)
theorem ellspsn6 (ph: wff) (S U N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wb (wcel X U) (wa (wcel X V) (wss (cfv (csn X) N) U))) $;

--| Relationship between a vector and the 1-dim (or 0-dim) subspace it generates. (Contributed by NM, 8-Aug-2014.)
theorem ellspsn5b (ph: wff) (S U N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wb (wcel X U) (wss (cfv (csn X) N) U)) $;

--| Relationship between a vector and the 1-dim (or 0-dim) subspace it generates. (Contributed by NM, 20-Feb-2015.)
theorem ellspsn5 (ph: wff) (S U N W X: class):
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X U) $ >
  $ wi ph (wss (cfv (csn X) N) U) $;

--| A member of a pair of vectors belongs to their span. (Contributed by NM, 14-May-2015.)
theorem lspprid1 (ph: wff) (N V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel X (cfv (cpr X Y) N)) $;

--| A member of a pair of vectors belongs to their span. (Contributed by NM, 14-May-2015.)
theorem lspprid2 (ph: wff) (N V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel Y (cfv (cpr X Y) N)) $;

--| The sum of two vectors belongs to their span. (Contributed by NM, 20-May-2015.)
theorem lspprvacl (ph: wff) (c_pl N V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel (co X Y c_pl) (cfv (cpr X Y) N)) $;

--| A way to express atomisticity (a subspace is the union of its atoms). (Contributed by NM, 3-Feb-2015.)
theorem lssats2 {x3: setvar} (ph: wff) (S: class x3) (U N: class) (W: class x3):
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wceq U (ciun x3 U (cfv (csn (cv x3)) N))) $;

--| A scalar product with a vector belongs to the span of its singleton. ( ~ spansnmul analog.) (Contributed by NM, 2-Jul-2014.)
theorem ellspsni (ph: wff) (A2 c_x F K N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel (co A2 X c_x) (cfv (csn X) N)) $;

--| Span of the singleton of a vector. (Contributed by NM, 14-Jan-2014.) (Proof shortened by Mario Carneiro, 19-Jun-2014.)
theorem lspsn {v k: setvar} (c_x: class) (F: class v) (K N V W X: class):
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (wcel W clmod) (wcel X V)) (wceq (cfv (csn X) N) (cab v (wrex k (wceq (cv v) (co (cv k) X c_x)) K))) $;

--| Member of span of the singleton of a vector. ( ~ elspansn analog.) (Contributed by NM, 22-Feb-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem ellspsn {k: setvar} (c_x U F K N V W X: class):
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (wcel W clmod) (wcel X V)) (wb (wcel U (cfv (csn X) N)) (wrex k (wceq U (co (cv k) X c_x)) K)) $;

--| Span of a scalar product of a singleton. (Contributed by NM, 23-Apr-2014.) (Proof shortened by Mario Carneiro, 4-Sep-2014.)
theorem lspsnvsi (R c_x F K N V W X: class):
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (w3a (wcel W clmod) (wcel R K) (wcel X V)) (wss (cfv (csn (co R X c_x)) N) (cfv (csn X) N)) $;

--| Comparable spans of singletons must have proportional vectors. See ~ lspsneq for equal span version. (Contributed by NM, 7-Jun-2015.)
theorem lspsnss2 {k: setvar} (ph: wff k) (S c_x K N V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W csca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wb (wss (cfv (csn X) N) (cfv (csn Y) N)) (wrex k (wceq X (co (cv k) Y c_x)) K)) $;

--| Negation does not change the span of a singleton. (Contributed by NM, 24-Apr-2014.) (Proof shortened by Mario Carneiro, 19-Jun-2014.)
theorem lspsnneg (M N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq M (cfv W cminusg) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (wcel W clmod) (wcel X V)) (wceq (cfv (csn (cfv X M)) N) (cfv (csn X) N)) $;

--| Swapping subtraction order does not change the span of a singleton. (Contributed by NM, 4-Apr-2015.)
theorem lspsnsub (ph: wff) (c_mi N V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wceq (cfv (csn (co X Y c_mi)) N) (cfv (csn (co Y X c_mi)) N)) $;

--| Span of the singleton of the zero vector. ( ~ spansn0 analog.) (Contributed by NM, 15-Jan-2014.) (Proof shortened by Mario Carneiro, 19-Jun-2014.)
theorem lspsn0 (N W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wcel W clmod) (wceq (cfv (csn c_0) N) (csn c_0)) $;

--| Span of the empty set. (Contributed by Mario Carneiro, 5-Sep-2014.)
theorem lsp0 (N W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wcel W clmod) (wceq (cfv c0 N) (csn c_0)) $;

--| Union of the span of the empty set. (Contributed by NM, 14-Mar-2015.)
theorem lspuni0 (N W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wcel W clmod) (wceq (cuni (cfv c0 N)) c_0) $;

--| The span of a union with the zero subspace. (Contributed by NM, 22-May-2015.)
theorem lspun0 (ph: wff) (N V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wss X V) $ >
  $ wi ph (wceq (cfv (cun X (csn c_0)) N) (cfv X N)) $;

--| Span of the singleton is the zero subspace iff the vector is zero. (Contributed by NM, 27-Apr-2014.) (Revised by Mario Carneiro, 19-Jun-2014.)
theorem lspsneq0 (N V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (wcel W clmod) (wcel X V)) (wb (wceq (cfv (csn X) N) (csn c_0)) (wceq X c_0)) $;

--| Equal singleton spans imply both arguments are zero or both are nonzero. (Contributed by NM, 21-Mar-2015.)
theorem lspsneq0b (ph: wff) (N V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wceq (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wb (wceq X c_0) (wceq Y c_0)) $;

--| Two independent (non-colinear) vectors have nonzero sum. (Contributed by NM, 22-Apr-2015.)
theorem lmodindp1 (ph: wff) (c_pl N V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wne (co X Y c_pl) c_0) $;

--| Spans in submodules correspond to spans in the containing module. (Contributed by Stefan O'Rear, 12-Dec-2014.) Terms in the equation were swapped as proposed by NM on 15-Mar-2015. (Revised by AV, 18-Apr-2025.)
theorem lsslsp (U G L M N W X: class):
  $ wceq X (co W U cress) $ >
  $ wceq M (cfv W clspn) $ >
  $ wceq N (cfv X clspn) $ >
  $ wceq L (cfv W clss) $ >
  $ wi (w3a (wcel W clmod) (wcel U L) (wss G U)) (wceq (cfv G N) (cfv G M)) $;

--| The zero vector in a submodule equals the zero vector in the including module. (Contributed by NM, 15-Mar-2015.)
theorem lss0v (U L W X c_0 Z: class):
  $ wceq X (co W U cress) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq Z (cfv X c0g) $ >
  $ wceq L (cfv W clss) $ >
  $ wi (wa (wcel W clmod) (wcel U L)) (wceq Z c_0) $;

--| If two structures have the same components (properties), they have the same subspace structure. (Contributed by Mario Carneiro, 9-Feb-2015.) (Revised by Mario Carneiro, 14-Jun-2015.)
theorem lsspropd {x3 y1: setvar} (ph: wff) (B2 P K L W: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi ph (wss B2 W) $ >
  $ wi (wa ph (wa (wcel (cv x3) W) (wcel (cv y1) W))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) B2))) (wcel (co (cv x3) (cv y1) (cfv K cvsca)) W) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cvsca)) (co (cv x3) (cv y1) (cfv L cvsca))) $ >
  $ wi ph (wceq P (cfv (cfv K csca) cbs)) $ >
  $ wi ph (wceq P (cfv (cfv L csca) cbs)) $ >
  $ wi ph (wceq (cfv K clss) (cfv L clss)) $;

--| If two structures have the same components (properties), they have the same span function. (Contributed by Mario Carneiro, 9-Feb-2015.) (Revised by Mario Carneiro, 14-Jun-2015.) (Revised by AV, 24-Apr-2024.)
theorem lsppropd {x3 y1: setvar} (ph: wff) (B2 P K L W: class) (X Y: class x3 y1):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi ph (wss B2 W) $ >
  $ wi (wa ph (wa (wcel (cv x3) W) (wcel (cv y1) W))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) B2))) (wcel (co (cv x3) (cv y1) (cfv K cvsca)) W) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cvsca)) (co (cv x3) (cv y1) (cfv L cvsca))) $ >
  $ wi ph (wceq P (cfv (cfv K csca) cbs)) $ >
  $ wi ph (wceq P (cfv (cfv L csca) cbs)) $ >
  $ wi ph (wcel K X) $ >
  $ wi ph (wcel L Y) $ >
  $ wi ph (wceq (cfv K clspn) (cfv L clspn)) $;

--| Extend class notation with the generator of left module hom-sets.
term clmhm: class;

--| The class of left module isomorphism sets.
term clmim: class;

--| The class of the left module isomorphism relation.
term clmic: class;

--| A homomorphism of left modules is a group homomorphism which additionally preserves the scalar product. This requires both structures to be left modules over the same ring. (Contributed by Stefan O'Rear, 31-Dec-2014.)
axiom df_lmhm {x3 y1 w t f2 s1: setvar}:
  $ wceq clmhm (cmpo s1 t clmod clmod (crab f2 (wsbc w (wa (wceq (cfv (cv t) csca) (cv w)) (wral x3 (wral y1 (wceq (cfv (co (cv x3) (cv y1) (cfv (cv s1) cvsca)) (cv f2)) (co (cv x3) (cfv (cv y1) (cv f2)) (cfv (cv t) cvsca))) (cfv (cv s1) cbs)) (cfv (cv w) cbs))) (cfv (cv s1) csca)) (co (cv s1) (cv t) cghm))) $;

--| An isomorphism of modules is a homomorphism which is also a bijection, i.e. it preserves equality as well as the group and scalar operations. (Contributed by Stefan O'Rear, 21-Jan-2015.)
axiom df_lmim {t g2 s1: setvar}:
  $ wceq clmim (cmpo s1 t clmod clmod (crab g2 (wf1o (cfv (cv s1) cbs) (cfv (cv t) cbs) (cv g2)) (co (cv s1) (cv t) clmhm))) $;

--| Two modules are said to be isomorphic iff they are connected by at least one isomorphism. (Contributed by Stefan O'Rear, 25-Jan-2015.)
axiom df_lmic:
  $ wceq clmic (cima (ccnv clmim) (cdif cvv c1o)) $;

--| Lemma for module homomorphisms. (Contributed by Stefan O'Rear, 31-Dec-2014.)
theorem reldmlmhm:
  $ wrel (cdm clmhm) $;

--| Lemma for module isomorphisms. (Contributed by Stefan O'Rear, 23-Aug-2015.)
theorem lmimfn:
  $ wfn clmim (cxp clmod clmod) $;

--| Property of being a homomorphism of left modules. (Contributed by Stefan O'Rear, 1-Jan-2015.) (Proof shortened by Mario Carneiro, 30-Apr-2015.)
theorem islmhm {x3 y1: setvar} (B2: class y1) (S T: class) (c_x c_xp: class x3 y1) (E: class x3) (F: class) (K L: class x3 y1):
  $ wceq K (cfv S csca) $ >
  $ wceq L (cfv T csca) $ >
  $ wceq B2 (cfv K cbs) $ >
  $ wceq E (cfv S cbs) $ >
  $ wceq c_x (cfv S cvsca) $ >
  $ wceq c_xp (cfv T cvsca) $ >
  $ wb (wcel F (co S T clmhm)) (wa (wa (wcel S clmod) (wcel T clmod)) (w3a (wcel F (co S T cghm)) (wceq L K) (wral x3 (wral y1 (wceq (cfv (co (cv x3) (cv y1) c_x) F) (co (cv x3) (cfv (cv y1) F) c_xp)) E) B2))) $;

--| Property of a module homomorphism, similar to ~ ismhm . (Contributed by Stefan O'Rear, 7-Mar-2015.)
theorem islmhm3 {x3 y1: setvar} (B2: class y1) (S T: class) (c_x c_xp: class x3 y1) (E: class x3) (F: class) (K L: class x3 y1):
  $ wceq K (cfv S csca) $ >
  $ wceq L (cfv T csca) $ >
  $ wceq B2 (cfv K cbs) $ >
  $ wceq E (cfv S cbs) $ >
  $ wceq c_x (cfv S cvsca) $ >
  $ wceq c_xp (cfv T cvsca) $ >
  $ wi (wa (wcel S clmod) (wcel T clmod)) (wb (wcel F (co S T clmhm)) (w3a (wcel F (co S T cghm)) (wceq L K) (wral x3 (wral y1 (wceq (cfv (co (cv x3) (cv y1) c_x) F) (co (cv x3) (cfv (cv y1) F) c_xp)) E) B2))) $;

--| Non-quantified consequences of a left module homomorphism. (Contributed by Stefan O'Rear, 1-Jan-2015.)
theorem lmhmlem (S T F K L: class):
  $ wceq K (cfv S csca) $ >
  $ wceq L (cfv T csca) $ >
  $ wi (wcel F (co S T clmhm)) (wa (wa (wcel S clmod) (wcel T clmod)) (wa (wcel F (co S T cghm)) (wceq L K))) $;

--| A homomorphism of left modules constrains both modules to the same ring of scalars. (Contributed by Stefan O'Rear, 1-Jan-2015.)
theorem lmhmsca (S T F K L: class):
  $ wceq K (cfv S csca) $ >
  $ wceq L (cfv T csca) $ >
  $ wi (wcel F (co S T clmhm)) (wceq L K) $;

--| A homomorphism of left modules is a homomorphism of groups. (Contributed by Stefan O'Rear, 1-Jan-2015.)
theorem lmghm (S T F: class):
  $ wi (wcel F (co S T clmhm)) (wcel F (co S T cghm)) $;

--| A homomorphism of left modules has a left module as codomain. (Contributed by Stefan O'Rear, 1-Jan-2015.)
theorem lmhmlmod2 (S T F: class):
  $ wi (wcel F (co S T clmhm)) (wcel T clmod) $;

--| A homomorphism of left modules has a left module as domain. (Contributed by Stefan O'Rear, 1-Jan-2015.)
theorem lmhmlmod1 (S T F: class):
  $ wi (wcel F (co S T clmhm)) (wcel S clmod) $;

--| A homomorphism of left modules is a function. (Contributed by Stefan O'Rear, 1-Jan-2015.)
theorem lmhmf (B2 C S T F: class):
  $ wceq B2 (cfv S cbs) $ >
  $ wceq C (cfv T cbs) $ >
  $ wi (wcel F (co S T clmhm)) (wf B2 C F) $;

--| A homomorphism of left modules is ` K ` -linear. (Contributed by Stefan O'Rear, 1-Jan-2015.)
theorem lmhmlin (B2 S T c_x c_xp E F K X Y: class):
  $ wceq K (cfv S csca) $ >
  $ wceq B2 (cfv K cbs) $ >
  $ wceq E (cfv S cbs) $ >
  $ wceq c_x (cfv S cvsca) $ >
  $ wceq c_xp (cfv T cvsca) $ >
  $ wi (w3a (wcel F (co S T clmhm)) (wcel X B2) (wcel Y E)) (wceq (cfv (co X Y c_x) F) (co X (cfv Y F) c_xp)) $;

--| Multiplication of a vector by a negated scalar. (Contributed by Stefan O'Rear, 28-Feb-2015.)
theorem lmodvsinv (B2 R c_x F K M N W X: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq N (cfv W cminusg) $ >
  $ wceq M (cfv F cminusg) $ >
  $ wceq K (cfv F cbs) $ >
  $ wi (w3a (wcel W clmod) (wcel R K) (wcel X B2)) (wceq (co (cfv R M) X c_x) (cfv (co R X c_x) N)) $;

--| Multiplying a negated vector by a scalar. (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem lmodvsinv2 (B2 R c_x F K N W X: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq N (cfv W cminusg) $ >
  $ wceq K (cfv F cbs) $ >
  $ wi (w3a (wcel W clmod) (wcel R K) (wcel X B2)) (wceq (co R (cfv X N) c_x) (cfv (co R X c_x) N)) $;

--| A one-equation proof of linearity of a left module homomorphism, similar to ~ df-lss . (Contributed by Mario Carneiro, 7-Oct-2015.)
theorem islmhm2 {x3 y1 z: setvar} (B2 C c_pl c_pd S T: class) (c_x c_xp: class y1) (E F K L: class):
  $ wceq B2 (cfv S cbs) $ >
  $ wceq C (cfv T cbs) $ >
  $ wceq K (cfv S csca) $ >
  $ wceq L (cfv T csca) $ >
  $ wceq E (cfv K cbs) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wceq c_pd (cfv T cplusg) $ >
  $ wceq c_x (cfv S cvsca) $ >
  $ wceq c_xp (cfv T cvsca) $ >
  $ wi (wa (wcel S clmod) (wcel T clmod)) (wb (wcel F (co S T clmhm)) (w3a (wf B2 C F) (wceq L K) (wral x3 (wral y1 (wral z (wceq (cfv (co (co (cv x3) (cv y1) c_x) (cv z) c_pl) F) (co (co (cv x3) (cfv (cv y1) F) c_xp) (cfv (cv z) F) c_pd)) B2) B2) E))) $;

--| Deduction for a module homomorphism. (Contributed by Stefan O'Rear, 4-Feb-2015.)
theorem islmhmd {x3 y1: setvar} (ph: wff) (S T: class) (c_x c_xp: class x3 y1) (F J K N X: class):
  $ wceq X (cfv S cbs) $ >
  $ wceq c_x (cfv S cvsca) $ >
  $ wceq c_xp (cfv T cvsca) $ >
  $ wceq K (cfv S csca) $ >
  $ wceq J (cfv T csca) $ >
  $ wceq N (cfv K cbs) $ >
  $ wi ph (wcel S clmod) $ >
  $ wi ph (wcel T clmod) $ >
  $ wi ph (wceq J K) $ >
  $ wi ph (wcel F (co S T cghm)) $ >
  $ wi (wa ph (wa (wcel (cv x3) N) (wcel (cv y1) X))) (wceq (cfv (co (cv x3) (cv y1) c_x) F) (co (cv x3) (cfv (cv y1) F) c_xp)) $ >
  $ wi ph (wcel F (co S T clmhm)) $;

--| The constant zero linear function between two modules. (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem _0lmhm (B2 S T M N c_0: class):
  $ wceq c_0 (cfv N c0g) $ >
  $ wceq B2 (cfv M cbs) $ >
  $ wceq S (cfv M csca) $ >
  $ wceq T (cfv N csca) $ >
  $ wi (w3a (wcel M clmod) (wcel N clmod) (wceq S T)) (wcel (cxp B2 (csn c_0)) (co M N clmhm)) $;

--| The identity function on a module is linear. (Contributed by Stefan O'Rear, 4-Sep-2015.)
theorem idlmhm (B2 M: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wi (wcel M clmod) (wcel (cres cid B2) (co M M clmhm)) $;

--| The negative function on a module is linear. (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem invlmhm (I M: class):
  $ wceq I (cfv M cminusg) $ >
  $ wi (wcel M clmod) (wcel I (co M M clmhm)) $;

--| The composition of two module-linear functions is module-linear. (Contributed by Stefan O'Rear, 4-Sep-2015.)
theorem lmhmco (F G M N O: class):
  $ wi (wa (wcel F (co N O clmhm)) (wcel G (co M N clmhm))) (wcel (ccom F G) (co M O clmhm)) $;

--| The pointwise sum of two linear functions is linear. (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem lmhmplusg (c_pl F G M N: class):
  $ wceq c_pl (cfv N cplusg) $ >
  $ wi (wa (wcel F (co M N clmhm)) (wcel G (co M N clmhm))) (wcel (co F G (cof c_pl)) (co M N clmhm)) $;

--| The pointwise scalar product of a linear function and a constant is linear, over a commutative ring. (Contributed by Mario Carneiro, 22-Sep-2015.)
theorem lmhmvsca (A2 c_x F J K M N V: class):
  $ wceq V (cfv M cbs) $ >
  $ wceq c_x (cfv N cvsca) $ >
  $ wceq J (cfv N csca) $ >
  $ wceq K (cfv J cbs) $ >
  $ wi (w3a (wcel J ccrg) (wcel A2 K) (wcel F (co M N clmhm))) (wcel (co (cxp V (csn A2)) F (cof c_x)) (co M N clmhm)) $;

--| A bijective module homomorphism is also converse homomorphic. (Contributed by Stefan O'Rear, 25-Jan-2015.)
theorem lmhmf1o (S T F X Y: class):
  $ wceq X (cfv S cbs) $ >
  $ wceq Y (cfv T cbs) $ >
  $ wi (wcel F (co S T clmhm)) (wb (wf1o X Y F) (wcel (ccnv F) (co T S clmhm))) $;

--| The image of a subspace under a homomorphism. (Contributed by Stefan O'Rear, 1-Jan-2015.)
theorem lmhmima (S T U F X Y: class):
  $ wceq X (cfv S clss) $ >
  $ wceq Y (cfv T clss) $ >
  $ wi (wa (wcel F (co S T clmhm)) (wcel U X)) (wcel (cima F U) Y) $;

--| The inverse image of a subspace under a homomorphism. (Contributed by Stefan O'Rear, 1-Jan-2015.)
theorem lmhmpreima (S T U F X Y: class):
  $ wceq X (cfv S clss) $ >
  $ wceq Y (cfv T clss) $ >
  $ wi (wa (wcel F (co S T clmhm)) (wcel U Y)) (wcel (cima (ccnv F) U) X) $;

--| Homomorphisms preserve spans. (Contributed by Stefan O'Rear, 1-Jan-2015.)
theorem lmhmlsp (S T U F K L V: class):
  $ wceq V (cfv S cbs) $ >
  $ wceq K (cfv S clspn) $ >
  $ wceq L (cfv T clspn) $ >
  $ wi (wa (wcel F (co S T clmhm)) (wss U V)) (wceq (cima F (cfv U K)) (cfv (cima F U) L)) $;

--| The range of a homomorphism is a submodule. (Contributed by Stefan O'Rear, 1-Jan-2015.)
theorem lmhmrnlss (S T F: class):
  $ wi (wcel F (co S T clmhm)) (wcel (crn F) (cfv T clss)) $;

--| The kernel of a homomorphism is a submodule. (Contributed by Stefan O'Rear, 1-Jan-2015.)
theorem lmhmkerlss (S T U F K c_0: class):
  $ wceq K (cima (ccnv F) (csn c_0)) $ >
  $ wceq c_0 (cfv T c0g) $ >
  $ wceq U (cfv S clss) $ >
  $ wi (wcel F (co S T clmhm)) (wcel K U) $;

--| Restriction of a homomorphism to a subspace. (Contributed by Stefan O'Rear, 1-Jan-2015.)
theorem reslmhm (R S T U F X: class):
  $ wceq U (cfv S clss) $ >
  $ wceq R (co S X cress) $ >
  $ wi (wa (wcel F (co S T clmhm)) (wcel X U)) (wcel (cres F X) (co R T clmhm)) $;

--| Expansion of the codomain of a homomorphism. (Contributed by Stefan O'Rear, 3-Feb-2015.) (Revised by Mario Carneiro, 5-May-2015.)
theorem reslmhm2 (S T U F L X: class):
  $ wceq U (co T X cress) $ >
  $ wceq L (cfv T clss) $ >
  $ wi (w3a (wcel F (co S U clmhm)) (wcel T clmod) (wcel X L)) (wcel F (co S T clmhm)) $;

--| Expansion of the codomain of a homomorphism. (Contributed by Stefan O'Rear, 3-Feb-2015.) (Revised by Mario Carneiro, 5-May-2015.)
theorem reslmhm2b (S T U F L X: class):
  $ wceq U (co T X cress) $ >
  $ wceq L (cfv T clss) $ >
  $ wi (w3a (wcel T clmod) (wcel X L) (wss (crn F) X)) (wb (wcel F (co S T clmhm)) (wcel F (co S U clmhm))) $;

--| The equalizer of two module homomorphisms is a subspace. (Contributed by Stefan O'Rear, 7-Mar-2015.)
theorem lmhmeql (S T U F G: class):
  $ wceq U (cfv S clss) $ >
  $ wi (wa (wcel F (co S T clmhm)) (wcel G (co S T clmhm))) (wcel (cdm (cin F G)) U) $;

--| A linear function is completely determined (or overdetermined) by its values on a spanning subset. (Contributed by Stefan O'Rear, 7-Mar-2015.) (Revised by NM, 17-Jun-2017.)
theorem lspextmo {g2: setvar} (B2 S T F K X: class):
  $ wceq B2 (cfv S cbs) $ >
  $ wceq K (cfv S clspn) $ >
  $ wi (wa (wss X B2) (wceq (cfv X K) B2)) (wrmo g2 (wceq (cres (cv g2) X) F) (co S T clmhm)) $;

--| Diagonal homomorphism into a structure power. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem pwsdiaglmhm {x3: setvar} (B2 R: class) (F: class x3) (I W Y: class):
  $ wceq Y (co R I cpws) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq F (cmpt x3 B2 (cxp I (csn (cv x3)))) $ >
  $ wi (wa (wcel R clmod) (wcel I W)) (wcel F (co R Y clmhm)) $;

--| Splitting for structure powers, part 0: restriction is a function. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem pwssplit0 {x3: setvar} (B2 C T U: class) (F: class x3) (V W X Y Z: class):
  $ wceq Y (co W U cpws) $ >
  $ wceq Z (co W V cpws) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq C (cfv Z cbs) $ >
  $ wceq F (cmpt x3 B2 (cres (cv x3) V)) $ >
  $ wi (w3a (wcel W T) (wcel U X) (wss V U)) (wf B2 C F) $;

--| Splitting for structure powers, part 1: restriction is an onto function. The only actual monoid law we need here is that the base set is nonempty. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem pwssplit1 {x3: setvar} (B2 C U: class) (F: class x3) (V W X Y Z: class):
  $ wceq Y (co W U cpws) $ >
  $ wceq Z (co W V cpws) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq C (cfv Z cbs) $ >
  $ wceq F (cmpt x3 B2 (cres (cv x3) V)) $ >
  $ wi (w3a (wcel W cmnd) (wcel U X) (wss V U)) (wfo B2 C F) $;

--| Splitting for structure powers, part 2: restriction is a group homomorphism. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem pwssplit2 {x3: setvar} (B2 C U: class) (F: class x3) (V W X Y Z: class):
  $ wceq Y (co W U cpws) $ >
  $ wceq Z (co W V cpws) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq C (cfv Z cbs) $ >
  $ wceq F (cmpt x3 B2 (cres (cv x3) V)) $ >
  $ wi (w3a (wcel W cgrp) (wcel U X) (wss V U)) (wcel F (co Y Z cghm)) $;

--| Splitting for structure powers, part 3: restriction is a module homomorphism. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem pwssplit3 {x3: setvar} (B2 C U: class) (F: class x3) (V W X Y Z: class):
  $ wceq Y (co W U cpws) $ >
  $ wceq Z (co W V cpws) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq C (cfv Z cbs) $ >
  $ wceq F (cmpt x3 B2 (cres (cv x3) V)) $ >
  $ wi (w3a (wcel W clmod) (wcel U X) (wss V U)) (wcel F (co Y Z clmhm)) $;

--| An isomorphism of left modules is a bijective homomorphism. (Contributed by Stefan O'Rear, 21-Jan-2015.)
theorem islmim (B2 C R S F: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wb (wcel F (co R S clmim)) (wa (wcel F (co R S clmhm)) (wf1o B2 C F)) $;

--| An isomorphism of left modules is a bijection. (Contributed by Stefan O'Rear, 21-Jan-2015.)
theorem lmimf1o (B2 C R S F: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wi (wcel F (co R S clmim)) (wf1o B2 C F) $;

--| An isomorphism of modules is a homomorphism. (Contributed by Stefan O'Rear, 21-Jan-2015.)
theorem lmimlmhm (R S F: class):
  $ wi (wcel F (co R S clmim)) (wcel F (co R S clmhm)) $;

--| An isomorphism of modules is an isomorphism of groups. (Contributed by Stefan O'Rear, 21-Jan-2015.) (Revised by Mario Carneiro, 6-May-2015.)
theorem lmimgim (R S F: class):
  $ wi (wcel F (co R S clmim)) (wcel F (co R S cgim)) $;

--| An isomorphism of left modules is a homomorphism whose converse is a homomorphism. (Contributed by Mario Carneiro, 6-May-2015.)
theorem islmim2 (R S F: class):
  $ wb (wcel F (co R S clmim)) (wa (wcel F (co R S clmhm)) (wcel (ccnv F) (co S R clmhm))) $;

--| The converse of a bijective module homomorphism is a bijective module homomorphism. (Contributed by Stefan O'Rear, 25-Jan-2015.) (Revised by Mario Carneiro, 6-May-2015.)
theorem lmimcnv (S T F: class):
  $ wi (wcel F (co S T clmim)) (wcel (ccnv F) (co T S clmim)) $;

--| The relation "is isomorphic to" for modules. (Contributed by Stefan O'Rear, 25-Jan-2015.)
theorem brlmic (R S: class):
  $ wb (wbr R S clmic) (wne (co R S clmim) c0) $;

--| Prove isomorphic by an explicit isomorphism. (Contributed by Stefan O'Rear, 25-Jan-2015.)
theorem brlmici (R S F: class):
  $ wi (wcel F (co R S clmim)) (wbr R S clmic) $;

--| Isomorphism implies the left side is a module. (Contributed by Stefan O'Rear, 25-Jan-2015.)
theorem lmiclcl (R S: class):
  $ wi (wbr R S clmic) (wcel R clmod) $;

--| Isomorphism implies the right side is a module. (Contributed by Mario Carneiro, 6-May-2015.)
theorem lmicrcl (R S: class):
  $ wi (wbr R S clmic) (wcel S clmod) $;

--| Module isomorphism is symmetric. (Contributed by Stefan O'Rear, 26-Feb-2015.)
theorem lmicsym (R S: class):
  $ wi (wbr R S clmic) (wbr S R clmic) $;

--| Module homomorphism depends only on the module attributes of structures. (Contributed by Mario Carneiro, 8-Oct-2015.)
theorem lmhmpropd {x3 y1: setvar} (ph: wff) (B2 C P Q: class) (F G: class x3 y1) (J K L M: class):
  $ wi ph (wceq B2 (cfv J cbs)) $ >
  $ wi ph (wceq C (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi ph (wceq C (cfv M cbs)) $ >
  $ wi ph (wceq F (cfv J csca)) $ >
  $ wi ph (wceq G (cfv K csca)) $ >
  $ wi ph (wceq F (cfv L csca)) $ >
  $ wi ph (wceq G (cfv M csca)) $ >
  $ wceq P (cfv F cbs) $ >
  $ wceq Q (cfv G cbs) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv J cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) C) (wcel (cv y1) C))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv M cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv J cvsca)) (co (cv x3) (cv y1) (cfv L cvsca))) $ >
  $ wi (wa ph (wa (wcel (cv x3) Q) (wcel (cv y1) C))) (wceq (co (cv x3) (cv y1) (cfv K cvsca)) (co (cv x3) (cv y1) (cfv M cvsca))) $ >
  $ wi ph (wceq (co J K clmhm) (co L M clmhm)) $;

--| Extend class notation with the set of bases for a vector space.
term clbs: class;

--| Define the set of bases to a left module or left vector space. (Contributed by Mario Carneiro, 24-Jun-2014.)
axiom df_lbs {x3 y1 w n s1 b: setvar}:
  $ wceq clbs (cmpt w cvv (crab b (wsbc n (wsbc s1 (wa (wceq (cfv (cv b) (cv n)) (cfv (cv w) cbs)) (wral x3 (wral y1 (wn (wcel (co (cv y1) (cv x3) (cfv (cv w) cvsca)) (cfv (cdif (cv b) (csn (cv x3))) (cv n)))) (cdif (cfv (cv s1) cbs) (csn (cfv (cv s1) c0g)))) (cv b))) (cfv (cv w) csca)) (cfv (cv w) clspn)) (cpw (cfv (cv w) cbs)))) $;

--| The predicate " ` B ` is a basis for the left module or vector space ` W ` ". A subset of the base set is a basis if zero is not in the set, it spans the set, and no nonzero multiple of an element of the basis is in the span of the rest of the family. (Contributed by Mario Carneiro, 24-Jun-2014.) (Revised by Mario Carneiro, 14-Jan-2015.)
theorem islbs {x3 y1: setvar} (B2: class) (c_x: class x3 y1) (F: class) (J: class x3 y1) (K: class x3) (N: class) (V: class x3 y1) (W: class) (X: class x3 y1) (c_0: class x3):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq J (cfv W clbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wi (wcel W X) (wb (wcel B2 J) (w3a (wss B2 V) (wceq (cfv B2 N) V) (wral x3 (wral y1 (wn (wcel (co (cv y1) (cv x3) c_x) (cfv (cdif B2 (csn (cv x3))) N))) (cdif K (csn c_0))) B2))) $;

--| A basis is a set of vectors. (Contributed by Mario Carneiro, 24-Jun-2014.)
theorem lbsss (B2 J V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq J (cfv W clbs) $ >
  $ wi (wcel B2 J) (wss B2 V) $;

--| An element of a basis is a vector. (Contributed by Mario Carneiro, 24-Jun-2014.)
theorem lbsel (B2 E J V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq J (cfv W clbs) $ >
  $ wi (wa (wcel B2 J) (wcel E B2)) (wcel E V) $;

--| The span of a basis is the whole space. (Contributed by Mario Carneiro, 24-Jun-2014.)
theorem lbssp (B2 J N V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq J (cfv W clbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wcel B2 J) (wceq (cfv B2 N) V) $;

--| A basis is linearly independent; that is, every element has a span which trivially intersects the span of the remainder of the basis. (Contributed by Mario Carneiro, 12-Jan-2015.)
theorem lbsind (A2 B2 c_x E F J K N V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq J (cfv W clbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wi (wa (wa (wcel B2 J) (wcel E B2)) (wa (wcel A2 K) (wne A2 c_0))) (wn (wcel (co A2 E c_x) (cfv (cdif B2 (csn E)) N))) $;

--| A basis is linearly independent; that is, every element is not in the span of the remainder of the basis. (Contributed by Mario Carneiro, 25-Jun-2014.) (Revised by Mario Carneiro, 12-Jan-2015.)
theorem lbsind2 (B2 c_1 E F J N W c_0: class):
  $ wceq J (cfv W clbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wi (w3a (wa (wcel W clmod) (wne c_1 c_0)) (wcel B2 J) (wcel E B2)) (wn (wcel E (cfv (cdif B2 (csn E)) N))) $;

--| No proper subset of a basis spans the space. (Contributed by Mario Carneiro, 25-Jun-2014.)
theorem lbspss (B2 C c_1 F J N V W c_0: class):
  $ wceq J (cfv W clbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wceq V (cfv W cbs) $ >
  $ wi (w3a (wa (wcel W clmod) (wne c_1 c_0)) (wcel B2 J) (wpss C B2)) (wne (cfv C N) V) $;

--| The sum of two subspaces is a subspace. (Contributed by NM, 4-Feb-2014.) (Revised by Mario Carneiro, 19-Apr-2016.)
theorem lsmcl (c_po S T U W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wi (w3a (wcel W clmod) (wcel T S) (wcel U S)) (wcel (co T U c_po) S) $;

--| Member of subspace sum of spans of singletons. (Contributed by NM, 8-Apr-2015.)
theorem lsmspsn {j k: setvar} (ph: wff) (c_pl: class) (c_po: class j k) (c_x U F K N V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wb (wcel U (co (cfv (csn X) N) (cfv (csn Y) N) c_po)) (wrex j (wrex k (wceq U (co (co (cv j) X c_x) (co (cv k) Y c_x) c_pl)) K) K)) $;

--| Subspace sum membership in terms of a sum of 1-dim subspaces (atoms), which can be useful for treating subspaces as projective lattice elements. (Contributed by NM, 9-Aug-2014.)
theorem lsmelval2 {y1 z: setvar} (ph: wff) (c_po: class) (S: class y1 z) (T U: class) (N: class y1 z) (V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wb (wcel X (co T U c_po)) (wa (wcel X V) (wrex y1 (wrex z (wss (cfv (csn X) N) (co (cfv (csn (cv y1)) N) (cfv (csn (cv z)) N) c_po)) U) T))) $;

--| Subspace sum in terms of span. (Contributed by NM, 6-Feb-2014.) (Proof shortened by Mario Carneiro, 21-Jun-2014.)
theorem lsmsp (c_po S T U N W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wi (w3a (wcel W clmod) (wcel T S) (wcel U S)) (wceq (co T U c_po) (cfv (cun T U) N)) $;

--| Subspace sum of spans of subsets is the span of their union. ( ~ spanuni analog.) (Contributed by NM, 22-Feb-2014.) (Revised by Mario Carneiro, 21-Jun-2014.)
theorem lsmsp2 (c_po T U N V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wi (w3a (wcel W clmod) (wss T V) (wss U V)) (wceq (co (cfv T N) (cfv U N) c_po) (cfv (cun T U) N)) $;

--| Subspace sum (in its extended domain) is a subset of the span of the union of its arguments. (Contributed by NM, 6-Aug-2014.)
theorem lsmssspx (ph: wff) (c_po T U N V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wi ph (wss T V) $ >
  $ wi ph (wss U V) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wss (co T U c_po) (cfv (cun T U) N)) $;

--| The span of a pair of vectors equals the sum of the spans of their singletons. (Contributed by NM, 13-Jan-2015.)
theorem lsmpr (ph: wff) (c_po N V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wceq (cfv (cpr X Y) N) (co (cfv (csn X) N) (cfv (csn Y) N) c_po)) $;

--| A vector expressed as a sum belongs to the span of its components. (Contributed by NM, 9-Apr-2015.)
theorem lsppreli (ph: wff) (A2 B2 c_pl c_x F K N V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wcel B2 K) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel (co (co A2 X c_x) (co B2 Y c_x) c_pl) (cfv (cpr X Y) N)) $;

--| Two ways to say that a vector belongs to the span of a pair of vectors. (Contributed by NM, 14-Jan-2015.)
theorem lsmelpr (ph: wff) (c_po N V W X Y Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wb (wcel X (cfv (cpr Y Z) N)) (wss (cfv (csn X) N) (co (cfv (csn Y) N) (cfv (csn Z) N) c_po))) $;

--| The span of a vector paired with zero equals the span of the singleton of the vector. (Contributed by NM, 29-Aug-2014.)
theorem lsppr0 (ph: wff) (N V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (cfv (cpr X c_0) N) (cfv (csn X) N)) $;

--| Span of a pair of vectors. (Contributed by NM, 22-Aug-2014.)
theorem lsppr {v k l: setvar} (ph: wff) (c_pl c_x F K: class v) (N: class) (V: class v) (W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wceq (cfv (cpr X Y) N) (cab v (wrex k (wrex l (wceq (cv v) (co (co (cv k) X c_x) (co (cv l) Y c_x) c_pl)) K) K))) $;

--| Member of the span of a pair of vectors. (Contributed by NM, 10-Apr-2015.)
theorem lspprel {k l: setvar} (ph: wff) (c_pl c_x F K N V W X Y Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wb (wcel Z (cfv (cpr X Y) N)) (wrex k (wrex l (wceq Z (co (co (cv k) X c_x) (co (cv l) Y c_x) c_pl)) K) K)) $;

--| Absorption of vector sum into span of pair. (Contributed by NM, 27-Apr-2015.)
theorem lspprabs (ph: wff) (c_pl N V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wceq (cfv (cpr X (co X Y c_pl)) N) (cfv (cpr X Y) N)) $;

--| The span of a vector sum is included in the span of its arguments. (Contributed by NM, 22-Feb-2014.) (Proof shortened by Mario Carneiro, 21-Jun-2014.)
theorem lspvadd (c_pl N V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (w3a (wcel W clmod) (wcel X V) (wcel Y V)) (wss (cfv (csn (co X Y c_pl)) N) (cfv (cpr X Y) N)) $;

--| Triangle-type inequality for span of a singleton. (Contributed by NM, 24-Feb-2014.) (Revised by Mario Carneiro, 21-Jun-2014.)
theorem lspsntri (c_pl c_po N V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wi (w3a (wcel W clmod) (wcel X V) (wcel Y V)) (wss (cfv (csn (co X Y c_pl)) N) (co (cfv (csn X) N) (cfv (csn Y) N) c_po)) $;

--| Triangle-type inequality for span of a singleton of vector difference. (Contributed by NM, 25-Apr-2014.) (Revised by Mario Carneiro, 21-Jun-2014.)
theorem lspsntrim (c_po c_mi N V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (w3a (wcel W clmod) (wcel X V) (wcel Y V)) (wss (cfv (csn (co X Y c_mi)) N) (co (cfv (csn X) N) (cfv (csn Y) N) c_po)) $;

--| If two structures have the same components (properties), they have the same set of bases. (Contributed by Mario Carneiro, 9-Feb-2015.) (Revised by Mario Carneiro, 14-Jun-2015.) (Revised by AV, 24-Apr-2024.)
theorem lbspropd {x3 y1: setvar} (ph: wff) (B2 P F G K L W: class) (X Y: class x3 y1):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi ph (wss B2 W) $ >
  $ wi (wa ph (wa (wcel (cv x3) W) (wcel (cv y1) W))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) B2))) (wcel (co (cv x3) (cv y1) (cfv K cvsca)) W) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cvsca)) (co (cv x3) (cv y1) (cfv L cvsca))) $ >
  $ wceq F (cfv K csca) $ >
  $ wceq G (cfv L csca) $ >
  $ wi ph (wceq P (cfv F cbs)) $ >
  $ wi ph (wceq P (cfv G cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) P))) (wceq (co (cv x3) (cv y1) (cfv F cplusg)) (co (cv x3) (cv y1) (cfv G cplusg))) $ >
  $ wi ph (wcel K X) $ >
  $ wi ph (wcel L Y) $ >
  $ wi ph (wceq (cfv K clbs) (cfv L clbs)) $;

--| The left projection function is a linear operator. (Contributed by Mario Carneiro, 15-Oct-2015.) (Revised by Mario Carneiro, 21-Apr-2016.)
theorem pj1lmhm (ph: wff) (P c_po T U L W c_0: class):
  $ wceq L (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq P (cfv W cpj1) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel T L) $ >
  $ wi ph (wcel U L) $ >
  $ wi ph (wceq (cin T U) (csn c_0)) $ >
  $ wi ph (wcel (co T U P) (co (co W (co T U c_po) cress) W clmhm)) $;

--| The left projection function is a linear operator. (Contributed by Mario Carneiro, 15-Oct-2015.) (Revised by Mario Carneiro, 21-Apr-2016.)
theorem pj1lmhm2 (ph: wff) (P c_po T U L W c_0: class):
  $ wceq L (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq P (cfv W cpj1) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel T L) $ >
  $ wi ph (wcel U L) $ >
  $ wi ph (wceq (cin T U) (csn c_0)) $ >
  $ wi ph (wcel (co T U P) (co (co W (co T U c_po) cress) (co W T cress) clmhm)) $;

--| Extend class notation with class of all left vector spaces.
term clvec: class;

--| Define the class of all left vector spaces. A left vector space over a division ring is an Abelian group (vectors) together with a division ring (scalars) and a left scalar product connecting them. Some authors call this a "left module over a division ring", reserving "vector space" for those where the division ring is commutative, i.e., is a field. (Contributed by NM, 11-Nov-2013.)
axiom df_lvec {f2: setvar}:
  $ wceq clvec (crab f2 (wcel (cfv (cv f2) csca) cdr) clmod) $;

--| The predicate "is a left vector space". (Contributed by NM, 11-Nov-2013.)
theorem islvec (F W: class):
  $ wceq F (cfv W csca) $ >
  $ wb (wcel W clvec) (wa (wcel W clmod) (wcel F cdr)) $;

--| The set of scalars of a left vector space is a division ring. (Contributed by NM, 17-Apr-2014.)
theorem lvecdrng (F W: class):
  $ wceq F (cfv W csca) $ >
  $ wi (wcel W clvec) (wcel F cdr) $;

--| A left vector space is a left module. (Contributed by NM, 9-Dec-2013.)
theorem lveclmod (W: class):
  $ wi (wcel W clvec) (wcel W clmod) $;

--| A vector space is a left module. (Contributed by SN, 16-May-2024.)
theorem lveclmodd (ph: wff) (W: class):
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel W clmod) $;

--| A vector space is a group. (Contributed by SN, 16-May-2024.)
theorem lvecgrpd (ph: wff) (W: class):
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel W cgrp) $;

--| A vector subspace is a vector space. (Contributed by NM, 14-Mar-2015.)
theorem lsslvec (S U W X: class):
  $ wceq X (co W U cress) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wa (wcel W clvec) (wcel U S)) (wcel X clvec) $;

--| The property for modules to be vector spaces is invariant under module isomorphism. (Contributed by Steven Nguyen, 15-Aug-2023.)
theorem lmhmlvec (S T F: class):
  $ wi (wcel F (co S T clmhm)) (wb (wcel S clvec) (wcel T clvec)) $;

--| If a scalar product is zero, one of its factors must be zero. ( ~ hvmul0or analog.) (Contributed by NM, 2-Jul-2014.)
theorem lvecvs0or (ph: wff) (A2 c_x F K O V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq O (cfv F c0g) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wb (wceq (co A2 X c_x) c_0) (wo (wceq A2 O) (wceq X c_0))) $;

--| A scalar product is nonzero iff both of its factors are nonzero. (Contributed by NM, 3-Jan-2015.)
theorem lvecvsn0 (ph: wff) (A2 c_x F K O V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq O (cfv F c0g) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wb (wne (co A2 X c_x) c_0) (wa (wne A2 O) (wne X c_0))) $;

--| If a scalar product belongs to a subspace, either the scalar component is zero or the vector component also belongs to the subspace. (Contributed by NM, 5-Apr-2015.)
theorem lssvs0or (ph: wff) (A2 S c_x U F K V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wceq S (cfv W clss) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wb (wcel (co A2 X c_x) U) (wo (wceq A2 c_0) (wcel X U))) $;

--| Cancellation law for scalar multiplication. ( ~ hvmulcan analog.) (Contributed by NM, 2-Jul-2014.)
theorem lvecvscan (ph: wff) (A2 c_x F K V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wne A2 c_0) $ >
  $ wi ph (wb (wceq (co A2 X c_x) (co A2 Y c_x)) (wceq X Y)) $;

--| Cancellation law for scalar multiplication. ( ~ hvmulcan2 analog.) (Contributed by NM, 2-Jul-2014.)
theorem lvecvscan2 (ph: wff) (A2 B2 c_x F K V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wcel B2 K) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wb (wceq (co A2 X c_x) (co B2 X c_x)) (wceq A2 B2)) $;

--| Invert coefficient of scalar product. (Contributed by NM, 11-Apr-2015.)
theorem lvecinv (ph: wff) (A2 c_x F I K V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wceq I (cfv F cinvr) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel A2 (cdif K (csn c_0))) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wb (wceq X (co A2 Y c_x)) (wceq Y (co (cfv A2 I) X c_x))) $;

--| A nonzero scalar product does not change the span of a singleton. ( ~ spansncol analog.) (Contributed by NM, 23-Apr-2014.)
theorem lspsnvs (R c_x F K N V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (w3a (wcel W clvec) (wa (wcel R K) (wne R c_0)) (wcel X V)) (wceq (cfv (csn (co R X c_x)) N) (cfv (csn X) N)) $;

--| Membership relation that implies equality of spans. ( ~ spansneleq analog.) (Contributed by NM, 4-Jul-2014.)
theorem lspsneleq (ph: wff) (N V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y (cfv (csn X) N)) $ >
  $ wi ph (wne Y c_0) $ >
  $ wi ph (wceq (cfv (csn Y) N) (cfv (csn X) N)) $;

--| Comparable spans of nonzero singletons are equal. (Contributed by NM, 27-Apr-2015.)
theorem lspsncmp (ph: wff) (N V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wb (wss (cfv (csn X) N) (cfv (csn Y) N)) (wceq (cfv (csn X) N) (cfv (csn Y) N))) $;

--| Two ways to express that vectors have different spans. (Contributed by NM, 28-May-2015.)
theorem lspsnne1 (ph: wff) (N V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wn (wcel X (cfv (csn Y) N))) $;

--| Two ways to express that vectors have different spans. (Contributed by NM, 20-May-2015.)
theorem lspsnne2 (ph: wff) (N V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wn (wcel X (cfv (csn Y) N))) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $;

--| Swap two vectors with different spans. (Contributed by NM, 20-May-2015.)
theorem lspsnnecom (ph: wff) (N V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wn (wcel X (cfv (csn Y) N))) $ >
  $ wi ph (wn (wcel Y (cfv (csn X) N))) $;

--| Absorption law for span of vector sum. (Contributed by NM, 30-Apr-2015.)
theorem lspabs2 (ph: wff) (c_pl N V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wceq (cfv (csn X) N) (cfv (csn (co X Y c_pl)) N)) $ >
  $ wi ph (wceq (cfv (csn X) N) (cfv (csn Y) N)) $;

--| Absorption law for span of vector sum. (Contributed by NM, 30-Apr-2015.)
theorem lspabs3 (ph: wff) (c_pl N V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wne (co X Y c_pl) c_0) $ >
  $ wi ph (wceq (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wceq (cfv (csn X) N) (cfv (csn (co X Y c_pl)) N)) $;

--| Equal spans of singletons must have proportional vectors. See ~ lspsnss2 for comparable span version. TODO: can proof be shortened? (Contributed by NM, 21-Mar-2015.)
theorem lspsneq {k: setvar} (ph: wff k) (S: class k) (c_x K: class) (N V W: class k) (X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W csca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wb (wceq (cfv (csn X) N) (cfv (csn Y) N)) (wrex k (wceq X (co (cv k) Y c_x)) (cdif K (csn c_0)))) $;

--| Nonzero vectors with equal singleton spans have a unique proportionality constant. (Contributed by NM, 31-May-2015.)
theorem lspsneu {k: setvar} (ph: wff k) (S: class k) (c_x K: class) (N: class k) (O: class) (V W: class k) (X Y: class) (c_0: class k):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W csca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq O (cfv S c0g) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wb (wceq (cfv (csn X) N) (cfv (csn Y) N)) (wreu k (wceq X (co (cv k) Y c_x)) (cdif K (csn O)))) $;

--| A member of the span of the singleton of a vector is a member of a subspace containing the vector. ( ~ elspansn4 analog.) (Contributed by NM, 4-Jul-2014.)
theorem ellspsn4 (ph: wff) (S U N V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y (cfv (csn X) N)) $ >
  $ wi ph (wne Y c_0) $ >
  $ wi ph (wb (wcel X U) (wcel Y U)) $;

--| The span of a vector not in a subspace is disjoint with the subspace. (Contributed by NM, 6-Apr-2015.)
theorem lspdisj (ph: wff) (S U N V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq S (cfv W clss) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wn (wcel X U)) $ >
  $ wi ph (wceq (cin (cfv (csn X) N) U) (csn c_0)) $;

--| A nonzero vector is not in a subspace iff its span is disjoint with the subspace. (Contributed by NM, 23-Apr-2015.)
theorem lspdisjb (ph: wff) (S U N V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq S (cfv W clss) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wb (wn (wcel X U)) (wceq (cin (cfv (csn X) N) U) (csn c_0))) $;

--| Unequal spans are disjoint (share only the zero vector). (Contributed by NM, 22-Mar-2015.)
theorem lspdisj2 (ph: wff) (N V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wceq (cin (cfv (csn X) N) (cfv (csn Y) N)) (csn c_0)) $;

--| Show membership in the span of the sum of two vectors, one of which ( ` Y ` ) is fixed in advance. (Contributed by NM, 27-May-2015.) (Revised by AV, 12-Jul-2022.)
theorem lspfixed {z: setvar} (ph: wff z) (c_pl N: class) (V: class z) (W X Y c_0 Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wn (wcel X (cfv (csn Y) N))) $ >
  $ wi ph (wn (wcel X (cfv (csn Z) N))) $ >
  $ wi ph (wcel X (cfv (cpr Y Z) N)) $ >
  $ wi ph (wrex z (wcel X (cfv (csn (co Y (cv z) c_pl)) N)) (cdif (cfv (csn Z) N) (csn c_0))) $;

--| Exchange property for span of a pair. TODO: see if a version with Y,Z and X,Z reversed will shorten proofs (analogous to ~ lspexchn1 versus ~ lspexchn2 ); look for ~ lspexch and ~ prcom in same proof. TODO: would a hypothesis of ` -. X e. ( N `` { Z } ) ` instead of ` ( N `` { X } ) =/= ( N `` { Z } ) ` be better overall? This would be shorter and also satisfy the ` X =/= .0. ` condition. Here and also lspindp* and all proofs affected by them (all in NM's mathbox); there are 58 hypotheses with the ` =/= ` pattern as of 24-May-2015. (Contributed by NM, 11-Apr-2015.)
theorem lspexch (ph: wff) (N V W X Y c_0 Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Z) N)) $ >
  $ wi ph (wcel X (cfv (cpr Y Z) N)) $ >
  $ wi ph (wcel Y (cfv (cpr X Z) N)) $;

--| Exchange property for span of a pair with negated membership. TODO: look at uses of ~ lspexch to see if this will shorten proofs. (Contributed by NM, 20-May-2015.)
theorem lspexchn1 (ph: wff) (N V W X Y Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wn (wcel Y (cfv (csn Z) N))) $ >
  $ wi ph (wn (wcel X (cfv (cpr Y Z) N))) $ >
  $ wi ph (wn (wcel Y (cfv (cpr X Z) N))) $;

--| Exchange property for span of a pair with negated membership. TODO: look at uses of ~ lspexch to see if this will shorten proofs. (Contributed by NM, 24-May-2015.)
theorem lspexchn2 (ph: wff) (N V W X Y Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wn (wcel Y (cfv (csn Z) N))) $ >
  $ wi ph (wn (wcel X (cfv (cpr Z Y) N))) $ >
  $ wi ph (wn (wcel Y (cfv (cpr Z X) N))) $;

--| Partial independence property. (Contributed by NM, 23-Apr-2015.)
theorem lspindpi (ph: wff) (N V W X Y Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wn (wcel X (cfv (cpr Y Z) N))) $ >
  $ wi ph (wa (wne (cfv (csn X) N) (cfv (csn Y) N)) (wne (cfv (csn X) N) (cfv (csn Z) N))) $;

--| Alternate way to say 3 vectors are mutually independent (swap 1st and 2nd). (Contributed by NM, 11-Apr-2015.)
theorem lspindp1 (ph: wff) (N V W X Y c_0 Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wn (wcel Z (cfv (cpr X Y) N))) $ >
  $ wi ph (wa (wne (cfv (csn Z) N) (cfv (csn Y) N)) (wn (wcel X (cfv (cpr Z Y) N)))) $;

--| Alternate way to say 3 vectors are mutually independent (rotate left). (Contributed by NM, 10-May-2015.)
theorem lspindp2l (ph: wff) (N V W X Y c_0 Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wn (wcel Z (cfv (cpr X Y) N))) $ >
  $ wi ph (wa (wne (cfv (csn Y) N) (cfv (csn Z) N)) (wn (wcel X (cfv (cpr Y Z) N)))) $;

--| Alternate way to say 3 vectors are mutually independent (rotate right). (Contributed by NM, 12-Apr-2015.)
theorem lspindp2 (ph: wff) (N V W X Y c_0 Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wn (wcel Z (cfv (cpr X Y) N))) $ >
  $ wi ph (wa (wne (cfv (csn Z) N) (cfv (csn X) N)) (wn (wcel Y (cfv (cpr Z X) N)))) $;

--| Independence of 2 vectors is preserved by vector sum. (Contributed by NM, 26-Apr-2015.)
theorem lspindp3 (ph: wff) (c_pl N V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn (co X Y c_pl)) N)) $;

--| (Partial) independence of 3 vectors is preserved by vector sum. (Contributed by NM, 26-Apr-2015.)
theorem lspindp4 (ph: wff) (c_pl N V W X Y Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wn (wcel Z (cfv (cpr X Y) N))) $ >
  $ wi ph (wn (wcel Z (cfv (cpr X (co X Y c_pl)) N))) $;

--| Compute the ` X ` coefficient in a sum with an independent vector ` X ` (first conjunct), which can then be removed to continue with the remaining vectors summed in expressions ` Y ` and ` Z ` (second conjunct). Typically, ` U ` is the span of the remaining vectors. (Contributed by NM, 5-Apr-2015.) (Revised by Mario Carneiro, 21-Apr-2016.) (Proof shortened by AV, 19-Jul-2022.)
theorem lvecindp (ph: wff) (A2 B2 c_pl S c_x U F K V W X Y Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq S (cfv W clss) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wn (wcel X U)) $ >
  $ wi ph (wcel Y U) $ >
  $ wi ph (wcel Z U) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wcel B2 K) $ >
  $ wi ph (wceq (co (co A2 X c_x) Y c_pl) (co (co B2 X c_x) Z c_pl)) $ >
  $ wi ph (wa (wceq A2 B2) (wceq Y Z)) $;

--| Sums of independent vectors must have equal coefficients. (Contributed by NM, 22-Mar-2015.)
theorem lvecindp2 (ph: wff) (A2 B2 C D c_pl c_x F K N V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wcel B2 K) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wcel D K) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wceq (co (co A2 X c_x) (co B2 Y c_x) c_pl) (co (co C X c_x) (co D Y c_x) c_pl)) $ >
  $ wi ph (wa (wceq A2 C) (wceq B2 D)) $;

--| Unequal singleton spans imply nonzero vector subtraction. (Contributed by NM, 19-Mar-2015.)
theorem lspsnsubn0 (ph: wff) (c_mi N V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wne (co X Y c_mi) c_0) $;

--| Subspace sum has the covering property (using spans of singletons to represent atoms). Similar to Exercise 5 of [Kalmbach] p. 153. ( ~ spansncvi analog.) TODO: ugly proof; can it be shortened? (Contributed by NM, 2-Oct-2014.)
theorem lsmcv (ph: wff) (c_po S T U N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X V) $ >
  $ wi (w3a ph (wpss T U) (wss U (co T (cfv (csn X) N) c_po))) (wceq U (co T (cfv (csn X) N) c_po)) $;

--| Lemma for ~ lspsolv . (Contributed by Mario Carneiro, 25-Jun-2014.)
theorem lspsolvlem {z r: setvar} (ph: wff r) (A2 B2 c_pl: class) (Q: class z r) (S: class z) (c_x: class) (F: class z) (N V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq Q (crab z (wrex r (wcel (co (cv z) (co (cv r) Y c_x) c_pl) (cfv A2 N)) B2) V) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wss A2 V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel X (cfv (cun A2 (csn Y)) N)) $ >
  $ wi ph (wrex r (wcel (co X (co (cv r) Y c_x) c_pl) (cfv A2 N)) B2) $;

--| If ` X ` is in the span of ` A u. { Y } ` but not ` A ` , then ` Y ` is in the span of ` A u. { X } ` . (Contributed by Mario Carneiro, 25-Jun-2014.)
theorem lspsolv (A2 S N V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (wcel W clvec) (w3a (wss A2 V) (wcel Y V) (wcel X (cdif (cfv (cun A2 (csn Y)) N) (cfv A2 N))))) (wcel Y (cfv (cun A2 (csn X)) N)) $;

--| In a vector space, subspaces form an algebraic closure system whose closure operator has the exchange property. Strengthening of ~ lssacs by ~ lspsolv . (Contributed by David Moews, 1-May-2017.)
theorem lssacsex {y1 z s1: setvar} (A2 N: class y1 z s1) (W: class) (X: class s1):
  $ wceq A2 (cfv W clss) $ >
  $ wceq N (cfv A2 cmrc) $ >
  $ wceq X (cfv W cbs) $ >
  $ wi (wcel W clvec) (wa (wcel A2 (cfv X cacs)) (wral s1 (wral y1 (wral z (wcel (cv y1) (cfv (cun (cv s1) (csn (cv z))) N)) (cdif (cfv (cun (cv s1) (csn (cv y1))) N) (cfv (cv s1) N))) X) (cpw X))) $;

--| There is no subspace strictly between the zero subspace and the span of a vector (i.e. a 1-dimensional subspace is an atom). ( ~ h1datomi analog.) (Contributed by NM, 20-Apr-2014.) (Proof shortened by Mario Carneiro, 22-Jun-2014.)
theorem lspsnat (S U N V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (w3a (wcel W clvec) (wcel U S) (wcel X V)) (wss U (cfv (csn X) N))) (wo (wceq U (cfv (csn X) N)) (wceq U (csn c_0))) $;

--| The span of a singleton covers the zero subspace, using Definition 3.2.18 of [PtakPulmannova] p. 68 for "covers".) (Contributed by NM, 12-Aug-2014.) (Revised by AV, 13-Jul-2022.)
theorem lspsncv0 {y1: setvar} (ph: wff) (S N V W X c_0: class y1):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wn (wrex y1 (wa (wpss (csn c_0) (cv y1)) (wpss (cv y1) (cfv (csn X) N))) S)) $;

--| Lemma for ~ lspprat . Let ` x e. ( U \ { 0 } ) ` (if there is no such ` x ` then ` U ` is the zero subspace), and let ` y e. ( U \ ( N `` { x } ) ) ` (assuming the conclusion is false). The goal is to write ` X ` , ` Y ` in terms of ` x ` , ` y ` , which would normally be done by solving the system of linear equations. The span equivalent of this process is ~ lspsolv (hence the name), which we use extensively below. In this lemma, we show that since ` x e. ( N `` { X , Y } ) ` , either ` x e. ( N `` { Y } ) ` or ` X e. ( N `` { x , Y } ) ` . (Contributed by NM, 29-Aug-2014.)
theorem lsppratlem1 {x3 y1: setvar} (ph: wff x3 y1) (S U N V W X Y c_0: class x3 y1):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wpss U (cfv (cpr X Y) N)) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel (cv x3) (cdif U (csn c_0))) $ >
  $ wi ph (wcel (cv y1) (cdif U (cfv (csn (cv x3)) N))) $ >
  $ wi ph (wo (wcel (cv x3) (cfv (csn Y) N)) (wcel X (cfv (cpr (cv x3) Y) N))) $;

--| Lemma for ~ lspprat . Show that if ` X ` and ` Y ` are both in ` ( N `` { x , y } ) ` (which will be our goal for each of the two cases above), then ` ( N `` { X , Y } ) C_ U ` , contradicting the hypothesis for ` U ` . (Contributed by NM, 29-Aug-2014.) (Revised by Mario Carneiro, 5-Sep-2014.)
theorem lsppratlem2 {x3 y1: setvar} (ph: wff x3 y1) (S U N V W X Y c_0: class x3 y1):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wpss U (cfv (cpr X Y) N)) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel (cv x3) (cdif U (csn c_0))) $ >
  $ wi ph (wcel (cv y1) (cdif U (cfv (csn (cv x3)) N))) $ >
  $ wi ph (wcel X (cfv (cpr (cv x3) (cv y1)) N)) $ >
  $ wi ph (wcel Y (cfv (cpr (cv x3) (cv y1)) N)) $ >
  $ wi ph (wss (cfv (cpr X Y) N) U) $;

--| Lemma for ~ lspprat . In the first case of ~ lsppratlem1 , since ` x e/ ( N `` (/) ) ` , also ` Y e. ( N `` { x } ) ` , and since ` y e. ( N `` { X , Y } ) C_ ( N `` { X , x } ) ` and ` y e/ ( N `` { x } ) ` , we have ` X e. ( N `` { x , y } ) ` as desired. (Contributed by NM, 29-Aug-2014.)
theorem lsppratlem3 {x3 y1: setvar} (ph: wff x3 y1) (S U N V W X Y c_0: class x3 y1):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wpss U (cfv (cpr X Y) N)) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel (cv x3) (cdif U (csn c_0))) $ >
  $ wi ph (wcel (cv y1) (cdif U (cfv (csn (cv x3)) N))) $ >
  $ wi ph (wcel (cv x3) (cfv (csn Y) N)) $ >
  $ wi ph (wa (wcel X (cfv (cpr (cv x3) (cv y1)) N)) (wcel Y (cfv (cpr (cv x3) (cv y1)) N))) $;

--| Lemma for ~ lspprat . In the second case of ~ lsppratlem1 , ` y e. ( N `` { X , Y } ) C_ ( N `` { x , Y } ) ` and ` y e/ ( N `` { x } ) ` implies ` Y e. ( N `` { x , y } ) ` and thus ` X e. ( N `` { x , Y } ) C_ ( N `` { x , y } ) ` as well. (Contributed by NM, 29-Aug-2014.)
theorem lsppratlem4 {x3 y1: setvar} (ph: wff x3 y1) (S U N V W X Y c_0: class x3 y1):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wpss U (cfv (cpr X Y) N)) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel (cv x3) (cdif U (csn c_0))) $ >
  $ wi ph (wcel (cv y1) (cdif U (cfv (csn (cv x3)) N))) $ >
  $ wi ph (wcel X (cfv (cpr (cv x3) Y) N)) $ >
  $ wi ph (wa (wcel X (cfv (cpr (cv x3) (cv y1)) N)) (wcel Y (cfv (cpr (cv x3) (cv y1)) N))) $;

--| Lemma for ~ lspprat . Combine the two cases and show a contradiction to ` U C. ( N `` { X , Y } ) ` under the assumptions on ` x ` and ` y ` . (Contributed by NM, 29-Aug-2014.)
theorem lsppratlem5 {x3 y1: setvar} (ph: wff x3 y1) (S U N V W X Y c_0: class x3 y1):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wpss U (cfv (cpr X Y) N)) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel (cv x3) (cdif U (csn c_0))) $ >
  $ wi ph (wcel (cv y1) (cdif U (cfv (csn (cv x3)) N))) $ >
  $ wi ph (wss (cfv (cpr X Y) N) U) $;

--| Lemma for ~ lspprat . Negating the assumption on ` y ` , we arrive close to the desired conclusion. (Contributed by NM, 29-Aug-2014.)
theorem lsppratlem6 {x3: setvar} (ph: wff x3) (S U N V W X Y c_0: class x3):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wpss U (cfv (cpr X Y) N)) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wi (wcel (cv x3) (cdif U (csn c_0))) (wceq U (cfv (csn (cv x3)) N))) $;

--| A proper subspace of the span of a pair of vectors is the span of a singleton (an atom) or the zero subspace (if ` z ` is zero). Proof suggested by Mario Carneiro, 28-Aug-2014. (Contributed by NM, 29-Aug-2014.)
theorem lspprat {z: setvar} (ph: wff) (S: class z) (U N V W: class) (X Y: class z):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wpss U (cfv (cpr X Y) N)) $ >
  $ wi ph (wrex z (wceq U (cfv (csn (cv z)) N)) V) $;

--| An equivalent formulation of the basis predicate in a vector space: a subset is a basis iff no element is in the span of the rest of the set. (Contributed by Mario Carneiro, 14-Jan-2015.)
theorem islbs2 {x3: setvar} (B2 J N V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq J (cfv W clbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wcel W clvec) (wb (wcel B2 J) (w3a (wss B2 V) (wceq (cfv B2 N) V) (wral x3 (wn (wcel (cv x3) (cfv (cdif B2 (csn (cv x3))) N))) B2))) $;

--| An equivalent formulation of the basis predicate: a subset is a basis iff it is a minimal spanning set. (Contributed by Mario Carneiro, 25-Jun-2014.)
theorem islbs3 {s1: setvar} (B2 J N V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq J (cfv W clbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wcel W clvec) (wb (wcel B2 J) (w3a (wss B2 V) (wceq (cfv B2 N) V) (wal s1 (wi (wpss (cv s1) B2) (wpss (cfv (cv s1) N) V))))) $;

--| Being a basis in a vector space is equivalent to being a basis in the associated algebraic closure system. Equivalent to ~ islbs2 . (Contributed by David Moews, 1-May-2017.)
theorem lbsacsbs (A2 S I J N W X: class):
  $ wceq A2 (cfv W clss) $ >
  $ wceq N (cfv A2 cmrc) $ >
  $ wceq X (cfv W cbs) $ >
  $ wceq I (cfv A2 cmri) $ >
  $ wceq J (cfv W clbs) $ >
  $ wi (wcel W clvec) (wb (wcel S J) (wa (wcel S I) (wceq (cfv S N) X))) $;

--| The dimension theorem for vector spaces: any two bases of the same vector space are equinumerous. Proven by using ~ lssacsex and ~ lbsacsbs to show that being a basis for a vector space is equivalent to being a basis for the associated algebraic closure system, and then using ~ acsexdimd . (Contributed by David Moews, 1-May-2017.)
theorem lvecdim (S T J W: class):
  $ wceq J (cfv W clbs) $ >
  $ wi (w3a (wcel W clvec) (wcel S J) (wcel T J)) (wbr S T cen) $;

--| Lemma for ~ lbsext . The set ` S ` is the set of all linearly independent sets containing ` C ` ; we show here that it is nonempty. (Contributed by Mario Carneiro, 25-Jun-2014.)
theorem lbsextlem1 {x3 z: setvar} (ph: wff z) (C: class) (S J: class z) (N V: class) (W: class z):
  $ wceq V (cfv W cbs) $ >
  $ wceq J (cfv W clbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wss C V) $ >
  $ wi ph (wral x3 (wn (wcel (cv x3) (cfv (cdif C (csn (cv x3))) N))) C) $ >
  $ wceq S (crab z (wa (wss C (cv z)) (wral x3 (wn (wcel (cv x3) (cfv (cdif (cv z) (csn (cv x3))) N))) (cv z))) (cpw V)) $ >
  $ wi ph (wne S c0) $;

--| Lemma for ~ lbsext . Since ` A ` is a chain (actually, we only need it to be closed under binary union), the union ` T ` of the spans of each individual element of ` A ` is a subspace, and it contains all of ` U. A ` (except for our target vector ` x ` - we are trying to make ` x ` a linear combination of all the other vectors in some set from ` A ` ). (Contributed by Mario Carneiro, 25-Jun-2014.)
theorem lbsextlem2 {x3 z u: setvar} (ph: wff z) (A2: class) (C: class u) (P: class x3 z u) (S: class z) (T: class x3 z u) (J: class z u) (N V: class) (W: class z):
  $ wceq V (cfv W cbs) $ >
  $ wceq J (cfv W clbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wss C V) $ >
  $ wi ph (wral x3 (wn (wcel (cv x3) (cfv (cdif C (csn (cv x3))) N))) C) $ >
  $ wceq S (crab z (wa (wss C (cv z)) (wral x3 (wn (wcel (cv x3) (cfv (cdif (cv z) (csn (cv x3))) N))) (cv z))) (cpw V)) $ >
  $ wceq P (cfv W clss) $ >
  $ wi ph (wss A2 S) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wor A2 crpss) $ >
  $ wceq T (ciun u A2 (cfv (cdif (cv u) (csn (cv x3))) N)) $ >
  $ wi ph (wa (wcel T P) (wss (cdif (cuni A2) (csn (cv x3))) T)) $;

--| Lemma for ~ lbsext . A chain in ` S ` has an upper bound in ` S ` . (Contributed by Mario Carneiro, 25-Jun-2014.)
theorem lbsextlem3 {x3 z u: setvar} (ph: wff z) (A2: class) (C: class u) (P: class x3 z u) (S: class z) (T: class x3 z u) (J: class z u) (N V: class) (W: class z):
  $ wceq V (cfv W cbs) $ >
  $ wceq J (cfv W clbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wss C V) $ >
  $ wi ph (wral x3 (wn (wcel (cv x3) (cfv (cdif C (csn (cv x3))) N))) C) $ >
  $ wceq S (crab z (wa (wss C (cv z)) (wral x3 (wn (wcel (cv x3) (cfv (cdif (cv z) (csn (cv x3))) N))) (cv z))) (cpw V)) $ >
  $ wceq P (cfv W clss) $ >
  $ wi ph (wss A2 S) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wor A2 crpss) $ >
  $ wceq T (ciun u A2 (cfv (cdif (cv u) (csn (cv x3))) N)) $ >
  $ wi ph (wcel (cuni A2) S) $;

--| Lemma for ~ lbsext . ~ lbsextlem3 satisfies the conditions for the application of Zorn's lemma ~ zorn (thus invoking AC), and so there is a maximal linearly independent set extending ` C ` . Here we prove that such a set is a basis. (Contributed by Mario Carneiro, 25-Jun-2014.)
theorem lbsextlem4 {x3 z s1: setvar} (ph: wff z) (C: class s1) (S: class z) (J: class z s1) (N V: class s1) (W: class z s1):
  $ wceq V (cfv W cbs) $ >
  $ wceq J (cfv W clbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wss C V) $ >
  $ wi ph (wral x3 (wn (wcel (cv x3) (cfv (cdif C (csn (cv x3))) N))) C) $ >
  $ wceq S (crab z (wa (wss C (cv z)) (wral x3 (wn (wcel (cv x3) (cfv (cdif (cv z) (csn (cv x3))) N))) (cv z))) (cpw V)) $ >
  $ wi ph (wcel (cpw V) (cdm ccrd)) $ >
  $ wi ph (wrex s1 (wss C (cv s1)) J) $;

--| For any linearly independent subset ` C ` of ` V ` , there is a basis containing the vectors in ` C ` . (Contributed by Mario Carneiro, 17-May-2015.)
theorem lbsextg {x3 s1: setvar} (C: class) (J: class x3) (N: class) (V: class x3) (W: class):
  $ wceq J (cfv W clbs) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (w3a (wa (wcel W clvec) (wcel (cpw V) (cdm ccrd))) (wss C V) (wral x3 (wn (wcel (cv x3) (cfv (cdif C (csn (cv x3))) N))) C)) (wrex s1 (wss C (cv s1)) J) $;

--| For any linearly independent subset ` C ` of ` V ` , there is a basis containing the vectors in ` C ` . (Contributed by Mario Carneiro, 25-Jun-2014.) (Revised by Mario Carneiro, 17-May-2015.)
theorem lbsext {x3 s1: setvar} (C: class) (J: class x3) (N: class) (V: class x3) (W: class):
  $ wceq J (cfv W clbs) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (w3a (wcel W clvec) (wss C V) (wral x3 (wn (wcel (cv x3) (cfv (cdif C (csn (cv x3))) N))) C)) (wrex s1 (wss C (cv s1)) J) $;

--| Every vector space has a basis. This theorem is an AC equivalent; this is the forward implication. (Contributed by Mario Carneiro, 17-May-2015.)
theorem lbsexg (J W: class):
  $ wceq J (cfv W clbs) $ >
  $ wi (wa wac (wcel W clvec)) (wne J c0) $;

--| Every vector space has a basis. This theorem is an AC equivalent. (Contributed by Mario Carneiro, 25-Jun-2014.)
theorem lbsex (J W: class):
  $ wceq J (cfv W clbs) $ >
  $ wi (wcel W clvec) (wne J c0) $;

--| If two structures have the same components (properties), one is a left vector space iff the other one is. This version of ~ lvecpropd also breaks up the components of the scalar ring. (Contributed by Mario Carneiro, 27-Jun-2015.)
theorem lvecprop2d {x3 y1: setvar} (ph: wff) (B2 P F G K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wceq F (cfv K csca) $ >
  $ wceq G (cfv L csca) $ >
  $ wi ph (wceq P (cfv F cbs)) $ >
  $ wi ph (wceq P (cfv G cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) P))) (wceq (co (cv x3) (cv y1) (cfv F cplusg)) (co (cv x3) (cv y1) (cfv G cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) P))) (wceq (co (cv x3) (cv y1) (cfv F cmulr)) (co (cv x3) (cv y1) (cfv G cmulr))) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cvsca)) (co (cv x3) (cv y1) (cfv L cvsca))) $ >
  $ wi ph (wb (wcel K clvec) (wcel L clvec)) $;

--| If two structures have the same components (properties), one is a left vector space iff the other one is. (Contributed by Mario Carneiro, 27-Jun-2015.)
theorem lvecpropd {x3 y1: setvar} (ph: wff) (B2 P: class) (F: class x3 y1) (K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi ph (wceq F (cfv K csca)) $ >
  $ wi ph (wceq F (cfv L csca)) $ >
  $ wceq P (cfv F cbs) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cvsca)) (co (cv x3) (cv y1) (cfv L cvsca))) $ >
  $ wi ph (wb (wcel K clvec) (wcel L clvec)) $;

--| Extend class notation with the subring algebra generator.
term csra: class;

--| Extend class notation with the left module induced by a ring over itself.
term crglmod: class;

--| Any ring can be regarded as a left algebra over any of its subrings. The function ` subringAlg ` associates with any ring and any of its subrings the left algebra consisting in the ring itself regarded as a left algebra over the subring. It has an inner product which is simply the ring product. (Contributed by Mario Carneiro, 27-Nov-2014.) (Revised by Thierry Arnoux, 16-Jun-2019.)
axiom df_sra {w s1: setvar}:
  $ wceq csra (cmpt w cvv (cmpt s1 (cpw (cfv (cv w) cbs)) (co (co (co (cv w) (cop (cfv cnx csca) (co (cv w) (cv s1) cress)) csts) (cop (cfv cnx cvsca) (cfv (cv w) cmulr)) csts) (cop (cfv cnx cip) (cfv (cv w) cmulr)) csts))) $;

--| Any ring can be regarded as a left algebra over itself. The function ` ringLMod ` associates with any ring the left algebra consisting in the ring itself regarded as a left algebra over itself. It has an inner product which is simply the ring product. (Contributed by Stefan O'Rear, 6-Dec-2014.)
axiom df_rgmod {w: setvar}:
  $ wceq crglmod (cmpt w cvv (cfv (cfv (cv w) cbs) (cfv (cv w) csra))) $;

--| Lemma for ~ srabase through ~ sravsca . (Contributed by Mario Carneiro, 27-Nov-2014.) (Revised by Thierry Arnoux, 16-Jun-2019.)
theorem sraval (S V W: class):
  $ wi (wa (wcel W V) (wss S (cfv W cbs))) (wceq (cfv S (cfv W csra)) (co (co (co W (cop (cfv cnx csca) (co W S cress)) csts) (cop (cfv cnx cvsca) (cfv W cmulr)) csts) (cop (cfv cnx cip) (cfv W cmulr)) csts)) $;

--| Lemma for ~ srabase and similar theorems. (Contributed by Mario Carneiro, 4-Oct-2015.) (Revised by Thierry Arnoux, 16-Jun-2019.) (Revised by AV, 29-Oct-2024.)
theorem sralem (ph: wff) (A2 S E W: class):
  $ wi ph (wceq A2 (cfv S (cfv W csra))) $ >
  $ wi ph (wss S (cfv W cbs)) $ >
  $ wceq E (cslot (cfv cnx E)) $ >
  $ wne (cfv cnx csca) (cfv cnx E) $ >
  $ wne (cfv cnx cvsca) (cfv cnx E) $ >
  $ wne (cfv cnx cip) (cfv cnx E) $ >
  $ wi ph (wceq (cfv W E) (cfv A2 E)) $;

--| Base set of a subring algebra. (Contributed by Stefan O'Rear, 27-Nov-2014.) (Revised by Mario Carneiro, 4-Oct-2015.) (Revised by Thierry Arnoux, 16-Jun-2019.) (Revised by AV, 29-Oct-2024.)
theorem srabase (ph: wff) (A2 S W: class):
  $ wi ph (wceq A2 (cfv S (cfv W csra))) $ >
  $ wi ph (wss S (cfv W cbs)) $ >
  $ wi ph (wceq (cfv W cbs) (cfv A2 cbs)) $;

--| Additive operation of a subring algebra. (Contributed by Stefan O'Rear, 27-Nov-2014.) (Revised by Mario Carneiro, 4-Oct-2015.) (Revised by Thierry Arnoux, 16-Jun-2019.) (Revised by AV, 29-Oct-2024.)
theorem sraaddg (ph: wff) (A2 S W: class):
  $ wi ph (wceq A2 (cfv S (cfv W csra))) $ >
  $ wi ph (wss S (cfv W cbs)) $ >
  $ wi ph (wceq (cfv W cplusg) (cfv A2 cplusg)) $;

--| Multiplicative operation of a subring algebra. (Contributed by Stefan O'Rear, 27-Nov-2014.) (Revised by Mario Carneiro, 4-Oct-2015.) (Revised by Thierry Arnoux, 16-Jun-2019.) (Revised by AV, 29-Oct-2024.)
theorem sramulr (ph: wff) (A2 S W: class):
  $ wi ph (wceq A2 (cfv S (cfv W csra))) $ >
  $ wi ph (wss S (cfv W cbs)) $ >
  $ wi ph (wceq (cfv W cmulr) (cfv A2 cmulr)) $;

--| The set of scalars of a subring algebra. (Contributed by Stefan O'Rear, 27-Nov-2014.) (Revised by Mario Carneiro, 4-Oct-2015.) (Revised by Thierry Arnoux, 16-Jun-2019.) (Proof shortened by AV, 12-Nov-2024.)
theorem srasca (ph: wff) (A2 S W: class):
  $ wi ph (wceq A2 (cfv S (cfv W csra))) $ >
  $ wi ph (wss S (cfv W cbs)) $ >
  $ wi ph (wceq (co W S cress) (cfv A2 csca)) $;

--| The scalar product operation of a subring algebra. (Contributed by Stefan O'Rear, 27-Nov-2014.) (Revised by Mario Carneiro, 4-Oct-2015.) (Revised by Thierry Arnoux, 16-Jun-2019.) (Proof shortened by AV, 12-Nov-2024.)
theorem sravsca (ph: wff) (A2 S W: class):
  $ wi ph (wceq A2 (cfv S (cfv W csra))) $ >
  $ wi ph (wss S (cfv W cbs)) $ >
  $ wi ph (wceq (cfv W cmulr) (cfv A2 cvsca)) $;

--| The inner product operation of a subring algebra. (Contributed by Thierry Arnoux, 16-Jun-2019.)
theorem sraip (ph: wff) (A2 S W: class):
  $ wi ph (wceq A2 (cfv S (cfv W csra))) $ >
  $ wi ph (wss S (cfv W cbs)) $ >
  $ wi ph (wceq (cfv W cmulr) (cfv A2 cip)) $;

--| Topology component of a subring algebra. (Contributed by Mario Carneiro, 4-Oct-2015.) (Revised by Thierry Arnoux, 16-Jun-2019.) (Revised by AV, 29-Oct-2024.)
theorem sratset (ph: wff) (A2 S W: class):
  $ wi ph (wceq A2 (cfv S (cfv W csra))) $ >
  $ wi ph (wss S (cfv W cbs)) $ >
  $ wi ph (wceq (cfv W cts) (cfv A2 cts)) $;

--| Topology component of a subring algebra. (Contributed by Mario Carneiro, 4-Oct-2015.) (Revised by Thierry Arnoux, 16-Jun-2019.)
theorem sratopn (ph: wff) (A2 S W: class):
  $ wi ph (wceq A2 (cfv S (cfv W csra))) $ >
  $ wi ph (wss S (cfv W cbs)) $ >
  $ wi ph (wceq (cfv W ctopn) (cfv A2 ctopn)) $;

--| Distance function of a subring algebra. (Contributed by Mario Carneiro, 4-Oct-2015.) (Revised by Thierry Arnoux, 16-Jun-2019.) (Revised by AV, 29-Oct-2024.)
theorem srads (ph: wff) (A2 S W: class):
  $ wi ph (wceq A2 (cfv S (cfv W csra))) $ >
  $ wi ph (wss S (cfv W cbs)) $ >
  $ wi ph (wceq (cfv W cds) (cfv A2 cds)) $;

--| Condition for a subring algebra to be a ring. (Contributed by Thierry Arnoux, 24-Jul-2023.)
theorem sraring (A2 B2 R V: class):
  $ wceq A2 (cfv V (cfv R csra)) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wa (wcel R crg) (wss V B2)) (wcel A2 crg) $;

--| The subring algebra is a left module. (Contributed by Stefan O'Rear, 27-Nov-2014.)
theorem sralmod (A2 S W: class):
  $ wceq A2 (cfv S (cfv W csra)) $ >
  $ wi (wcel S (cfv W csubrg)) (wcel A2 clmod) $;

--| The subring module inherits a zero from its ring. (Contributed by Stefan O'Rear, 27-Dec-2014.)
theorem sralmod0 (ph: wff) (A2 S W c_0: class):
  $ wi ph (wceq A2 (cfv S (cfv W csra))) $ >
  $ wi ph (wceq c_0 (cfv W c0g)) $ >
  $ wi ph (wss S (cfv W cbs)) $ >
  $ wi ph (wceq c_0 (cfv A2 c0g)) $;

--| Prove a subring by closure (definition version). (Contributed by Stefan O'Rear, 7-Dec-2014.)
theorem issubrgd {x3 y1: setvar} (ph: wff) (D c_pl S c_x: class) (c_1: class x3 y1) (I c_0: class):
  $ wi ph (wceq S (co I D cress)) $ >
  $ wi ph (wceq c_0 (cfv I c0g)) $ >
  $ wi ph (wceq c_pl (cfv I cplusg)) $ >
  $ wi ph (wss D (cfv I cbs)) $ >
  $ wi ph (wcel c_0 D) $ >
  $ wi (w3a ph (wcel (cv x3) D) (wcel (cv y1) D)) (wcel (co (cv x3) (cv y1) c_pl) D) $ >
  $ wi (wa ph (wcel (cv x3) D)) (wcel (cfv (cv x3) (cfv I cminusg)) D) $ >
  $ wi ph (wceq c_1 (cfv I cur)) $ >
  $ wi ph (wceq c_x (cfv I cmulr)) $ >
  $ wi ph (wcel c_1 D) $ >
  $ wi (w3a ph (wcel (cv x3) D) (wcel (cv y1) D)) (wcel (co (cv x3) (cv y1) c_x) D) $ >
  $ wi ph (wcel I crg) $ >
  $ wi ph (wcel D (cfv I csubrg)) $;

--| ` ringLMod ` is a function. (Contributed by Stefan O'Rear, 6-Dec-2014.)
theorem rlmfn:
  $ wfn crglmod cvv $;

--| Value of the ring module. (Contributed by Stefan O'Rear, 31-Mar-2015.)
theorem rlmval (W: class):
  $ wceq (cfv W crglmod) (cfv (cfv W cbs) (cfv W csra)) $;

--| Value of the ring module extended. (Contributed by AV, 2-Dec-2018.) (Revised by Thierry Arnoux, 16-Jun-2019.)
theorem rlmval2 (W X: class):
  $ wi (wcel W X) (wceq (cfv W crglmod) (co (co (co W (cop (cfv cnx csca) W) csts) (cop (cfv cnx cvsca) (cfv W cmulr)) csts) (cop (cfv cnx cip) (cfv W cmulr)) csts)) $;

--| Base set of the ring module. (Contributed by Stefan O'Rear, 31-Mar-2015.)
theorem rlmbas (R: class):
  $ wceq (cfv R cbs) (cfv (cfv R crglmod) cbs) $;

--| Vector addition in the ring module. (Contributed by Stefan O'Rear, 31-Mar-2015.)
theorem rlmplusg (R: class):
  $ wceq (cfv R cplusg) (cfv (cfv R crglmod) cplusg) $;

--| Zero vector in the ring module. (Contributed by Stefan O'Rear, 6-Dec-2014.) (Revised by Mario Carneiro, 2-Oct-2015.)
theorem rlm0 (R: class):
  $ wceq (cfv R c0g) (cfv (cfv R crglmod) c0g) $;

--| Subtraction in the ring module. (Contributed by Thierry Arnoux, 30-Jun-2019.)
theorem rlmsub (R: class):
  $ wceq (cfv R csg) (cfv (cfv R crglmod) csg) $;

--| Ring multiplication in the ring module. (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem rlmmulr (R: class):
  $ wceq (cfv R cmulr) (cfv (cfv R crglmod) cmulr) $;

--| Scalars in the ring module. (Contributed by Stefan O'Rear, 6-Dec-2014.)
theorem rlmsca (R X: class):
  $ wi (wcel R X) (wceq R (cfv (cfv R crglmod) csca)) $;

--| Scalars in the ring module. (Contributed by Stefan O'Rear, 1-Apr-2015.)
theorem rlmsca2 (R: class):
  $ wceq (cfv R cid) (cfv (cfv R crglmod) csca) $;

--| Scalar multiplication in the ring module. (Contributed by Stefan O'Rear, 31-Mar-2015.)
theorem rlmvsca (R: class):
  $ wceq (cfv R cmulr) (cfv (cfv R crglmod) cvsca) $;

--| Topology component of the ring module. (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem rlmtopn (R: class):
  $ wceq (cfv R ctopn) (cfv (cfv R crglmod) ctopn) $;

--| Metric component of the ring module. (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem rlmds (R: class):
  $ wceq (cfv R cds) (cfv (cfv R crglmod) cds) $;

--| The ring module is a module. (Contributed by Stefan O'Rear, 6-Dec-2014.)
theorem rlmlmod (R: class):
  $ wi (wcel R crg) (wcel (cfv R crglmod) clmod) $;

--| The ring module over a division ring is a vector space. (Contributed by Mario Carneiro, 4-Oct-2015.)
theorem rlmlvec (R: class):
  $ wi (wcel R cdr) (wcel (cfv R crglmod) clvec) $;

--| Subgroup sum of the ring module. (Contributed by Thierry Arnoux, 9-Apr-2024.)
theorem rlmlsm (R V: class):
  $ wi (wcel R V) (wceq (cfv R clsm) (cfv (cfv R crglmod) clsm)) $;

--| Vector negation in the ring module. (Contributed by Stefan O'Rear, 6-Dec-2014.) (Revised by Mario Carneiro, 5-Jun-2015.)
theorem rlmvneg (R: class):
  $ wceq (cfv R cminusg) (cfv (cfv R crglmod) cminusg) $;

--| Functionalized scalar multiplication in the ring module. (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem rlmscaf (R: class):
  $ wceq (cfv (cfv R cmgp) cplusf) (cfv (cfv R crglmod) cscaf) $;

--| The value of an infinite Cartesian product of the base of a left module over a ring with a singleton. (Contributed by AV, 3-Dec-2018.)
theorem ixpsnbasval {x3 f2: setvar} (R: class) (V W: class x3) (X: class):
  $ wi (wa (wcel R V) (wcel X W)) (wceq (cixp x3 (csn X) (cfv (cfv (cv x3) (cxp (csn X) (csn (cfv R crglmod)))) cbs)) (cab f2 (wa (wfn (cv f2) (csn X)) (wcel (cfv X (cv f2)) (cfv R cbs))))) $;

--| Ring left-ideal function.
term clidl: class;

--| Ring span function.
term crsp: class;

--| Define the class of left ideals of a given ring. An ideal is a submodule of the ring viewed as a module over itself. For the usual textbook definition of a (left) ideal of a ring to be a subgroup of the additive group of the ring which is closed under left-multiplication by elements of the full ring, see ~ dflidl2rng and ~ dflidl2 . (Contributed by Stefan O'Rear, 31-Mar-2015.)
axiom df_lidl:
  $ wceq clidl (ccom clss crglmod) $;

--| Define the linear span function in a ring (Ideal generator). (Contributed by Stefan O'Rear, 4-Apr-2015.)
axiom df_rsp:
  $ wceq crsp (ccom clspn crglmod) $;

--| Value of the set of ring ideals. (Contributed by Stefan O'Rear, 31-Mar-2015.)
theorem lidlval (W: class):
  $ wceq (cfv W clidl) (cfv (cfv W crglmod) clss) $;

--| Value of the ring span function. (Contributed by Stefan O'Rear, 4-Apr-2015.)
theorem rspval (W: class):
  $ wceq (cfv W crsp) (cfv (cfv W crglmod) clspn) $;

--| An ideal is a subset of the base set. (Contributed by Stefan O'Rear, 28-Mar-2015.)
theorem lidlss (B2 U I W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq I (cfv W clidl) $ >
  $ wi (wcel U I) (wss U B2) $;

--| An element of an ideal is an element of the ring. (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by AV, 27-Jun-2026.)
theorem lidlbasel (B2 U I W X: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq I (cfv W clidl) $ >
  $ wi (wa (wcel U I) (wcel X U)) (wcel X B2) $;

--| The base set of the restriction of the ring to a (left) ideal is a subset of the base set of the ring. (Contributed by AV, 17-Feb-2020.)
theorem lidlssbas (R U I L: class):
  $ wceq L (cfv R clidl) $ >
  $ wceq I (co R U cress) $ >
  $ wi (wcel U L) (wss (cfv I cbs) (cfv R cbs)) $;

--| A (left) ideal of a ring is the base set of the restriction of the ring to this ideal. (Contributed by AV, 17-Feb-2020.)
theorem lidlbas (R U I L: class):
  $ wceq L (cfv R clidl) $ >
  $ wceq I (co R U cress) $ >
  $ wi (wcel U L) (wceq (cfv I cbs) U) $;

--| Predicate of being a (left) ideal. (Contributed by Stefan O'Rear, 1-Apr-2015.)
theorem islidl {x3 a b: setvar} (B2: class a b) (c_pl: class x3 a b) (R: class) (c_x U: class x3 a b) (I: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wb (wcel I U) (w3a (wss I B2) (wne I c0) (wral x3 (wral a (wral b (wcel (co (co (cv x3) (cv a) c_x) (cv b) c_pl) I) I) I) B2)) $;

--| A (left) ideal containing the zero element is closed under left-multiplication by elements of the full non-unital ring. If the ring is not a unital ring, and the ideal does not contain the zero element of the ring, then the closure cannot be proven as in ~ lidlmcl . (Contributed by AV, 18-Feb-2025.)
theorem rnglidlmcl (B2 R c_x U I X Y c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq U (cfv R clidl) $ >
  $ wi (wa (w3a (wcel R crng) (wcel I U) (wcel c_0 I)) (wa (wcel X B2) (wcel Y I))) (wcel (co X Y c_x) I) $;

--| A right ideal (which is a left ideal over the opposite ring) containing the zero element is closed under right-multiplication by elements of the full non-unital ring. (Contributed by AV, 19-Feb-2025.)
theorem rngridlmcl (B2 R c_x U I X Y c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq U (cfv (cfv R coppr) clidl) $ >
  $ wi (wa (w3a (wcel R crng) (wcel I U) (wcel c_0 I)) (wa (wcel X B2) (wcel Y I))) (wcel (co Y X c_x) I) $;

--| Alternate (the usual textbook) definition of a (left) ideal of a non-unital ring to be a subgroup of the additive group of the ring which is closed under left-multiplication by elements of the full ring. (Contributed by AV, 21-Mar-2025.)
theorem dflidl2rng {x3 y1: setvar} (B2 R: class) (c_x: class x3 y1) (U I: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crng) (wcel I (cfv R csubg))) (wb (wcel I U) (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) c_x) I) I) B2)) $;

--| A right ideal is a left ideal of the opposite non-unital ring. This theorem shows that this definition corresponds to the usual textbook definition of a right ideal of a ring to be a subgroup of the additive group of the ring which is closed under right-multiplication by elements of the full ring. (Contributed by AV, 21-Mar-2025.)
theorem isridlrng {x3 y1: setvar} (B2 R: class) (c_x: class x3 y1) (U I: class):
  $ wceq U (cfv (cfv R coppr) clidl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crng) (wcel I (cfv R csubg))) (wb (wcel I U) (wral x3 (wral y1 (wcel (co (cv y1) (cv x3) c_x) I) I) B2)) $;

--| An ideal contains 0. (Contributed by Stefan O'Rear, 3-Jan-2015.)
theorem lidl0cl (R U I c_0: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R crg) (wcel I U)) (wcel c_0 I) $;

--| An ideal is closed under addition. (Contributed by Stefan O'Rear, 3-Jan-2015.)
theorem lidlacl (c_pl R U I X Y: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (wa (wa (wcel R crg) (wcel I U)) (wa (wcel X I) (wcel Y I))) (wcel (co X Y c_pl) I) $;

--| An ideal contains negatives. (Contributed by Stefan O'Rear, 3-Jan-2015.)
theorem lidlnegcl (R U I N X: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wi (w3a (wcel R crg) (wcel I U) (wcel X I)) (wcel (cfv X N) I) $;

--| An ideal is a subgroup of the additive group. (Contributed by Mario Carneiro, 14-Jun-2015.)
theorem lidlsubg (R U I: class):
  $ wceq U (cfv R clidl) $ >
  $ wi (wa (wcel R crg) (wcel I U)) (wcel I (cfv R csubg)) $;

--| An ideal is closed under subtraction. (Contributed by Stefan O'Rear, 28-Mar-2015.) (Proof shortened by OpenAI, 25-Mar-2020.)
theorem lidlsubcl (R U I c_mi X Y: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wi (wa (wa (wcel R crg) (wcel I U)) (wa (wcel X I) (wcel Y I))) (wcel (co X Y c_mi) I) $;

--| An ideal is closed under left-multiplication by elements of the full ring. (Contributed by Stefan O'Rear, 3-Jan-2015.) (Proof shortened by AV, 31-Mar-2025.)
theorem lidlmcl (B2 R c_x U I X Y: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wa (wcel R crg) (wcel I U)) (wa (wcel X B2) (wcel Y I))) (wcel (co X Y c_x) I) $;

--| An ideal contains 1 iff it is the unit ideal. (Contributed by Stefan O'Rear, 3-Jan-2015.) (Revised by Wolf Lammen, 6-Sep-2020.)
theorem lidl1el (B2 R U c_1 I: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wcel I U)) (wb (wcel c_1 I) (wceq I B2)) $;

--| An ideal is closed under left-multiplication by elements of the full ring. (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem lidlmcld (ph: wff) (B2 R c_x U I X Y: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I U) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y I) $ >
  $ wi ph (wcel (co X Y c_x) I) $;

--| Alternate (the usual textbook) definition of a (left) ideal of a ring to be a subgroup of the additive group of the ring which is closed under left-multiplication by elements of the full ring. (Contributed by AV, 13-Feb-2025.) (Proof shortened by AV, 18-Apr-2025.)
theorem dflidl2 {x3 y1: setvar} (B2 R: class) (c_x: class x3 y1) (U I: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wcel R crg) (wb (wcel I U) (wa (wcel I (cfv R csubg)) (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) c_x) I) I) B2))) $;

--| Alternate proof for ~ lidl0 not using ~ rnglidl0 : Every ring contains a zero ideal. (Contributed by Stefan O'Rear, 3-Jan-2015.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem lidl0ALT (R U c_0: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R crg) (wcel (csn c_0) U) $;

--| Every non-unital ring contains a zero ideal. (Contributed by AV, 19-Feb-2025.)
theorem rnglidl0 (R U c_0: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R crng) (wcel (csn c_0) U) $;

--| Every ring contains a zero ideal. (Contributed by Stefan O'Rear, 3-Jan-2015.) (Proof shortened by AV, 18-Apr-2025.)
theorem lidl0 (R U c_0: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R crg) (wcel (csn c_0) U) $;

--| Alternate proof for ~ lidl1 not using ~ rnglidl1 : Every ring contains a unit ideal. (Contributed by Stefan O'Rear, 3-Jan-2015.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem lidl1ALT (B2 R U: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R crg) (wcel B2 U) $;

--| The base set of every non-unital ring is an ideal. For unital rings, such ideals are called "unit ideals", see ~ lidl1 . (Contributed by AV, 19-Feb-2025.)
theorem rnglidl1 (B2 R U: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R crng) (wcel B2 U) $;

--| Every ring contains a unit ideal. (Contributed by Stefan O'Rear, 3-Jan-2015.) (Proof shortened by AV, 18-Apr-2025.)
theorem lidl1 (B2 R U: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R crg) (wcel B2 U) $;

--| The zero ideal is the only ideal of the trivial ring. (Contributed by Thierry Arnoux, 1-Jul-2024.)
theorem _0ringidl (B2 R c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R crg) (wceq (cfv B2 chash) c1)) (wceq (cfv R clidl) (csn (csn c_0))) $;

--| The union of a nonempty subset of ideals in a ring is nonempty. (Contributed by AV, 28-Jun-2026.)
theorem lidlunin0 (C R: class):
  $ wi (w3a (wcel R crg) (wne C c0) (wss C (cfv R clidl))) (wne (cuni C) c0) $;

--| The union of a nonempty chain of ideals is an ideal. (Contributed by Jeff Madsen, 5-Jan-2011.) (Revised by AV, 28-Jun-2026.)
theorem unichnlidl {i j: setvar} (C: class) (R: class j):
  $ wi (wa (wcel R crg) (w3a (wne C c0) (wss C (cfv R clidl)) (wral i (wral j (wo (wss (cv i) (cv j)) (wss (cv j) (cv i))) C) C))) (wcel (cuni C) (cfv R clidl)) $;

--| The ideal system is an algebraic closure system on the base set. (Contributed by Stefan O'Rear, 4-Apr-2015.)
theorem lidlacs (B2 I W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq I (cfv W clidl) $ >
  $ wi (wcel W crg) (wcel I (cfv B2 cacs)) $;

--| The span of a set of ring elements is an ideal. (Contributed by Stefan O'Rear, 3-Jan-2015.) (Revised by Mario Carneiro, 2-Oct-2015.)
theorem rspcl (B2 R U G K: class):
  $ wceq K (cfv R crsp) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R clidl) $ >
  $ wi (wa (wcel R crg) (wss G B2)) (wcel (cfv G K) U) $;

--| The span of a set of ring elements contains those elements. (Contributed by Stefan O'Rear, 3-Jan-2015.)
theorem rspssid (B2 R G K: class):
  $ wceq K (cfv R crsp) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wa (wcel R crg) (wss G B2)) (wss G (cfv G K)) $;

--| The span of the identity element is the unit ideal. (Contributed by Stefan O'Rear, 3-Jan-2015.)
theorem rsp1 (B2 R c_1 K: class):
  $ wceq K (cfv R crsp) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R crg) (wceq (cfv (csn c_1) K) B2) $;

--| The span of the zero element is the zero ideal. (Contributed by Stefan O'Rear, 3-Jan-2015.)
theorem rsp0 (R K c_0: class):
  $ wceq K (cfv R crsp) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R crg) (wceq (cfv (csn c_0) K) (csn c_0)) $;

--| The ideal span of a set of elements in a ring is contained in any subring which contains those elements. (Contributed by Stefan O'Rear, 3-Jan-2015.)
theorem rspssp (R U G I K: class):
  $ wceq K (cfv R crsp) $ >
  $ wceq U (cfv R clidl) $ >
  $ wi (w3a (wcel R crg) (wcel I U) (wss G I)) (wss (cfv G K) I) $;

--| The ideal generated by a subset of a ring as intersection of ideals including the subset. (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by AV, 30-Jun-2026.)
theorem rspvalint {t: setvar} (B2: class t) (R S I: class) (K: class t):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq I (cfv R clidl) $ >
  $ wceq K (cfv R crsp) $ >
  $ wi (wa (wcel R crg) (wss S B2)) (wceq (cfv S K) (cint (crab t (wss S (cv t)) I))) $;

--| Properties of a class to be the ideal generated by a subset of a ring. (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by AV, 30-Jun-2026.)
theorem rspprop {i: setvar} (B2: class i) (R S I K X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq I (cfv R clidl) $ >
  $ wceq K (cfv R crsp) $ >
  $ wi (wa (wcel R crg) (wss S B2)) (wb (wceq (cfv S K) X) (w3a (wcel X I) (wss S X) (wral i (wi (wss S (cv i)) (wss X (cv i))) I))) $;

--| Membership in a principal ideal. Analogous to ~ ellspsn . (Contributed by Thierry Arnoux, 15-Jan-2024.)
theorem elrspsn {x3: setvar} (B2 R c_x I K X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq K (cfv R crsp) $ >
  $ wi (wa (wcel R crg) (wcel X B2)) (wb (wcel I (cfv (csn X) K)) (wrex x3 (wceq I (co (cv x3) X c_x)) B2)) $;

--| A principal ideal (an ideal generated by one element) in a ring. (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by AV, 12-Jul-2026.)
theorem rspsn0 {x3 i: setvar} (B2 R c_x K X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq K (cfv R crsp) $ >
  $ wi (wa (wcel R crg) (wcel X B2)) (wceq (cfv (csn X) K) (crab i (wrex x3 (wceq (cv i) (co (cv x3) X c_x)) B2) B2)) $;

--| A principal ideal contains the element that generates it. (Contributed by Thierry Arnoux, 15-Jan-2024.)
theorem rspsnid (B2 R G K: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq K (cfv R crsp) $ >
  $ wi (wa (wcel R crg) (wcel G B2)) (wcel G (cfv (csn G) K)) $;

--| A principal ideal generated by a nonzero element is not the zero ideal. (Contributed by Thierry Arnoux, 11-Apr-2024.)
theorem pidlnz (B2 R K X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq K (cfv R crsp) $ >
  $ wi (w3a (wcel R crg) (wcel X B2) (wne X c_0)) (wne (cfv (csn X) K) (csn c_0)) $;

--| Moore closure generalizes ideal span. (Contributed by Stefan O'Rear, 4-Apr-2015.)
theorem mrcrsp (R U F K: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq K (cfv R crsp) $ >
  $ wceq F (cfv U cmrc) $ >
  $ wi (wcel R crg) (wceq K F) $;

--| A nonzero ideal contains a nonzero element. (Contributed by Stefan O'Rear, 3-Jan-2015.)
theorem lidlnz {x3: setvar} (R U: class x3) (I c_0: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel R crg) (wcel I U) (wne I (csn c_0))) (wrex x3 (wne (cv x3) c_0) I) $;

--| A division ring has only the two trivial ideals. (Contributed by Stefan O'Rear, 3-Jan-2015.) (Revised by Wolf Lammen, 6-Sep-2020.)
theorem drngnidl (B2 R U c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq U (cfv R clidl) $ >
  $ wi (wcel R cdr) (wceq U (cpr (csn c_0) B2)) $;

--| The left ideals and ring span of a ring depend only on the ring components. Here ` W ` is expected to be either ` B ` (when closure is available) or ` _V ` (when strong equality is available). (Contributed by Mario Carneiro, 14-Jun-2015.)
theorem lidlrsppropd {x3 y1: setvar} (ph: wff) (B2 K L W: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi ph (wss B2 W) $ >
  $ wi (wa ph (wa (wcel (cv x3) W) (wcel (cv y1) W))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wcel (co (cv x3) (cv y1) (cfv K cmulr)) W) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi ph (wa (wceq (cfv K clidl) (cfv L clidl)) (wceq (cfv K crsp) (cfv L crsp))) $;

--| The multiplicative group of a (left) ideal of a non-unital ring is a magma. (Contributed by AV, 17-Feb-2020.) Generalization for non-unital rings. The assumption ` .0. e. U ` is required because a left ideal of a non-unital ring does not have to be a subgroup. (Revised by AV, 11-Mar-2025.)
theorem rnglidlmmgm (R U I L c_0: class):
  $ wceq L (cfv R clidl) $ >
  $ wceq I (co R U cress) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel R crng) (wcel U L) (wcel c_0 U)) (wcel (cfv I cmgp) cmgm) $;

--| The multiplicative group of a (left) ideal of a non-unital ring is a semigroup. (Contributed by AV, 17-Feb-2020.) Generalization for non-unital rings. The assumption ` .0. e. U ` is required because a left ideal of a non-unital ring does not have to be a subgroup. (Revised by AV, 11-Mar-2025.)
theorem rnglidlmsgrp (R U I L c_0: class):
  $ wceq L (cfv R clidl) $ >
  $ wceq I (co R U cress) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel R crng) (wcel U L) (wcel c_0 U)) (wcel (cfv I cmgp) csgrp) $;

--| A (left) ideal of a non-unital ring is a non-unital ring. (Contributed by AV, 17-Feb-2020.) Generalization for non-unital rings. The assumption ` U e. ( SubGrp `` R ) ` is required because a left ideal of a non-unital ring does not have to be a subgroup. (Revised by AV, 11-Mar-2025.)
theorem rnglidlrng (R U I L: class):
  $ wceq L (cfv R clidl) $ >
  $ wceq I (co R U cress) $ >
  $ wi (w3a (wcel R crng) (wcel U L) (wcel U (cfv R csubg))) (wcel I crng) $;

--| An ideal is a normal subgroup. (Contributed by Thierry Arnoux, 14-Jan-2024.)
theorem lidlnsg (R I: class):
  $ wi (wa (wcel R crg) (wcel I (cfv R clidl))) (wcel I (cfv R cnsg)) $;

--| The sum of two ideals is the ideal generated by their union. (Contributed by Thierry Arnoux, 21-Jan-2024.)
theorem lsmidllsp (ph: wff) (B2 c_po R I J K: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_po (cfv R clsm) $ >
  $ wceq K (cfv R crsp) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I (cfv R clidl)) $ >
  $ wi ph (wcel J (cfv R clidl)) $ >
  $ wi ph (wceq (co I J c_po) (cfv (cun I J) K)) $;

--| The sum of two ideals is an ideal. (Contributed by Thierry Arnoux, 21-Jan-2024.)
theorem lsmidl (ph: wff) (B2 c_po R I J K: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_po (cfv R clsm) $ >
  $ wceq K (cfv R crsp) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I (cfv R clidl)) $ >
  $ wi ph (wcel J (cfv R clidl)) $ >
  $ wi ph (wcel (co I J c_po) (cfv R clidl)) $;

--| A nonzero ring is a division ring if and only if its only left ideals are the zero ideal and the unit ideal. (Proposed by Gerard Lang, 13-Mar-2025.) (Contributed by Thierry Arnoux, 13-Mar-2025.)
theorem drngidl (B2 R U c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq U (cfv R clidl) $ >
  $ wi (wcel R cnzr) (wb (wcel R cdr) (wceq U (cpr (csn c_0) B2))) $;

--| Determine if a ring is a field based on its ideals. (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by AV, 30-Jun-2026.)
theorem isfieldidl (B2 R c_1 I c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq I (cfv R clidl) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wb (wcel R cfield) (w3a (wcel R ccrg) (wne c_0 c_1) (wceq I (cpr (csn c_0) B2))) $;

--| Determine if a ring is a field based on its ideals. (Contributed by Jeff Madsen, 6-Jan-2011.) (Revised by AV, 30-Jun-2026.)
theorem isfieldidl2 (B2 R I c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq I (cfv R clidl) $ >
  $ wb (wcel R cfield) (w3a (wcel R ccrg) (wne B2 (csn c_0)) (wceq I (cpr (csn c_0) B2))) $;

--| Ring two-sided ideal function.
term c2idl: class;

--| Define the class of two-sided ideals of a ring. A two-sided ideal is a left ideal which is also a right ideal (or a left ideal over the opposite ring). (Contributed by Mario Carneiro, 14-Jun-2015.)
axiom df_2idl {r: setvar}:
  $ wceq c2idl (cmpt r cvv (cin (cfv (cv r) clidl) (cfv (cfv (cv r) coppr) clidl))) $;

--| Definition of a two-sided ideal. (Contributed by Mario Carneiro, 14-Jun-2015.)
theorem _2idlval (R T I J O: class):
  $ wceq I (cfv R clidl) $ >
  $ wceq O (cfv R coppr) $ >
  $ wceq J (cfv O clidl) $ >
  $ wceq T (cfv R c2idl) $ >
  $ wceq T (cin I J) $;

--| A right ideal is a left ideal of the opposite ring. This theorem shows that this definition corresponds to the usual textbook definition of a right ideal of a ring to be a subgroup of the additive group of the ring which is closed under right-multiplication by elements of the full ring. (Contributed by AV, 13-Feb-2025.)
theorem isridl {x3 y1: setvar} (B2 R: class) (c_x: class x3 y1) (U I: class):
  $ wceq U (cfv (cfv R coppr) clidl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wcel R crg) (wb (wcel I U) (wa (wcel I (cfv R csubg)) (wral x3 (wral y1 (wcel (co (cv y1) (cv x3) c_x) I) I) B2))) $;

--| Membership in a two-sided ideal. Formerly part of proof for ~ 2idlcpbl . (Contributed by Mario Carneiro, 14-Jun-2015.) (Revised by AV, 20-Feb-2025.)
theorem _2idlelb (R T U I J O: class):
  $ wceq I (cfv R clidl) $ >
  $ wceq O (cfv R coppr) $ >
  $ wceq J (cfv O clidl) $ >
  $ wceq T (cfv R c2idl) $ >
  $ wb (wcel U T) (wa (wcel U I) (wcel U J)) $;

--| A two-sided ideal is a left ideal. (Contributed by Thierry Arnoux, 9-Mar-2025.)
theorem _2idllidld (ph: wff) (R I: class):
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wi ph (wcel I (cfv R clidl)) $;

--| A two-sided ideal is a right ideal. (Contributed by Thierry Arnoux, 9-Mar-2025.)
theorem _2idlridld (ph: wff) (R I O: class):
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq O (cfv R coppr) $ >
  $ wi ph (wcel I (cfv O clidl)) $;

--| A two-sided ideal contains 1 iff it is the unit ideal. (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by AV, 24-Aug-2026.)
theorem _2idl1el (B2 R U c_1 I: class):
  $ wceq U (cfv R c2idl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wcel I U)) (wb (wcel c_1 I) (wceq I B2)) $;

--| Alternate (the usual textbook) definition of a two-sided ideal of a non-unital ring to be a subgroup of the additive group of the ring which is closed under left- and right-multiplication by elements of the full ring. (Contributed by AV, 21-Mar-2025.)
theorem df2idl2rng {x3 y1: setvar} (B2 R: class) (c_x U: class x3 y1) (I: class):
  $ wceq U (cfv R c2idl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crng) (wcel I (cfv R csubg))) (wb (wcel I U) (wral x3 (wral y1 (wa (wcel (co (cv x3) (cv y1) c_x) I) (wcel (co (cv y1) (cv x3) c_x) I)) I) B2)) $;

--| Alternate (the usual textbook) definition of a two-sided ideal of a ring to be a subgroup of the additive group of the ring which is closed under left- and right-multiplication by elements of the full ring. (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by AV, 13-Feb-2025.) (Proof shortened by AV, 18-Apr-2025.)
theorem df2idl2 {x3 y1: setvar} (B2 R: class) (c_x U: class x3 y1) (I: class):
  $ wceq U (cfv R c2idl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wcel R crg) (wb (wcel I U) (wa (wcel I (cfv R csubg)) (wral x3 (wral y1 (wa (wcel (co (cv x3) (cv y1) c_x) I) (wcel (co (cv y1) (cv x3) c_x) I)) I) B2))) $;

--| Every ring contains a zero right ideal. (Contributed by AV, 13-Feb-2025.)
theorem ridl0 (R U c_0: class):
  $ wceq U (cfv (cfv R coppr) clidl) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R crg) (wcel (csn c_0) U) $;

--| Every ring contains a unit right ideal. (Contributed by AV, 13-Feb-2025.)
theorem ridl1 (B2 R U: class):
  $ wceq U (cfv (cfv R coppr) clidl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R crg) (wcel B2 U) $;

--| Every ring contains a zero two-sided ideal. (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by AV, 13-Feb-2025.)
theorem _2idl0 (R I c_0: class):
  $ wceq I (cfv R c2idl) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R crg) (wcel (csn c_0) I) $;

--| Every ring contains a unit two-sided ideal. (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by AV, 13-Feb-2025.)
theorem _2idl1 (B2 R I: class):
  $ wceq I (cfv R c2idl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R crg) (wcel B2 I) $;

--| A two-sided ideal is a subset of the base set. Formerly part of proof for ~ 2idlcpbl . (Contributed by Mario Carneiro, 14-Jun-2015.) (Revised by AV, 20-Feb-2025.) (Proof shortened by AV, 13-Mar-2025.)
theorem _2idlss (B2 U I W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq I (cfv W c2idl) $ >
  $ wi (wcel U I) (wss U B2) $;

--| The base set of a two-sided ideal as structure. (Contributed by AV, 20-Feb-2025.)
theorem _2idlbas (ph: wff) (B2 R I J: class):
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wceq B2 (cfv J cbs) $ >
  $ wi ph (wceq B2 I) $;

--| The base set of a two-sided ideal as structure is a left and right ideal. (Contributed by AV, 20-Feb-2025.)
theorem _2idlelbas (ph: wff) (B2 R I J: class):
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wceq B2 (cfv J cbs) $ >
  $ wi ph (wa (wcel B2 (cfv R clidl)) (wcel B2 (cfv (cfv R coppr) clidl))) $;

--| A two-sided ideal of a non-unital ring which is a non-unital ring is a subring of the ring. (Contributed by AV, 20-Feb-2025.) (Revised by AV, 11-Mar-2025.)
theorem rng2idlsubrng (ph: wff) (R I: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wi ph (wcel (co R I cress) crng) $ >
  $ wi ph (wcel I (cfv R csubrng)) $;

--| A two-sided ideal of a non-unital ring which is a non-unital ring is a normal subgroup of the ring. (Contributed by AV, 20-Feb-2025.)
theorem rng2idlnsg (ph: wff) (R I: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wi ph (wcel (co R I cress) crng) $ >
  $ wi ph (wcel I (cfv R cnsg)) $;

--| The zero (additive identity) of a non-unital ring is an element of each two-sided ideal of the ring which is a non-unital ring. (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by AV, 20-Feb-2025.)
theorem rng2idl0 (ph: wff) (R I: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wi ph (wcel (co R I cress) crng) $ >
  $ wi ph (wcel (cfv R c0g) I) $;

--| A two-sided ideal of a non-unital ring which is a subgroup of the ring is a subring of the ring. (Contributed by AV, 11-Mar-2025.)
theorem rng2idlsubgsubrng (ph: wff) (R I: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wi ph (wcel I (cfv R csubg)) $ >
  $ wi ph (wcel I (cfv R csubrng)) $;

--| A two-sided ideal of a non-unital ring which is a subgroup of the ring is a normal subgroup of the ring. (Contributed by AV, 20-Feb-2025.)
theorem rng2idlsubgnsg (ph: wff) (R I: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wi ph (wcel I (cfv R csubg)) $ >
  $ wi ph (wcel I (cfv R cnsg)) $;

--| The zero (additive identity) of a non-unital ring is an element of each two-sided ideal of the ring which is a subgroup of the ring. (Contributed by AV, 20-Feb-2025.)
theorem rng2idlsubg0 (ph: wff) (R I: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wi ph (wcel I (cfv R csubg)) $ >
  $ wi ph (wcel (cfv R c0g) I) $;

--| The coset equivalence relation for a two-sided ideal is compatible with ring multiplication. (Contributed by Mario Carneiro, 14-Jun-2015.) Generalization for non-unital rings and two-sided ideals which are subgroups of the additive group of the non-unital ring. (Revised by AV, 23-Feb-2025.)
theorem _2idlcpblrng (A2 B2 C D R S c_x E I X: class):
  $ wceq X (cfv R cbs) $ >
  $ wceq E (co R S cqg) $ >
  $ wceq I (cfv R c2idl) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R crng) (wcel S I) (wcel S (cfv R csubg))) (wi (wa (wbr A2 C E) (wbr B2 D E)) (wbr (co A2 B2 c_x) (co C D c_x) E)) $;

--| The coset equivalence relation for a two-sided ideal is compatible with ring multiplication. (Contributed by Mario Carneiro, 14-Jun-2015.) (Proof shortened by AV, 31-Mar-2025.)
theorem _2idlcpbl (A2 B2 C D R S c_x E I X: class):
  $ wceq X (cfv R cbs) $ >
  $ wceq E (co R S cqg) $ >
  $ wceq I (cfv R c2idl) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crg) (wcel S I)) (wi (wa (wbr A2 C E) (wbr B2 D E)) (wbr (co A2 B2 c_x) (co C D c_x) E)) $;

--| The quotient of a non-unital ring modulo a two-sided ideal, which is a subgroup of the additive group of the non-unital ring, is a non-unital ring ( ~ qusring analog). (Contributed by AV, 23-Feb-2025.)
theorem qus2idrng (R S U I: class):
  $ wceq U (co R (co R S cqg) cqus) $ >
  $ wceq I (cfv R c2idl) $ >
  $ wi (w3a (wcel R crng) (wcel S I) (wcel S (cfv R csubg))) (wcel U crng) $;

--| The multiplicative identity of the quotient ring. (Contributed by Mario Carneiro, 14-Jun-2015.)
theorem qus1 (R S U c_1 I: class):
  $ wceq U (co R (co R S cqg) cqus) $ >
  $ wceq I (cfv R c2idl) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wcel S I)) (wa (wcel U crg) (wceq (cec c_1 (co R S cqg)) (cfv U cur))) $;

--| If ` S ` is a two-sided ideal in ` R ` , then ` U = R / S ` is a ring, called the quotient ring of ` R ` by ` S ` . (Contributed by Mario Carneiro, 14-Jun-2015.)
theorem qusring (R S U I: class):
  $ wceq U (co R (co R S cqg) cqus) $ >
  $ wceq I (cfv R c2idl) $ >
  $ wi (wa (wcel R crg) (wcel S I)) (wcel U crg) $;

--| If ` S ` is a two-sided ideal in ` R ` , then the "natural map" from elements to their cosets is a ring homomorphism from ` R ` to ` R / S ` . (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem qusrhm {x3: setvar} (R S U: class) (F: class x3) (I X: class):
  $ wceq U (co R (co R S cqg) cqus) $ >
  $ wceq I (cfv R c2idl) $ >
  $ wceq X (cfv R cbs) $ >
  $ wceq F (cmpt x3 X (cec (cv x3) (co R S cqg))) $ >
  $ wi (wa (wcel R crg) (wcel S I)) (wcel F (co R U crh)) $;

--| The preimage of an ideal by a ring homomorphism is an ideal. (Contributed by Thierry Arnoux, 30-Jun-2024.)
theorem rhmpreimaidl (R S F I J: class):
  $ wceq I (cfv R clidl) $ >
  $ wi (wa (wcel F (co R S crh)) (wcel J (cfv S clidl))) (wcel (cima (ccnv F) J) I) $;

--| The kernel of a ring homomorphism is an ideal. (Contributed by Thierry Arnoux, 1-Jul-2024.)
theorem kerlidl (R S F I c_0: class):
  $ wceq I (cfv R clidl) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wi (wcel F (co R S crh)) (wcel (cima (ccnv F) (csn c_0)) I) $;

--| The kernel of a ring homomorphism is a two-sided ideal. (Contributed by Jeff Madsen, 3-Jan-2011.) (Revised by AV, 24-Aug-2026.)
theorem ker2idl (R S F I c_0: class):
  $ wceq I (cfv R c2idl) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wi (wcel F (co R S crh)) (wcel (cima (ccnv F) (csn c_0)) I) $;

--| Value of the ring operation in a quotient ring by a two-sided ideal. (Contributed by Thierry Arnoux, 1-Sep-2024.)
theorem qusmul2idl (ph: wff) (B2 Q R c_x c_xp I X Y: class):
  $ wceq Q (co R (co R I cqg) cqus) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_xp (cfv Q cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co (cec X (co R I cqg)) (cec Y (co R I cqg)) c_xp) (cec (co X Y c_x) (co R I cqg))) $;

--| In a commutative ring, the left and right ideals coincide. (Contributed by Mario Carneiro, 14-Jun-2015.)
theorem crngridl (R I O: class):
  $ wceq I (cfv R clidl) $ >
  $ wceq O (cfv R coppr) $ >
  $ wi (wcel R ccrg) (wceq I (cfv O clidl)) $;

--| In a commutative ring, a two-sided ideal is the same as a left ideal. (Contributed by Mario Carneiro, 14-Jun-2015.)
theorem crng2idl (R I: class):
  $ wceq I (cfv R clidl) $ >
  $ wi (wcel R ccrg) (wceq I (cfv R c2idl)) $;

--| The predicate "is an ideal of the commutative ring ` R ` ". (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by AV, 27-Jun-2026.)
theorem df2idl2crng {x3 y1: setvar} (B2 R: class) (c_x U: class x3 y1) (I: class):
  $ wceq U (cfv R c2idl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wcel R ccrg) (wb (wcel I U) (wa (wcel I (cfv R csubg)) (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) c_x) I) I) B2))) $;

--| Value of the multiplication operation in a quotient ring of a non-unital ring. Formerly part of proof for ~ quscrng . Similar to ~ qusmul2idl . (Contributed by Mario Carneiro, 15-Jun-2015.) (Revised by AV, 28-Feb-2025.)
theorem qusmulrng (B2 c_sm R S c_xb c_x H X Y: class):
  $ wceq c_sm (co R S cqg) $ >
  $ wceq H (co R c_sm cqus) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_xb (cfv H cmulr) $ >
  $ wi (wa (w3a (wcel R crng) (wcel S (cfv R c2idl)) (wcel S (cfv R csubg))) (wa (wcel X B2) (wcel Y B2))) (wceq (co (cec X c_sm) (cec Y c_sm) c_xb) (cec (co X Y c_x) c_sm)) $;

--| The quotient of a commutative ring by an ideal is a commutative ring. (Contributed by Mario Carneiro, 15-Jun-2015.) (Proof shortened by AV, 3-Apr-2025.)
theorem quscrng (R S U I: class):
  $ wceq U (co R (co R S cqg) cqus) $ >
  $ wceq I (cfv R clidl) $ >
  $ wi (wa (wcel R ccrg) (wcel S I)) (wcel U ccrg) $;

--| Value of the ring operation in a quotient ring of a commutative ring. (Contributed by Thierry Arnoux, 1-Sep-2024.) (Proof shortened by metakunt, 3-Jun-2025.)
theorem qusmulcrng (ph: wff) (B2 Q R c_x c_xp I X Y: class):
  $ wceq Q (co R (co R I cqg) cqus) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_xp (cfv Q cmulr) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel I (cfv R clidl)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co (cec X (co R I cqg)) (cec Y (co R I cqg)) c_xp) (cec (co X Y c_x) (co R I cqg))) $;

--| The mapping ` J ` induced by a ring homomorphism ` F ` from a subring ` N ` of the quotient group ` Q ` over ` F ` 's kernel ` K ` is a ring homomorphism. (Contributed by Thierry Arnoux, 13-May-2025.)
theorem rhmqusnsg {q: setvar} (ph: wff) (Q F G H J K N: class) (c_0: class q):
  $ wceq c_0 (cfv H c0g) $ >
  $ wi ph (wcel F (co G H crh)) $ >
  $ wceq K (cima (ccnv F) (csn c_0)) $ >
  $ wceq Q (co G (co G N cqg) cqus) $ >
  $ wceq J (cmpt q (cfv Q cbs) (cuni (cima F (cv q)))) $ >
  $ wi ph (wcel G ccrg) $ >
  $ wi ph (wss N K) $ >
  $ wi ph (wcel N (cfv G clidl)) $ >
  $ wi ph (wcel J (co Q H crh)) $;

--| The ring unity of a two-sided ideal of a non-unital ring belongs to the base set of the ring. (Contributed by AV, 15-Mar-2025.)
theorem rngqiprng1elbas (ph: wff) (B2 R c_x c_1 I J: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wi ph (wcel c_1 B2) $;

--| Lemma 1 for ~ rngqiprngghm . (Contributed by AV, 25-Feb-2025.)
theorem rngqiprngghmlem1 (ph: wff) (A2 B2 R c_x c_1 I J: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wi (wa ph (wcel A2 B2)) (wcel (co c_1 A2 c_x) (cfv J cbs)) $;

--| Lemma 2 for ~ rngqiprngghm . (Contributed by AV, 25-Feb-2025.)
theorem rngqiprngghmlem2 (ph: wff) (A2 B2 C R c_x c_1 I J: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wi (wa ph (wa (wcel A2 B2) (wcel C B2))) (wcel (co (co c_1 A2 c_x) (co c_1 C c_x) (cfv J cplusg)) (cfv J cbs)) $;

--| Lemma 3 for ~ rngqiprngghm . (Contributed by AV, 25-Feb-2025.) (Proof shortened by AV, 24-Mar-2025.)
theorem rngqiprngghmlem3 (ph: wff) (A2 B2 C R c_x c_1 I J: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wi (wa ph (wa (wcel A2 B2) (wcel C B2))) (wceq (co c_1 (co A2 C (cfv R cplusg)) c_x) (co (co c_1 A2 c_x) (co c_1 C c_x) (cfv J cplusg))) $;

--| Lemma for ~ rngqiprngimfo . (Contributed by AV, 5-Mar-2025.) (Proof shortened by AV, 24-Mar-2025.)
theorem rngqiprngimfolem (ph: wff) (A2 B2 C R c_x c_1 I J: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wi (w3a ph (wcel A2 I) (wcel C B2)) (wceq (co c_1 (co (co C (co c_1 C c_x) (cfv R csg)) A2 (cfv R cplusg)) c_x) A2) $;

--| Lemma 1 for ~ rngqiprnglin . (Contributed by AV, 28-Feb-2025.) (Proof shortened by AV, 24-Mar-2025.)
theorem rngqiprnglinlem1 (ph: wff) (A2 B2 C R c_x c_1 I J: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wi (wa ph (wa (wcel A2 B2) (wcel C B2))) (wceq (co (co c_1 A2 c_x) (co c_1 C c_x) c_x) (co c_1 (co A2 C c_x) c_x)) $;

--| Lemma 2 for ~ rngqiprnglin . (Contributed by AV, 28-Feb-2025.)
theorem rngqiprnglinlem2 (ph: wff) (A2 B2 C Q c_sm R c_x c_1 I J: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wi (wa ph (wa (wcel A2 B2) (wcel C B2))) (wceq (cec (co A2 C c_x) c_sm) (co (cec A2 c_sm) (cec C c_sm) (cfv Q cmulr))) $;

--| Lemma 3 for ~ rngqiprnglin . (Contributed by AV, 28-Feb-2025.)
theorem rngqiprnglinlem3 (ph: wff) (A2 B2 C Q c_sm R c_x c_1 I J: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wi (wa ph (wa (wcel A2 B2) (wcel C B2))) (wcel (co (cec A2 c_sm) (cec C c_sm) (cfv Q cmulr)) (cfv Q cbs)) $;

--| Lemma for ~ rngqiprngimf1 . (Contributed by AV, 7-Mar-2025.)
theorem rngqiprngimf1lem (ph: wff) (A2 B2 Q c_sm R c_x c_1 I J: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wi (wa ph (wcel A2 B2)) (wi (wa (wceq (cec A2 c_sm) (cfv Q c0g)) (wceq (co c_1 A2 c_x) (cfv J c0g))) (wceq A2 (cfv R c0g))) $;

--| The base set of the product of the quotient with a two-sided ideal and the two-sided ideal is the cartesian product of the base set of the quotient and the base set of the two-sided ideal. (Contributed by AV, 21-Feb-2025.)
theorem rngqipbas (ph: wff) (B2 C P Q c_sm R c_x c_1 I J: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wceq C (cfv Q cbs) $ >
  $ wceq P (co Q J cxps) $ >
  $ wi ph (wceq (cfv P cbs) (cxp C I)) $;

--| The product of the quotient with a two-sided ideal and the two-sided ideal is a non-unital ring. (Contributed by AV, 23-Feb-2025.)
theorem rngqiprng (ph: wff) (B2 C P Q c_sm R c_x c_1 I J: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wceq C (cfv Q cbs) $ >
  $ wceq P (co Q J cxps) $ >
  $ wi ph (wcel P crng) $;

--| ` F ` is a function from (the base set of) a non-unital ring to the product of the (base set ` C ` of the) quotient with a two-sided ideal and the (base set ` I ` of the) two-sided ideal (because of ~ 2idlbas , ` ( Base `` J ) = I ` !) (Contributed by AV, 21-Feb-2025.)
theorem rngqiprngimf {x3: setvar} (ph: wff) (B2 C: class) (P Q c_sm R c_x c_1 F: class x3) (I: class) (J: class x3):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wceq C (cfv Q cbs) $ >
  $ wceq P (co Q J cxps) $ >
  $ wceq F (cmpt x3 B2 (cop (cec (cv x3) c_sm) (co c_1 (cv x3) c_x))) $ >
  $ wi ph (wf B2 (cxp C I) F) $;

--| The value of the function ` F ` at an element of (the base set of) a non-unital ring. (Contributed by AV, 24-Feb-2025.)
theorem rngqiprngimfv {x3: setvar} (ph: wff) (A2 B2 C: class) (P Q: class x3) (c_sm: class) (R: class x3) (c_x c_1: class) (F: class x3) (I: class) (J: class x3):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wceq C (cfv Q cbs) $ >
  $ wceq P (co Q J cxps) $ >
  $ wceq F (cmpt x3 B2 (cop (cec (cv x3) c_sm) (co c_1 (cv x3) c_x))) $ >
  $ wi (wa ph (wcel A2 B2)) (wceq (cfv A2 F) (cop (cec A2 c_sm) (co c_1 A2 c_x))) $;

--| ` F ` is a homomorphism of the additive groups of non-unital rings. (Contributed by AV, 24-Feb-2025.)
theorem rngqiprngghm {x3: setvar} (ph: wff) (B2 C: class) (P Q: class x3) (c_sm R c_x c_1: class) (F: class x3) (I: class) (J: class x3):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wceq C (cfv Q cbs) $ >
  $ wceq P (co Q J cxps) $ >
  $ wceq F (cmpt x3 B2 (cop (cec (cv x3) c_sm) (co c_1 (cv x3) c_x))) $ >
  $ wi ph (wcel F (co R P cghm)) $;

--| ` F ` is a one-to-one function from (the base set of) a non-unital ring to the product of the (base set of the) quotient with a two-sided ideal and the (base set of the) two-sided ideal. (Contributed by AV, 7-Mar-2025.)
theorem rngqiprngimf1 {x3: setvar} (ph: wff) (B2 C: class) (P Q: class x3) (c_sm R c_x c_1: class) (F: class x3) (I: class) (J: class x3):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wceq C (cfv Q cbs) $ >
  $ wceq P (co Q J cxps) $ >
  $ wceq F (cmpt x3 B2 (cop (cec (cv x3) c_sm) (co c_1 (cv x3) c_x))) $ >
  $ wi ph (wf1 B2 (cxp C I) F) $;

--| ` F ` is a function from (the base set of) a non-unital ring onto the product of the (base set of the) quotient with a two-sided ideal and the (base set of the) two-sided ideal. (Contributed by AV, 5-Mar-2025.) (Proof shortened by AV, 24-Mar-2025.)
theorem rngqiprngimfo {x3: setvar} (ph: wff) (B2 C: class) (P Q: class x3) (c_sm R c_x c_1: class) (F: class x3) (I: class) (J: class x3):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wceq C (cfv Q cbs) $ >
  $ wceq P (co Q J cxps) $ >
  $ wceq F (cmpt x3 B2 (cop (cec (cv x3) c_sm) (co c_1 (cv x3) c_x))) $ >
  $ wi ph (wfo B2 (cxp C I) F) $;

--| ` F ` is linear with respect to the multiplication. (Contributed by AV, 28-Feb-2025.)
theorem rngqiprnglin {x3 a b: setvar} (ph: wff) (B2 C: class) (P: class x3) (Q: class x3 b) (c_sm: class b) (R: class) (c_x c_1: class b) (F: class x3) (I: class) (J: class x3 b):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wceq C (cfv Q cbs) $ >
  $ wceq P (co Q J cxps) $ >
  $ wceq F (cmpt x3 B2 (cop (cec (cv x3) c_sm) (co c_1 (cv x3) c_x))) $ >
  $ wi ph (wral a (wral b (wceq (cfv (co (cv a) (cv b) c_x) F) (co (cfv (cv a) F) (cfv (cv b) F) (cfv P cmulr))) B2) B2) $;

--| ` F ` is a homomorphism of non-unital rings. (Contributed by AV, 21-Feb-2025.)
theorem rngqiprngho {x3: setvar} (ph: wff) (B2 C: class) (P Q: class x3) (c_sm R c_x c_1: class) (F: class x3) (I: class) (J: class x3):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wceq C (cfv Q cbs) $ >
  $ wceq P (co Q J cxps) $ >
  $ wceq F (cmpt x3 B2 (cop (cec (cv x3) c_sm) (co c_1 (cv x3) c_x))) $ >
  $ wi ph (wcel F (co R P crnghm)) $;

--| ` F ` is an isomorphism of non-unital rings. (Contributed by AV, 21-Feb-2025.)
theorem rngqiprngim {x3: setvar} (ph: wff) (B2 C: class) (P Q: class x3) (c_sm R c_x c_1: class) (F: class x3) (I: class) (J: class x3):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wceq C (cfv Q cbs) $ >
  $ wceq P (co Q J cxps) $ >
  $ wceq F (cmpt x3 B2 (cop (cec (cv x3) c_sm) (co c_1 (cv x3) c_x))) $ >
  $ wi ph (wcel F (co R P crngim)) $;

--| The unity of a two-sided ideal of a non-unital ring is central, i.e., an element of the center of the multiplicative semigroup of the non-unital ring. This is part of the proof given in MathOverflow, which seems to be sufficient to show that ` F ` given below (see ~ rngqiprngimf ) is an isomorphism. In our proof, however we show that ` F ` is linear regarding the multiplication ( ~ rngqiprnglin ) via ~ rngqiprnglinlem1 instead. (Contributed by AV, 13-Feb-2025.)
theorem rng2idl1cntr (ph: wff) (R c_1 I J M: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wi ph (wcel c_1 (cfv M ccntr)) $;

--| In a unital ring, the quotient of the ring and a two-sided ideal is unital. (Contributed by AV, 20-Feb-2025.)
theorem rngringbdlem1 (ph: wff) (Q R I J: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq Q (co R (co R I cqg) cqus) $ >
  $ wi (wa ph (wcel R crg)) (wcel Q crg) $;

--| A non-unital ring is unital if and only if there is a (two-sided) ideal of the ring which is unital, and the quotient of the ring and the ideal is unital. (Proposed by GL, 12-Feb-2025.) (Contributed by AV, 14-Feb-2025.)
theorem rngringbdlem2 (ph: wff) (Q R I J: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq Q (co R (co R I cqg) cqus) $ >
  $ wi (wa ph (wcel Q crg)) (wcel R crg) $;

--| A non-unital ring is unital if and only if there is a (two-sided) ideal of the ring which is unital, and the quotient of the ring and the ideal is unital. (Proposed by GL, 12-Feb-2025.) (Contributed by AV, 20-Feb-2025.)
theorem rngringbd (ph: wff) (Q R I J: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq Q (co R (co R I cqg) cqus) $ >
  $ wi ph (wb (wcel R crg) (wcel Q crg)) $;

--| For every unital ring there is a (two-sided) ideal of the ring (in fact the base set of the ring itself) which is unital, and the quotient of the ring and the ideal is unital. (Proposed by GL, 12-Feb-2025.) (Contributed by AV, 13-Feb-2025.)
theorem ring2idlqus {i: setvar} (R: class):
  $ wi (wcel R crg) (wrex i (wa (wcel (co R (cv i) cress) crg) (wcel (co R (co R (cv i) cqg) cqus) crg)) (cfv R c2idl)) $;

--| A non-unital ring is unital if and only if there is a (two-sided) ideal of the ring which is unital, and the quotient of the ring and the ideal is unital. (Proposed by GL, 12-Feb-2025.) (Contributed by AV, 20-Feb-2025.)
theorem ring2idlqusb {i: setvar} (R: class):
  $ wi (wcel R crng) (wb (wcel R crg) (wrex i (wa (wcel (co R (cv i) cress) crg) (wcel (co R (co R (cv i) cqg) cqus) crg)) (cfv R c2idl))) $;

--| Lemma 1 for ~ rngqiprngfu (and lemma for ~ rngqiprngu ). (Contributed by AV, 16-Mar-2025.)
theorem rngqiprngfulem1 {x3: setvar} (ph: wff) (B2 Q c_sm: class) (R c_x c_1 I J: class x3):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wi ph (wcel Q crg) $ >
  $ wi ph (wrex x3 (wceq (cfv Q cur) (cec (cv x3) c_sm)) B2) $;

--| Lemma 2 for ~ rngqiprngfu (and lemma for ~ rngqiprngu ). (Contributed by AV, 16-Mar-2025.)
theorem rngqiprngfulem2 (ph: wff) (B2 Q c_sm R c_x c_1 E I J: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wi ph (wcel Q crg) $ >
  $ wi ph (wcel E (cfv Q cur)) $ >
  $ wi ph (wcel E B2) $;

--| Lemma 3 for ~ rngqiprngfu (and lemma for ~ rngqiprngu ). (Contributed by AV, 16-Mar-2025.)
theorem rngqiprngfulem3 (ph: wff) (B2 c_pl Q c_sm R c_x U c_1 E I J c_mi: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wi ph (wcel Q crg) $ >
  $ wi ph (wcel E (cfv Q cur)) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq U (co (co E (co c_1 E c_x) c_mi) c_1 c_pl) $ >
  $ wi ph (wcel U B2) $;

--| Lemma 4 for ~ rngqiprngfu . (Contributed by AV, 16-Mar-2025.)
theorem rngqiprngfulem4 (ph: wff) (B2 c_pl Q c_sm R c_x U c_1 E I J c_mi: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wi ph (wcel Q crg) $ >
  $ wi ph (wcel E (cfv Q cur)) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq U (co (co E (co c_1 E c_x) c_mi) c_1 c_pl) $ >
  $ wi ph (wceq (cec U c_sm) (cec E c_sm)) $;

--| Lemma 5 for ~ rngqiprngfu . (Contributed by AV, 16-Mar-2025.)
theorem rngqiprngfulem5 (ph: wff) (B2 c_pl Q c_sm R c_x U c_1 E I J c_mi: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wi ph (wcel Q crg) $ >
  $ wi ph (wcel E (cfv Q cur)) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq U (co (co E (co c_1 E c_x) c_mi) c_1 c_pl) $ >
  $ wi ph (wceq (co c_1 U c_x) c_1) $;

--| The ring unity of the product of the quotient with a two-sided ideal and the two-sided ideal, which both are rings. (Contributed by AV, 16-Mar-2025.)
theorem rngqipring1 (ph: wff) (B2 P c_pl Q c_sm R c_x U c_1 E I J c_mi: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wi ph (wcel Q crg) $ >
  $ wi ph (wcel E (cfv Q cur)) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq U (co (co E (co c_1 E c_x) c_mi) c_1 c_pl) $ >
  $ wceq P (co Q J cxps) $ >
  $ wi ph (wceq (cfv P cur) (cop (cec E c_sm) c_1)) $;

--| The function value of ` F ` at the constructed expected ring unity of ` R ` is the ring unity of the product of the quotient with the two-sided ideal and the two-sided ideal. (Contributed by AV, 16-Mar-2025.)
theorem rngqiprngfu {x3: setvar} (ph: wff) (B2: class) (c_pl: class x3) (Q c_sm: class) (R: class x3) (c_x U c_1 E: class) (F: class x3) (I: class) (J c_mi: class x3):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wi ph (wcel Q crg) $ >
  $ wi ph (wcel E (cfv Q cur)) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq U (co (co E (co c_1 E c_x) c_mi) c_1 c_pl) $ >
  $ wceq F (cmpt x3 B2 (cop (cec (cv x3) c_sm) (co c_1 (cv x3) c_x))) $ >
  $ wi ph (wceq (cfv U F) (cop (cec E c_sm) c_1)) $;

--| If a non-unital ring has a (two-sided) ideal which is unital, and the quotient of the ring and the ideal is also unital, then the ring is also unital with a ring unity which can be constructed from the ring unity of the ideal and a representative of the ring unity of the quotient. (Contributed by AV, 17-Mar-2025.)
theorem rngqiprngu (ph: wff) (B2 c_pl Q c_sm R c_x U c_1 E I J c_mi: class):
  $ wi ph (wcel R crng) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq J (co R I cress) $ >
  $ wi ph (wcel J crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wi ph (wcel Q crg) $ >
  $ wi ph (wcel E (cfv Q cur)) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq U (co (co E (co c_1 E c_x) c_mi) c_1 c_pl) $ >
  $ wi ph (wceq (cfv R cur) U) $;

--| If a non-unital ring has a (two-sided) ideal which is unital, and the quotient of the ring and the ideal is also unital, then the ring is also unital with a ring unity which can be constructed from the ring unity of the ideal and a representative of the ring unity of the quotient. (Contributed by AV, 17-Mar-2025.)
theorem ring2idlqus1 (c_pl R c_x U c_1 I c_mi: class):
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv (co R I cress) cur) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (w3a (wa (wcel R crng) (wcel I (cfv R c2idl))) (wa (wcel (co R I cress) crg) (wcel (co R (co R I cqg) cqus) crg)) (wcel U (cfv (co R (co R I cqg) cqus) cur))) (wa (wcel R crg) (wceq (cfv R cur) (co (co U (co c_1 U c_x) c_mi) c_1 c_pl))) $;

--| Extend class notation with the class of prime ideals.
term cprmidl: class;

--| Define the class of prime ideals of a ring ` R ` . A proper ideal ` I ` of ` R ` is prime if whenever ` A B C_ I ` for ideals ` A ` and ` B ` , either ` A C_ I ` or ` B C_ I ` . The more familiar definition using elements rather than ideals is equivalent provided ` R ` is commutative; see ~ prmidl2 and ~ isprmidlc . (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by Thierry Arnoux, 14-Jan-2024.)
axiom df_prmidl {x3 y1 i r a b: setvar}:
  $ wceq cprmidl (cmpt r crg (crab i (wa (wne (cv i) (cfv (cv r) cbs)) (wral a (wral b (wi (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) (cfv (cv r) cmulr)) (cv i)) (cv b)) (cv a)) (wo (wss (cv a) (cv i)) (wss (cv b) (cv i)))) (cfv (cv r) clidl)) (cfv (cv r) clidl))) (cfv (cv r) clidl))) $;

--| The class of prime ideals of a ring ` R ` . (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by Thierry Arnoux, 12-Jan-2024.)
theorem prmidlval {x3 y1 i a b: setvar} (B2: class x3 y1 i a b) (R: class) (c_x: class x3 y1 i a b):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wcel R crg) (wceq (cfv R cprmidl) (crab i (wa (wne (cv i) B2) (wral a (wral b (wi (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) c_x) (cv i)) (cv b)) (cv a)) (wo (wss (cv a) (cv i)) (wss (cv b) (cv i)))) (cfv R clidl)) (cfv R clidl))) (cfv R clidl))) $;

--| The predicate "is a prime ideal". (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by Thierry Arnoux, 12-Jan-2024.)
theorem isprmidl {x3 y1 a b: setvar} (B2: class x3 y1 a b) (P R: class) (c_x: class x3 y1 a b):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wcel R crg) (wb (wcel P (cfv R cprmidl)) (w3a (wcel P (cfv R clidl)) (wne P B2) (wral a (wral b (wi (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) c_x) P) (cv b)) (cv a)) (wo (wss (cv a) P) (wss (cv b) P))) (cfv R clidl)) (cfv R clidl)))) $;

--| A prime ideal is a proper ideal. (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by Thierry Arnoux, 12-Jan-2024.)
theorem prmidlnr (B2 P R c_x: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crg) (wcel P (cfv R cprmidl))) (wne P B2) $;

--| The main property of a prime ideal. (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by Thierry Arnoux, 12-Jan-2024.)
theorem prmidl {x3 y1: setvar} (B2: class x3 y1) (P R: class) (c_x: class x3 y1) (I: class y1) (J: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wa (wa (wcel R crg) (wcel P (cfv R cprmidl))) (wa (wcel I (cfv R clidl)) (wcel J (cfv R clidl)))) (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) c_x) P) J) I)) (wo (wss I P) (wss J P)) $;

--| A condition that shows an ideal is prime. For commutative rings, this is often taken to be the definition. See ~ ispridlc for the equivalence in the commutative case. (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by Thierry Arnoux, 12-Jan-2024.)
theorem prmidl2 {x3 y1: setvar} (B2 P R: class) (c_x: class x3 y1):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wa (wcel R crg) (wcel P (cfv R clidl))) (wa (wne P B2) (wral x3 (wral y1 (wi (wcel (co (cv x3) (cv y1) c_x) P) (wo (wcel (cv x3) P) (wcel (cv y1) P))) B2) B2))) (wcel P (cfv R cprmidl)) $;

--| Let ` P ` be a prime ideal containing the product ` ( I .X. J ) ` of two ideals ` I ` and ` J ` . Then ` I C_ P ` or ` J C_ P ` . (Contributed by Thierry Arnoux, 13-Apr-2024.)
theorem idlmulssprm (ph: wff) (P R c_xp I J: class):
  $ wceq c_xp (cfv (cfv R cmgp) clsm) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel P (cfv R cprmidl)) $ >
  $ wi ph (wcel I (cfv R clidl)) $ >
  $ wi ph (wcel J (cfv R clidl)) $ >
  $ wi ph (wss (co I J c_xp) P) $ >
  $ wi ph (wo (wss I P) (wss J P)) $;

--| A proper ideal cannot contain the ring unity. (Contributed by Thierry Arnoux, 9-Apr-2024.)
theorem pridln1 (B2 R c_1 I: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (w3a (wcel R crg) (wcel I (cfv R clidl)) (wne I B2)) (wn (wcel c_1 I)) $;

--| A prime ideal is an ideal. (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by Thierry Arnoux, 12-Jan-2024.)
theorem prmidlidl (P R: class):
  $ wi (wa (wcel R crg) (wcel P (cfv R cprmidl))) (wcel P (cfv R clidl)) $;

--| Prime ideals as a subset of ideals. (Contributed by Thierry Arnoux, 2-Jun-2024.)
theorem prmidlssidl (R: class):
  $ wi (wcel R crg) (wss (cfv R cprmidl) (cfv R clidl)) $;

--| Commutative/associative law for commutative ring. (Contributed by Thierry Arnoux, 14-Jan-2024.)
theorem cringm4 (B2 R c_x W X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R ccrg) (wa (wcel X B2) (wcel Y B2)) (wa (wcel Z B2) (wcel W B2))) (wceq (co (co X Y c_x) (co Z W c_x) c_x) (co (co X Z c_x) (co Y W c_x) c_x)) $;

--| The predicate "is prime ideal" for commutative rings. Alternate definition for commutative rings. See definition in [Lang] p. 92. (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by Thierry Arnoux, 12-Jan-2024.)
theorem isprmidlc {x3 y1: setvar} (B2 P R: class) (c_x: class x3 y1):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wcel R ccrg) (wb (wcel P (cfv R cprmidl)) (w3a (wcel P (cfv R clidl)) (wne P B2) (wral x3 (wral y1 (wi (wcel (co (cv x3) (cv y1) c_x) P) (wo (wcel (cv x3) P) (wcel (cv y1) P))) B2) B2))) $;

--| Property of a prime ideal in a commutative ring. (Contributed by Jeff Madsen, 17-Jun-2011.) (Revised by Thierry Arnoux, 12-Jan-2024.)
theorem prmidlc (B2 P R c_x I J: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wa (wcel R ccrg) (wcel P (cfv R cprmidl))) (w3a (wcel I B2) (wcel J B2) (wcel (co I J c_x) P))) (wo (wcel I P) (wcel J P)) $;

--| Property of a prime ideal in a commutative ring. (Contributed by Jeff Madsen, 17-Jun-2011.) (Revised by AV, 12-Jul-2026.)
theorem prmidlc2 (B2 P R c_x I J: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wa (wcel R ccrg) (wcel P (cfv R cprmidl))) (w3a (wcel I (cdif B2 P)) (wcel J B2) (wcel (co I J c_x) P))) (wcel J P) $;

--| The complement of a prime ideal is multiplicatively closed. (Contributed by Jeff Madsen, 17-Jun-2011.) (Revised by AV, 12-Jul-2026.)
theorem cmprmidlmcl (B2 P R c_x I J: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wa (wcel R ccrg) (wcel P (cfv R cprmidl))) (wa (wcel I (cdif B2 P)) (wcel J (cdif B2 P)))) (wcel (co I J c_x) (cdif B2 P)) $;

--| Property of prime ideals. (Contributed by Thierry Arnoux, 6-Jun-2026.)
theorem prmidlprop (ph: wff) (B2 P R c_x X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel P (cfv R cprmidl)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel (co X Y c_x) P) $ >
  $ wi ph (wo (wcel X P) (wcel Y P)) $;

--| The trivial ring does not have any prime ideal. (Contributed by Thierry Arnoux, 30-Jun-2024.)
theorem _0ringprmidl (B2 R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wa (wcel R crg) (wceq (cfv B2 chash) c1)) (wceq (cfv R cprmidl) c0) $;

--| The zero ideal of a commutative ring ` R ` is a prime ideal if and only if ` R ` is an integral domain. (Contributed by Thierry Arnoux, 30-Jun-2024.)
theorem prmidl0 (R c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wb (wa (wcel R ccrg) (wcel (csn c_0) (cfv R cprmidl))) (wcel R cidom) $;

--| The preimage of a prime ideal by a ring homomorphism is a prime ideal. (Contributed by Thierry Arnoux, 29-Jun-2024.)
theorem rhmpreimaprmidl (P R S F J: class):
  $ wceq P (cfv R cprmidl) $ >
  $ wi (wa (wa (wcel S ccrg) (wcel F (co R S crh))) (wcel J (cfv S cprmidl))) (wcel (cima (ccnv F) J) P) $;

--| If the quotient ring of a commutative ring relative to an ideal is an integral domain, that ideal must be prime. (Contributed by Thierry Arnoux, 16-Jan-2024.)
theorem qsidomlem1 (Q R I: class):
  $ wceq Q (co R (co R I cqg) cqus) $ >
  $ wi (wa (wa (wcel R ccrg) (wcel I (cfv R clidl))) (wcel Q cidom)) (wcel I (cfv R cprmidl)) $;

--| A quotient by a prime ideal is an integral domain. (Contributed by Thierry Arnoux, 16-Jan-2024.)
theorem qsidomlem2 (Q R I: class):
  $ wceq Q (co R (co R I cqg) cqus) $ >
  $ wi (wa (wcel R ccrg) (wcel I (cfv R cprmidl))) (wcel Q cidom) $;

--| An ideal ` I ` in the commutative ring ` R ` is prime if and only if the factor ring ` Q ` is an integral domain. (Contributed by Thierry Arnoux, 16-Jan-2024.)
theorem qsidom (Q R I: class):
  $ wceq Q (co R (co R I cqg) cqus) $ >
  $ wi (wa (wcel R ccrg) (wcel I (cfv R clidl))) (wb (wcel Q cidom) (wcel I (cfv R cprmidl))) $;

--| A quotient of a nonzero ring by a proper ideal is a nonzero ring. (Contributed by Thierry Arnoux, 9-Mar-2025.)
theorem qsnzr (ph: wff) (B2 Q R I: class):
  $ wceq Q (co R (co R I cqg) cqus) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel R cnzr) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wi ph (wne I B2) $ >
  $ wi ph (wcel Q cnzr) $;

--| Lemma for ~ ssdifidl : The set ` P ` used in the proof of ~ ssdifidl satisfies the condition of Zorn's Lemma. (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem ssdifidllem {p: setvar} (ph: wff p) (B2 P: class p) (R S I Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I (cfv R clidl)) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wceq (cin S I) c0) $ >
  $ wceq P (crab p (wa (wceq (cin S (cv p)) c0) (wss I (cv p))) (cfv R clidl)) $ >
  $ wi ph (wss Z P) $ >
  $ wi ph (wne Z c0) $ >
  $ wi ph (wor Z crpss) $ >
  $ wi ph (wcel (cuni Z) P) $;

--| Let ` R ` be a ring, and let ` I ` be an ideal of ` R ` disjoint with a set ` S ` . Then there exists an ideal ` i ` , maximal among the set ` P ` of ideals containing ` I ` and disjoint with ` S ` . (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem ssdifidl {i j p: setvar} (ph: wff p) (B2: class i j p) (P: class p) (R S I: class i j):
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I (cfv R clidl)) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wceq (cin S I) c0) $ >
  $ wceq P (crab p (wa (wceq (cin S (cv p)) c0) (wss I (cv p))) (cfv R clidl)) $ >
  $ wi ph (wrex i (wral j (wn (wpss (cv i) (cv j))) P) P) $;

--| If the set ` S ` of ~ ssdifidl is multiplicatively closed, then the ideal ` i ` is prime. (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem ssdifidlprm {i j p: setvar} (ph: wff p) (B2: class i j p) (P: class p) (R S I: class i) (M: class i j p):
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel I (cfv R clidl)) $ >
  $ wi ph (wcel S (cfv M csubmnd)) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wi ph (wceq (cin S I) c0) $ >
  $ wceq P (crab p (wa (wceq (cin S (cv p)) c0) (wss I (cv p))) (cfv R clidl)) $ >
  $ wi ph (wrex i (wa (wcel (cv i) (cfv R cprmidl)) (wral j (wn (wpss (cv i) (cv j))) P)) P) $;

--| The complement of a prime ideal is multiplicatively closed. Converse of ~ ssdifidlprm . (Contributed by Thierry Arnoux, 6-Jun-2026.)
theorem prmidlsubm (ph: wff) (B2 P R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel P (cfv R cprmidl)) $ >
  $ wi ph (wcel (cdif B2 P) (cfv (cfv R cmgp) csubmnd)) $;

--| Ring left-principal-ideal function.
term clpidl: class;

--| Class of left principal ideal rings.
term clpir: class;

--| Define the class of left principal ideals of a ring, which are ideals with a single generator. (Contributed by Stefan O'Rear, 3-Jan-2015.)
axiom df_lpidl {w g2: setvar}:
  $ wceq clpidl (cmpt w crg (ciun g2 (cfv (cv w) cbs) (csn (cfv (csn (cv g2)) (cfv (cv w) crsp))))) $;

--| Define the class of left principal ideal rings, rings where every left ideal has a single generator. (Contributed by Stefan O'Rear, 3-Jan-2015.)
axiom df_lpir {w: setvar}:
  $ wceq clpir (crab w (wceq (cfv (cv w) clidl) (cfv (cv w) clpidl)) crg) $;

--| Value of the set of principal ideals. (Contributed by Stefan O'Rear, 3-Jan-2015.)
theorem lpival {g2: setvar} (B2 P R K: class):
  $ wceq P (cfv R clpidl) $ >
  $ wceq K (cfv R crsp) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R crg) (wceq P (ciun g2 B2 (csn (cfv (csn (cv g2)) K)))) $;

--| Property of being a principal ideal. (Contributed by Stefan O'Rear, 3-Jan-2015.)
theorem islpidl {g2: setvar} (B2 P R I K: class):
  $ wceq P (cfv R clpidl) $ >
  $ wceq K (cfv R crsp) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R crg) (wb (wcel I P) (wrex g2 (wceq I (cfv (csn (cv g2)) K)) B2)) $;

--| The zero ideal is always principal. (Contributed by Stefan O'Rear, 3-Jan-2015.)
theorem lpi0 (P R c_0: class):
  $ wceq P (cfv R clpidl) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R crg) (wcel (csn c_0) P) $;

--| The unit ideal is always principal. (Contributed by Stefan O'Rear, 3-Jan-2015.)
theorem lpi1 (B2 P R: class):
  $ wceq P (cfv R clpidl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R crg) (wcel B2 P) $;

--| Principal ideal rings are where all ideals are principal. (Contributed by Stefan O'Rear, 3-Jan-2015.)
theorem islpir (P R U: class):
  $ wceq P (cfv R clpidl) $ >
  $ wceq U (cfv R clidl) $ >
  $ wb (wcel R clpir) (wa (wcel R crg) (wceq U P)) $;

--| Principal ideals are a subclass of ideal. (Contributed by Stefan O'Rear, 3-Jan-2015.)
theorem lpiss (P R U: class):
  $ wceq P (cfv R clpidl) $ >
  $ wceq U (cfv R clidl) $ >
  $ wi (wcel R crg) (wss P U) $;

--| Principal ideal rings are where all ideals are principal. (Contributed by Stefan O'Rear, 3-Jan-2015.)
theorem islpir2 (P R U: class):
  $ wceq P (cfv R clpidl) $ >
  $ wceq U (cfv R clidl) $ >
  $ wb (wcel R clpir) (wa (wcel R crg) (wss U P)) $;

--| Principal ideal rings are rings. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem lpirring (R: class):
  $ wi (wcel R clpir) (wcel R crg) $;

--| Division rings are principal ideal. (Contributed by Stefan O'Rear, 3-Jan-2015.)
theorem drnglpir (R: class):
  $ wi (wcel R cdr) (wcel R clpir) $;

--| Membership in principal ideals is closely related to divisibility. (Contributed by Stefan O'Rear, 3-Jan-2015.) (Revised by Mario Carneiro, 6-May-2015.)
theorem rspsn {x3: setvar} (B2 c_pa R G K: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq K (cfv R crsp) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi (wa (wcel R crg) (wcel G B2)) (wceq (cfv (csn G) K) (cab x3 (wbr G (cv x3) c_pa))) $;

--| An element generates an ideal iff it is contained in the ideal and all elements are right-divided by it. (Contributed by Stefan O'Rear, 3-Jan-2015.)
theorem lidldvgen {x3: setvar} (B2 c_pa R U G I K: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R clidl) $ >
  $ wceq K (cfv R crsp) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi (w3a (wcel R crg) (wcel I U) (wcel G B2)) (wb (wceq I (cfv (csn G) K)) (wa (wcel G I) (wral x3 (wbr G (cv x3) c_pa) I))) $;

--| An ideal is principal iff it contains an element which right-divides all elements. (Contributed by Stefan O'Rear, 3-Jan-2015.) (Revised by Wolf Lammen, 6-Sep-2020.)
theorem lpigen {x3 y1: setvar} (c_pa P R U I: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq P (cfv R clpidl) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi (wa (wcel R crg) (wcel I U)) (wb (wcel I P) (wrex x3 (wral y1 (wbr (cv x3) (cv y1) c_pa) I) I)) $;

--| Class of principal ideal domains.
term cpid: class;

--| A _principal ideal domain_ is an integral domain satisfying the left principal ideal property. (Contributed by Stefan O'Rear, 29-Mar-2015.)
axiom df_pid:
  $ wceq cpid (cin cidom clpir) $;

--| Extend class notation with the class of all pseudometric spaces.
term cpsmet: class;

--| Extend class notation with the class of all extended metric spaces.
term cxmet: class;

--| Extend class notation with the class of all metrics.
term cmet: class;

--| Extend class notation with the metric space ball function.
term cbl: class;

--| Extend class definition to include the class of filter bases.
term cfbas: class;

--| Extend class definition to include the filter generating function.
term cfg: class;

--| Extend class notation with a function mapping each metric space to the family of its open sets.
term cmopn: class;

--| Extend class notation with the function mapping metrics to the uniform structure generated by that metric.
term cmetu: class;

--| Define the set of all pseudometrics on a given base set. In a pseudo metric, two distinct points may have a distance zero. (Contributed by Thierry Arnoux, 7-Feb-2018.)
axiom df_psmet {x3 y1 z w d: setvar}:
  $ wceq cpsmet (cmpt x3 cvv (crab d (wral y1 (wa (wceq (co (cv y1) (cv y1) (cv d)) cc0) (wral z (wral w (wbr (co (cv y1) (cv z) (cv d)) (co (co (cv w) (cv y1) (cv d)) (co (cv w) (cv z) (cv d)) cxad) cle) (cv x3)) (cv x3))) (cv x3)) (co cxr (cxp (cv x3) (cv x3)) cmap))) $;

--| Define the set of all extended metrics on a given base set. The definition is similar to ~ df-met , but we also allow the metric to take on the value ` +oo ` . (Contributed by Mario Carneiro, 20-Aug-2015.)
axiom df_xmet {x3 y1 z w d: setvar}:
  $ wceq cxmet (cmpt x3 cvv (crab d (wral y1 (wral z (wa (wb (wceq (co (cv y1) (cv z) (cv d)) cc0) (wceq (cv y1) (cv z))) (wral w (wbr (co (cv y1) (cv z) (cv d)) (co (co (cv w) (cv y1) (cv d)) (co (cv w) (cv z) (cv d)) cxad) cle) (cv x3))) (cv x3)) (cv x3)) (co cxr (cxp (cv x3) (cv x3)) cmap))) $;

--| Define the (proper) class of all metrics. (A metric space is the metric's base set paired with the metric; see ~ df-ms . However, we will often also call the metric itself a "metric space".) Equivalent to Definition 14-1.1 of [Gleason] p. 223. The 4 properties in Gleason's definition are shown by ~ met0 , ~ metgt0 , ~ metsym , and ~ mettri . (Contributed by NM, 25-Aug-2006.)
axiom df_met {x3 y1 z w d: setvar}:
  $ wceq cmet (cmpt x3 cvv (crab d (wral y1 (wral z (wa (wb (wceq (co (cv y1) (cv z) (cv d)) cc0) (wceq (cv y1) (cv z))) (wral w (wbr (co (cv y1) (cv z) (cv d)) (co (co (cv w) (cv y1) (cv d)) (co (cv w) (cv z) (cv d)) caddc) cle) (cv x3))) (cv x3)) (cv x3)) (co cr (cxp (cv x3) (cv x3)) cmap))) $;

--| Define the metric space ball function. See ~ blval for its value. (Contributed by NM, 30-Aug-2006.) (Revised by Thierry Arnoux, 11-Feb-2018.)
axiom df_bl {x3 y1 z d: setvar}:
  $ wceq cbl (cmpt d cvv (cmpo x3 z (cdm (cdm (cv d))) cxr (crab y1 (wbr (co (cv x3) (cv y1) (cv d)) (cv z) clt) (cdm (cdm (cv d)))))) $;

--| Define a function whose value is the family of open sets of a metric space. See ~ elmopn for its main property. (Contributed by NM, 1-Sep-2006.)
axiom df_mopn {d: setvar}:
  $ wceq cmopn (cmpt d (cuni (crn cxmet)) (cfv (crn (cfv (cv d) cbl)) ctg)) $;

--| Define the class of all filter bases. Note that a filter base on one set is also a filter base for any superset, so there is not a unique base set that can be recovered. (Contributed by Jeff Hankins, 1-Sep-2009.) (Revised by Stefan O'Rear, 11-Jul-2015.)
axiom df_fbas {x3 y1 z w: setvar}:
  $ wceq cfbas (cmpt w cvv (crab x3 (w3a (wne (cv x3) c0) (wnel c0 (cv x3)) (wral y1 (wral z (wne (cin (cv x3) (cpw (cin (cv y1) (cv z)))) c0) (cv x3)) (cv x3))) (cpw (cpw (cv w))))) $;

--| Define the filter generating function. (Contributed by Jeff Hankins, 3-Sep-2009.) (Revised by Stefan O'Rear, 11-Jul-2015.)
axiom df_fg {x3 y1 w: setvar}:
  $ wceq cfg (cmpo w x3 cvv (cfv (cv w) cfbas) (crab y1 (wne (cin (cv x3) (cpw (cv y1))) c0) (cpw (cv w)))) $;

--| Define the function mapping metrics to the uniform structure generated by that metric. (Contributed by Thierry Arnoux, 1-Dec-2017.) (Revised by Thierry Arnoux, 11-Feb-2018.)
axiom df_metu {a d: setvar}:
  $ wceq cmetu (cmpt d (cuni (crn cpsmet)) (co (cxp (cdm (cdm (cv d))) (cdm (cdm (cv d)))) (crn (cmpt a crp (cima (ccnv (cv d)) (co cc0 (cv a) cico)))) cfg)) $;

--| Extend class notation with the field of complex numbers.
term ccnfld: class;

--| The field of complex numbers. Other number fields and rings can be constructed by applying the ` |``s ` restriction operator, for instance ` ( CCfld |`` AA ) ` is the field of algebraic numbers. The contract of this set is defined entirely by ~ cnfldex , ~ cnfldadd , ~ cnfldmul , ~ cnfldcj , ~ cnfldtset , ~ cnfldle , ~ cnfldds , and ~ cnfldbas . We may add additional members to this in the future. (Contributed by Stefan O'Rear, 27-Nov-2014.) (Revised by Thierry Arnoux, 15-Dec-2017.) Use maps-to notation for addition and multiplication. (Revised by GG, 31-Mar-2025.) (New usage is discouraged.)
axiom df_cnfld {x3 y1: setvar}:
  $ wceq ccnfld (cun (cun (ctp (cop (cfv cnx cbs) cc) (cop (cfv cnx cplusg) (cmpo x3 y1 cc cc (co (cv x3) (cv y1) caddc))) (cop (cfv cnx cmulr) (cmpo x3 y1 cc cc (co (cv x3) (cv y1) cmul)))) (csn (cop (cfv cnx cstv) ccj))) (cun (ctp (cop (cfv cnx cts) (cfv (ccom cabs cmin) cmopn)) (cop (cfv cnx cple) cle) (cop (cfv cnx cds) (ccom cabs cmin))) (csn (cop (cfv cnx cunif) (cfv (ccom cabs cmin) cmetu))))) $;

--| The field of complex numbers is a structure. (Contributed by Mario Carneiro, 14-Aug-2015.) (Revised by Thierry Arnoux, 17-Dec-2017.) Revise ~ df-cnfld . (Revised by GG, 31-Mar-2025.)
theorem cnfldstr:
  $ wbr ccnfld (cop c1 (cdc c1 c3)) cstr $;

--| The field of complex numbers is a set. (Contributed by Stefan O'Rear, 27-Nov-2014.) (Revised by Mario Carneiro, 14-Aug-2015.) (Revised by Thierry Arnoux, 17-Dec-2017.) Avoid complex number axioms and ~ ax-pow . (Revised by GG, 16-Mar-2025.)
theorem cnfldex:
  $ wcel ccnfld cvv $;

--| The base set of the field of complex numbers. (Contributed by Stefan O'Rear, 27-Nov-2014.) (Revised by Mario Carneiro, 6-Oct-2015.) (Revised by Thierry Arnoux, 17-Dec-2017.) Revise ~ df-cnfld . (Revised by GG, 31-Mar-2025.)
theorem cnfldbas:
  $ wceq cc (cfv ccnfld cbs) $;

--| The addition operation of the field of complex numbers. Version of ~ cnfldadd using maps-to notation, which does not require ~ ax-addf . (Contributed by GG, 31-Mar-2025.)
theorem mpocnfldadd {x3 y1: setvar}:
  $ wceq (cmpo x3 y1 cc cc (co (cv x3) (cv y1) caddc)) (cfv ccnfld cplusg) $;

--| The addition operation of the field of complex numbers. (Contributed by Stefan O'Rear, 27-Nov-2014.) (Revised by Mario Carneiro, 6-Oct-2015.) (Revised by Thierry Arnoux, 17-Dec-2017.) Revise ~ df-cnfld . (Revised by GG, 27-Apr-2025.)
theorem cnfldadd:
  $ wceq caddc (cfv ccnfld cplusg) $;

--| The multiplication operation of the field of complex numbers. Version of ~ cnfldmul using maps-to notation, which does not require ~ ax-mulf . (Contributed by GG, 31-Mar-2025.)
theorem mpocnfldmul {x3 y1: setvar}:
  $ wceq (cmpo x3 y1 cc cc (co (cv x3) (cv y1) cmul)) (cfv ccnfld cmulr) $;

--| The multiplication operation of the field of complex numbers. (Contributed by Stefan O'Rear, 27-Nov-2014.) (Revised by Mario Carneiro, 6-Oct-2015.) (Revised by Thierry Arnoux, 17-Dec-2017.) Revise ~ df-cnfld . (Revised by GG, 27-Apr-2025.)
theorem cnfldmul:
  $ wceq cmul (cfv ccnfld cmulr) $;

--| The conjugation operation of the field of complex numbers. (Contributed by Mario Carneiro, 6-Oct-2015.) (Revised by Thierry Arnoux, 17-Dec-2017.) (Revised by Thierry Arnoux, 17-Dec-2017.) Revise ~ df-cnfld . (Revised by GG, 31-Mar-2025.)
theorem cnfldcj:
  $ wceq ccj (cfv ccnfld cstv) $;

--| The topology component of the field of complex numbers. (Contributed by Mario Carneiro, 14-Aug-2015.) (Revised by Mario Carneiro, 6-Oct-2015.) (Revised by Thierry Arnoux, 17-Dec-2017.) Revise ~ df-cnfld . (Revised by GG, 31-Mar-2025.)
theorem cnfldtset:
  $ wceq (cfv (ccom cabs cmin) cmopn) (cfv ccnfld cts) $;

--| The ordering of the field of complex numbers. Note that this is not actually an ordering on ` CC ` , but we put it in the structure anyway because restricting to ` RR ` does not affect this component, so that ` ( CCfld |``s RR ) ` is an ordered field even though ` CCfld ` itself is not. (Contributed by Mario Carneiro, 14-Aug-2015.) (Revised by Mario Carneiro, 6-Oct-2015.) (Revised by Thierry Arnoux, 17-Dec-2017.) Revise ~ df-cnfld . (Revised by GG, 31-Mar-2025.)
theorem cnfldle:
  $ wceq cle (cfv ccnfld cple) $;

--| The metric of the field of complex numbers. (Contributed by Mario Carneiro, 14-Aug-2015.) (Revised by Mario Carneiro, 6-Oct-2015.) (Revised by Thierry Arnoux, 17-Dec-2017.) Revise ~ df-cnfld . (Revised by GG, 31-Mar-2025.)
theorem cnfldds:
  $ wceq (ccom cabs cmin) (cfv ccnfld cds) $;

--| The uniform structure component of the complex numbers. (Contributed by Thierry Arnoux, 17-Dec-2017.) Revise ~ df-cnfld . (Revised by GG, 31-Mar-2025.)
theorem cnfldunif:
  $ wceq (cfv (ccom cabs cmin) cmetu) (cfv ccnfld cunif) $;

--| The field of complex numbers is a function. The proof is much shorter than the proof of ~ cnfldfunALT by using ~ cnfldstr and ~ structn0fun : in addition, it must be shown that ` (/) e/ CCfld ` . (Contributed by AV, 18-Nov-2021.) Revise ~ df-cnfld . (Revised by GG, 31-Mar-2025.)
theorem cnfldfun:
  $ wfun ccnfld $;

--| The field of complex numbers is a function. Alternate proof of ~ cnfldfun not requiring that the index set of the components is ordered, but using quadratically many inequalities for the indices. (Contributed by AV, 14-Nov-2021.) (Proof shortened by AV, 11-Nov-2024.) Revise ~ df-cnfld . (Revised by GG, 31-Mar-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem cnfldfunALT:
  $ wfun ccnfld $;

--| The extended real structure is a structure. (Contributed by Mario Carneiro, 21-Aug-2015.)
theorem xrsstr:
  $ wbr cxrs (cop c1 (cdc c1 c2)) cstr $;

--| The extended real structure is a set. (Contributed by Mario Carneiro, 21-Aug-2015.)
theorem xrsex:
  $ wcel cxrs cvv $;

--| The addition operation of the extended real number structure. (Contributed by Mario Carneiro, 21-Aug-2015.)
theorem xrsadd:
  $ wceq cxad (cfv cxrs cplusg) $;

--| The multiplication operation of the extended real number structure. (Contributed by Mario Carneiro, 21-Aug-2015.)
theorem xrsmul:
  $ wceq cxmu (cfv cxrs cmulr) $;

--| The topology component of the extended real number structure. (Contributed by Mario Carneiro, 21-Aug-2015.)
theorem xrstset:
  $ wceq (cfv cle cordt) (cfv cxrs cts) $;

--| The complex numbers form a commutative ring. (Contributed by Mario Carneiro, 8-Jan-2015.) Avoid ~ ax-mulf . (Revised by GG, 31-Mar-2025.)
theorem cncrng:
  $ wcel ccnfld ccrg $;

--| The complex numbers form a ring. (Contributed by Stefan O'Rear, 27-Nov-2014.)
theorem cnring:
  $ wcel ccnfld crg $;

--| The "multiplicative group" of the extended reals is a commutative monoid (even though the "additive group" is not a semigroup, see ~ xrsmgmdifsgrp .) (Contributed by Mario Carneiro, 21-Aug-2015.)
theorem xrsmcmn:
  $ wcel (cfv cxrs cmgp) ccmn $;

--| Zero is the zero element of the field of complex numbers. (Contributed by Stefan O'Rear, 27-Nov-2014.)
theorem cnfld0:
  $ wceq cc0 (cfv ccnfld c0g) $;

--| One is the unity element of the field of complex numbers. (Contributed by Stefan O'Rear, 27-Nov-2014.) Avoid ~ ax-mulf . (Revised by GG, 31-Mar-2025.)
theorem cnfld1:
  $ wceq c1 (cfv ccnfld cur) $;

--| The additive inverse in the field of complex numbers. (Contributed by Stefan O'Rear, 27-Nov-2014.)
theorem cnfldneg (X: class):
  $ wi (wcel X cc) (wceq (cfv X (cfv ccnfld cminusg)) (cneg X)) $;

--| The functionalized addition operation of the field of complex numbers. (Contributed by Mario Carneiro, 2-Sep-2015.)
theorem cnfldplusf:
  $ wceq caddc (cfv ccnfld cplusf) $;

--| The subtraction operator in the field of complex numbers. (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem cnfldsub:
  $ wceq cmin (cfv ccnfld csg) $;

--| The complex numbers form a division ring. (Contributed by Stefan O'Rear, 27-Nov-2014.) Avoid ~ ax-mulf . (Revised by GG, 30-Apr-2025.)
theorem cndrng:
  $ wcel ccnfld cdr $;

--| The division operation in the field of complex numbers. (Contributed by Stefan O'Rear, 27-Nov-2014.) (Revised by Mario Carneiro, 2-Dec-2014.) Avoid ~ ax-mulf . (Revised by GG, 30-Apr-2025.)
theorem cnflddiv:
  $ wceq cdiv (cfv ccnfld cdvr) $;

--| The multiplicative inverse in the field of complex numbers. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem cnfldinv (X: class):
  $ wi (wa (wcel X cc) (wne X cc0)) (wceq (cfv X (cfv ccnfld cinvr)) (co c1 X cdiv)) $;

--| The group multiple function in the field of complex numbers. (Contributed by Mario Carneiro, 14-Jun-2015.)
theorem cnfldmulg (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cc)) (wceq (co A2 B2 (cfv ccnfld cmg)) (co A2 B2 cmul)) $;

--| The exponentiation operator in the field of complex numbers (for nonnegative exponents). (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem cnfldexp (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cn0)) (wceq (co B2 A2 (cfv (cfv ccnfld cmgp) cmg)) (co A2 B2 cexp)) $;

--| The complex numbers form a *-ring. (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem cnsrng:
  $ wcel ccnfld csr $;

--| The "additive group" of the extended reals is a magma. (Contributed by AV, 30-Jan-2020.)
theorem xrsmgm:
  $ wcel cxrs cmgm $;

--| The "additive group" of the extended reals is not a semigroup. (Contributed by AV, 30-Jan-2020.)
theorem xrsnsgrp:
  $ wnel cxrs csgrp $;

--| The "additive group" of the extended reals is a magma but not a semigroup, and therefore also not a monoid nor a group, in contrast to the "multiplicative group", see ~ xrsmcmn . (Contributed by AV, 30-Jan-2020.)
theorem xrsmgmdifsgrp:
  $ wcel cxrs (cdif cmgm csgrp) $;

--| The metric of the extended real number structure. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xrsds {x3 y1: setvar} (D: class x3 y1):
  $ wceq D (cfv cxrs cds) $ >
  $ wceq D (cmpo x3 y1 cxr cxr (cif (wbr (cv x3) (cv y1) cle) (co (cv y1) (cxne (cv x3)) cxad) (co (cv x3) (cxne (cv y1)) cxad))) $;

--| The metric of the extended real number structure. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xrsdsval (A2 B2 D: class):
  $ wceq D (cfv cxrs cds) $ >
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wceq (co A2 B2 D) (cif (wbr A2 B2 cle) (co B2 (cxne A2) cxad) (co A2 (cxne B2) cxad))) $;

--| The metric of the extended real number structure coincides with the real number metric on the reals. (Contributed by Mario Carneiro, 3-Sep-2015.)
theorem xrsdsreval (A2 B2 D: class):
  $ wceq D (cfv cxrs cds) $ >
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (co A2 B2 D) (cfv (co A2 B2 cmin) cabs)) $;

--| Lemma for ~ xrsdsreclb . (Contributed by Mario Carneiro, 3-Sep-2015.)
theorem xrsdsreclblem (A2 B2 D: class):
  $ wceq D (cfv cxrs cds) $ >
  $ wi (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wne A2 B2)) (wbr A2 B2 cle)) (wi (wcel (co B2 (cxne A2) cxad) cr) (wa (wcel A2 cr) (wcel B2 cr))) $;

--| The metric of the extended real number structure is only real when both arguments are real. (Contributed by Mario Carneiro, 3-Sep-2015.)
theorem xrsdsreclb (A2 B2 D: class):
  $ wceq D (cfv cxrs cds) $ >
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wne A2 B2)) (wb (wcel (co A2 B2 D) cr) (wa (wcel A2 cr) (wcel B2 cr))) $;

--| Lemma for ~ nn0subm and friends. (Contributed by Mario Carneiro, 18-Jun-2015.)
theorem cnsubmlem {x3 y1: setvar} (A2: class):
  $ wi (wcel (cv x3) A2) (wcel (cv x3) cc) $ >
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) A2)) (wcel (co (cv x3) (cv y1) caddc) A2) $ >
  $ wcel cc0 A2 $ >
  $ wcel A2 (cfv ccnfld csubmnd) $;

--| Lemma for ~ resubdrg and friends. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem cnsubglem {x3 y1: setvar} (A2: class) (B2: class x3 y1):
  $ wi (wcel (cv x3) A2) (wcel (cv x3) cc) $ >
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) A2)) (wcel (co (cv x3) (cv y1) caddc) A2) $ >
  $ wi (wcel (cv x3) A2) (wcel (cneg (cv x3)) A2) $ >
  $ wcel B2 A2 $ >
  $ wcel A2 (cfv ccnfld csubg) $;

--| Lemma for ~ resubdrg and friends. (Contributed by Mario Carneiro, 4-Dec-2014.) Avoid ~ ax-mulf . (Revised by GG, 30-Apr-2025.)
theorem cnsubrglem {x3 y1: setvar} (A2: class):
  $ wi (wcel (cv x3) A2) (wcel (cv x3) cc) $ >
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) A2)) (wcel (co (cv x3) (cv y1) caddc) A2) $ >
  $ wi (wcel (cv x3) A2) (wcel (cneg (cv x3)) A2) $ >
  $ wcel c1 A2 $ >
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) A2)) (wcel (co (cv x3) (cv y1) cmul) A2) $ >
  $ wcel A2 (cfv ccnfld csubrg) $;

--| Lemma for ~ resubdrg and friends. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem cnsubdrglem {x3 y1: setvar} (A2: class):
  $ wi (wcel (cv x3) A2) (wcel (cv x3) cc) $ >
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) A2)) (wcel (co (cv x3) (cv y1) caddc) A2) $ >
  $ wi (wcel (cv x3) A2) (wcel (cneg (cv x3)) A2) $ >
  $ wcel c1 A2 $ >
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) A2)) (wcel (co (cv x3) (cv y1) cmul) A2) $ >
  $ wi (wa (wcel (cv x3) A2) (wne (cv x3) cc0)) (wcel (co c1 (cv x3) cdiv) A2) $ >
  $ wa (wcel A2 (cfv ccnfld csubrg)) (wcel (co ccnfld A2 cress) cdr) $;

--| The rational numbers form a division subring of the complex numbers. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem qsubdrg:
  $ wa (wcel cq (cfv ccnfld csubrg)) (wcel (co ccnfld cq cress) cdr) $;

--| The integers form a subring of the complex numbers. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem zsubrg:
  $ wcel cz (cfv ccnfld csubrg) $;

--| The gaussian integers form a subring of the complex numbers. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem gzsubrg:
  $ wcel cgz (cfv ccnfld csubrg) $;

--| The nonnegative integers form a submonoid of the complex numbers. (Contributed by Mario Carneiro, 18-Jun-2015.)
theorem nn0subm:
  $ wcel cn0 (cfv ccnfld csubmnd) $;

--| The nonnegative reals form a submonoid of the complex numbers. (Contributed by Mario Carneiro, 20-Jun-2015.)
theorem rege0subm:
  $ wcel (co cc0 cpnf cico) (cfv ccnfld csubmnd) $;

--| The regular absolute value function on the complex numbers is in fact an absolute value under our definition. (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem absabv:
  $ wcel cabs (cfv ccnfld cabv) $;

--| The integers are a subset of any subring of the complex numbers. (Contributed by Mario Carneiro, 15-Oct-2015.)
theorem zsssubrg (R: class):
  $ wi (wcel R (cfv ccnfld csubrg)) (wss cz R) $;

--| The rational numbers are a subset of any subfield of the complex numbers. (Contributed by Mario Carneiro, 15-Oct-2015.)
theorem qsssubdrg (R: class):
  $ wi (wa (wcel R (cfv ccnfld csubrg)) (wcel (co ccnfld R cress) cdr)) (wss cq R) $;

--| There are no subrings of the complex numbers strictly between ` RR ` and ` CC ` . (Contributed by Mario Carneiro, 15-Oct-2015.)
theorem cnsubrg (R: class):
  $ wi (wa (wcel R (cfv ccnfld csubrg)) (wss cr R)) (wcel R (cpr cr cc)) $;

--| The unit group of the complex numbers is an abelian group. (Contributed by Mario Carneiro, 21-Jun-2015.)
theorem cnmgpabl (M: class):
  $ wceq M (co (cfv ccnfld cmgp) (cdif cc (csn cc0)) cress) $ >
  $ wcel M cabl $;

--| The group identity element of nonzero complex number multiplication is one. (Contributed by Steve Rodriguez, 23-Feb-2007.) (Revised by AV, 26-Aug-2021.)
theorem cnmgpid (M: class):
  $ wceq M (co (cfv ccnfld cmgp) (cdif cc (csn cc0)) cress) $ >
  $ wceq (cfv M c0g) c1 $;

--| Lemma for ~ rpmsubg and friends. (Contributed by Mario Carneiro, 21-Jun-2015.)
theorem cnmsubglem {x3 y1: setvar} (A2 M: class):
  $ wceq M (co (cfv ccnfld cmgp) (cdif cc (csn cc0)) cress) $ >
  $ wi (wcel (cv x3) A2) (wcel (cv x3) cc) $ >
  $ wi (wcel (cv x3) A2) (wne (cv x3) cc0) $ >
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) A2)) (wcel (co (cv x3) (cv y1) cmul) A2) $ >
  $ wcel c1 A2 $ >
  $ wi (wcel (cv x3) A2) (wcel (co c1 (cv x3) cdiv) A2) $ >
  $ wcel A2 (cfv M csubg) $;

--| The positive reals form a multiplicative subgroup of the complex numbers. (Contributed by Mario Carneiro, 21-Jun-2015.)
theorem rpmsubg (M: class):
  $ wceq M (co (cfv ccnfld cmgp) (cdif cc (csn cc0)) cress) $ >
  $ wcel crp (cfv M csubg) $;

--| Lemma for ~ gzrngunit . (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem gzrngunitlem (A2 Z: class):
  $ wceq Z (co ccnfld cgz cress) $ >
  $ wi (wcel A2 (cfv Z cui)) (wbr c1 (cfv A2 cabs) cle) $;

--| The units on ` ZZ [ _i ] ` are the gaussian integers with norm ` 1 ` . (Contributed by Mario Carneiro, 4-Dec-2014.)
theorem gzrngunit (A2 Z: class):
  $ wceq Z (co ccnfld cgz cress) $ >
  $ wb (wcel A2 (cfv Z cui)) (wa (wcel A2 cgz) (wceq (cfv A2 cabs) c1)) $;

--| Relate a group sum on ` CCfld ` to a finite sum on the complex numbers. (Contributed by Mario Carneiro, 28-Dec-2014.)
theorem gsumfsum {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wceq (co ccnfld (cmpt k A2 B2) cgsu) (csu k A2 B2)) $;

--| Relate a group sum on ` ( CCfld |``s RR ) ` to a finite sum on the reals. Cf. ~ gsumfsum . (Contributed by Thierry Arnoux, 7-Sep-2018.)
theorem regsumfsum {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cr) $ >
  $ wi ph (wceq (co (co ccnfld cr cress) (cmpt k A2 B2) cgsu) (csu k A2 B2)) $;

--| Exponentiation is a monoid homomorphism from addition to multiplication. (Contributed by Mario Carneiro, 18-Jun-2015.)
theorem expmhm {x3: setvar} (A2: class) (M N: class x3):
  $ wceq N (co ccnfld cn0 cress) $ >
  $ wceq M (cfv ccnfld cmgp) $ >
  $ wi (wcel A2 cc) (wcel (cmpt x3 cn0 (co A2 (cv x3) cexp)) (co N M cmhm)) $;

--| The nonnegative integers form a semiring (commutative by ~ subcmn ). (Contributed by Thierry Arnoux, 1-May-2018.)
theorem nn0srg:
  $ wcel (co ccnfld cn0 cress) csrg $;

--| The nonnegative real numbers form a semiring (commutative by ~ subcmn ). (Contributed by Thierry Arnoux, 6-Sep-2018.)
theorem rge0srg:
  $ wcel (co ccnfld (co cc0 cpnf cico) cress) csrg $;

--| The additive law of the extended nonnegative real numbers monoid is the addition in the extended real numbers. (Contributed by Thierry Arnoux, 20-Mar-2017.)
theorem xrge0plusg:
  $ wceq cxad (cfv (co cxrs (co cc0 cpnf cicc) cress) cplusg) $;

--| The extended real numbers, restricted to ` RR* \ { -oo } ` , form an additive monoid - in contrast to the full structure, see ~ xrsmgmdifsgrp . (Contributed by Mario Carneiro, 27-Nov-2014.)
theorem xrs1mnd (R: class):
  $ wceq R (co cxrs (cdif cxr (csn cmnf)) cress) $ >
  $ wcel R cmnd $;

--| The zero of the extended real number monoid. (Contributed by Mario Carneiro, 21-Aug-2015.)
theorem xrs10 (R: class):
  $ wceq R (co cxrs (cdif cxr (csn cmnf)) cress) $ >
  $ wceq cc0 (cfv R c0g) $;

--| The extended real numbers restricted to ` RR* \ { -oo } ` form a commutative monoid. They are not a group because ` 1 + +oo = 2 + +oo ` even though ` 1 =/= 2 ` . (Contributed by Mario Carneiro, 27-Nov-2014.)
theorem xrs1cmn (R: class):
  $ wceq R (co cxrs (cdif cxr (csn cmnf)) cress) $ >
  $ wcel R ccmn $;

--| The nonnegative extended real numbers are a submonoid of the nonnegative-infinite extended reals. (Contributed by Mario Carneiro, 21-Aug-2015.)
theorem xrge0subm (R: class):
  $ wceq R (co cxrs (cdif cxr (csn cmnf)) cress) $ >
  $ wcel (co cc0 cpnf cicc) (cfv R csubmnd) $;

--| The nonnegative extended real numbers are a monoid. (Contributed by Mario Carneiro, 30-Aug-2015.)
theorem xrge0cmn:
  $ wcel (co cxrs (co cc0 cpnf cicc) cress) ccmn $;

--| The nonnegative extended real numbers form an ordered monoid. (Contributed by Thierry Arnoux, 22-Mar-2018.)
theorem xrge0omnd:
  $ wcel (co cxrs (co cc0 cpnf cicc) cress) comnd $;

--| Extend class notation with the (unital) ring of integers.
term czring: class;

--| The (unital) ring of integers. (Contributed by Alexander van der Vekens, 9-Jun-2019.)
axiom df_zring:
  $ wceq czring (co ccnfld cz cress) $;

--| The ring of integers is a commutative ring. (Contributed by AV, 13-Jun-2019.)
theorem zringcrng:
  $ wcel czring ccrg $;

--| The ring of integers is a ring. (Contributed by AV, 20-May-2019.) (Revised by AV, 9-Jun-2019.) (Proof shortened by AV, 13-Jun-2019.)
theorem zringring:
  $ wcel czring crg $;

--| The ring of integers is a non-unital ring. (Contributed by AV, 17-Mar-2025.)
theorem zringrng:
  $ wcel czring crng $;

--| The ring of integers is an (additive) abelian group. (Contributed by AV, 13-Jun-2019.)
theorem zringabl:
  $ wcel czring cabl $;

--| The ring of integers is an (additive) group. (Contributed by AV, 10-Jun-2019.)
theorem zringgrp:
  $ wcel czring cgrp $;

--| The integers are the base of the ring of integers. (Contributed by Thierry Arnoux, 31-Oct-2017.) (Revised by AV, 9-Jun-2019.)
theorem zringbas:
  $ wceq cz (cfv czring cbs) $;

--| The addition operation of the ring of integers. (Contributed by Thierry Arnoux, 8-Nov-2017.) (Revised by AV, 9-Jun-2019.)
theorem zringplusg:
  $ wceq caddc (cfv czring cplusg) $;

--| The subtraction of elements in the ring of integers. (Contributed by AV, 24-Mar-2025.)
theorem zringsub (c_mi X Y: class):
  $ wceq c_mi (cfv czring csg) $ >
  $ wi (wa (wcel X cz) (wcel Y cz)) (wceq (co X Y c_mi) (co X Y cmin)) $;

--| The multiplication (group power) operation of the group of integers. (Contributed by Thierry Arnoux, 31-Oct-2017.) (Revised by AV, 9-Jun-2019.)
theorem zringmulg (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wceq (co A2 B2 (cfv czring cmg)) (co A2 B2 cmul)) $;

--| The multiplication operation of the ring of integers. (Contributed by Thierry Arnoux, 1-Nov-2017.) (Revised by AV, 9-Jun-2019.)
theorem zringmulr:
  $ wceq cmul (cfv czring cmulr) $;

--| The zero element of the ring of integers. (Contributed by Thierry Arnoux, 1-Nov-2017.) (Revised by AV, 9-Jun-2019.)
theorem zring0:
  $ wceq cc0 (cfv czring c0g) $;

--| The unity element of the ring of integers. (Contributed by Thierry Arnoux, 1-Nov-2017.) (Revised by AV, 9-Jun-2019.)
theorem zring1:
  $ wceq c1 (cfv czring cur) $;

--| The ring of integers is a nonzero ring. (Contributed by AV, 18-Apr-2020.)
theorem zringnzr:
  $ wcel czring cnzr $;

--| Ring divisibility in the ring of integers corresponds to ordinary divisibility in ` ZZ ` . (Contributed by Stefan O'Rear, 3-Jan-2015.) (Revised by AV, 9-Jun-2019.)
theorem dvdsrzring:
  $ wceq cdvds (cfv czring cdsr) $;

--| Lemma for ~ zringlpir . A nonzero ideal of integers contains some positive integers. (Contributed by Stefan O'Rear, 3-Jan-2015.) (Revised by AV, 9-Jun-2019.)
theorem zringlpirlem1 (ph: wff) (I: class):
  $ wi ph (wcel I (cfv czring clidl)) $ >
  $ wi ph (wne I (csn cc0)) $ >
  $ wi ph (wne (cin I cn) c0) $;

--| Lemma for ~ zringlpir . A nonzero ideal of integers contains the least positive element. (Contributed by Stefan O'Rear, 3-Jan-2015.) (Revised by AV, 9-Jun-2019.) (Revised by AV, 27-Sep-2020.)
theorem zringlpirlem2 (ph: wff) (G I: class):
  $ wi ph (wcel I (cfv czring clidl)) $ >
  $ wi ph (wne I (csn cc0)) $ >
  $ wceq G (cinf (cin I cn) cr clt) $ >
  $ wi ph (wcel G I) $;

--| Lemma for ~ zringlpir . All elements of a nonzero ideal of integers are divided by the least one. (Contributed by Stefan O'Rear, 3-Jan-2015.) (Revised by AV, 9-Jun-2019.) (Proof shortened by AV, 27-Sep-2020.)
theorem zringlpirlem3 (ph: wff) (G I X: class):
  $ wi ph (wcel I (cfv czring clidl)) $ >
  $ wi ph (wne I (csn cc0)) $ >
  $ wceq G (cinf (cin I cn) cr clt) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wbr G X cdvds) $;

--| The additive inverse of an element of the ring of integers. (Contributed by AV, 24-May-2019.) (Revised by AV, 10-Jun-2019.)
theorem zringinvg (A2: class):
  $ wi (wcel A2 cz) (wceq (cneg A2) (cfv A2 (cfv czring cminusg))) $;

--| The units of ` ZZ ` are the integers with norm ` 1 ` , i.e. ` 1 ` and ` -u 1 ` . (Contributed by Mario Carneiro, 5-Dec-2014.) (Revised by AV, 10-Jun-2019.)
theorem zringunit (A2: class):
  $ wb (wcel A2 (cfv czring cui)) (wa (wcel A2 cz) (wceq (cfv A2 cabs) c1)) $;

--| The integers are a principal ideal ring. (Contributed by Stefan O'Rear, 3-Jan-2015.) (Revised by AV, 9-Jun-2019.) (Proof shortened by AV, 27-Sep-2020.)
theorem zringlpir:
  $ wcel czring clpir $;

--| The integers are not a division ring, and therefore not a field. (Contributed by AV, 22-Oct-2021.)
theorem zringndrg:
  $ wnel czring cdr $;

--| The integers are a cyclic group. (Contributed by Mario Carneiro, 21-Apr-2016.) (Revised by AV, 9-Jun-2019.)
theorem zringcyg:
  $ wcel czring ccyg $;

--| Subtraction in the ring of integers. (Contributed by AV, 3-Aug-2019.)
theorem zringsubgval (c_mi X Y: class):
  $ wceq c_mi (cfv czring csg) $ >
  $ wi (wa (wcel X cz) (wcel Y cz)) (wceq (co X Y cmin) (co X Y c_mi)) $;

--| The multiplicative group of the ring of integers is the restriction of the multiplicative group of the complex numbers to the integers. (Contributed by AV, 15-Jun-2019.)
theorem zringmpg:
  $ wceq (co (cfv ccnfld cmgp) cz cress) (cfv czring cmgp) $;

--| A positive integer is irreducible over ` ZZ ` iff it is a prime number. (Contributed by Mario Carneiro, 5-Dec-2014.) (Revised by AV, 10-Jun-2019.)
theorem prmirredlem (A2 I: class):
  $ wceq I (cfv czring cir) $ >
  $ wi (wcel A2 cn) (wb (wcel A2 I) (wcel A2 cprime)) $;

--| The positive irreducible elements of ` ZZ ` are the prime numbers. This is an alternative way to define ` Prime ` . (Contributed by Mario Carneiro, 5-Dec-2014.) (Revised by AV, 10-Jun-2019.)
theorem dfprm2 (I: class):
  $ wceq I (cfv czring cir) $ >
  $ wceq cprime (cin cn I) $;

--| The irreducible elements of ` ZZ ` are exactly the prime numbers (and their negatives). (Contributed by Mario Carneiro, 5-Dec-2014.) (Revised by AV, 10-Jun-2019.)
theorem prmirred (A2 I: class):
  $ wceq I (cfv czring cir) $ >
  $ wb (wcel A2 I) (wa (wcel A2 cz) (wcel (cfv A2 cabs) cprime)) $;

--| Exponentiation is a group homomorphism from addition to multiplication. (Contributed by Mario Carneiro, 18-Jun-2015.) (Revised by AV, 10-Jun-2019.)
theorem expghm {x3: setvar} (A2: class) (U M: class x3):
  $ wceq M (cfv ccnfld cmgp) $ >
  $ wceq U (co M (cdif cc (csn cc0)) cress) $ >
  $ wi (wa (wcel A2 cc) (wne A2 cc0)) (wcel (cmpt x3 cz (co A2 (cv x3) cexp)) (co czring U cghm)) $;

--| The powers of a group element give a homomorphism from ` ZZ ` to a group. The name ` .1. ` should not be taken as a constraint as it may be any group element. (Contributed by Mario Carneiro, 13-Jun-2015.) (Revised by AV, 12-Jun-2019.)
theorem mulgghm2 {n: setvar} (B2 R c_x c_1: class) (F: class n):
  $ wceq c_x (cfv R cmg) $ >
  $ wceq F (cmpt n cz (co (cv n) c_1 c_x)) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wa (wcel R cgrp) (wcel c_1 B2)) (wcel F (co czring R cghm)) $;

--| The powers of the element ` 1 ` give a ring homomorphism from ` ZZ ` to a ring. (Contributed by Mario Carneiro, 14-Jun-2015.) (Revised by AV, 12-Jun-2019.)
theorem mulgrhm {n: setvar} (R c_x c_1: class) (F: class n):
  $ wceq c_x (cfv R cmg) $ >
  $ wceq F (cmpt n cz (co (cv n) c_1 c_x)) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R crg) (wcel F (co czring R crh)) $;

--| The powers of the element ` 1 ` give the unique ring homomorphism from ` ZZ ` to a ring. (Contributed by Mario Carneiro, 14-Jun-2015.) (Revised by AV, 12-Jun-2019.)
theorem mulgrhm2 {n: setvar} (R c_x c_1: class) (F: class n):
  $ wceq c_x (cfv R cmg) $ >
  $ wceq F (cmpt n cz (co (cv n) c_1 c_x)) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R crg) (wceq (co czring R crh) (csn F)) $;

--| The ring of integers is an initial object in the category of unital rings (within a universe containing the ring of integers). Example 7.2 (6) of [Adamek] p. 101 , and example in [Lang] p. 58. (Contributed by AV, 3-Apr-2020.)
theorem irinitoringc (ph: wff) (C U V: class):
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel czring U) $ >
  $ wceq C (cfv U cringc) $ >
  $ wi ph (wcel czring (cfv C cinito)) $;

--| There is no zero object in the category of unital rings (at least in a universe which contains the zero ring and the ring of integers). Example 7.9 (3) in [Adamek] p. 103. (Contributed by AV, 18-Apr-2020.)
theorem nzerooringczr (ph: wff) (C U V Z: class):
  $ wi ph (wcel U V) $ >
  $ wceq C (cfv U cringc) $ >
  $ wi ph (wcel Z (cdif crg cnzr)) $ >
  $ wi ph (wcel Z U) $ >
  $ wi ph (wcel czring U) $ >
  $ wi ph (wceq (cfv C czeroo) c0) $;

--| Lemma 1 for ~ pzriprng : ` R ` is a non-unital (actually a unital!) ring. (Contributed by AV, 17-Mar-2025.)
theorem pzriprnglem1 (R: class):
  $ wceq R (co czring czring cxps) $ >
  $ wcel R crng $;

--| Lemma 2 for ~ pzriprng : The base set of ` R ` is the cartesian product of the integers. (Contributed by AV, 17-Mar-2025.)
theorem pzriprnglem2 (R: class):
  $ wceq R (co czring czring cxps) $ >
  $ wceq (cfv R cbs) (cxp cz cz) $;

--| Lemma 3 for ~ pzriprng : An element of ` I ` is an ordered pair. (Contributed by AV, 18-Mar-2025.)
theorem pzriprnglem3 {x3: setvar} (R I: class x3) (X: class):
  $ wceq R (co czring czring cxps) $ >
  $ wceq I (cxp cz (csn cc0)) $ >
  $ wb (wcel X I) (wrex x3 (wceq X (cop (cv x3) cc0)) cz) $;

--| Lemma 4 for ~ pzriprng : ` I ` is a subgroup of ` R ` . (Contributed by AV, 18-Mar-2025.)
theorem pzriprnglem4 (R I: class):
  $ wceq R (co czring czring cxps) $ >
  $ wceq I (cxp cz (csn cc0)) $ >
  $ wcel I (cfv R csubg) $;

--| Lemma 5 for ~ pzriprng : ` I ` is a subring of the non-unital ring ` R ` . (Contributed by AV, 18-Mar-2025.)
theorem pzriprnglem5 (R I: class):
  $ wceq R (co czring czring cxps) $ >
  $ wceq I (cxp cz (csn cc0)) $ >
  $ wcel I (cfv R csubrng) $;

--| Lemma 6 for ~ pzriprng : ` J ` has a ring unity. (Contributed by AV, 19-Mar-2025.)
theorem pzriprnglem6 (R I J X: class):
  $ wceq R (co czring czring cxps) $ >
  $ wceq I (cxp cz (csn cc0)) $ >
  $ wceq J (co R I cress) $ >
  $ wi (wcel X I) (wa (wceq (co (cop c1 cc0) X (cfv J cmulr)) X) (wceq (co X (cop c1 cc0) (cfv J cmulr)) X)) $;

--| Lemma 7 for ~ pzriprng : ` J ` is a unital ring. (Contributed by AV, 19-Mar-2025.)
theorem pzriprnglem7 (R I J: class):
  $ wceq R (co czring czring cxps) $ >
  $ wceq I (cxp cz (csn cc0)) $ >
  $ wceq J (co R I cress) $ >
  $ wcel J crg $;

--| Lemma 8 for ~ pzriprng : ` I ` resp. ` J ` is a two-sided ideal of the non-unital ring ` R ` . (Contributed by AV, 21-Mar-2025.)
theorem pzriprnglem8 (R I J: class):
  $ wceq R (co czring czring cxps) $ >
  $ wceq I (cxp cz (csn cc0)) $ >
  $ wceq J (co R I cress) $ >
  $ wcel I (cfv R c2idl) $;

--| Lemma 9 for ~ pzriprng : The ring unity of the ring ` J ` . (Contributed by AV, 22-Mar-2025.)
theorem pzriprnglem9 (R c_1 I J: class):
  $ wceq R (co czring czring cxps) $ >
  $ wceq I (cxp cz (csn cc0)) $ >
  $ wceq J (co R I cress) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_1 (cop c1 cc0) $;

--| Lemma 10 for ~ pzriprng : The equivalence classes of ` R ` modulo ` J ` . (Contributed by AV, 22-Mar-2025.)
theorem pzriprnglem10 (c_sm R c_1 I J X Y: class):
  $ wceq R (co czring czring cxps) $ >
  $ wceq I (cxp cz (csn cc0)) $ >
  $ wceq J (co R I cress) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wi (wa (wcel X cz) (wcel Y cz)) (wceq (cec (cop X Y) c_sm) (cxp cz (csn Y))) $;

--| Lemma 11 for ~ pzriprng : The base set of the quotient of ` R ` and ` J ` . (Contributed by AV, 22-Mar-2025.)
theorem pzriprnglem11 {r: setvar} (Q: class r) (c_sm: class) (R c_1 I J: class r):
  $ wceq R (co czring czring cxps) $ >
  $ wceq I (cxp cz (csn cc0)) $ >
  $ wceq J (co R I cress) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wceq (cfv Q cbs) (ciun r cz (csn (cxp cz (csn (cv r))))) $;

--| Lemma 12 for ~ pzriprng : ` Q ` has a ring unity. (Contributed by AV, 23-Mar-2025.)
theorem pzriprnglem12 (Q c_sm R c_1 I J X: class):
  $ wceq R (co czring czring cxps) $ >
  $ wceq I (cxp cz (csn cc0)) $ >
  $ wceq J (co R I cress) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wi (wcel X (cfv Q cbs)) (wa (wceq (co (cxp cz (csn c1)) X (cfv Q cmulr)) X) (wceq (co X (cxp cz (csn c1)) (cfv Q cmulr)) X)) $;

--| Lemma 13 for ~ pzriprng : ` Q ` is a unital ring. (Contributed by AV, 23-Mar-2025.)
theorem pzriprnglem13 (Q c_sm R c_1 I J: class):
  $ wceq R (co czring czring cxps) $ >
  $ wceq I (cxp cz (csn cc0)) $ >
  $ wceq J (co R I cress) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wcel Q crg $;

--| Lemma 14 for ~ pzriprng : The ring unity of the ring ` Q ` . (Contributed by AV, 23-Mar-2025.)
theorem pzriprnglem14 (Q c_sm R c_1 I J: class):
  $ wceq R (co czring czring cxps) $ >
  $ wceq I (cxp cz (csn cc0)) $ >
  $ wceq J (co R I cress) $ >
  $ wceq c_1 (cfv J cur) $ >
  $ wceq c_sm (co R I cqg) $ >
  $ wceq Q (co R c_sm cqus) $ >
  $ wceq (cfv Q cur) (cxp cz (csn c1)) $;

--| The non-unital ring ` ( ZZring Xs. ZZring ) ` is unital because it has the two-sided ideal ` ( ZZ X. { 0 } ) ` , which is unital, and the quotient of the ring and the ideal is also unital (using ~ ring2idlqusb ). (Contributed by AV, 23-Mar-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem pzriprngALT:
  $ wcel (co czring czring cxps) crg $;

--| The ring unity of the ring ` ( ZZring Xs. ZZring ) ` constructed from the ring unity of the two-sided ideal ` ( ZZ X. { 0 } ) ` and the ring unity of the quotient of the ring and the ideal (using ~ ring2idlqus1 ). (Contributed by AV, 24-Mar-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem pzriprng1ALT:
  $ wceq (cfv (co czring czring cxps) cur) (cop c1 c1) $;

--| The non-unital ring ` ( ZZring Xs. ZZring ) ` is unital. Direct proof in contrast to ~ pzriprngALT . (Contributed by AV, 25-Mar-2025.)
theorem pzriprng:
  $ wcel (co czring czring cxps) crg $;

--| The ring unity of the ring ` ( ZZring Xs. ZZring ) ` . Direct proof in contrast to ~ pzriprng1ALT . (Contributed by AV, 25-Mar-2025.)
theorem pzriprng1:
  $ wceq (cfv (co czring czring cxps) cur) (cop c1 c1) $;

--| Map the rationals into a field, or the integers into a ring.
term czrh: class;

--| Augment an abelian group with vector space operations to turn it into a ` ZZ ` -module.
term czlm: class;

--| Syntax for ring characteristic.
term cchr: class;

--| The ring of integers modulo ` n ` .
term czn: class;

--| Define the unique homomorphism from the integers into a ring. This encodes the usual notation of ` n = 1r + 1r + ... + 1r ` for integers (see also ~ df-mulg ). (Contributed by Mario Carneiro, 13-Jun-2015.) (Revised by AV, 12-Jun-2019.)
axiom df_zrh {r: setvar}:
  $ wceq czrh (cmpt r cvv (cuni (co czring (cv r) crh))) $;

--| Augment an abelian group with vector space operations to turn it into a ` ZZ ` -module. (Contributed by Mario Carneiro, 2-Oct-2015.) (Revised by AV, 12-Jun-2019.)
axiom df_zlm {g2: setvar}:
  $ wceq czlm (cmpt g2 cvv (co (co (cv g2) (cop (cfv cnx csca) czring) csts) (cop (cfv cnx cvsca) (cfv (cv g2) cmg)) csts)) $;

--| The characteristic of a ring is the smallest positive integer which is equal to 0 when interpreted in the ring, or 0 if there is no such positive integer. (Contributed by Stefan O'Rear, 5-Sep-2015.)
axiom df_chr {g2: setvar}:
  $ wceq cchr (cmpt g2 cvv (cfv (cfv (cv g2) cur) (cfv (cv g2) cod))) $;

--| Define the ring of integers ` mod n ` . This is literally the quotient ring of ` ZZ ` by the ideal ` n ZZ ` , but we augment it with a total order. (Contributed by Mario Carneiro, 14-Jun-2015.) (Revised by AV, 12-Jun-2019.)
axiom df_zn {z f2 n s1: setvar}:
  $ wceq czn (cmpt n cn0 (csb z czring (csb s1 (co (cv z) (co (cv z) (cfv (csn (cv n)) (cfv (cv z) crsp)) cqg) cqus) (co (cv s1) (cop (cfv cnx cple) (csb f2 (cres (cfv (cv s1) czrh) (cif (wceq (cv n) cc0) cz (co cc0 (cv n) cfzo))) (ccom (ccom (cv f2) cle) (ccnv (cv f2))))) csts)))) $;

--| Define the unique homomorphism from the integers to a ring or field. (Contributed by Mario Carneiro, 13-Jun-2015.) (Revised by AV, 12-Jun-2019.)
theorem zrhval (R L: class):
  $ wceq L (cfv R czrh) $ >
  $ wceq L (cuni (co czring R crh)) $;

--| Alternate value of the ` ZRHom ` homomorphism. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem zrhval2 {n: setvar} (R c_x c_1: class) (L: class n):
  $ wceq L (cfv R czrh) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R crg) (wceq L (cmpt n cz (co (cv n) c_1 c_x))) $;

--| Value of the ` ZRHom ` homomorphism. (Contributed by Mario Carneiro, 14-Jun-2015.)
theorem zrhmulg (R c_x c_1 L N: class):
  $ wceq L (cfv R czrh) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wcel N cz)) (wceq (cfv N L) (co N c_1 c_x)) $;

--| The ` ZRHom ` homomorphism is the unique ring homomorphism from ` ZZ ` . (Contributed by Mario Carneiro, 15-Jun-2015.) (Revised by AV, 12-Jun-2019.)
theorem zrhrhmb (R F L: class):
  $ wceq L (cfv R czrh) $ >
  $ wi (wcel R crg) (wb (wcel F (co czring R crh)) (wceq F L)) $;

--| The ` ZRHom ` homomorphism is a homomorphism. (Contributed by Mario Carneiro, 12-Jun-2015.) (Revised by AV, 12-Jun-2019.)
theorem zrhrhm (R L: class):
  $ wceq L (cfv R czrh) $ >
  $ wi (wcel R crg) (wcel L (co czring R crh)) $;

--| Interpretation of 1 in a ring. (Contributed by Stefan O'Rear, 6-Sep-2015.)
theorem zrh1 (R c_1 L: class):
  $ wceq L (cfv R czrh) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R crg) (wceq (cfv c1 L) c_1) $;

--| Interpretation of 0 in a ring. (Contributed by Stefan O'Rear, 6-Sep-2015.)
theorem zrh0 (R L c_0: class):
  $ wceq L (cfv R czrh) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R crg) (wceq (cfv cc0 L) c_0) $;

--| The ` ZZ ` ring homomorphism depends only on the ring attributes of a structure. (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem zrhpropd {x3 y1: setvar} (ph: wff) (B2 K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi ph (wceq (cfv K czrh) (cfv L czrh)) $;

--| Augment an abelian group with vector space operations to turn it into a ` ZZ ` -module. (Contributed by Mario Carneiro, 2-Oct-2015.) (Revised by AV, 12-Jun-2019.)
theorem zlmval (c_x G V W: class):
  $ wceq W (cfv G czlm) $ >
  $ wceq c_x (cfv G cmg) $ >
  $ wi (wcel G V) (wceq W (co (co G (cop (cfv cnx csca) czring) csts) (cop (cfv cnx cvsca) c_x) csts)) $;

--| Lemma for ~ zlmbas and ~ zlmplusg . (Contributed by Mario Carneiro, 2-Oct-2015.) (Revised by AV, 3-Nov-2024.)
theorem zlmlem (E G W: class):
  $ wceq W (cfv G czlm) $ >
  $ wceq E (cslot (cfv cnx E)) $ >
  $ wne (cfv cnx E) (cfv cnx csca) $ >
  $ wne (cfv cnx E) (cfv cnx cvsca) $ >
  $ wceq (cfv G E) (cfv W E) $;

--| Base set of a ` ZZ ` -module. (Contributed by Mario Carneiro, 2-Oct-2015.) (Revised by AV, 3-Nov-2024.)
theorem zlmbas (B2 G W: class):
  $ wceq W (cfv G czlm) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wceq B2 (cfv W cbs) $;

--| Group operation of a ` ZZ ` -module. (Contributed by Mario Carneiro, 2-Oct-2015.) (Revised by AV, 3-Nov-2024.)
theorem zlmplusg (c_pl G W: class):
  $ wceq W (cfv G czlm) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wceq c_pl (cfv W cplusg) $;

--| Ring operation of a ` ZZ ` -module (if present). (Contributed by Mario Carneiro, 2-Oct-2015.) (Revised by AV, 3-Nov-2024.)
theorem zlmmulr (c_x G W: class):
  $ wceq W (cfv G czlm) $ >
  $ wceq c_x (cfv G cmulr) $ >
  $ wceq c_x (cfv W cmulr) $;

--| Scalar ring of a ` ZZ ` -module. (Contributed by Mario Carneiro, 2-Oct-2015.) (Revised by AV, 12-Jun-2019.) (Proof shortened by AV, 2-Nov-2024.)
theorem zlmsca (G V W: class):
  $ wceq W (cfv G czlm) $ >
  $ wi (wcel G V) (wceq czring (cfv W csca)) $;

--| Scalar multiplication operation of a ` ZZ ` -module. (Contributed by Mario Carneiro, 2-Oct-2015.)
theorem zlmvsca (c_x G W: class):
  $ wceq W (cfv G czlm) $ >
  $ wceq c_x (cfv G cmg) $ >
  $ wceq c_x (cfv W cvsca) $;

--| The ` ZZ ` -module operation turns an arbitrary abelian group into a left module over ` ZZ ` . Also see ~ zlmassa . (Contributed by Mario Carneiro, 2-Oct-2015.)
theorem zlmlmod (G W: class):
  $ wceq W (cfv G czlm) $ >
  $ wb (wcel G cabl) (wcel W clmod) $;

--| Definition substitution of the ring characteristic. (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem chrval (C R c_1 O: class):
  $ wceq O (cfv R cod) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq C (cfv R cchr) $ >
  $ wceq (cfv c_1 O) C $;

--| Closure of the characteristic. (Contributed by Mario Carneiro, 23-Sep-2015.)
theorem chrcl (C R: class):
  $ wceq C (cfv R cchr) $ >
  $ wi (wcel R crg) (wcel C cn0) $;

--| The canonical ` ZZ ` ring homomorphism applied to a ring's characteristic is zero. (Contributed by Mario Carneiro, 23-Sep-2015.)
theorem chrid (C R L c_0: class):
  $ wceq C (cfv R cchr) $ >
  $ wceq L (cfv R czrh) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R crg) (wceq (cfv C L) c_0) $;

--| The ` ZZ ` ring homomorphism is zero only at multiples of the characteristic. (Contributed by Mario Carneiro, 23-Sep-2015.)
theorem chrdvds (C R L N c_0: class):
  $ wceq C (cfv R cchr) $ >
  $ wceq L (cfv R czrh) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R crg) (wcel N cz)) (wb (wbr C N cdvds) (wceq (cfv N L) c_0)) $;

--| If two integers are congruent relative to the ring characteristic, their images in the ring are the same. (Contributed by Mario Carneiro, 24-Sep-2015.)
theorem chrcong (C R L M N c_0: class):
  $ wceq C (cfv R cchr) $ >
  $ wceq L (cfv R czrh) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel R crg) (wcel M cz) (wcel N cz)) (wb (wbr C (co M N cmin) cdvds) (wceq (cfv M L) (cfv N L))) $;

--| In a ring, any multiple of the characteristics annihilates all elements. (Contributed by Thierry Arnoux, 6-Sep-2016.)
theorem dvdschrmulg (A2 B2 C R c_x N c_0: class):
  $ wceq C (cfv R cchr) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel R crg) (wbr C N cdvds) (wcel A2 B2)) (wceq (co N A2 c_x) c_0) $;

--| A generalization of Fermat's little theorem in a commutative ring ` F ` of prime characteristic. See ~ fermltl . (Contributed by Thierry Arnoux, 9-Jan-2024.)
theorem fermltlchr (ph: wff) (A2 B2 P E c_ex F: class):
  $ wceq P (cfv F cchr) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq c_ex (cfv (cfv F cmgp) cmg) $ >
  $ wceq A2 (cfv E (cfv F czrh)) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel E cz) $ >
  $ wi ph (wcel F ccrg) $ >
  $ wi ph (wceq (co P A2 c_ex) A2) $;

--| Nonzero rings are precisely those with characteristic not 1. (Contributed by Stefan O'Rear, 6-Sep-2015.)
theorem chrnzr (R: class):
  $ wi (wcel R crg) (wb (wcel R cnzr) (wne (cfv R cchr) c1)) $;

--| The characteristic restriction on ring homomorphisms. (Contributed by Stefan O'Rear, 6-Sep-2015.)
theorem chrrhm (R S F: class):
  $ wi (wcel F (co R S crh)) (wbr (cfv S cchr) (cfv R cchr) cdvds) $;

--| The characteristic of a domain can only be zero or a prime. (Contributed by Stefan O'Rear, 6-Sep-2015.)
theorem domnchr (R: class):
  $ wi (wcel R cdomn) (wo (wceq (cfv R cchr) cc0) (wcel (cfv R cchr) cprime)) $;

--| The set ` n ZZ ` is an ideal in ` ZZ ` . (Contributed by Mario Carneiro, 14-Jun-2015.) (Revised by AV, 13-Jun-2019.)
theorem znlidl (S N: class):
  $ wceq S (cfv czring crsp) $ >
  $ wi (wcel N cz) (wcel (cfv (csn N) S) (cfv czring clidl)) $;

--| Making a commutative ring as a quotient of ` ZZ ` and ` n ZZ ` . (Contributed by Mario Carneiro, 12-Jun-2015.) (Revised by AV, 13-Jun-2019.)
theorem zncrng2 (S U N: class):
  $ wceq S (cfv czring crsp) $ >
  $ wceq U (co czring (co czring (cfv (csn N) S) cqg) cqus) $ >
  $ wi (wcel N cz) (wcel U ccrg) $;

--| The value of the ` Z/nZ ` structure. It is defined as the quotient ring ` ZZ / n ZZ ` , with an "artificial" ordering added to make it a ` Toset ` . (In other words, ` Z/nZ ` is a _ring_ with an _order_ , but it is not an _ordered ring_ , which as a term implies that the order is compatible with the ring operations in some way.) (Contributed by Mario Carneiro, 14-Jun-2015.) (Revised by Mario Carneiro, 2-May-2016.) (Revised by AV, 13-Jun-2019.)
theorem znval (S U F c_le N W Y: class):
  $ wceq S (cfv czring crsp) $ >
  $ wceq U (co czring (co czring (cfv (csn N) S) cqg) cqus) $ >
  $ wceq Y (cfv N czn) $ >
  $ wceq F (cres (cfv U czrh) W) $ >
  $ wceq W (cif (wceq N cc0) cz (co cc0 N cfzo)) $ >
  $ wceq c_le (ccom (ccom F cle) (ccnv F)) $ >
  $ wi (wcel N cn0) (wceq Y (co U (cop (cfv cnx cple) c_le) csts)) $;

--| The value of the ` Z/nZ ` structure. It is defined as the quotient ring ` ZZ / n ZZ ` , with an "artificial" ordering added to make it a ` Toset ` . (In other words, ` Z/nZ ` is a _ring_ with an _order_ , but it is not an _ordered ring_ , which as a term implies that the order is compatible with the ring operations in some way.) (Contributed by Mario Carneiro, 14-Jun-2015.) (Revised by AV, 13-Jun-2019.)
theorem znle (S U F c_le N W Y: class):
  $ wceq S (cfv czring crsp) $ >
  $ wceq U (co czring (co czring (cfv (csn N) S) cqg) cqus) $ >
  $ wceq Y (cfv N czn) $ >
  $ wceq F (cres (cfv U czrh) W) $ >
  $ wceq W (cif (wceq N cc0) cz (co cc0 N cfzo)) $ >
  $ wceq c_le (cfv Y cple) $ >
  $ wi (wcel N cn0) (wceq c_le (ccom (ccom F cle) (ccnv F))) $;

--| Self-referential expression for the ` Z/nZ ` structure. (Contributed by Mario Carneiro, 14-Jun-2015.) (Revised by AV, 13-Jun-2019.)
theorem znval2 (S U c_le N Y: class):
  $ wceq S (cfv czring crsp) $ >
  $ wceq U (co czring (co czring (cfv (csn N) S) cqg) cqus) $ >
  $ wceq Y (cfv N czn) $ >
  $ wceq c_le (cfv Y cple) $ >
  $ wi (wcel N cn0) (wceq Y (co U (cop (cfv cnx cple) c_le) csts)) $;

--| Lemma for ~ znbas . (Contributed by Mario Carneiro, 14-Jun-2015.) (Revised by Mario Carneiro, 14-Aug-2015.) (Revised by AV, 13-Jun-2019.) (Revised by AV, 9-Sep-2021.) (Revised by AV, 3-Nov-2024.)
theorem znbaslem (S U E N Y: class):
  $ wceq S (cfv czring crsp) $ >
  $ wceq U (co czring (co czring (cfv (csn N) S) cqg) cqus) $ >
  $ wceq Y (cfv N czn) $ >
  $ wceq E (cslot (cfv cnx E)) $ >
  $ wne (cfv cnx E) (cfv cnx cple) $ >
  $ wi (wcel N cn0) (wceq (cfv U E) (cfv Y E)) $;

--| The base set of ` Z/nZ ` is the same as the quotient ring it is based on. (Contributed by Mario Carneiro, 15-Jun-2015.) (Revised by AV, 13-Jun-2019.) (Revised by AV, 3-Nov-2024.)
theorem znbas2 (S U N Y: class):
  $ wceq S (cfv czring crsp) $ >
  $ wceq U (co czring (co czring (cfv (csn N) S) cqg) cqus) $ >
  $ wceq Y (cfv N czn) $ >
  $ wi (wcel N cn0) (wceq (cfv U cbs) (cfv Y cbs)) $;

--| The additive structure of ` Z/nZ ` is the same as the quotient ring it is based on. (Contributed by Mario Carneiro, 15-Jun-2015.) (Revised by AV, 13-Jun-2019.) (Revised by AV, 3-Nov-2024.)
theorem znadd (S U N Y: class):
  $ wceq S (cfv czring crsp) $ >
  $ wceq U (co czring (co czring (cfv (csn N) S) cqg) cqus) $ >
  $ wceq Y (cfv N czn) $ >
  $ wi (wcel N cn0) (wceq (cfv U cplusg) (cfv Y cplusg)) $;

--| The multiplicative structure of ` Z/nZ ` is the same as the quotient ring it is based on. (Contributed by Mario Carneiro, 15-Jun-2015.) (Revised by AV, 13-Jun-2019.) (Revised by AV, 3-Nov-2024.)
theorem znmul (S U N Y: class):
  $ wceq S (cfv czring crsp) $ >
  $ wceq U (co czring (co czring (cfv (csn N) S) cqg) cqus) $ >
  $ wceq Y (cfv N czn) $ >
  $ wi (wcel N cn0) (wceq (cfv U cmulr) (cfv Y cmulr)) $;

--| The ` ZZ ` ring homomorphism of ` Z/nZ ` is inherited from the quotient ring it is based on. (Contributed by Mario Carneiro, 14-Jun-2015.) (Revised by AV, 13-Jun-2019.)
theorem znzrh (S U N Y: class):
  $ wceq S (cfv czring crsp) $ >
  $ wceq U (co czring (co czring (cfv (csn N) S) cqg) cqus) $ >
  $ wceq Y (cfv N czn) $ >
  $ wi (wcel N cn0) (wceq (cfv U czrh) (cfv Y czrh)) $;

--| The base set of ` Z/nZ ` structure. (Contributed by Mario Carneiro, 15-Jun-2015.) (Revised by AV, 13-Jun-2019.)
theorem znbas (R S N Y: class):
  $ wceq S (cfv czring crsp) $ >
  $ wceq Y (cfv N czn) $ >
  $ wceq R (co czring (cfv (csn N) S) cqg) $ >
  $ wi (wcel N cn0) (wceq (cqs cz R) (cfv Y cbs)) $;

--| ` Z/nZ ` is a commutative ring. (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem zncrng (N Y: class):
  $ wceq Y (cfv N czn) $ >
  $ wi (wcel N cn0) (wcel Y ccrg) $;

--| The ` ZZ ` ring homomorphism maps elements to their equivalence classes. (Contributed by Mario Carneiro, 15-Jun-2015.) (Revised by AV, 13-Jun-2019.)
theorem znzrh2 {x3: setvar} (c_sm S: class) (L: class x3) (N: class) (Y: class x3):
  $ wceq S (cfv czring crsp) $ >
  $ wceq c_sm (co czring (cfv (csn N) S) cqg) $ >
  $ wceq Y (cfv N czn) $ >
  $ wceq L (cfv Y czrh) $ >
  $ wi (wcel N cn0) (wceq L (cmpt x3 cz (cec (cv x3) c_sm))) $;

--| The ` ZZ ` ring homomorphism maps elements to their equivalence classes. (Contributed by Mario Carneiro, 15-Jun-2015.) (Revised by AV, 13-Jun-2019.)
theorem znzrhval (A2 c_sm S L N Y: class):
  $ wceq S (cfv czring crsp) $ >
  $ wceq c_sm (co czring (cfv (csn N) S) cqg) $ >
  $ wceq Y (cfv N czn) $ >
  $ wceq L (cfv Y czrh) $ >
  $ wi (wa (wcel N cn0) (wcel A2 cz)) (wceq (cfv A2 L) (cec A2 c_sm)) $;

--| The ` ZZ ` ring homomorphism is a surjection onto ` Z/nZ ` . (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem znzrhfo (B2 L N Y: class):
  $ wceq Y (cfv N czn) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq L (cfv Y czrh) $ >
  $ wi (wcel N cn0) (wfo cz B2 L) $;

--| The group ` ZZ / n ZZ ` is cyclic for all ` n ` (including ` n = 0 ` ). (Contributed by Mario Carneiro, 21-Apr-2016.)
theorem zncyg (N Y: class):
  $ wceq Y (cfv N czn) $ >
  $ wi (wcel N cn0) (wcel Y ccyg) $;

--| Express equality of equivalence classes in ` ZZ / n ZZ ` in terms of divisibility. (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem zndvds (A2 B2 L N Y: class):
  $ wceq Y (cfv N czn) $ >
  $ wceq L (cfv Y czrh) $ >
  $ wi (w3a (wcel N cn0) (wcel A2 cz) (wcel B2 cz)) (wb (wceq (cfv A2 L) (cfv B2 L)) (wbr N (co A2 B2 cmin) cdvds)) $;

--| Special case of ~ zndvds when one argument is zero. (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem zndvds0 (A2 L N Y c_0: class):
  $ wceq Y (cfv N czn) $ >
  $ wceq L (cfv Y czrh) $ >
  $ wceq c_0 (cfv Y c0g) $ >
  $ wi (wa (wcel N cn0) (wcel A2 cz)) (wb (wceq (cfv A2 L) c_0) (wbr N A2 cdvds)) $;

--| The function ` F ` enumerates all equivalence classes in ` Z/nZ ` for each ` n ` . When ` n = 0 ` , ` ZZ / 0 ZZ = ZZ / { 0 } ~~ ZZ ` so we let ` W = ZZ ` ; otherwise ` W = { 0 , ... , n - 1 } ` enumerates all the equivalence classes. (Contributed by Mario Carneiro, 15-Jun-2015.) (Revised by Mario Carneiro, 2-May-2016.) (Revised by AV, 13-Jun-2019.)
theorem znf1o (B2 F N W Y: class):
  $ wceq Y (cfv N czn) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq F (cres (cfv Y czrh) W) $ >
  $ wceq W (cif (wceq N cc0) cz (co cc0 N cfzo)) $ >
  $ wi (wcel N cn0) (wf1o W B2 F) $;

--| The ` ZZ ` ring homomorphism is an isomorphism for ` N = 0 ` . (We only show group isomorphism here, but ring isomorphism follows, since it is a bijective ring homomorphism.) (Contributed by Mario Carneiro, 21-Apr-2016.) (Revised by AV, 13-Jun-2019.)
theorem zzngim (L Y: class):
  $ wceq Y (cfv cc0 czn) $ >
  $ wceq L (cfv Y czrh) $ >
  $ wcel L (co czring Y cgim) $;

--| The ordering of the ` Z/nZ ` structure. (Contributed by Mario Carneiro, 15-Jun-2015.) (Revised by AV, 13-Jun-2019.)
theorem znle2 (F c_le N W Y: class):
  $ wceq Y (cfv N czn) $ >
  $ wceq F (cres (cfv Y czrh) W) $ >
  $ wceq W (cif (wceq N cc0) cz (co cc0 N cfzo)) $ >
  $ wceq c_le (cfv Y cple) $ >
  $ wi (wcel N cn0) (wceq c_le (ccom (ccom F cle) (ccnv F))) $;

--| The ordering of the ` Z/nZ ` structure. (Contributed by Mario Carneiro, 15-Jun-2015.) (Revised by AV, 13-Jun-2019.)
theorem znleval (A2 B2 F c_le N W X Y: class):
  $ wceq Y (cfv N czn) $ >
  $ wceq F (cres (cfv Y czrh) W) $ >
  $ wceq W (cif (wceq N cc0) cz (co cc0 N cfzo)) $ >
  $ wceq c_le (cfv Y cple) $ >
  $ wceq X (cfv Y cbs) $ >
  $ wi (wcel N cn0) (wb (wbr A2 B2 c_le) (w3a (wcel A2 X) (wcel B2 X) (wbr (cfv A2 (ccnv F)) (cfv B2 (ccnv F)) cle))) $;

--| The ordering of the ` Z/nZ ` structure. (Contributed by Mario Carneiro, 15-Jun-2015.) (Revised by AV, 13-Jun-2019.)
theorem znleval2 (A2 B2 F c_le N W X Y: class):
  $ wceq Y (cfv N czn) $ >
  $ wceq F (cres (cfv Y czrh) W) $ >
  $ wceq W (cif (wceq N cc0) cz (co cc0 N cfzo)) $ >
  $ wceq c_le (cfv Y cple) $ >
  $ wceq X (cfv Y cbs) $ >
  $ wi (w3a (wcel N cn0) (wcel A2 X) (wcel B2 X)) (wb (wbr A2 B2 c_le) (wbr (cfv A2 (ccnv F)) (cfv B2 (ccnv F)) cle)) $;

--| Lemma for ~ zntos . (Contributed by Mario Carneiro, 15-Jun-2015.) (Revised by AV, 13-Jun-2019.)
theorem zntoslem (F c_le N W X Y: class):
  $ wceq Y (cfv N czn) $ >
  $ wceq F (cres (cfv Y czrh) W) $ >
  $ wceq W (cif (wceq N cc0) cz (co cc0 N cfzo)) $ >
  $ wceq c_le (cfv Y cple) $ >
  $ wceq X (cfv Y cbs) $ >
  $ wi (wcel N cn0) (wcel Y ctos) $;

--| The ` Z/nZ ` structure is a totally ordered set. (The order is not respected by the operations, except in the case ` N = 0 ` when it coincides with the ordering on ` ZZ ` .) (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem zntos (N Y: class):
  $ wceq Y (cfv N czn) $ >
  $ wi (wcel N cn0) (wcel Y ctos) $;

--| The ` Z/nZ ` structure has ` n ` elements. (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem znhash (B2 N Y: class):
  $ wceq Y (cfv N czn) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wi (wcel N cn) (wceq (cfv B2 chash) N) $;

--| The ` Z/nZ ` structure is a finite ring. (Contributed by Mario Carneiro, 2-May-2016.)
theorem znfi (B2 N Y: class):
  $ wceq Y (cfv N czn) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wi (wcel N cn) (wcel B2 cfn) $;

--| The ` Z/nZ ` structure is a finite field when ` n ` is prime. (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem znfld (N Y: class):
  $ wceq Y (cfv N czn) $ >
  $ wi (wcel N cprime) (wcel Y cfield) $;

--| The ` Z/nZ ` structure is a domain (and hence a field) precisely when ` n ` is prime. (Contributed by Mario Carneiro, 15-Jun-2015.)
theorem znidomb (N Y: class):
  $ wceq Y (cfv N czn) $ >
  $ wi (wcel N cn) (wb (wcel Y cidom) (wcel N cprime)) $;

--| Cyclic rings are defined by their characteristic. (Contributed by Stefan O'Rear, 6-Sep-2015.)
theorem znchr (N Y: class):
  $ wceq Y (cfv N czn) $ >
  $ wi (wcel N cn0) (wceq (cfv Y cchr) N) $;

--| The units of ` Z/nZ ` are the integers coprime to the base. (Contributed by Mario Carneiro, 18-Apr-2016.)
theorem znunit (A2 U L N Y: class):
  $ wceq Y (cfv N czn) $ >
  $ wceq U (cfv Y cui) $ >
  $ wceq L (cfv Y czrh) $ >
  $ wi (wa (wcel N cn0) (wcel A2 cz)) (wb (wcel (cfv A2 L) U) (wceq (co A2 N cgcd) c1)) $;

--| The size of the unit group of ` Z/nZ ` . (Contributed by Mario Carneiro, 19-Apr-2016.)
theorem znunithash (U N Y: class):
  $ wceq Y (cfv N czn) $ >
  $ wceq U (cfv Y cui) $ >
  $ wi (wcel N cn) (wceq (cfv U chash) (cfv N cphi)) $;

--| The regular elements of ` Z/nZ ` are exactly the units. (This theorem fails for ` N = 0 ` , where all nonzero integers are regular, but only ` +- 1 ` are units.) (Contributed by Mario Carneiro, 18-Apr-2016.)
theorem znrrg (U E N Y: class):
  $ wceq Y (cfv N czn) $ >
  $ wceq U (cfv Y cui) $ >
  $ wceq E (cfv Y crlreg) $ >
  $ wi (wcel N cn) (wceq E U) $;

--| Lemma for ~ cygzn . (Contributed by Mario Carneiro, 21-Apr-2016.)
theorem cygznlem1 {x3 n: setvar} (ph: wff x3 n) (B2 c_x: class) (E: class x3 n) (G: class) (K: class x3 n) (L: class) (M: class x3 n) (N: class n) (X Y: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq N (cif (wcel B2 cfn) (cfv B2 chash) cc0) $ >
  $ wceq Y (cfv N czn) $ >
  $ wceq c_x (cfv G cmg) $ >
  $ wceq L (cfv Y czrh) $ >
  $ wceq E (crab x3 (wceq (crn (cmpt n cz (co (cv n) (cv x3) c_x))) B2) B2) $ >
  $ wi ph (wcel G ccyg) $ >
  $ wi ph (wcel X E) $ >
  $ wi (wa ph (wa (wcel K cz) (wcel M cz))) (wb (wceq (cfv K L) (cfv M L)) (wceq (co K X c_x) (co M X c_x))) $;

--| Lemma for ~ cygzn . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem cygznlem2a {x3 m n: setvar} (ph: wff x3 n) (B2 c_x: class) (E: class x3 m n) (F: class m) (G L: class) (N: class m n) (X Y: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq N (cif (wcel B2 cfn) (cfv B2 chash) cc0) $ >
  $ wceq Y (cfv N czn) $ >
  $ wceq c_x (cfv G cmg) $ >
  $ wceq L (cfv Y czrh) $ >
  $ wceq E (crab x3 (wceq (crn (cmpt n cz (co (cv n) (cv x3) c_x))) B2) B2) $ >
  $ wi ph (wcel G ccyg) $ >
  $ wi ph (wcel X E) $ >
  $ wceq F (crn (cmpt m cz (cop (cfv (cv m) L) (co (cv m) X c_x)))) $ >
  $ wi ph (wf (cfv Y cbs) B2 F) $;

--| Lemma for ~ cygzn . (Contributed by Mario Carneiro, 21-Apr-2016.) (Revised by Mario Carneiro, 23-Dec-2016.)
theorem cygznlem2 {x3 m n: setvar} (ph: wff x3 n) (B2 c_x: class) (E: class x3 m n) (F: class m) (G L: class) (M: class x3 n) (N: class m n) (X Y: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq N (cif (wcel B2 cfn) (cfv B2 chash) cc0) $ >
  $ wceq Y (cfv N czn) $ >
  $ wceq c_x (cfv G cmg) $ >
  $ wceq L (cfv Y czrh) $ >
  $ wceq E (crab x3 (wceq (crn (cmpt n cz (co (cv n) (cv x3) c_x))) B2) B2) $ >
  $ wi ph (wcel G ccyg) $ >
  $ wi ph (wcel X E) $ >
  $ wceq F (crn (cmpt m cz (cop (cfv (cv m) L) (co (cv m) X c_x)))) $ >
  $ wi (wa ph (wcel M cz)) (wceq (cfv (cfv M L) F) (co M X c_x)) $;

--| A cyclic group with ` n ` elements is isomorphic to ` ZZ / n ZZ ` . (Contributed by Mario Carneiro, 21-Apr-2016.)
theorem cygznlem3 {x3 m n: setvar} (ph: wff x3 n) (B2 c_x: class) (E: class x3 m n) (F: class m) (G L: class) (N: class m n) (X Y: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq N (cif (wcel B2 cfn) (cfv B2 chash) cc0) $ >
  $ wceq Y (cfv N czn) $ >
  $ wceq c_x (cfv G cmg) $ >
  $ wceq L (cfv Y czrh) $ >
  $ wceq E (crab x3 (wceq (crn (cmpt n cz (co (cv n) (cv x3) c_x))) B2) B2) $ >
  $ wi ph (wcel G ccyg) $ >
  $ wi ph (wcel X E) $ >
  $ wceq F (crn (cmpt m cz (cop (cfv (cv m) L) (co (cv m) X c_x)))) $ >
  $ wi ph (wbr G Y cgic) $;

--| A cyclic group with ` n ` elements is isomorphic to ` ZZ / n ZZ ` , and an infinite cyclic group is isomorphic to ` ZZ / 0 ZZ ~~ ZZ ` . (Contributed by Mario Carneiro, 21-Apr-2016.)
theorem cygzn (B2 G N Y: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq N (cif (wcel B2 cfn) (cfv B2 chash) cc0) $ >
  $ wceq Y (cfv N czn) $ >
  $ wi (wcel G ccyg) (wbr G Y cgic) $;

--| The "fundamental theorem of cyclic groups". Cyclic groups are exactly the additive groups ` ZZ / n ZZ ` , for ` 0 <_ n ` (where ` n = 0 ` is the infinite cyclic group ` ZZ ` ), up to isomorphism. (Contributed by Mario Carneiro, 21-Apr-2016.)
theorem cygth {n: setvar} (G: class):
  $ wb (wcel G ccyg) (wrex n (wbr G (cfv (cv n) czn) cgic) cn0) $;

--| Cyclic groups are isomorphic precisely when they have the same order. (Contributed by Mario Carneiro, 21-Apr-2016.)
theorem cyggic (B2 C G H: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq C (cfv H cbs) $ >
  $ wi (wa (wcel G ccyg) (wcel H ccyg)) (wb (wbr G H cgic) (wbr B2 C cen)) $;

--| A free group is cyclic iff it has zero or one generator. (Contributed by Mario Carneiro, 21-Apr-2016.) (Proof shortened by AV, 18-Apr-2021.)
theorem frgpcyg (G I: class):
  $ wceq G (cfv I cfrgp) $ >
  $ wb (wbr I c1o cdom) (wcel G ccyg) $;

--| For a prime number ` P ` , if ` X ` and ` Y ` are members of a commutative ring ` R ` of characteristic ` P ` , then ` ( ( X + Y ) ^ P ) = ( ( X ^ P ) + ( Y ^ P ) ) ` . This theorem is sometimes referred to as "the freshman's dream" . (Contributed by Thierry Arnoux, 18-Sep-2023.)
theorem freshmansdream (ph: wff) (B2 P c_pl R c_ex X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_ex (cfv (cfv R cmgp) cmg) $ >
  $ wceq P (cfv R cchr) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co P (co X Y c_pl) c_ex) (co (co P X c_ex) (co P Y c_ex) c_pl)) $;

--| In a commutative ring with prime characteristic, the Frobenius function ` F ` is a ring endomorphism, thus named the Frobenius endomorphism. (Contributed by Thierry Arnoux, 31-May-2024.)
theorem frobrhm {x3: setvar} (ph: wff) (B2 P R c_ex: class) (F: class x3):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq P (cfv R cchr) $ >
  $ wceq c_ex (cfv (cfv R cmgp) cmg) $ >
  $ wceq F (cmpt x3 B2 (co P (cv x3) c_ex)) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel F (co R R crh)) $;

--| The characteristic of an ordered field is zero. (Contributed by Thierry Arnoux, 21-Jan-2018.) (Proof shortened by AV, 6-Oct-2020.)
theorem ofldchr (F: class):
  $ wi (wcel F cofld) (wceq (cfv F cchr) cc0) $;

--| The signs form a multiplicative subgroup of the complex numbers. (Contributed by Stefan O'Rear, 28-Aug-2015.)
theorem cnmsgnsubg (M: class):
  $ wceq M (co (cfv ccnfld cmgp) (cdif cc (csn cc0)) cress) $ >
  $ wcel (cpr c1 (cneg c1)) (cfv M csubg) $;

--| The base set of the sign subgroup of the complex numbers. (Contributed by Stefan O'Rear, 28-Aug-2015.)
theorem cnmsgnbas (U: class):
  $ wceq U (co (cfv ccnfld cmgp) (cpr c1 (cneg c1)) cress) $ >
  $ wceq (cpr c1 (cneg c1)) (cfv U cbs) $;

--| The group of signs under multiplication. (Contributed by Stefan O'Rear, 28-Aug-2015.)
theorem cnmsgngrp (U: class):
  $ wceq U (co (cfv ccnfld cmgp) (cpr c1 (cneg c1)) cress) $ >
  $ wcel U cgrp $;

--| The sign is a homomorphism from the finitary permutation group to the numeric signs. (Contributed by Stefan O'Rear, 28-Aug-2015.)
theorem psgnghm (D S U F N V: class):
  $ wceq S (cfv D csymg) $ >
  $ wceq N (cfv D cpsgn) $ >
  $ wceq F (co S (cdm N) cress) $ >
  $ wceq U (co (cfv ccnfld cmgp) (cpr c1 (cneg c1)) cress) $ >
  $ wi (wcel D V) (wcel N (co F U cghm)) $;

--| The sign is a homomorphism from the finite symmetric group to the numeric signs. (Contributed by Stefan O'Rear, 28-Aug-2015.)
theorem psgnghm2 (D S U N: class):
  $ wceq S (cfv D csymg) $ >
  $ wceq N (cfv D cpsgn) $ >
  $ wceq U (co (cfv ccnfld cmgp) (cpr c1 (cneg c1)) cress) $ >
  $ wi (wcel D cfn) (wcel N (co S U cghm)) $;

--| The sign of a permutation equals the sign of the inverse of the permutation. (Contributed by SO, 9-Jul-2018.)
theorem psgninv (D P S F N: class):
  $ wceq S (cfv D csymg) $ >
  $ wceq N (cfv D cpsgn) $ >
  $ wceq P (cfv S cbs) $ >
  $ wi (wa (wcel D cfn) (wcel F P)) (wceq (cfv (ccnv F) N) (cfv F N)) $;

--| Multiplicativity of the permutation sign function. (Contributed by SO, 9-Jul-2018.)
theorem psgnco (D P S F G N: class):
  $ wceq S (cfv D csymg) $ >
  $ wceq N (cfv D cpsgn) $ >
  $ wceq P (cfv S cbs) $ >
  $ wi (w3a (wcel D cfn) (wcel F P) (wcel G P)) (wceq (cfv (ccom F G) N) (co (cfv F N) (cfv G N) cmul)) $;

--| Embedding of permutation signs into an arbitrary ring is a homomorphism. (Contributed by SO, 9-Jul-2018.)
theorem zrhpsgnmhm (A2 R: class):
  $ wi (wa (wcel R crg) (wcel A2 cfn)) (wcel (ccom (cfv R czrh) (cfv A2 cpsgn)) (co (cfv A2 csymg) (cfv R cmgp) cmhm)) $;

--| The embedded sign of a permutation equals the embedded sign of the inverse of the permutation. (Contributed by SO, 9-Jul-2018.)
theorem zrhpsgninv (P R S F N Y: class):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wi (w3a (wcel R crg) (wcel N cfn) (wcel F P)) (wceq (cfv (ccnv F) (ccom Y S)) (cfv F (ccom Y S))) $;

--| Even permutations are permutations. (Contributed by SO, 9-Jul-2018.)
theorem evpmss (D P S: class):
  $ wceq S (cfv D csymg) $ >
  $ wceq P (cfv S cbs) $ >
  $ wss (cfv D cevpm) P $;

--| A class is an even permutation if it is a permutation with sign 1. (Contributed by SO, 9-Jul-2018.)
theorem psgnevpmb (D P S F N: class):
  $ wceq S (cfv D csymg) $ >
  $ wceq P (cfv S cbs) $ >
  $ wceq N (cfv D cpsgn) $ >
  $ wi (wcel D cfn) (wb (wcel F (cfv D cevpm)) (wa (wcel F P) (wceq (cfv F N) c1))) $;

--| A permutation which is odd (i.e. not even) has sign -1. (Contributed by SO, 9-Jul-2018.)
theorem psgnodpm (D P S F N: class):
  $ wceq S (cfv D csymg) $ >
  $ wceq P (cfv S cbs) $ >
  $ wceq N (cfv D cpsgn) $ >
  $ wi (wa (wcel D cfn) (wcel F (cdif P (cfv D cevpm)))) (wceq (cfv F N) (cneg c1)) $;

--| A permutation which is even has sign 1. (Contributed by SO, 9-Jul-2018.)
theorem psgnevpm (D P S F N: class):
  $ wceq S (cfv D csymg) $ >
  $ wceq P (cfv S cbs) $ >
  $ wceq N (cfv D cpsgn) $ >
  $ wi (wa (wcel D cfn) (wcel F (cfv D cevpm))) (wceq (cfv F N) c1) $;

--| If a permutation has sign -1 it is odd (not even). (Contributed by SO, 9-Jul-2018.)
theorem psgnodpmr (D P S F N: class):
  $ wceq S (cfv D csymg) $ >
  $ wceq P (cfv S cbs) $ >
  $ wceq N (cfv D cpsgn) $ >
  $ wi (w3a (wcel D cfn) (wcel F P) (wceq (cfv F N) (cneg c1))) (wcel F (cdif P (cfv D cevpm))) $;

--| The sign of an even permutation embedded into a ring is the unity element of the ring. (Contributed by SO, 9-Jul-2018.)
theorem zrhpsgnevpm (R S c_1 F N Y: class):
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (w3a (wcel R crg) (wcel N cfn) (wcel F (cfv N cevpm))) (wceq (cfv F (ccom Y S)) c_1) $;

--| The sign of an odd permutation embedded into a ring is the additive inverse of the unity element of the ring. (Contributed by SO, 9-Jul-2018.)
theorem zrhpsgnodpm (P R S c_1 F I N Y: class):
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq I (cfv R cminusg) $ >
  $ wi (w3a (wcel R crg) (wcel N cfn) (wcel F (cdif P (cfv N cevpm)))) (wceq (cfv F (ccom Y S)) (cfv c_1 I)) $;

--| Composition of any class ` Y ` and the sign function for a finite permutation. (Contributed by AV, 27-Dec-2018.) (Revised by AV, 3-Jul-2022.)
theorem cofipsgn (P Q S N Y: class):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wi (wa (wcel N cfn) (wcel Q P)) (wceq (cfv Q (ccom Y S)) (cfv (cfv Q S) Y)) $;

--| Embedding of permutation signs into a ring results in an element of the ring. (Contributed by AV, 1-Jan-2019.)
theorem zrhpsgnelbas (P Q R S N Y: class):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wi (w3a (wcel R crg) (wcel N cfn) (wcel Q P)) (wcel (cfv (cfv Q S) Y) (cfv R cbs)) $;

--| Embedding of permutation signs into a ring results in an element of the ring. (Contributed by AV, 1-Jan-2019.) (Proof shortened by AV, 3-Jul-2022.)
theorem zrhcopsgnelbas (P Q R S N Y: class):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wi (w3a (wcel R crg) (wcel N cfn) (wcel Q P)) (wcel (cfv Q (ccom Y S)) (cfv R cbs)) $;

--| The function for performing an even permutation after a fixed odd permutation is one to one onto all odd permutations. (Contributed by SO, 9-Jul-2018.)
theorem evpmodpmf1o {f2: setvar} (D P S F: class):
  $ wceq S (cfv D csymg) $ >
  $ wceq P (cfv S cbs) $ >
  $ wi (wa (wcel D cfn) (wcel F (cdif P (cfv D cevpm)))) (wf1o (cfv D cevpm) (cdif P (cfv D cevpm)) (cmpt f2 (cfv D cevpm) (co F (cv f2) (cfv S cplusg)))) $;

--| A transposition is an odd permutation. (Contributed by SO, 9-Jul-2018.)
theorem pmtrodpm (D P S T F: class):
  $ wceq S (cfv D csymg) $ >
  $ wceq P (cfv S cbs) $ >
  $ wceq T (crn (cfv D cpmtr)) $ >
  $ wi (wa (wcel D cfn) (wcel F T)) (wcel F (cdif P (cfv D cevpm))) $;

--| A permutation of a finite set fixing one element is generated by transpositions not involving the fixed element. (Contributed by AV, 13-Jan-2019.)
theorem psgnfix1 {w q: setvar} (P: class w) (Q S T: class q) (K: class) (N: class q):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq T (crn (cfv (cdif N (csn K)) cpmtr)) $ >
  $ wceq S (cfv (cdif N (csn K)) csymg) $ >
  $ wi (wa (wcel N cfn) (wcel K N)) (wi (wcel Q (crab q (wceq (cfv K (cv q)) K) P)) (wrex w (wceq (cres Q (cdif N (csn K))) (co S (cv w) cgsu)) (cword T))) $;

--| A permutation of a finite set fixing one element is generated by transpositions not involving the fixed element. (Contributed by AV, 17-Jan-2019.)
theorem psgnfix2 {w q: setvar} (P: class w) (Q: class) (R S T: class q) (K: class) (N Z: class q):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq T (crn (cfv (cdif N (csn K)) cpmtr)) $ >
  $ wceq S (cfv (cdif N (csn K)) csymg) $ >
  $ wceq Z (cfv N csymg) $ >
  $ wceq R (crn (cfv N cpmtr)) $ >
  $ wi (wa (wcel N cfn) (wcel K N)) (wi (wcel Q (crab q (wceq (cfv K (cv q)) K) P)) (wrex w (wceq Q (co Z (cv w) cgsu)) (cword R))) $;

--| Lemma 1 for ~ psgndif . (Contributed by AV, 27-Jan-2019.)
theorem psgndiflemB {i n q: setvar} (P Q: class i n) (R: class i n q) (S: class q) (T: class i n q) (U: class q) (K: class) (N W Z: class q):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq T (crn (cfv (cdif N (csn K)) cpmtr)) $ >
  $ wceq S (cfv (cdif N (csn K)) csymg) $ >
  $ wceq Z (cfv N csymg) $ >
  $ wceq R (crn (cfv N cpmtr)) $ >
  $ wi (wa (wa (wcel N cfn) (wcel K N)) (wcel Q (crab q (wceq (cfv K (cv q)) K) P))) (wi (wa (wcel W (cword T)) (wceq (cres Q (cdif N (csn K))) (co S W cgsu))) (wi (w3a (wcel U (cword R)) (wceq (cfv W chash) (cfv U chash)) (wral i (wa (wceq (cfv K (cfv (cv i) U)) K) (wral n (wceq (cfv (cv n) (cfv (cv i) W)) (cfv (cv n) (cfv (cv i) U))) (cdif N (csn K)))) (co cc0 (cfv W chash) cfzo))) (wceq Q (co Z U cgsu)))) $;

--| Lemma 2 for ~ psgndif . (Contributed by AV, 31-Jan-2019.)
theorem psgndiflemA {q: setvar} (P Q: class) (R S T U: class q) (K: class) (N W Z: class q):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq T (crn (cfv (cdif N (csn K)) cpmtr)) $ >
  $ wceq S (cfv (cdif N (csn K)) csymg) $ >
  $ wceq Z (cfv N csymg) $ >
  $ wceq R (crn (cfv N cpmtr)) $ >
  $ wi (wa (wa (wcel N cfn) (wcel K N)) (wcel Q (crab q (wceq (cfv K (cv q)) K) P))) (wi (w3a (wcel W (cword T)) (wceq (cres Q (cdif N (csn K))) (co S W cgsu)) (wcel U (cword R))) (wi (wceq Q (co (cfv N csymg) U cgsu)) (wceq (co (cneg c1) (cfv W chash) cexp) (co (cneg c1) (cfv U chash) cexp)))) $;

--| Embedding of permutation signs restricted to a set without a single element into a ring. (Contributed by AV, 31-Jan-2019.)
theorem psgndif {q: setvar} (P Q: class) (S: class q) (K: class) (N Z: class q):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq Z (cfv (cdif N (csn K)) cpsgn) $ >
  $ wi (wa (wcel N cfn) (wcel K N)) (wi (wcel Q (crab q (wceq (cfv K (cv q)) K) P)) (wceq (cfv (cres Q (cdif N (csn K))) Z) (cfv Q S))) $;

--| Embedding of permutation signs restricted to a set without a single element into a ring. (Contributed by AV, 31-Jan-2019.) (Revised by AV, 5-Jul-2022.)
theorem copsgndif {q: setvar} (P Q: class) (S: class q) (K: class) (N Y Z: class q):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq Z (cfv (cdif N (csn K)) cpsgn) $ >
  $ wi (wa (wcel N cfn) (wcel K N)) (wi (wcel Q (crab q (wceq (cfv K (cv q)) K) P)) (wceq (cfv (cres Q (cdif N (csn K))) (ccom Y Z)) (cfv Q (ccom Y S)))) $;

--| Extend class notation with the field of real numbers.
term crefld: class;

--| The field of real numbers. (Contributed by Thierry Arnoux, 30-Jun-2019.)
axiom df_refld:
  $ wceq crefld (co ccnfld cr cress) $;

--| The base of the field of reals. (Contributed by Thierry Arnoux, 1-Nov-2017.)
theorem rebase:
  $ wceq cr (cfv crefld cbs) $;

--| The multiplication (group power) operation of the group of reals. (Contributed by Thierry Arnoux, 1-Nov-2017.)
theorem remulg (A2 N: class):
  $ wi (wa (wcel N cz) (wcel A2 cr)) (wceq (co N A2 (cfv crefld cmg)) (co N A2 cmul)) $;

--| The real numbers form a division subring of the complex numbers. (Contributed by Mario Carneiro, 4-Dec-2014.) (Revised by Thierry Arnoux, 30-Jun-2019.)
theorem resubdrg:
  $ wa (wcel cr (cfv ccnfld csubrg)) (wcel crefld cdr) $;

--| Subtraction in the field of real numbers. (Contributed by Thierry Arnoux, 30-Jun-2019.)
theorem resubgval (c_mi X Y: class):
  $ wceq c_mi (cfv crefld csg) $ >
  $ wi (wa (wcel X cr) (wcel Y cr)) (wceq (co X Y cmin) (co X Y c_mi)) $;

--| The addition operation of the field of reals. (Contributed by Thierry Arnoux, 21-Jan-2018.)
theorem replusg:
  $ wceq caddc (cfv crefld cplusg) $;

--| The multiplication operation of the field of reals. (Contributed by Thierry Arnoux, 1-Nov-2017.)
theorem remulr:
  $ wceq cmul (cfv crefld cmulr) $;

--| The zero element of the field of reals. (Contributed by Thierry Arnoux, 1-Nov-2017.)
theorem re0g:
  $ wceq cc0 (cfv crefld c0g) $;

--| The unity element of the field of reals. (Contributed by Thierry Arnoux, 1-Nov-2017.)
theorem re1r:
  $ wceq c1 (cfv crefld cur) $;

--| The ordering relation of the field of reals. (Contributed by Thierry Arnoux, 21-Jan-2018.)
theorem rele2:
  $ wceq cle (cfv crefld cple) $;

--| The ordering relation of the field of reals. (Contributed by Thierry Arnoux, 21-Jan-2018.)
theorem relt:
  $ wceq clt (cfv crefld cplt) $;

--| The distance of the field of reals. (Contributed by Thierry Arnoux, 20-Jun-2019.)
theorem reds:
  $ wceq (ccom cabs cmin) (cfv crefld cds) $;

--| The division operation of the field of reals. (Contributed by Thierry Arnoux, 1-Nov-2017.)
theorem redvr (A2 B2: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wne B2 cc0)) (wceq (co A2 B2 (cfv crefld cdvr)) (co A2 B2 cdiv)) $;

--| The real numbers are a totally ordered set. (Contributed by Thierry Arnoux, 21-Jan-2018.)
theorem retos:
  $ wcel crefld ctos $;

--| The real numbers form a field. (Contributed by Thierry Arnoux, 1-Nov-2017.)
theorem refld:
  $ wcel crefld cfield $;

--| The conjugation operation of the field of real numbers. (Contributed by Thierry Arnoux, 30-Jun-2019.)
theorem refldcj:
  $ wceq ccj (cfv crefld cstv) $;

--| The real numbers form a star ring. (Contributed by Thierry Arnoux, 19-Apr-2019.) (Proof shortened by Thierry Arnoux, 11-Jan-2025.)
theorem resrng:
  $ wcel crefld csr $;

--| The group sum over the real numbers, expressed as a finite sum. (Contributed by Thierry Arnoux, 22-Jun-2019.) (Proof shortened by AV, 19-Jul-2019.)
theorem regsumsupp {x3: setvar} (F I V: class):
  $ wi (w3a (wf I cr F) (wbr F cc0 cfsupp) (wcel I V)) (wceq (co crefld F cgsu) (csu x3 (co F cc0 csupp) (cfv (cv x3) F))) $;

--| The quotient group ` RR / ZZ ` is a group. (Contributed by Thierry Arnoux, 26-Jan-2020.)
theorem rzgrp (R: class):
  $ wceq R (co crefld (co crefld cz cqg) cqus) $ >
  $ wcel R cgrp $;

--| Extend class notation with class of all pre-Hilbert spaces.
term cphl: class;

--| Extend class notation with inner product function.
term cipf: class;

--| Define the class of all pre-Hilbert spaces (inner product spaces) over arbitrary fields with involution. (Some textbook definitions are more restrictive and require the field of scalars to be the field of real or complex numbers). (Contributed by NM, 22-Sep-2011.)
axiom df_phl {x3 y1 v f2 g2 h: setvar}:
  $ wceq cphl (crab g2 (wsbc v (wsbc h (wsbc f2 (wa (wcel (cv f2) csr) (wral x3 (w3a (wcel (cmpt y1 (cv v) (co (cv y1) (cv x3) (cv h))) (co (cv g2) (cfv (cv f2) crglmod) clmhm)) (wi (wceq (co (cv x3) (cv x3) (cv h)) (cfv (cv f2) c0g)) (wceq (cv x3) (cfv (cv g2) c0g))) (wral y1 (wceq (cfv (co (cv x3) (cv y1) (cv h)) (cfv (cv f2) cstv)) (co (cv y1) (cv x3) (cv h))) (cv v))) (cv v))) (cfv (cv g2) csca)) (cfv (cv g2) cip)) (cfv (cv g2) cbs)) clvec) $;

--| Define the inner product function. Usually we will use ` .i ` directly instead of ` .if ` , and they have the same behavior in most cases. The main advantage of ` .if ` is that it is a guaranteed function ( ~ ipffn ), while ` .i ` only has closure ( ~ ipcl ). (Contributed by Mario Carneiro, 12-Aug-2015.)
axiom df_ipf {x3 y1 g2: setvar}:
  $ wceq cipf (cmpt g2 cvv (cmpo x3 y1 (cfv (cv g2) cbs) (cfv (cv g2) cbs) (co (cv x3) (cv y1) (cfv (cv g2) cip)))) $;

--| The predicate "is a generalized pre-Hilbert (inner product) space". (Contributed by NM, 22-Sep-2011.) (Revised by Mario Carneiro, 7-Oct-2015.)
theorem isphl {x3 y1: setvar} (F c_xi c_as: class x3 y1) (V W: class) (c_0 Z: class x3 y1):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_as (cfv F cstv) $ >
  $ wceq Z (cfv F c0g) $ >
  $ wb (wcel W cphl) (w3a (wcel W clvec) (wcel F csr) (wral x3 (w3a (wcel (cmpt y1 V (co (cv y1) (cv x3) c_xi)) (co W (cfv F crglmod) clmhm)) (wi (wceq (co (cv x3) (cv x3) c_xi) Z) (wceq (cv x3) c_0)) (wral y1 (wceq (cfv (co (cv x3) (cv y1) c_xi) c_as) (co (cv y1) (cv x3) c_xi)) V)) V)) $;

--| A pre-Hilbert space is a left vector space. (Contributed by Mario Carneiro, 7-Oct-2015.)
theorem phllvec (W: class):
  $ wi (wcel W cphl) (wcel W clvec) $;

--| A pre-Hilbert space is a left module. (Contributed by Mario Carneiro, 7-Oct-2015.)
theorem phllmod (W: class):
  $ wi (wcel W cphl) (wcel W clmod) $;

--| The scalar ring of a pre-Hilbert space is a star ring. (Contributed by Mario Carneiro, 7-Oct-2015.)
theorem phlsrng (F W: class):
  $ wceq F (cfv W csca) $ >
  $ wi (wcel W cphl) (wcel F csr) $;

--| The inner product of a pre-Hilbert space is linear in its left argument. (Contributed by Mario Carneiro, 7-Oct-2015.)
theorem phllmhm {x3: setvar} (A2: class) (F G: class x3) (c_xi V W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq G (cmpt x3 V (co (cv x3) A2 c_xi)) $ >
  $ wi (wa (wcel W cphl) (wcel A2 V)) (wcel G (co W (cfv F crglmod) clmhm)) $;

--| Closure of the inner product operation in a pre-Hilbert space. (Contributed by Mario Carneiro, 7-Oct-2015.)
theorem ipcl (A2 B2 F c_xi K V W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq K (cfv F cbs) $ >
  $ wi (w3a (wcel W cphl) (wcel A2 V) (wcel B2 V)) (wcel (co A2 B2 c_xi) K) $;

--| Conjugate of an inner product in a pre-Hilbert space. Equation I1 of [Ponnusamy] p. 362. (Contributed by NM, 1-Feb-2007.) (Revised by Mario Carneiro, 7-Oct-2015.)
theorem ipcj (A2 B2 F c_xi c_as V W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_as (cfv F cstv) $ >
  $ wi (w3a (wcel W cphl) (wcel A2 V) (wcel B2 V)) (wceq (cfv (co A2 B2 c_xi) c_as) (co B2 A2 c_xi)) $;

--| Orthogonality (meaning inner product is 0) is commutative. (Contributed by NM, 17-Apr-2008.) (Revised by Mario Carneiro, 7-Oct-2015.)
theorem iporthcom (A2 B2 F c_xi V W Z: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq Z (cfv F c0g) $ >
  $ wi (w3a (wcel W cphl) (wcel A2 V) (wcel B2 V)) (wb (wceq (co A2 B2 c_xi) Z) (wceq (co B2 A2 c_xi) Z)) $;

--| Inner product with a zero first argument. Part of proof of Theorem 6.44 of [Ponnusamy] p. 361. (Contributed by NM, 5-Feb-2007.) (Revised by Mario Carneiro, 7-Oct-2015.)
theorem ip0l (A2 F c_xi V W c_0 Z: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq Z (cfv F c0g) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wa (wcel W cphl) (wcel A2 V)) (wceq (co c_0 A2 c_xi) Z) $;

--| Inner product with a zero second argument. (Contributed by NM, 5-Feb-2007.) (Revised by Mario Carneiro, 7-Oct-2015.)
theorem ip0r (A2 F c_xi V W c_0 Z: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq Z (cfv F c0g) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wa (wcel W cphl) (wcel A2 V)) (wceq (co A2 c_0 c_xi) Z) $;

--| The inner product of a vector with itself is zero iff the vector is zero. Part of Definition 3.1-1 of [Kreyszig] p. 129. (Contributed by NM, 24-Jan-2008.) (Revised by Mario Carneiro, 7-Oct-2015.)
theorem ipeq0 (A2 F c_xi V W c_0 Z: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq Z (cfv F c0g) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wa (wcel W cphl) (wcel A2 V)) (wb (wceq (co A2 A2 c_xi) Z) (wceq A2 c_0)) $;

--| Distributive law for inner product (right-distributivity). Equation I3 of [Ponnusamy] p. 362. (Contributed by NM, 25-Aug-2007.) (Revised by Mario Carneiro, 7-Oct-2015.)
theorem ipdir (A2 B2 C c_pl c_pd F c_xi V W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_pd (cfv F cplusg) $ >
  $ wi (wa (wcel W cphl) (w3a (wcel A2 V) (wcel B2 V) (wcel C V))) (wceq (co (co A2 B2 c_pl) C c_xi) (co (co A2 C c_xi) (co B2 C c_xi) c_pd)) $;

--| Distributive law for inner product (left-distributivity). (Contributed by NM, 20-Nov-2007.) (Revised by Mario Carneiro, 7-Oct-2015.)
theorem ipdi (A2 B2 C c_pl c_pd F c_xi V W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_pd (cfv F cplusg) $ >
  $ wi (wa (wcel W cphl) (w3a (wcel A2 V) (wcel B2 V) (wcel C V))) (wceq (co A2 (co B2 C c_pl) c_xi) (co (co A2 B2 c_xi) (co A2 C c_xi) c_pd)) $;

--| Distributive law for inner product. (Contributed by NM, 17-Apr-2008.) (Revised by Mario Carneiro, 7-Oct-2015.)
theorem ip2di (ph: wff) (A2 B2 C D c_pl c_pd F c_xi V W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_pd (cfv F cplusg) $ >
  $ wi ph (wcel W cphl) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wceq (co (co A2 B2 c_pl) (co C D c_pl) c_xi) (co (co (co A2 C c_xi) (co B2 D c_xi) c_pd) (co (co A2 D c_xi) (co B2 C c_xi) c_pd) c_pd)) $;

--| Distributive law for inner product subtraction. (Contributed by NM, 20-Nov-2007.) (Revised by Mario Carneiro, 7-Oct-2015.)
theorem ipsubdir (A2 B2 C S F c_xi c_mi V W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wceq S (cfv F csg) $ >
  $ wi (wa (wcel W cphl) (w3a (wcel A2 V) (wcel B2 V) (wcel C V))) (wceq (co (co A2 B2 c_mi) C c_xi) (co (co A2 C c_xi) (co B2 C c_xi) S)) $;

--| Distributive law for inner product subtraction. (Contributed by NM, 20-Nov-2007.) (Revised by Mario Carneiro, 7-Oct-2015.)
theorem ipsubdi (A2 B2 C S F c_xi c_mi V W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wceq S (cfv F csg) $ >
  $ wi (wa (wcel W cphl) (w3a (wcel A2 V) (wcel B2 V) (wcel C V))) (wceq (co A2 (co B2 C c_mi) c_xi) (co (co A2 B2 c_xi) (co A2 C c_xi) S)) $;

--| Distributive law for inner product subtraction. (Contributed by Mario Carneiro, 8-Oct-2015.)
theorem ip2subdi (ph: wff) (A2 B2 C D c_pl S F c_xi c_mi V W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wceq S (cfv F csg) $ >
  $ wceq c_pl (cfv F cplusg) $ >
  $ wi ph (wcel W cphl) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wceq (co (co A2 B2 c_mi) (co C D c_mi) c_xi) (co (co (co A2 C c_xi) (co B2 D c_xi) c_pl) (co (co A2 D c_xi) (co B2 C c_xi) c_pl) S)) $;

--| Associative law for inner product. Equation I2 of [Ponnusamy] p. 363. (Contributed by NM, 25-Aug-2007.) (Revised by Mario Carneiro, 7-Oct-2015.)
theorem ipass (A2 B2 C c_x c_xp F c_xi K V W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_xp (cfv F cmulr) $ >
  $ wi (wa (wcel W cphl) (w3a (wcel A2 K) (wcel B2 V) (wcel C V))) (wceq (co (co A2 B2 c_x) C c_xi) (co A2 (co B2 C c_xi) c_xp)) $;

--| "Associative" law for second argument of inner product (compare ~ ipass ). (Contributed by NM, 25-Aug-2007.) (Revised by Mario Carneiro, 7-Oct-2015.)
theorem ipassr (A2 B2 C c_x c_xp F c_xi c_as K V W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_xp (cfv F cmulr) $ >
  $ wceq c_as (cfv F cstv) $ >
  $ wi (wa (wcel W cphl) (w3a (wcel A2 V) (wcel B2 V) (wcel C K))) (wceq (co A2 (co C B2 c_x) c_xi) (co (co A2 B2 c_xi) (cfv C c_as) c_xp)) $;

--| "Associative" law for inner product. Conjugate version of ~ ipassr . (Contributed by NM, 25-Aug-2007.) (Revised by Mario Carneiro, 7-Oct-2015.)
theorem ipassr2 (A2 B2 C c_x c_xp F c_xi c_as K V W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_xp (cfv F cmulr) $ >
  $ wceq c_as (cfv F cstv) $ >
  $ wi (wa (wcel W cphl) (w3a (wcel A2 V) (wcel B2 V) (wcel C K))) (wceq (co (co A2 B2 c_xi) C c_xp) (co A2 (co (cfv C c_as) B2 c_x) c_xi)) $;

--| The inner product operation as a function. (Contributed by Mario Carneiro, 12-Oct-2015.) (Proof shortened by AV, 2-Mar-2024.)
theorem ipffval {x3 y1: setvar} (c_x: class x3 y1) (c_xi V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq c_x (cfv W cipf) $ >
  $ wceq c_x (cmpo x3 y1 V V (co (cv x3) (cv y1) c_xi)) $;

--| The inner product operation as a function. (Contributed by Mario Carneiro, 14-Aug-2015.)
theorem ipfval (c_x c_xi V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq c_x (cfv W cipf) $ >
  $ wi (wa (wcel X V) (wcel Y V)) (wceq (co X Y c_x) (co X Y c_xi)) $;

--| If the inner product operation is already a function, the functionalization of it is equal to the original operation. (Contributed by Mario Carneiro, 14-Aug-2015.)
theorem ipfeq (c_x c_xi V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq c_x (cfv W cipf) $ >
  $ wi (wfn c_xi (cxp V V)) (wceq c_x c_xi) $;

--| The inner product operation is a function. (Contributed by Mario Carneiro, 20-Sep-2015.)
theorem ipffn (c_xi V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_xi (cfv W cipf) $ >
  $ wfn c_xi (cxp V V) $;

--| The inner product operation is a function. (Contributed by Mario Carneiro, 14-Aug-2015.)
theorem phlipf (S c_xi K V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_xi (cfv W cipf) $ >
  $ wceq S (cfv W csca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wi (wcel W cphl) (wf (cxp V V) K c_xi) $;

--| Two vectors are equal iff their inner products with all other vectors are equal. (Contributed by NM, 24-Jan-2008.) (Revised by Mario Carneiro, 7-Oct-2015.)
theorem ip2eq {x3: setvar} (A2 B2 c_xi V W: class):
  $ wceq c_xi (cfv W cip) $ >
  $ wceq V (cfv W cbs) $ >
  $ wi (w3a (wcel W cphl) (wcel A2 V) (wcel B2 V)) (wb (wceq A2 B2) (wral x3 (wceq (co (cv x3) A2 c_xi) (co (cv x3) B2 c_xi)) V)) $;

--| Properties that determine a pre-Hilbert (inner product) space. (Contributed by Mario Carneiro, 18-Nov-2013.) (Revised by Mario Carneiro, 7-Oct-2015.)
theorem isphld {x3 y1 z q: setvar} (ph: wff) (c_pl c_pd c_x c_xp F I c_as K O V: class x3 y1 z q) (W: class) (c_0: class x3 y1 z q):
  $ wi ph (wceq V (cfv W cbs)) $ >
  $ wi ph (wceq c_pl (cfv W cplusg)) $ >
  $ wi ph (wceq c_x (cfv W cvsca)) $ >
  $ wi ph (wceq I (cfv W cip)) $ >
  $ wi ph (wceq c_0 (cfv W c0g)) $ >
  $ wi ph (wceq F (cfv W csca)) $ >
  $ wi ph (wceq K (cfv F cbs)) $ >
  $ wi ph (wceq c_pd (cfv F cplusg)) $ >
  $ wi ph (wceq c_xp (cfv F cmulr)) $ >
  $ wi ph (wceq c_as (cfv F cstv)) $ >
  $ wi ph (wceq O (cfv F c0g)) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel F csr) $ >
  $ wi (w3a ph (wcel (cv x3) V) (wcel (cv y1) V)) (wcel (co (cv x3) (cv y1) I) K) $ >
  $ wi (w3a ph (wcel (cv q) K) (w3a (wcel (cv x3) V) (wcel (cv y1) V) (wcel (cv z) V))) (wceq (co (co (co (cv q) (cv x3) c_x) (cv y1) c_pl) (cv z) I) (co (co (cv q) (co (cv x3) (cv z) I) c_xp) (co (cv y1) (cv z) I) c_pd)) $ >
  $ wi (w3a ph (wcel (cv x3) V) (wceq (co (cv x3) (cv x3) I) O)) (wceq (cv x3) c_0) $ >
  $ wi (w3a ph (wcel (cv x3) V) (wcel (cv y1) V)) (wceq (cfv (co (cv x3) (cv y1) I) c_as) (co (cv y1) (cv x3) I)) $ >
  $ wi ph (wcel W cphl) $;

--| If two structures have the same components (properties), one is a pre-Hilbert space iff the other one is. (Contributed by Mario Carneiro, 8-Oct-2015.)
theorem phlpropd {x3 y1: setvar} (ph: wff) (B2 P F K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi ph (wceq F (cfv K csca)) $ >
  $ wi ph (wceq F (cfv L csca)) $ >
  $ wceq P (cfv F cbs) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cvsca)) (co (cv x3) (cv y1) (cfv L cvsca))) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cip)) (co (cv x3) (cv y1) (cfv L cip))) $ >
  $ wi ph (wb (wcel K cphl) (wcel L cphl)) $;

--| The inner product on a subspace equals the inner product on the parent space. (Contributed by AV, 19-Oct-2021.)
theorem ssipeq (P S U c_xi W X: class):
  $ wceq X (co W U cress) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq P (cfv X cip) $ >
  $ wi (wcel U S) (wceq P c_xi) $;

--| The inner product on a subspace in terms of the inner product on the parent space. (Contributed by NM, 28-Jan-2008.) (Revised by AV, 19-Oct-2021.)
theorem phssipval (A2 B2 P S U c_xi W X: class):
  $ wceq X (co W U cress) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq P (cfv X cip) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wa (wa (wcel W cphl) (wcel U S)) (wa (wcel A2 U) (wcel B2 U))) (wceq (co A2 B2 P) (co A2 B2 c_xi)) $;

--| The inner product (as a function) on a subspace is a restriction of the inner product (as a function) on the parent space. (Contributed by NM, 28-Jan-2008.) (Revised by AV, 19-Oct-2021.)
theorem phssip (P S c_x U W X: class):
  $ wceq X (co W U cress) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq c_x (cfv W cipf) $ >
  $ wceq P (cfv X cipf) $ >
  $ wi (wa (wcel W cphl) (wcel U S)) (wceq P (cres c_x (cxp U U))) $;

--| A subspace of an inner product space (pre-Hilbert space) is an inner product space. (Contributed by AV, 25-Sep-2022.)
theorem phlssphl (S U W X: class):
  $ wceq X (co W U cress) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wa (wcel W cphl) (wcel U S)) (wcel X cphl) $;

--| Extend class notation with orthocomplement of a subset.
term cocv: class;

--| Extend class notation with set of closed subspaces.
term ccss: class;

--| Extend class notation with the Hilbert lattice.
term cthl: class;

--| Define the orthocomplement function in a given set (which usually is a pre-Hilbert space): it associates with a subset its orthogonal subset (which in the case of a closed linear subspace is its orthocomplement). (Contributed by NM, 7-Oct-2011.)
axiom df_ocv {x3 y1 h s1: setvar}:
  $ wceq cocv (cmpt h cvv (cmpt s1 (cpw (cfv (cv h) cbs)) (crab x3 (wral y1 (wceq (co (cv x3) (cv y1) (cfv (cv h) cip)) (cfv (cfv (cv h) csca) c0g)) (cv s1)) (cfv (cv h) cbs)))) $;

--| Define the set of closed (linear) subspaces of a given pre-Hilbert space. (Contributed by NM, 7-Oct-2011.)
axiom df_css {h s1: setvar}:
  $ wceq ccss (cmpt h cvv (cab s1 (wceq (cv s1) (cfv (cfv (cv s1) (cfv (cv h) cocv)) (cfv (cv h) cocv))))) $;

--| Define the Hilbert lattice of closed subspaces of a given pre-Hilbert space. (Contributed by Mario Carneiro, 25-Oct-2015.)
axiom df_thl {h: setvar}:
  $ wceq cthl (cmpt h cvv (co (cfv (cfv (cv h) ccss) cipo) (cop (cfv cnx coc) (cfv (cv h) cocv)) csts)) $;

--| The orthocomplement operation. (Contributed by NM, 7-Oct-2011.) (Revised by Mario Carneiro, 13-Oct-2015.)
theorem ocvfval {x3 y1 s1: setvar} (F: class x3 y1 s1) (c_xi: class) (c_pe: class x3 y1 s1) (V W: class) (X: class x3 y1 s1) (c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wi (wcel W X) (wceq c_pe (cmpt s1 (cpw V) (crab x3 (wral y1 (wceq (co (cv x3) (cv y1) c_xi) c_0) (cv s1)) V))) $;

--| Value of the orthocomplement of a subset (normally a subspace) of a pre-Hilbert space. (Contributed by NM, 7-Oct-2011.) (Revised by Mario Carneiro, 13-Oct-2015.)
theorem ocvval {x3 y1: setvar} (S: class) (F: class x3 y1) (c_xi: class) (c_pe: class x3 y1) (V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wi (wss S V) (wceq (cfv S c_pe) (crab x3 (wral y1 (wceq (co (cv x3) (cv y1) c_xi) c_0) S) V)) $;

--| Elementhood in the orthocomplement of a subset (normally a subspace) of a pre-Hilbert space. (Contributed by Mario Carneiro, 13-Oct-2015.)
theorem elocv {x3: setvar} (A2 S: class) (F: class x3) (c_xi: class) (c_pe: class x3) (V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wb (wcel A2 (cfv S c_pe)) (w3a (wss S V) (wcel A2 V) (wral x3 (wceq (co A2 (cv x3) c_xi) c_0) S)) $;

--| Property of a member of the orthocomplement of a subset. (Contributed by Mario Carneiro, 13-Oct-2015.)
theorem ocvi (A2 B2 S F c_xi c_pe V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wi (wa (wcel A2 (cfv S c_pe)) (wcel B2 S)) (wceq (co A2 B2 c_xi) c_0) $;

--| The orthocomplement of a subset is a subset of the base. (Contributed by Mario Carneiro, 13-Oct-2015.)
theorem ocvss (S c_pe V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wss (cfv S c_pe) V $;

--| A set is contained in its double orthocomplement. (Contributed by Mario Carneiro, 13-Oct-2015.)
theorem ocvocv (S c_pe V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wi (wa (wcel W cphl) (wss S V)) (wss S (cfv (cfv S c_pe) c_pe)) $;

--| The orthocomplement of a subset is a linear subspace of the pre-Hilbert space. (Contributed by Mario Carneiro, 13-Oct-2015.)
theorem ocvlss (S L c_pe V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq L (cfv W clss) $ >
  $ wi (wa (wcel W cphl) (wss S V)) (wcel (cfv S c_pe) L) $;

--| Orthocomplements reverse subset inclusion. (Contributed by Mario Carneiro, 13-Oct-2015.)
theorem ocv2ss (S T c_pe W: class):
  $ wceq c_pe (cfv W cocv) $ >
  $ wi (wss T S) (wss (cfv S c_pe) (cfv T c_pe)) $;

--| An orthocomplement has trivial intersection with the original subspace. (Contributed by Mario Carneiro, 16-Oct-2015.)
theorem ocvin (S L c_pe W c_0: class):
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq L (cfv W clss) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wa (wcel W cphl) (wcel S L)) (wceq (cin S (cfv S c_pe)) (csn c_0)) $;

--| Two ways to say that ` S ` and ` T ` are orthogonal subspaces. (Contributed by Mario Carneiro, 23-Oct-2015.)
theorem ocvsscon (S T c_pe V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wi (w3a (wcel W cphl) (wss S V) (wss T V)) (wb (wss S (cfv T c_pe)) (wss T (cfv S c_pe))) $;

--| The orthocomplement of a linear span. (Contributed by Mario Carneiro, 23-Oct-2015.)
theorem ocvlsp (S N c_pe V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (wcel W cphl) (wss S V)) (wceq (cfv (cfv S N) c_pe) (cfv S c_pe)) $;

--| The orthocomplement of the empty set. (Contributed by Mario Carneiro, 23-Oct-2015.)
theorem ocv0 (c_pe V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq (cfv c0 c_pe) V $;

--| The orthocomplement of the zero subspace. (Contributed by Mario Carneiro, 23-Oct-2015.)
theorem ocvz (c_pe V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wcel W cphl) (wceq (cfv (csn c_0) c_pe) V) $;

--| The orthocomplement of the base set. (Contributed by Mario Carneiro, 23-Oct-2015.)
theorem ocv1 (c_pe V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wcel W cphl) (wceq (cfv V c_pe) (csn c_0)) $;

--| The orthocomplement of a union. (Contributed by Mario Carneiro, 23-Oct-2015.)
theorem unocv (A2 B2 c_pe W: class):
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq (cfv (cun A2 B2) c_pe) (cin (cfv A2 c_pe) (cfv B2 c_pe)) $;

--| The orthocomplement of an indexed union. (Contributed by Mario Carneiro, 23-Oct-2015.)
theorem iunocv {x3: setvar} (A2 B2 c_pe: class x3) (V W: class):
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq (cfv (ciun x3 A2 B2) c_pe) (cin V (ciin x3 A2 (cfv B2 c_pe))) $;

--| The set of closed subspaces of a pre-Hilbert space. (Contributed by NM, 7-Oct-2011.) (Revised by Mario Carneiro, 13-Oct-2015.)
theorem cssval {s1: setvar} (C: class s1) (c_pe W: class) (X: class s1):
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq C (cfv W ccss) $ >
  $ wi (wcel W X) (wceq C (cab s1 (wceq (cv s1) (cfv (cfv (cv s1) c_pe) c_pe)))) $;

--| The predicate "is a closed subspace" (of a pre-Hilbert space). (Contributed by NM, 7-Oct-2011.) (Revised by Mario Carneiro, 13-Oct-2015.)
theorem iscss (C S c_pe W X: class):
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq C (cfv W ccss) $ >
  $ wi (wcel W X) (wb (wcel S C) (wceq S (cfv (cfv S c_pe) c_pe))) $;

--| Property of a closed subspace (of a pre-Hilbert space). (Contributed by Mario Carneiro, 13-Oct-2015.)
theorem cssi (C S c_pe W: class):
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq C (cfv W ccss) $ >
  $ wi (wcel S C) (wceq S (cfv (cfv S c_pe) c_pe)) $;

--| A closed subspace is a subset of the base. (Contributed by Mario Carneiro, 13-Oct-2015.)
theorem cssss (C S V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq C (cfv W ccss) $ >
  $ wi (wcel S C) (wss S V) $;

--| It is sufficient to prove that the double orthocomplement is a subset of the target set to show that the set is a closed subspace. (Contributed by Mario Carneiro, 13-Oct-2015.)
theorem iscss2 (C S c_pe V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq C (cfv W ccss) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wi (wa (wcel W cphl) (wss S V)) (wb (wcel S C) (wss (cfv (cfv S c_pe) c_pe) S)) $;

--| The orthocomplement of any set is a closed subspace. (Contributed by Mario Carneiro, 13-Oct-2015.)
theorem ocvcss (C S c_pe V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq C (cfv W ccss) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wi (wa (wcel W cphl) (wss S V)) (wcel (cfv S c_pe) C) $;

--| The zero subspace is a closed subspace. (Contributed by Mario Carneiro, 13-Oct-2015.)
theorem cssincl (A2 B2 C W: class):
  $ wceq C (cfv W ccss) $ >
  $ wi (w3a (wcel W cphl) (wcel A2 C) (wcel B2 C)) (wcel (cin A2 B2) C) $;

--| The zero subspace is a closed subspace. (Contributed by Mario Carneiro, 13-Oct-2015.)
theorem css0 (C W c_0: class):
  $ wceq C (cfv W ccss) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wcel W cphl) (wcel (csn c_0) C) $;

--| The whole space is a closed subspace. (Contributed by Mario Carneiro, 13-Oct-2015.)
theorem css1 (C V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq C (cfv W ccss) $ >
  $ wi (wcel W cphl) (wcel V C) $;

--| A closed subspace of a pre-Hilbert space is a linear subspace. (Contributed by Mario Carneiro, 13-Oct-2015.)
theorem csslss (C S L W: class):
  $ wceq C (cfv W ccss) $ >
  $ wceq L (cfv W clss) $ >
  $ wi (wa (wcel W cphl) (wcel S C)) (wcel S L) $;

--| A subset of a pre-Hilbert space whose double orthocomplement has a projection decomposition is a closed subspace. This is the core of the proof that a topologically closed subspace is algebraically closed in a Hilbert space. (Contributed by Mario Carneiro, 13-Oct-2015.)
theorem lsmcss (ph: wff) (C c_po S c_pe V W: class):
  $ wceq C (cfv W ccss) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wi ph (wcel W cphl) $ >
  $ wi ph (wss S V) $ >
  $ wi ph (wss (cfv (cfv S c_pe) c_pe) (co S (cfv S c_pe) c_po)) $ >
  $ wi ph (wcel S C) $;

--| The closed subspaces of a pre-Hilbert space are a Moore system. Unlike many of our other examples of closure systems, this one is _not_ usually an algebraic closure system ~ df-acs : consider the Hilbert space of sequences ` NN --> RR ` with convergent sum; the subspace of all sequences with finite support is the classic example of a non-closed subspace, but for every finite set of sequences of finite support, there is a finite-dimensional (and hence closed) subspace containing all of the sequences, so if closed subspaces were an algebraic closure system this would violate ~ acsfiel . (Contributed by Mario Carneiro, 13-Oct-2015.)
theorem cssmre (C V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq C (cfv W ccss) $ >
  $ wi (wcel W cphl) (wcel C (cfv V cmre)) $;

--| The Moore closure corresponding to the system of closed subspaces is the double orthocomplement operation. (Contributed by Mario Carneiro, 13-Oct-2015.)
theorem mrccss (C S F c_pe V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq C (cfv W ccss) $ >
  $ wceq F (cfv C cmrc) $ >
  $ wi (wa (wcel W cphl) (wss S V)) (wceq (cfv S F) (cfv (cfv S c_pe) c_pe)) $;

--| Value of the Hilbert lattice. (Contributed by Mario Carneiro, 25-Oct-2015.)
theorem thlval (C I K c_pe V W: class):
  $ wceq K (cfv W cthl) $ >
  $ wceq C (cfv W ccss) $ >
  $ wceq I (cfv C cipo) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wi (wcel W V) (wceq K (co I (cop (cfv cnx coc) c_pe) csts)) $;

--| Base set of the Hilbert lattice of closed subspaces. (Contributed by Mario Carneiro, 25-Oct-2015.) (Proof shortened by AV, 11-Nov-2024.)
theorem thlbas (C K W: class):
  $ wceq K (cfv W cthl) $ >
  $ wceq C (cfv W ccss) $ >
  $ wceq C (cfv K cbs) $;

--| Ordering on the Hilbert lattice of closed subspaces. (Contributed by Mario Carneiro, 25-Oct-2015.) (Proof shortened by AV, 11-Nov-2024.)
theorem thlle (C I K c_le W: class):
  $ wceq K (cfv W cthl) $ >
  $ wceq C (cfv W ccss) $ >
  $ wceq I (cfv C cipo) $ >
  $ wceq c_le (cfv I cple) $ >
  $ wceq c_le (cfv K cple) $;

--| Ordering on the Hilbert lattice of closed subspaces. (Contributed by Mario Carneiro, 25-Oct-2015.)
theorem thlleval (C S T K c_le W: class):
  $ wceq K (cfv W cthl) $ >
  $ wceq C (cfv W ccss) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wi (wa (wcel S C) (wcel T C)) (wb (wbr S T c_le) (wss S T)) $;

--| Orthocomplement on the Hilbert lattice of closed subspaces. (Contributed by Mario Carneiro, 25-Oct-2015.)
theorem thloc (K c_pe W: class):
  $ wceq K (cfv W cthl) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq c_pe (cfv K coc) $;

--| Extend class notation with orthogonal projection function.
term cpj: class;

--| Extend class notation with class of all Hilbert spaces.
term chil: class;

--| Extend class notation with the set of orthonormal bases.
term cobs: class;

--| Define orthogonal projection onto a subspace. This is just a wrapping of ~ df-pj1 , but we restrict the domain of this function to only total projection functions. (Contributed by Mario Carneiro, 16-Oct-2015.)
axiom df_pj {x3 h: setvar}:
  $ wceq cpj (cmpt h cvv (cin (cmpt x3 (cfv (cv h) clss) (co (cv x3) (cfv (cv x3) (cfv (cv h) cocv)) (cfv (cv h) cpj1))) (cxp cvv (co (cfv (cv h) cbs) (cfv (cv h) cbs) cmap)))) $;

--| Define class of all Hilbert spaces. Based on Proposition 4.5, p. 176, Gudrun Kalmbach, Quantum Measures and Spaces, Kluwer, Dordrecht, 1998. (Contributed by NM, 7-Oct-2011.) (Revised by Mario Carneiro, 16-Oct-2015.)
axiom df_hil {h: setvar}:
  $ wceq chil (crab h (wceq (cdm (cfv (cv h) cpj)) (cfv (cv h) ccss)) cphl) $;

--| Define the set of all orthonormal bases for a pre-Hilbert space. An orthonormal basis is a set of mutually orthogonal vectors with norm 1 and such that the linear span is dense in the whole space. (As this is an "algebraic" definition, before we have topology available, we express this denseness by saying that the double orthocomplement is the whole space, or equivalently, the single orthocomplement is trivial.) (Contributed by Mario Carneiro, 23-Oct-2015.)
axiom df_obs {x3 y1 h b: setvar}:
  $ wceq cobs (cmpt h cphl (crab b (wa (wral x3 (wral y1 (wceq (co (cv x3) (cv y1) (cfv (cv h) cip)) (cif (wceq (cv x3) (cv y1)) (cfv (cfv (cv h) csca) cur) (cfv (cfv (cv h) csca) c0g))) (cv b)) (cv b)) (wceq (cfv (cv b) (cfv (cv h) cocv)) (csn (cfv (cv h) c0g)))) (cpw (cfv (cv h) cbs)))) $;

--| The value of the projection function. (Contributed by Mario Carneiro, 16-Oct-2015.)
theorem pjfval {x3: setvar} (P: class) (K: class x3) (L c_pe V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq L (cfv W clss) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq P (cfv W cpj1) $ >
  $ wceq K (cfv W cpj) $ >
  $ wceq K (cin (cmpt x3 L (co (cv x3) (cfv (cv x3) c_pe) P)) (cxp cvv (co V V cmap))) $;

--| A subspace is in the domain of the projection function iff the subspace admits a projection decomposition of the whole space. (Contributed by Mario Carneiro, 16-Oct-2015.)
theorem pjdm (P T K L c_pe V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq L (cfv W clss) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq P (cfv W cpj1) $ >
  $ wceq K (cfv W cpj) $ >
  $ wb (wcel T (cdm K)) (wa (wcel T L) (wf V V (co T (cfv T c_pe) P))) $;

--| The projection map is a partial function from subspaces of the pre-Hilbert space to total operators. (Contributed by Mario Carneiro, 16-Oct-2015.)
theorem pjpm (K L V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq L (cfv W clss) $ >
  $ wceq K (cfv W cpj) $ >
  $ wcel K (co (co V V cmap) L cpm) $;

--| Value of the projection map with implicit domain. (Contributed by Mario Carneiro, 16-Oct-2015.)
theorem pjfval2 {x3: setvar} (P K c_pe W: class):
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq P (cfv W cpj1) $ >
  $ wceq K (cfv W cpj) $ >
  $ wceq K (cmpt x3 (cdm K) (co (cv x3) (cfv (cv x3) c_pe) P)) $;

--| Value of the projection map. (Contributed by Mario Carneiro, 16-Oct-2015.)
theorem pjval (P T K c_pe W: class):
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq P (cfv W cpj1) $ >
  $ wceq K (cfv W cpj) $ >
  $ wi (wcel T (cdm K)) (wceq (cfv T K) (co T (cfv T c_pe) P)) $;

--| A subspace is in the domain of the projection function iff the subspace admits a projection decomposition of the whole space. (Contributed by Mario Carneiro, 16-Oct-2015.)
theorem pjdm2 (c_po T K L c_pe V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq L (cfv W clss) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq K (cfv W cpj) $ >
  $ wi (wcel W cphl) (wb (wcel T (cdm K)) (wa (wcel T L) (wceq (co T (cfv T c_pe) c_po) V))) $;

--| A projection is a linear operator. (Contributed by Mario Carneiro, 16-Oct-2015.)
theorem pjff (K W: class):
  $ wceq K (cfv W cpj) $ >
  $ wi (wcel W cphl) (wf (cdm K) (co W W clmhm) K) $;

--| A projection is a function on the base set. (Contributed by Mario Carneiro, 16-Oct-2015.)
theorem pjf (T K V W: class):
  $ wceq K (cfv W cpj) $ >
  $ wceq V (cfv W cbs) $ >
  $ wi (wcel T (cdm K)) (wf V V (cfv T K)) $;

--| A projection is a function from the base set to the subspace. (Contributed by Mario Carneiro, 16-Oct-2015.)
theorem pjf2 (T K V W: class):
  $ wceq K (cfv W cpj) $ >
  $ wceq V (cfv W cbs) $ >
  $ wi (wa (wcel W cphl) (wcel T (cdm K))) (wf V T (cfv T K)) $;

--| A projection is a surjection onto the subspace. (Contributed by Mario Carneiro, 16-Oct-2015.)
theorem pjfo (T K V W: class):
  $ wceq K (cfv W cpj) $ >
  $ wceq V (cfv W cbs) $ >
  $ wi (wa (wcel W cphl) (wcel T (cdm K))) (wfo V T (cfv T K)) $;

--| A projection subspace is an (algebraically) closed subspace. (Contributed by Mario Carneiro, 16-Oct-2015.)
theorem pjcss (C K W: class):
  $ wceq K (cfv W cpj) $ >
  $ wceq C (cfv W ccss) $ >
  $ wi (wcel W cphl) (wss (cdm K) C) $;

--| The orthocomplement of a projection subspace is a projection subspace. (Contributed by Mario Carneiro, 16-Oct-2015.)
theorem ocvpj (T K c_pe W: class):
  $ wceq K (cfv W cpj) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wi (wa (wcel W cphl) (wcel T (cdm K))) (wcel (cfv T c_pe) (cdm K)) $;

--| The predicate "is a Hilbert space" (over a *-division ring). A Hilbert space is a pre-Hilbert space such that all closed subspaces have a projection decomposition. (Contributed by NM, 7-Oct-2011.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem ishil (C H K: class):
  $ wceq K (cfv H cpj) $ >
  $ wceq C (cfv H ccss) $ >
  $ wb (wcel H chil) (wa (wcel H cphl) (wceq (cdm K) C)) $;

--| The predicate "is a Hilbert space" (over a *-division ring). (Contributed by NM, 7-Oct-2011.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem ishil2 {s1: setvar} (C: class) (c_po: class s1) (H: class) (c_pe V: class s1):
  $ wceq V (cfv H cbs) $ >
  $ wceq c_po (cfv H clsm) $ >
  $ wceq c_pe (cfv H cocv) $ >
  $ wceq C (cfv H ccss) $ >
  $ wb (wcel H chil) (wa (wcel H cphl) (wral s1 (wceq (co (cv s1) (cfv (cv s1) c_pe) c_po) V) C)) $;

--| The predicate "is an orthonormal basis" (over a pre-Hilbert space). (Contributed by Mario Carneiro, 23-Oct-2015.)
theorem isobs {x3 y1: setvar} (B2 c_1: class) (F: class x3 y1) (c_xi: class) (c_pe V: class x3 y1) (W: class) (Y: class x3 y1) (c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq Y (cfv W c0g) $ >
  $ wb (wcel B2 (cfv W cobs)) (w3a (wcel W cphl) (wss B2 V) (wa (wral x3 (wral y1 (wceq (co (cv x3) (cv y1) c_xi) (cif (wceq (cv x3) (cv y1)) c_1 c_0)) B2) B2) (wceq (cfv B2 c_pe) (csn Y)))) $;

--| The inner product of two elements of an orthonormal basis. (Contributed by Mario Carneiro, 23-Oct-2015.)
theorem obsip (B2 P Q c_1 F c_xi V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_xi (cfv W cip) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wi (w3a (wcel B2 (cfv W cobs)) (wcel P B2) (wcel Q B2)) (wceq (co P Q c_xi) (cif (wceq P Q) c_1 c_0)) $;

--| A basis element has length one. (Contributed by Mario Carneiro, 23-Oct-2015.)
theorem obsipid (A2 B2 c_1 F c_xi W: class):
  $ wceq c_xi (cfv W cip) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ wi (wa (wcel B2 (cfv W cobs)) (wcel A2 B2)) (wceq (co A2 A2 c_xi) c_1) $;

--| Reverse closure for an orthonormal basis. (Contributed by Mario Carneiro, 23-Oct-2015.)
theorem obsrcl (B2 W: class):
  $ wi (wcel B2 (cfv W cobs)) (wcel W cphl) $;

--| An orthonormal basis is a subset of the base set. (Contributed by Mario Carneiro, 23-Oct-2015.)
theorem obsss (B2 V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wi (wcel B2 (cfv W cobs)) (wss B2 V) $;

--| A basis element is nonzero. (Contributed by Mario Carneiro, 23-Oct-2015.)
theorem obsne0 (A2 B2 W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wa (wcel B2 (cfv W cobs)) (wcel A2 B2)) (wne A2 c_0) $;

--| An orthonormal basis has trivial orthocomplement. (Contributed by Mario Carneiro, 23-Oct-2015.)
theorem obsocv (B2 c_pe W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_pe (cfv W cocv) $ >
  $ wi (wcel B2 (cfv W cobs)) (wceq (cfv B2 c_pe) (csn c_0)) $;

--| The double orthocomplement (closure) of an orthonormal basis is the whole space. (Contributed by Mario Carneiro, 23-Oct-2015.)
theorem obs2ocv (B2 c_pe V W: class):
  $ wceq c_pe (cfv W cocv) $ >
  $ wceq V (cfv W cbs) $ >
  $ wi (wcel B2 (cfv W cobs)) (wceq (cfv (cfv B2 c_pe) c_pe) V) $;

--| A basis element is in the orthocomplement of a subset of the basis iff it is not in the subset. (Contributed by Mario Carneiro, 23-Oct-2015.)
theorem obselocv (A2 B2 C c_pe W: class):
  $ wceq c_pe (cfv W cocv) $ >
  $ wi (w3a (wcel B2 (cfv W cobs)) (wss C B2) (wcel A2 B2)) (wb (wcel A2 (cfv C c_pe)) (wn (wcel A2 C))) $;

--| A basis has no proper subsets that are also bases. (Contributed by Mario Carneiro, 23-Oct-2015.)
theorem obs2ss (B2 C W: class):
  $ wi (w3a (wcel B2 (cfv W cobs)) (wcel C (cfv W cobs)) (wss C B2)) (wceq C B2) $;

--| An orthogonal basis is a linear basis iff the span of the basis elements is closed (which is usually not true). (Contributed by Mario Carneiro, 29-Oct-2015.)
theorem obslbs (B2 C J N W: class):
  $ wceq J (cfv W clbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq C (cfv W ccss) $ >
  $ wi (wcel B2 (cfv W cobs)) (wb (wcel B2 J) (wcel (cfv B2 N) C)) $;

--| Class of module direct sum generator.
term cdsmm: class;

--| The direct sum of a family of Abelian groups or left modules is the induced group structure on finite linear combinations of elements, here represented as functions with finite support. (Contributed by Stefan O'Rear, 7-Jan-2015.)
axiom df_dsmm {x3 f2 s1 r: setvar}:
  $ wceq cdsmm (cmpo s1 r cvv cvv (co (co (cv s1) (cv r) cprds) (crab f2 (wcel (crab x3 (wne (cfv (cv x3) (cv f2)) (cfv (cfv (cv x3) (cv r)) c0g)) (cdm (cv r))) cfn) (cixp x3 (cdm (cv r)) (cfv (cfv (cv x3) (cv r)) cbs))) cress)) $;

--| The direct sum is a well-behaved binary operator. (Contributed by Stefan O'Rear, 7-Jan-2015.)
theorem reldmdsmm:
  $ wrel (cdm cdsmm) $;

--| Value of the module direct sum. (Contributed by Stefan O'Rear, 7-Jan-2015.)
theorem dsmmval {x3 f2: setvar} (B2: class x3 f2) (R S: class) (V: class x3 f2):
  $ wceq B2 (crab f2 (wcel (crab x3 (wne (cfv (cv x3) (cv f2)) (cfv (cfv (cv x3) R) c0g)) (cdm R)) cfn) (cfv (co S R cprds) cbs)) $ >
  $ wi (wcel R V) (wceq (co S R cdsmm) (co (co S R cprds) B2 cress)) $;

--| Base set of the module direct sum. (Contributed by Stefan O'Rear, 7-Jan-2015.)
theorem dsmmbase {x3 f2: setvar} (B2: class x3 f2) (R S: class) (V: class x3 f2):
  $ wceq B2 (crab f2 (wcel (crab x3 (wne (cfv (cv x3) (cv f2)) (cfv (cfv (cv x3) R) c0g)) (cdm R)) cfn) (cfv (co S R cprds) cbs)) $ >
  $ wi (wcel R V) (wceq B2 (cfv (co S R cdsmm) cbs)) $;

--| Self-referential definition of the module direct sum. (Contributed by Stefan O'Rear, 7-Jan-2015.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem dsmmval2 (B2 R S: class):
  $ wceq B2 (cfv (co S R cdsmm) cbs) $ >
  $ wceq (co S R cdsmm) (co (co S R cprds) B2 cress) $;

--| Base set of the direct sum module using the ~ fndmin abbreviation. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem dsmmbas2 {f2: setvar} (B2: class f2) (P R S I V: class):
  $ wceq P (co S R cprds) $ >
  $ wceq B2 (crab f2 (wcel (cdm (cdif (cv f2) (ccom c0g R))) cfn) (cfv P cbs)) $ >
  $ wi (wa (wfn R I) (wcel I V)) (wceq B2 (cfv (co S R cdsmm) cbs)) $;

--| For finite products, the direct sum is just the module product. See also the observation in [Lang] p. 129. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem dsmmfi (R S I: class):
  $ wi (wa (wfn R I) (wcel I cfn)) (wceq (co S R cdsmm) (co S R cprds)) $;

--| Membership in the finitely supported hull of a structure product in terms of the index set. (Contributed by Stefan O'Rear, 11-Jan-2015.)
theorem dsmmelbas {a: setvar} (ph: wff a) (B2 C P: class a) (R S: class) (H: class a) (I: class) (V: class a) (X: class):
  $ wceq P (co S R cprds) $ >
  $ wceq C (co S R cdsmm) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq H (cfv C cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wfn R I) $ >
  $ wi ph (wb (wcel X H) (wa (wcel X B2) (wcel (crab a (wne (cfv (cv a) X) (cfv (cfv (cv a) R) c0g)) I) cfn))) $;

--| The all-zero vector is contained in the finite hull, since its support is empty and therefore finite. This theorem along with the next one effectively proves that the finite hull is a "submonoid", although that does not exist as a defined concept yet. (Contributed by Stefan O'Rear, 11-Jan-2015.)
theorem dsmm0cl (ph: wff) (P R S H I V W c_0: class):
  $ wceq P (co S R cprds) $ >
  $ wceq H (cfv (co S R cdsmm) cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel S V) $ >
  $ wi ph (wf I cmnd R) $ >
  $ wceq c_0 (cfv P c0g) $ >
  $ wi ph (wcel c_0 H) $;

--| The finite hull is closed under addition. (Contributed by Stefan O'Rear, 11-Jan-2015.)
theorem dsmmacl (ph: wff) (P c_pl R S H I J K V W: class):
  $ wceq P (co S R cprds) $ >
  $ wceq H (cfv (co S R cdsmm) cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel S V) $ >
  $ wi ph (wf I cmnd R) $ >
  $ wi ph (wcel J H) $ >
  $ wi ph (wcel K H) $ >
  $ wceq c_pl (cfv P cplusg) $ >
  $ wi ph (wcel (co J K c_pl) H) $;

--| Negation of a single coordinate in a structure product. (Contributed by Stefan O'Rear, 11-Jan-2015.)
theorem prdsinvgd2 (ph: wff) (B2 R S I J N V W X Y: class):
  $ wceq Y (co S R cprds) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel S V) $ >
  $ wi ph (wf I cgrp R) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq N (cfv Y cminusg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel J I) $ >
  $ wi ph (wceq (cfv J (cfv X N)) (cfv (cfv J X) (cfv (cfv J R) cminusg))) $;

--| The finite hull of a product of groups is additionally closed under negation and thus is a subgroup of the product. (Contributed by Stefan O'Rear, 11-Jan-2015.)
theorem dsmmsubg (ph: wff) (P R S H I V W: class):
  $ wceq P (co S R cprds) $ >
  $ wceq H (cfv (co S R cdsmm) cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel S V) $ >
  $ wi ph (wf I cgrp R) $ >
  $ wi ph (wcel H (cfv P csubg)) $;

--| The finite hull of a product of modules is additionally closed under scalar multiplication and thus is a linear subspace of the product. (Contributed by Stefan O'Rear, 11-Jan-2015.)
theorem dsmmlss {x3: setvar} (ph: wff) (P R S: class) (U: class x3) (H I: class) (W: class x3):
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel S crg) $ >
  $ wi ph (wf I clmod R) $ >
  $ wi (wa ph (wcel (cv x3) I)) (wceq (cfv (cfv (cv x3) R) csca) S) $ >
  $ wceq P (co S R cprds) $ >
  $ wceq U (cfv P clss) $ >
  $ wceq H (cfv (co S R cdsmm) cbs) $ >
  $ wi ph (wcel H U) $;

--| The direct sum of a family of modules is a module. See also the remark in [Lang] p. 128. (Contributed by Stefan O'Rear, 11-Jan-2015.)
theorem dsmmlmod {x3: setvar} (ph: wff) (C: class x3) (R S I: class) (W: class x3):
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel S crg) $ >
  $ wi ph (wf I clmod R) $ >
  $ wi (wa ph (wcel (cv x3) I)) (wceq (cfv (cfv (cv x3) R) csca) S) $ >
  $ wceq C (co S R cdsmm) $ >
  $ wi ph (wcel C clmod) $;

--| Class of free module generator.
term cfrlm: class;

--| Define the function associating with a ring and a set the direct sum indexed by that set of copies of that ring regarded as a left module over itself. Recall from ~ df-dsmm that an element of a direct sum has finitely many nonzero coordinates. (Contributed by Stefan O'Rear, 1-Feb-2015.)
axiom df_frlm {i r: setvar}:
  $ wceq cfrlm (cmpo r i cvv cvv (co (cv r) (cxp (cv i) (csn (cfv (cv r) crglmod))) cdsmm)) $;

--| Value of the "free module" function. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem frlmval (R F I V W: class):
  $ wceq F (co R I cfrlm) $ >
  $ wi (wa (wcel R V) (wcel I W)) (wceq F (co R (cxp I (csn (cfv R crglmod))) cdsmm)) $;

--| The free module is a module. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem frlmlmod (R F I W: class):
  $ wceq F (co R I cfrlm) $ >
  $ wi (wa (wcel R crg) (wcel I W)) (wcel F clmod) $;

--| The free module as a restriction of the power module. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem frlmpws (B2 R F I V W: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi (wa (wcel R V) (wcel I W)) (wceq F (co (co (cfv R crglmod) I cpws) B2 cress)) $;

--| The base set of the free module is a subspace of the power module. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem frlmlss (B2 R U F I W: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq U (cfv (co (cfv R crglmod) I cpws) clss) $ >
  $ wi (wa (wcel R crg) (wcel I W)) (wcel B2 U) $;

--| The finite free module is a power of the ring module. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem frlmpwsfi (R F I V: class):
  $ wceq F (co R I cfrlm) $ >
  $ wi (wa (wcel R V) (wcel I cfn)) (wceq F (co (cfv R crglmod) I cpws)) $;

--| The ring of scalars of a free module. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem frlmsca (R F I V W: class):
  $ wceq F (co R I cfrlm) $ >
  $ wi (wa (wcel R V) (wcel I W)) (wceq R (cfv F csca)) $;

--| Zero in a free module (ring constraint is stronger than necessary, but allows use of ~ frlmlss ). (Contributed by Stefan O'Rear, 4-Feb-2015.)
theorem frlm0 (R F I W c_0: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R crg) (wcel I W)) (wceq (cxp I (csn c_0)) (cfv F c0g)) $;

--| Base set of the free module. (Contributed by Stefan O'Rear, 1-Feb-2015.) (Revised by AV, 23-Jun-2019.)
theorem frlmbas {k: setvar} (B2: class k) (R: class) (F: class k) (I N V W c_0: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq N (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq B2 (crab k (wbr (cv k) c_0 cfsupp) (co N I cmap)) $ >
  $ wi (wa (wcel R V) (wcel I W)) (wceq B2 (cfv F cbs)) $;

--| Membership in the base set of the free module. (Contributed by Stefan O'Rear, 1-Feb-2015.) (Revised by AV, 23-Jun-2019.)
theorem frlmelbas (B2 R F I N V W X c_0: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq N (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi (wa (wcel R V) (wcel I W)) (wb (wcel X B2) (wa (wcel X (co N I cmap)) (wbr X c_0 cfsupp))) $;

--| If a free module is inhabited, this is sufficient to conclude that the ring expression defines a set. (Contributed by Stefan O'Rear, 3-Feb-2015.)
theorem frlmrcl (B2 R F I X: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi (wcel X B2) (wcel R cvv) $;

--| Elements of the free module are finitely supported. (Contributed by Stefan O'Rear, 3-Feb-2015.) (Revised by Thierry Arnoux, 21-Jun-2019.) (Proof shortened by AV, 20-Jul-2019.)
theorem frlmbasfsupp (B2 R F I W X c_0: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi (wa (wcel I W) (wcel X B2)) (wbr X c_0 cfsupp) $;

--| Elements of the free module are set functions. (Contributed by Stefan O'Rear, 3-Feb-2015.) (Proof shortened by AV, 21-Jul-2019.)
theorem frlmbasmap (B2 R F I N W X: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq N (cfv R cbs) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi (wa (wcel I W) (wcel X B2)) (wcel X (co N I cmap)) $;

--| Elements of the free module are functions. (They map an index to the coordinate at that index). (Contributed by Stefan O'Rear, 3-Feb-2015.)
theorem frlmbasf (B2 R F I N W X: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq N (cfv R cbs) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi (wa (wcel I W) (wcel X B2)) (wf I N X) $;

--| The free module over a division ring is a left vector space. (Contributed by Steven Nguyen, 29-Apr-2023.)
theorem frlmlvec (R F I W: class):
  $ wceq F (co R I cfrlm) $ >
  $ wi (wa (wcel R cdr) (wcel I W)) (wcel F clvec) $;

--| The base set of the finite free module as a set exponential. (Contributed by AV, 6-Dec-2018.)
theorem frlmfibas (R F I N V: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq N (cfv R cbs) $ >
  $ wi (wa (wcel R V) (wcel I cfn)) (wceq (co N I cmap) (cfv F cbs)) $;

--| If the dimension of a free module over a ring is not 0, every element of its base set is not empty. (Contributed by AV, 10-Feb-2019.)
theorem elfrlmbasn0 (B2 R F I N V X: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq N (cfv R cbs) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi (wa (wcel I V) (wne I c0)) (wi (wcel X B2) (wne X c0)) $;

--| Addition in a free module. (Contributed by Stefan O'Rear, 1-Feb-2015.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem frlmplusgval (ph: wff) (B2 c_pl c_pb R F G I V W Y: class):
  $ wceq Y (co R I cfrlm) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_pb (cfv Y cplusg) $ >
  $ wi ph (wceq (co F G c_pb) (co F G (cof c_pl))) $;

--| Subtraction in a free module. (Contributed by Thierry Arnoux, 30-Jun-2019.)
theorem frlmsubgval (ph: wff) (B2 R F G I M c_mi W Y: class):
  $ wceq Y (co R I cfrlm) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wceq M (cfv Y csg) $ >
  $ wi ph (wceq (co F G M) (co F G (cof c_mi))) $;

--| Scalar multiplication in a free module. (Contributed by Stefan O'Rear, 1-Feb-2015.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem frlmvscafval (ph: wff) (A2 B2 R c_xb c_x I K W X Y: class):
  $ wceq Y (co R I cfrlm) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wcel X B2) $ >
  $ wceq c_xb (cfv Y cvsca) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wceq (co A2 X c_xb) (co (cxp I (csn A2)) X (cof c_x))) $;

--| Coordinates of a sum with respect to a basis in a free module. (Contributed by AV, 16-Jan-2023.)
theorem frlmvplusgvalc (ph: wff) (B2 c_pl c_pb R F I J V W X Y: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel J I) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_pb (cfv F cplusg) $ >
  $ wi ph (wceq (cfv J (co X Y c_pb)) (co (cfv J X) (cfv J Y) c_pl)) $;

--| Coordinates of a scalar multiple with respect to a basis in a free module. (Contributed by Stefan O'Rear, 3-Feb-2015.)
theorem frlmvscaval (ph: wff) (A2 B2 R c_xb c_x I J K W X Y: class):
  $ wceq Y (co R I cfrlm) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel J I) $ >
  $ wceq c_xb (cfv Y cvsca) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wceq (cfv J (co A2 X c_xb)) (co A2 (cfv J X) c_x)) $;

--| Addition in a free module at the coordinates. (Contributed by AV, 16-Jan-2023.)
theorem frlmplusgvalb {i: setvar} (ph: wff) (B2 c_pl: class i) (c_pb: class) (R F: class i) (I: class) (W: class i) (X Y Z: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_pb (cfv F cplusg) $ >
  $ wi ph (wb (wceq Z (co X Y c_pb)) (wral i (wceq (cfv (cv i) Z) (co (cfv (cv i) X) (cfv (cv i) Y) c_pl)) I)) $;

--| Scalar multiplication in a free module at the coordinates. (Contributed by AV, 16-Jan-2023.)
theorem frlmvscavalb {i: setvar} (ph: wff) (A2: class) (B2 R: class i) (c_xb: class) (c_x F: class i) (I: class) (K W: class i) (X Z: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi ph (wcel A2 K) $ >
  $ wceq c_xb (cfv F cvsca) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wb (wceq Z (co A2 X c_xb)) (wral i (wceq (cfv (cv i) Z) (co A2 (cfv (cv i) X) c_x)) I)) $;

--| Addition combined with scalar multiplication in a free module at the coordinates. (Contributed by AV, 16-Jan-2023.)
theorem frlmvplusgscavalb {i: setvar} (ph: wff) (A2: class) (B2: class i) (C: class) (c_pl: class i) (c_pb: class) (R: class i) (c_xb: class) (c_x F: class i) (I: class) (K W: class i) (X Y Z: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi ph (wcel A2 K) $ >
  $ wceq c_xb (cfv F cvsca) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_pb (cfv F cplusg) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wb (wceq Z (co (co A2 X c_xb) (co C Y c_xb) c_pb)) (wral i (wceq (cfv (cv i) Z) (co (co A2 (cfv (cv i) X) c_x) (co C (cfv (cv i) Y) c_x) c_pl)) I)) $;

--| Finite commutative sums in a free module are taken componentwise. (Contributed by Stefan O'Rear, 1-Feb-2015.) (Revised by Mario Carneiro, 5-Jul-2015.) (Revised by AV, 23-Jun-2019.)
theorem frlmgsum {x3 y1: setvar} (ph: wff) (B2 R: class) (U: class x3 y1) (I J: class) (V W: class x3 y1) (Y c_0: class):
  $ wceq Y (co R I cfrlm) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq c_0 (cfv Y c0g) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel J W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi (wa ph (wcel (cv y1) J)) (wcel (cmpt x3 I U) B2) $ >
  $ wi ph (wbr (cmpt y1 J (cmpt x3 I U)) c_0 cfsupp) $ >
  $ wi ph (wceq (co Y (cmpt y1 J (cmpt x3 I U)) cgsu) (cmpt x3 I (co R (cmpt y1 J U) cgsu))) $;

--| Restriction is homomorphic on free modules. (Contributed by Stefan O'Rear, 3-Feb-2015.) (Proof shortened by AV, 21-Jul-2019.)
theorem frlmsplit2 {x3: setvar} (B2 C R U: class) (F: class x3) (V X Y Z: class):
  $ wceq Y (co R U cfrlm) $ >
  $ wceq Z (co R V cfrlm) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq C (cfv Z cbs) $ >
  $ wceq F (cmpt x3 B2 (cres (cv x3) V)) $ >
  $ wi (w3a (wcel R crg) (wcel U X) (wss V U)) (wcel F (co Y Z clmhm)) $;

--| A subset of a free module obtained by restricting the support set is a submodule. ` J ` is the set of forbidden unit vectors. (Contributed by Stefan O'Rear, 4-Feb-2015.)
theorem frlmsslss {x3: setvar} (B2: class) (C: class x3) (R U I J V Y c_0: class):
  $ wceq Y (co R I cfrlm) $ >
  $ wceq U (cfv Y clss) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq C (crab x3 (wceq (cres (cv x3) J) (cxp J (csn c_0))) B2) $ >
  $ wi (w3a (wcel R crg) (wcel I V) (wss J I)) (wcel C U) $;

--| A subset of a free module obtained by restricting the support set is a submodule. ` J ` is the set of permitted unit vectors. (Contributed by Stefan O'Rear, 5-Feb-2015.) (Revised by AV, 23-Jun-2019.)
theorem frlmsslss2 {x3: setvar} (B2: class) (C: class x3) (R U I J V Y c_0: class):
  $ wceq Y (co R I cfrlm) $ >
  $ wceq U (cfv Y clss) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq C (crab x3 (wss (co (cv x3) c_0 csupp) J) B2) $ >
  $ wi (w3a (wcel R crg) (wcel I V) (wss J I)) (wcel C U) $;

--| An element of the base set of a finite free module with a Cartesian product as index set as operation value. (Contributed by AV, 14-Feb-2019.)
theorem frlmbas3 (B2 R F I J M N V W X: class):
  $ wceq F (co R (cxp N M) cfrlm) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq V (cfv F cbs) $ >
  $ wi (w3a (wa (wcel R W) (wcel X V)) (wa (wcel N cfn) (wcel M cfn)) (wa (wcel I N) (wcel J M))) (wcel (co I J X) B2) $;

--| Elements of the free module are mappings with two arguments defined by their operation values. (Contributed by AV, 20-Feb-2019.) (Proof shortened by AV, 3-Jul-2022.)
theorem mpofrlmd {i j a b: setvar} (ph: wff) (A2: class i j) (B2: class a b) (R U F: class i j a b) (M N: class) (V W X Y: class i j a b) (Z: class a b):
  $ wceq F (co R (cxp N M) cfrlm) $ >
  $ wceq V (cfv F cbs) $ >
  $ wi (wa (wceq (cv i) (cv a)) (wceq (cv j) (cv b))) (wceq A2 B2) $ >
  $ wi (w3a ph (wcel (cv i) N) (wcel (cv j) M)) (wcel A2 X) $ >
  $ wi (w3a ph (wcel (cv a) N) (wcel (cv b) M)) (wcel B2 Y) $ >
  $ wi ph (w3a (wcel N U) (wcel M W) (wcel Z V)) $ >
  $ wi ph (wb (wceq Z (cmpo a b N M B2)) (wral i (wral j (wceq (co (cv i) (cv j) Z) A2) M) N)) $;

--| The inner product of a free module. (Contributed by Thierry Arnoux, 20-Jun-2019.)
theorem frlmip {x3 f2 g2: setvar} (B2 R: class) (c_x: class x3 f2 g2) (I V W: class) (Y: class x3 f2 g2):
  $ wceq Y (co R I cfrlm) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel I W) (wcel R V)) (wceq (cmpo f2 g2 (co B2 I cmap) (co B2 I cmap) (co R (cmpt x3 I (co (cfv (cv x3) (cv f2)) (cfv (cv x3) (cv g2)) c_x)) cgsu)) (cfv Y cip)) $;

--| The inner product of a free module. (Contributed by Thierry Arnoux, 21-Jun-2019.)
theorem frlmipval (B2 R c_x F G c_xi I V W X Y: class):
  $ wceq Y (co R I cfrlm) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq V (cfv Y cbs) $ >
  $ wceq c_xi (cfv Y cip) $ >
  $ wi (wa (wa (wcel I W) (wcel R X)) (wa (wcel F V) (wcel G V))) (wceq (co F G c_xi) (co R (co F G (cof c_x)) cgsu)) $;

--| Lemma for ~ frlmphl . (Contributed by AV, 21-Jul-2019.)
theorem frlmphllem {x3 g2: setvar} (ph: wff) (B2 R c_x: class) (h: setvar) (c_xi I: class) (c_as: class g2) (O: class x3) (V W Y c_0: class):
  $ wceq Y (co R I cfrlm) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq V (cfv Y cbs) $ >
  $ wceq c_xi (cfv Y cip) $ >
  $ wceq O (cfv Y c0g) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_as (cfv R cstv) $ >
  $ wi ph (wcel R cfield) $ >
  $ wi (w3a ph (wcel (cv g2) V) (wceq (co (cv g2) (cv g2) c_xi) c_0)) (wceq (cv g2) O) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wceq (cfv (cv x3) c_as) (cv x3)) $ >
  $ wi ph (wcel I W) $ >
  $ wi (w3a ph (wcel (cv g2) V) (wcel (cv h) V)) (wbr (cmpt x3 I (co (cfv (cv x3) (cv g2)) (cfv (cv x3) (cv h)) c_x)) c_0 cfsupp) $;

--| Conditions for a free module to be a pre-Hilbert space. (Contributed by Thierry Arnoux, 21-Jun-2019.) (Proof shortened by AV, 21-Jul-2019.)
theorem frlmphl {x3 g2: setvar} (ph: wff) (B2 R c_x c_xi I: class) (c_as: class g2) (O: class x3) (V W Y c_0: class):
  $ wceq Y (co R I cfrlm) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq V (cfv Y cbs) $ >
  $ wceq c_xi (cfv Y cip) $ >
  $ wceq O (cfv Y c0g) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_as (cfv R cstv) $ >
  $ wi ph (wcel R cfield) $ >
  $ wi (w3a ph (wcel (cv g2) V) (wceq (co (cv g2) (cv g2) c_xi) c_0)) (wceq (cv g2) O) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wceq (cfv (cv x3) c_as) (cv x3)) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel Y cphl) $;

--| Class of basic unit vectors for an explicit free module.
term cuvc: class;

--| ` ( ( R unitVec I ) `` j ) ` is the unit vector in ` ( R freeLMod I ) ` along the ` j ` axis. (Contributed by Stefan O'Rear, 1-Feb-2015.)
axiom df_uvc {i j k r: setvar}:
  $ wceq cuvc (cmpo r i cvv cvv (cmpt j (cv i) (cmpt k (cv i) (cif (wceq (cv k) (cv j)) (cfv (cv r) cur) (cfv (cv r) c0g))))) $;

--| Value of the unit-vector generator for a free module. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem uvcfval {j k: setvar} (R: class) (U: class j k) (c_1 I: class) (V W: class j k) (c_0: class):
  $ wceq U (co R I cuvc) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R V) (wcel I W)) (wceq U (cmpt j I (cmpt k I (cif (wceq (cv k) (cv j)) c_1 c_0)))) $;

--| Value of a single unit vector in a free module. (Contributed by Stefan O'Rear, 3-Feb-2015.)
theorem uvcval {k: setvar} (R: class) (U: class k) (c_1 I J: class) (V W: class k) (c_0: class):
  $ wceq U (co R I cuvc) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel R V) (wcel I W) (wcel J I)) (wceq (cfv J U) (cmpt k I (cif (wceq (cv k) J) c_1 c_0))) $;

--| Value of a unit vector coordinate in a free module. (Contributed by Stefan O'Rear, 3-Feb-2015.)
theorem uvcvval (R U c_1 I J K V W c_0: class):
  $ wceq U (co R I cuvc) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (w3a (wcel R V) (wcel I W) (wcel J I)) (wcel K I)) (wceq (cfv K (cfv J U)) (cif (wceq K J) c_1 c_0)) $;

--| A coordinate of a unit vector is either 0 or 1. (Contributed by Stefan O'Rear, 3-Feb-2015.)
theorem uvcvvcl (R U c_1 I J K V W c_0: class):
  $ wceq U (co R I cuvc) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (w3a (wcel R V) (wcel I W) (wcel J I)) (wcel K I)) (wcel (cfv K (cfv J U)) (cpr c_0 c_1)) $;

--| A unit vector coordinate is a ring element. (Contributed by Stefan O'Rear, 3-Feb-2015.)
theorem uvcvvcl2 (ph: wff) (B2 R U I J K W: class):
  $ wceq U (co R I cuvc) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel J I) $ >
  $ wi ph (wcel K I) $ >
  $ wi ph (wcel (cfv K (cfv J U)) B2) $;

--| The unit vector is one at its designated coordinate. (Contributed by Stefan O'Rear, 3-Feb-2015.)
theorem uvcvv1 (ph: wff) (R U c_1 I J V W: class):
  $ wceq U (co R I cuvc) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel J I) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wceq (cfv J (cfv J U)) c_1) $;

--| The unit vector is zero at its designated coordinate. (Contributed by Stefan O'Rear, 3-Feb-2015.)
theorem uvcvv0 (ph: wff) (R U I J K V W c_0: class):
  $ wceq U (co R I cuvc) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel J I) $ >
  $ wi ph (wcel K I) $ >
  $ wi ph (wne J K) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wceq (cfv K (cfv J U)) c_0) $;

--| Domain and codomain of the unit vector generator; ring condition required to be sure 1 and 0 are actually in the ring. (Contributed by Stefan O'Rear, 1-Feb-2015.) (Proof shortened by AV, 21-Jul-2019.)
theorem uvcff (B2 R U I W Y: class):
  $ wceq U (co R I cuvc) $ >
  $ wceq Y (co R I cfrlm) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wi (wa (wcel R crg) (wcel I W)) (wf I B2 U) $;

--| In a nonzero ring, each unit vector is different. (Contributed by Stefan O'Rear, 7-Feb-2015.) (Revised by Mario Carneiro, 14-Jun-2015.)
theorem uvcf1 (B2 R U I W Y: class):
  $ wceq U (co R I cuvc) $ >
  $ wceq Y (co R I cfrlm) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wi (wa (wcel R cnzr) (wcel I W)) (wf1 I B2 U) $;

--| Any element of a free module can be expressed as a finite linear combination of unit vectors. (Contributed by Stefan O'Rear, 3-Feb-2015.) (Proof shortened by Mario Carneiro, 5-Jul-2015.)
theorem uvcresum (B2 R c_x U I W X Y: class):
  $ wceq U (co R I cuvc) $ >
  $ wceq Y (co R I cfrlm) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq c_x (cfv Y cvsca) $ >
  $ wi (w3a (wcel R crg) (wcel I W) (wcel X B2)) (wceq X (co Y (co X U (cof c_x)) cgsu)) $;

--| A scalar multiple of a unit vector included in a support-restriction subspace is included in the subspace. (Contributed by Stefan O'Rear, 5-Feb-2015.) (Revised by AV, 24-Jun-2019.)
theorem frlmssuvc1 {x3: setvar} (ph: wff) (B2: class) (C: class x3) (R c_x U F I J K L V X c_0: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq U (co R I cuvc) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_x (cfv F cvsca) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq C (crab x3 (wss (co (cv x3) c_0 csupp) J) B2) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wss J I) $ >
  $ wi ph (wcel L J) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel (co X (cfv L U) c_x) C) $;

--| A nonzero scalar multiple of a unit vector not included in a support-restriction subspace is not included in the subspace. (Contributed by Stefan O'Rear, 5-Feb-2015.) (Revised by AV, 24-Jun-2019.)
theorem frlmssuvc2 {x3: setvar} (ph: wff) (B2: class) (C: class x3) (R c_x U F I J K L V X c_0: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq U (co R I cuvc) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_x (cfv F cvsca) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq C (crab x3 (wss (co (cv x3) c_0 csupp) J) B2) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wss J I) $ >
  $ wi ph (wcel L (cdif I J)) $ >
  $ wi ph (wcel X (cdif K (csn c_0))) $ >
  $ wi ph (wn (wcel (co X (cfv L U) c_x) C)) $;

--| A subset of a free module obtained by restricting the support set is spanned by the relevant unit vectors. (Contributed by Stefan O'Rear, 6-Feb-2015.) (Revised by AV, 24-Jun-2019.)
theorem frlmsslsp {x3: setvar} (B2: class) (C: class x3) (R U I J K V Y c_0: class):
  $ wceq Y (co R I cfrlm) $ >
  $ wceq U (co R I cuvc) $ >
  $ wceq K (cfv Y clspn) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq C (crab x3 (wss (co (cv x3) c_0 csupp) J) B2) $ >
  $ wi (w3a (wcel R crg) (wcel I V) (wss J I)) (wceq (cfv (cima U J) K) C) $;

--| The unit vectors comprise a basis for a free module. (Contributed by Stefan O'Rear, 6-Feb-2015.) (Proof shortened by AV, 21-Jul-2019.)
theorem frlmlbs (R U F I J V: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq U (co R I cuvc) $ >
  $ wceq J (cfv F clbs) $ >
  $ wi (wa (wcel R crg) (wcel I V)) (wcel (crn U) J) $;

--| Any assignment of unit vectors to target vectors can be extended (uniquely) to a homomorphism from a free module to an arbitrary other module on the same base ring. (Contributed by Stefan O'Rear, 7-Feb-2015.) (Proof shortened by AV, 21-Jul-2019.)
theorem frlmup1 {x3: setvar} (ph: wff) (A2 B2 C R T c_x: class) (E: class x3) (F I X: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq C (cfv T cbs) $ >
  $ wceq c_x (cfv T cvsca) $ >
  $ wceq E (cmpt x3 B2 (co T (co (cv x3) A2 (cof c_x)) cgsu)) $ >
  $ wi ph (wcel T clmod) $ >
  $ wi ph (wcel I X) $ >
  $ wi ph (wceq R (cfv T csca)) $ >
  $ wi ph (wf I C A2) $ >
  $ wi ph (wcel E (co F T clmhm)) $;

--| The evaluation map has the intended behavior on the unit vectors. (Contributed by Stefan O'Rear, 7-Feb-2015.) (Proof shortened by AV, 21-Jul-2019.)
theorem frlmup2 {x3: setvar} (ph: wff) (A2 B2 C R T c_x U: class) (E: class x3) (F I X Y: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq C (cfv T cbs) $ >
  $ wceq c_x (cfv T cvsca) $ >
  $ wceq E (cmpt x3 B2 (co T (co (cv x3) A2 (cof c_x)) cgsu)) $ >
  $ wi ph (wcel T clmod) $ >
  $ wi ph (wcel I X) $ >
  $ wi ph (wceq R (cfv T csca)) $ >
  $ wi ph (wf I C A2) $ >
  $ wi ph (wcel Y I) $ >
  $ wceq U (co R I cuvc) $ >
  $ wi ph (wceq (cfv (cfv Y U) E) (cfv Y A2)) $;

--| The range of such an evaluation map is the finite linear combinations of the target vectors and also the span of the target vectors. (Contributed by Stefan O'Rear, 6-Feb-2015.)
theorem frlmup3 {x3: setvar} (ph: wff) (A2 B2 C R T c_x: class) (E: class x3) (F I K X: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq C (cfv T cbs) $ >
  $ wceq c_x (cfv T cvsca) $ >
  $ wceq E (cmpt x3 B2 (co T (co (cv x3) A2 (cof c_x)) cgsu)) $ >
  $ wi ph (wcel T clmod) $ >
  $ wi ph (wcel I X) $ >
  $ wi ph (wceq R (cfv T csca)) $ >
  $ wi ph (wf I C A2) $ >
  $ wceq K (cfv T clspn) $ >
  $ wi ph (wceq (crn E) (cfv (crn A2) K)) $;

--| Universal property of the free module by existential uniqueness. (Contributed by Stefan O'Rear, 7-Mar-2015.)
theorem frlmup4 {m: setvar} (A2: class) (C R: class m) (T U F: class) (I X: class m):
  $ wceq R (cfv T csca) $ >
  $ wceq F (co R I cfrlm) $ >
  $ wceq U (co R I cuvc) $ >
  $ wceq C (cfv T cbs) $ >
  $ wi (w3a (wcel T clmod) (wcel I X) (wf I C A2)) (wreu m (wceq (ccom (cv m) U) A2) (co F T clmhm)) $;

--| The elements of the span of an indexed collection of basic vectors are those vectors which can be written as finite linear combinations of basic vectors. (Contributed by Stefan O'Rear, 7-Feb-2015.) (Revised by AV, 24-Jun-2019.) (Revised by AV, 11-Apr-2024.)
theorem ellspd {f2: setvar} (ph: wff) (B2 S c_x F I K M N V X c_0: class):
  $ wceq N (cfv M clspn) $ >
  $ wceq B2 (cfv M cbs) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq S (cfv M csca) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq c_x (cfv M cvsca) $ >
  $ wi ph (wf I B2 F) $ >
  $ wi ph (wcel M clmod) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wb (wcel X (cfv (cima F I) N)) (wrex f2 (wa (wbr (cv f2) c_0 cfsupp) (wceq X (co M (co (cv f2) F (cof c_x)) cgsu))) (co K I cmap))) $;

--| Simplified version of ~ ellspd when the spanning set is finite: all linear combinations are then acceptable. (Contributed by Stefan O'Rear, 7-Feb-2015.) (Proof shortened by AV, 21-Jul-2019.)
theorem elfilspd {f2: setvar} (ph: wff) (B2 S c_x F I K M N X c_0: class):
  $ wceq N (cfv M clspn) $ >
  $ wceq B2 (cfv M cbs) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq S (cfv M csca) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq c_x (cfv M cvsca) $ >
  $ wi ph (wf I B2 F) $ >
  $ wi ph (wcel M clmod) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wb (wcel X (cfv (cima F I) N)) (wrex f2 (wceq X (co M (co (cv f2) F (cof c_x)) cgsu)) (co K I cmap))) $;

--| The class relationship of independent families in a module.
term clindf: class;

--| The class generator of independent sets in a module.
term clinds: class;

--| An independent family is a family of vectors, no nonzero multiple of which can be expressed as a linear combination of other elements of the family. This is almost, but not quite, the same as a function into an independent set. This is a defined concept because it matters in many cases whether independence is taken at a set or family level. For instance, a number is transcedental iff its nonzero powers are linearly independent. Is 1 transcedental? It has only one nonzero power. We can almost define family independence as a family of unequal elements with independent range, as ~ islindf3 , but taking that as primitive would lead to unpleasant corner case behavior with the zero ring. This is equivalent to the common definition of having no nontrivial representations of zero ( ~ islindf4 ) and only one representation for each element of the range ( ~ islindf5 ). (Contributed by Stefan O'Rear, 24-Feb-2015.)
axiom df_lindf {x3 w f2 k s1: setvar}:
  $ wceq clindf (copab f2 w (wa (wf (cdm (cv f2)) (cfv (cv w) cbs) (cv f2)) (wsbc s1 (wral x3 (wral k (wn (wcel (co (cv k) (cfv (cv x3) (cv f2)) (cfv (cv w) cvsca)) (cfv (cima (cv f2) (cdif (cdm (cv f2)) (csn (cv x3)))) (cfv (cv w) clspn)))) (cdif (cfv (cv s1) cbs) (csn (cfv (cv s1) c0g)))) (cdm (cv f2))) (cfv (cv w) csca)))) $;

--| An independent set is a set which is independent as a family. See also ~ islinds3 and ~ islinds4 . (Contributed by Stefan O'Rear, 24-Feb-2015.)
axiom df_linds {w s1: setvar}:
  $ wceq clinds (cmpt w cvv (crab s1 (wbr (cres cid (cv s1)) (cv w) clindf) (cpw (cfv (cv w) cbs)))) $;

--| The independent-family predicate is a proper relation and can be used with ~ brrelex1i . (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem rellindf:
  $ wrel clindf $;

--| Property of an independent set of vectors in terms of an independent family. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem islinds (B2 V W X: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wi (wcel W V) (wb (wcel X (cfv W clinds)) (wa (wss X B2) (wbr (cres cid X) W clindf))) $;

--| An independent set of vectors is a set of vectors. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem linds1 (B2 W X: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wi (wcel X (cfv W clinds)) (wss X B2) $;

--| An independent set of vectors is independent as a family. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem linds2 (W X: class):
  $ wi (wcel X (cfv W clinds)) (wbr (cres cid X) W clindf) $;

--| Property of an independent family of vectors. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem islindf {x3 k: setvar} (B2 S c_x: class x3 k) (F: class) (K: class x3 k) (N: class x3) (W: class) (X Y: class x3 k) (c_0: class x3):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv W clspn) $ >
  $ wceq S (cfv W csca) $ >
  $ wceq N (cfv S cbs) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wi (wa (wcel W Y) (wcel F X)) (wb (wbr F W clindf) (wa (wf (cdm F) B2 F) (wral x3 (wral k (wn (wcel (co (cv k) (cfv (cv x3) F) c_x) (cfv (cima F (cdif (cdm F) (csn (cv x3)))) K))) (cdif N (csn c_0))) (cdm F)))) $;

--| Expanded property of an independent set of vectors. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem islinds2 {x3 k: setvar} (B2 S c_x: class x3 k) (F: class) (K: class x3 k) (N: class x3) (W: class) (Y: class x3 k) (c_0: class x3):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv W clspn) $ >
  $ wceq S (cfv W csca) $ >
  $ wceq N (cfv S cbs) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wi (wcel W Y) (wb (wcel F (cfv W clinds)) (wa (wss F B2) (wral x3 (wral k (wn (wcel (co (cv k) (cv x3) c_x) (cfv (cdif F (csn (cv x3))) K))) (cdif N (csn c_0))) F))) $;

--| Property of an independent family of vectors with prior constrained domain and codomain. (Contributed by Stefan O'Rear, 26-Feb-2015.)
theorem islindf2 {x3 k: setvar} (B2: class) (S c_x: class x3 k) (F I: class) (K: class x3 k) (N: class x3) (W X Y: class) (c_0: class x3):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv W clspn) $ >
  $ wceq S (cfv W csca) $ >
  $ wceq N (cfv S cbs) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wi (w3a (wcel W Y) (wcel I X) (wf I B2 F)) (wb (wbr F W clindf) (wral x3 (wral k (wn (wcel (co (cv k) (cfv (cv x3) F) c_x) (cfv (cima F (cdif I (csn (cv x3)))) K))) (cdif N (csn c_0))) I)) $;

--| Functional property of a linearly independent family. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem lindff (B2 F W Y: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wi (wa (wbr F W clindf) (wcel W Y)) (wf (cdm F) B2 F) $;

--| A linearly independent family is independent: no nonzero element multiple can be expressed as a linear combination of the others. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem lindfind (A2 c_x E F K L N W c_0: class):
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq L (cfv W csca) $ >
  $ wceq c_0 (cfv L c0g) $ >
  $ wceq K (cfv L cbs) $ >
  $ wi (wa (wa (wbr F W clindf) (wcel E (cdm F))) (wa (wcel A2 K) (wne A2 c_0))) (wn (wcel (co A2 (cfv E F) c_x) (cfv (cima F (cdif (cdm F) (csn E))) N))) $;

--| A linearly independent set is independent: no nonzero element multiple can be expressed as a linear combination of the others. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem lindsind (A2 c_x E F K L N W c_0: class):
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq L (cfv W csca) $ >
  $ wceq c_0 (cfv L c0g) $ >
  $ wceq K (cfv L cbs) $ >
  $ wi (wa (wa (wcel F (cfv W clinds)) (wcel E F)) (wa (wcel A2 K) (wne A2 c_0))) (wn (wcel (co A2 E c_x) (cfv (cdif F (csn E)) N))) $;

--| In a linearly independent family in a module over a nonzero ring, no element is contained in the span of any non-containing set. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem lindfind2 (E F K L W: class):
  $ wceq K (cfv W clspn) $ >
  $ wceq L (cfv W csca) $ >
  $ wi (w3a (wa (wcel W clmod) (wcel L cnzr)) (wbr F W clindf) (wcel E (cdm F))) (wn (wcel (cfv E F) (cfv (cima F (cdif (cdm F) (csn E))) K))) $;

--| In a linearly independent set in a module over a nonzero ring, no element is contained in the span of any non-containing set. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem lindsind2 (E F K L W: class):
  $ wceq K (cfv W clspn) $ >
  $ wceq L (cfv W csca) $ >
  $ wi (w3a (wa (wcel W clmod) (wcel L cnzr)) (wcel F (cfv W clinds)) (wcel E F)) (wn (wcel E (cfv (cdif F (csn E)) K))) $;

--| A linearly independent family over a nonzero ring has no repeated elements. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem lindff1 (B2 F L W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq L (cfv W csca) $ >
  $ wi (w3a (wcel W clmod) (wcel L cnzr) (wbr F W clindf)) (wf1 (cdm F) B2 F) $;

--| The range of an independent family is an independent set. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem lindfrn (F W: class):
  $ wi (wa (wcel W clmod) (wbr F W clindf)) (wcel (crn F) (cfv W clinds)) $;

--| Rearranging and deleting elements from an independent family gives an independent family. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem f1lindf (F G K W: class):
  $ wi (w3a (wcel W clmod) (wbr F W clindf) (wf1 K (cdm F) G)) (wbr (ccom F G) W clindf) $;

--| Any restriction of an independent family is independent. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem lindfres (F W X: class):
  $ wi (wa (wcel W clmod) (wbr F W clindf)) (wbr (cres F X) W clindf) $;

--| Any subset of an independent set is independent. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem lindsss (F G W: class):
  $ wi (w3a (wcel W clmod) (wcel F (cfv W clinds)) (wss G F)) (wcel G (cfv W clinds)) $;

--| A family constructed from non-repeated elements of an independent set is independent. (Contributed by Stefan O'Rear, 26-Feb-2015.)
theorem f1linds (D S F W: class):
  $ wi (w3a (wcel W clmod) (wcel S (cfv W clinds)) (wf1 D S F)) (wbr F W clindf) $;

--| In a nonzero ring, independent families can be equivalently characterized as renamings of independent sets. (Contributed by Stefan O'Rear, 26-Feb-2015.)
theorem islindf3 (F L W: class):
  $ wceq L (cfv W csca) $ >
  $ wi (wa (wcel W clmod) (wcel L cnzr)) (wb (wbr F W clindf) (wa (wf1 (cdm F) cvv F) (wcel (crn F) (cfv W clinds)))) $;

--| Linear independence of a family is unchanged by injective linear functions. (Contributed by Stefan O'Rear, 26-Feb-2015.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem lindfmm (B2 C S T F G I: class):
  $ wceq B2 (cfv S cbs) $ >
  $ wceq C (cfv T cbs) $ >
  $ wi (w3a (wcel G (co S T clmhm)) (wf1 B2 C G) (wf I B2 F)) (wb (wbr F S clindf) (wbr (ccom G F) T clindf)) $;

--| Linear independence of a set is unchanged by injective linear functions. (Contributed by Stefan O'Rear, 26-Feb-2015.)
theorem lindsmm (B2 C S T F G: class):
  $ wceq B2 (cfv S cbs) $ >
  $ wceq C (cfv T cbs) $ >
  $ wi (w3a (wcel G (co S T clmhm)) (wf1 B2 C G) (wss F B2)) (wb (wcel F (cfv S clinds)) (wcel (cima G F) (cfv T clinds))) $;

--| The monomorphic image of an independent set is independent. (Contributed by Stefan O'Rear, 26-Feb-2015.)
theorem lindsmm2 (B2 C S T F G: class):
  $ wceq B2 (cfv S cbs) $ >
  $ wceq C (cfv T cbs) $ >
  $ wi (w3a (wcel G (co S T clmhm)) (wf1 B2 C G) (wcel F (cfv S clinds))) (wcel (cima G F) (cfv T clinds)) $;

--| Linear independence is unchanged by working in a subspace. (Contributed by Stefan O'Rear, 24-Feb-2015.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem lsslindf (S U F W X: class):
  $ wceq U (cfv W clss) $ >
  $ wceq X (co W S cress) $ >
  $ wi (w3a (wcel W clmod) (wcel S U) (wss (crn F) S)) (wb (wbr F X clindf) (wbr F W clindf)) $;

--| Linear independence is unchanged by working in a subspace. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem lsslinds (S U F W X: class):
  $ wceq U (cfv W clss) $ >
  $ wceq X (co W S cress) $ >
  $ wi (w3a (wcel W clmod) (wcel S U) (wss F S)) (wb (wcel F (cfv X clinds)) (wcel F (cfv W clinds))) $;

--| A basis is an independent spanning set. This could have been used as alternative definition of a basis: ` LBasis = ( w e. _V |-> { b e. ~P ( Base `` w ) | ( ( ( LSpan `` w ) ` ` `` b ) = ( Base `` w ) /\ b e. ( LIndS `` w ) ) } ) ` . (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem islbs4 (B2 J K W X: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq J (cfv W clbs) $ >
  $ wceq K (cfv W clspn) $ >
  $ wb (wcel X J) (wa (wcel X (cfv W clinds)) (wceq (cfv X K) B2)) $;

--| A basis is independent. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem lbslinds (J W: class):
  $ wceq J (cfv W clbs) $ >
  $ wss J (cfv W clinds) $;

--| A subset is linearly independent iff it is a basis of its span. (Contributed by Stefan O'Rear, 25-Feb-2015.)
theorem islinds3 (B2 J K W X Y: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq K (cfv W clspn) $ >
  $ wceq X (co W (cfv Y K) cress) $ >
  $ wceq J (cfv X clbs) $ >
  $ wi (wcel W clmod) (wb (wcel Y (cfv W clinds)) (wcel Y J)) $;

--| A set is independent in a vector space iff it is a subset of some basis. This is an axiom of choice equivalent. (Contributed by Stefan O'Rear, 24-Feb-2015.)
theorem islinds4 {b: setvar} (J W Y: class):
  $ wceq J (cfv W clbs) $ >
  $ wi (wcel W clvec) (wb (wcel Y (cfv W clinds)) (wrex b (wss Y (cv b)) J)) $;

--| The isomorphic image of a basis is a basis. (Contributed by Stefan O'Rear, 26-Feb-2015.)
theorem lmimlbs (B2 S T F J K: class):
  $ wceq J (cfv S clbs) $ >
  $ wceq K (cfv T clbs) $ >
  $ wi (wa (wcel F (co S T clmim)) (wcel B2 J)) (wcel (cima F B2) K) $;

--| Having a basis is an isomorphism invariant. (Contributed by Stefan O'Rear, 26-Feb-2015.)
theorem lmiclbs (S T J K: class):
  $ wceq J (cfv S clbs) $ >
  $ wceq K (cfv T clbs) $ >
  $ wi (wbr S T clmic) (wi (wne J c0) (wne K c0)) $;

--| A family is independent iff it has no nontrivial representations of zero. (Contributed by Stefan O'Rear, 28-Feb-2015.)
theorem islindf4 {x3: setvar} (B2 R c_x F I L W X Y c_0: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq Y (cfv R c0g) $ >
  $ wceq L (cfv (co R I cfrlm) cbs) $ >
  $ wi (w3a (wcel W clmod) (wcel I X) (wf I B2 F)) (wb (wbr F W clindf) (wral x3 (wi (wceq (co W (co (cv x3) F (cof c_x)) cgsu) c_0) (wceq (cv x3) (cxp I (csn Y)))) L)) $;

--| A family is independent iff the linear combinations homomorphism is injective. (Contributed by Stefan O'Rear, 28-Feb-2015.)
theorem islindf5 {x3: setvar} (ph: wff) (A2 B2 C R T c_x: class) (E: class x3) (F I X: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq C (cfv T cbs) $ >
  $ wceq c_x (cfv T cvsca) $ >
  $ wceq E (cmpt x3 B2 (co T (co (cv x3) A2 (cof c_x)) cgsu)) $ >
  $ wi ph (wcel T clmod) $ >
  $ wi ph (wcel I X) $ >
  $ wi ph (wceq R (cfv T csca)) $ >
  $ wi ph (wf I C A2) $ >
  $ wi ph (wb (wbr A2 T clindf) (wf1 B2 C E)) $;

--| An independent, spanning family extends to an isomorphism from a free module. (Contributed by Stefan O'Rear, 26-Feb-2015.)
theorem indlcim {x3: setvar} (ph: wff) (A2 B2 C R T c_x: class) (E: class x3) (F I: class) (J: class x3) (N X: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq C (cfv T cbs) $ >
  $ wceq c_x (cfv T cvsca) $ >
  $ wceq N (cfv T clspn) $ >
  $ wceq E (cmpt x3 B2 (co T (co (cv x3) A2 (cof c_x)) cgsu)) $ >
  $ wi ph (wcel T clmod) $ >
  $ wi ph (wcel I X) $ >
  $ wi ph (wceq R (cfv T csca)) $ >
  $ wi ph (wfo I J A2) $ >
  $ wi ph (wbr A2 T clindf) $ >
  $ wi ph (wceq (cfv J N) C) $ >
  $ wi ph (wcel E (co F T clmim)) $;

--| A module with a basis is isomorphic to a free module with the same cardinality. (Contributed by Stefan O'Rear, 26-Feb-2015.)
theorem lbslcic (B2 F I J W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq J (cfv W clbs) $ >
  $ wi (w3a (wcel W clmod) (wcel B2 J) (wbr I B2 cen)) (wbr W (co F I cfrlm) clmic) $;

--| A module has a basis iff it is isomorphic to a free module. In settings where isomorphic objects are not distinguished, it is common to define "free module" as any module with a basis; thus for instance ~ lbsex might be described as "every vector space is free". (Contributed by Stefan O'Rear, 26-Feb-2015.)
theorem lmisfree {k: setvar} (F J W: class):
  $ wceq J (cfv W clbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wi (wcel W clmod) (wb (wne J c0) (wex k (wbr W (co F (cv k) cfrlm) clmic))) $;

--| Every vector space is isomorphic to a free module. (Contributed by AV, 7-Mar-2019.)
theorem lvecisfrlm {k: setvar} (F W: class):
  $ wceq F (cfv W csca) $ >
  $ wi (wcel W clvec) (wex k (wbr W (co F (cv k) cfrlm) clmic)) $;

--| The composition of two isomorphisms of modules is an isomorphism of modules. (Contributed by AV, 10-Mar-2019.)
theorem lmimco (R S T F G: class):
  $ wi (wa (wcel F (co S T clmim)) (wcel G (co R S clmim))) (wcel (ccom F G) (co R T clmim)) $;

--| Module isomorphism is transitive. (Contributed by AV, 10-Mar-2019.)
theorem lmictra (R S T: class):
  $ wi (wa (wbr R S clmic) (wbr S T clmic)) (wbr R T clmic) $;

--| In a nonzero ring, the mapping of the index set of a free module onto the unit vectors of the free module is a 1-1 onto function. (Contributed by AV, 10-Mar-2019.)
theorem uvcf1o (R U I W: class):
  $ wceq U (co R I cuvc) $ >
  $ wi (wa (wcel R cnzr) (wcel I W)) (wf1o I (crn U) U) $;

--| In a nonzero ring, the number of unit vectors of a free module corresponds to the dimension of the free module. (Contributed by AV, 10-Mar-2019.)
theorem uvcendim (R U I W: class):
  $ wceq U (co R I cuvc) $ >
  $ wi (wa (wcel R cnzr) (wcel I W)) (wbr I (crn U) cen) $;

--| A free module is isomorphic to a free module over the same (nonzero) ring, with the same cardinality. (Contributed by AV, 10-Mar-2019.)
theorem frlmisfrlm (R I J Y: class):
  $ wi (w3a (wcel R cnzr) (wcel I Y) (wbr I J cen)) (wbr (co R I cfrlm) (co R J cfrlm) clmic) $;

--| Every free module is isomorphic to the free module of "column vectors" of the same dimension over the same (nonzero) ring. (Contributed by AV, 10-Mar-2019.)
theorem frlmiscvec (R I Y: class):
  $ wi (wa (wcel R cnzr) (wcel I Y)) (wbr (co R I cfrlm) (co R (cxp I (csn c0)) cfrlm) clmic) $;

--| A linearly independent set in a free linear module of finite dimension over a division ring is smaller than the dimension of the module. (Contributed by Brendan Leahy, 2-Jun-2021.)
theorem lindsdom (R I X: class):
  $ wi (w3a (wcel R cdr) (wcel I cfn) (wcel X (cfv (co R I cfrlm) clinds))) (wbr X I cdom) $;

--| A maximal linearly independent set in a free module of finite dimension over a division ring is a basis. (Contributed by Brendan Leahy, 2-Jun-2021.)
theorem lindsenlbs (R I X: class):
  $ wi (wa (w3a (wcel R cdr) (wcel I cfn) (wcel X (cfv (co R I cfrlm) clinds))) (wbr X I cen)) (wcel X (cfv (co R I cfrlm) clbs)) $;

--| Associative algebra.
term casa: class;

--| Algebraic span function.
term casp: class;

--| Class of algebra scalar lifting function.
term cascl: class;

--| Definition of an associative algebra. An associative algebra is a set equipped with a left-module structure on a ring, coupled with a multiplicative internal operation on the vectors of the module that is associative and distributive for the additive structure of the left-module (so giving the vectors a ring structure) and that is also bilinear under the scalar product. (Contributed by Mario Carneiro, 29-Dec-2014.) (Revised by SN, 2-Mar-2025.)
axiom df_assa {x3 y1 w t f2 s1 r: setvar}:
  $ wceq casa (crab w (wsbc f2 (wral r (wral x3 (wral y1 (wsbc s1 (wsbc t (wa (wceq (co (co (cv r) (cv x3) (cv s1)) (cv y1) (cv t)) (co (cv r) (co (cv x3) (cv y1) (cv t)) (cv s1))) (wceq (co (cv x3) (co (cv r) (cv y1) (cv s1)) (cv t)) (co (cv r) (co (cv x3) (cv y1) (cv t)) (cv s1)))) (cfv (cv w) cmulr)) (cfv (cv w) cvsca)) (cfv (cv w) cbs)) (cfv (cv w) cbs)) (cfv (cv f2) cbs)) (cfv (cv w) csca)) (cin clmod crg)) $;

--| Define the algebraic span of a set of vectors in an algebra. (Contributed by Mario Carneiro, 7-Jan-2015.)
axiom df_asp {w t s1: setvar}:
  $ wceq casp (cmpt w casa (cmpt s1 (cpw (cfv (cv w) cbs)) (cint (crab t (wss (cv s1) (cv t)) (cin (cfv (cv w) csubrg) (cfv (cv w) clss)))))) $;

--| Every unital algebra contains a canonical homomorphic image of its ring of scalars as scalar multiples of the unity element. This names the homomorphism. (Contributed by Mario Carneiro, 8-Mar-2015.)
axiom df_ascl {x3 w: setvar}:
  $ wceq cascl (cmpt w cvv (cmpt x3 (cfv (cfv (cv w) csca) cbs) (co (cv x3) (cfv (cv w) cur) (cfv (cv w) cvsca)))) $;

--| The properties of an associative algebra. (Contributed by Mario Carneiro, 29-Dec-2014.) (Revised by SN, 2-Mar-2025.)
theorem isassa {x3 y1 r: setvar} (B2: class x3 y1) (c_x c_xp: class) (F: class x3 y1) (V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_xp (cfv W cmulr) $ >
  $ wb (wcel W casa) (wa (wa (wcel W clmod) (wcel W crg)) (wral r (wral x3 (wral y1 (wa (wceq (co (co (cv r) (cv x3) c_x) (cv y1) c_xp) (co (cv r) (co (cv x3) (cv y1) c_xp) c_x)) (wceq (co (cv x3) (co (cv r) (cv y1) c_x) c_xp) (co (cv r) (co (cv x3) (cv y1) c_xp) c_x))) V) V) B2)) $;

--| The properties of an associative algebra. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem assalem (A2 B2 c_x c_xp F V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_xp (cfv W cmulr) $ >
  $ wi (wa (wcel W casa) (w3a (wcel A2 B2) (wcel X V) (wcel Y V))) (wa (wceq (co (co A2 X c_x) Y c_xp) (co A2 (co X Y c_xp) c_x)) (wceq (co X (co A2 Y c_x) c_xp) (co A2 (co X Y c_xp) c_x))) $;

--| Left-associative property of an associative algebra. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem assaass (A2 B2 c_x c_xp F V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_xp (cfv W cmulr) $ >
  $ wi (wa (wcel W casa) (w3a (wcel A2 B2) (wcel X V) (wcel Y V))) (wceq (co (co A2 X c_x) Y c_xp) (co A2 (co X Y c_xp) c_x)) $;

--| Right-associative property of an associative algebra. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem assaassr (A2 B2 c_x c_xp F V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_xp (cfv W cmulr) $ >
  $ wi (wa (wcel W casa) (w3a (wcel A2 B2) (wcel X V) (wcel Y V))) (wceq (co X (co A2 Y c_x) c_xp) (co A2 (co X Y c_xp) c_x)) $;

--| An associative algebra is a left module. (Contributed by Mario Carneiro, 5-Dec-2014.)
theorem assalmod (W: class):
  $ wi (wcel W casa) (wcel W clmod) $;

--| An associative algebra is a ring. (Contributed by Mario Carneiro, 5-Dec-2014.)
theorem assaring (W: class):
  $ wi (wcel W casa) (wcel W crg) $;

--| The scalars of an associative algebra form a ring. (Contributed by Mario Carneiro, 7-Jan-2015.) (Revised by SN, 2-Mar-2025.)
theorem assasca (F W: class):
  $ wceq F (cfv W csca) $ >
  $ wi (wcel W casa) (wcel F crg) $;

--| Left- and right-associative property of an associative algebra. Notice that the scalars are commuted! (Contributed by AV, 14-Aug-2019.) (Proof shortened by Zhi Wang, 11-Sep-2025.)
theorem assa2ass (A2 B2 C c_x c_xp F c_as V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq c_as (cfv F cmulr) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_xp (cfv W cmulr) $ >
  $ wi (w3a (wcel W casa) (wa (wcel A2 B2) (wcel C B2)) (wa (wcel X V) (wcel Y V))) (wceq (co (co A2 X c_x) (co C Y c_x) c_xp) (co (co C A2 c_as) (co X Y c_xp) c_x)) $;

--| Left- and right-associative property of an associative algebra. Notice that the scalars are not commuted! (Contributed by Zhi Wang, 11-Sep-2025.)
theorem assa2ass2 (A2 B2 C c_x c_xp F c_as V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq c_as (cfv F cmulr) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_xp (cfv W cmulr) $ >
  $ wi (w3a (wcel W casa) (wa (wcel A2 B2) (wcel C B2)) (wa (wcel X V) (wcel Y V))) (wceq (co (co A2 X c_x) (co C Y c_x) c_xp) (co (co A2 C c_as) (co X Y c_xp) c_x)) $;

--| Sufficient condition for being an associative algebra. (Contributed by Mario Carneiro, 5-Dec-2014.) (Revised by SN, 2-Mar-2025.)
theorem isassad {x3 y1 r: setvar} (ph: wff) (B2: class) (c_x c_xp F: class x3 y1 r) (V: class r) (W: class):
  $ wi ph (wceq V (cfv W cbs)) $ >
  $ wi ph (wceq F (cfv W csca)) $ >
  $ wi ph (wceq B2 (cfv F cbs)) $ >
  $ wi ph (wceq c_x (cfv W cvsca)) $ >
  $ wi ph (wceq c_xp (cfv W cmulr)) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel W crg) $ >
  $ wi (wa ph (w3a (wcel (cv r) B2) (wcel (cv x3) V) (wcel (cv y1) V))) (wceq (co (co (cv r) (cv x3) c_x) (cv y1) c_xp) (co (cv r) (co (cv x3) (cv y1) c_xp) c_x)) $ >
  $ wi (wa ph (w3a (wcel (cv r) B2) (wcel (cv x3) V) (wcel (cv y1) V))) (wceq (co (cv x3) (co (cv r) (cv y1) c_x) c_xp) (co (cv r) (co (cv x3) (cv y1) c_xp) c_x)) $ >
  $ wi ph (wcel W casa) $;

--| A subring that is also a subspace is a subalgebra. The key theorem is ~ islss3 . (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem issubassa3 (A2 S L W: class):
  $ wceq S (co W A2 cress) $ >
  $ wceq L (cfv W clss) $ >
  $ wi (wa (wcel W casa) (wa (wcel A2 (cfv W csubrg)) (wcel A2 L))) (wcel S casa) $;

--| The subalgebras of an associative algebra are exactly the subrings (under the ring multiplication) that are simultaneously subspaces (under the scalar multiplication from the vector space). (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem issubassa (A2 S c_1 L V W: class):
  $ wceq S (co W A2 cress) $ >
  $ wceq L (cfv W clss) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_1 (cfv W cur) $ >
  $ wi (w3a (wcel W casa) (wcel c_1 A2) (wss A2 V)) (wb (wcel S casa) (wa (wcel A2 (cfv W csubrg)) (wcel A2 L))) $;

--| A subring algebra is an associative algebra if and only if the subring is included in the ring's center. (Contributed by SN, 21-Mar-2025.)
theorem sraassab (ph: wff) (A2 S W Z: class):
  $ wceq A2 (cfv S (cfv W csra)) $ >
  $ wceq Z (cfv (cfv W cmgp) ccntr) $ >
  $ wi ph (wcel W crg) $ >
  $ wi ph (wcel S (cfv W csubrg)) $ >
  $ wi ph (wb (wcel A2 casa) (wss S Z)) $;

--| The subring algebra over a commutative ring is an associative algebra. (Contributed by Mario Carneiro, 6-Oct-2015.) (Proof shortened by SN, 21-Mar-2025.)
theorem sraassa (A2 S W: class):
  $ wceq A2 (cfv S (cfv W csra)) $ >
  $ wi (wa (wcel W ccrg) (wcel S (cfv W csubrg))) (wcel A2 casa) $;

--| The ring module over a commutative ring is an associative algebra. (Contributed by Mario Carneiro, 6-Oct-2015.)
theorem rlmassa (R: class):
  $ wi (wcel R ccrg) (wcel (cfv R crglmod) casa) $;

--| If two structures have the same components (properties), one is an associative algebra iff the other one is. (Contributed by Mario Carneiro, 8-Feb-2015.)
theorem assapropd {x3 y1: setvar} (ph: wff) (B2 P: class) (F: class x3 y1) (K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi ph (wceq F (cfv K csca)) $ >
  $ wi ph (wceq F (cfv L csca)) $ >
  $ wceq P (cfv F cbs) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cvsca)) (co (cv x3) (cv y1) (cfv L cvsca))) $ >
  $ wi ph (wb (wcel K casa) (wcel L casa)) $;

--| Value of the algebraic closure operation inside an associative algebra. (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem aspval {t: setvar} (A2: class t) (S L V W: class):
  $ wceq A2 (cfv W casp) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq L (cfv W clss) $ >
  $ wi (wa (wcel W casa) (wss S V)) (wceq (cfv S A2) (cint (crab t (wss S (cv t)) (cin (cfv W csubrg) L)))) $;

--| The algebraic span of a set of vectors is a vector subspace. (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem asplss (A2 S L V W: class):
  $ wceq A2 (cfv W casp) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq L (cfv W clss) $ >
  $ wi (wa (wcel W casa) (wss S V)) (wcel (cfv S A2) L) $;

--| The algebraic span of a subalgebra is itself. ( ~ spanid analog.) (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem aspid (A2 S L V W: class):
  $ wceq A2 (cfv W casp) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq L (cfv W clss) $ >
  $ wi (w3a (wcel W casa) (wcel S (cfv W csubrg)) (wcel S L)) (wceq (cfv S A2) S) $;

--| The algebraic span of a set of vectors is a subring of the algebra. (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem aspsubrg (A2 S V W: class):
  $ wceq A2 (cfv W casp) $ >
  $ wceq V (cfv W cbs) $ >
  $ wi (wa (wcel W casa) (wss S V)) (wcel (cfv S A2) (cfv W csubrg)) $;

--| Span preserves subset ordering. ( ~ spanss analog.) (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem aspss (A2 S T V W: class):
  $ wceq A2 (cfv W casp) $ >
  $ wceq V (cfv W cbs) $ >
  $ wi (w3a (wcel W casa) (wss S V) (wss T S)) (wss (cfv T A2) (cfv S A2)) $;

--| A set of vectors is a subset of its span. ( ~ spanss2 analog.) (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem aspssid (A2 S V W: class):
  $ wceq A2 (cfv W casp) $ >
  $ wceq V (cfv W cbs) $ >
  $ wi (wa (wcel W casa) (wss S V)) (wss S (cfv S A2)) $;

--| Function value of the algebra scalar lifting function. (Contributed by Mario Carneiro, 8-Mar-2015.)
theorem asclfval {x3: setvar} (A2: class x3) (c_x c_1: class) (F: class x3) (K W: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_1 (cfv W cur) $ >
  $ wceq A2 (cmpt x3 K (co (cv x3) c_1 c_x)) $;

--| Value of a mapped algebra scalar. (Contributed by Mario Carneiro, 8-Mar-2015.)
theorem asclval (A2 c_x c_1 F K W X: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_1 (cfv W cur) $ >
  $ wi (wcel X K) (wceq (cfv X A2) (co X c_1 c_x)) $;

--| Unconditional functionality of the algebra scalar lifting function. (Contributed by Mario Carneiro, 9-Mar-2015.)
theorem asclfn (A2 F K W: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wfn A2 K $;

--| The algebra scalar lifting function is a function into the base set. (Contributed by Mario Carneiro, 4-Jul-2015.)
theorem asclf (ph: wff) (A2 B2 F K W: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq F (cfv W csca) $ >
  $ wi ph (wcel W crg) $ >
  $ wi ph (wcel W clmod) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wf K B2 A2) $;

--| The algebra scalar lifting function is a group homomorphism. (Contributed by Mario Carneiro, 4-Jul-2015.)
theorem asclghm (ph: wff) (A2 F W: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq F (cfv W csca) $ >
  $ wi ph (wcel W crg) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel A2 (co F W cghm)) $;

--| Lifted scalars are in the base set of the algebra. (Contributed by Zhi Wang, 11-Sep-2025.) (Proof shortened by Thierry Arnoux, 22-Sep-2025.)
theorem asclelbas (ph: wff) (A2 B2 C F W: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wcel W casa) $ >
  $ wi ph (wcel C B2) $ >
  $ wi ph (wcel (cfv C A2) (cfv W cbs)) $;

--| The scalar 0 embedded into a left module corresponds to the 0 of the left module if the left module is also a ring. (Contributed by AV, 31-Jul-2019.)
theorem ascl0 (ph: wff) (A2 F W: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq F (cfv W csca) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel W crg) $ >
  $ wi ph (wceq (cfv (cfv F c0g) A2) (cfv W c0g)) $;

--| The scalar 1 embedded into a left module corresponds to the 1 of the left module if the left module is also a ring. (Contributed by AV, 31-Jul-2019.)
theorem ascl1 (ph: wff) (A2 F W: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq F (cfv W csca) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel W crg) $ >
  $ wi ph (wceq (cfv (cfv F cur) A2) (cfv W cur)) $;

--| Left multiplication by a lifted scalar is the same as the scalar operation. (Contributed by Mario Carneiro, 9-Mar-2015.)
theorem asclmul1 (A2 R c_x c_xp F K V W X: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_xp (cfv W cmulr) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wi (w3a (wcel W casa) (wcel R K) (wcel X V)) (wceq (co (cfv R A2) X c_xp) (co R X c_x)) $;

--| Right multiplication by a lifted scalar is the same as the scalar operation. (Contributed by Mario Carneiro, 9-Mar-2015.)
theorem asclmul2 (A2 R c_x c_xp F K V W X: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_xp (cfv W cmulr) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wi (w3a (wcel W casa) (wcel R K) (wcel X V)) (wceq (co X (cfv R A2) c_xp) (co R X c_x)) $;

--| The algebra scalar lifting function distributes over multiplication. (Contributed by Mario Carneiro, 8-Mar-2015.) (Proof shortened by SN, 5-Nov-2023.)
theorem ascldimul (A2 R S c_x c_xp F K W: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_xp (cfv W cmulr) $ >
  $ wceq c_x (cfv F cmulr) $ >
  $ wi (w3a (wcel W casa) (wcel R K) (wcel S K)) (wceq (cfv (co R S c_x) A2) (co (cfv R A2) (cfv S A2) c_xp)) $;

--| The group inverse (negation) of a lifted scalar is the lifted negation of the scalar. (Contributed by AV, 2-Sep-2019.)
theorem asclinvg (A2 B2 C R I J W: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq I (cfv R cminusg) $ >
  $ wceq J (cfv W cminusg) $ >
  $ wi (w3a (wcel W clmod) (wcel W crg) (wcel C B2)) (wceq (cfv (cfv C A2) J) (cfv (cfv C I) A2)) $;

--| The algebra scalar lifting function is a ring homomorphism. (Contributed by Mario Carneiro, 8-Mar-2015.)
theorem asclrhm (A2 F W: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq F (cfv W csca) $ >
  $ wi (wcel W casa) (wcel A2 (co F W crh)) $;

--| The set of lifted scalars is also interpretable as the span of the identity. (Contributed by Mario Carneiro, 9-Mar-2015.)
theorem rnascl (A2 c_1 N W: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq c_1 (cfv W cur) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wcel W casa) (wceq (crn A2) (cfv (csn c_1) N)) $;

--| A subring of a unital algebra is a subspace and thus a subalgebra iff it contains all scalar multiples of the identity. (Contributed by Mario Carneiro, 9-Mar-2015.)
theorem issubassa2 (A2 S L W: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq L (cfv W clss) $ >
  $ wi (wa (wcel W casa) (wcel S (cfv W csubrg))) (wb (wcel S L) (wss (crn A2) S)) $;

--| The scalar multiples of the unit vector form a subring of the vectors. (Contributed by SN, 5-Nov-2023.)
theorem rnasclsubrg (ph: wff) (C W: class):
  $ wceq C (cfv W cascl) $ >
  $ wi ph (wcel W casa) $ >
  $ wi ph (wcel (crn C) (cfv W csubrg)) $;

--| (Vector) multiplication is closed for scalar multiples of the unit vector. (Contributed by SN, 5-Nov-2023.)
theorem rnasclmulcl (ph: wff) (C c_xp W X Y: class):
  $ wceq C (cfv W cascl) $ >
  $ wceq c_xp (cfv W cmulr) $ >
  $ wi ph (wcel W casa) $ >
  $ wi (wa ph (wa (wcel X (crn C)) (wcel Y (crn C)))) (wcel (co X Y c_xp) (crn C)) $;

--| The scalar multiples of the unit vector form a subalgebra of the vectors. (Contributed by SN, 16-Nov-2023.)
theorem rnasclassa (ph: wff) (A2 U W: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq U (co W (crn A2) cress) $ >
  $ wi ph (wcel W casa) $ >
  $ wi ph (wcel U casa) $;

--| The lifting of scalars is invariant between subalgebras and superalgebras. (Contributed by Mario Carneiro, 9-Mar-2015.)
theorem ressascl (A2 S W X: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq X (co W S cress) $ >
  $ wi (wcel S (cfv W csubrg)) (wceq A2 (cfv X cascl)) $;

--| If two structures have the same components (properties), one is an associative algebra iff the other one is. The last hypotheses on ` 1r ` can be discharged either by letting ` W = _V ` (if strong equality is known on ` .s ` ) or assuming ` K ` is a ring. (Contributed by Mario Carneiro, 5-Jul-2015.)
theorem asclpropd {x3 y1: setvar} (ph: wff) (P: class) (F G: class x3 y1) (K L W: class):
  $ wceq F (cfv K csca) $ >
  $ wceq G (cfv L csca) $ >
  $ wi ph (wceq P (cfv F cbs)) $ >
  $ wi ph (wceq P (cfv G cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) W))) (wceq (co (cv x3) (cv y1) (cfv K cvsca)) (co (cv x3) (cv y1) (cfv L cvsca))) $ >
  $ wi ph (wceq (cfv K cur) (cfv L cur)) $ >
  $ wi ph (wcel (cfv K cur) W) $ >
  $ wi ph (wceq (cfv K cascl) (cfv L cascl)) $;

--| The algebraic closure is the ring closure when the generating set is expanded to include all scalars. _EDITORIAL_ : In light of this, is ` AlgSpan ` independently needed? (Contributed by Stefan O'Rear, 9-Mar-2015.)
theorem aspval2 (A2 C R S V W: class):
  $ wceq A2 (cfv W casp) $ >
  $ wceq C (cfv W cascl) $ >
  $ wceq R (cfv (cfv W csubrg) cmrc) $ >
  $ wceq V (cfv W cbs) $ >
  $ wi (wa (wcel W casa) (wss S V)) (wceq (cfv S A2) (cfv (cun (crn C) S) R)) $;

--| Lemma 1 for ~ assamulgscm (induction base). (Contributed by AV, 26-Aug-2019.)
theorem assamulgscmlem1 (A2 B2 c_x E c_ex F G H V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq G (cfv F cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wceq H (cfv W cmgp) $ >
  $ wceq E (cfv H cmg) $ >
  $ wi (wa (wa (wcel A2 B2) (wcel X V)) (wcel W casa)) (wceq (co cc0 (co A2 X c_x) E) (co (co cc0 A2 c_ex) (co cc0 X E) c_x)) $;

--| Lemma for ~ assamulgscm (induction step). (Contributed by AV, 26-Aug-2019.)
theorem assamulgscmlem2 (y1: setvar) (A2 B2 c_x E c_ex F G H V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq G (cfv F cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wceq H (cfv W cmgp) $ >
  $ wceq E (cfv H cmg) $ >
  $ wi (wcel (cv y1) cn0) (wi (wa (wa (wcel A2 B2) (wcel X V)) (wcel W casa)) (wi (wceq (co (cv y1) (co A2 X c_x) E) (co (co (cv y1) A2 c_ex) (co (cv y1) X E) c_x)) (wceq (co (co (cv y1) c1 caddc) (co A2 X c_x) E) (co (co (co (cv y1) c1 caddc) A2 c_ex) (co (co (cv y1) c1 caddc) X E) c_x)))) $;

--| Exponentiation of a scalar multiplication in an associative algebra: ` ( a .x. X ) ^ N = ( a ^ N ) .X. ( X ^ N ) ` . (Contributed by AV, 26-Aug-2019.)
theorem assamulgscm (A2 B2 c_x E c_ex F G H N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq G (cfv F cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wceq H (cfv W cmgp) $ >
  $ wceq E (cfv H cmg) $ >
  $ wi (wa (wcel W casa) (w3a (wcel N cn0) (wcel A2 B2) (wcel X V))) (wceq (co N (co A2 X c_x) E) (co (co N A2 c_ex) (co N X E) c_x)) $;

--| Apply group multiplication to the algebra scalars. (Contributed by Thierry Arnoux, 24-Jul-2024.)
theorem asclmulg (A2 c_ex F c_as K N W X: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_ex (cfv W cmg) $ >
  $ wceq c_as (cfv F cmg) $ >
  $ wi (w3a (wcel W casa) (wcel N cn0) (wcel X K)) (wceq (cfv (co N X c_as) A2) (co N (cfv X A2) c_ex)) $;

--| The ` ZZ ` -module operation turns a ring into an associative algebra over ` ZZ ` . Also see ~ zlmlmod . (Contributed by Mario Carneiro, 2-Oct-2015.)
theorem zlmassa (G W: class):
  $ wceq W (cfv G czlm) $ >
  $ wb (wcel G crg) (wcel W casa) $;

--| Multivariate power series.
term cmps: class;

--| Multivariate power series variables.
term cmvr: class;

--| Multivariate polynomials.
term cmpl: class;

--| Ordering on terms of a multivariate polynomial.
term cltb: class;

--| Ordered set of power series.
term copws: class;

--| Define the algebra of power series over the index set ` i ` and with coefficients from the ring ` r ` . (Contributed by Mario Carneiro, 21-Mar-2015.)
axiom df_psr {x3 y1 f2 g2 h i k r b d: setvar}:
  $ wceq cmps (cmpo i r cvv cvv (csb d (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 (cv i) cmap)) (csb b (co (cfv (cv r) cbs) (cv d) cmap) (cun (ctp (cop (cfv cnx cbs) (cv b)) (cop (cfv cnx cplusg) (cres (cof (cfv (cv r) cplusg)) (cxp (cv b) (cv b)))) (cop (cfv cnx cmulr) (cmpo f2 g2 (cv b) (cv b) (cmpt k (cv d) (co (cv r) (cmpt x3 (crab y1 (wbr (cv y1) (cv k) (cofr cle)) (cv d)) (co (cfv (cv x3) (cv f2)) (cfv (co (cv k) (cv x3) (cof cmin)) (cv g2)) (cfv (cv r) cmulr))) cgsu))))) (ctp (cop (cfv cnx csca) (cv r)) (cop (cfv cnx cvsca) (cmpo x3 f2 (cfv (cv r) cbs) (cv b) (co (cxp (cv d) (csn (cv x3))) (cv f2) (cof (cfv (cv r) cmulr))))) (cop (cfv cnx cts) (cfv (cxp (cv d) (csn (cfv (cv r) ctopn))) cpt))))))) $;

--| Define the generating elements of the power series algebra. (Contributed by Mario Carneiro, 7-Jan-2015.)
axiom df_mvr {x3 y1 f2 h i r: setvar}:
  $ wceq cmvr (cmpo i r cvv cvv (cmpt x3 (cv i) (cmpt f2 (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 (cv i) cmap)) (cif (wceq (cv f2) (cmpt y1 (cv i) (cif (wceq (cv y1) (cv x3)) c1 cc0))) (cfv (cv r) cur) (cfv (cv r) c0g))))) $;

--| Define the subalgebra of the power series algebra generated by the variables; this is the polynomial algebra (the set of power series with finite degree). (Contributed by Mario Carneiro, 7-Jan-2015.) (Revised by AV, 25-Jun-2019.)
axiom df_mpl {w f2 i r: setvar}:
  $ wceq cmpl (cmpo i r cvv cvv (csb w (co (cv i) (cv r) cmps) (co (cv w) (crab f2 (wbr (cv f2) (cfv (cv r) c0g) cfsupp) (cfv (cv w) cbs)) cress))) $;

--| Define a well-order on the set of all finite bags from the index set ` i ` given a wellordering ` r ` of ` i ` . (Contributed by Mario Carneiro, 8-Feb-2015.)
axiom df_ltbag {x3 y1 z w h i r: setvar}:
  $ wceq cltb (cmpo r i cvv cvv (copab x3 y1 (wa (wss (cpr (cv x3) (cv y1)) (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 (cv i) cmap))) (wrex z (wa (wbr (cfv (cv z) (cv x3)) (cfv (cv z) (cv y1)) clt) (wral w (wi (wbr (cv z) (cv w) (cv r)) (wceq (cfv (cv w) (cv x3)) (cfv (cv w) (cv y1)))) (cv i))) (cv i))))) $;

--| Define a total order on the set of all power series in ` s ` from the index set ` i ` given a wellordering ` r ` of ` i ` and a totally ordered base ring ` s ` . (Contributed by Mario Carneiro, 8-Feb-2015.)
axiom df_opsr {x3 y1 z w h i s1 r p d: setvar}:
  $ wceq copws (cmpo i s1 cvv cvv (cmpt r (cpw (cxp (cv i) (cv i))) (csb p (co (cv i) (cv s1) cmps) (co (cv p) (cop (cfv cnx cple) (copab x3 y1 (wa (wss (cpr (cv x3) (cv y1)) (cfv (cv p) cbs)) (wo (wsbc d (wrex z (wa (wbr (cfv (cv z) (cv x3)) (cfv (cv z) (cv y1)) (cfv (cv s1) cplt)) (wral w (wi (wbr (cv w) (cv z) (co (cv r) (cv i) cltb)) (wceq (cfv (cv w) (cv x3)) (cfv (cv w) (cv y1)))) (cv d))) (cv d)) (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 (cv i) cmap))) (wceq (cv x3) (cv y1)))))) csts)))) $;

--| The multivariate power series constructor is a proper binary operator. (Contributed by Mario Carneiro, 21-Mar-2015.)
theorem reldmpsr:
  $ wrel (cdm cmps) $;

--| Value of the multivariate power series structure. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem psrval {x3 y1 f2 g2 h k: setvar} (ph: wff y1 h) (B2: class y1 h) (D: class h) (c_pl c_pb: class x3 y1 f2 g2 h k) (R: class y1 h) (S c_xb c_x c_xp: class x3 y1 f2 g2 h k) (I: class y1) (J K O W X: class x3 y1 f2 g2 h k):
  $ wceq S (co I R cmps) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq O (cfv R ctopn) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wceq B2 (co K D cmap)) $ >
  $ wceq c_pb (cres (cof c_pl) (cxp B2 B2)) $ >
  $ wceq c_xp (cmpo f2 g2 B2 B2 (cmpt k D (co R (cmpt x3 (crab y1 (wbr (cv y1) (cv k) (cofr cle)) D) (co (cfv (cv x3) (cv f2)) (cfv (co (cv k) (cv x3) (cof cmin)) (cv g2)) c_x)) cgsu))) $ >
  $ wceq c_xb (cmpo x3 f2 K B2 (co (cxp D (csn (cv x3))) (cv f2) (cof c_x))) $ >
  $ wi ph (wceq J (cfv (cxp D (csn O)) cpt)) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R X) $ >
  $ wi ph (wceq S (cun (ctp (cop (cfv cnx cbs) B2) (cop (cfv cnx cplusg) c_pb) (cop (cfv cnx cmulr) c_xp)) (ctp (cop (cfv cnx csca) R) (cop (cfv cnx cvsca) c_xb) (cop (cfv cnx cts) J)))) $;

--| The multivariate power series structure is a function. (Contributed by Mario Carneiro, 8-Feb-2015.)
theorem psrvalstr (B2 c_pl R c_x c_xp J: class):
  $ wbr (cun (ctp (cop (cfv cnx cbs) B2) (cop (cfv cnx cplusg) c_pl) (cop (cfv cnx cmulr) c_xp)) (ctp (cop (cfv cnx csca) R) (cop (cfv cnx cvsca) c_x) (cop (cfv cnx cts) J))) (cop c1 c9) cstr $;

--| Elementhood in the set of finite bags. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem psrbag {f2: setvar} (D: class f2) (F I: class) (V: class f2):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi (wcel I V) (wb (wcel F D) (wa (wf I cn0 F) (wcel (cima (ccnv F) cn) cfn))) $;

--| A finite bag is a function. (Contributed by Mario Carneiro, 29-Dec-2014.) Remove a sethood antecedent. (Revised by SN, 30-Jul-2024.)
theorem psrbagf {f2: setvar} (D: class f2) (F I: class):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi (wcel F D) (wf I cn0 F) $;

--| Finite bags have finite support. (Contributed by Stefan O'Rear, 9-Mar-2015.) (Revised by AV, 18-Jul-2019.) Remove a sethood antecedent. (Revised by SN, 7-Aug-2024.)
theorem psrbagfsupp {f2: setvar} (D: class f2) (F I: class):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi (wcel F D) (wbr F cc0 cfsupp) $;

--| A bag containing one element is a finite bag. (Contributed by Mario Carneiro, 7-Jan-2015.) (Revised by AV, 8-Jul-2019.)
theorem snifpsrbag {y1 f2: setvar} (D: class y1 f2) (I N: class) (V: class f2) (X: class):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi (wa (wcel I V) (wcel N cn0)) (wcel (cmpt y1 I (cif (wceq (cv y1) X) N cc0)) D) $;

--| The constant function equal to zero is a finite bag. (Contributed by AV, 8-Jul-2019.)
theorem fczpsrbag {x3 f2: setvar} (D: class x3 f2) (I: class) (V: class f2):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi (wcel I V) (wcel (cmpt x3 I cc0) D) $;

--| The support of a dominated bag is smaller than the dominating bag. (Contributed by Mario Carneiro, 29-Dec-2014.) Remove a sethood antecedent. (Revised by SN, 5-Aug-2024.)
theorem psrbaglesupp {f2: setvar} (D: class f2) (F: class) (G: class f2) (I: class):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi (w3a (wcel F D) (wf I cn0 G) (wbr G F (cofr cle))) (wss (cima (ccnv G) cn) (cima (ccnv F) cn)) $;

--| The set of finite bags is downward-closed. (Contributed by Mario Carneiro, 29-Dec-2014.) Remove a sethood antecedent. (Revised by SN, 5-Aug-2024.)
theorem psrbaglecl {f2: setvar} (D: class f2) (F G I: class):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi (w3a (wcel F D) (wf I cn0 G) (wbr G F (cofr cle))) (wcel G D) $;

--| The sum of two finite bags is a finite bag. (Contributed by Mario Carneiro, 9-Jan-2015.) Shorten proof and remove a sethood antecedent. (Revised by SN, 7-Aug-2024.)
theorem psrbagaddcl {f2: setvar} (D: class f2) (F G I: class):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi (wa (wcel F D) (wcel G D)) (wcel (co F G (cof caddc)) D) $;

--| The analogue of the statement " ` 0 <_ G <_ F ` implies ` 0 <_ F - G <_ F ` " for finite bags. (Contributed by Mario Carneiro, 29-Dec-2014.) Remove a sethood antecedent. (Revised by SN, 5-Aug-2024.)
theorem psrbagcon {f2: setvar} (D: class f2) (F G I: class):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi (w3a (wcel F D) (wf I cn0 G) (wbr G F (cofr cle))) (wa (wcel (co F G (cof cmin)) D) (wbr (co F G (cof cmin)) F (cofr cle))) $;

--| There are finitely many bags dominated by a given bag. (Contributed by Mario Carneiro, 29-Dec-2014.) (Revised by Mario Carneiro, 25-Jan-2015.) Remove a sethood antecedent. (Revised by SN, 5-Aug-2024.)
theorem psrbaglefi {y1 f2: setvar} (D: class f2) (F I: class):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi (wcel F D) (wcel (crab y1 (wbr (cv y1) F (cofr cle)) D) cfn) $;

--| The complement of a bag is a bag. (Contributed by Mario Carneiro, 29-Dec-2014.) Remove a sethood antecedent. (Revised by SN, 6-Aug-2024.)
theorem psrbagconcl {y1 f2: setvar} (D: class f2) (S: class y1 f2) (F: class) (I: class y1) (X: class):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq S (crab y1 (wbr (cv y1) F (cofr cle)) D) $ >
  $ wi (wa (wcel F D) (wcel X S)) (wcel (co F X (cof cmin)) S) $;

--| The analogue of " ` X <_ F ` implies ` X + G <_ F + G ` " (compare ~ leadd1d ) for bags. (Contributed by SN, 2-May-2025.)
theorem psrbagleadd1 {y1 z f2: setvar} (D: class f2) (S T: class y1 z f2) (F: class) (G: class y1) (I: class y1 z) (X: class):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq S (crab y1 (wbr (cv y1) F (cofr cle)) D) $ >
  $ wceq T (crab z (wbr (cv z) (co F G (cof caddc)) (cofr cle)) D) $ >
  $ wi (w3a (wcel F D) (wcel G D) (wcel X S)) (wcel (co X G (cof caddc)) T) $;

--| The analogue of " ` X <_ F ` implies ` X + G <_ F + G ` " (compare ~ leadd1d ) for bags. (Contributed by SN, 2-May-2025.)
theorem psrbagleadd1_b {y1 f2: setvar} (D: class f2) (S T: class y1 f2) (F G: class) (I: class y1) (X: class):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq S (crab y1 (wbr (cv y1) F (cofr cle)) D) $ >
  $ wceq T (crab y1 (wbr (cv y1) (co F G (cof caddc)) (cofr cle)) D) $ >
  $ wi (w3a (wcel F D) (wcel G D) (wcel X S)) (wcel (co X G (cof caddc)) T) $;

--| Bag complementation is a bijection on the set of bags dominated by a given bag ` F ` . (Contributed by Mario Carneiro, 29-Dec-2014.) Remove a sethood antecedent. (Revised by SN, 6-Aug-2024.)
theorem psrbagconf1o {x3 y1 f2: setvar} (D: class f2) (S: class y1 f2) (F: class) (I: class y1):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq S (crab y1 (wbr (cv y1) F (cofr cle)) D) $ >
  $ wi (wcel F D) (wf1o S S (cmpt x3 S (co F (cv x3) (cof cmin)))) $;

--| Restrict a bag of variables in ` I ` to a bag of variables in ` J C_ I ` . (Contributed by SN, 10-Mar-2025.)
theorem psrbagres {g2 h: setvar} (ph: wff g2 h) (D E: class g2 h) (F: class) (I: class g2) (J: class h) (V: class g2 h):
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq E (crab g2 (wcel (cima (ccnv (cv g2)) cn) cfn) (co cn0 J cmap)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wss J I) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wcel (cres F J) E) $;

--| Lemma for ~ gsumbagdiag . (Contributed by Mario Carneiro, 5-Jan-2015.) Remove a sethood hypothesis. (Revised by SN, 6-Aug-2024.)
theorem gsumbagdiaglem {x3 y1 f2: setvar} (ph: wff x3 y1 f2) (D: class f2) (S: class x3 y1 f2) (F: class) (I: class x3 y1) (X Y: class):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq S (crab y1 (wbr (cv y1) F (cofr cle)) D) $ >
  $ wi ph (wcel F D) $ >
  $ wi (wa ph (wa (wcel X S) (wcel Y (crab x3 (wbr (cv x3) (co F X (cof cmin)) (cofr cle)) D)))) (wa (wcel Y S) (wcel X (crab x3 (wbr (cv x3) (co F Y (cof cmin)) (cofr cle)) D))) $;

--| Two-dimensional commutation of a group sum over a "triangular" region. ~ fsum0diag analogue for finite bags. (Contributed by Mario Carneiro, 5-Jan-2015.) Remove a sethood hypothesis. (Revised by SN, 6-Aug-2024.)
theorem gsumbagdiag {x3 y1 f2 j k: setvar} (ph: wff x3 y1 f2) (B2: class x3 y1 f2) (D: class f2) (S: class x3 y1 f2) (F: class) (G: class x3 y1 f2) (I: class x3 j k) (X: class j k):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq S (crab y1 (wbr (cv y1) F (cofr cle)) D) $ >
  $ wi ph (wcel F D) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wi ph (wcel G ccmn) $ >
  $ wi (wa ph (wa (wcel (cv j) S) (wcel (cv k) (crab x3 (wbr (cv x3) (co F (cv j) (cof cmin)) (cofr cle)) D)))) (wcel X B2) $ >
  $ wi ph (wceq (co G (cmpo j k S (crab x3 (wbr (cv x3) (co F (cv j) (cof cmin)) (cofr cle)) D) X) cgsu) (co G (cmpo k j S (crab x3 (wbr (cv x3) (co F (cv k) (cof cmin)) (cofr cle)) D) X) cgsu)) $;

--| A group sum commutation used by ~ psrass1 . (Contributed by Mario Carneiro, 5-Jan-2015.) Remove a sethood hypothesis. (Revised by SN, 7-Aug-2024.)
theorem psrass1lem {x3 y1 f2 j k n: setvar} (ph: wff x3 y1 f2 n) (B2: class x3 y1 f2 n) (D: class f2) (S: class x3 y1 f2) (F: class) (G: class x3 y1 f2) (I: class j k n) (X: class j k) (Y: class j n):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq S (crab y1 (wbr (cv y1) F (cofr cle)) D) $ >
  $ wi ph (wcel F D) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wi ph (wcel G ccmn) $ >
  $ wi (wa ph (wa (wcel (cv j) S) (wcel (cv k) (crab x3 (wbr (cv x3) (co F (cv j) (cof cmin)) (cofr cle)) D)))) (wcel X B2) $ >
  $ wi (wceq (cv k) (co (cv n) (cv j) (cof cmin))) (wceq X Y) $ >
  $ wi ph (wceq (co G (cmpt n S (co G (cmpt j (crab x3 (wbr (cv x3) (cv n) (cofr cle)) D) Y) cgsu)) cgsu) (co G (cmpt j S (co G (cmpt k (crab x3 (wbr (cv x3) (co F (cv j) (cof cmin)) (cofr cle)) D) X) cgsu)) cgsu)) $;

--| The base set of the multivariate power series structure. (Contributed by Mario Carneiro, 28-Dec-2014.) (Revised by Mario Carneiro, 2-Oct-2015.) (Proof shortened by AV, 8-Jul-2019.)
theorem psrbas {f2: setvar} (ph: wff f2) (B2 D R S: class f2) (I: class) (K V: class f2):
  $ wceq S (co I R cmps) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wceq B2 (co K D cmap)) $;

--| An element of the set of power series is a function on the coefficients. (Contributed by Mario Carneiro, 28-Dec-2014.)
theorem psrelbas {f2: setvar} (ph: wff f2) (B2 D R S: class f2) (I: class) (K X: class f2):
  $ wceq S (co I R cmps) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wf D K X) $;

--| An element of the set of power series is a function. (Contributed by AV, 17-Jul-2019.)
theorem psrelbasfun (B2 R S I X: class):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi (wcel X B2) (wfun X) $;

--| The addition operation of the multivariate power series structure. (Contributed by Mario Carneiro, 28-Dec-2014.) (Revised by Mario Carneiro, 2-Oct-2015.)
theorem psrplusg (B2 c_pl c_pb R S I: class):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_pb (cfv S cplusg) $ >
  $ wceq c_pb (cres (cof c_pl) (cxp B2 B2)) $;

--| The addition operation of the multivariate power series structure. (Contributed by Mario Carneiro, 28-Dec-2014.)
theorem psradd (ph: wff) (B2 c_pl c_pb R S I X Y: class):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_pb (cfv S cplusg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co X Y c_pb) (co X Y (cof c_pl))) $;

--| Closure of the power series addition operation. (Contributed by Mario Carneiro, 28-Dec-2014.) Generalize to magmas. (Revised by SN, 12-Apr-2025.)
theorem psraddcl (ph: wff) (B2 c_pl R S I X Y: class):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wi ph (wcel R cmgm) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel (co X Y c_pl) B2) $;

--| Lemma for ~ rhmpsr et al. (Contributed by SN, 8-Feb-2025.)
theorem rhmpsrlem1 {x3 y1 f2: setvar} (ph: wff y1 f2) (D: class f2) (R: class x3 y1 f2) (k: setvar) (I: class x3) (X Y: class x3 y1 f2):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wf D (cfv R cbs) X) $ >
  $ wi ph (wf D (cfv R cbs) Y) $ >
  $ wi (wa ph (wcel (cv k) D)) (wbr (cmpt x3 (crab y1 (wbr (cv y1) (cv k) (cofr cle)) D) (co (cfv (cv x3) X) (cfv (co (cv k) (cv x3) (cof cmin)) Y) (cfv R cmulr))) (cfv R c0g) cfsupp) $;

--| Lemma for ~ rhmpsr et al. (Contributed by SN, 8-Feb-2025.)
theorem rhmpsrlem2 {x3 y1 f2: setvar} (ph: wff y1 f2) (D: class f2) (R: class y1 f2) (k: setvar) (I: class x3) (X Y: class x3 y1 f2):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wf D (cfv R cbs) X) $ >
  $ wi ph (wf D (cfv R cbs) Y) $ >
  $ wi (wa ph (wcel (cv k) D)) (wcel (co R (cmpt x3 (crab y1 (wbr (cv y1) (cv k) (cofr cle)) D) (co (cfv (cv x3) X) (cfv (co (cv k) (cv x3) (cof cmin)) Y) (cfv R cmulr))) cgsu) (cfv R cbs)) $;

--| The multiplication operation of the multivariate power series structure. (Contributed by Mario Carneiro, 28-Dec-2014.) (Revised by Mario Carneiro, 2-Oct-2015.) (Proof shortened by AV, 2-Mar-2024.)
theorem psrmulr {x3 y1 f2 g2 h k: setvar} (B2: class y1 h) (D: class h) (R: class y1 h) (S c_xb: class x3 y1 f2 g2 h k) (c_x: class y1 h) (I: class):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_xb (cfv S cmulr) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_xb (cmpo f2 g2 B2 B2 (cmpt k D (co R (cmpt x3 (crab y1 (wbr (cv y1) (cv k) (cofr cle)) D) (co (cfv (cv x3) (cv f2)) (cfv (co (cv k) (cv x3) (cof cmin)) (cv g2)) c_x)) cgsu))) $;

--| The multiplication operation of the multivariate power series structure. (Contributed by Mario Carneiro, 28-Dec-2014.)
theorem psrmulfval {x3 y1 h k: setvar} (ph: wff y1 h) (B2: class y1 h) (D: class h) (R: class y1 h) (S c_xb: class x3 y1 h k) (c_x F G: class y1 h) (I: class):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_xb (cfv S cmulr) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wi ph (wceq (co F G c_xb) (cmpt k D (co R (cmpt x3 (crab y1 (wbr (cv y1) (cv k) (cofr cle)) D) (co (cfv (cv x3) F) (cfv (co (cv k) (cv x3) (cof cmin)) G) c_x)) cgsu))) $;

--| The multiplication operation of the multivariate power series structure. (Contributed by Mario Carneiro, 28-Dec-2014.)
theorem psrmulval {y1 h k: setvar} (ph: wff y1 h) (B2: class y1 h) (D: class h) (R: class y1 h) (S c_xb: class y1 h k) (c_x F G: class y1 h) (I: class) (X: class h):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_xb (cfv S cmulr) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wi ph (wcel X D) $ >
  $ wi ph (wceq (cfv X (co F G c_xb)) (co R (cmpt k (crab y1 (wbr (cv y1) X (cofr cle)) D) (co (cfv (cv k) F) (cfv (co X (cv k) (cof cmin)) G) c_x)) cgsu)) $;

--| Closure of the power series multiplication operation. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem psrmulcllem {f2: setvar} (ph: wff f2) (B2 D R S c_x: class f2) (I: class) (X Y: class f2):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel (co X Y c_x) B2) $;

--| Closure of the power series multiplication operation. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem psrmulcl (ph: wff) (B2 R S c_x I X Y: class):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel (co X Y c_x) B2) $;

--| The scalar field of the multivariate power series structure. (Contributed by Mario Carneiro, 28-Dec-2014.)
theorem psrsca (ph: wff) (R S I V W: class):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wi ph (wceq R (cfv S csca)) $;

--| The scalar multiplication operation of the multivariate power series structure. (Contributed by Mario Carneiro, 28-Dec-2014.) (Revised by Mario Carneiro, 2-Oct-2015.) (Proof shortened by AV, 2-Nov-2024.)
theorem psrvscafval {x3 f2 h: setvar} (B2 D R: class h) (S: class x3 f2 h) (c_xb c_x: class h) (I: class) (K: class h):
  $ wceq S (co I R cmps) $ >
  $ wceq c_xb (cfv S cvsca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_xb (cmpo x3 f2 K B2 (co (cxp D (csn (cv x3))) (cv f2) (cof c_x))) $;

--| The scalar multiplication operation of the multivariate power series structure. (Contributed by Mario Carneiro, 28-Dec-2014.)
theorem psrvsca {h: setvar} (ph: wff h) (B2 D R S c_xb c_x F: class h) (I: class) (K X: class h):
  $ wceq S (co I R cmps) $ >
  $ wceq c_xb (cfv S cvsca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wceq (co X F c_xb) (co (cxp D (csn X)) F (cof c_x))) $;

--| The scalar multiplication operation of the multivariate power series structure. (Contributed by Mario Carneiro, 28-Dec-2014.)
theorem psrvscaval {h: setvar} (ph: wff h) (B2 D R S c_xb c_x F: class h) (I: class) (K X Y: class h):
  $ wceq S (co I R cmps) $ >
  $ wceq c_xb (cfv S cvsca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel Y D) $ >
  $ wi ph (wceq (cfv Y (co X F c_xb)) (co X (cfv Y F) c_x)) $;

--| Closure of the power series scalar multiplication operation. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem psrvscacl (ph: wff) (B2 R S c_x F I K X: class):
  $ wceq S (co I R cmps) $ >
  $ wceq c_x (cfv S cvsca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel (co X F c_x) B2) $;

--| The zero element of the ring of power series. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem psr0cl {f2: setvar} (ph: wff f2) (B2 D R S: class f2) (I: class) (V c_0: class f2):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel (cxp D (csn c_0)) B2) $;

--| The zero element of the ring of power series is a left identity. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem psr0lid {f2: setvar} (ph: wff f2) (B2 D c_pl R S: class f2) (I: class) (V X c_0: class f2):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (co (cxp D (csn c_0)) X c_pl) X) $;

--| The negative function in the ring of power series. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem psrnegcl {f2: setvar} (ph: wff f2) (B2 D R S: class f2) (I: class) (N V X: class f2):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel (ccom N X) B2) $;

--| The negative function in the ring of power series. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem psrlinv {f2: setvar} (ph: wff f2) (B2 D c_pl R S: class f2) (I: class) (N V X c_0: class f2):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wi ph (wceq (co (ccom N X) X c_pl) (cxp D (csn c_0))) $;

--| The ring of power series is a group. (Contributed by Mario Carneiro, 29-Dec-2014.) (Proof shortened by SN, 7-Feb-2025.)
theorem psrgrp (ph: wff) (R S I V: class):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wi ph (wcel S cgrp) $;

--| The zero element of the ring of power series. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem psr0 {f2: setvar} (ph: wff f2) (D R S: class f2) (I: class) (O V c_0: class f2):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq O (cfv R c0g) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wi ph (wceq c_0 (cxp D (csn O))) $;

--| The negative function of the ring of power series. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem psrneg {f2: setvar} (ph: wff f2) (B2 D R S: class f2) (I: class) (M N V X: class f2):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq M (cfv S cminusg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cfv X M) (ccom N X)) $;

--| The ring of power series is a left module. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem psrlmod (ph: wff) (R S I V: class):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel S clmod) $;

--| The identity element of the ring of power series. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem psr1cl {x3 f2: setvar} (ph: wff f2) (B2 D: class f2) (R: class) (S: class f2) (U: class x3 f2) (c_1: class f2) (I: class) (V: class f2) (c_0: class):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq U (cmpt x3 D (cif (wceq (cv x3) (cxp I (csn cc0))) c_1 c_0)) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel U B2) $;

--| The identity element of the ring of power series is a left identity. (Contributed by Mario Carneiro, 29-Dec-2014.) (Proof shortened by AV, 8-Jul-2019.)
theorem psrlidm {x3 f2: setvar} (ph: wff f2) (B2 D: class f2) (R: class) (S c_x: class f2) (U: class x3 f2) (c_1: class f2) (I: class) (V: class f2) (X c_0: class):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq U (cmpt x3 D (cif (wceq (cv x3) (cxp I (csn cc0))) c_1 c_0)) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (co U X c_x) X) $;

--| The identity element of the ring of power series is a right identity. (Contributed by Mario Carneiro, 29-Dec-2014.) (Proof shortened by AV, 8-Jul-2019.)
theorem psrridm {x3 f2: setvar} (ph: wff f2) (B2 D: class f2) (R: class) (S c_x: class f2) (U: class x3 f2) (c_1: class f2) (I: class) (V: class f2) (X c_0: class):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq U (cmpt x3 D (cif (wceq (cv x3) (cxp I (csn cc0))) c_1 c_0)) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (co X U c_x) X) $;

--| Associative identity for the ring of power series. (Contributed by Mario Carneiro, 5-Jan-2015.)
theorem psrass1 {f2: setvar} (ph: wff f2) (B2 D: class f2) (R: class) (S c_xp: class f2) (I: class) (V: class f2) (X Y Z: class):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_xp (cfv S cmulr) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wceq (co (co X Y c_xp) Z c_xp) (co X (co Y Z c_xp) c_xp)) $;

--| Distributive law for the ring of power series (left-distributivity). (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem psrdi {f2: setvar} (ph: wff f2) (B2 D c_pl: class f2) (R: class) (S c_xp: class f2) (I: class) (V: class f2) (X Y Z: class):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_xp (cfv S cmulr) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wi ph (wceq (co X (co Y Z c_pl) c_xp) (co (co X Y c_xp) (co X Z c_xp) c_pl)) $;

--| Distributive law for the ring of power series (right-distributivity). (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem psrdir {f2: setvar} (ph: wff f2) (B2 D c_pl: class f2) (R: class) (S c_xp: class f2) (I: class) (V: class f2) (X Y Z: class):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_xp (cfv S cmulr) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wi ph (wceq (co (co X Y c_pl) Z c_xp) (co (co X Z c_xp) (co Y Z c_xp) c_pl)) $;

--| Associative identity for the ring of power series. Part of ~ psrass23 which does not require the scalar ring to be commutative. (Contributed by Mario Carneiro, 7-Jan-2015.) (Revised by AV, 14-Aug-2019.)
theorem psrass23l {f2: setvar} (ph: wff f2) (A2 B2 D: class f2) (R: class) (S c_x c_xp: class f2) (I: class) (K V: class f2) (X Y: class):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_xp (cfv S cmulr) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_x (cfv S cvsca) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wceq (co (co A2 X c_x) Y c_xp) (co A2 (co X Y c_xp) c_x)) $;

--| Commutative law for the ring of power series. (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem psrcom {f2: setvar} (ph: wff f2) (B2 D: class f2) (R: class) (S c_xp: class f2) (I: class) (V: class f2) (X Y: class):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_xp (cfv S cmulr) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wceq (co X Y c_xp) (co Y X c_xp)) $;

--| Associative identities for the ring of power series. (Contributed by Mario Carneiro, 7-Jan-2015.) (Proof shortened by AV, 25-Nov-2019.)
theorem psrass23 {f2: setvar} (ph: wff f2) (A2 B2 D: class f2) (R: class) (S c_x c_xp: class f2) (I: class) (K V: class f2) (X Y: class):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_xp (cfv S cmulr) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_x (cfv S cvsca) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wa (wceq (co (co A2 X c_x) Y c_xp) (co A2 (co X Y c_xp) c_x)) (wceq (co X (co A2 Y c_x) c_xp) (co A2 (co X Y c_xp) c_x))) $;

--| The ring of power series is a ring. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem psrring (ph: wff) (R S I V: class):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel S crg) $;

--| The identity element of the ring of power series. (Contributed by Mario Carneiro, 8-Jan-2015.)
theorem psr1 {x3 f2: setvar} (ph: wff f2) (D: class f2) (R: class) (S: class f2) (U: class x3 f2) (c_1: class f2) (I: class) (V: class f2) (c_0: class):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq U (cfv S cur) $ >
  $ wi ph (wceq U (cmpt x3 D (cif (wceq (cv x3) (cxp I (csn cc0))) c_1 c_0))) $;

--| The ring of power series is commutative ring. (Contributed by Mario Carneiro, 10-Jan-2015.)
theorem psrcrng (ph: wff) (R S I V: class):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S ccrg) $;

--| The ring of power series is an associative algebra. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem psrassa (ph: wff) (R S I V: class):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S casa) $;

--| A restricted power series algebra has the same base set. (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem resspsrbas (ph: wff) (B2 P R S T U H I: class):
  $ wceq S (co I R cmps) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (co I H cmps) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wceq P (co S B2 cress) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wi ph (wceq B2 (cfv P cbs)) $;

--| A restricted power series algebra has the same addition operation. (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem resspsradd (ph: wff) (B2 P R S T U H I X Y: class):
  $ wceq S (co I R cmps) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (co I H cmps) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wceq P (co S B2 cress) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wi (wa ph (wa (wcel X B2) (wcel Y B2))) (wceq (co X Y (cfv U cplusg)) (co X Y (cfv P cplusg))) $;

--| A restricted power series algebra has the same multiplication operation. (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem resspsrmul (ph: wff) (B2 P R S T U H I X Y: class):
  $ wceq S (co I R cmps) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (co I H cmps) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wceq P (co S B2 cress) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wi (wa ph (wa (wcel X B2) (wcel Y B2))) (wceq (co X Y (cfv U cmulr)) (co X Y (cfv P cmulr))) $;

--| A restricted power series algebra has the same scalar multiplication operation. (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem resspsrvsca (ph: wff) (B2 P R S T U H I X Y: class):
  $ wceq S (co I R cmps) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (co I H cmps) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wceq P (co S B2 cress) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wi (wa ph (wa (wcel X T) (wcel Y B2))) (wceq (co X Y (cfv U cvsca)) (co X Y (cfv P cvsca))) $;

--| A subring of the base ring induces a subring of power series. (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem subrgpsr (B2 R S T U H I V: class):
  $ wceq S (co I R cmps) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (co I H cmps) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi (wa (wcel I V) (wcel T (cfv R csubrg))) (wcel B2 (cfv S csubrg)) $;

--| Value of the scalar injection into the power series algebra. (Contributed by SN, 18-May-2025.)
theorem psrascl {y1 f2: setvar} (ph: wff f2) (A2: class y1 f2) (D: class f2) (R: class) (S: class f2) (I: class y1) (K V: class y1 f2) (X: class f2) (c_0: class y1):
  $ wceq S (co I R cmps) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (cfv S cascl) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wceq (cfv X A2) (cmpt y1 D (cif (wceq (cv y1) (cxp I (csn cc0))) X c_0))) $;

--| A scalar is lifted into a member of the power series. (Contributed by SN, 25-Apr-2025.)
theorem psrasclcl (ph: wff) (A2 B2 C R S I K W: class):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (cfv S cascl) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wcel (cfv C A2) B2) $;

--| Value of the generating elements of the power series structure. (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem mvrfval {x3 y1 f2 h: setvar} (ph: wff x3 y1 f2 h) (D: class h) (R c_1: class y1 h) (I: class) (V: class x3 y1 f2 h) (W: class x3 f2 h) (Y: class x3 y1 f2 h) (c_0: class y1 h):
  $ wceq V (co I R cmvr) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R Y) $ >
  $ wi ph (wceq V (cmpt x3 I (cmpt f2 D (cif (wceq (cv f2) (cmpt y1 I (cif (wceq (cv y1) (cv x3)) c1 cc0))) c_1 c_0)))) $;

--| Value of the generating elements of the power series structure. (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem mvrval {y1 f2 h: setvar} (ph: wff y1 f2 h) (D: class h) (R c_1: class y1 h) (I: class) (V: class y1 f2 h) (W: class f2 h) (X: class) (Y: class y1 f2 h) (c_0: class y1 h):
  $ wceq V (co I R cmvr) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R Y) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wceq (cfv X V) (cmpt f2 D (cif (wceq (cv f2) (cmpt y1 I (cif (wceq (cv y1) X) c1 cc0))) c_1 c_0))) $;

--| Value of the generating elements of the power series structure. (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem mvrval2 {y1 h: setvar} (ph: wff y1 h) (D: class h) (R c_1 F: class y1 h) (I: class) (V: class y1 h) (W: class h) (X: class) (Y c_0: class y1 h):
  $ wceq V (co I R cmvr) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R Y) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wceq (cfv F (cfv X V)) (cif (wceq F (cmpt y1 I (cif (wceq (cv y1) X) c1 cc0))) c_1 c_0)) $;

--| The ` X i ` -th coefficient of the term ` X i ` is ` 1 ` . (Contributed by Mario Carneiro, 7-Jan-2015.)
theorem mvrid {y1 h: setvar} (ph: wff y1 h) (D: class h) (R c_1: class y1 h) (I: class) (V: class y1 h) (W: class h) (X: class) (Y c_0: class y1 h):
  $ wceq V (co I R cmvr) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R Y) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wceq (cfv (cmpt y1 I (cif (wceq (cv y1) X) c1 cc0)) (cfv X V)) c_1) $;

--| The power series variable function is a function from the index set to elements of the power series structure representing ` X i ` for each ` i ` . (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem mvrf (ph: wff) (B2 R S I V W: class):
  $ wceq S (co I R cmps) $ >
  $ wceq V (co I R cmvr) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wf I B2 V) $;

--| The power series variable function is injective if the base ring is nonzero. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem mvrf1 (ph: wff) (B2 R S c_1 I V W c_0: class):
  $ wceq S (co I R cmps) $ >
  $ wceq V (co I R cmvr) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wne c_1 c_0) $ >
  $ wi ph (wf1 I B2 V) $;

--| A power series variable is an element of the base set. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem mvrcl2 (ph: wff) (B2 R S I V W X: class):
  $ wceq S (co I R cmps) $ >
  $ wceq V (co I R cmvr) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel (cfv X V) B2) $;

--| The multivariate polynomial constructor is a proper binary operator. (Contributed by Mario Carneiro, 21-Mar-2015.)
theorem reldmmpl:
  $ wrel (cdm cmpl) $;

--| Value of the set of multivariate polynomials. (Contributed by Mario Carneiro, 7-Jan-2015.) (Revised by Mario Carneiro, 2-Oct-2015.) (Revised by AV, 25-Jun-2019.)
theorem mplval {f2: setvar} (B2: class) (P: class f2) (R: class) (S U: class f2) (I c_0: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq U (crab f2 (wbr (cv f2) c_0 cfsupp) B2) $ >
  $ wceq P (co S U cress) $;

--| Base set of the set of multivariate polynomials. (Contributed by Mario Carneiro, 7-Jan-2015.) (Revised by Mario Carneiro, 2-Oct-2015.) (Revised by AV, 25-Jun-2019.)
theorem mplbas {f2: setvar} (B2: class) (P: class f2) (R: class) (S U: class f2) (I c_0: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq U (crab f2 (wbr (cv f2) c_0 cfsupp) B2) $;

--| Property of being a polynomial. (Contributed by Mario Carneiro, 7-Jan-2015.) (Revised by Mario Carneiro, 2-Oct-2015.) (Revised by AV, 25-Jun-2019.)
theorem mplelbas (B2 P R S U I X c_0: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq U (cfv P cbs) $ >
  $ wb (wcel X U) (wa (wcel X B2) (wbr X c_0 cfsupp)) $;

--| A power series variable is a polynomial. (Contributed by Mario Carneiro, 9-Jan-2015.)
theorem mvrcl (ph: wff) (B2 P R I V W X: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq V (co I R cmvr) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel (cfv X V) B2) $;

--| The power series/polynomial variable function maps indices to polynomials. (Contributed by Stefan O'Rear, 8-Mar-2015.)
theorem mvrf2 (ph: wff) (B2 P R I V W: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq V (co I R cmvr) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wf I B2 V) $;

--| Reverse closure for the polynomial index set. (Contributed by Stefan O'Rear, 19-Mar-2015.) (Revised by Mario Carneiro, 30-Aug-2015.)
theorem mplrcl (B2 P R I X: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi (wcel X B2) (wcel I cvv) $;

--| A polynomial treated as a coefficient function has finitely many nonzero terms. (Contributed by Stefan O'Rear, 22-Mar-2015.) (Revised by AV, 25-Jun-2019.)
theorem mplelsfi (ph: wff) (B2 P R F I c_0: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wbr F c_0 cfsupp) $;

--| Self-referential expression for the set of multivariate polynomials. (Contributed by Mario Carneiro, 7-Jan-2015.) (Revised by Mario Carneiro, 2-Oct-2015.)
theorem mplval2 (P R S U I: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq S (co I R cmps) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq P (co S U cress) $;

--| The set of polynomials is a subset of the set of power series. (Contributed by Mario Carneiro, 7-Jan-2015.) (Revised by Mario Carneiro, 2-Oct-2015.)
theorem mplbasss (B2 P R S U I: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq S (co I R cmps) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wss U B2 $;

--| A polynomial is defined as a function on the coefficients. (Contributed by Mario Carneiro, 7-Jan-2015.) (Revised by Mario Carneiro, 2-Oct-2015.)
theorem mplelf {f2: setvar} (ph: wff f2) (B2 D P R: class f2) (I: class) (K X: class f2):
  $ wceq P (co I R cmpl) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wf D K X) $;

--| If ` A ` is an ideal of sets (a nonempty collection closed under subset and binary union) of the set ` D ` of finite bags (the primary applications being ` A = Fin ` and ` A = ~P B ` for some ` B ` ), then the set of all power series whose coefficient functions are supported on an element of ` A ` is a subgroup of the set of all power series. (Contributed by Mario Carneiro, 12-Jan-2015.) (Revised by AV, 16-Jul-2019.)
theorem mplsubglem {x3 y1 f2 g2: setvar} (ph: wff f2 g2) (A2: class) (B2: class x3 y1) (D: class x3 y1 f2) (R: class x3 y1 f2 g2) (S: class x3) (U: class x3 y1 f2 g2) (I: class x3 y1 g2) (W: class x3 y1 f2 g2) (c_0: class):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel c0 A2) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) A2))) (wcel (cun (cv x3) (cv y1)) A2) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wss (cv y1) (cv x3)))) (wcel (cv y1) A2) $ >
  $ wi ph (wceq U (crab g2 (wcel (co (cv g2) c_0 csupp) A2) B2)) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wi ph (wcel U (cfv S csubg)) $;

--| If ` A ` is an ideal of subsets (a nonempty collection closed under subset and binary union) of the set ` D ` of finite bags (the primary applications being ` A = Fin ` and ` A = ~P B ` for some ` B ` ), then the set of all power series whose coefficient functions are supported on an element of ` A ` is a linear subspace of the set of all power series. (Contributed by Mario Carneiro, 12-Jan-2015.) (Revised by AV, 16-Jul-2019.)
theorem mpllsslem {x3 y1 f2 g2: setvar} (ph: wff f2 g2) (A2: class) (B2: class x3 y1) (D: class x3 y1 f2) (R: class x3 y1 f2 g2) (S: class x3) (U: class x3 y1 f2 g2) (I: class x3 y1 g2) (W: class x3 y1 f2 g2) (c_0: class):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel c0 A2) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) A2))) (wcel (cun (cv x3) (cv y1)) A2) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wss (cv y1) (cv x3)))) (wcel (cv y1) A2) $ >
  $ wi ph (wceq U (crab g2 (wcel (co (cv g2) c_0 csupp) A2) B2)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel U (cfv S clss)) $;

--| Lemma for ~ mplsubg and ~ mpllss . (Contributed by AV, 16-Jul-2019.)
theorem mplsubglem2 {g2: setvar} (ph: wff) (P: class g2) (R S: class) (U: class g2) (I: class) (W: class g2):
  $ wceq S (co I R cmps) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wceq U (crab g2 (wcel (co (cv g2) (cfv R c0g) csupp) cfn) (cfv S cbs))) $;

--| The set of polynomials is closed under addition, i.e. it is a subgroup of the set of power series. (Contributed by Mario Carneiro, 8-Jan-2015.) (Proof shortened by AV, 16-Jul-2019.)
theorem mplsubg (ph: wff) (P R S U I W: class):
  $ wceq S (co I R cmps) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wi ph (wcel U (cfv S csubg)) $;

--| The set of polynomials is closed under scalar multiplication, i.e. it is a linear subspace of the set of power series. (Contributed by Mario Carneiro, 7-Jan-2015.) (Proof shortened by AV, 16-Jul-2019.)
theorem mpllss (ph: wff) (P R S U I W: class):
  $ wceq S (co I R cmps) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel U (cfv S clss)) $;

--| Lemma for ~ mplsubrg . (Contributed by Mario Carneiro, 9-Jan-2015.) (Revised by AV, 18-Jul-2019.)
theorem mplsubrglem {f2: setvar} (ph: wff f2) (A2 D P: class f2) (R S: class) (c_x U: class f2) (I: class) (W: class f2) (X Y c_0: class):
  $ wceq S (co I R cmps) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq A2 (cima (cof caddc) (cxp (co X c_0 csupp) (co Y c_0 csupp))) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel X U) $ >
  $ wi ph (wcel Y U) $ >
  $ wi ph (wcel (co X Y (cfv S cmulr)) U) $;

--| The set of polynomials is closed under multiplication, i.e. it is a subring of the set of power series. (Contributed by Mario Carneiro, 9-Jan-2015.)
theorem mplsubrg (ph: wff) (P R S U I W: class):
  $ wceq S (co I R cmps) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel U (cfv S csubrg)) $;

--| The zero polynomial. (Contributed by Mario Carneiro, 9-Jan-2015.)
theorem mpl0 {f2: setvar} (ph: wff f2) (D P R: class f2) (I: class) (O W c_0: class f2):
  $ wceq P (co I R cmpl) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq O (cfv R c0g) $ >
  $ wceq c_0 (cfv P c0g) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wi ph (wceq c_0 (cxp D (csn O))) $;

--| Value of addition in a polynomial ring. (Contributed by Stefan O'Rear, 21-Mar-2015.) (Revised by Mario Carneiro, 2-Oct-2015.)
theorem mplplusg (c_pl R S I Y: class):
  $ wceq Y (co I R cmpl) $ >
  $ wceq S (co I R cmps) $ >
  $ wceq c_pl (cfv Y cplusg) $ >
  $ wceq c_pl (cfv S cplusg) $;

--| Value of multiplication in a polynomial ring. (Contributed by Stefan O'Rear, 21-Mar-2015.) (Revised by Mario Carneiro, 2-Oct-2015.)
theorem mplmulr (R S c_x I Y: class):
  $ wceq Y (co I R cmpl) $ >
  $ wceq S (co I R cmps) $ >
  $ wceq c_x (cfv Y cmulr) $ >
  $ wceq c_x (cfv S cmulr) $;

--| The addition operation on multivariate polynomials. (Contributed by Mario Carneiro, 9-Jan-2015.) (Revised by Mario Carneiro, 2-Oct-2015.)
theorem mpladd (ph: wff) (B2 P c_pl c_pb R I X Y: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_pb (cfv P cplusg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co X Y c_pb) (co X Y (cof c_pl))) $;

--| The negative function on multivariate polynomials. (Contributed by SN, 25-May-2024.)
theorem mplneg (ph: wff) (B2 P R I M N V X: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wceq M (cfv P cminusg) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cfv X M) (ccom N X)) $;

--| The multiplication operation on multivariate polynomials. (Contributed by Mario Carneiro, 9-Jan-2015.)
theorem mplmul {x3 y1 h k: setvar} (ph: wff y1 h) (B2: class x3 y1 h k) (D: class h) (P: class x3 y1 h k) (R: class y1 h) (c_xb: class x3 y1 h k) (c_x F G: class y1 h) (I: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_xb (cfv P cmulr) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wi ph (wceq (co F G c_xb) (cmpt k D (co R (cmpt x3 (crab y1 (wbr (cv y1) (cv k) (cofr cle)) D) (co (cfv (cv x3) F) (cfv (co (cv k) (cv x3) (cof cmin)) G) c_x)) cgsu))) $;

--| The identity element of the ring of polynomials. (Contributed by Mario Carneiro, 10-Jan-2015.)
theorem mpl1 {x3 f2: setvar} (ph: wff f2) (D: class f2) (P: class x3 f2) (R: class) (U: class x3 f2) (c_1: class f2) (I: class) (W: class f2) (c_0: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq U (cfv P cur) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wceq U (cmpt x3 D (cif (wceq (cv x3) (cxp I (csn cc0))) c_1 c_0))) $;

--| The scalar field of a multivariate polynomial structure. (Contributed by Mario Carneiro, 9-Jan-2015.)
theorem mplsca (ph: wff) (P R I V W: class):
  $ wceq P (co I R cmpl) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wi ph (wceq R (cfv P csca)) $;

--| The scalar multiplication operation on multivariate polynomials. (Contributed by Mario Carneiro, 9-Jan-2015.)
theorem mplvsca2 (P R S c_x I: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq S (co I R cmps) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq c_x (cfv S cvsca) $;

--| The scalar multiplication operation on multivariate polynomials. (Contributed by Mario Carneiro, 9-Jan-2015.) (Revised by Mario Carneiro, 2-Oct-2015.)
theorem mplvsca {h: setvar} (ph: wff h) (B2 D P R c_xb c_x F: class h) (I: class) (K X: class h):
  $ wceq P (co I R cmpl) $ >
  $ wceq c_xb (cfv P cvsca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wceq (co X F c_xb) (co (cxp D (csn X)) F (cof c_x))) $;

--| The scalar multiplication operation on multivariate polynomials. (Contributed by Mario Carneiro, 9-Jan-2015.)
theorem mplvscaval {h: setvar} (ph: wff h) (B2 D P R c_xb c_x F: class h) (I: class) (K X Y: class h):
  $ wceq P (co I R cmpl) $ >
  $ wceq c_xb (cfv P cvsca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel Y D) $ >
  $ wi ph (wceq (cfv Y (co X F c_xb)) (co X (cfv Y F) c_x)) $;

--| The polynomial ring is a group. (Contributed by Mario Carneiro, 9-Jan-2015.)
theorem mplgrp (P R I V: class):
  $ wceq P (co I R cmpl) $ >
  $ wi (wa (wcel I V) (wcel R cgrp)) (wcel P cgrp) $;

--| The polynomial ring is a left module. (Contributed by Mario Carneiro, 9-Jan-2015.)
theorem mpllmod (P R I V: class):
  $ wceq P (co I R cmpl) $ >
  $ wi (wa (wcel I V) (wcel R crg)) (wcel P clmod) $;

--| The polynomial ring is a ring. (Contributed by Mario Carneiro, 9-Jan-2015.)
theorem mplring (P R I V: class):
  $ wceq P (co I R cmpl) $ >
  $ wi (wa (wcel I V) (wcel R crg)) (wcel P crg) $;

--| The polynomial ring is a vector space. (Contributed by SN, 29-Feb-2024.)
theorem mpllvec (P R I V: class):
  $ wceq P (co I R cmpl) $ >
  $ wi (wa (wcel I V) (wcel R cdr)) (wcel P clvec) $;

--| The polynomial ring is a commutative ring. (Contributed by Mario Carneiro, 9-Jan-2015.)
theorem mplcrng (P R I V: class):
  $ wceq P (co I R cmpl) $ >
  $ wi (wa (wcel I V) (wcel R ccrg)) (wcel P ccrg) $;

--| The polynomial ring is an associative algebra. (Contributed by Mario Carneiro, 9-Jan-2015.)
theorem mplassa (P R I V: class):
  $ wceq P (co I R cmpl) $ >
  $ wi (wa (wcel I V) (wcel R ccrg)) (wcel P casa) $;

--| The polynomial ring is a ring. (Contributed by SN, 7-Feb-2025.)
theorem mplringd (ph: wff) (P R I V: class):
  $ wceq P (co I R cmpl) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel P crg) $;

--| The polynomial ring is a commutative ring. (Contributed by SN, 7-Feb-2025.)
theorem mplcrngd (ph: wff) (P R I V: class):
  $ wceq P (co I R cmpl) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel P ccrg) $;

--| The polynomial ring is a left module. (Contributed by SN, 12-Mar-2025.)
theorem mpllmodd (ph: wff) (P R I V: class):
  $ wceq P (co I R cmpl) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel P clmod) $;

--| The zero scalar as a polynomial. (Contributed by SN, 23-Nov-2024.)
theorem mplascl0 (ph: wff) (A2 R I O V W c_0: class):
  $ wceq W (co I R cmpl) $ >
  $ wceq A2 (cfv W cascl) $ >
  $ wceq O (cfv R c0g) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wceq (cfv O A2) c_0) $;

--| The one scalar as a polynomial. (Contributed by SN, 12-Mar-2025.)
theorem mplascl1 (ph: wff) (A2 R c_1 I O V W: class):
  $ wceq W (co I R cmpl) $ >
  $ wceq A2 (cfv W cascl) $ >
  $ wceq O (cfv R cur) $ >
  $ wceq c_1 (cfv W cur) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wceq (cfv O A2) c_1) $;

--| The base set of a restricted polynomial algebra consists of power series in the subring which are also polynomials (in the parent ring). (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem ressmplbas2 (ph: wff) (B2 C R S T U H I K V W: class):
  $ wceq S (co I R cmpl) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (co I H cmpl) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq W (co I H cmps) $ >
  $ wceq C (cfv W cbs) $ >
  $ wceq K (cfv S cbs) $ >
  $ wi ph (wceq B2 (cin C K)) $;

--| A restricted polynomial algebra has the same base set. (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem ressmplbas (ph: wff) (B2 P R S T U H I V: class):
  $ wceq S (co I R cmpl) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (co I H cmpl) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq P (co S B2 cress) $ >
  $ wi ph (wceq B2 (cfv P cbs)) $;

--| A restricted polynomial algebra has the same addition operation. (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem ressmpladd (ph: wff) (B2 P R S T U H I V X Y: class):
  $ wceq S (co I R cmpl) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (co I H cmpl) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq P (co S B2 cress) $ >
  $ wi (wa ph (wa (wcel X B2) (wcel Y B2))) (wceq (co X Y (cfv U cplusg)) (co X Y (cfv P cplusg))) $;

--| A restricted polynomial algebra has the same multiplication operation. (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem ressmplmul (ph: wff) (B2 P R S T U H I V X Y: class):
  $ wceq S (co I R cmpl) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (co I H cmpl) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq P (co S B2 cress) $ >
  $ wi (wa ph (wa (wcel X B2) (wcel Y B2))) (wceq (co X Y (cfv U cmulr)) (co X Y (cfv P cmulr))) $;

--| A restricted power series algebra has the same scalar multiplication operation. (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem ressmplvsca (ph: wff) (B2 P R S T U H I V X Y: class):
  $ wceq S (co I R cmpl) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (co I H cmpl) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq P (co S B2 cress) $ >
  $ wi (wa ph (wa (wcel X T) (wcel Y B2))) (wceq (co X Y (cfv U cvsca)) (co X Y (cfv P cvsca))) $;

--| A subring of the base ring induces a subring of polynomials. (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem subrgmpl (B2 R S T U H I V: class):
  $ wceq S (co I R cmpl) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (co I H cmpl) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi (wa (wcel I V) (wcel T (cfv R csubrg))) (wcel B2 (cfv S csubrg)) $;

--| An element of a polynomial algebra over a subring is an element of the polynomial algebra. (Contributed by SN, 9-Feb-2025.)
theorem mplsubrgcl (ph: wff) (B2 C P R S U F I V W: class):
  $ wceq W (co I U cmpl) $ >
  $ wceq U (co S R cress) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq P (co I S cmpl) $ >
  $ wceq C (cfv P cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel F C) $;

--| The variables in a subring polynomial algebra are the same as the original ring. (Contributed by Mario Carneiro, 4-Jul-2015.)
theorem subrgmvr (ph: wff) (R T H I V W: class):
  $ wceq V (co I R cmvr) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq H (co R T cress) $ >
  $ wi ph (wceq V (co I H cmvr)) $;

--| The variables in a polynomial algebra are contained in every subring algebra. (Contributed by Mario Carneiro, 4-Jul-2015.)
theorem subrgmvrf (ph: wff) (B2 R T U H I V W: class):
  $ wceq V (co I R cmvr) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (co I H cmpl) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi ph (wf I B2 V) $;

--| A monomial is a polynomial. (Contributed by Mario Carneiro, 9-Jan-2015.)
theorem mplmon {y1 f2: setvar} (ph: wff f2) (B2: class y1 f2) (D: class f2) (P: class y1 f2) (R c_1: class f2) (I: class y1) (W: class y1 f2) (X: class) (c_0: class f2):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X D) $ >
  $ wi ph (wcel (cmpt y1 D (cif (wceq (cv y1) X) c_1 c_0)) B2) $;

--| The product of two monomials adds the exponent vectors together. For example, the product of ` ( x ^ 2 ) ( y ^ 2 ) ` with ` ( y ^ 1 ) ( z ^ 3 ) ` is ` ( x ^ 2 ) ( y ^ 3 ) ( z ^ 3 ) ` , where the exponent vectors ` <. 2 , 2 , 0 >. ` and ` <. 0 , 1 , 3 >. ` are added to give ` <. 2 , 3 , 3 >. ` . (Contributed by Mario Carneiro, 9-Jan-2015.)
theorem mplmonmul {y1 f2: setvar} (ph: wff f2) (B2: class y1 f2) (D: class f2) (P: class y1 f2) (R: class f2) (c_x: class y1 f2) (c_1: class f2) (I: class y1) (W: class y1 f2) (X Y: class) (c_0: class f2):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X D) $ >
  $ wceq c_x (cfv P cmulr) $ >
  $ wi ph (wcel Y D) $ >
  $ wi ph (wceq (co (cmpt y1 D (cif (wceq (cv y1) X) c_1 c_0)) (cmpt y1 D (cif (wceq (cv y1) Y) c_1 c_0)) c_x) (cmpt y1 D (cif (wceq (cv y1) (co X Y (cof caddc))) c_1 c_0))) $;

--| Decompose a polynomial into a finite sum of monomials. (Contributed by Mario Carneiro, 9-Jan-2015.)
theorem mplcoe1 {y1 f2 k: setvar} (ph: wff f2) (B2: class y1 f2) (D: class f2) (P: class y1 f2) (R: class k) (c_x: class y1 f2) (c_1: class f2) (I: class) (W: class f2) (X c_0: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wcel I W) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq X (co P (cmpt k D (co (cfv (cv k) X) (cmpt y1 D (cif (wceq (cv y1) (cv k)) c_1 c_0)) c_x)) cgsu)) $;

--| Decompose a monomial in one variable into a power of a variable. (Contributed by Mario Carneiro, 7-Jan-2015.) (Proof shortened by AV, 18-Jul-2019.)
theorem mplcoe3 {y1 f2 k: setvar} (ph: wff f2) (D: class f2) (P: class y1 f2) (R: class k) (c_1: class f2) (c_ex G: class y1 f2) (I: class) (N: class f2) (V: class y1 f2) (W: class f2) (X c_0: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wcel I W) $ >
  $ wceq G (cfv P cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wceq V (co I R cmvr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (cmpt y1 D (cif (wceq (cv y1) (cmpt k I (cif (wceq (cv k) X) N cc0))) c_1 c_0)) (co N (cfv X V) c_ex)) $;

--| Lemma for ~ mplcoe4 . (Contributed by AV, 7-Oct-2019.)
theorem mplcoe5lem {x3 y1 f2 k: setvar} (ph: wff f2) (D: class f2) (P: class y1 f2) (R: class x3 k) (S c_1 c_ex G: class f2) (I: class) (V: class f2) (W: class x3 f2) (Y c_0: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wcel I W) $ >
  $ wceq G (cfv P cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wceq V (co I R cmvr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel Y D) $ >
  $ wi ph (wral x3 (wral y1 (wceq (co (cfv (cv y1) V) (cfv (cv x3) V) (cfv G cplusg)) (co (cfv (cv x3) V) (cfv (cv y1) V) (cfv G cplusg))) I) I) $ >
  $ wi ph (wss S I) $ >
  $ wi ph (wss (crn (cmpt k S (co (cfv (cv k) Y) (cfv (cv k) V) c_ex))) (cfv (crn (cmpt k S (co (cfv (cv k) Y) (cfv (cv k) V) c_ex))) (cfv G ccntz))) $;

--| Decompose a monomial into a finite product of powers of variables. Instead of assuming that ` R ` is a commutative ring (as in ~ mplcoe2 ), it is sufficient that ` R ` is a ring and all the variables of the multivariate polynomial commute. (Contributed by AV, 7-Oct-2019.)
theorem mplcoe5 {x3 y1 f2 k: setvar} (ph: wff f2) (D: class f2) (P: class y1 f2) (R: class x3 k) (c_1 c_ex G: class f2) (I: class) (V: class f2) (W: class x3 f2) (Y c_0: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wcel I W) $ >
  $ wceq G (cfv P cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wceq V (co I R cmvr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel Y D) $ >
  $ wi ph (wral x3 (wral y1 (wceq (co (cfv (cv y1) V) (cfv (cv x3) V) (cfv G cplusg)) (co (cfv (cv x3) V) (cfv (cv y1) V) (cfv G cplusg))) I) I) $ >
  $ wi ph (wceq (cmpt y1 D (cif (wceq (cv y1) Y) c_1 c_0)) (co G (cmpt k I (co (cfv (cv k) Y) (cfv (cv k) V) c_ex)) cgsu)) $;

--| Decompose a monomial into a finite product of powers of variables. (The assumption that ` R ` is a commutative ring is not strictly necessary, because the submonoid of monomials is in the center of the multiplicative monoid of polynomials, but it simplifies the proof.) (Contributed by Mario Carneiro, 10-Jan-2015.) (Proof shortened by AV, 18-Oct-2019.)
theorem mplcoe2 {y1 f2 k: setvar} (ph: wff f2) (D: class f2) (P: class y1 f2) (R: class k) (c_1 c_ex G: class f2) (I: class) (V W: class f2) (Y c_0: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wcel I W) $ >
  $ wceq G (cfv P cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wceq V (co I R cmvr) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel Y D) $ >
  $ wi ph (wceq (cmpt y1 D (cif (wceq (cv y1) Y) c_1 c_0)) (co G (cmpt k I (co (cfv (cv k) Y) (cfv (cv k) V) c_ex)) cgsu)) $;

--| An alternative expression for the set of polynomials, as the smallest subalgebra of the set of power series that contains all the variable generators. (Contributed by Mario Carneiro, 10-Jan-2015.)
theorem mplbas2 (ph: wff) (A2 P R S I V W: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq S (co I R cmps) $ >
  $ wceq V (co I R cmvr) $ >
  $ wceq A2 (cfv S casp) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wceq (cfv (crn V) A2) (cfv P cbs)) $;

--| Value of the well-order on finite bags. (Contributed by Mario Carneiro, 8-Feb-2015.)
theorem ltbval {x3 y1 z w h: setvar} (ph: wff z w) (C: class x3 y1 z w h) (D: class z w h) (T: class h) (I: class) (V W: class x3 y1 z w h):
  $ wceq C (co T I cltb) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel T W) $ >
  $ wi ph (wceq C (copab x3 y1 (wa (wss (cpr (cv x3) (cv y1)) D) (wrex z (wa (wbr (cfv (cv z) (cv x3)) (cfv (cv z) (cv y1)) clt) (wral w (wi (wbr (cv z) (cv w) T) (wceq (cfv (cv w) (cv x3)) (cfv (cv w) (cv y1)))) I)) I)))) $;

--| The finite bag order is a well-order, given a well-order of the index set. (Contributed by Mario Carneiro, 2-Jun-2015.)
theorem ltbwe {h: setvar} (ph: wff) (C D T: class h) (I: class) (V W: class h):
  $ wceq C (co T I cltb) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel T W) $ >
  $ wi ph (wwe I T) $ >
  $ wi ph (wwe D C) $;

--| Lemma for ordered power series. (Contributed by Stefan O'Rear, 2-Oct-2015.)
theorem reldmopsr:
  $ wrel (cdm copws) $;

--| The value of the "ordered power series" function. This is the same as ` mPwSer ` ~ psrval , but with the addition of a well-order on ` I ` we can turn a strict order on ` R ` into a strict order on the power series structure. (Contributed by Mario Carneiro, 8-Feb-2015.)
theorem opsrval {x3 y1 z w h: setvar} (ph: wff h) (B2 C: class x3 y1 z w h) (D: class x3 y1 h) (R: class h) (S c_lt: class x3 y1 z w h) (T: class h) (I: class) (c_le O V W: class x3 y1 z w h):
  $ wceq S (co I R cmps) $ >
  $ wceq O (cfv T (co I R copws)) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_lt (cfv R cplt) $ >
  $ wceq C (co T I cltb) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_le (copab x3 y1 (wa (wss (cpr (cv x3) (cv y1)) B2) (wo (wrex z (wa (wbr (cfv (cv z) (cv x3)) (cfv (cv z) (cv y1)) c_lt) (wral w (wi (wbr (cv w) (cv z) C) (wceq (cfv (cv w) (cv x3)) (cfv (cv w) (cv y1)))) D)) D) (wceq (cv x3) (cv y1))))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wi ph (wceq O (co S (cop (cfv cnx cple) c_le) csts)) $;

--| An alternative expression for the set of polynomials, as the smallest subalgebra of the set of power series that contains all the variable generators. (Contributed by Mario Carneiro, 8-Feb-2015.) (Revised by Mario Carneiro, 2-Oct-2015.)
theorem opsrle {x3 y1 z w h: setvar} (ph: wff h) (B2: class z w h) (C: class x3 y1 z w h) (D: class x3 y1 h) (R: class h) (S c_lt: class x3 y1 z w h) (T: class h) (I: class) (c_le O: class x3 y1 z w h):
  $ wceq S (co I R cmps) $ >
  $ wceq O (cfv T (co I R copws)) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_lt (cfv R cplt) $ >
  $ wceq C (co T I cltb) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_le (cfv O cple) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wi ph (wceq c_le (copab x3 y1 (wa (wss (cpr (cv x3) (cv y1)) B2) (wo (wrex z (wa (wbr (cfv (cv z) (cv x3)) (cfv (cv z) (cv y1)) c_lt) (wral w (wi (wbr (cv w) (cv z) C) (wceq (cfv (cv w) (cv x3)) (cfv (cv w) (cv y1)))) D)) D) (wceq (cv x3) (cv y1)))))) $;

--| Self-referential expression for the ordered power series structure. (Contributed by Mario Carneiro, 8-Feb-2015.)
theorem opsrval2 (ph: wff) (R S T I c_le O V W: class):
  $ wceq S (co I R cmps) $ >
  $ wceq O (cfv T (co I R copws)) $ >
  $ wceq c_le (cfv O cple) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wi ph (wceq O (co S (cop (cfv cnx cple) c_le) csts)) $;

--| Get a component of the ordered power series structure. (Contributed by Mario Carneiro, 8-Feb-2015.) (Revised by Mario Carneiro, 2-Oct-2015.) (Revised by AV, 9-Sep-2021.) (Revised by AV, 1-Nov-2024.)
theorem opsrbaslem (ph: wff) (R S T E I O: class):
  $ wceq S (co I R cmps) $ >
  $ wceq O (cfv T (co I R copws)) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wceq E (cslot (cfv cnx E)) $ >
  $ wne (cfv cnx E) (cfv cnx cple) $ >
  $ wi ph (wceq (cfv S E) (cfv O E)) $;

--| The base set of the ordered power series structure. (Contributed by Mario Carneiro, 8-Feb-2015.) (Revised by Mario Carneiro, 30-Aug-2015.) (Revised by AV, 1-Nov-2024.)
theorem opsrbas (ph: wff) (R S T I O: class):
  $ wceq S (co I R cmps) $ >
  $ wceq O (cfv T (co I R copws)) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wi ph (wceq (cfv S cbs) (cfv O cbs)) $;

--| The addition operation of the ordered power series structure. (Contributed by Mario Carneiro, 8-Feb-2015.) (Revised by Mario Carneiro, 30-Aug-2015.) (Revised by AV, 1-Nov-2024.)
theorem opsrplusg (ph: wff) (R S T I O: class):
  $ wceq S (co I R cmps) $ >
  $ wceq O (cfv T (co I R copws)) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wi ph (wceq (cfv S cplusg) (cfv O cplusg)) $;

--| The multiplication operation of the ordered power series structure. (Contributed by Mario Carneiro, 8-Feb-2015.) (Revised by Mario Carneiro, 30-Aug-2015.) (Revised by AV, 1-Nov-2024.)
theorem opsrmulr (ph: wff) (R S T I O: class):
  $ wceq S (co I R cmps) $ >
  $ wceq O (cfv T (co I R copws)) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wi ph (wceq (cfv S cmulr) (cfv O cmulr)) $;

--| The scalar product operation of the ordered power series structure. (Contributed by Mario Carneiro, 8-Feb-2015.) (Revised by Mario Carneiro, 30-Aug-2015.) (Revised by AV, 1-Nov-2024.)
theorem opsrvsca (ph: wff) (R S T I O: class):
  $ wceq S (co I R cmps) $ >
  $ wceq O (cfv T (co I R copws)) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wi ph (wceq (cfv S cvsca) (cfv O cvsca)) $;

--| The scalar ring of the ordered power series structure. (Contributed by Mario Carneiro, 8-Feb-2015.) (Revised by Mario Carneiro, 30-Aug-2015.) (Revised by AV, 1-Nov-2024.)
theorem opsrsca (ph: wff) (R S T I O V W: class):
  $ wceq S (co I R cmps) $ >
  $ wceq O (cfv T (co I R copws)) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wi ph (wceq R (cfv O csca)) $;

--| Lemma for ~ opsrtos . (Contributed by Mario Carneiro, 8-Feb-2015.)
theorem opsrtoslem1 {x3 y1 z w h: setvar} (ph: wff) (ps: wff x3 y1 z w h) (B2: class z w h) (C D R: class h) (S: class x3 y1 z w h) (c_lt T: class h) (I: class) (c_le O V: class x3 y1 z w h):
  $ wceq O (cfv T (co I R copws)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ctos) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wi ph (wwe I T) $ >
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_lt (cfv R cplt) $ >
  $ wceq C (co T I cltb) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wb ps (wrex z (wa (wbr (cfv (cv z) (cv x3)) (cfv (cv z) (cv y1)) c_lt) (wral w (wi (wbr (cv w) (cv z) C) (wceq (cfv (cv w) (cv x3)) (cfv (cv w) (cv y1)))) D)) D) $ >
  $ wceq c_le (cfv O cple) $ >
  $ wi ph (wceq c_le (cun (cin (copab x3 y1 ps) (cxp B2 B2)) (cres cid B2))) $;

--| Lemma for ~ opsrtos . (Contributed by Mario Carneiro, 8-Feb-2015.)
theorem opsrtoslem2 {x3 y1 z w h: setvar} (ph: wff) (ps: wff x3 y1 z w h) (B2: class z w h) (C D R: class h) (S: class x3 y1 z w h) (c_lt T: class h) (I: class) (c_le O V: class x3 y1 z w h):
  $ wceq O (cfv T (co I R copws)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ctos) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wi ph (wwe I T) $ >
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_lt (cfv R cplt) $ >
  $ wceq C (co T I cltb) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wb ps (wrex z (wa (wbr (cfv (cv z) (cv x3)) (cfv (cv z) (cv y1)) c_lt) (wral w (wi (wbr (cv w) (cv z) C) (wceq (cfv (cv w) (cv x3)) (cfv (cv w) (cv y1)))) D)) D) $ >
  $ wceq c_le (cfv O cple) $ >
  $ wi ph (wcel O ctos) $;

--| The ordered power series structure is a totally ordered set. (Contributed by Mario Carneiro, 10-Jan-2015.)
theorem opsrtos (ph: wff) (R T I O V: class):
  $ wceq O (cfv T (co I R copws)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ctos) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wi ph (wwe I T) $ >
  $ wi ph (wcel O ctos) $;

--| The ordered power series structure is a totally ordered set. (Contributed by Mario Carneiro, 10-Jan-2015.)
theorem opsrso (ph: wff) (B2 R T I c_le O V: class):
  $ wceq O (cfv T (co I R copws)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ctos) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wi ph (wwe I T) $ >
  $ wceq c_le (cfv O cplt) $ >
  $ wceq B2 (cfv O cbs) $ >
  $ wi ph (wor B2 c_le) $;

--| The ring of ordered power series is commutative ring. (Contributed by Mario Carneiro, 10-Jan-2015.)
theorem opsrcrng (ph: wff) (R T I O V: class):
  $ wceq O (cfv T (co I R copws)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wi ph (wcel O ccrg) $;

--| The ring of ordered power series is an associative algebra. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem opsrassa (ph: wff) (R T I O V: class):
  $ wceq O (cfv T (co I R copws)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wi ph (wcel O casa) $;

--| Express a scaled monomial. (Contributed by Stefan O'Rear, 8-Mar-2015.)
theorem mplmon2 {y1 f2: setvar} (ph: wff f2) (B2 D: class f2) (P: class y1 f2) (R: class f2) (c_x: class y1 f2) (c_1: class f2) (I: class y1) (K: class) (W: class y1 f2) (X c_0: class f2):
  $ wceq P (co I R cmpl) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel K D) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (co X (cmpt y1 D (cif (wceq (cv y1) K) c_1 c_0)) c_x) (cmpt y1 D (cif (wceq (cv y1) K) X c_0))) $;

--| The empty bag is a bag. (Contributed by Stefan O'Rear, 9-Mar-2015.)
theorem psrbag0 {f2: setvar} (D: class f2) (I: class) (V: class f2):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi (wcel I V) (wcel (cxp I (csn cc0)) D) $;

--| A singleton bag is a bag. (Contributed by Stefan O'Rear, 9-Mar-2015.)
theorem psrbagsn {x3 f2: setvar} (D: class x3 f2) (I K: class) (V: class x3 f2):
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi (wcel I V) (wcel (cmpt x3 I (cif (wceq (cv x3) K) c1 cc0)) D) $;

--| Value of the scalar injection into the polynomial algebra. (Contributed by Stefan O'Rear, 9-Mar-2015.)
theorem mplascl {y1 f2: setvar} (ph: wff f2) (A2: class y1 f2) (B2 D: class f2) (P: class y1 f2) (R I: class) (W X: class f2) (c_0: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cfv X A2) (cmpt y1 D (cif (wceq (cv y1) (cxp I (csn cc0))) X c_0))) $;

--| The scalar injection is a function into the polynomial algebra. (Contributed by Stefan O'Rear, 9-Mar-2015.)
theorem mplasclf (ph: wff) (A2 B2 P R I K W: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wf K B2 A2) $;

--| The scalar injection function in a subring algebra is the same up to a restriction to the subring. (Contributed by Mario Carneiro, 4-Jul-2015.)
theorem subrgascl (ph: wff) (A2 C P R T U H I W: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (co I H cmpl) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq C (cfv U cascl) $ >
  $ wi ph (wceq C (cres A2 T)) $;

--| The scalars in a polynomial algebra are in the subring algebra iff the scalar value is in the subring. (Contributed by Mario Carneiro, 4-Jul-2015.)
theorem subrgasclcl (ph: wff) (A2 B2 P R T U H I K W X: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (co I H cmpl) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wb (wcel (cfv X A2) B2) (wcel X T)) $;

--| A scaled monomial is a polynomial. (Contributed by Stefan O'Rear, 8-Mar-2015.)
theorem mplmon2cl {y1 f2: setvar} (ph: wff f2) (B2: class y1 f2) (C D: class f2) (P: class y1 f2) (R: class f2) (I: class y1) (K: class) (W: class y1 f2) (X c_0: class f2):
  $ wceq P (co I R cmpl) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq C (cfv R cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wcel X C) $ >
  $ wi ph (wcel K D) $ >
  $ wi ph (wcel (cmpt y1 D (cif (wceq (cv y1) K) X c_0)) B2) $;

--| Product of scaled monomials. (Contributed by Stefan O'Rear, 8-Mar-2015.)
theorem mplmon2mul {y1 f2: setvar} (ph: wff f2) (C D: class f2) (P: class y1 f2) (R: class f2) (c_xb: class y1 f2) (c_x F G: class f2) (I: class y1) (W: class y1 f2) (X Y: class) (c_0: class f2):
  $ wceq P (co I R cmpl) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq C (cfv R cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wceq c_xb (cfv P cmulr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel X D) $ >
  $ wi ph (wcel Y D) $ >
  $ wi ph (wcel F C) $ >
  $ wi ph (wcel G C) $ >
  $ wi ph (wceq (co (cmpt y1 D (cif (wceq (cv y1) X) F c_0)) (cmpt y1 D (cif (wceq (cv y1) Y) G c_0)) c_xb) (cmpt y1 D (cif (wceq (cv y1) (co X Y (cof caddc))) (co F G c_x) c_0))) $;

--| Prove a property of polynomials by "structural" induction, under a simplified model of structure which loses the sum of products structure. The commutativity condition is stronger than strictly needed. (Contributed by Stefan O'Rear, 11-Mar-2015.)
theorem mplind {x3 y1: setvar} (ph: wff) (B2 C c_pl: class) (R: class x3 y1) (c_x H: class) (I K V: class y1) (W X: class x3 y1) (Y: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq V (co I R cmvr) $ >
  $ wceq Y (co I R cmpl) $ >
  $ wceq c_pl (cfv Y cplusg) $ >
  $ wceq c_x (cfv Y cmulr) $ >
  $ wceq C (cfv Y cascl) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wi (wa ph (wa (wcel (cv x3) H) (wcel (cv y1) H))) (wcel (co (cv x3) (cv y1) c_pl) H) $ >
  $ wi (wa ph (wa (wcel (cv x3) H) (wcel (cv y1) H))) (wcel (co (cv x3) (cv y1) c_x) H) $ >
  $ wi (wa ph (wcel (cv x3) K)) (wcel (cfv (cv x3) C) H) $ >
  $ wi (wa ph (wcel (cv x3) I)) (wcel (cfv (cv x3) V) H) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X H) $;

--| Decompose a polynomial into a finite sum of scaled monomials. (Contributed by Stefan O'Rear, 8-Mar-2015.)
theorem mplcoe4 {y1 f2 k: setvar} (ph: wff f2) (B2: class y1 f2) (D P: class f2) (R I: class) (W: class f2) (X c_0: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq X (co P (cmpt k D (cmpt y1 D (cif (wceq (cv y1) (cv k)) (cfv (cv k) X) c_0))) cgsu)) $;

--| Evaluation of a multivariate polynomial in a subring.
term ces: class;

--| Evaluation of a multivariate polynomial.
term cevl: class;

--| Define the evaluation map for the polynomial algebra. The function ` ( ( I evalSub S ) `` R ) : V --> ( S ^m ( S ^m I ) ) ` makes sense when ` I ` is an index set, ` S ` is a ring, ` R ` is a subring of ` S ` , and where ` V ` is the set of polynomials in ` ( I mPoly R ) ` . This function maps an element of the formal polynomial algebra (with coefficients in ` R ` ) to a function from assignments ` I --> S ` of the variables to elements of ` S ` formed by evaluating the polynomial with the given assignments. (Contributed by Stefan O'Rear, 11-Mar-2015.)
axiom df_evls {x3 w f2 g2 i s1 r b: setvar}:
  $ wceq ces (cmpo i s1 cvv ccrg (csb b (cfv (cv s1) cbs) (cmpt r (cfv (cv s1) csubrg) (csb w (co (cv i) (co (cv s1) (cv r) cress) cmpl) (crio f2 (wa (wceq (ccom (cv f2) (cfv (cv w) cascl)) (cmpt x3 (cv r) (cxp (co (cv b) (cv i) cmap) (csn (cv x3))))) (wceq (ccom (cv f2) (co (cv i) (co (cv s1) (cv r) cress) cmvr)) (cmpt x3 (cv i) (cmpt g2 (co (cv b) (cv i) cmap) (cfv (cv x3) (cv g2)))))) (co (cv w) (co (cv s1) (co (cv b) (cv i) cmap) cpws) crh)))))) $;

--| A simplification of ` evalSub ` when the evaluation ring is the same as the coefficient ring. (Contributed by Stefan O'Rear, 19-Mar-2015.)
axiom df_evl {i r: setvar}:
  $ wceq cevl (cmpo i r cvv cvv (cfv (cfv (cv r) cbs) (co (cv i) (cv r) ces))) $;

--| The support of a tensor product of ring element families is contained in the product of the supports. (Contributed by Stefan O'Rear, 8-Mar-2015.) (Revised by AV, 18-Jul-2019.)
theorem evlslem4 {x3 y1: setvar} (ph: wff) (B2: class) (R: class x3 y1) (c_x I J: class) (V W: class x3 y1) (X: class x3) (Y: class y1) (c_0: class x3 y1):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi (wa ph (wcel (cv x3) I)) (wcel X B2) $ >
  $ wi (wa ph (wcel (cv y1) J)) (wcel Y B2) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel J W) $ >
  $ wi ph (wss (co (cmpo x3 y1 I J (co X Y c_x)) c_0 csupp) (cxp (co (cmpt x3 I X) c_0 csupp) (co (cmpt y1 J Y) c_0 csupp))) $;

--| A bag of multipliers provides the conditions for a valid sum. (Contributed by Stefan O'Rear, 9-Mar-2015.) (Revised by AV, 18-Jul-2019.) (Revised by AV, 11-Apr-2024.) Remove a sethood hypothesis. (Revised by SN, 7-Aug-2024.)
theorem psrbagev1 {h: setvar} (ph: wff h) (B2: class) (C D T c_x G: class h) (I: class) (c_0: class h):
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq C (cfv T cbs) $ >
  $ wceq c_x (cfv T cmg) $ >
  $ wceq c_0 (cfv T c0g) $ >
  $ wi ph (wcel T ccmn) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wf I C G) $ >
  $ wi ph (wa (wf I C (co B2 G (cof c_x))) (wbr (co B2 G (cof c_x)) c_0 cfsupp)) $;

--| Closure of a sum using a bag of multipliers. (Contributed by Stefan O'Rear, 9-Mar-2015.) (Proof shortened by AV, 18-Jul-2019.) (Revised by AV, 11-Apr-2024.) Remove a sethood hypothesis. (Revised by SN, 7-Aug-2024.)
theorem psrbagev2 {h: setvar} (ph: wff h) (B2: class) (C D T c_x G: class h) (I: class):
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq C (cfv T cbs) $ >
  $ wceq c_x (cfv T cmg) $ >
  $ wi ph (wcel T ccmn) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wf I C G) $ >
  $ wi ph (wcel (co T (co B2 G (cof c_x)) cgsu) C) $;

--| A linear function on the polynomial ring which is multiplicative on scaled monomials is generally multiplicative. (Contributed by Stefan O'Rear, 9-Mar-2015.) (Revised by AV, 11-Apr-2024.)
theorem evlslem2 {x3 y1 h i j k: setvar} (ph: wff x3 h) (B2 D P: class h) (R: class x3 y1) (S c_x E: class x3 y1 h k) (I: class x3 y1) (W: class x3 y1 h) (c_0: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel E (co P S cghm)) $ >
  $ wi (wa ph (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wa (wcel (cv j) D) (wcel (cv i) D)))) (wceq (cfv (cmpt k D (cif (wceq (cv k) (co (cv j) (cv i) (cof caddc))) (co (cfv (cv j) (cv x3)) (cfv (cv i) (cv y1)) (cfv R cmulr)) c_0)) E) (co (cfv (cmpt k D (cif (wceq (cv k) (cv j)) (cfv (cv j) (cv x3)) c_0)) E) (cfv (cmpt k D (cif (wceq (cv k) (cv i)) (cfv (cv i) (cv y1)) c_0)) E) c_x)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (cfv (co (cv x3) (cv y1) (cfv P cmulr)) E) (co (cfv (cv x3) E) (cfv (cv y1) E) c_x)) $;

--| Lemma for ~ evlseu . Polynomial evaluation of a scaled monomial. (Contributed by Stefan O'Rear, 8-Mar-2015.) (Revised by AV, 11-Apr-2024.)
theorem evlslem3 {x3 h p b: setvar} (ph: wff h p) (A2: class) (B2: class x3 h b) (C: class x3 h p) (D: class h) (P: class x3 h p b) (R: class h p b) (S T c_x: class x3 h) (E: class x3 h p b) (c_ex F G: class x3 h) (H: class h) (I: class x3 p b) (K: class h p b) (V W: class x3 h p b) (c_0: class h):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq T (cfv S cmgp) $ >
  $ wceq c_ex (cfv T cmg) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wceq V (co I R cmvr) $ >
  $ wceq E (cmpt p B2 (co S (cmpt b D (co (cfv (cfv (cv b) (cv p)) F) (co T (co (cv b) G (cof c_ex)) cgsu) c_x)) cgsu)) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel F (co R S crh)) $ >
  $ wi ph (wf I C G) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel H K) $ >
  $ wi ph (wceq (cfv (cmpt x3 D (cif (wceq (cv x3) A2) H c_0)) E) (co (cfv H F) (co T (co A2 G (cof c_ex)) cgsu) c_x)) $;

--| Lemma for ~ evlseu . Finiteness and consistency of the top-level sum. (Contributed by Stefan O'Rear, 9-Mar-2015.) (Revised by AV, 26-Jul-2019.) (Revised by AV, 11-Apr-2024.)
theorem evlslem6 {h p b: setvar} (ph: wff h p) (B2: class h p b) (C D: class h p) (P: class h p b) (R S: class h p) (T c_x E c_ex F G: class h p b) (I: class p b) (V W: class h p b) (Y: class h p):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq T (cfv S cmgp) $ >
  $ wceq c_ex (cfv T cmg) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wceq V (co I R cmvr) $ >
  $ wceq E (cmpt p B2 (co S (cmpt b D (co (cfv (cfv (cv b) (cv p)) F) (co T (co (cv b) G (cof c_ex)) cgsu) c_x)) cgsu)) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel F (co R S crh)) $ >
  $ wi ph (wf I C G) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wa (wf D C (cmpt b D (co (cfv (cfv (cv b) Y) F) (co T (co (cv b) G (cof c_ex)) cgsu) c_x))) (wbr (cmpt b D (co (cfv (cfv (cv b) Y) F) (co T (co (cv b) G (cof c_ex)) cgsu) c_x)) (cfv S c0g) cfsupp)) $;

--| Lemma for ~ evlseu , give a formula for (the unique) polynomial evaluation homomorphism. (Contributed by Stefan O'Rear, 9-Mar-2015.) (Proof shortened by AV, 26-Jul-2019.) (Revised by AV, 11-Apr-2024.)
theorem evlslem1 {h p b: setvar} (ph: wff h) (A2: class h p b) (B2 C D P: class h) (R: class) (S T c_x: class h) (E: class h p b) (c_ex F G: class h) (I: class) (V W: class h p b):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq C (cfv S cbs) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq T (cfv S cmgp) $ >
  $ wceq c_ex (cfv T cmg) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wceq V (co I R cmvr) $ >
  $ wceq E (cmpt p B2 (co S (cmpt b D (co (cfv (cfv (cv b) (cv p)) F) (co T (co (cv b) G (cof c_ex)) cgsu) c_x)) cgsu)) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel F (co R S crh)) $ >
  $ wi ph (wf I C G) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wi ph (w3a (wcel E (co P S crh)) (wceq (ccom E A2) F) (wceq (ccom E V) G)) $;

--| For a given interpretation of the variables ` G ` and of the scalars ` F ` , this extends to a homomorphic interpretation of the polynomial ring in exactly one way. (Contributed by Stefan O'Rear, 9-Mar-2015.) (Revised by AV, 11-Apr-2024.)
theorem evlseu {m: setvar} (ph: wff) (A2: class) (C: class m) (P: class) (R: class m) (S F G I V: class) (W: class m):
  $ wceq P (co I R cmpl) $ >
  $ wceq C (cfv S cbs) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq V (co I R cmvr) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel F (co R S crh)) $ >
  $ wi ph (wf I C G) $ >
  $ wi ph (wreu m (wa (wceq (ccom (cv m) A2) F) (wceq (ccom (cv m) V) G)) (co P S crh)) $;

--| Well-behaved binary operation property of ` evalSub ` . (Contributed by Stefan O'Rear, 19-Mar-2015.)
theorem reldmevls:
  $ wrel (cdm ces) $;

--| Reverse closure for the set of polynomial functions. (Contributed by Stefan O'Rear, 19-Mar-2015.)
theorem mpfrcl (Q R S I X: class):
  $ wceq Q (crn (cfv R (co I S ces))) $ >
  $ wi (wcel X Q) (w3a (wcel I cvv) (wcel S ccrg) (wcel R (cfv S csubrg))) $;

--| Value of the polynomial evaluation map function. (Contributed by Stefan O'Rear, 11-Mar-2015.) (Revised by AV, 18-Sep-2021.)
theorem evlsval {x3 f2 g2: setvar} (A2 B2 Q: class x3 f2 g2) (R: class g2) (S: class) (T: class x3 g2) (U: class x3 f2 g2) (I: class) (V: class x3 f2 g2) (W: class x3 g2) (X Y Z: class x3 f2 g2):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq W (co I U cmpl) $ >
  $ wceq V (co I U cmvr) $ >
  $ wceq U (co S R cress) $ >
  $ wceq T (co S (co B2 I cmap) cpws) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq A2 (cfv W cascl) $ >
  $ wceq X (cmpt x3 R (cxp (co B2 I cmap) (csn (cv x3)))) $ >
  $ wceq Y (cmpt x3 I (cmpt g2 (co B2 I cmap) (cfv (cv x3) (cv g2)))) $ >
  $ wi (w3a (wcel I Z) (wcel S ccrg) (wcel R (cfv S csubrg))) (wceq Q (crio f2 (wa (wceq (ccom (cv f2) A2) X) (wceq (ccom (cv f2) V) Y)) (co W T crh))) $;

--| Characterizing properties of the polynomial evaluation map function. (Contributed by Stefan O'Rear, 12-Mar-2015.) (Revised by AV, 18-Sep-2021.)
theorem evlsval2 {x3 g2: setvar} (A2: class x3 g2) (B2: class) (Q: class x3 g2) (R S: class) (T: class g2) (U: class x3 g2) (I: class) (V W X Y: class x3 g2) (Z: class):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq W (co I U cmpl) $ >
  $ wceq V (co I U cmvr) $ >
  $ wceq U (co S R cress) $ >
  $ wceq T (co S (co B2 I cmap) cpws) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq A2 (cfv W cascl) $ >
  $ wceq X (cmpt x3 R (cxp (co B2 I cmap) (csn (cv x3)))) $ >
  $ wceq Y (cmpt x3 I (cmpt g2 (co B2 I cmap) (cfv (cv x3) (cv g2)))) $ >
  $ wi (w3a (wcel I Z) (wcel S ccrg) (wcel R (cfv S csubrg))) (wa (wcel Q (co W T crh)) (wa (wceq (ccom Q A2) X) (wceq (ccom Q V) Y))) $;

--| Polynomial evaluation is a homomorphism (into the product ring). (Contributed by Stefan O'Rear, 12-Mar-2015.)
theorem evlsrhm (B2 Q R S T U I V W: class):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq W (co I U cmpl) $ >
  $ wceq U (co S R cress) $ >
  $ wceq T (co S (co B2 I cmap) cpws) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi (w3a (wcel I V) (wcel S ccrg) (wcel R (cfv S csubrg))) (wcel Q (co W T crh)) $;

--| Give a formula for the polynomial evaluation homomorphism. (Contributed by SN, 26-Jul-2024.)
theorem evlsval3 {x3 h p a b: setvar} (ph: wff h) (B2 D P: class x3 h a) (Q: class x3 h p a b) (R: class h p a b) (S: class h p b) (T: class h a) (c_x: class x3 h a) (U: class x3 a) (E: class x3 h p a b) (c_ex F G: class x3 h a) (I: class) (K: class h p b) (M: class x3 h a) (V: class x3 h p a b):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq P (co I U cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq U (co S R cress) $ >
  $ wceq T (co S (co K I cmap) cpws) $ >
  $ wceq M (cfv T cmgp) $ >
  $ wceq c_ex (cfv M cmg) $ >
  $ wceq c_x (cfv T cmulr) $ >
  $ wceq E (cmpt p B2 (co T (cmpt b D (co (cfv (cfv (cv b) (cv p)) F) (co M (co (cv b) G (cof c_ex)) cgsu) c_x)) cgsu)) $ >
  $ wceq F (cmpt x3 R (cxp (co K I cmap) (csn (cv x3)))) $ >
  $ wceq G (cmpt x3 I (cmpt a (co K I cmap) (cfv (cv x3) (cv a)))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wceq Q E) $;

--| Give a formula for the evaluation of a polynomial. (Contributed by SN, 9-Feb-2025.)
theorem evlsvval {x3 h a b: setvar} (ph: wff h) (A2 B2 D P: class x3 h a) (Q: class x3 h a b) (R: class h a b) (S: class h b) (T: class h a) (c_x: class x3 h a) (U: class x3 a) (c_ex F G: class x3 h a) (I: class) (K: class h b) (M: class x3 h a) (V: class x3 h a b):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq P (co I U cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq U (co S R cress) $ >
  $ wceq T (co S (co K I cmap) cpws) $ >
  $ wceq M (cfv T cmgp) $ >
  $ wceq c_ex (cfv M cmg) $ >
  $ wceq c_x (cfv T cmulr) $ >
  $ wceq F (cmpt x3 R (cxp (co K I cmap) (csn (cv x3)))) $ >
  $ wceq G (cmpt x3 I (cmpt a (co K I cmap) (cfv (cv x3) (cv a)))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wceq (cfv A2 Q) (co T (cmpt b D (co (cfv (cfv (cv b) A2) F) (co M (co (cv b) G (cof c_ex)) cgsu) c_x)) cgsu)) $;

--| Lemma for ~ evlsvvval akin to ~ psrbagev2 . (Contributed by SN, 6-Mar-2025.)
theorem evlsvvvallem {v h: setvar} (ph: wff h) (A2: class v h) (B2: class) (D: class v h) (S: class h) (c_ex: class v h) (I: class) (K: class h) (M V: class v h):
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq M (cfv S cmgp) $ >
  $ wceq c_ex (cfv M cmg) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wcel (co M (cmpt v I (co (cfv (cv v) B2) (cfv (cv v) A2) c_ex)) cgsu) K) $;

--| Lemma for theorems using ~ evlsvvval . (Contributed by SN, 8-Mar-2025.)
theorem evlsvvvallem2 {v h b: setvar} (ph: wff h) (A2: class v h b) (B2: class b) (D: class h) (P R: class v h b) (S: class h) (c_x: class v h b) (U: class v h) (c_ex: class v h b) (F: class v h) (I: class b) (K: class h b) (M V: class v h b):
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq P (co I U cmpl) $ >
  $ wceq U (co S R cress) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq M (cfv S cmgp) $ >
  $ wceq c_ex (cfv M cmg) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wbr (cmpt b D (co (cfv (cv b) F) (co M (cmpt v I (co (cfv (cv v) (cv b)) (cfv (cv v) A2) c_ex)) cgsu) c_x)) (cfv S c0g) cfsupp) $;

--| Give a formula for the evaluation of a polynomial given assignments from variables to values. This is the sum of the evaluations for each term (corresponding to a bag of variables), that is, the coefficient times the product of each variable raised to the corresponding power. (Contributed by SN, 5-Mar-2025.)
theorem evlsvvval {h i b: setvar} (ph: wff h) (A2: class h) (B2: class h i) (D: class h) (P: class h i) (Q: class h i b) (R: class h i) (S: class h) (c_x: class h i b) (U: class i) (c_ex: class h i b) (F: class h i) (I: class) (K: class h) (M V: class h i b):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq P (co I U cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq U (co S R cress) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq M (cfv S cmgp) $ >
  $ wceq c_ex (cfv M cmg) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wceq (cfv A2 (cfv F Q)) (co S (cmpt b D (co (cfv (cv b) F) (co M (cmpt i I (co (cfv (cv i) (cv b)) (cfv (cv i) A2) c_ex)) cgsu) c_x)) cgsu)) $;

--| Polynomial evaluation maps scalars to constant functions. (Contributed by Stefan O'Rear, 13-Mar-2015.) (Proof shortened by AV, 18-Sep-2021.)
theorem evlssca (ph: wff) (A2 B2 Q R S U I V W X: class):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq W (co I U cmpl) $ >
  $ wceq U (co S R cress) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq A2 (cfv W cascl) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel X R) $ >
  $ wi ph (wceq (cfv (cfv X A2) Q) (cxp (co B2 I cmap) (csn X))) $;

--| Polynomial evaluation maps variables to projections. (Contributed by Stefan O'Rear, 12-Mar-2015.) (Proof shortened by AV, 18-Sep-2021.)
theorem evlsvar {g2: setvar} (ph: wff g2) (B2: class) (Q: class g2) (R S: class) (U: class g2) (I: class) (V: class g2) (W X: class):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq V (co I U cmvr) $ >
  $ wceq U (co S R cress) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wceq (cfv (cfv X V) Q) (cmpt g2 (co B2 I cmap) (cfv X (cv g2)))) $;

--| Polynomial evaluation maps (additive) group sums to group sums. (Contributed by SN, 13-Feb-2024.)
theorem evlsgsumadd {x3: setvar} (ph: wff) (B2: class) (P: class x3) (Q: class) (R S U I K: class x3) (N: class) (V W Y c_0: class x3):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq W (co I U cmpl) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq U (co S R cress) $ >
  $ wceq P (co S (co K I cmap) cpws) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi (wa ph (wcel (cv x3) N)) (wcel Y B2) $ >
  $ wi ph (wss N cn0) $ >
  $ wi ph (wbr (cmpt x3 N Y) c_0 cfsupp) $ >
  $ wi ph (wceq (cfv (co W (cmpt x3 N Y) cgsu) Q) (co P (cmpt x3 N (cfv Y Q)) cgsu)) $;

--| Polynomial evaluation maps (multiplicative) group sums to group sums. (Contributed by SN, 13-Feb-2024.)
theorem evlsgsummul {x3: setvar} (ph: wff) (B2: class) (P: class x3) (Q: class) (R S U c_1 G H I K: class x3) (N: class) (V W Y: class x3):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq W (co I U cmpl) $ >
  $ wceq G (cfv W cmgp) $ >
  $ wceq c_1 (cfv W cur) $ >
  $ wceq U (co S R cress) $ >
  $ wceq P (co S (co K I cmap) cpws) $ >
  $ wceq H (cfv P cmgp) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi (wa ph (wcel (cv x3) N)) (wcel Y B2) $ >
  $ wi ph (wss N cn0) $ >
  $ wi ph (wbr (cmpt x3 N Y) c_1 cfsupp) $ >
  $ wi ph (wceq (cfv (co G (cmpt x3 N Y) cgsu) Q) (co H (cmpt x3 N (cfv Y Q)) cgsu)) $;

--| Polynomial evaluation for subrings maps the exponentiation of a polynomial to the exponentiation of the evaluated polynomial. (Contributed by SN, 29-Feb-2024.)
theorem evlspw (ph: wff) (B2 P Q R S U c_ex G H I K N V W X: class):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq W (co I U cmpl) $ >
  $ wceq G (cfv W cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wceq U (co S R cress) $ >
  $ wceq P (co S (co K I cmap) cpws) $ >
  $ wceq H (cfv P cmgp) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cfv (co N X c_ex) Q) (co N (cfv X Q) (cfv H cmg))) $;

--| Polynomial evaluation for subrings maps the exponentiation of a variable to the exponentiation of the evaluated variable. (Contributed by SN, 21-Feb-2024.)
theorem evlsvarpw (ph: wff) (B2 P Q R S U c_ex G H I N V W X Y: class):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq W (co I U cmpl) $ >
  $ wceq G (cfv W cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wceq X (cfv Y (co I U cmvr)) $ >
  $ wceq U (co S R cress) $ >
  $ wceq P (co S (co B2 I cmap) cpws) $ >
  $ wceq H (cfv P cmgp) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel Y I) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (cfv (co N X c_ex) Q) (co N (cfv X Q) (cfv H cmg))) $;

--| Value of the simple/same ring evaluation map. (Contributed by Stefan O'Rear, 19-Mar-2015.) (Revised by Mario Carneiro, 12-Jun-2015.)
theorem evlval (B2 Q R I: class):
  $ wceq Q (co I R cevl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq Q (cfv B2 (co I R ces)) $;

--| The simple evaluation map is a ring homomorphism. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem evlrhm (B2 Q R T I V W: class):
  $ wceq Q (co I R cevl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq W (co I R cmpl) $ >
  $ wceq T (co R (co B2 I cmap) cpws) $ >
  $ wi (wa (wcel I V) (wcel R ccrg)) (wcel Q (co W T crh)) $;

--| A polynomial over the ring ` R ` evaluates to an element in ` R ` . (Contributed by SN, 12-Mar-2025.)
theorem evlcl (ph: wff) (A2 B2 P Q R F I K V: class):
  $ wceq Q (co I R cevl) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wcel (cfv A2 (cfv F Q)) K) $;

--| Polynomial evaluation builder for addition. (Contributed by SN, 9-Feb-2025.)
theorem evladdval (ph: wff) (A2 B2 P c_pl c_pb Q S I K M N V W Z: class):
  $ wceq Q (co I S cevl) $ >
  $ wceq P (co I S cmpl) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_pb (cfv P cplusg) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wi ph (wcel I Z) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wa (wcel M B2) (wceq (cfv A2 (cfv M Q)) V)) $ >
  $ wi ph (wa (wcel N B2) (wceq (cfv A2 (cfv N Q)) W)) $ >
  $ wi ph (wa (wcel (co M N c_pb) B2) (wceq (cfv A2 (cfv (co M N c_pb) Q)) (co V W c_pl))) $;

--| Polynomial evaluation builder for multiplication. (Contributed by SN, 18-Feb-2025.)
theorem evlmulval (ph: wff) (A2 B2 P Q S c_xb c_x I K M N V W Z: class):
  $ wceq Q (co I S cevl) $ >
  $ wceq P (co I S cmpl) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_xb (cfv P cmulr) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi ph (wcel I Z) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wa (wcel M B2) (wceq (cfv A2 (cfv M Q)) V)) $ >
  $ wi ph (wa (wcel N B2) (wceq (cfv A2 (cfv N Q)) W)) $ >
  $ wi ph (wa (wcel (co M N c_xb) B2) (wceq (cfv A2 (cfv (co M N c_xb) Q)) (co V W c_x))) $;

--| The evaluation of a scalar of a subring yields the same result as evaluated as a scalar over the ring itself. (Contributed by AV, 12-Sep-2019.)
theorem evlsscasrng (ph: wff) (A2 B2 C P Q R S U I O V W X: class):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq O (co I S cevl) $ >
  $ wceq W (co I U cmpl) $ >
  $ wceq U (co S R cress) $ >
  $ wceq P (co I S cmpl) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq A2 (cfv W cascl) $ >
  $ wceq C (cfv P cascl) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel X R) $ >
  $ wi ph (wceq (cfv (cfv X A2) Q) (cfv (cfv X C) O)) $;

--| Simple polynomial evaluation maps scalars to constant functions. (Contributed by AV, 12-Sep-2019.)
theorem evlsca (ph: wff) (A2 B2 Q S I V W X: class):
  $ wceq Q (co I S cevl) $ >
  $ wceq W (co I S cmpl) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq A2 (cfv W cascl) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cfv (cfv X A2) Q) (cxp (co B2 I cmap) (csn X))) $;

--| The evaluation of the variable of polynomials over subring yields the same result as evaluated as variable of the polynomials over the ring itself. (Contributed by AV, 12-Sep-2019.)
theorem evlsvarsrng (ph: wff) (A2 B2 Q R S U I O V X: class):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq O (co I S cevl) $ >
  $ wceq V (co I U cmvr) $ >
  $ wceq U (co S R cress) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel I A2) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wceq (cfv (cfv X V) Q) (cfv (cfv X V) O)) $;

--| Simple polynomial evaluation maps variables to projections. (Contributed by AV, 12-Sep-2019.)
theorem evlvar {g2: setvar} (ph: wff g2) (B2: class) (Q: class g2) (S I: class) (V: class g2) (W X: class):
  $ wceq Q (co I S cevl) $ >
  $ wceq V (co I S cmvr) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wceq (cfv (cfv X V) Q) (cmpt g2 (co B2 I cmap) (cfv X (cv g2)))) $;

--| Constants are multivariate polynomial functions. (Contributed by Mario Carneiro, 19-Mar-2015.)
theorem mpfconst (ph: wff) (B2 Q R S I V X: class):
  $ wceq B2 (cfv S cbs) $ >
  $ wceq Q (crn (cfv R (co I S ces))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel X R) $ >
  $ wi ph (wcel (cxp (co B2 I cmap) (csn X)) Q) $;

--| Projections are multivariate polynomial functions. (Contributed by Mario Carneiro, 20-Mar-2015.)
theorem mpfproj {f2: setvar} (ph: wff f2) (B2: class) (Q: class f2) (R S I J V: class):
  $ wceq B2 (cfv S cbs) $ >
  $ wceq Q (crn (cfv R (co I S ces))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel J I) $ >
  $ wi ph (wcel (cmpt f2 (co B2 I cmap) (cfv J (cv f2))) Q) $;

--| Polynomial functions are a subring. (Contributed by Mario Carneiro, 19-Mar-2015.) (Revised by Mario Carneiro, 6-May-2015.) (Revised by AV, 19-Sep-2021.)
theorem mpfsubrg (Q R S I V: class):
  $ wceq Q (crn (cfv R (co I S ces))) $ >
  $ wi (w3a (wcel I V) (wcel S ccrg) (wcel R (cfv S csubrg))) (wcel Q (cfv (co S (co (cfv S cbs) I cmap) cpws) csubrg)) $;

--| Polynomial functions are functions. (Contributed by Mario Carneiro, 19-Mar-2015.)
theorem mpff (B2 Q R S F I: class):
  $ wceq Q (crn (cfv R (co I S ces))) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi (wcel F Q) (wf (co B2 I cmap) B2 F) $;

--| The sum of multivariate polynomial functions. (Contributed by Mario Carneiro, 19-Mar-2015.)
theorem mpfaddcl (c_pl Q R S F G I: class):
  $ wceq Q (crn (cfv R (co I S ces))) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wi (wa (wcel F Q) (wcel G Q)) (wcel (co F G (cof c_pl)) Q) $;

--| The product of multivariate polynomial functions. (Contributed by Mario Carneiro, 19-Mar-2015.)
theorem mpfmulcl (Q R S c_x F G I: class):
  $ wceq Q (crn (cfv R (co I S ces))) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi (wa (wcel F Q) (wcel G Q)) (wcel (co F G (cof c_x)) Q) $;

--| Prove a property of polynomials by "structural" induction, under a simplified model of structure which loses the sum of products structure. (Contributed by Mario Carneiro, 19-Mar-2015.)
theorem mpfind {x3 f2 g2: setvar} (ph ps: wff x3) (ch th ta et ze si rh: wff f2 g2) (A2: class f2 g2) (B2 c_pl: class) (Q R S: class x3) (c_x I: class):
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wceq Q (crn (cfv R (co I S ces))) $ >
  $ wi (wa ph (wa (wa (wcel (cv f2) Q) ta) (wa (wcel (cv g2) Q) et))) ze $ >
  $ wi (wa ph (wa (wa (wcel (cv f2) Q) ta) (wa (wcel (cv g2) Q) et))) si $ >
  $ wi (wceq (cv x3) (cxp (co B2 I cmap) (csn (cv f2)))) (wb ps ch) $ >
  $ wi (wceq (cv x3) (cmpt g2 (co B2 I cmap) (cfv (cv f2) (cv g2)))) (wb ps th) $ >
  $ wi (wceq (cv x3) (cv f2)) (wb ps ta) $ >
  $ wi (wceq (cv x3) (cv g2)) (wb ps et) $ >
  $ wi (wceq (cv x3) (co (cv f2) (cv g2) (cof c_pl))) (wb ps ze) $ >
  $ wi (wceq (cv x3) (co (cv f2) (cv g2) (cof c_x))) (wb ps si) $ >
  $ wi (wceq (cv x3) A2) (wb ps rh) $ >
  $ wi (wa ph (wcel (cv f2) R)) ch $ >
  $ wi (wa ph (wcel (cv f2) I)) th $ >
  $ wi ph (wcel A2 Q) $ >
  $ wi ph rh $;

--| Select a subset of variables in a multivariate polynomial.
term cslv: class;

--| Define the "variable selection" function. The function ` ( ( I selectVars R ) `` J ) ` maps elements of ` ( I mPoly R ) ` bijectively onto ` ( J mPoly ( ( I \ J ) mPoly R ) ) ` in the natural way, for example if ` I = { x , y } ` and ` J = { y } ` it would map ` 1 + x + y + x y e. ( { x , y } mPoly ZZ ) ` to ` ( 1 + x ) + ( 1 + x ) y e. ( { y } mPoly ( { x } mPoly ZZ ) ) ` . This, for example, allows one to treat a multivariate polynomial as a univariate polynomial with coefficients in a polynomial ring with one less variable. (Contributed by Mario Carneiro, 21-Mar-2015.)
axiom df_selv {x3 u t f2 i j r c d: setvar}:
  $ wceq cslv (cmpo i r cvv cvv (cmpt j (cpw (cv i)) (cmpt f2 (cfv (co (cv i) (cv r) cmpl) cbs) (csb u (co (cdif (cv i) (cv j)) (cv r) cmpl) (csb t (co (cv j) (cv u) cmpl) (csb c (cfv (cv t) cascl) (csb d (ccom (cv c) (cfv (cv u) cascl)) (cfv (cmpt x3 (cv i) (cif (wcel (cv x3) (cv j)) (cfv (cv x3) (co (cv j) (cv u) cmvr)) (cfv (cfv (cv x3) (co (cdif (cv i) (cv j)) (cv r) cmvr)) (cv c)))) (cfv (ccom (cv d) (cv f2)) (cfv (crn (cv d)) (co (cv i) (cv t) ces))))))))))) $;

--| Value of the "variable selection" function. (Contributed by SN, 4-Nov-2023.)
theorem selvffval {x3 u t f2 j c d: setvar} (ph: wff x3 u t f2 j c d) (R I: class) (V W: class x3 u t f2 j c d):
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wi ph (wceq (co I R cslv) (cmpt j (cpw I) (cmpt f2 (cfv (co I R cmpl) cbs) (csb u (co (cdif I (cv j)) R cmpl) (csb t (co (cv j) (cv u) cmpl) (csb c (cfv (cv t) cascl) (csb d (ccom (cv c) (cfv (cv u) cascl)) (cfv (cmpt x3 I (cif (wcel (cv x3) (cv j)) (cfv (cv x3) (co (cv j) (cv u) cmvr)) (cfv (cfv (cv x3) (co (cdif I (cv j)) R cmvr)) (cv c)))) (cfv (ccom (cv d) (cv f2)) (cfv (crn (cv d)) (co I (cv t) ces))))))))))) $;

--| Value of the "variable selection" function. (Contributed by SN, 4-Nov-2023.)
theorem selvfval {x3 u t f2 c d: setvar} (ph: wff x3 u t f2 c d) (R I J: class) (V W: class x3 u t f2 c d):
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wi ph (wss J I) $ >
  $ wi ph (wceq (cfv J (co I R cslv)) (cmpt f2 (cfv (co I R cmpl) cbs) (csb u (co (cdif I J) R cmpl) (csb t (co J (cv u) cmpl) (csb c (cfv (cv t) cascl) (csb d (ccom (cv c) (cfv (cv u) cascl)) (cfv (cmpt x3 I (cif (wcel (cv x3) J) (cfv (cv x3) (co J (cv u) cmvr)) (cfv (cfv (cv x3) (co (cdif I J) R cmvr)) (cv c)))) (cfv (ccom (cv d) (cv f2)) (cfv (crn (cv d)) (co I (cv t) ces)))))))))) $;

--| Value of the "variable selection" function. (Contributed by SN, 4-Nov-2023.)
theorem selvval {x3: setvar} (ph: wff x3) (B2: class x3) (C: class) (D P: class x3) (R: class) (T: class x3) (U: class) (F: class x3) (I J: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq U (co (cdif I J) R cmpl) $ >
  $ wceq T (co J U cmpl) $ >
  $ wceq C (cfv T cascl) $ >
  $ wceq D (ccom C (cfv U cascl)) $ >
  $ wi ph (wss J I) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wceq (cfv F (cfv J (co I R cslv))) (cfv (cmpt x3 I (cif (wcel (cv x3) J) (cfv (cv x3) (co J U cmvr)) (cfv (cfv (cv x3) (co (cdif I J) R cmvr)) C))) (cfv (ccom D F) (cfv (crn D) (co I T ces))))) $;

--| The composition of a monoid homomorphism and a polynomial is a polynomial. (Contributed by SN, 7-Feb-2025.)
theorem mhmcompl (ph: wff) (B2 C P Q R S F H I: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq Q (co I S cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq C (cfv Q cbs) $ >
  $ wi ph (wcel H (co R S cmhm)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel (ccom H F) C) $;

--| The function ` H ` mapping polynomials ` p ` to their coefficient given a bag of variables ` F ` is a group homomorphism. (Contributed by SN, 15-Mar-2025.)
theorem mplmapghm {f2 p: setvar} (ph: wff f2) (B2: class f2) (D: class f2 p) (P R F: class f2) (H: class f2 p) (I: class p) (V: class f2 p):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq H (cmpt p B2 (cfv F (cv p))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wcel H (co P R cghm)) $;

--| Show that the ring homomorphism in ~ rhmmpl preserves addition. (Contributed by SN, 8-Feb-2025.)
theorem mhmcoaddmpl (ph: wff) (B2 C P c_pl c_pb Q R S F G H I: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq Q (co I S cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq C (cfv Q cbs) $ >
  $ wceq c_pl (cfv P cplusg) $ >
  $ wceq c_pb (cfv Q cplusg) $ >
  $ wi ph (wcel H (co R S cmhm)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wi ph (wceq (ccom H (co F G c_pl)) (co (ccom H F) (ccom H G) c_pb)) $;

--| Show that the ring homomorphism in ~ rhmmpl preserves multiplication. (Contributed by SN, 8-Feb-2025.)
theorem rhmcomulmpl (ph: wff) (B2 C P Q R S c_xb c_x F G H I: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq Q (co I S cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq C (cfv Q cbs) $ >
  $ wceq c_x (cfv P cmulr) $ >
  $ wceq c_xb (cfv Q cmulr) $ >
  $ wi ph (wcel H (co R S crh)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wi ph (wceq (ccom H (co F G c_x)) (co (ccom H F) (ccom H G) c_xb)) $;

--| A polynomial over the ring ` R ` evaluates to an element in ` R ` . (Contributed by SN, 12-Mar-2025.)
theorem evlscl (ph: wff) (A2 B2 P Q R S U F I K V: class):
  $ wceq Q (cfv S (co I R ces)) $ >
  $ wceq P (co I U cmpl) $ >
  $ wceq U (co R S cress) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wcel (cfv A2 (cfv F Q)) K) $;

--| Polynomial evaluation builder for a scalar. Compare ~ evl1scad . Note that scalar multiplication by ` X ` is the same as vector multiplication by ` ( A `` X ) ` by ~ asclmul1 . (Contributed by SN, 27-Jul-2024.)
theorem evlsscaval (ph: wff) (A2 B2 P Q R S U I K L V X: class):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq P (co I U cmpl) $ >
  $ wceq U (co S R cress) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel X R) $ >
  $ wi ph (wcel L (co K I cmap)) $ >
  $ wi ph (wa (wcel (cfv X A2) B2) (wceq (cfv L (cfv (cfv X A2) Q)) X)) $;

--| Polynomial evaluation builder for a variable. (Contributed by SN, 27-Jul-2024.)
theorem evlsvarval (ph: wff) (A2 B2 P Q R S U I K V W X: class):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq P (co I U cmpl) $ >
  $ wceq V (co I U cmvr) $ >
  $ wceq U (co S R cress) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wa (wcel (cfv X V) B2) (wceq (cfv A2 (cfv (cfv X V) Q)) (cfv X A2))) $;

--| Polynomial evaluation builder for exponentiation. (Contributed by SN, 27-Jul-2024.)
theorem evlsexpval (ph: wff) (A2 B2 P Q R S c_xb U c_ex I K M N V Z: class):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq P (co I U cmpl) $ >
  $ wceq U (co S R cress) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wcel I Z) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wa (wcel M B2) (wceq (cfv A2 (cfv M Q)) V)) $ >
  $ wceq c_xb (cfv (cfv P cmgp) cmg) $ >
  $ wceq c_ex (cfv (cfv S cmgp) cmg) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wa (wcel (co N M c_xb) B2) (wceq (cfv A2 (cfv (co N M c_xb) Q)) (co N V c_ex))) $;

--| Polynomial evaluation builder for addition. (Contributed by SN, 27-Jul-2024.)
theorem evlsaddval (ph: wff) (A2 B2 P c_pl c_pb Q R S U I K M N V W Z: class):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq P (co I U cmpl) $ >
  $ wceq U (co S R cress) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wcel I Z) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wa (wcel M B2) (wceq (cfv A2 (cfv M Q)) V)) $ >
  $ wi ph (wa (wcel N B2) (wceq (cfv A2 (cfv N Q)) W)) $ >
  $ wceq c_pb (cfv P cplusg) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wi ph (wa (wcel (co M N c_pb) B2) (wceq (cfv A2 (cfv (co M N c_pb) Q)) (co V W c_pl))) $;

--| Polynomial evaluation builder for multiplication. (Contributed by SN, 27-Jul-2024.)
theorem evlsmulval (ph: wff) (A2 B2 P Q R S c_xb c_x U I K M N V W Z: class):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq P (co I U cmpl) $ >
  $ wceq U (co S R cress) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wcel I Z) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wa (wcel M B2) (wceq (cfv A2 (cfv M Q)) V)) $ >
  $ wi ph (wa (wcel N B2) (wceq (cfv A2 (cfv N Q)) W)) $ >
  $ wceq c_xb (cfv P cmulr) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi ph (wa (wcel (co M N c_xb) B2) (wceq (cfv A2 (cfv (co M N c_xb) Q)) (co V W c_x))) $;

--| The function ` F ` mapping polynomials ` p ` to their subring evaluation at a given point ` X ` is a ring homomorphism. Compare ~ evls1maprhm . (Contributed by SN, 12-Mar-2025.)
theorem evlsmaprhm {p: setvar} (ph: wff) (A2 B2 P Q: class) (R S U F I: class p) (K: class) (V: class p):
  $ wceq Q (cfv S (co I R ces)) $ >
  $ wceq P (co I U cmpl) $ >
  $ wceq U (co R S cress) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq F (cmpt p B2 (cfv A2 (cfv (cv p) Q))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wcel F (co P R crh)) $;

--| Evaluation in a subring is the same as evaluation in the ring itself. (Contributed by SN, 9-Feb-2025.)
theorem evlsevl (ph: wff) (B2 Q R S U F I O V W: class):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq O (co I S cevl) $ >
  $ wceq W (co I U cmpl) $ >
  $ wceq U (co S R cress) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wceq (cfv F Q) (cfv F O)) $;

--| Give a formula for the evaluation of a polynomial given assignments from variables to values. (Contributed by SN, 5-Mar-2025.)
theorem evlvvval {h i b: setvar} (ph: wff h) (A2: class h) (B2: class h i) (D: class h) (P: class h i) (Q: class h i b) (R: class) (c_x c_ex: class h i b) (F: class h i) (I: class) (K: class h) (M V: class h i b):
  $ wceq Q (co I R cevl) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq c_ex (cfv M cmg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wceq (cfv A2 (cfv F Q)) (co R (cmpt b D (co (cfv (cv b) F) (co M (cmpt i I (co (cfv (cv i) (cv b)) (cfv (cv i) A2) c_ex)) cgsu) c_x)) cgsu)) $;

--| ` T ` is an associative algebra. For simplicity, ` I ` stands for ` ( I \ J ) ` and we have ` J e. W ` instead of ` J C_ I ` . (Contributed by SN, 15-Dec-2023.)
theorem selvcllem1 (ph: wff) (R T U I J V W: class):
  $ wceq U (co I R cmpl) $ >
  $ wceq T (co J U cmpl) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel J W) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel T casa) $;

--| ` D ` is a ring homomorphism. (Contributed by SN, 15-Dec-2023.)
theorem selvcllem2 (ph: wff) (C D R T U I J V W: class):
  $ wceq U (co I R cmpl) $ >
  $ wceq T (co J U cmpl) $ >
  $ wceq C (cfv T cascl) $ >
  $ wceq D (ccom C (cfv U cascl)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel J W) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel D (co R T crh)) $;

--| The third argument passed to ` evalSub ` is in the domain. (Contributed by SN, 15-Dec-2023.)
theorem selvcllem3 (ph: wff) (C D R T U I J V W: class):
  $ wceq U (co I R cmpl) $ >
  $ wceq T (co J U cmpl) $ >
  $ wceq C (cfv T cascl) $ >
  $ wceq D (ccom C (cfv U cascl)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel J W) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel (crn D) (cfv T csubrg)) $;

--| Apply the third argument ( ~ selvcllem3 ) to show that ` Q ` is a (ring) homomorphism. (Contributed by SN, 5-Nov-2023.)
theorem selvcllemh (ph: wff) (B2 C D Q R S T U I J V W X: class):
  $ wceq U (co (cdif I J) R cmpl) $ >
  $ wceq T (co J U cmpl) $ >
  $ wceq C (cfv T cascl) $ >
  $ wceq D (ccom C (cfv U cascl)) $ >
  $ wceq Q (cfv (crn D) (co I T ces)) $ >
  $ wceq W (co I S cmpl) $ >
  $ wceq S (co T (crn D) cress) $ >
  $ wceq X (co T (co B2 I cmap) cpws) $ >
  $ wceq B2 (cfv T cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wss J I) $ >
  $ wi ph (wcel Q (co W X crh)) $;

--| The fourth argument passed to ` evalSub ` is in the domain (a polynomial in ` ( I mPoly ( J mPoly ( ( I \ J ) mPoly R ) ) ) ` ). (Contributed by SN, 5-Nov-2023.)
theorem selvcllem4 (ph: wff) (B2 C D P R S T U F I J W X: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq U (co (cdif I J) R cmpl) $ >
  $ wceq T (co J U cmpl) $ >
  $ wceq C (cfv T cascl) $ >
  $ wceq D (ccom C (cfv U cascl)) $ >
  $ wceq S (co T (crn D) cress) $ >
  $ wceq W (co I S cmpl) $ >
  $ wceq X (cfv W cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wss J I) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel (ccom D F) X) $;

--| The fifth argument passed to ` evalSub ` is in the domain (a function ` I --> E ` ). (Contributed by SN, 22-Feb-2024.)
theorem selvcllem5 {x3: setvar} (ph: wff) (C R T U: class x3) (E: class) (F: class x3) (I: class) (J V: class x3):
  $ wceq U (co (cdif I J) R cmpl) $ >
  $ wceq T (co J U cmpl) $ >
  $ wceq C (cfv T cascl) $ >
  $ wceq E (cfv T cbs) $ >
  $ wceq F (cmpt x3 I (cif (wcel (cv x3) J) (cfv (cv x3) (co J U cmvr)) (cfv (cfv (cv x3) (co (cdif I J) R cmvr)) C))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wss J I) $ >
  $ wi ph (wcel F (co E I cmap)) $;

--| Closure of the "variable selection" function. (Contributed by SN, 22-Feb-2024.)
theorem selvcl (ph: wff) (B2 P R T U E F I J: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq U (co (cdif I J) R cmpl) $ >
  $ wceq T (co J U cmpl) $ >
  $ wceq E (cfv T cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wss J I) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel (cfv F (cfv J (co I R cslv))) E) $;

--| Value of the "variable selection" function. Convert ~ selvval into a simpler form by using ~ evlsevl . (Contributed by SN, 9-Feb-2025.)
theorem selvval2 {x3: setvar} (ph: wff x3) (B2: class x3) (C: class) (D P: class x3) (R: class) (T: class x3) (U: class) (F: class x3) (I J: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq U (co (cdif I J) R cmpl) $ >
  $ wceq T (co J U cmpl) $ >
  $ wceq C (cfv T cascl) $ >
  $ wceq D (ccom C (cfv U cascl)) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wss J I) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wceq (cfv F (cfv J (co I R cslv))) (cfv (cmpt x3 I (cif (wcel (cv x3) J) (cfv (cv x3) (co J U cmvr)) (cfv (cfv (cv x3) (co (cdif I J) R cmvr)) C))) (cfv (ccom D F) (co I T cevl)))) $;

--| Recover the original polynomial from a ` selectVars ` application. (Contributed by SN, 15-Mar-2025.)
theorem selvvvval {h: setvar} (ph: wff h) (B2 D P: class h) (R: class) (F: class h) (I J Y: class):
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wss J I) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel Y D) $ >
  $ wi ph (wceq (cfv (cres Y (cdif I J)) (cfv (cres Y J) (cfv F (cfv J (co I R cslv))))) (cfv Y F)) $;

--| The "variable selection" function is additive. (Contributed by SN, 7-Feb-2025.)
theorem selvadd (ph: wff) (B2 P c_pl c_pb R T U F G I J V: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_pl (cfv P cplusg) $ >
  $ wceq U (co (cdif I J) R cmpl) $ >
  $ wceq T (co J U cmpl) $ >
  $ wceq c_pb (cfv T cplusg) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wss J I) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wi ph (wceq (cfv (co F G c_pl) (cfv J (co I R cslv))) (co (cfv F (cfv J (co I R cslv))) (cfv G (cfv J (co I R cslv))) c_pb)) $;

--| The "variable selection" function is multiplicative. (Contributed by SN, 18-Feb-2025.)
theorem selvmul (ph: wff) (B2 P R c_xb T c_x U F G I J V: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_x (cfv P cmulr) $ >
  $ wceq U (co (cdif I J) R cmpl) $ >
  $ wceq T (co J U cmpl) $ >
  $ wceq c_xb (cfv T cmulr) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wss J I) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wi ph (wceq (cfv (co F G c_x) (cfv J (co I R cslv))) (co (cfv F (cfv J (co I R cslv))) (cfv G (cfv J (co I R cslv))) c_xb)) $;

--| Multivariate polynomials.
term cmhp: class;

--| Power series partial derivative function.
term cpsd: class;

--| Algebraically independent.
term cai: class;

--| Define the subspaces of order- ` n ` homogeneous polynomials. (Contributed by Mario Carneiro, 21-Mar-2015.)
axiom df_mhp {f2 g2 h i n r: setvar}:
  $ wceq cmhp (cmpo i r cvv cvv (cmpt n cn0 (crab f2 (wss (co (cv f2) (cfv (cv r) c0g) csupp) (crab g2 (wceq (co (co ccnfld cn0 cress) (cv g2) cgsu) (cv n)) (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 (cv i) cmap)))) (cfv (co (cv i) (cv r) cmpl) cbs)))) $;

--| The domain of the homogeneous polynomial operator is a relation. (Contributed by SN, 18-May-2025.)
theorem reldmmhp:
  $ wrel (cdm cmhp) $;

--| Value of the "homogeneous polynomial" operator. (Contributed by Steven Nguyen, 25-Aug-2023.)
theorem mhpfval {f2 g2 h n: setvar} (ph: wff f2 g2 h n) (B2: class g2 h n) (D: class f2 h n) (P: class f2 g2 h n) (R: class g2 h) (H: class f2 g2 h n) (I: class g2) (V W c_0: class f2 g2 h n):
  $ wceq H (co I R cmhp) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wi ph (wceq H (cmpt n cn0 (crab f2 (wss (co (cv f2) c_0 csupp) (crab g2 (wceq (co (co ccnfld cn0 cress) (cv g2) cgsu) (cv n)) D)) B2))) $;

--| Value of the "homogeneous polynomial" function. (Contributed by Steven Nguyen, 25-Aug-2023.)
theorem mhpval {f2 g2 h: setvar} (ph: wff f2 g2 h) (B2: class g2 h) (D: class f2 h) (P: class f2 g2 h) (R: class g2 h) (H: class f2 g2 h) (I: class g2) (N: class h) (V W c_0: class f2 g2 h):
  $ wceq H (co I R cmhp) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (cfv N H) (crab f2 (wss (co (cv f2) c_0 csupp) (crab g2 (wceq (co (co ccnfld cn0 cress) (cv g2) cgsu) N) D)) B2)) $;

--| Property of being a homogeneous polynomial. (Contributed by Steven Nguyen, 25-Aug-2023.)
theorem ismhp {g2 h: setvar} (ph: wff g2 h) (B2: class g2 h) (D: class h) (P R H: class g2 h) (I: class g2) (N: class h) (X c_0: class g2 h):
  $ wceq H (co I R cmhp) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wb (wcel X (cfv N H)) (wa (wcel X B2) (wss (co X c_0 csupp) (crab g2 (wceq (co (co ccnfld cn0 cress) (cv g2) cgsu) N) D)))) $;

--| Deduce a homogeneous polynomial from its properties. (Contributed by SN, 25-May-2024.)
theorem ismhp2 {g2 h: setvar} (ph: wff g2 h) (B2: class g2 h) (D: class h) (P R H: class g2 h) (I: class g2) (N: class h) (X c_0: class g2 h):
  $ wceq H (co I R cmhp) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wss (co X c_0 csupp) (crab g2 (wceq (co (co ccnfld cn0 cress) (cv g2) cgsu) N) D)) $ >
  $ wi ph (wcel X (cfv N H)) $;

--| A polynomial is homogeneous iff the degree of every nonzero term is the same. (Contributed by SN, 22-Jul-2024.)
theorem ismhp3 {h d: setvar} (ph: wff h) (B2: class h d) (D: class h) (P R H: class h d) (I: class d) (N X c_0: class h):
  $ wceq H (co I R cmhp) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wb (wcel X (cfv N H)) (wral d (wi (wne (cfv (cv d) X) c_0) (wceq (co (co ccnfld cn0 cress) (cv d) cgsu) N)) D)) $;

--| Reverse closure for homogeneous polynomials, use ~ elfvov1 and ~ elfvov2 with ~ reldmmhp for the reverse closure of ` I ` and ` R ` . (Contributed by SN, 4-Aug-2025.)
theorem mhprcl (ph: wff) (R H I N X: class):
  $ wceq H (co I R cmhp) $ >
  $ wi ph (wcel X (cfv N H)) $ >
  $ wi ph (wcel N cn0) $;

--| A homogeneous polynomial is a polynomial. (Contributed by Steven Nguyen, 25-Aug-2023.)
theorem mhpmpl (ph: wff) (B2 P R H I N X: class):
  $ wceq H (co I R cmhp) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wcel X (cfv N H)) $ >
  $ wi ph (wcel X B2) $;

--| All nonzero terms of a homogeneous polynomial have degree ` N ` . (Contributed by Steven Nguyen, 25-Aug-2023.)
theorem mhpdeg {g2 h: setvar} (ph: wff g2 h) (D: class h) (R H: class g2 h) (I: class g2) (N: class h) (X c_0: class g2 h):
  $ wceq H (co I R cmhp) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel X (cfv N H)) $ >
  $ wi ph (wss (co X c_0 csupp) (crab g2 (wceq (co (co ccnfld cn0 cress) (cv g2) cgsu) N) D)) $;

--| The zero polynomial is homogeneous. Under ~ df-mhp , it has any (nonnegative integer) degree which loosely corresponds to the value "undefined". The values ` -oo ` and ` 0 ` are also used in Metamath (by ~ df-mdeg and ~ df-dgr respectively) and the literature: ~ https://math.stackexchange.com/a/1796314/593843 . (Contributed by SN, 12-Sep-2023.)
theorem mhp0cl {h: setvar} (ph: wff h) (D R H: class h) (I: class) (N V c_0: class h):
  $ wceq H (co I R cmhp) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel (cxp D (csn c_0)) (cfv N H)) $;

--| A scalar (or constant) polynomial has degree 0. Compare ~ deg1scl . In other contexts, there may be an exception for the zero polynomial, but under ~ df-mhp the zero polynomial can be any degree (see ~ mhp0cl ) so there is no exception. (Contributed by SN, 25-May-2024.)
theorem mhpsclcl (ph: wff) (A2 C P R H I K V: class):
  $ wceq H (co I R cmhp) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wcel (cfv C A2) (cfv cc0 H)) $;

--| A power series variable is a polynomial of degree 1. (Contributed by SN, 25-May-2024.)
theorem mhpvarcl (ph: wff) (R H I V W X: class):
  $ wceq H (co I R cmhp) $ >
  $ wceq V (co I R cmvr) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel (cfv X V) (cfv c1 H)) $;

--| A product of homogeneous polynomials is a homogeneous polynomial whose degree is the sum of the degrees of the factors. Compare ~ mdegmulle2 (which shows less-than-or-equal instead of equal). (Contributed by SN, 22-Jul-2024.) Remove closure hypotheses. (Revised by SN, 4-Sep-2025.)
theorem mhpmulcl (ph: wff) (P Q R c_x H I M N Y: class):
  $ wceq H (co I R cmhp) $ >
  $ wceq Y (co I R cmpl) $ >
  $ wceq c_x (cfv Y cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel P (cfv M H)) $ >
  $ wi ph (wcel Q (cfv N H)) $ >
  $ wi ph (wcel (co P Q c_x) (cfv (co M N caddc) H)) $;

--| Degree of a homogeneous polynomial raised to a power. General version of ~ deg1pw . (Contributed by SN, 26-Jul-2024.) Remove closure hypotheses. (Revised by SN, 4-Sep-2025.)
theorem mhppwdeg (ph: wff) (P R T c_ex H I M N X: class):
  $ wceq H (co I R cmhp) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq T (cfv P cmgp) $ >
  $ wceq c_ex (cfv T cmg) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel X (cfv M H)) $ >
  $ wi ph (wcel (co N X c_ex) (cfv (co M N cmul) H)) $;

--| Homogeneous polynomials are closed under addition. (Contributed by SN, 26-Aug-2023.) Remove closure hypotheses. (Revised by SN, 4-Sep-2025.)
theorem mhpaddcl (ph: wff) (P c_pl R H I N X Y: class):
  $ wceq H (co I R cmhp) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq c_pl (cfv P cplusg) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wi ph (wcel X (cfv N H)) $ >
  $ wi ph (wcel Y (cfv N H)) $ >
  $ wi ph (wcel (co X Y c_pl) (cfv N H)) $;

--| Homogeneous polynomials are closed under taking the opposite. (Contributed by SN, 12-Sep-2023.) Remove closure hypotheses. (Revised by SN, 4-Sep-2025.)
theorem mhpinvcl (ph: wff) (P R H I M N X: class):
  $ wceq H (co I R cmhp) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq M (cfv P cminusg) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wi ph (wcel X (cfv N H)) $ >
  $ wi ph (wcel (cfv X M) (cfv N H)) $;

--| Homogeneous polynomials form a subgroup of the polynomials. (Contributed by SN, 25-Sep-2023.)
theorem mhpsubg (ph: wff) (P R H I N V: class):
  $ wceq H (co I R cmhp) $ >
  $ wceq P (co I R cmpl) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel (cfv N H) (cfv P csubg)) $;

--| Homogeneous polynomials are closed under scalar multiplication. (Contributed by SN, 25-Sep-2023.) Remove closure hypotheses. (Revised by SN, 4-Sep-2025.)
theorem mhpvscacl (ph: wff) (P R c_x F H I K N X: class):
  $ wceq H (co I R cmhp) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel F (cfv N H)) $ >
  $ wi ph (wcel (co X F c_x) (cfv N H)) $;

--| Homogeneous polynomials form a linear subspace of the polynomials. (Contributed by SN, 25-Sep-2023.)
theorem mhplss (ph: wff) (P R H I N V: class):
  $ wceq H (co I R cmhp) $ >
  $ wceq P (co I R cmpl) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel (cfv N H) (cfv P clss)) $;

--| Define the differentiation operation on multivariate polynomials. ` ( ( ( I mPSDer R ) `` X ) `` F ) ` is the partial derivative of the polynomial ` F ` with respect to ` X ` . (Contributed by Mario Carneiro, 21-Mar-2015.)
axiom df_psd {x3 y1 f2 h i k r: setvar}:
  $ wceq cpsd (cmpo i r cvv cvv (cmpt x3 (cv i) (cmpt f2 (cfv (co (cv i) (cv r) cmps) cbs) (cmpt k (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 (cv i) cmap)) (co (co (cfv (cv x3) (cv k)) c1 caddc) (cfv (co (cv k) (cmpt y1 (cv i) (cif (wceq (cv y1) (cv x3)) c1 cc0)) (cof caddc)) (cv f2)) (cfv (cv r) cmg)))))) $;

--| Value of the power series differentiation operation. (Contributed by SN, 11-Apr-2025.)
theorem psdffval {x3 y1 f2 h k: setvar} (ph: wff x3 y1 f2 h k) (B2 D: class x3 y1 f2 h k) (R: class y1 h) (S: class x3 y1 f2 h k) (I: class) (V W: class x3 y1 f2 h k):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wi ph (wceq (co I R cpsd) (cmpt x3 I (cmpt f2 B2 (cmpt k D (co (co (cfv (cv x3) (cv k)) c1 caddc) (cfv (co (cv k) (cmpt y1 I (cif (wceq (cv y1) (cv x3)) c1 cc0)) (cof caddc)) (cv f2)) (cfv R cmg)))))) $;

--| Give a map between power series and their partial derivatives with respect to a given variable ` X ` . (Contributed by SN, 11-Apr-2025.)
theorem psdfval {y1 f2 h k: setvar} (ph: wff y1 f2 h k) (B2: class y1 h k) (D: class y1 f2 h k) (R: class y1 h) (S: class y1 f2 h k) (I: class) (V W: class y1 f2 h k) (X: class h):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wceq (cfv X (co I R cpsd)) (cmpt f2 B2 (cmpt k D (co (co (cfv X (cv k)) c1 caddc) (cfv (co (cv k) (cmpt y1 I (cif (wceq (cv y1) X) c1 cc0)) (cof caddc)) (cv f2)) (cfv R cmg))))) $;

--| Evaluate the partial derivative of a power series ` F ` with respect to ` X ` . (Contributed by SN, 11-Apr-2025.)
theorem psdval {y1 h k: setvar} (ph: wff y1 h k) (B2: class y1 h k) (D R: class y1 h) (S: class y1 h k) (F: class y1 h) (I: class) (X: class h):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wceq (cfv F (cfv X (co I R cpsd))) (cmpt k D (co (co (cfv X (cv k)) c1 caddc) (cfv (co (cv k) (cmpt y1 I (cif (wceq (cv y1) X) c1 cc0)) (cof caddc)) F) (cfv R cmg)))) $;

--| Coefficient of a term of the derivative of a power series. (Contributed by SN, 12-Apr-2025.)
theorem psdcoef {y1 h: setvar} (ph: wff y1 h) (B2 D R S F: class y1 h) (I: class) (K: class y1 h) (X: class h):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel K D) $ >
  $ wi ph (wceq (cfv K (cfv F (cfv X (co I R cpsd)))) (co (co (cfv X K) c1 caddc) (cfv (co K (cmpt y1 I (cif (wceq (cv y1) X) c1 cc0)) (cof caddc)) F) (cfv R cmg))) $;

--| The derivative of a power series is a power series. (Contributed by SN, 11-Apr-2025.)
theorem psdcl (ph: wff) (B2 R S F I X: class):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel R cmgm) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel (cfv F (cfv X (co I R cpsd))) B2) $;

--| The derivative of a polynomial is a polynomial. (Contributed by SN, 12-Apr-2025.)
theorem psdmplcl (ph: wff) (B2 P R F I X: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wcel R cmnd) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel (cfv F (cfv X (co I R cpsd))) B2) $;

--| The derivative of a sum is the sum of the derivatives. (Contributed by SN, 12-Apr-2025.)
theorem psdadd (ph: wff) (B2 c_pl R S F G I X: class):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wi ph (wcel R ccmn) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wi ph (wceq (cfv (co F G c_pl) (cfv X (co I R cpsd))) (co (cfv F (cfv X (co I R cpsd))) (cfv G (cfv X (co I R cpsd))) c_pl)) $;

--| The derivative of a scaled power series is the scaled derivative. (Contributed by SN, 12-Apr-2025.)
theorem psdvsca (ph: wff) (B2 C R S c_x F I K X: class):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_x (cfv S cvsca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wceq (cfv (co C F c_x) (cfv X (co I R cpsd))) (co C (cfv F (cfv X (co I R cpsd))) c_x)) $;

--| Lemma for ~ psdmul . Transitive law for union of class difference. (Contributed by SN, 5-May-2025.)
theorem psdmullem (ph: wff) (A2 B2 C: class):
  $ wi ph (wss C B2) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wceq (cun (cdif A2 B2) (cdif B2 C)) (cdif A2 C)) $;

--| Product rule for power series. An outline is available at ~ https://github.com/icecream17/Stuff/blob/main/math/psdmul.pdf . (Contributed by SN, 25-Apr-2025.)
theorem psdmul (ph: wff) (B2 c_pl R S c_x F G I X: class):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wi ph (wceq (cfv (co F G c_x) (cfv X (co I R cpsd))) (co (co (cfv F (cfv X (co I R cpsd))) G c_x) (co F (cfv G (cfv X (co I R cpsd))) c_x) c_pl)) $;

--| The derivative of one is zero. (Contributed by SN, 25-Apr-2025.)
theorem psd1 (ph: wff) (R S c_1 I V X c_0: class):
  $ wceq S (co I R cmps) $ >
  $ wceq c_1 (cfv S cur) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wceq (cfv c_1 (cfv X (co I R cpsd))) c_0) $;

--| The derivative of a constant polynomial is zero. (Contributed by SN, 25-Apr-2025.)
theorem psdascl (ph: wff) (A2 B2 C R S I V X c_0: class):
  $ wceq S (co I R cmps) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq A2 (cfv S cascl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel C B2) $ >
  $ wi ph (wceq (cfv (cfv C A2) (cfv X (co I R cpsd))) c_0) $;

--| The partial derivative of a variable is the Kronecker delta ` if ( X = Y , .1. , .0. ) ` . (Contributed by SN, 16-Oct-2025.)
theorem psdmvr (ph: wff) (R S c_1 I V W X Y c_0: class):
  $ wceq S (co I R cmps) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq c_1 (cfv S cur) $ >
  $ wceq V (co I R cmvr) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel Y I) $ >
  $ wi ph (wceq (cfv (cfv Y V) (cfv X (co I R cpsd))) (cif (wceq X Y) c_1 c_0)) $;

--| Power rule for partial derivative of power series. (Contributed by SN, 25-Apr-2025.)
theorem psdpw (ph: wff) (B2 R S c_xb c_x c_ex F I M N X: class):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_x (cfv S cmg) $ >
  $ wceq c_xb (cfv S cmulr) $ >
  $ wceq M (cfv S cmgp) $ >
  $ wceq c_ex (cfv M cmg) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq (cfv (co N F c_ex) (cfv X (co I R cpsd))) (co (co N (co (co N c1 cmin) F c_ex) c_x) (cfv F (cfv X (co I R cpsd))) c_xb)) $;

--| Define the predicate "the set ` v ` is algebraically independent in the algebra ` w ` ". A collection of vectors is algebraically independent if no nontrivial polynomial with elements from the subset evaluates to zero. (Contributed by Mario Carneiro, 21-Mar-2015.)
axiom df_algind {w v f2 k: setvar}:
  $ wceq cai (cmpo w k cvv (cpw (cfv (cv w) cbs)) (crab v (wfun (ccnv (cmpt f2 (cfv (co (cv v) (co (cv w) (cv k) cress) cmpl) cbs) (cfv (cres cid (cv v)) (cfv (cv f2) (cfv (cv k) (co (cv v) (cv w) ces))))))) (cpw (cfv (cv w) cbs)))) $;

--| Univariate power series.
term cps1: class;

--| The base variable of a univariate power series.
term cv1: class;

--| Univariate polynomials.
term cpl1: class;

--| Coefficient function for a univariate polynomial.
term cco1: class;

--| Convert a univariate polynomial representation to multivariate.
term ctp1: class;

--| Define the algebra of univariate power series. (Contributed by Mario Carneiro, 29-Dec-2014.)
axiom df_psr1 {r: setvar}:
  $ wceq cps1 (cmpt r cvv (cfv c0 (co c1o (cv r) copws))) $;

--| Define the base element of a univariate power series (the ` X ` element of the set ` R [ X ] ` of polynomials and also the ` X ` in the set ` R [ [ X ] ] ` of power series). (Contributed by Mario Carneiro, 8-Feb-2015.)
axiom df_vr1 {r: setvar}:
  $ wceq cv1 (cmpt r cvv (cfv c0 (co c1o (cv r) cmvr))) $;

--| Define the algebra of univariate polynomials. (Contributed by Mario Carneiro, 9-Feb-2015.)
axiom df_ply1 {r: setvar}:
  $ wceq cpl1 (cmpt r cvv (co (cfv (cv r) cps1) (cfv (co c1o (cv r) cmpl) cbs) cress)) $;

--| Define the coefficient function for a univariate polynomial. (Contributed by Stefan O'Rear, 21-Mar-2015.)
axiom df_coe1 {f2 n: setvar}:
  $ wceq cco1 (cmpt f2 cvv (cmpt n cn0 (cfv (cxp c1o (csn (cv n))) (cv f2)))) $;

--| Define a function which maps a coefficient function for a univariate polynomial to the corresponding polynomial object. (Contributed by Mario Carneiro, 12-Jun-2015.)
axiom df_toply1 {f2 n: setvar}:
  $ wceq ctp1 (cmpt f2 cvv (cmpt n (co cn0 c1o cmap) (cfv (cfv c0 (cv n)) (cv f2)))) $;

--| The set of finite bags on ` 1o ` is just the set of all functions from ` 1o ` to ` NN0 ` . (Contributed by Mario Carneiro, 9-Feb-2015.)
theorem psr1baslem {f2: setvar}:
  $ wceq (co cn0 c1o cmap) (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 c1o cmap)) $;

--| Value of the ring of univariate power series. (Contributed by Mario Carneiro, 8-Feb-2015.)
theorem psr1val (R S: class):
  $ wceq S (cfv R cps1) $ >
  $ wceq S (cfv c0 (co c1o R copws)) $;

--| The ring of univariate power series is a commutative ring. (Contributed by Mario Carneiro, 8-Feb-2015.)
theorem psr1crng (R S: class):
  $ wceq S (cfv R cps1) $ >
  $ wi (wcel R ccrg) (wcel S ccrg) $;

--| The ring of univariate power series is an associative algebra. (Contributed by Mario Carneiro, 8-Feb-2015.)
theorem psr1assa (R S: class):
  $ wceq S (cfv R cps1) $ >
  $ wi (wcel R ccrg) (wcel S casa) $;

--| The ordered power series structure is a totally ordered set. (Contributed by Mario Carneiro, 2-Jun-2015.)
theorem psr1tos (R S: class):
  $ wceq S (cfv R cps1) $ >
  $ wi (wcel R ctos) (wcel S ctos) $;

--| The base set of the ring of univariate power series. (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem psr1bas2 (B2 R S O: class):
  $ wceq S (cfv R cps1) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq O (co c1o R cmps) $ >
  $ wceq B2 (cfv O cbs) $;

--| The base set of the ring of univariate power series. (Contributed by Mario Carneiro, 8-Feb-2015.)
theorem psr1bas (B2 R S K: class):
  $ wceq S (cfv R cps1) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq B2 (co K (co cn0 c1o cmap) cmap) $;

--| The value of the generator of the power series algebra (the ` X ` in ` R [ [ X ] ] ` ). Since all univariate polynomial rings over a fixed base ring ` R ` are isomorphic, we don't bother to pass this in as a parameter; internally we are actually using the empty set as this generator and ` 1o = { (/) } ` is the index set (but for most purposes this choice should not be visible anyway). (Contributed by Mario Carneiro, 8-Feb-2015.) (Revised by Mario Carneiro, 12-Jun-2015.)
theorem vr1val (R X: class):
  $ wceq X (cfv R cv1) $ >
  $ wceq X (cfv c0 (co c1o R cmvr)) $;

--| The variable ` X ` is a member of the power series algebra ` R [ [ X ] ] ` . (Contributed by Mario Carneiro, 8-Feb-2015.)
theorem vr1cl2 (B2 R S X: class):
  $ wceq X (cfv R cv1) $ >
  $ wceq S (cfv R cps1) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi (wcel R crg) (wcel X B2) $;

--| The value of the set of univariate polynomials. (Contributed by Mario Carneiro, 9-Feb-2015.)
theorem ply1val (P R S: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq S (cfv R cps1) $ >
  $ wceq P (co S (cfv (co c1o R cmpl) cbs) cress) $;

--| The value of the base set of univariate polynomials. (Contributed by Mario Carneiro, 9-Feb-2015.) Remove hypothesis. (Revised by SN, 20-May-2025.)
theorem ply1bas (P R U: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq U (cfv (co c1o R cmpl) cbs) $;

--| Univariate polynomials form a linear subspace of the set of univariate power series. (Contributed by Mario Carneiro, 9-Feb-2015.)
theorem ply1lss (P R S U: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq S (cfv R cps1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi (wcel R crg) (wcel U (cfv S clss)) $;

--| Univariate polynomials form a subring of the set of univariate power series. (Contributed by Mario Carneiro, 9-Feb-2015.)
theorem ply1subrg (P R S U: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq S (cfv R cps1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi (wcel R crg) (wcel U (cfv S csubrg)) $;

--| The ring of univariate polynomials is a commutative ring. (Contributed by Mario Carneiro, 9-Feb-2015.)
theorem ply1crng (P R: class):
  $ wceq P (cfv R cpl1) $ >
  $ wi (wcel R ccrg) (wcel P ccrg) $;

--| The ring of univariate polynomials is an associative algebra. (Contributed by Mario Carneiro, 9-Feb-2015.)
theorem ply1assa (P R: class):
  $ wceq P (cfv R cpl1) $ >
  $ wi (wcel R ccrg) (wcel P casa) $;

--| A univariate power series is a multivariate power series on one index. (Contributed by Stefan O'Rear, 25-Mar-2015.)
theorem psr1bascl (B2 P R F: class):
  $ wceq P (cfv R cps1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi (wcel F B2) (wcel F (cfv (co c1o R cmps) cbs)) $;

--| Univariate power series base set elements are functions. (Contributed by Stefan O'Rear, 25-Mar-2015.)
theorem psr1basf (B2 P R F K: class):
  $ wceq P (cfv R cps1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi (wcel F B2) (wf (co cn0 c1o cmap) K F) $;

--| Univariate polynomial base set elements are functions. (Contributed by Stefan O'Rear, 21-Mar-2015.)
theorem ply1basf (B2 P R F K: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi (wcel F B2) (wf (co cn0 c1o cmap) K F) $;

--| A univariate polynomial is a univariate power series. (Contributed by Stefan O'Rear, 25-Mar-2015.)
theorem ply1bascl (B2 P R F: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi (wcel F B2) (wcel F (cfv (cfv R cps1) cbs)) $;

--| A univariate polynomial is a multivariate polynomial on one index. (Contributed by Stefan O'Rear, 25-Mar-2015.)
theorem ply1bascl2 (B2 P R F: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi (wcel F B2) (wcel F (cfv (co c1o R cmpl) cbs)) $;

--| Value of the univariate polynomial coefficient function. (Contributed by Stefan O'Rear, 21-Mar-2015.)
theorem coe1fval {n: setvar} (A2: class n) (F: class) (V: class n):
  $ wceq A2 (cfv F cco1) $ >
  $ wi (wcel F V) (wceq A2 (cmpt n cn0 (cfv (cxp c1o (csn (cv n))) F))) $;

--| Value of an evaluated coefficient in a polynomial coefficient vector. (Contributed by Stefan O'Rear, 21-Mar-2015.)
theorem coe1fv (A2 F N V: class):
  $ wceq A2 (cfv F cco1) $ >
  $ wi (wa (wcel F V) (wcel N cn0)) (wceq (cfv N A2) (cfv (cxp c1o (csn N)) F)) $;

--| Value of a multivariate coefficient in terms of the coefficient vector. (Contributed by Stefan O'Rear, 21-Mar-2015.)
theorem fvcoe1 (A2 F V X: class):
  $ wceq A2 (cfv F cco1) $ >
  $ wi (wa (wcel F V) (wcel X (co cn0 c1o cmap))) (wceq (cfv X F) (cfv (cfv c0 X) A2)) $;

--| Univariate power series coefficient vectors expressed as a function composition. (Contributed by Stefan O'Rear, 25-Mar-2015.)
theorem coe1fval3 {y1: setvar} (A2 B2 P R: class y1) (F: class) (G: class y1):
  $ wceq A2 (cfv F cco1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (cfv R cps1) $ >
  $ wceq G (cmpt y1 cn0 (cxp c1o (csn (cv y1)))) $ >
  $ wi (wcel F B2) (wceq A2 (ccom F G)) $;

--| Functionality of univariate power series coefficient vectors. (Contributed by Stefan O'Rear, 25-Mar-2015.)
theorem coe1f2 (A2 B2 P R F K: class):
  $ wceq A2 (cfv F cco1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (cfv R cps1) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi (wcel F B2) (wf cn0 K A2) $;

--| Univariate polynomial coefficient vectors expressed as a function composition. (Contributed by Stefan O'Rear, 21-Mar-2015.)
theorem coe1fval2 {y1: setvar} (A2 B2 P R: class y1) (F: class) (G: class y1):
  $ wceq A2 (cfv F cco1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq G (cmpt y1 cn0 (cxp c1o (csn (cv y1)))) $ >
  $ wi (wcel F B2) (wceq A2 (ccom F G)) $;

--| Functionality of univariate polynomial coefficient vectors. (Contributed by Stefan O'Rear, 21-Mar-2015.)
theorem coe1f (A2 B2 P R F K: class):
  $ wceq A2 (cfv F cco1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi (wcel F B2) (wf cn0 K A2) $;

--| A coefficient of a univariate polynomial over a class/ring is an element of this class/ring. (Contributed by AV, 9-Oct-2019.)
theorem coe1fvalcl (A2 B2 P R F K N: class):
  $ wceq A2 (cfv F cco1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi (wa (wcel F B2) (wcel N cn0)) (wcel (cfv N A2) K) $;

--| Finite support of univariate polynomial coefficient vectors. (Contributed by Stefan O'Rear, 21-Mar-2015.) (Revised by AV, 19-Jul-2019.)
theorem coe1sfi (A2 B2 P R F c_0: class):
  $ wceq A2 (cfv F cco1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel F B2) (wbr A2 c_0 cfsupp) $;

--| The coefficient vector of a univariate polynomial is a finitely supported mapping from the nonnegative integers to the elements of the coefficient class/ring for the polynomial. (Contributed by AV, 3-Oct-2019.)
theorem coe1fsupp {g2: setvar} (A2: class) (B2 P R F: class g2) (K c_0: class):
  $ wceq A2 (cfv F cco1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi (wcel F B2) (wcel A2 (crab g2 (wbr (cv g2) c_0 cfsupp) (co K cn0 cmap))) $;

--| A mapping involving coefficients of polynomials is finitely supported. (Contributed by AV, 12-Oct-2019.)
theorem mptcoe1fsupp {k: setvar} (B2: class) (P: class k) (R M: class) (c_0: class k):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R crg) (wcel M B2)) (wbr (cmpt k cn0 (cfv (cv k) (cfv M cco1))) c_0 cfsupp) $;

--| The coefficient vector of a univariate polynomial is 0 almost everywhere. (Contributed by AV, 19-Oct-2019.)
theorem coe1ae0 {n s1: setvar} (A2: class) (B2 P R F: class n s1) (c_0: class):
  $ wceq A2 (cfv F cco1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel F B2) (wrex s1 (wral n (wi (wbr (cv s1) (cv n) clt) (wceq (cfv (cv n) A2) c_0)) cn0) cn0) $;

--| The generator of a univariate polynomial algebra is contained in the base set. (Contributed by Stefan O'Rear, 19-Mar-2015.)
theorem vr1cl (B2 P R X: class):
  $ wceq X (cfv R cv1) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi (wcel R crg) (wcel X B2) $;

--| Zero in the ordered power series ring. (Contributed by Stefan O'Rear, 23-Mar-2015.) (Revised by Mario Carneiro, 2-Oct-2015.)
theorem opsr0 (ph: wff) (R S T I O: class):
  $ wceq S (co I R cmps) $ >
  $ wceq O (cfv T (co I R copws)) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wi ph (wceq (cfv S c0g) (cfv O c0g)) $;

--| One in the ordered power series ring. (Contributed by Stefan O'Rear, 23-Mar-2015.) (Revised by Mario Carneiro, 2-Oct-2015.)
theorem opsr1 (ph: wff) (R S T I O: class):
  $ wceq S (co I R cmps) $ >
  $ wceq O (cfv T (co I R copws)) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wi ph (wceq (cfv S cur) (cfv O cur)) $;

--| Value of addition in a univariate power series ring. (Contributed by Stefan O'Rear, 21-Mar-2015.) (Revised by Mario Carneiro, 2-Oct-2015.)
theorem psr1plusg (c_pl R S Y: class):
  $ wceq Y (cfv R cps1) $ >
  $ wceq S (co c1o R cmps) $ >
  $ wceq c_pl (cfv Y cplusg) $ >
  $ wceq c_pl (cfv S cplusg) $;

--| Value of scalar multiplication in a univariate power series ring. (Contributed by Stefan O'Rear, 21-Mar-2015.) (Revised by Mario Carneiro, 2-Oct-2015.)
theorem psr1vsca (R S c_x Y: class):
  $ wceq Y (cfv R cps1) $ >
  $ wceq S (co c1o R cmps) $ >
  $ wceq c_x (cfv Y cvsca) $ >
  $ wceq c_x (cfv S cvsca) $;

--| Value of multiplication in a univariate power series ring. (Contributed by Stefan O'Rear, 21-Mar-2015.) (Revised by Mario Carneiro, 2-Oct-2015.)
theorem psr1mulr (R S c_x Y: class):
  $ wceq Y (cfv R cps1) $ >
  $ wceq S (co c1o R cmps) $ >
  $ wceq c_x (cfv Y cmulr) $ >
  $ wceq c_x (cfv S cmulr) $;

--| Value of addition in a univariate polynomial ring. (Contributed by Stefan O'Rear, 21-Mar-2015.) (Revised by Mario Carneiro, 4-Jul-2015.)
theorem ply1plusg (c_pl R S Y: class):
  $ wceq Y (cfv R cpl1) $ >
  $ wceq S (co c1o R cmpl) $ >
  $ wceq c_pl (cfv Y cplusg) $ >
  $ wceq c_pl (cfv S cplusg) $;

--| Value of scalar multiplication in a univariate polynomial ring. (Contributed by Stefan O'Rear, 21-Mar-2015.) (Revised by Mario Carneiro, 4-Jul-2015.)
theorem ply1vsca (R S c_x Y: class):
  $ wceq Y (cfv R cpl1) $ >
  $ wceq S (co c1o R cmpl) $ >
  $ wceq c_x (cfv Y cvsca) $ >
  $ wceq c_x (cfv S cvsca) $;

--| Value of multiplication in a univariate polynomial ring. (Contributed by Stefan O'Rear, 21-Mar-2015.) (Revised by Mario Carneiro, 4-Jul-2015.)
theorem ply1mulr (R S c_x Y: class):
  $ wceq Y (cfv R cpl1) $ >
  $ wceq S (co c1o R cmpl) $ >
  $ wceq c_x (cfv Y cmulr) $ >
  $ wceq c_x (cfv S cmulr) $;

--| Associative identity with scalar and ring multiplication for the polynomial ring. (Contributed by AV, 14-Aug-2019.)
theorem ply1ass23l (A2 B2 P R c_x c_xp K X Y: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq c_xp (cfv P cmulr) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wi (wa (wcel R crg) (w3a (wcel A2 K) (wcel X B2) (wcel Y B2))) (wceq (co (co A2 X c_x) Y c_xp) (co A2 (co X Y c_xp) c_x)) $;

--| The base set of a restricted polynomial algebra consists of power series in the subring which are also polynomials (in the parent ring). (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem ressply1bas2 (ph: wff) (B2 C R S T U H K W: class):
  $ wceq S (cfv R cpl1) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (cfv H cpl1) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq W (cfv H cps1) $ >
  $ wceq C (cfv W cbs) $ >
  $ wceq K (cfv S cbs) $ >
  $ wi ph (wceq B2 (cin C K)) $;

--| A restricted polynomial algebra has the same base set. (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem ressply1bas (ph: wff) (B2 P R S T U H: class):
  $ wceq S (cfv R cpl1) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (cfv H cpl1) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq P (co S B2 cress) $ >
  $ wi ph (wceq B2 (cfv P cbs)) $;

--| A restricted polynomial algebra has the same addition operation. (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem ressply1add (ph: wff) (B2 P R S T U H X Y: class):
  $ wceq S (cfv R cpl1) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (cfv H cpl1) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq P (co S B2 cress) $ >
  $ wi (wa ph (wa (wcel X B2) (wcel Y B2))) (wceq (co X Y (cfv U cplusg)) (co X Y (cfv P cplusg))) $;

--| A restricted polynomial algebra has the same multiplication operation. (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem ressply1mul (ph: wff) (B2 P R S T U H X Y: class):
  $ wceq S (cfv R cpl1) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (cfv H cpl1) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq P (co S B2 cress) $ >
  $ wi (wa ph (wa (wcel X B2) (wcel Y B2))) (wceq (co X Y (cfv U cmulr)) (co X Y (cfv P cmulr))) $;

--| A restricted power series algebra has the same scalar multiplication operation. (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem ressply1vsca (ph: wff) (B2 P R S T U H X Y: class):
  $ wceq S (cfv R cpl1) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (cfv H cpl1) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq P (co S B2 cress) $ >
  $ wi (wa ph (wa (wcel X T) (wcel Y B2))) (wceq (co X Y (cfv U cvsca)) (co X Y (cfv P cvsca))) $;

--| A subring of the base ring induces a subring of polynomials. (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem subrgply1 (B2 R S T U H: class):
  $ wceq S (cfv R cpl1) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (cfv H cpl1) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi (wcel T (cfv R csubrg)) (wcel B2 (cfv S csubrg)) $;

--| Evaluate a group sum in a polynomial ring over a subring. (Contributed by AV, 22-Sep-2019.) (Proof shortened by AV, 31-Jan-2020.)
theorem gsumply1subr (ph: wff) (A2 B2 R S T U F H V: class):
  $ wceq S (cfv R cpl1) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (cfv H cpl1) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wceq (co S F cgsu) (co U F cgsu)) $;

--| Property deduction for power series base set. (Contributed by Stefan O'Rear, 27-Mar-2015.)
theorem psrbaspropd (ph: wff) (R S I: class):
  $ wi ph (wceq (cfv R cbs) (cfv S cbs)) $ >
  $ wi ph (wceq (cfv (co I R cmps) cbs) (cfv (co I S cmps) cbs)) $;

--| Property deduction for power series addition. (Contributed by Stefan O'Rear, 27-Mar-2015.) (Revised by Mario Carneiro, 3-Oct-2015.)
theorem psrplusgpropd {x3 y1: setvar} (ph: wff) (B2 R S: class) (I: class x3 y1):
  $ wi ph (wceq B2 (cfv R cbs)) $ >
  $ wi ph (wceq B2 (cfv S cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv R cplusg)) (co (cv x3) (cv y1) (cfv S cplusg))) $ >
  $ wi ph (wceq (cfv (co I R cmps) cplusg) (cfv (co I S cmps) cplusg)) $;

--| Property deduction for polynomial base set. (Contributed by Stefan O'Rear, 27-Mar-2015.) (Proof shortened by AV, 19-Jul-2019.)
theorem mplbaspropd {x3 y1: setvar} (ph: wff) (B2 R S: class) (I: class x3 y1):
  $ wi ph (wceq B2 (cfv R cbs)) $ >
  $ wi ph (wceq B2 (cfv S cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv R cplusg)) (co (cv x3) (cv y1) (cfv S cplusg))) $ >
  $ wi ph (wceq (cfv (co I R cmpl) cbs) (cfv (co I S cmpl) cbs)) $;

--| Reversing multiplication in a ring reverses multiplication in the power series ring. (Contributed by Stefan O'Rear, 27-Mar-2015.)
theorem psropprmul (B2 R S c_xb c_x F G I Y Z: class):
  $ wceq Y (co I R cmps) $ >
  $ wceq S (cfv R coppr) $ >
  $ wceq Z (co I S cmps) $ >
  $ wceq c_x (cfv Y cmulr) $ >
  $ wceq c_xb (cfv Z cmulr) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wi (w3a (wcel R crg) (wcel F B2) (wcel G B2)) (wceq (co F G c_xb) (co G F c_x)) $;

--| Reversing multiplication in a ring reverses multiplication in the univariate polynomial ring. (Contributed by Stefan O'Rear, 27-Mar-2015.)
theorem ply1opprmul (B2 R S c_xb c_x F G Y Z: class):
  $ wceq Y (cfv R cpl1) $ >
  $ wceq S (cfv R coppr) $ >
  $ wceq Z (cfv S cpl1) $ >
  $ wceq c_x (cfv Y cmulr) $ >
  $ wceq c_xb (cfv Z cmulr) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wi (w3a (wcel R crg) (wcel F B2) (wcel G B2)) (wceq (co F G c_xb) (co G F c_x)) $;

--| Lemma for ~ ply1basfvi and ~ deg1fvi . (Contributed by Stefan O'Rear, 28-Mar-2015.)
theorem _00ply1bas:
  $ wceq c0 (cfv (cfv c0 cpl1) cbs) $;

--| Protection compatibility of the univariate polynomial base set. (Contributed by Stefan O'Rear, 27-Mar-2015.)
theorem ply1basfvi (R: class):
  $ wceq (cfv (cfv R cpl1) cbs) (cfv (cfv (cfv R cid) cpl1) cbs) $;

--| Protection compatibility of the univariate polynomial addition. (Contributed by Stefan O'Rear, 27-Mar-2015.)
theorem ply1plusgfvi (R: class):
  $ wceq (cfv (cfv R cpl1) cplusg) (cfv (cfv (cfv R cid) cpl1) cplusg) $;

--| Property deduction for univariate polynomial base set. (Contributed by Stefan O'Rear, 27-Mar-2015.)
theorem ply1baspropd {x3 y1: setvar} (ph: wff) (B2 R S: class):
  $ wi ph (wceq B2 (cfv R cbs)) $ >
  $ wi ph (wceq B2 (cfv S cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv R cplusg)) (co (cv x3) (cv y1) (cfv S cplusg))) $ >
  $ wi ph (wceq (cfv (cfv R cpl1) cbs) (cfv (cfv S cpl1) cbs)) $;

--| Property deduction for univariate polynomial addition. (Contributed by Stefan O'Rear, 27-Mar-2015.)
theorem ply1plusgpropd {x3 y1: setvar} (ph: wff) (B2 R S: class):
  $ wi ph (wceq B2 (cfv R cbs)) $ >
  $ wi ph (wceq B2 (cfv S cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv R cplusg)) (co (cv x3) (cv y1) (cfv S cplusg))) $ >
  $ wi ph (wceq (cfv (cfv R cpl1) cplusg) (cfv (cfv S cpl1) cplusg)) $;

--| Ordered power series form a ring. (Contributed by Stefan O'Rear, 22-Mar-2015.)
theorem opsrring (ph: wff) (R T I O V: class):
  $ wceq O (cfv T (co I R copws)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wi ph (wcel O crg) $;

--| Ordered power series form a left module. (Contributed by Stefan O'Rear, 26-Mar-2015.)
theorem opsrlmod (ph: wff) (R T I O V: class):
  $ wceq O (cfv T (co I R copws)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wss T (cxp I I)) $ >
  $ wi ph (wcel O clmod) $;

--| Univariate power series form a ring. (Contributed by Stefan O'Rear, 22-Mar-2015.)
theorem psr1ring (R S: class):
  $ wceq S (cfv R cps1) $ >
  $ wi (wcel R crg) (wcel S crg) $;

--| Univariate polynomials form a ring. (Contributed by Stefan O'Rear, 22-Mar-2015.)
theorem ply1ring (P R: class):
  $ wceq P (cfv R cpl1) $ >
  $ wi (wcel R crg) (wcel P crg) $;

--| Univariate power series form a left module. (Contributed by Stefan O'Rear, 26-Mar-2015.)
theorem psr1lmod (P R: class):
  $ wceq P (cfv R cps1) $ >
  $ wi (wcel R crg) (wcel P clmod) $;

--| Scalars of a univariate power series ring. (Contributed by Stefan O'Rear, 4-Jul-2015.)
theorem psr1sca (P R V: class):
  $ wceq P (cfv R cps1) $ >
  $ wi (wcel R V) (wceq R (cfv P csca)) $;

--| Scalars of a univariate power series ring. (Contributed by Stefan O'Rear, 26-Mar-2015.) (Revised by Mario Carneiro, 4-Jul-2015.)
theorem psr1sca2 (P R: class):
  $ wceq P (cfv R cps1) $ >
  $ wceq (cfv R cid) (cfv P csca) $;

--| Univariate polynomials form a left module. (Contributed by Stefan O'Rear, 26-Mar-2015.)
theorem ply1lmod (P R: class):
  $ wceq P (cfv R cpl1) $ >
  $ wi (wcel R crg) (wcel P clmod) $;

--| Scalars of a univariate polynomial ring. (Contributed by Stefan O'Rear, 26-Mar-2015.)
theorem ply1sca (P R V: class):
  $ wceq P (cfv R cpl1) $ >
  $ wi (wcel R V) (wceq R (cfv P csca)) $;

--| Scalars of a univariate polynomial ring. (Contributed by Stefan O'Rear, 26-Mar-2015.)
theorem ply1sca2 (P R: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq (cfv R cid) (cfv P csca) $;

--| The zero scalar as a polynomial. (Contributed by Thierry Arnoux, 20-Jan-2025.)
theorem ply1ascl0 (ph: wff) (A2 R O W c_0: class):
  $ wceq W (cfv R cpl1) $ >
  $ wceq A2 (cfv W cascl) $ >
  $ wceq O (cfv R c0g) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wceq (cfv O A2) c_0) $;

--| The multiplicative identity scalar as a univariate polynomial. (Contributed by Thierry Arnoux, 20-Jan-2025.)
theorem ply1ascl1 (ph: wff) (A2 R c_1 I W: class):
  $ wceq W (cfv R cpl1) $ >
  $ wceq A2 (cfv W cascl) $ >
  $ wceq I (cfv R cur) $ >
  $ wceq c_1 (cfv W cur) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wceq (cfv I A2) c_1) $;

--| The univariate polynomial ring has the same zero as the corresponding multivariate polynomial ring. (Contributed by Stefan O'Rear, 23-Mar-2015.) (Revised by Mario Carneiro, 3-Oct-2015.)
theorem ply1mpl0 (P R M c_0: class):
  $ wceq M (co c1o R cmpl) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq c_0 (cfv P c0g) $ >
  $ wceq c_0 (cfv M c0g) $;

--| Zero times a univariate polynomial is the zero polynomial ( ~ lmod0vs analog.) (Contributed by AV, 2-Dec-2019.)
theorem ply10s0 (B2 P R c_as M c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_as (cfv P cvsca) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R crg) (wcel M B2)) (wceq (co c_0 M c_as) (cfv P c0g)) $;

--| The univariate polynomial ring has the same one as the corresponding multivariate polynomial ring. (Contributed by Stefan O'Rear, 23-Mar-2015.) (Revised by Mario Carneiro, 3-Oct-2015.)
theorem ply1mpl1 (P R c_1 M: class):
  $ wceq M (co c1o R cmpl) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq c_1 (cfv P cur) $ >
  $ wceq c_1 (cfv M cur) $;

--| The univariate polynomial ring inherits the multivariate ring's scalar function. (Contributed by Stefan O'Rear, 28-Mar-2015.) (Proof shortened by Fan Zheng, 26-Jun-2016.)
theorem ply1ascl (A2 P R: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq A2 (cfv (co c1o R cmpl) cascl) $;

--| The scalar injection function in a subring algebra is the same up to a restriction to the subring. (Contributed by Mario Carneiro, 4-Jul-2015.)
theorem subrg1ascl (ph: wff) (A2 C P R T U H: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (cfv H cpl1) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq C (cfv U cascl) $ >
  $ wi ph (wceq C (cres A2 T)) $;

--| The scalars in a polynomial algebra are in the subring algebra iff the scalar value is in the subring. (Contributed by Mario Carneiro, 4-Jul-2015.)
theorem subrg1asclcl (ph: wff) (A2 B2 P R T U H K X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (cfv H cpl1) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wb (wcel (cfv X A2) B2) (wcel X T)) $;

--| The variables in a subring polynomial algebra are the same as the original ring. (Contributed by Mario Carneiro, 5-Jul-2015.)
theorem subrgvr1 (ph: wff) (R T H X: class):
  $ wceq X (cfv R cv1) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq H (co R T cress) $ >
  $ wi ph (wceq X (cfv H cv1)) $;

--| The variables in a polynomial algebra are contained in every subring algebra. (Contributed by Mario Carneiro, 5-Jul-2015.)
theorem subrgvr1cl (ph: wff) (B2 R T U H X: class):
  $ wceq X (cfv R cv1) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (cfv H cpl1) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi ph (wcel X B2) $;

--| The coefficient vector of 0. (Contributed by Stefan O'Rear, 23-Mar-2015.)
theorem coe1z (P R Y c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq c_0 (cfv P c0g) $ >
  $ wceq Y (cfv R c0g) $ >
  $ wi (wcel R crg) (wceq (cfv c_0 cco1) (cxp cn0 (csn Y))) $;

--| The coefficient vector of an addition. (Contributed by Stefan O'Rear, 24-Mar-2015.)
theorem coe1add (B2 c_pl c_pb R F G Y: class):
  $ wceq Y (cfv R cpl1) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq c_pb (cfv Y cplusg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (w3a (wcel R crg) (wcel F B2) (wcel G B2)) (wceq (cfv (co F G c_pb) cco1) (co (cfv F cco1) (cfv G cco1) (cof c_pl))) $;

--| A particular coefficient of an addition. (Contributed by Stefan O'Rear, 23-Mar-2015.)
theorem coe1addfv (B2 c_pl c_pb R F G X Y: class):
  $ wceq Y (cfv R cpl1) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq c_pb (cfv Y cplusg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (wa (w3a (wcel R crg) (wcel F B2) (wcel G B2)) (wcel X cn0)) (wceq (cfv X (cfv (co F G c_pb) cco1)) (co (cfv X (cfv F cco1)) (cfv X (cfv G cco1)) c_pl)) $;

--| A particular coefficient of a subtraction. (Contributed by Stefan O'Rear, 23-Mar-2015.)
theorem coe1subfv (B2 R F G c_mi N X Y: class):
  $ wceq Y (cfv R cpl1) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq c_mi (cfv Y csg) $ >
  $ wceq N (cfv R csg) $ >
  $ wi (wa (w3a (wcel R crg) (wcel F B2) (wcel G B2)) (wcel X cn0)) (wceq (cfv X (cfv (co F G c_mi) cco1)) (co (cfv X (cfv F cco1)) (cfv X (cfv G cco1)) N)) $;

--| An equivalence for ~ coe1mul2 . (Contributed by Stefan O'Rear, 25-Mar-2015.)
theorem coe1mul2lem1 (A2 X: class):
  $ wi (wa (wcel A2 cn0) (wcel X (co cn0 c1o cmap))) (wb (wbr X (cxp c1o (csn A2)) (cofr cle)) (wcel (cfv c0 X) (co cc0 A2 cfz))) $;

--| An equivalence for ~ coe1mul2 . (Contributed by Stefan O'Rear, 25-Mar-2015.)
theorem coe1mul2lem2 {k c d: setvar} (H: class k d):
  $ wceq H (crab d (wbr (cv d) (cxp c1o (csn (cv k))) (cofr cle)) (co cn0 c1o cmap)) $ >
  $ wi (wcel (cv k) cn0) (wf1o H (co cc0 (cv k) cfz) (cmpt c H (cfv c0 (cv c)))) $;

--| The coefficient vector of multiplication in the univariate power series ring. (Contributed by Stefan O'Rear, 25-Mar-2015.)
theorem coe1mul2 {x3 k: setvar} (B2 R: class) (S: class x3 k) (c_xb: class x3) (c_x F G: class):
  $ wceq S (cfv R cps1) $ >
  $ wceq c_xb (cfv S cmulr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi (w3a (wcel R crg) (wcel F B2) (wcel G B2)) (wceq (cfv (co F G c_xb) cco1) (cmpt k cn0 (co R (cmpt x3 (co cc0 (cv k) cfz) (co (cfv (cv x3) (cfv F cco1)) (cfv (co (cv k) (cv x3) cmin) (cfv G cco1)) c_x)) cgsu))) $;

--| The coefficient vector of multiplication in the univariate polynomial ring. (Contributed by Stefan O'Rear, 25-Mar-2015.)
theorem coe1mul {x3 k: setvar} (B2: class x3 k) (R: class) (c_xb: class x3) (c_x F G: class) (Y: class x3 k):
  $ wceq Y (cfv R cpl1) $ >
  $ wceq c_xb (cfv Y cmulr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wi (w3a (wcel R crg) (wcel F B2) (wcel G B2)) (wceq (cfv (co F G c_xb) cco1) (cmpt k cn0 (co R (cmpt x3 (co cc0 (cv k) cfz) (co (cfv (cv x3) (cfv F cco1)) (cfv (co (cv k) (cv x3) cmin) (cfv G cco1)) c_x)) cgsu))) $;

--| Closure of the expression for a univariate primitive monomial. (Contributed by AV, 14-Aug-2019.)
theorem ply1moncl (B2 D P R c_ex N X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq N (cfv P cmgp) $ >
  $ wceq c_ex (cfv N cmg) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi (wa (wcel R crg) (wcel D cn0)) (wcel (co D X c_ex) B2) $;

--| Closure of the expression for a univariate polynomial term. (Contributed by Stefan O'Rear, 27-Mar-2015.) (Proof shortened by AV, 25-Nov-2019.)
theorem ply1tmcl (B2 C D P R c_x c_ex K N X: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq N (cfv P cmgp) $ >
  $ wceq c_ex (cfv N cmg) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi (w3a (wcel R crg) (wcel C K) (wcel D cn0)) (wcel (co C (co D X c_ex) c_x) B2) $;

--| Coefficient vector of a polynomial term. (Contributed by Stefan O'Rear, 27-Mar-2015.)
theorem coe1tm {x3: setvar} (C D P R c_x c_ex K N X c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq N (cfv P cmgp) $ >
  $ wceq c_ex (cfv N cmg) $ >
  $ wi (w3a (wcel R crg) (wcel C K) (wcel D cn0)) (wceq (cfv (co C (co D X c_ex) c_x) cco1) (cmpt x3 cn0 (cif (wceq (cv x3) D) C c_0))) $;

--| Nonzero coefficient of a polynomial term. (Contributed by Stefan O'Rear, 27-Mar-2015.)
theorem coe1tmfv1 (C D P R c_x c_ex K N X c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq N (cfv P cmgp) $ >
  $ wceq c_ex (cfv N cmg) $ >
  $ wi (w3a (wcel R crg) (wcel C K) (wcel D cn0)) (wceq (cfv D (cfv (co C (co D X c_ex) c_x) cco1)) C) $;

--| Zero coefficient of a polynomial term. (Contributed by Stefan O'Rear, 27-Mar-2015.)
theorem coe1tmfv2 (ph: wff) (C D P R c_x c_ex F K N X c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq N (cfv P cmgp) $ >
  $ wceq c_ex (cfv N cmg) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wcel D cn0) $ >
  $ wi ph (wcel F cn0) $ >
  $ wi ph (wne D F) $ >
  $ wi ph (wceq (cfv F (cfv (co C (co D X c_ex) c_x) cco1)) c_0) $;

--| Coefficient vector of a polynomial multiplied on the right by a term. (Contributed by Stefan O'Rear, 27-Mar-2015.)
theorem coe1tmmul2 {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C D P R c_xb c_x c_xp c_ex K N X c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq N (cfv P cmgp) $ >
  $ wceq c_ex (cfv N cmg) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_xb (cfv P cmulr) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wcel D cn0) $ >
  $ wi ph (wceq (cfv (co A2 (co C (co D X c_ex) c_x) c_xb) cco1) (cmpt x3 cn0 (cif (wbr D (cv x3) cle) (co (cfv (co (cv x3) D cmin) (cfv A2 cco1)) C c_xp) c_0))) $;

--| Coefficient vector of a polynomial multiplied on the left by a term. (Contributed by Stefan O'Rear, 29-Mar-2015.)
theorem coe1tmmul {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C D P R c_xb c_x c_xp c_ex K N X c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq N (cfv P cmgp) $ >
  $ wceq c_ex (cfv N cmg) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_xb (cfv P cmulr) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wcel D cn0) $ >
  $ wi ph (wceq (cfv (co (co C (co D X c_ex) c_x) A2 c_xb) cco1) (cmpt x3 cn0 (cif (wbr D (cv x3) cle) (co C (cfv (co (cv x3) D cmin) (cfv A2 cco1)) c_xp) c_0))) $;

--| Function value of a right-multiplication by a term in the shifted domain. (Contributed by Stefan O'Rear, 27-Mar-2015.)
theorem coe1tmmul2fv (ph: wff) (A2 B2 C D P R c_xb c_x c_xp c_ex K N X Y c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq N (cfv P cmgp) $ >
  $ wceq c_ex (cfv N cmg) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_xb (cfv P cmulr) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wcel D cn0) $ >
  $ wi ph (wcel Y cn0) $ >
  $ wi ph (wceq (cfv (co D Y caddc) (cfv (co A2 (co C (co D X c_ex) c_x) c_xb) cco1)) (co (cfv Y (cfv A2 cco1)) C c_xp)) $;

--| Coefficient vector of a polynomial multiplied on the left by a variable power. (Contributed by Stefan O'Rear, 1-Apr-2015.)
theorem coe1pwmul {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (D P R c_x c_ex N X c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq N (cfv P cmgp) $ >
  $ wceq c_ex (cfv N cmg) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_x (cfv P cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wcel D cn0) $ >
  $ wi ph (wceq (cfv (co (co D X c_ex) A2 c_x) cco1) (cmpt x3 cn0 (cif (wbr D (cv x3) cle) (cfv (co (cv x3) D cmin) (cfv A2 cco1)) c_0))) $;

--| Function value of a right-multiplication by a variable power in the shifted domain. (Contributed by Stefan O'Rear, 1-Apr-2015.)
theorem coe1pwmulfv (ph: wff) (A2 B2 D P R c_x c_ex N X Y c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq N (cfv P cmgp) $ >
  $ wceq c_ex (cfv N cmg) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_x (cfv P cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wcel D cn0) $ >
  $ wi ph (wcel Y cn0) $ >
  $ wi ph (wceq (cfv (co D Y caddc) (cfv (co (co D X c_ex) A2 c_x) cco1)) (cfv Y (cfv A2 cco1))) $;

--| A scalar is a term with zero exponent. (Contributed by Stefan O'Rear, 29-Mar-2015.)
theorem ply1scltm (A2 P R c_x c_ex F K N X: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq N (cfv P cmgp) $ >
  $ wceq c_ex (cfv N cmg) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wi (wa (wcel R crg) (wcel F K)) (wceq (cfv F A2) (co F (co cc0 X c_ex) c_x)) $;

--| Coefficient vector of a polynomial multiplied on the left by a scalar. (Contributed by Stefan O'Rear, 29-Mar-2015.)
theorem coe1sclmul (A2 B2 P R c_xb c_x K X Y: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq c_xb (cfv P cmulr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R crg) (wcel X K) (wcel Y B2)) (wceq (cfv (co (cfv X A2) Y c_xb) cco1) (co (cxp cn0 (csn X)) (cfv Y cco1) (cof c_x))) $;

--| A single coefficient of a polynomial multiplied on the left by a scalar. (Contributed by Stefan O'Rear, 1-Apr-2015.)
theorem coe1sclmulfv (A2 B2 P R c_xb c_x K X Y c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq c_xb (cfv P cmulr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R crg) (wa (wcel X K) (wcel Y B2)) (wcel c_0 cn0)) (wceq (cfv c_0 (cfv (co (cfv X A2) Y c_xb) cco1)) (co X (cfv c_0 (cfv Y cco1)) c_x)) $;

--| Coefficient vector of a polynomial multiplied on the right by a scalar. (Contributed by Stefan O'Rear, 29-Mar-2015.)
theorem coe1sclmul2 (A2 B2 P R c_xb c_x K X Y: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq c_xb (cfv P cmulr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R crg) (wcel X K) (wcel Y B2)) (wceq (cfv (co Y (cfv X A2) c_xb) cco1) (co (cfv Y cco1) (cxp cn0 (csn X)) (cof c_x))) $;

--| A scalar polynomial is a polynomial. (Contributed by Stefan O'Rear, 28-Mar-2015.)
theorem ply1sclf (A2 B2 P R K: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi (wcel R crg) (wf K B2 A2) $;

--| The value of the algebra scalar lifting function for (univariate) polynomials applied to a scalar results in a constant polynomial. (Contributed by AV, 27-Nov-2019.)
theorem ply1sclcl (A2 B2 P R S K: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi (wa (wcel R crg) (wcel S K)) (wcel (cfv S A2) B2) $;

--| Coefficient vector of a scalar. (Contributed by Stefan O'Rear, 28-Mar-2015.)
theorem coe1scl {x3: setvar} (A2 P R K X c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel R crg) (wcel X K)) (wceq (cfv (cfv X A2) cco1) (cmpt x3 cn0 (cif (wceq (cv x3) cc0) X c_0))) $;

--| Recover the base scalar from a scalar polynomial. (Contributed by Stefan O'Rear, 28-Mar-2015.)
theorem ply1sclid (A2 P R K X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi (wa (wcel R crg) (wcel X K)) (wceq X (cfv cc0 (cfv (cfv X A2) cco1))) $;

--| The polynomial scalar function is injective. (Contributed by Stefan O'Rear, 28-Mar-2015.)
theorem ply1sclf1 (A2 B2 P R K: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi (wcel R crg) (wf1 K B2 A2) $;

--| The zero scalar is zero. (Contributed by Stefan O'Rear, 29-Mar-2015.)
theorem ply1scl0 (A2 P R Y c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq Y (cfv P c0g) $ >
  $ wi (wcel R crg) (wceq (cfv c_0 A2) Y) $;

--| Nonzero scalars create nonzero polynomials. (Contributed by Stefan O'Rear, 29-Mar-2015.)
theorem ply1scln0 (A2 P R K X Y c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq Y (cfv P c0g) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi (w3a (wcel R crg) (wcel X K) (wne X c_0)) (wne (cfv X A2) Y) $;

--| The one scalar is the unit polynomial. (Contributed by Stefan O'Rear, 1-Apr-2015.) (Proof shortened by SN, 12-Mar-2025.)
theorem ply1scl1 (A2 P R c_1 N: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq N (cfv P cur) $ >
  $ wi (wcel R crg) (wceq (cfv c_1 A2) N) $;

--| Coefficient vector of the unit polynomial. (Contributed by AV, 9-Aug-2019.)
theorem coe1id {x3: setvar} (P R c_1: class) (I: class x3) (c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq I (cfv P cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel R crg) (wceq (cfv I cco1) (cmpt x3 cn0 (cif (wceq (cv x3) cc0) c_1 c_0))) $;

--| The identity of a polynomial ring expressed as power of the polynomial variable. (Contributed by AV, 14-Aug-2019.) (Proof shortened by SN, 3-Jul-2025.)
theorem ply1idvr1 (P R c_ex N X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq N (cfv P cmgp) $ >
  $ wceq c_ex (cfv N cmg) $ >
  $ wi (wcel R crg) (wceq (co cc0 X c_ex) (cfv P cur)) $;

--| The product of two constant polynomials is a constant polynomial. (Contributed by AV, 18-Nov-2019.)
theorem cply1mul {c: setvar} (B2 P R: class c) (c_xp F G c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_xp (cfv P cmulr) $ >
  $ wi (wa (wcel R crg) (wa (wcel F B2) (wcel G B2))) (wi (wral c (wa (wceq (cfv (cv c) (cfv F cco1)) c_0) (wceq (cfv (cv c) (cfv G cco1)) c_0)) cn) (wral c (wceq (cfv (cv c) (cfv (co F G c_xp) cco1)) c_0) cn)) $;

--| The decomposition of a univariate polynomial is finitely supported. Formerly part of proof for ~ ply1coe . (Contributed by Stefan O'Rear, 21-Mar-2015.) (Revised by AV, 8-Aug-2019.)
theorem ply1coefsupp {k: setvar} (A2 B2 P R c_x: class) (c_ex: class k) (K: class) (M X: class k):
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq M (cfv P cmgp) $ >
  $ wceq c_ex (cfv M cmg) $ >
  $ wceq A2 (cfv K cco1) $ >
  $ wi (wa (wcel R crg) (wcel K B2)) (wbr (cmpt k cn0 (co (cfv (cv k) A2) (co (cv k) X c_ex) c_x)) (cfv P c0g) cfsupp) $;

--| Decompose a univariate polynomial as a sum of powers. (Contributed by Stefan O'Rear, 21-Mar-2015.) (Revised by AV, 7-Oct-2019.)
theorem ply1coe {k: setvar} (A2 B2 P R c_x c_ex K: class) (M: class k) (X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq M (cfv P cmgp) $ >
  $ wceq c_ex (cfv M cmg) $ >
  $ wceq A2 (cfv K cco1) $ >
  $ wi (wa (wcel R crg) (wcel K B2)) (wceq K (co P (cmpt k cn0 (co (cfv (cv k) A2) (co (cv k) X c_ex) c_x)) cgsu)) $;

--| Two polynomials over the same ring are equal if they have identical coefficients. (Contributed by AV, 7-Oct-2019.)
theorem eqcoe1ply1eq {k: setvar} (A2: class) (B2: class k) (C: class) (P R K L: class k):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq A2 (cfv K cco1) $ >
  $ wceq C (cfv L cco1) $ >
  $ wi (w3a (wcel R crg) (wcel K B2) (wcel L B2)) (wi (wral k (wceq (cfv (cv k) A2) (cfv (cv k) C)) cn0) (wceq K L)) $;

--| Two polynomials over the same ring are equal iff they have identical coefficients. (Contributed by AV, 13-Oct-2019.)
theorem ply1coe1eq {k: setvar} (A2 B2 C: class) (P: class k) (R K L: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq A2 (cfv K cco1) $ >
  $ wceq C (cfv L cco1) $ >
  $ wi (w3a (wcel R crg) (wcel K B2) (wcel L B2)) (wb (wral k (wceq (cfv (cv k) A2) (cfv (cv k) C)) cn0) (wceq K L)) $;

--| All but the first coefficient of a constant polynomial ( i.e. a "lifted scalar") are zero. (Contributed by AV, 16-Nov-2019.)
theorem cply1coe0 {n: setvar} (A2 B2 P: class n) (R S K: class) (c_0: class n):
  $ wceq K (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wi (wa (wcel R crg) (wcel S K)) (wral n (wceq (cfv (cv n) (cfv (cfv S A2) cco1)) c_0) cn) $;

--| A polynomial is constant (i.e. a "lifted scalar") iff all but the first coefficient are zero. (Contributed by AV, 16-Nov-2019.)
theorem cply1coe0bi {n s1: setvar} (A2 B2: class) (P: class n s1) (R K M: class) (c_0: class n):
  $ wceq K (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wi (wa (wcel R crg) (wcel M B2)) (wb (wrex s1 (wceq M (cfv (cv s1) A2)) K) (wral n (wceq (cfv (cv n) (cfv M cco1)) c_0) cn)) $;

--| Lemma for ~ coe1fzgsumd (induction step). (Contributed by AV, 8-Oct-2019.)
theorem coe1fzgsumdlem {x3 a: setvar} (ph: wff x3 a) (B2: class a) (P R: class x3 a) (m: setvar) (K: class a) (M: class x3 a):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel K cn0) $ >
  $ wi (w3a (wcel (cv m) cfn) (wn (wcel (cv a) (cv m))) ph) (wi (wi (wral x3 (wcel M B2) (cv m)) (wceq (cfv K (cfv (co P (cmpt x3 (cv m) M) cgsu) cco1)) (co R (cmpt x3 (cv m) (cfv K (cfv M cco1))) cgsu))) (wi (wral x3 (wcel M B2) (cun (cv m) (csn (cv a)))) (wceq (cfv K (cfv (co P (cmpt x3 (cun (cv m) (csn (cv a))) M) cgsu) cco1)) (co R (cmpt x3 (cun (cv m) (csn (cv a))) (cfv K (cfv M cco1))) cgsu)))) $;

--| Value of an evaluated coefficient in a finite group sum of polynomials. (Contributed by AV, 8-Oct-2019.)
theorem coe1fzgsumd {x3: setvar} (ph: wff x3) (B2: class) (P R: class x3) (K: class) (M: class x3) (N: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel K cn0) $ >
  $ wi ph (wral x3 (wcel M B2) N) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wceq (cfv K (cfv (co P (cmpt x3 N M) cgsu) cco1)) (co R (cmpt x3 N (cfv K (cfv M cco1))) cgsu)) $;

--| Equality of a constant polynomial is the same as equality of the constant term. (Contributed by Thierry Arnoux, 24-Jul-2024.)
theorem ply1scleq (ph: wff) (A2 B2 P R E F: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel E B2) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wb (wceq (cfv E A2) (cfv F A2)) (wceq E F)) $;

--| The characteristic of a polynomial ring is the characteristic of the underlying ring. (Contributed by Thierry Arnoux, 24-Jul-2024.)
theorem ply1chr (P R: class):
  $ wceq P (cfv R cpl1) $ >
  $ wi (wcel R ccrg) (wceq (cfv P cchr) (cfv R cchr)) $;

--| A finite group sum of scaled monomials is a univariate polynomial. (Contributed by AV, 8-Oct-2019.)
theorem gsumsmonply1 {k: setvar} (ph: wff) (A2: class k) (B2: class) (P R c_ex: class k) (c_as K: class) (X c_0: class k):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_as (cfv P cvsca) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wral k (wcel A2 K) cn0) $ >
  $ wi ph (wbr (cmpt k cn0 A2) c_0 cfsupp) $ >
  $ wi ph (wcel (co P (cmpt k cn0 (co A2 (co (cv k) X c_ex) c_as)) cgsu) B2) $;

--| A coefficient of the polynomial represented as a sum of scaled monomials is the coefficient of the corresponding scaled monomial. (Contributed by AV, 13-Oct-2019.)
theorem gsummoncoe1 {k: setvar} (ph: wff) (A2: class k) (B2 P R c_ex c_as K L: class) (X: class k) (c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_as (cfv P cvsca) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wral k (wcel A2 K) cn0) $ >
  $ wi ph (wbr (cmpt k cn0 A2) c_0 cfsupp) $ >
  $ wi ph (wcel L cn0) $ >
  $ wi ph (wceq (cfv L (cfv (co P (cmpt k cn0 (co A2 (co (cv k) X c_ex) c_as)) cgsu) cco1)) (csb k L A2)) $;

--| Two univariate polynomials given as (finitely supported) sum of scaled monomials are equal iff the corresponding coefficients are equal. (Contributed by AV, 21-Nov-2019.)
theorem gsumply1eq {k: setvar} (ph: wff) (A2 B2: class k) (P Q R c_ex c_as K O X c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_as (cfv P cvsca) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wral k (wcel A2 K) cn0) $ >
  $ wi ph (wbr (cmpt k cn0 A2) c_0 cfsupp) $ >
  $ wi ph (wral k (wcel B2 K) cn0) $ >
  $ wi ph (wbr (cmpt k cn0 B2) c_0 cfsupp) $ >
  $ wi ph (wceq O (co P (cmpt k cn0 (co A2 (co (cv k) X c_ex) c_as)) cgsu)) $ >
  $ wi ph (wceq Q (co P (cmpt k cn0 (co B2 (co (cv k) X c_ex) c_as)) cgsu)) $ >
  $ wi ph (wb (wceq O Q) (wral k (wceq A2 B2) cn0)) $;

--| The binomial theorem for linear polynomials (monic polynomials of degree 1) over commutative rings: ` ( X + A ) ^ N ` is the sum from ` k = 0 ` to ` N ` of ` ( N _C k ) x. ( ( A ^ ( N - k ) ) x. ( X ^ k ) ) ` . (Contributed by AV, 25-Aug-2019.)
theorem lply1binom {k: setvar} (A2: class) (B2: class k) (P c_pl R c_x c_xp c_ex: class) (G: class k) (N X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_pl (cfv P cplusg) $ >
  $ wceq c_xp (cfv P cmulr) $ >
  $ wceq c_x (cfv P cmg) $ >
  $ wceq G (cfv P cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi (w3a (wcel R ccrg) (wcel N cn0) (wcel A2 B2)) (wceq (co N (co X A2 c_pl) c_ex) (co P (cmpt k (co cc0 N cfz) (co (co N (cv k) cbc) (co (co (co N (cv k) cmin) A2 c_ex) (co (cv k) X c_ex) c_xp) c_x)) cgsu)) $;

--| The binomial theorem for linear polynomials (monic polynomials of degree 1) over commutative rings, expressed by an element of this ring: ` ( X + A ) ^ N ` is the sum from ` k = 0 ` to ` N ` of ` ( N _C k ) x. ( ( A ^ ( N - k ) ) x. ( X ^ k ) ) ` . (Contributed by AV, 25-Aug-2019.)
theorem lply1binomsc {k: setvar} (A2 P c_pl R S c_x c_xp: class) (E: class k) (c_ex: class) (G H: class k) (K N X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_pl (cfv P cplusg) $ >
  $ wceq c_xp (cfv P cmulr) $ >
  $ wceq c_x (cfv P cmg) $ >
  $ wceq G (cfv P cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq S (cfv P cascl) $ >
  $ wceq H (cfv R cmgp) $ >
  $ wceq E (cfv H cmg) $ >
  $ wi (w3a (wcel R ccrg) (wcel N cn0) (wcel A2 K)) (wceq (co N (co X (cfv A2 S) c_pl) c_ex) (co P (cmpt k (co cc0 N cfz) (co (co N (cv k) cbc) (co (cfv (co (co N (cv k) cmin) A2 E) S) (co (cv k) X c_ex) c_xp) c_x)) cgsu)) $;

--| Fermat's little theorem for polynomials in a commutative ring ` F ` of characteristic ` P ` prime: we have the polynomial equation ` ( X + A ) ^ P = ( ( X ^ P ) + A ) ` . (Contributed by Thierry Arnoux, 9-Jan-2025.)
theorem ply1fermltlchr (ph: wff) (A2 C P c_pl E c_ex F N W X: class):
  $ wceq W (cfv F cpl1) $ >
  $ wceq X (cfv F cv1) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq N (cfv W cmgp) $ >
  $ wceq c_ex (cfv N cmg) $ >
  $ wceq C (cfv W cascl) $ >
  $ wceq A2 (cfv (cfv E (cfv F czrh)) C) $ >
  $ wceq P (cfv F cchr) $ >
  $ wi ph (wcel F ccrg) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel E cz) $ >
  $ wi ph (wceq (co P (co X A2 c_pl) c_ex) (co (co P X c_ex) A2 c_pl)) $;

--| Evaluation of a univariate polynomial in a subring.
term ces1: class;

--| Evaluation of a univariate polynomial.
term ce1: class;

--| Define the evaluation map for the univariate polynomial algebra. The function ` ( S evalSub1 R ) : V --> ( S ^m S ) ` makes sense when ` S ` is a ring and ` R ` is a subring of ` S ` , and where ` V ` is the set of polynomials in ` ( Poly1 `` R ) ` . This function maps an element of the formal polynomial algebra (with coefficients in ` R ` ) to a function from assignments to the variable from ` S ` into an element of ` S ` formed by evaluating the polynomial with the given assignment. (Contributed by Mario Carneiro, 12-Jun-2015.)
axiom df_evls1 {x3 y1 s1 r b: setvar}:
  $ wceq ces1 (cmpo s1 r cvv (cpw (cfv (cv s1) cbs)) (csb b (cfv (cv s1) cbs) (ccom (cmpt x3 (co (cv b) (co (cv b) c1o cmap) cmap) (ccom (cv x3) (cmpt y1 (cv b) (cxp c1o (csn (cv y1)))))) (cfv (cv r) (co c1o (cv s1) ces))))) $;

--| Define the evaluation map for the univariate polynomial algebra. The function ` ( eval1 `` R ) : V --> ( R ^m R ) ` makes sense when ` R ` is a ring, and ` V ` is the set of polynomials in ` ( Poly1 `` R ) ` . This function maps an element of the formal polynomial algebra (with coefficients in ` R ` ) to a function from assignments to the variable from ` R ` into an element of ` R ` formed by evaluating the polynomial with the given assignment. (Contributed by Mario Carneiro, 12-Jun-2015.)
axiom df_evl1 {x3 y1 r b: setvar}:
  $ wceq ce1 (cmpt r cvv (csb b (cfv (cv r) cbs) (ccom (cmpt x3 (co (cv b) (co (cv b) c1o cmap) cmap) (ccom (cv x3) (cmpt y1 (cv b) (cxp c1o (csn (cv y1)))))) (co c1o (cv r) cevl)))) $;

--| Well-behaved binary operation property of ` evalSub1 ` . (Contributed by AV, 7-Sep-2019.)
theorem reldmevls1:
  $ wrel (cdm ces1) $;

--| Reverse closure for the set of univariate polynomial functions. (Contributed by AV, 9-Sep-2019.)
theorem ply1frcl (Q R S X: class):
  $ wceq Q (crn (co S R ces1)) $ >
  $ wi (wcel X Q) (wa (wcel S cvv) (wcel R (cpw (cfv S cbs)))) $;

--| Value of the univariate polynomial evaluation map function. (Contributed by AV, 7-Sep-2019.)
theorem evls1fval {x3 y1: setvar} (B2: class) (Q R S E V: class x3 y1):
  $ wceq Q (co S R ces1) $ >
  $ wceq E (co c1o S ces) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi (wa (wcel S V) (wcel R (cpw B2))) (wceq Q (ccom (cmpt x3 (co B2 (co B2 c1o cmap) cmap) (ccom (cv x3) (cmpt y1 B2 (cxp c1o (csn (cv y1)))))) (cfv R E))) $;

--| Value of the univariate polynomial evaluation map. (Contributed by AV, 10-Sep-2019.)
theorem evls1val {y1: setvar} (A2: class y1) (B2: class) (Q R S E K M: class y1):
  $ wceq Q (co S R ces1) $ >
  $ wceq E (co c1o S ces) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq M (co c1o (co S R cress) cmpl) $ >
  $ wceq K (cfv M cbs) $ >
  $ wi (w3a (wcel S ccrg) (wcel R (cfv S csubrg)) (wcel A2 K)) (wceq (cfv A2 Q) (ccom (cfv A2 (cfv R E)) (cmpt y1 B2 (cxp c1o (csn (cv y1)))))) $;

--| Lemma for ~ evl1rhm and ~ evls1rhm (formerly part of the proof of ~ evl1rhm ): The first function of the composition forming the univariate polynomial evaluation map function for a (sub)ring is a ring homomorphism. (Contributed by AV, 11-Sep-2019.)
theorem evls1rhmlem {x3 y1: setvar} (B2: class) (R T: class y1) (F: class x3 y1):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq T (co R B2 cpws) $ >
  $ wceq F (cmpt x3 (co B2 (co B2 c1o cmap) cmap) (ccom (cv x3) (cmpt y1 B2 (cxp c1o (csn (cv y1)))))) $ >
  $ wi (wcel R ccrg) (wcel F (co (co R (co B2 c1o cmap) cpws) T crh)) $;

--| Polynomial evaluation is a homomorphism (into the product ring). (Contributed by AV, 11-Sep-2019.)
theorem evls1rhm (B2 Q R S T U W: class):
  $ wceq Q (co S R ces1) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq T (co S B2 cpws) $ >
  $ wceq U (co S R cress) $ >
  $ wceq W (cfv U cpl1) $ >
  $ wi (wa (wcel S ccrg) (wcel R (cfv S csubrg))) (wcel Q (co W T crh)) $;

--| Univariate polynomial evaluation maps scalars to constant functions. (Contributed by AV, 8-Sep-2019.)
theorem evls1sca (ph: wff) (A2 B2 Q R S U W X: class):
  $ wceq Q (co S R ces1) $ >
  $ wceq W (cfv U cpl1) $ >
  $ wceq U (co S R cress) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq A2 (cfv W cascl) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel X R) $ >
  $ wi ph (wceq (cfv (cfv X A2) Q) (cxp B2 (csn X))) $;

--| Univariate polynomial evaluation maps (additive) group sums to group sums. (Contributed by AV, 14-Sep-2019.)
theorem evls1gsumadd {x3: setvar} (ph: wff) (B2: class) (P: class x3) (Q: class) (R S U K: class x3) (N: class) (W Y c_0: class x3):
  $ wceq Q (co S R ces1) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq W (cfv U cpl1) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq U (co S R cress) $ >
  $ wceq P (co S K cpws) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi (wa ph (wcel (cv x3) N)) (wcel Y B2) $ >
  $ wi ph (wss N cn0) $ >
  $ wi ph (wbr (cmpt x3 N Y) c_0 cfsupp) $ >
  $ wi ph (wceq (cfv (co W (cmpt x3 N Y) cgsu) Q) (co P (cmpt x3 N (cfv Y Q)) cgsu)) $;

--| Univariate polynomial evaluation maps (multiplicative) group sums to group sums. (Contributed by AV, 14-Sep-2019.)
theorem evls1gsummul {x3: setvar} (ph: wff) (B2: class) (P: class x3) (Q: class) (R S U c_1 G H K: class x3) (N: class) (W Y: class x3):
  $ wceq Q (co S R ces1) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq W (cfv U cpl1) $ >
  $ wceq G (cfv W cmgp) $ >
  $ wceq c_1 (cfv W cur) $ >
  $ wceq U (co S R cress) $ >
  $ wceq P (co S K cpws) $ >
  $ wceq H (cfv P cmgp) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi (wa ph (wcel (cv x3) N)) (wcel Y B2) $ >
  $ wi ph (wss N cn0) $ >
  $ wi ph (wbr (cmpt x3 N Y) c_1 cfsupp) $ >
  $ wi ph (wceq (cfv (co G (cmpt x3 N Y) cgsu) Q) (co H (cmpt x3 N (cfv Y Q)) cgsu)) $;

--| Univariate polynomial evaluation for subrings maps the exponentiation of a polynomial to the exponentiation of the evaluated polynomial. (Contributed by SN, 29-Feb-2024.)
theorem evls1pw (ph: wff) (B2 Q R S U c_ex G K N W X: class):
  $ wceq Q (co S R ces1) $ >
  $ wceq U (co S R cress) $ >
  $ wceq W (cfv U cpl1) $ >
  $ wceq G (cfv W cmgp) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cfv (co N X c_ex) Q) (co N (cfv X Q) (cfv (cfv (co S K cpws) cmgp) cmg))) $;

--| Univariate polynomial evaluation for subrings maps the exponentiation of a variable to the exponentiation of the evaluated variable. (Contributed by AV, 14-Sep-2019.)
theorem evls1varpw (ph: wff) (B2 Q R S U c_ex G N W X: class):
  $ wceq Q (co S R ces1) $ >
  $ wceq U (co S R cress) $ >
  $ wceq W (cfv U cpl1) $ >
  $ wceq G (cfv W cmgp) $ >
  $ wceq X (cfv U cv1) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (cfv (co N X c_ex) Q) (co N (cfv X Q) (cfv (cfv (co S B2 cpws) cmgp) cmg))) $;

--| Value of the simple/same ring evaluation map. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem evl1fval {x3 y1: setvar} (B2: class) (Q R: class y1) (O: class x3 y1):
  $ wceq O (cfv R ce1) $ >
  $ wceq Q (co c1o R cevl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq O (ccom (cmpt x3 (co B2 (co B2 c1o cmap) cmap) (ccom (cv x3) (cmpt y1 B2 (cxp c1o (csn (cv y1)))))) Q) $;

--| Value of the simple/same ring evaluation map. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem evl1val {y1: setvar} (A2: class y1) (B2: class) (Q R K M O: class y1):
  $ wceq O (cfv R ce1) $ >
  $ wceq Q (co c1o R cevl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq M (co c1o R cmpl) $ >
  $ wceq K (cfv M cbs) $ >
  $ wi (wa (wcel R ccrg) (wcel A2 K)) (wceq (cfv A2 O) (ccom (cfv A2 Q) (cmpt y1 B2 (cxp c1o (csn (cv y1)))))) $;

--| Lemma for ~ evl1fval1 . (Contributed by AV, 11-Sep-2019.)
theorem evl1fval1lem (B2 Q R V: class):
  $ wceq Q (cfv R ce1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R V) (wceq Q (co R B2 ces1)) $;

--| Value of the simple/same ring evaluation map function for univariate polynomials. (Contributed by AV, 11-Sep-2019.)
theorem evl1fval1 (B2 Q R: class):
  $ wceq Q (cfv R ce1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq Q (co R B2 ces1) $;

--| Polynomial evaluation is a homomorphism (into the product ring). (Contributed by Mario Carneiro, 12-Jun-2015.) (Proof shortened by AV, 13-Sep-2019.)
theorem evl1rhm (B2 P R T O: class):
  $ wceq O (cfv R ce1) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq T (co R B2 cpws) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R ccrg) (wcel O (co P T crh)) $;

--| The function value of the evaluation function of a polynomial is an element of the underlying ring. (Contributed by AV, 17-Sep-2019.)
theorem fveval1fvcl (ph: wff) (B2 P R U M O Y: class):
  $ wceq O (cfv R ce1) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel M U) $ >
  $ wi ph (wcel (cfv Y (cfv M O)) B2) $;

--| Polynomial evaluation maps scalars to constant functions. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem evl1sca (A2 B2 P R O X: class):
  $ wceq O (cfv R ce1) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wi (wa (wcel R ccrg) (wcel X B2)) (wceq (cfv (cfv X A2) O) (cxp B2 (csn X))) $;

--| Polynomial evaluation builder for scalars. (Contributed by Mario Carneiro, 4-Jul-2015.)
theorem evl1scad (ph: wff) (A2 B2 P R U O X Y: class):
  $ wceq O (cfv R ce1) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wa (wcel (cfv X A2) U) (wceq (cfv Y (cfv (cfv X A2) O)) X)) $;

--| Polynomial evaluation maps the variable to the identity function. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem evl1var (B2 R O X: class):
  $ wceq O (cfv R ce1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R ccrg) (wceq (cfv X O) (cres cid B2)) $;

--| Polynomial evaluation builder for the variable. (Contributed by Mario Carneiro, 4-Jul-2015.)
theorem evl1vard (ph: wff) (B2 P R U O X Y: class):
  $ wceq O (cfv R ce1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wa (wcel X U) (wceq (cfv Y (cfv X O)) Y)) $;

--| Univariate polynomial evaluation for subrings maps the variable to the identity function. (Contributed by AV, 13-Sep-2019.)
theorem evls1var (ph: wff) (B2 Q R S U X: class):
  $ wceq Q (co S R ces1) $ >
  $ wceq X (cfv U cv1) $ >
  $ wceq U (co S R cress) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wceq (cfv X Q) (cres cid B2)) $;

--| The evaluation of a scalar of a subring yields the same result as evaluated as a scalar over the ring itself. (Contributed by AV, 13-Sep-2019.)
theorem evls1scasrng (ph: wff) (A2 B2 C P Q R S U O W X: class):
  $ wceq Q (co S R ces1) $ >
  $ wceq O (cfv S ce1) $ >
  $ wceq W (cfv U cpl1) $ >
  $ wceq U (co S R cress) $ >
  $ wceq P (cfv S cpl1) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq A2 (cfv W cascl) $ >
  $ wceq C (cfv P cascl) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel X R) $ >
  $ wi ph (wceq (cfv (cfv X A2) Q) (cfv (cfv X C) O)) $;

--| The evaluation of the variable of univariate polynomials over subring yields the same result as evaluated as variable of the polynomials over the ring itself. (Contributed by AV, 12-Sep-2019.)
theorem evls1varsrng (ph: wff) (B2 Q R S U O V: class):
  $ wceq Q (co S R ces1) $ >
  $ wceq O (cfv S ce1) $ >
  $ wceq V (cfv U cv1) $ >
  $ wceq U (co S R cress) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wceq (cfv V Q) (cfv V O)) $;

--| Polynomial evaluation builder for addition of polynomials. (Contributed by Mario Carneiro, 4-Jul-2015.)
theorem evl1addd (ph: wff) (B2 P c_pl c_pb R U M N O V W Y: class):
  $ wceq O (cfv R ce1) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wa (wcel M U) (wceq (cfv Y (cfv M O)) V)) $ >
  $ wi ph (wa (wcel N U) (wceq (cfv Y (cfv N O)) W)) $ >
  $ wceq c_pb (cfv P cplusg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi ph (wa (wcel (co M N c_pb) U) (wceq (cfv Y (cfv (co M N c_pb) O)) (co V W c_pl))) $;

--| Polynomial evaluation builder for subtraction of polynomials. (Contributed by Mario Carneiro, 4-Jul-2015.)
theorem evl1subd (ph: wff) (B2 D P R U M c_mi N O V W Y: class):
  $ wceq O (cfv R ce1) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wa (wcel M U) (wceq (cfv Y (cfv M O)) V)) $ >
  $ wi ph (wa (wcel N U) (wceq (cfv Y (cfv N O)) W)) $ >
  $ wceq c_mi (cfv P csg) $ >
  $ wceq D (cfv R csg) $ >
  $ wi ph (wa (wcel (co M N c_mi) U) (wceq (cfv Y (cfv (co M N c_mi) O)) (co V W D))) $;

--| Polynomial evaluation builder for multiplication of polynomials. (Contributed by Mario Carneiro, 4-Jul-2015.)
theorem evl1muld (ph: wff) (B2 P R c_xb c_x U M N O V W Y: class):
  $ wceq O (cfv R ce1) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wa (wcel M U) (wceq (cfv Y (cfv M O)) V)) $ >
  $ wi ph (wa (wcel N U) (wceq (cfv Y (cfv N O)) W)) $ >
  $ wceq c_xb (cfv P cmulr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wa (wcel (co M N c_xb) U) (wceq (cfv Y (cfv (co M N c_xb) O)) (co V W c_x))) $;

--| Polynomial evaluation builder for scalar multiplication of polynomials. (Contributed by Mario Carneiro, 4-Jul-2015.)
theorem evl1vsd (ph: wff) (B2 P R c_xb c_x U M N O V Y: class):
  $ wceq O (cfv R ce1) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wa (wcel M U) (wceq (cfv Y (cfv M O)) V)) $ >
  $ wi ph (wcel N B2) $ >
  $ wceq c_xb (cfv P cvsca) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wa (wcel (co N M c_xb) U) (wceq (cfv Y (cfv (co N M c_xb) O)) (co N V c_x))) $;

--| Polynomial evaluation builder for an exponential. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem evl1expd (ph: wff) (B2 P R c_xb U c_ex M N O V Y: class):
  $ wceq O (cfv R ce1) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wa (wcel M U) (wceq (cfv Y (cfv M O)) V)) $ >
  $ wceq c_xb (cfv (cfv P cmgp) cmg) $ >
  $ wceq c_ex (cfv (cfv R cmgp) cmg) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wa (wcel (co N M c_xb) U) (wceq (cfv Y (cfv (co N M c_xb) O)) (co N V c_ex))) $;

--| Constants are polynomial functions. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem pf1const (B2 Q R X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq Q (crn (cfv R ce1)) $ >
  $ wi (wa (wcel R ccrg) (wcel X B2)) (wcel (cxp B2 (csn X)) Q) $;

--| The identity is a polynomial function. (Contributed by Mario Carneiro, 20-Mar-2015.)
theorem pf1id (B2 Q R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq Q (crn (cfv R ce1)) $ >
  $ wi (wcel R ccrg) (wcel (cres cid B2) Q) $;

--| Polynomial functions are a subring. (Contributed by Mario Carneiro, 19-Mar-2015.) (Revised by Mario Carneiro, 6-May-2015.)
theorem pf1subrg (B2 Q R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq Q (crn (cfv R ce1)) $ >
  $ wi (wcel R ccrg) (wcel Q (cfv (co R B2 cpws) csubrg)) $;

--| Reverse closure for the set of polynomial functions. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem pf1rcl (Q R X: class):
  $ wceq Q (crn (cfv R ce1)) $ >
  $ wi (wcel X Q) (wcel R ccrg) $;

--| Polynomial functions are functions. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem pf1f (B2 Q R F: class):
  $ wceq Q (crn (cfv R ce1)) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel F Q) (wf B2 B2 F) $;

--| Convert a multivariate polynomial function to univariate. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem mpfpf1 {y1: setvar} (B2: class) (Q: class y1) (R E F: class):
  $ wceq Q (crn (cfv R ce1)) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq E (crn (co c1o R cevl)) $ >
  $ wi (wcel F E) (wcel (ccom F (cmpt y1 B2 (cxp c1o (csn (cv y1))))) Q) $;

--| Convert a univariate polynomial function to multivariate. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem pf1mpf {x3: setvar} (B2 Q R: class) (E: class x3) (F: class):
  $ wceq Q (crn (cfv R ce1)) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq E (crn (co c1o R cevl)) $ >
  $ wi (wcel F Q) (wcel (ccom F (cmpt x3 (co B2 c1o cmap) (cfv c0 (cv x3)))) E) $;

--| The sum of multivariate polynomial functions. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem pf1addcl (c_pl Q R F G: class):
  $ wceq Q (crn (cfv R ce1)) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (wa (wcel F Q) (wcel G Q)) (wcel (co F G (cof c_pl)) Q) $;

--| The product of multivariate polynomial functions. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem pf1mulcl (Q R c_x F G: class):
  $ wceq Q (crn (cfv R ce1)) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel F Q) (wcel G Q)) (wcel (co F G (cof c_x)) Q) $;

--| Prove a property of polynomials by "structural" induction, under a simplified model of structure which loses the sum of products structure. (Contributed by Mario Carneiro, 12-Jun-2015.)
theorem pf1ind {x3 f2 g2: setvar} (ph ps: wff x3) (ch th ta: wff f2 g2) (et: wff g2) (ze si rh: wff f2 g2) (A2: class f2 g2) (B2 c_pl: class) (Q: class x3) (R: class x3 f2 g2) (c_x: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq Q (crn (cfv R ce1)) $ >
  $ wi (wa ph (wa (wa (wcel (cv f2) Q) ta) (wa (wcel (cv g2) Q) et))) ze $ >
  $ wi (wa ph (wa (wa (wcel (cv f2) Q) ta) (wa (wcel (cv g2) Q) et))) si $ >
  $ wi (wceq (cv x3) (cxp B2 (csn (cv f2)))) (wb ps ch) $ >
  $ wi (wceq (cv x3) (cres cid B2)) (wb ps th) $ >
  $ wi (wceq (cv x3) (cv f2)) (wb ps ta) $ >
  $ wi (wceq (cv x3) (cv g2)) (wb ps et) $ >
  $ wi (wceq (cv x3) (co (cv f2) (cv g2) (cof c_pl))) (wb ps ze) $ >
  $ wi (wceq (cv x3) (co (cv f2) (cv g2) (cof c_x))) (wb ps si) $ >
  $ wi (wceq (cv x3) A2) (wb ps rh) $ >
  $ wi (wa ph (wcel (cv f2) B2)) ch $ >
  $ wi ph th $ >
  $ wi ph (wcel A2 Q) $ >
  $ wi ph rh $;

--| Lemma for ~ evl1gsumd (induction step). (Contributed by AV, 17-Sep-2019.)
theorem evl1gsumdlem {x3 a: setvar} (ph: wff x3 a) (B2 P R: class x3 a) (U: class a) (m: setvar) (M: class x3 a) (O Y: class a):
  $ wceq O (cfv R ce1) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi (w3a (wcel (cv m) cfn) (wn (wcel (cv a) (cv m))) ph) (wi (wi (wral x3 (wcel M U) (cv m)) (wceq (cfv Y (cfv (co P (cmpt x3 (cv m) M) cgsu) O)) (co R (cmpt x3 (cv m) (cfv Y (cfv M O))) cgsu))) (wi (wral x3 (wcel M U) (cun (cv m) (csn (cv a)))) (wceq (cfv Y (cfv (co P (cmpt x3 (cun (cv m) (csn (cv a))) M) cgsu) O)) (co R (cmpt x3 (cun (cv m) (csn (cv a))) (cfv Y (cfv M O))) cgsu)))) $;

--| Polynomial evaluation builder for a finite group sum of polynomials. (Contributed by AV, 17-Sep-2019.)
theorem evl1gsumd {x3: setvar} (ph: wff) (B2: class) (P: class x3) (R U: class) (M: class x3) (N O Y: class):
  $ wceq O (cfv R ce1) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wral x3 (wcel M U) N) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wceq (cfv Y (cfv (co P (cmpt x3 N M) cgsu) O)) (co R (cmpt x3 N (cfv Y (cfv M O))) cgsu)) $;

--| Univariate polynomial evaluation maps (additive) group sums to group sums. Remark: the proof would be shorter if the theorem is proved directly instead of using ~ evls1gsumadd . (Contributed by AV, 15-Sep-2019.)
theorem evl1gsumadd {x3: setvar} (ph: wff) (B2: class) (P: class x3) (Q R K N: class) (W Y c_0: class x3):
  $ wceq Q (cfv R ce1) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq W (cfv R cpl1) $ >
  $ wceq P (co R K cpws) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi (wa ph (wcel (cv x3) N)) (wcel Y B2) $ >
  $ wi ph (wss N cn0) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wbr (cmpt x3 N Y) c_0 cfsupp) $ >
  $ wi ph (wceq (cfv (co W (cmpt x3 N Y) cgsu) Q) (co P (cmpt x3 N (cfv Y Q)) cgsu)) $;

--| Value of a univariate polynomial evaluation mapping an additive group sum to a group sum of the evaluated variable. (Contributed by AV, 17-Sep-2019.)
theorem evl1gsumaddval {x3: setvar} (ph: wff) (B2 C: class) (P: class x3) (Q R K N: class) (W Y: class x3):
  $ wceq Q (cfv R ce1) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq W (cfv R cpl1) $ >
  $ wceq P (co R K cpws) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi (wa ph (wcel (cv x3) N)) (wcel Y B2) $ >
  $ wi ph (wss N cn0) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wceq (cfv C (cfv (co W (cmpt x3 N Y) cgsu) Q)) (co R (cmpt x3 N (cfv C (cfv Y Q))) cgsu)) $;

--| Univariate polynomial evaluation maps (multiplicative) group sums to group sums. (Contributed by AV, 15-Sep-2019.)
theorem evl1gsummul {x3: setvar} (ph: wff) (B2: class) (P: class x3) (Q R: class) (c_1 G H: class x3) (K N: class) (W Y: class x3):
  $ wceq Q (cfv R ce1) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq W (cfv R cpl1) $ >
  $ wceq P (co R K cpws) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi (wa ph (wcel (cv x3) N)) (wcel Y B2) $ >
  $ wi ph (wss N cn0) $ >
  $ wceq c_1 (cfv W cur) $ >
  $ wceq G (cfv W cmgp) $ >
  $ wceq H (cfv P cmgp) $ >
  $ wi ph (wbr (cmpt x3 N Y) c_1 cfsupp) $ >
  $ wi ph (wceq (cfv (co G (cmpt x3 N Y) cgsu) Q) (co H (cmpt x3 N (cfv Y Q)) cgsu)) $;

--| Univariate polynomial evaluation maps the exponentiation of a variable to the exponentiation of the evaluated variable. Remark: in contrast to ~ evl1gsumadd , the proof is shorter using ~ evls1varpw instead of proving it directly. (Contributed by AV, 15-Sep-2019.)
theorem evl1varpw (ph: wff) (B2 Q R c_ex G N W X: class):
  $ wceq Q (cfv R ce1) $ >
  $ wceq W (cfv R cpl1) $ >
  $ wceq G (cfv W cmgp) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (cfv (co N X c_ex) Q) (co N (cfv X Q) (cfv (cfv (co R B2 cpws) cmgp) cmg))) $;

--| Value of a univariate polynomial evaluation mapping the exponentiation of a variable to the exponentiation of the evaluated variable. (Contributed by AV, 14-Sep-2019.)
theorem evl1varpwval (ph: wff) (B2 C Q R E c_ex G H N W X: class):
  $ wceq Q (cfv R ce1) $ >
  $ wceq W (cfv R cpl1) $ >
  $ wceq G (cfv W cmgp) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel C B2) $ >
  $ wceq H (cfv R cmgp) $ >
  $ wceq E (cfv H cmg) $ >
  $ wi ph (wceq (cfv C (cfv (co N X c_ex) Q)) (co N C E)) $;

--| Univariate polynomial evaluation maps a multiple of an exponentiation of a variable to the multiple of an exponentiation of the evaluated variable. (Contributed by AV, 18-Sep-2019.)
theorem evl1scvarpw (ph: wff) (A2 B2 Q R S c_xb c_xp c_ex F G M N W X: class):
  $ wceq Q (cfv R ce1) $ >
  $ wceq W (cfv R cpl1) $ >
  $ wceq G (cfv W cmgp) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel N cn0) $ >
  $ wceq c_xp (cfv W cvsca) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wceq S (co R B2 cpws) $ >
  $ wceq c_xb (cfv S cmulr) $ >
  $ wceq M (cfv S cmgp) $ >
  $ wceq F (cfv M cmg) $ >
  $ wi ph (wceq (cfv (co A2 (co N X c_ex) c_xp) Q) (co (cxp B2 (csn A2)) (co N (cfv X Q) F) c_xb)) $;

--| Value of a univariate polynomial evaluation mapping a multiple of an exponentiation of a variable to the multiple of the exponentiation of the evaluated variable. (Contributed by AV, 18-Sep-2019.)
theorem evl1scvarpwval (ph: wff) (A2 B2 C Q R c_x c_xp E c_ex G H N W X: class):
  $ wceq Q (cfv R ce1) $ >
  $ wceq W (cfv R cpl1) $ >
  $ wceq G (cfv W cmgp) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel N cn0) $ >
  $ wceq c_xp (cfv W cvsca) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wcel C B2) $ >
  $ wceq H (cfv R cmgp) $ >
  $ wceq E (cfv H cmg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wceq (cfv C (cfv (co A2 (co N X c_ex) c_xp) Q)) (co A2 (co N C E) c_x)) $;

--| Value of a univariate polynomial evaluation mapping an additive group sum of a multiple of an exponentiation of a variable to a group sum of the multiple of the exponentiation of the evaluated variable. (Contributed by AV, 18-Sep-2019.)
theorem evl1gsummon {x3: setvar} (ph: wff) (A2: class x3) (B2 C Q R: class) (c_x c_xp E c_ex G H: class x3) (K M: class) (N W X: class x3):
  $ wceq Q (cfv R ce1) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq W (cfv R cpl1) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq H (cfv R cmgp) $ >
  $ wceq E (cfv H cmg) $ >
  $ wceq G (cfv W cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wceq c_xp (cfv W cvsca) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wral x3 (wcel A2 K) M) $ >
  $ wi ph (wss M cn0) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wral x3 (wcel N cn0) M) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wceq (cfv C (cfv (co W (cmpt x3 M (co A2 (co N X c_ex) c_xp)) cgsu) Q)) (co R (cmpt x3 M (co A2 (co N C E) c_x)) cgsu)) $;

--| Value of the univariate polynomial evaluation for scalars. (Contributed by Thierry Arnoux, 21-Jan-2025.)
theorem evls1scafv (ph: wff) (A2 B2 C Q R S U W X: class):
  $ wceq Q (co S R ces1) $ >
  $ wceq W (cfv U cpl1) $ >
  $ wceq U (co S R cress) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq A2 (cfv W cascl) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel X R) $ >
  $ wi ph (wcel C B2) $ >
  $ wi ph (wceq (cfv C (cfv (cfv X A2) Q)) X) $;

--| Univariate polynomial evaluation builder for an exponential. See also ~ evl1expd . (Contributed by Thierry Arnoux, 24-Jan-2025.)
theorem evls1expd (ph: wff) (B2 C Q R S U c_ex K M c_an N W: class):
  $ wceq Q (co S R ces1) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq W (cfv U cpl1) $ >
  $ wceq U (co S R cress) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wceq c_an (cfv (cfv W cmgp) cmg) $ >
  $ wceq c_ex (cfv (cfv S cmgp) cmg) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel M B2) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wceq (cfv C (cfv (co N M c_an) Q)) (co N (cfv C (cfv M Q)) c_ex)) $;

--| Univariate polynomial evaluation for subrings maps the exponentiation of a variable to the exponentiation of the evaluated variable. See ~ evl1varpwval . (Contributed by Thierry Arnoux, 24-Jan-2025.)
theorem evls1varpwval (ph: wff) (B2 C Q R S U c_ex c_an N W X: class):
  $ wceq Q (co S R ces1) $ >
  $ wceq U (co S R cress) $ >
  $ wceq W (cfv U cpl1) $ >
  $ wceq X (cfv U cv1) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_an (cfv (cfv W cmgp) cmg) $ >
  $ wceq c_ex (cfv (cfv S cmgp) cmg) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel C B2) $ >
  $ wi ph (wceq (cfv C (cfv (co N X c_an) Q)) (co N C c_ex)) $;

--| Evaluation of a univariate subring polynomial as a function in a power series. (Contributed by Thierry Arnoux, 23-Jan-2025.)
theorem evls1fpws {x3 k: setvar} (ph: wff) (A2: class) (B2: class x3) (Q: class) (R: class x3 k) (S c_x U: class) (c_ex: class x3 k) (K: class) (M: class x3) (W: class):
  $ wceq Q (co S R ces1) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq W (cfv U cpl1) $ >
  $ wceq U (co S R cress) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel M B2) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wceq c_ex (cfv (cfv S cmgp) cmg) $ >
  $ wceq A2 (cfv M cco1) $ >
  $ wi ph (wceq (cfv M Q) (cmpt x3 K (co S (cmpt k cn0 (co (cfv (cv k) A2) (co (cv k) (cv x3) c_ex) c_x)) cgsu))) $;

--| Evaluation of a univariate subring polynomial is the same as the evaluation in the bigger ring. (Contributed by Thierry Arnoux, 23-Jan-2025.)
theorem ressply1evl (ph: wff) (B2 Q R S U E K W: class):
  $ wceq Q (co S R ces1) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq W (cfv U cpl1) $ >
  $ wceq U (co S R cress) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq E (cfv S ce1) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wceq Q (cres E B2)) $;

--| Univariate polynomial evaluation of a sum of polynomials. (Contributed by Thierry Arnoux, 8-Feb-2025.)
theorem evls1addd (ph: wff) (B2 C c_pl c_pd Q R S U K M N W: class):
  $ wceq Q (co S R ces1) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq W (cfv U cpl1) $ >
  $ wceq U (co S R cress) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_pd (cfv W cplusg) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel M B2) $ >
  $ wi ph (wcel N B2) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wceq (cfv C (cfv (co M N c_pd) Q)) (co (cfv C (cfv M Q)) (cfv C (cfv N Q)) c_pl)) $;

--| Univariate polynomial evaluation of a product of polynomials. (Contributed by Thierry Arnoux, 24-Jan-2025.)
theorem evls1muld (ph: wff) (B2 C Q R S c_x c_xp U K M N W: class):
  $ wceq Q (co S R ces1) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq W (cfv U cpl1) $ >
  $ wceq U (co S R cress) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_xp (cfv W cmulr) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel M B2) $ >
  $ wi ph (wcel N B2) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wceq (cfv C (cfv (co M N c_xp) Q)) (co (cfv C (cfv M Q)) (cfv C (cfv N Q)) c_x)) $;

--| Univariate polynomial evaluation of a scalar product of polynomials. (Contributed by Thierry Arnoux, 25-Feb-2025.)
theorem evls1vsca (ph: wff) (A2 B2 C Q R S c_x c_xp U K N W: class):
  $ wceq Q (co S R ces1) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq W (cfv U cpl1) $ >
  $ wceq U (co S R cress) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_xp (cfv W cvsca) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel A2 R) $ >
  $ wi ph (wcel N B2) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wceq (cfv C (cfv (co A2 N c_xp) Q)) (co A2 (cfv C (cfv N Q)) c_x)) $;

--| Closure of the algebra scalar injection function in a polynomial on a subring. (Contributed by Thierry Arnoux, 5-Feb-2025.)
theorem asclply1subcl (ph: wff) (A2 P R S U V W Z: class):
  $ wceq A2 (cfv V cascl) $ >
  $ wceq U (co R S cress) $ >
  $ wceq V (cfv R cpl1) $ >
  $ wceq W (cfv U cpl1) $ >
  $ wceq P (cfv W cbs) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wcel Z S) $ >
  $ wi ph (wcel (cfv Z A2) P) $;

--| Variant of ~ fveval1fvcl for the subring evaluation function ` evalSub1 ` . (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem evls1fvcl (ph: wff) (B2 P R S U M O Y: class):
  $ wceq O (co R S ces1) $ >
  $ wceq P (cfv (co R S cress) cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel M U) $ >
  $ wi ph (wcel (cfv Y (cfv M O)) B2) $;

--| The function ` F ` mapping polynomials ` p ` to their subring evaluation at a given point ` X ` is a ring homomorphism. (Contributed by Thierry Arnoux, 8-Feb-2025.)
theorem evls1maprhm {p: setvar} (ph: wff) (B2 P: class) (R S: class p) (U: class) (F: class p) (O X: class):
  $ wceq O (co R S ces1) $ >
  $ wceq P (cfv (co R S cress) cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wcel X B2) $ >
  $ wceq F (cmpt p U (cfv X (cfv (cv p) O))) $ >
  $ wi ph (wcel F (co P R crh)) $;

--| The function ` F ` mapping polynomials ` p ` to their subring evaluation at a given point ` A ` is a module homomorphism, when considering the subring algebra. (Contributed by Thierry Arnoux, 25-Feb-2025.)
theorem evls1maplmhm {p: setvar} (ph: wff) (A2: class p) (B2 P: class) (R: class p) (S U: class) (F: class p) (O X: class):
  $ wceq O (co R S ces1) $ >
  $ wceq P (cfv (co R S cress) cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wcel X B2) $ >
  $ wceq F (cmpt p U (cfv X (cfv (cv p) O))) $ >
  $ wceq A2 (cfv S (cfv R csra)) $ >
  $ wi ph (wcel F (co P A2 clmhm)) $;

--| The function ` F ` mapping polynomials ` p ` to their subring evaluation at a given point ` A ` takes all values in the subring ` S ` . (Contributed by Thierry Arnoux, 25-Feb-2025.)
theorem evls1maprnss {p: setvar} (ph: wff) (B2 P: class) (R: class p) (S U: class) (F: class p) (O X: class):
  $ wceq O (co R S ces1) $ >
  $ wceq P (cfv (co R S cress) cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wcel X B2) $ >
  $ wceq F (cmpt p U (cfv X (cfv (cv p) O))) $ >
  $ wi ph (wss S (crn F)) $;

--| The function ` F ` mapping polynomials ` p ` to their evaluation at a given point ` X ` is a ring homomorphism. (Contributed by metakunt, 19-May-2025.)
theorem evl1maprhm {p: setvar} (ph: wff) (B2 P: class p) (R: class) (U F O: class p) (X: class):
  $ wceq O (cfv R ce1) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X B2) $ >
  $ wceq F (cmpt p U (cfv X (cfv (cv p) O))) $ >
  $ wi ph (wcel F (co P R crh)) $;

--| Provide a ring homomorphism between two polynomial algebras over their respective base rings given a ring homomorphism between the two base rings. Compare ~ pwsco2rhm . (Contributed by SN, 8-Feb-2025.)
theorem rhmmpl {p: setvar} (ph: wff) (B2 P Q: class) (R S F: class p) (H: class) (I V: class p):
  $ wceq P (co I R cmpl) $ >
  $ wceq Q (co I S cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq F (cmpt p B2 (ccom H (cv p))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel H (co R S crh)) $ >
  $ wi ph (wcel F (co P Q crh)) $;

--| Closure of scalar multiplication for univariate polynomials. (Contributed by SN, 20-May-2025.)
theorem ply1vscl (ph: wff) (B2 C P R c_x K X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel (co C X c_x) B2) $;

--| The composition of a monoid homomorphism and a polynomial is a polynomial. (Contributed by SN, 20-May-2025.)
theorem mhmcoply1 (ph: wff) (B2 C P Q R S F H: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq Q (cfv S cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq C (cfv Q cbs) $ >
  $ wi ph (wcel H (co R S cmhm)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel (ccom H F) C) $;

--| Provide a ring homomorphism between two univariate polynomial algebras over their respective base rings given a ring homomorphism between the two base rings. (Contributed by SN, 20-May-2025.)
theorem rhmply1 {p: setvar} (ph: wff) (B2: class) (P Q: class p) (R S: class) (F: class p) (H: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq Q (cfv S cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq F (cmpt p B2 (ccom H (cv p))) $ >
  $ wi ph (wcel H (co R S crh)) $ >
  $ wi ph (wcel F (co P Q crh)) $;

--| A ring homomorphism between two univariate polynomial algebras sends one variable to the other. (Contributed by SN, 20-May-2025.)
theorem rhmply1vr1 {p: setvar} (ph: wff p) (B2: class) (P Q R S F: class p) (H X: class) (Y: class p):
  $ wceq P (cfv R cpl1) $ >
  $ wceq Q (cfv S cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq F (cmpt p B2 (ccom H (cv p))) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq Y (cfv S cv1) $ >
  $ wi ph (wcel H (co R S crh)) $ >
  $ wi ph (wceq (cfv X F) Y) $;

--| Apply a ring homomorphism between two univariate polynomial algebras to a scaled polynomial. (Contributed by SN, 20-May-2025.)
theorem rhmply1vsca {p: setvar} (ph: wff p) (B2 C: class) (P Q R S c_xb: class p) (c_x: class) (F: class p) (H: class) (K: class p) (X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq Q (cfv S cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq F (cmpt p B2 (ccom H (cv p))) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq c_xb (cfv Q cvsca) $ >
  $ wi ph (wcel H (co R S crh)) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cfv (co C X c_x) F) (co (cfv C H) (cfv X F) c_xb)) $;

--| Apply a ring homomorphism between two univariate polynomial algebras to a scaled monomial, as in ~ ply1coe . (Contributed by SN, 20-May-2025.)
theorem rhmply1mon {p: setvar} (ph: wff) (B2 C: class) (P Q: class p) (R S: class) (c_xb: class p) (c_x E c_ex: class) (F: class p) (H: class) (K M c_an N: class p) (X: class) (Y: class p):
  $ wceq P (cfv R cpl1) $ >
  $ wceq Q (cfv S cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq F (cmpt p B2 (ccom H (cv p))) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq Y (cfv S cv1) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq c_xb (cfv Q cvsca) $ >
  $ wceq M (cfv P cmgp) $ >
  $ wceq N (cfv Q cmgp) $ >
  $ wceq c_ex (cfv M cmg) $ >
  $ wceq c_an (cfv N cmg) $ >
  $ wi ph (wcel H (co R S crh)) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wcel E cn0) $ >
  $ wi ph (wceq (cfv (co C (co E X c_ex) c_x) F) (co (cfv C H) (co E Y c_an) c_xb)) $;

--| Syntax for the matrix multiplication operator.
term cmmul: class;

--| The operator which multiplies an m x n matrix with an n x p matrix, see also the definition in [Lang] p. 504. Note that it is not generally possible to recover the dimensions from the matrix, since all n x 0 and all 0 x n matrices are represented by the empty set. (Contributed by Stefan O'Rear, 4-Sep-2015.)
axiom df_mamu {x3 y1 i j k m n o r p: setvar}:
  $ wceq cmmul (cmpo r o cvv cvv (csb m (cfv (cfv (cv o) c1st) c1st) (csb n (cfv (cfv (cv o) c1st) c2nd) (csb p (cfv (cv o) c2nd) (cmpo x3 y1 (co (cfv (cv r) cbs) (cxp (cv m) (cv n)) cmap) (co (cfv (cv r) cbs) (cxp (cv n) (cv p)) cmap) (cmpo i k (cv m) (cv p) (co (cv r) (cmpt j (cv n) (co (co (cv i) (cv j) (cv x3)) (co (cv j) (cv k) (cv y1)) (cfv (cv r) cmulr))) cgsu))))))) $;

--| Functional value of the matrix multiplication operator. (Contributed by Stefan O'Rear, 2-Sep-2015.)
theorem mamufval {x3 y1 i j k: setvar} (ph: wff) (B2: class i j k) (P R: class) (c_x: class j) (F: class x3 y1 i j k) (M N: class) (V: class x3 y1 i j k):
  $ wceq F (co R (cotp M N P) cmmul) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel P cfn) $ >
  $ wi ph (wceq F (cmpo x3 y1 (co B2 (cxp M N) cmap) (co B2 (cxp N P) cmap) (cmpo i k M P (co R (cmpt j N (co (co (cv i) (cv j) (cv x3)) (co (cv j) (cv k) (cv y1)) c_x)) cgsu)))) $;

--| Multiplication of two matrices. (Contributed by Stefan O'Rear, 2-Sep-2015.)
theorem mamuval {i j k: setvar} (ph: wff) (B2: class i j k) (P R: class) (c_x: class j) (F: class i j k) (M N: class) (V: class i j k) (X Y: class):
  $ wceq F (co R (cotp M N P) cmmul) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel P cfn) $ >
  $ wi ph (wcel X (co B2 (cxp M N) cmap)) $ >
  $ wi ph (wcel Y (co B2 (cxp N P) cmap)) $ >
  $ wi ph (wceq (co X Y F) (cmpo i k M P (co R (cmpt j N (co (co (cv i) (cv j) X) (co (cv j) (cv k) Y) c_x)) cgsu))) $;

--| A cell in the multiplication of two matrices. (Contributed by Stefan O'Rear, 2-Sep-2015.)
theorem mamufv {j: setvar} (ph: wff) (B2: class j) (P R: class) (c_x F: class j) (I K M N: class) (V: class j) (X Y: class):
  $ wceq F (co R (cotp M N P) cmmul) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel P cfn) $ >
  $ wi ph (wcel X (co B2 (cxp M N) cmap)) $ >
  $ wi ph (wcel Y (co B2 (cxp N P) cmap)) $ >
  $ wi ph (wcel I M) $ >
  $ wi ph (wcel K P) $ >
  $ wi ph (wceq (co I K (co X Y F)) (co R (cmpt j N (co (co I (cv j) X) (co (cv j) K Y) c_x)) cgsu)) $;

--| The domain of the matrix multiplication function. (Contributed by AV, 10-Feb-2019.)
theorem mamudm (B2 C P R c_xp E F M N V: class):
  $ wceq E (co R (cxp M N) cfrlm) $ >
  $ wceq B2 (cfv E cbs) $ >
  $ wceq F (co R (cxp N P) cfrlm) $ >
  $ wceq C (cfv F cbs) $ >
  $ wceq c_xp (co R (cotp M N P) cmmul) $ >
  $ wi (wa (wcel R V) (w3a (wcel M cfn) (wcel N cfn) (wcel P cfn))) (wceq (cdm c_xp) (cxp B2 C)) $;

--| Every solution of the equation ` A * X = B ` for matrices ` A ` and ` B ` is a matrix. (Contributed by AV, 10-Feb-2019.)
theorem mamufacex (B2 C D P R c_xp E F G M N V X Y Z: class):
  $ wceq E (co R (cxp M N) cfrlm) $ >
  $ wceq B2 (cfv E cbs) $ >
  $ wceq F (co R (cxp N P) cfrlm) $ >
  $ wceq C (cfv F cbs) $ >
  $ wceq c_xp (co R (cotp M N P) cmmul) $ >
  $ wceq G (co R (cxp M P) cfrlm) $ >
  $ wceq D (cfv G cbs) $ >
  $ wi (w3a (wa (wne M c0) (wne P c0)) (wa (wcel R V) (wcel Y D)) (w3a (wcel M cfn) (wcel N cfn) (wcel P cfn))) (wi (wceq (co X Z c_xp) Y) (wcel Z C)) $;

--| Rows in a matrix product are functions only of the corresponding rows in the left argument. (Contributed by SO, 9-Jul-2018.)
theorem mamures (ph: wff) (B2 P R F G I M N V X Y: class):
  $ wceq F (co R (cotp M N P) cmmul) $ >
  $ wceq G (co R (cotp I N P) cmmul) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel P cfn) $ >
  $ wi ph (wss I M) $ >
  $ wi ph (wcel X (co B2 (cxp M N) cmap)) $ >
  $ wi ph (wcel Y (co B2 (cxp N P) cmap)) $ >
  $ wi ph (wceq (cres (co X Y F) (cxp I P)) (co (cres X (cxp I N)) Y G)) $;

--| Tuple-wise left inverse in groups. (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem grpvlinv (B2 c_pl G I N X c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wceq N (cfv G cminusg) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi (wa (wcel G cgrp) (wcel X (co B2 I cmap))) (wceq (co (ccom N X) X (cof c_pl)) (cxp I (csn c_0))) $;

--| Tuple-wise right inverse in groups. (Contributed by Mario Carneiro, 22-Sep-2015.)
theorem grpvrinv (B2 c_pl G I N X c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wceq N (cfv G cminusg) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi (wa (wcel G cgrp) (wcel X (co B2 I cmap))) (wceq (co X (ccom N X) (cof c_pl)) (cxp I (csn c_0))) $;

--| Tuple-wise multiplication closure in monoids. (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem ringvcl (B2 R c_x I X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R crg) (wcel X (co B2 I cmap)) (wcel Y (co B2 I cmap))) (wcel (co X Y (cof c_x)) (co B2 I cmap)) $;

--| Operation closure of matrix multiplication. (Contributed by Stefan O'Rear, 2-Sep-2015.) (Proof shortened by AV, 23-Jul-2019.)
theorem mamucl (ph: wff) (B2 P R F M N X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq F (co R (cotp M N P) cmmul) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel P cfn) $ >
  $ wi ph (wcel X (co B2 (cxp M N) cmap)) $ >
  $ wi ph (wcel Y (co B2 (cxp N P) cmap)) $ >
  $ wi ph (wcel (co X Y F) (co B2 (cxp M P) cmap)) $;

--| Matrix multiplication is associative, see also statement in [Lang] p. 505. (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem mamuass (ph: wff) (B2 P R F G H I M N O X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel O cfn) $ >
  $ wi ph (wcel P cfn) $ >
  $ wi ph (wcel X (co B2 (cxp M N) cmap)) $ >
  $ wi ph (wcel Y (co B2 (cxp N O) cmap)) $ >
  $ wi ph (wcel Z (co B2 (cxp O P) cmap)) $ >
  $ wceq F (co R (cotp M N O) cmmul) $ >
  $ wceq G (co R (cotp M O P) cmmul) $ >
  $ wceq H (co R (cotp M N P) cmmul) $ >
  $ wceq I (co R (cotp N O P) cmmul) $ >
  $ wi ph (wceq (co (co X Y F) Z G) (co X (co Y Z I) H)) $;

--| Matrix multiplication distributes over addition on the left. (Contributed by Stefan O'Rear, 5-Sep-2015.) (Proof shortened by AV, 23-Jul-2019.)
theorem mamudi (ph: wff) (B2 c_pl R F M N O X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq F (co R (cotp M N O) cmmul) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel O cfn) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi ph (wcel X (co B2 (cxp M N) cmap)) $ >
  $ wi ph (wcel Y (co B2 (cxp M N) cmap)) $ >
  $ wi ph (wcel Z (co B2 (cxp N O) cmap)) $ >
  $ wi ph (wceq (co (co X Y (cof c_pl)) Z F) (co (co X Z F) (co Y Z F) (cof c_pl))) $;

--| Matrix multiplication distributes over addition on the right. (Contributed by Stefan O'Rear, 5-Sep-2015.) (Proof shortened by AV, 23-Jul-2019.)
theorem mamudir (ph: wff) (B2 c_pl R F M N O X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq F (co R (cotp M N O) cmmul) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel O cfn) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi ph (wcel X (co B2 (cxp M N) cmap)) $ >
  $ wi ph (wcel Y (co B2 (cxp N O) cmap)) $ >
  $ wi ph (wcel Z (co B2 (cxp N O) cmap)) $ >
  $ wi ph (wceq (co X (co Y Z (cof c_pl)) F) (co (co X Y F) (co X Z F) (cof c_pl))) $;

--| Matrix multiplication distributes over scalar multiplication on the left. (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem mamuvs1 (ph: wff) (B2 R c_x F M N O X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq F (co R (cotp M N O) cmmul) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel O cfn) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y (co B2 (cxp M N) cmap)) $ >
  $ wi ph (wcel Z (co B2 (cxp N O) cmap)) $ >
  $ wi ph (wceq (co (co (cxp (cxp M N) (csn X)) Y (cof c_x)) Z F) (co (cxp (cxp M O) (csn X)) (co Y Z F) (cof c_x))) $;

--| Matrix multiplication distributes over scalar multiplication on the left. (Contributed by Stefan O'Rear, 5-Sep-2015.) (Proof shortened by AV, 22-Jul-2019.)
theorem mamuvs2 (ph: wff) (B2 R c_x F M N O X Y Z: class):
  $ wi ph (wcel R ccrg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq F (co R (cotp M N O) cmmul) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel O cfn) $ >
  $ wi ph (wcel X (co B2 (cxp M N) cmap)) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z (co B2 (cxp N O) cmap)) $ >
  $ wi ph (wceq (co X (co (cxp (cxp N O) (csn Y)) Z (cof c_x)) F) (co (cxp (cxp M O) (csn Y)) (co X Z F) (cof c_x))) $;

--| Syntax for the square matrix algebra.
term cmat: class;

--| Define the algebra of n x n matrices over a ring r. (Contributed by Stefan O'Rear, 31-Aug-2015.)
axiom df_mat {n r: setvar}:
  $ wceq cmat (cmpo n r cfn cvv (co (co (cv r) (cxp (cv n) (cv n)) cfrlm) (cop (cfv cnx cmulr) (co (cv r) (cotp (cv n) (cv n) (cv n)) cmmul)) csts)) $;

--| There is no matrix with a proper class either as dimension or as underlying ring. (Contributed by AV, 28-Dec-2018.)
theorem matbas0pc (R N: class):
  $ wi (wn (wa (wcel N cvv) (wcel R cvv))) (wceq (cfv (co N R cmat) cbs) c0) $;

--| There is no matrix for a not finite dimension or a proper class as the underlying ring. (Contributed by AV, 28-Dec-2018.)
theorem matbas0 (R N: class):
  $ wi (wn (wa (wcel N cfn) (wcel R cvv))) (wceq (cfv (co N R cmat) cbs) c0) $;

--| Value of the matrix algebra. (Contributed by Stefan O'Rear, 4-Sep-2015.)
theorem matval (A2 R c_x G N V: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq G (co R (cxp N N) cfrlm) $ >
  $ wceq c_x (co R (cotp N N N) cmmul) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wceq A2 (co G (cop (cfv cnx cmulr) c_x) csts)) $;

--| Reverse closure for the matrix algebra. (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem matrcl (A2 B2 R N X: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (wcel X B2) (wa (wcel N cfn) (wcel R cvv)) $;

--| The matrix ring has the same base set as its underlying group. (Contributed by Stefan O'Rear, 4-Sep-2015.)
theorem matbas (A2 R G N V: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq G (co R (cxp N N) cfrlm) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wceq (cfv G cbs) (cfv A2 cbs)) $;

--| The matrix ring has the same addition as its underlying group. (Contributed by Stefan O'Rear, 4-Sep-2015.)
theorem matplusg (A2 R G N V: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq G (co R (cxp N N) cfrlm) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wceq (cfv G cplusg) (cfv A2 cplusg)) $;

--| The matrix ring has the same scalars as its underlying linear structure. (Contributed by Stefan O'Rear, 4-Sep-2015.) (Proof shortened by AV, 12-Nov-2024.)
theorem matsca (A2 R G N V: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq G (co R (cxp N N) cfrlm) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wceq (cfv G csca) (cfv A2 csca)) $;

--| The matrix ring has the same scalar multiplication as its underlying linear structure. (Contributed by Stefan O'Rear, 4-Sep-2015.) (Proof shortened by AV, 12-Nov-2024.)
theorem matvsca (A2 R G N V: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq G (co R (cxp N N) cfrlm) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wceq (cfv G cvsca) (cfv A2 cvsca)) $;

--| The matrix ring has the same zero as its underlying linear structure. (Contributed by Stefan O'Rear, 4-Sep-2015.)
theorem mat0 (A2 R G N V: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq G (co R (cxp N N) cfrlm) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wceq (cfv G c0g) (cfv A2 c0g)) $;

--| The matrix ring has the same additive inverse as its underlying linear structure. (Contributed by Stefan O'Rear, 4-Sep-2015.)
theorem matinvg (A2 R G N V: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq G (co R (cxp N N) cfrlm) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wceq (cfv G cminusg) (cfv A2 cminusg)) $;

--| Value of a zero matrix as operation. (Contributed by AV, 2-Dec-2018.)
theorem mat0op {i j: setvar} (A2: class i j) (R N: class) (c_0: class i j):
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wceq (cfv A2 c0g) (cmpo i j N N c_0)) $;

--| The scalars of the matrix ring are the underlying ring. (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem matsca2 (A2 R N V: class):
  $ wceq A2 (co N R cmat) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wceq R (cfv A2 csca)) $;

--| The base set of the matrix ring as a set exponential. (Contributed by Stefan O'Rear, 5-Sep-2015.) (Proof shortened by AV, 16-Dec-2018.)
theorem matbas2 (A2 R K N V: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wceq (co K (cxp N N) cmap) (cfv A2 cbs)) $;

--| A matrix is a function. (Contributed by Stefan O'Rear, 11-Sep-2015.)
theorem matbas2i (A2 B2 R K M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (wcel M B2) (wcel M (co K (cxp N N) cmap)) $;

--| The base set of the matrix ring as a mapping operation. (Contributed by Stefan O'Rear, 11-Jul-2018.)
theorem matbas2d {x3 y1: setvar} (ph: wff) (A2 B2 C R: class x3 y1) (K N: class) (V: class x3 y1):
  $ wceq A2 (co N R cmat) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel R V) $ >
  $ wi (w3a ph (wcel (cv x3) N) (wcel (cv y1) N)) (wcel C K) $ >
  $ wi ph (wcel (cmpo x3 y1 N N C) B2) $;

--| Two square matrices of the same dimension are equal if they have the same entries. (Contributed by AV, 25-Sep-2019.)
theorem eqmat {i j: setvar} (A2 B2 R: class i j) (N X Y: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (wa (wcel X B2) (wcel Y B2)) (wb (wceq X Y) (wral i (wral j (wceq (co (cv i) (cv j) X) (co (cv i) (cv j) Y)) N) N)) $;

--| Each entry (according to Wikipedia "Matrix (mathematics)", 30-Dec-2018, ~ https://en.wikipedia.org/wiki/Matrix_(mathematics)#Definition (or element or component or coefficient or cell) of a matrix is an element of the underlying ring. (Contributed by AV, 16-Dec-2018.)
theorem matecl (A2 R I J K M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi (w3a (wcel I N) (wcel J N) (wcel M (cfv A2 cbs))) (wcel (co I J M) K) $;

--| Each entry (according to Wikipedia "Matrix (mathematics)", 30-Dec-2018, ~ https://en.wikipedia.org/wiki/Matrix_(mathematics)#Definition (or element or component or coefficient or cell) of a matrix is an element of the underlying ring, deduction form. (Contributed by AV, 27-Nov-2019.)
theorem matecld (ph: wff) (A2 B2 R I J K M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi ph (wcel I N) $ >
  $ wi ph (wcel J N) $ >
  $ wi ph (wcel M B2) $ >
  $ wi ph (wcel (co I J M) K) $;

--| Addition in the matrix ring is cell-wise. (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem matplusg2 (A2 B2 c_pl c_pb R N X Y: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_pb (cfv A2 cplusg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (wa (wcel X B2) (wcel Y B2)) (wceq (co X Y c_pb) (co X Y (cof c_pl))) $;

--| Scalar multiplication in the matrix ring is cell-wise. (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem matvsca2 (A2 B2 C R c_x c_xp K N X Y: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_x (cfv A2 cvsca) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq C (cxp N N) $ >
  $ wi (wa (wcel X K) (wcel Y B2)) (wceq (co X Y c_x) (co (cxp C (csn X)) Y (cof c_xp))) $;

--| The matrix ring is a linear structure. (Contributed by Stefan O'Rear, 4-Sep-2015.)
theorem matlmod (A2 R N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel A2 clmod) $;

--| The matrix ring is a group. (Contributed by AV, 21-Dec-2019.)
theorem matgrp (A2 R N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel A2 cgrp) $;

--| Closure of the scalar multiplication in the matrix ring. ( ~ lmodvscl analog.) (Contributed by AV, 27-Nov-2019.)
theorem matvscl (A2 B2 C R c_x K N X: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_x (cfv A2 cvsca) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R crg)) (wa (wcel C K) (wcel X B2))) (wcel (co C X c_x) B2) $;

--| The matrix ring has the same addition as its underlying group. (Contributed by AV, 2-Aug-2019.)
theorem matsubg (A2 R G N V: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq G (co R (cxp N N) cfrlm) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wceq (cfv G csg) (cfv A2 csg)) $;

--| Addition in the matrix ring is cell-wise. (Contributed by AV, 2-Aug-2019.)
theorem matplusgcell (A2 B2 c_pl c_pb R I J N X Y: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_pb (cfv A2 cplusg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi (wa (wa (wcel X B2) (wcel Y B2)) (wa (wcel I N) (wcel J N))) (wceq (co I J (co X Y c_pb)) (co (co I J X) (co I J Y) c_pl)) $;

--| Subtraction in the matrix ring is cell-wise. (Contributed by AV, 2-Aug-2019.)
theorem matsubgcell (A2 B2 R S I J c_mi N X Y: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq S (cfv A2 csg) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wi (w3a (wcel R crg) (wa (wcel X B2) (wcel Y B2)) (wa (wcel I N) (wcel J N))) (wceq (co I J (co X Y S)) (co (co I J X) (co I J Y) c_mi)) $;

--| Additive inversion in the matrix ring is cell-wise. (Contributed by AV, 17-Nov-2019.)
theorem matinvgcell (A2 B2 R I J N V W X: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (cfv R cminusg) $ >
  $ wceq W (cfv A2 cminusg) $ >
  $ wi (w3a (wcel R crg) (wcel X B2) (wa (wcel I N) (wcel J N))) (wceq (co I J (cfv X W)) (cfv (co I J X) V)) $;

--| Scalar multiplication in the matrix ring is cell-wise. (Contributed by AV, 7-Aug-2019.)
theorem matvscacell (A2 B2 R c_x c_xp I J K N X Y: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_x (cfv A2 cvsca) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wi (w3a (wcel R crg) (wa (wcel X K) (wcel Y B2)) (wa (wcel I N) (wcel J N))) (wceq (co I J (co X Y c_x)) (co X (co I J Y) c_xp)) $;

--| Finite commutative sums in a matrix algebra are taken componentwise. (Contributed by AV, 26-Sep-2019.)
theorem matgsum {y1 i j: setvar} (ph: wff i j) (A2 B2: class y1 i j) (R: class) (U: class y1 i j) (J N: class) (W c_0: class y1 i j):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_0 (cfv A2 c0g) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel J W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi (wa ph (wcel (cv y1) J)) (wcel (cmpo i j N N U) B2) $ >
  $ wi ph (wbr (cmpt y1 J (cmpo i j N N U)) c_0 cfsupp) $ >
  $ wi ph (wceq (co A2 (cmpt y1 J (cmpo i j N N U)) cgsu) (cmpo i j N N (co R (cmpt y1 J U) cgsu))) $;

--| Multiplication in the matrix algebra. (Contributed by Stefan O'Rear, 4-Sep-2015.)
theorem matmulr (A2 R c_x N V: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_x (co R (cotp N N N) cmmul) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wceq c_x (cfv A2 cmulr)) $;

--| The identity matrix (as operation in maps-to notation) is a matrix. (Contributed by Stefan O'Rear, 2-Sep-2015.)
theorem mamumat1cl {i j: setvar} (ph: wff) (B2: class) (R c_1 I: class i j) (M: class) (c_0: class i j):
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq I (cmpo i j M M (cif (wceq (cv i) (cv j)) c_1 c_0)) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wcel I (co B2 (cxp M M) cmap)) $;

--| The components of the identity matrix (as operation in maps-to notation). (Contributed by AV, 22-Jul-2019.)
theorem mat1comp {i j: setvar} (ph: wff) (A2 B2: class) (R: class i j) (c_1: class) (I: class i j) (J M c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq I (cmpo i j M M (cif (wceq (cv i) (cv j)) c_1 c_0)) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi (wa (wcel A2 M) (wcel J M)) (wceq (co A2 J I) (cif (wceq A2 J) c_1 c_0)) $;

--| The identity matrix (as operation in maps-to notation) is a left identity (for any matrix with the same number of rows). (Contributed by Stefan O'Rear, 3-Sep-2015.) (Proof shortened by AV, 22-Jul-2019.)
theorem mamulid {i j: setvar} (ph: wff) (B2: class) (R: class i j) (c_1: class) (F I: class i j) (M: class) (N X: class i j) (c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq I (cmpo i j M M (cif (wceq (cv i) (cv j)) c_1 c_0)) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wcel N cfn) $ >
  $ wceq F (co R (cotp M M N) cmmul) $ >
  $ wi ph (wcel X (co B2 (cxp M N) cmap)) $ >
  $ wi ph (wceq (co I X F) X) $;

--| The identity matrix (as operation in maps-to notation) is a right identity (for any matrix with the same number of columns). (Contributed by Stefan O'Rear, 3-Sep-2015.) (Proof shortened by AV, 22-Jul-2019.)
theorem mamurid {i j: setvar} (ph: wff) (B2: class) (R: class i j) (c_1: class) (F I: class i j) (M: class) (N X: class i j) (c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq I (cmpo i j M M (cif (wceq (cv i) (cv j)) c_1 c_0)) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wcel N cfn) $ >
  $ wceq F (co R (cotp N M M) cmmul) $ >
  $ wi ph (wcel X (co B2 (cxp N M) cmap)) $ >
  $ wi ph (wceq (co X I F) X) $;

--| Existence of the matrix ring, see also the statement in [Lang] p. 504: "For a given integer n > 0 the set of square n x n matrices form a ring." (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem matring (A2 R N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel A2 crg) $;

--| Existence of the matrix algebra, see also the statement in [Lang] p. 505: "Then Mat_n(R) is an algebra over R" . (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem matassa (A2 R N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wi (wa (wcel N cfn) (wcel R ccrg)) (wcel A2 casa) $;

--| Multiplication in the matrix ring for a single cell of a matrix. (Contributed by AV, 17-Nov-2019.) (Revised by AV, 3-Jul-2022.)
theorem matmulcell {j: setvar} (A2: class j) (B2 R: class) (c_xp: class j) (I J N X Y: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_xp (cfv A2 cmulr) $ >
  $ wi (w3a (wcel R crg) (wa (wcel X B2) (wcel Y B2)) (wa (wcel I N) (wcel J N))) (wceq (co I J (co X Y c_xp)) (co R (cmpt j N (co (co I (cv j) X) (co (cv j) J Y) (cfv R cmulr))) cgsu)) $;

--| Multiplication of two N x N matrices given in maps-to notation. (Contributed by AV, 29-Oct-2019.)
theorem mpomatmul {i j k m l: setvar} (ph: wff) (A2 B2 C: class i j k m l) (D: class k m l) (R: class) (c_x: class i j m) (c_xp U E: class i j k m l) (F: class k m l) (N: class) (V W: class i j k m l) (X Y: class i j):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_xp (cfv A2 cmulr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel N cfn) $ >
  $ wceq X (cmpo i j N N C) $ >
  $ wceq Y (cmpo i j N N E) $ >
  $ wi (w3a ph (wcel (cv i) N) (wcel (cv j) N)) (wcel C B2) $ >
  $ wi (w3a ph (wcel (cv i) N) (wcel (cv j) N)) (wcel E B2) $ >
  $ wi (wa ph (wa (wceq (cv k) (cv i)) (wceq (cv m) (cv j)))) (wceq D C) $ >
  $ wi (wa ph (wa (wceq (cv m) (cv i)) (wceq (cv l) (cv j)))) (wceq F E) $ >
  $ wi (w3a ph (wcel (cv k) N) (wcel (cv m) N)) (wcel D U) $ >
  $ wi (w3a ph (wcel (cv m) N) (wcel (cv l) N)) (wcel F W) $ >
  $ wi ph (wceq (co X Y c_xp) (cmpo k l N N (co R (cmpt m N (co D F c_x)) cgsu))) $;

--| Value of an identity matrix, see also the statement in [Lang] p. 504: "The unit element of the ring of n x n matrices is the matrix I_n ... whose components are equal to 0 except on the diagonal, in which case they are equal to 1.". (Contributed by Stefan O'Rear, 7-Sep-2015.)
theorem mat1 {i j: setvar} (A2 R c_1 N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wceq (cfv A2 cur) (cmpo i j N N (cif (wceq (cv i) (cv j)) c_1 c_0))) $;

--| Entries of an identity matrix, deduction form. (Contributed by Stefan O'Rear, 10-Jul-2018.)
theorem mat1ov (ph: wff) (A2 R U c_1 I J N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I N) $ >
  $ wi ph (wcel J N) $ >
  $ wceq U (cfv A2 cur) $ >
  $ wi ph (wceq (co I J U) (cif (wceq I J) c_1 c_0)) $;

--| The identity matrix is a matrix. (Contributed by AV, 15-Feb-2019.)
theorem mat1bas (A2 B2 R c_1 N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_1 (cfv (co N R cmat) cur) $ >
  $ wi (wa (wcel R crg) (wcel N cfn)) (wcel c_1 B2) $;

--| The identity matrix multiplied with a scalar. (Contributed by Stefan O'Rear, 16-Jul-2018.)
theorem matsc {i j: setvar} (A2 R c_x K L N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_x (cfv A2 cvsca) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel N cfn) (wcel R crg) (wcel L K)) (wceq (co L (cfv A2 cur) c_x) (cmpo i j N N (cif (wceq (cv i) (cv j)) L c_0))) $;

--| Distribution law for the function operation and the composition of functions. (Contributed by Stefan O'Rear, 17-Jul-2018.)
theorem ofco2 (R F G H: class):
  $ wi (wa (wa (wcel F cvv) (wcel G cvv)) (w3a (wfun H) (wcel (ccom F H) cvv) (wcel (ccom G H) cvv))) (wceq (ccom (co F G (cof R)) H) (co (ccom F H) (ccom G H) (cof R))) $;

--| The transposition of the value of a function operation for two functions is the value of the function operation for the two functions transposed. (Contributed by Stefan O'Rear, 17-Jul-2018.)
theorem oftpos (R F G V W: class):
  $ wi (wa (wcel F V) (wcel G W)) (wceq (ctpos (co F G (cof R))) (co (ctpos F) (ctpos G) (cof R))) $;

--| The transpose of a square matrix is a square matrix of the same size. (Contributed by SO, 9-Jul-2018.)
theorem mattposcl (A2 B2 R M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (wcel M B2) (wcel (ctpos M) B2) $;

--| The transpose of the transpose of a square matrix is the square matrix itself. (Contributed by SO, 17-Jul-2018.)
theorem mattpostpos (A2 B2 R M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (wcel M B2) (wceq (ctpos (ctpos M)) M) $;

--| The transposition of a matrix multiplied with a scalar equals the transposed matrix multiplied with the scalar, see also the statement in [Lang] p. 505. (Contributed by Stefan O'Rear, 17-Jul-2018.)
theorem mattposvs (A2 B2 R c_x K N X Y: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_x (cfv A2 cvsca) $ >
  $ wi (wa (wcel X K) (wcel Y B2)) (wceq (ctpos (co X Y c_x)) (co X (ctpos Y) c_x)) $;

--| The transposition of the identity matrix is the identity matrix. (Contributed by Stefan O'Rear, 17-Jul-2018.)
theorem mattpos1 (A2 R c_1 N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wceq (ctpos c_1) c_1) $;

--| The transposition of an I X J -matrix is a J X I -matrix, see also the statement in [Lang] p. 505. (Contributed by Stefan O'Rear, 9-Jul-2018.)
theorem tposmap (A2 B2 I J: class):
  $ wi (wcel A2 (co B2 (cxp I J) cmap)) (wcel (ctpos A2) (co B2 (cxp J I) cmap)) $;

--| Behavior of transposes in matrix products, see also the statement in [Lang] p. 505. (Contributed by Stefan O'Rear, 9-Jul-2018.)
theorem mamutpos (ph: wff) (B2 P R F G M N X Y: class):
  $ wceq F (co R (cotp M N P) cmmul) $ >
  $ wceq G (co R (cotp P N M) cmmul) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel P cfn) $ >
  $ wi ph (wcel X (co B2 (cxp M N) cmap)) $ >
  $ wi ph (wcel Y (co B2 (cxp N P) cmap)) $ >
  $ wi ph (wceq (ctpos (co X Y F)) (co (ctpos Y) (ctpos X) G)) $;

--| Multiplying two transposed matrices results in the transposition of the product of the two matrices. (Contributed by Stefan O'Rear, 17-Jul-2018.)
theorem mattposm (A2 B2 R c_x N X Y: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_x (cfv A2 cmulr) $ >
  $ wi (w3a (wcel R ccrg) (wcel X B2) (wcel Y B2)) (wceq (ctpos (co X Y c_x)) (co (ctpos Y) (ctpos X) c_x)) $;

--| Closure of a group sum over the diagonal coefficients of a square matrix over a commutative ring. (Contributed by AV, 29-Dec-2018.) (Proof shortened by AV, 23-Jul-2019.)
theorem matgsumcl {r: setvar} (A2: class r) (B2 R: class) (U: class r) (M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq U (cfv R cmgp) $ >
  $ wi (wa (wcel R ccrg) (wcel M B2)) (wcel (co U (cmpt r N (co (cv r) (cv r) M)) cgsu) (cfv R cbs)) $;

--| The identity summand in the Leibniz' formula of a determinant for a square matrix over a commutative ring. (Contributed by AV, 29-Dec-2018.)
theorem madetsumid {r: setvar} (A2: class r) (B2 P R: class) (S c_x U: class r) (M N: class) (Y: class r):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq U (cfv R cmgp) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel R ccrg) (wcel M B2) (wceq P (cres cid N))) (wceq (co (cfv P (ccom Y S)) (co U (cmpt r N (co (cfv (cv r) P) (cv r) M)) cgsu) c_x) (co U (cmpt r N (co (cv r) (cv r) M)) cgsu)) $;

--| Each entry of a matrix with an index as permutation of the other is an element of the underlying ring. (Contributed by AV, 1-Jan-2019.)
theorem matepmcl {n: setvar} (A2: class n) (B2 P Q R M: class) (N: class n):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wi (w3a (wcel R crg) (wcel Q P) (wcel M B2)) (wral n (wcel (co (cfv (cv n) Q) (cv n) M) (cfv R cbs)) N) $;

--| Each entry of a matrix with an index as permutation of the other is an element of the underlying ring. (Contributed by AV, 1-Jan-2019.)
theorem matepm2cl {n: setvar} (A2: class n) (B2 P Q R M: class) (N: class n):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wi (w3a (wcel R crg) (wcel Q P) (wcel M B2)) (wral n (wcel (co (cv n) (cfv (cv n) Q) M) (cfv R cbs)) N) $;

--| A summand of the determinant of a matrix belongs to the underlying ring. (Contributed by AV, 1-Jan-2019.)
theorem madetsmelbas {n: setvar} (A2: class n) (B2 P Q R: class) (S G: class n) (M N: class) (Y: class n):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wi (w3a (wcel R ccrg) (wcel M B2) (wcel Q P)) (wcel (co (cfv Q (ccom Y S)) (co G (cmpt n N (co (cfv (cv n) Q) (cv n) M)) cgsu) (cfv R cmulr)) (cfv R cbs)) $;

--| A summand of the determinant of a matrix belongs to the underlying ring. (Contributed by AV, 1-Jan-2019.)
theorem madetsmelbas2 {n: setvar} (A2: class n) (B2 P Q R: class) (S G: class n) (M N: class) (Y: class n):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wi (w3a (wcel R ccrg) (wcel M B2) (wcel Q P)) (wcel (co (cfv Q (ccom Y S)) (co G (cmpt n N (co (cv n) (cfv (cv n) Q) M)) cgsu) (cfv R cmulr)) (cfv R cbs)) $;

--| The empty set is the one and only matrix of dimension 0, called "the empty matrix". (Contributed by AV, 27-Feb-2019.)
theorem mat0dimbas0 (R V: class):
  $ wi (wcel R V) (wceq (cfv (co c0 R cmat) cbs) (csn c0)) $;

--| The zero of the algebra of matrices with dimension 0. (Contributed by AV, 6-Aug-2019.)
theorem mat0dim0 (A2 R: class):
  $ wceq A2 (co c0 R cmat) $ >
  $ wi (wcel R crg) (wceq (cfv A2 c0g) c0) $;

--| The identity of the algebra of matrices with dimension 0. (Contributed by AV, 6-Aug-2019.)
theorem mat0dimid (A2 R: class):
  $ wceq A2 (co c0 R cmat) $ >
  $ wi (wcel R crg) (wceq (cfv A2 cur) c0) $;

--| The scalar multiplication in the algebra of matrices with dimension 0. (Contributed by AV, 6-Aug-2019.)
theorem mat0dimscm (A2 R X: class):
  $ wceq A2 (co c0 R cmat) $ >
  $ wi (wa (wcel R crg) (wcel X (cfv R cbs))) (wceq (co X c0 (cfv A2 cvsca)) c0) $;

--| The algebra of matrices with dimension 0 (over an arbitrary ring!) is a commutative ring. (Contributed by AV, 10-Aug-2019.)
theorem mat0dimcrng (A2 R: class):
  $ wceq A2 (co c0 R cmat) $ >
  $ wi (wcel R crg) (wcel A2 ccrg) $;

--| A matrix with dimension 1 is an ordered pair with an ordered pair (of the one and only pair of indices) as first component. (Contributed by AV, 15-Aug-2019.)
theorem mat1dimelbas {r: setvar} (A2: class r) (B2 R E M: class) (O: class r) (V: class):
  $ wceq A2 (co (csn E) R cmat) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq O (cop E E) $ >
  $ wi (wa (wcel R crg) (wcel E V)) (wb (wcel M (cfv A2 cbs)) (wrex r (wceq M (csn (cop O (cv r)))) B2)) $;

--| A matrix with dimension 1 is an ordered pair with an ordered pair (of the one and only pair of indices) as first component. (Contributed by AV, 15-Aug-2019.)
theorem mat1dimbas (A2 B2 R E O V X: class):
  $ wceq A2 (co (csn E) R cmat) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq O (cop E E) $ >
  $ wi (w3a (wcel R crg) (wcel E V) (wcel X B2)) (wcel (csn (cop O X)) (cfv A2 cbs)) $;

--| The zero of the algebra of matrices with dimension 1. (Contributed by AV, 15-Aug-2019.)
theorem mat1dim0 (A2 B2 R E O V: class):
  $ wceq A2 (co (csn E) R cmat) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq O (cop E E) $ >
  $ wi (wa (wcel R crg) (wcel E V)) (wceq (cfv A2 c0g) (csn (cop O (cfv R c0g)))) $;

--| The identity of the algebra of matrices with dimension 1. (Contributed by AV, 15-Aug-2019.)
theorem mat1dimid (A2 B2 R E O V: class):
  $ wceq A2 (co (csn E) R cmat) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq O (cop E E) $ >
  $ wi (wa (wcel R crg) (wcel E V)) (wceq (cfv A2 cur) (csn (cop O (cfv R cur)))) $;

--| The scalar multiplication in the algebra of matrices with dimension 1. (Contributed by AV, 16-Aug-2019.)
theorem mat1dimscm (A2 B2 R E O V X Y: class):
  $ wceq A2 (co (csn E) R cmat) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq O (cop E E) $ >
  $ wi (wa (wa (wcel R crg) (wcel E V)) (wa (wcel X B2) (wcel Y B2))) (wceq (co X (csn (cop O Y)) (cfv A2 cvsca)) (csn (cop O (co X Y (cfv R cmulr))))) $;

--| The ring multiplication in the algebra of matrices with dimension 1. (Contributed by AV, 16-Aug-2019.) (Proof shortened by AV, 18-Apr-2021.)
theorem mat1dimmul (A2 B2 R E O V X Y: class):
  $ wceq A2 (co (csn E) R cmat) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq O (cop E E) $ >
  $ wi (wa (wa (wcel R crg) (wcel E V)) (wa (wcel X B2) (wcel Y B2))) (wceq (co (csn (cop O X)) (csn (cop O Y)) (cfv A2 cmulr)) (csn (cop O (co X Y (cfv R cmulr))))) $;

--| The algebra of matrices with dimension 1 over a commutative ring is a commutative ring. (Contributed by AV, 16-Aug-2019.)
theorem mat1dimcrng (A2 B2 R E O V: class):
  $ wceq A2 (co (csn E) R cmat) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq O (cop E E) $ >
  $ wi (wa (wcel R ccrg) (wcel E V)) (wcel A2 ccrg) $;

--| There is a 1-1 function from a ring onto the ring of matrices with dimension 1 over this ring. (Contributed by AV, 22-Dec-2019.)
theorem mat1f1o {x3: setvar} (A2 B2 R E F: class x3) (K O: class) (V: class x3):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co (csn E) R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq O (cop E E) $ >
  $ wceq F (cmpt x3 K (csn (cop O (cv x3)))) $ >
  $ wi (wa (wcel R crg) (wcel E V)) (wf1o K B2 F) $;

--| The value of the ring homomorphism ` F ` . (Contributed by AV, 22-Dec-2019.)
theorem mat1rhmval {x3: setvar} (A2 B2: class x3) (R E: class) (F: class x3) (K O V X: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co (csn E) R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq O (cop E E) $ >
  $ wceq F (cmpt x3 K (csn (cop O (cv x3)))) $ >
  $ wi (w3a (wcel R crg) (wcel E V) (wcel X K)) (wceq (cfv X F) (csn (cop O X))) $;

--| The value of the ring homomorphism ` F ` . (Contributed by AV, 22-Dec-2019.)
theorem mat1rhmelval {x3: setvar} (A2 B2: class x3) (R E: class) (F: class x3) (K O V X: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co (csn E) R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq O (cop E E) $ >
  $ wceq F (cmpt x3 K (csn (cop O (cv x3)))) $ >
  $ wi (w3a (wcel R crg) (wcel E V) (wcel X K)) (wceq (co E E (cfv X F)) X) $;

--| The value of the ring homomorphism ` F ` is a matrix with dimension 1. (Contributed by AV, 22-Dec-2019.)
theorem mat1rhmcl {x3: setvar} (A2 B2: class x3) (R E: class) (F: class x3) (K O V X: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co (csn E) R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq O (cop E E) $ >
  $ wceq F (cmpt x3 K (csn (cop O (cv x3)))) $ >
  $ wi (w3a (wcel R crg) (wcel E V) (wcel X K)) (wcel (cfv X F) B2) $;

--| There is a function from a ring to the ring of matrices with dimension 1 over this ring. (Contributed by AV, 22-Dec-2019.)
theorem mat1f {x3: setvar} (A2: class x3) (B2 R E: class) (F: class x3) (K O V: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co (csn E) R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq O (cop E E) $ >
  $ wceq F (cmpt x3 K (csn (cop O (cv x3)))) $ >
  $ wi (wa (wcel R crg) (wcel E V)) (wf K B2 F) $;

--| There is a group homomorphism from the additive group of a ring to the additive group of the ring of matrices with dimension 1 over this ring. (Contributed by AV, 22-Dec-2019.)
theorem mat1ghm {x3: setvar} (A2 B2 R E F K O V: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co (csn E) R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq O (cop E E) $ >
  $ wceq F (cmpt x3 K (csn (cop O (cv x3)))) $ >
  $ wi (wa (wcel R crg) (wcel E V)) (wcel F (co R A2 cghm)) $;

--| There is a monoid homomorphism from the multiplicative group of a ring to the multiplicative group of the ring of matrices with dimension 1 over this ring. (Contributed by AV, 22-Dec-2019.)
theorem mat1mhm {x3: setvar} (A2 B2 R E F K M N O V: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co (csn E) R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq O (cop E E) $ >
  $ wceq F (cmpt x3 K (csn (cop O (cv x3)))) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq N (cfv A2 cmgp) $ >
  $ wi (wa (wcel R crg) (wcel E V)) (wcel F (co M N cmhm)) $;

--| There is a ring homomorphism from a ring to the ring of matrices with dimension 1 over this ring. (Contributed by AV, 22-Dec-2019.)
theorem mat1rhm {x3: setvar} (A2 B2 R E F K O V: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co (csn E) R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq O (cop E E) $ >
  $ wceq F (cmpt x3 K (csn (cop O (cv x3)))) $ >
  $ wi (wa (wcel R crg) (wcel E V)) (wcel F (co R A2 crh)) $;

--| There is a ring isomorphism from a ring to the ring of matrices with dimension 1 over this ring. (Contributed by AV, 22-Dec-2019.)
theorem mat1rngiso {x3: setvar} (A2 B2 R E F K O V: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co (csn E) R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq O (cop E E) $ >
  $ wceq F (cmpt x3 K (csn (cop O (cv x3)))) $ >
  $ wi (wa (wcel R crg) (wcel E V)) (wcel F (co R A2 crs)) $;

--| A ring is isomorphic to the ring of matrices with dimension 1 over this ring. (Contributed by AV, 30-Dec-2019.)
theorem mat1ric (A2 R E V: class):
  $ wceq A2 (co (csn E) R cmat) $ >
  $ wi (wa (wcel R crg) (wcel E V)) (wbr R A2 cric) $;

--| Extend class notation for the algebra of diagonal matrices.
term cdmat: class;

--| Extend class notation for the algebra of scalar matrices.
term cscmat: class;

--| Define the set of n x n diagonal (square) matrices over a set (usually a ring) r, see definition in [Roman] p. 4 or Definition 3.12 in [Hefferon] p. 240. (Contributed by AV, 8-Dec-2019.)
axiom df_dmat {i j m n r: setvar}:
  $ wceq cdmat (cmpo n r cfn cvv (crab m (wral i (wral j (wi (wne (cv i) (cv j)) (wceq (co (cv i) (cv j) (cv m)) (cfv (cv r) c0g))) (cv n)) (cv n)) (cfv (co (cv n) (cv r) cmat) cbs))) $;

--| Define the algebra of n x n scalar matrices over a set (usually a ring) r, see definition in [Connell] p. 57: "A _scalar matrix_ is a diagonal matrix for which all the diagonal terms are equal, i.e., a matrix of the form cI_n". (Contributed by AV, 8-Dec-2019.)
axiom df_scmat {m n r a c: setvar}:
  $ wceq cscmat (cmpo n r cfn cvv (csb a (co (cv n) (cv r) cmat) (crab m (wrex c (wceq (cv m) (co (cv c) (cfv (cv a) cur) (cfv (cv a) cvsca))) (cfv (cv r) cbs)) (cfv (cv a) cbs)))) $;

--| The set of ` N ` x ` N ` diagonal matrices over (a ring) ` R ` . (Contributed by AV, 8-Dec-2019.)
theorem dmatval {i j m: setvar} (A2: class i j m) (B2: class i j) (D: class i j m) (R N: class) (V c_0: class i j m):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (co N R cdmat) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wceq D (crab m (wral i (wral j (wi (wne (cv i) (cv j)) (wceq (co (cv i) (cv j) (cv m)) c_0)) N) N) B2)) $;

--| A ` N ` x ` N ` diagonal matrix over (a ring) ` R ` . (Contributed by AV, 18-Dec-2019.)
theorem dmatel {i j: setvar} (A2 B2 D: class i j) (R M N: class) (V c_0: class i j):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (co N R cdmat) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wb (wcel M D) (wa (wcel M B2) (wral i (wral j (wi (wne (cv i) (cv j)) (wceq (co (cv i) (cv j) M) c_0)) N) N))) $;

--| An ` N ` x ` N ` diagonal matrix over (the ring) ` R ` is an ` N ` x ` N ` matrix over (the ring) ` R ` . (Contributed by AV, 18-Dec-2019.)
theorem dmatmat (A2 B2 D R M N V c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (co N R cdmat) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wi (wcel M D) (wcel M B2)) $;

--| The identity matrix is a diagonal matrix. (Contributed by AV, 19-Aug-2019.) (Revised by AV, 18-Dec-2019.)
theorem dmatid (A2 B2 D R N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (co N R cdmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel (cfv A2 cur) D) $;

--| An extradiagonal entry of a diagonal matrix is equal to zero. (Contributed by AV, 19-Aug-2019.) (Revised by AV, 18-Dec-2019.)
theorem dmatelnd (A2 B2 D R I J N X c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (co N R cdmat) $ >
  $ wi (wa (w3a (wcel N cfn) (wcel R crg) (wcel X D)) (w3a (wcel I N) (wcel J N) (wne I J))) (wceq (co I J X) c_0) $;

--| The product of two diagonal matrices. (Contributed by AV, 19-Aug-2019.) (Revised by AV, 18-Dec-2019.)
theorem dmatmul {x3 y1: setvar} (A2 B2: class x3 y1) (D R N X Y: class) (c_0: class x3 y1):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (co N R cdmat) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R crg)) (wa (wcel X D) (wcel Y D))) (wceq (co X Y (cfv A2 cmulr)) (cmpo x3 y1 N N (cif (wceq (cv x3) (cv y1)) (co (co (cv x3) (cv y1) X) (co (cv x3) (cv y1) Y) (cfv R cmulr)) c_0))) $;

--| The difference of two diagonal matrices is a diagonal matrix. (Contributed by AV, 19-Aug-2019.) (Revised by AV, 18-Dec-2019.)
theorem dmatsubcl (A2 B2 D R N X Y c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (co N R cdmat) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R crg)) (wa (wcel X D) (wcel Y D))) (wcel (co X Y (cfv A2 csg)) D) $;

--| The set of diagonal matrices is a subgroup of the matrix group/algebra. (Contributed by AV, 19-Aug-2019.) (Revised by AV, 18-Dec-2019.)
theorem dmatsgrp (A2 B2 D R N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (co N R cdmat) $ >
  $ wi (wa (wcel R crg) (wcel N cfn)) (wcel D (cfv A2 csubg)) $;

--| The product of two diagonal matrices is a diagonal matrix. (Contributed by AV, 20-Aug-2019.) (Revised by AV, 18-Dec-2019.)
theorem dmatmulcl (A2 B2 D R N X Y c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (co N R cdmat) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R crg)) (wa (wcel X D) (wcel Y D))) (wcel (co X Y (cfv A2 cmulr)) D) $;

--| The set of diagonal matrices is a subring of the matrix ring/algebra. (Contributed by AV, 20-Aug-2019.) (Revised by AV, 18-Dec-2019.)
theorem dmatsrng (A2 B2 D R N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (co N R cdmat) $ >
  $ wi (wa (wcel R crg) (wcel N cfn)) (wcel D (cfv A2 csubrg)) $;

--| The subring of diagonal matrices (over a commutative ring) is a commutative ring . (Contributed by AV, 20-Aug-2019.) (Revised by AV, 18-Dec-2019.)
theorem dmatcrng (A2 B2 C D R N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (co N R cdmat) $ >
  $ wceq C (co A2 D cress) $ >
  $ wi (wa (wcel R ccrg) (wcel N cfn)) (wcel C ccrg) $;

--| The multiplication of a diagonal matrix with a scalar is a diagonal matrix. (Contributed by AV, 19-Dec-2019.)
theorem dmatscmcl (A2 B2 C D R c_as K M N: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_as (cfv A2 cvsca) $ >
  $ wceq D (co N R cdmat) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R crg)) (wa (wcel C K) (wcel M D))) (wcel (co C M c_as) D) $;

--| The set of ` N ` x ` N ` scalar matrices over (a ring) ` R ` . (Contributed by AV, 18-Dec-2019.)
theorem scmatval {m c: setvar} (A2: class m c) (B2: class c) (R: class) (S c_x c_1: class m c) (K: class m) (N: class) (V: class m c):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_x (cfv A2 cvsca) $ >
  $ wceq S (co N R cscmat) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wceq S (crab m (wrex c (wceq (cv m) (co (cv c) c_1 c_x)) K) B2)) $;

--| An ` N ` x ` N ` scalar matrix over (a ring) ` R ` . (Contributed by AV, 18-Dec-2019.)
theorem scmatel {c: setvar} (A2 B2: class c) (R: class) (S c_x c_1: class c) (K M N: class) (V: class c):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_x (cfv A2 cvsca) $ >
  $ wceq S (co N R cscmat) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wb (wcel M S) (wa (wcel M B2) (wrex c (wceq M (co (cv c) c_1 c_x)) K))) $;

--| A scalar matrix can be expressed as a multiplication of a scalar with the identity matrix. (Contributed by AV, 30-Oct-2019.) (Revised by AV, 18-Dec-2019.)
theorem scmatscmid {c: setvar} (A2 B2: class c) (R: class) (S c_x c_1: class c) (K M N: class) (V: class c):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_x (cfv A2 cvsca) $ >
  $ wceq S (co N R cscmat) $ >
  $ wi (w3a (wcel N cfn) (wcel R V) (wcel M S)) (wrex c (wceq M (co (cv c) c_1 c_x)) K) $;

--| An entry of a scalar matrix expressed as a multiplication of a scalar with the identity matrix. (Contributed by AV, 30-Oct-2019.)
theorem scmatscmide (A2 B2 C R c_1 I c_as J N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_as (cfv A2 cvsca) $ >
  $ wi (wa (w3a (wcel N cfn) (wcel R crg) (wcel C B2)) (wa (wcel I N) (wcel J N))) (wceq (co I J (co C c_1 c_as)) (cif (wceq I J) C c_0)) $;

--| Distributive law for scalar and ring multiplication for scalar matrices expressed as multiplications of a scalar with the identity matrix. (Contributed by AV, 19-Dec-2019.)
theorem scmatscmiddistr (A2 B2 R S T c_x c_xp c_1 c_as N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_as (cfv A2 cvsca) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_xp (cfv A2 cmulr) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R crg)) (wa (wcel S B2) (wcel T B2))) (wceq (co (co S c_1 c_as) (co T c_1 c_as) c_xp) (co (co S T c_x) c_1 c_as)) $;

--| An ` N ` x ` N ` scalar matrix over (the ring) ` R ` is an ` N ` x ` N ` matrix over (the ring) ` R ` . (Contributed by AV, 18-Dec-2019.)
theorem scmatmat (A2 B2 R S M N V: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq S (co N R cscmat) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wi (wcel M S) (wcel M B2)) $;

--| An entry of an ` N ` x ` N ` scalar matrix over the ring ` R ` . (Contributed by AV, 18-Dec-2019.)
theorem scmate {c: setvar} (A2 B2: class c) (R S I J K M N: class) (c_0: class c):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq S (co N R cscmat) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (w3a (wcel N cfn) (wcel R crg) (wcel M S)) (wa (wcel I N) (wcel J N))) (wrex c (wceq (co I J M) (cif (wceq I J) (cv c) c_0)) K) $;

--| The set of an ` N ` x ` N ` scalar matrices over the ring ` R ` expressed as a subset of ` N ` x ` N ` matrices over the ring ` R ` with certain properties for their entries. (Contributed by AV, 31-Oct-2019.) (Revised by AV, 19-Dec-2019.)
theorem scmatmats {i j m c: setvar} (A2: class m c) (B2 R: class) (S: class i j m) (K: class m) (N: class) (c_0: class i j m c):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq S (co N R cscmat) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wceq S (crab m (wrex c (wral i (wral j (wceq (co (cv i) (cv j) (cv m)) (cif (wceq (cv i) (cv j)) (cv c) c_0)) N) N) K) B2)) $;

--| Alternate proof of ~ scmate : An entry of an ` N ` x ` N ` scalar matrix over the ring ` R ` . This prove makes use of ~ scmatmats but is longer and requires more distinct variables. (Contributed by AV, 19-Dec-2019.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem scmateALT {c: setvar} (A2: class c) (B2 R S I J K M N: class) (c_0: class c):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq S (co N R cscmat) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (w3a (wcel N cfn) (wcel R crg) (wcel M S)) (wa (wcel I N) (wcel J N))) (wrex c (wceq (co I J M) (cif (wceq I J) (cv c) c_0)) K) $;

--| The multiplication of a matrix with a scalar matrix corresponds to a scalar multiplication. (Contributed by AV, 28-Dec-2019.)
theorem scmatscm {m c: setvar} (A2: class c) (B2: class m c) (C R S: class) (c_xp: class m c) (c_as: class c) (K N: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_as (cfv A2 cvsca) $ >
  $ wceq c_xp (cfv A2 cmulr) $ >
  $ wceq S (co N R cscmat) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R crg)) (wcel C S)) (wrex c (wral m (wceq (co C (cv m) c_xp) (co (cv c) (cv m) c_as)) B2) K) $;

--| The identity matrix is a scalar matrix. (Contributed by AV, 20-Aug-2019.) (Revised by AV, 18-Dec-2019.)
theorem scmatid (A2 B2 R S E N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq E (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq S (co N R cscmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel (cfv A2 cur) S) $;

--| A scalar matrix is a diagonal matrix. (Contributed by AV, 20-Aug-2019.) (Revised by AV, 19-Dec-2019.)
theorem scmatdmat (A2 B2 D R S E M N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq E (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq S (co N R cscmat) $ >
  $ wceq D (co N R cdmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wi (wcel M S) (wcel M D)) $;

--| The sum of two scalar matrices is a scalar matrix. (Contributed by AV, 25-Dec-2019.)
theorem scmataddcl (A2 B2 R S E N X Y c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq E (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq S (co N R cscmat) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R crg)) (wa (wcel X S) (wcel Y S))) (wcel (co X Y (cfv A2 cplusg)) S) $;

--| The difference of two scalar matrices is a scalar matrix. (Contributed by AV, 20-Aug-2019.) (Revised by AV, 19-Dec-2019.)
theorem scmatsubcl (A2 B2 R S E N X Y c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq E (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq S (co N R cscmat) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R crg)) (wa (wcel X S) (wcel Y S))) (wcel (co X Y (cfv A2 csg)) S) $;

--| The product of two scalar matrices is a scalar matrix. (Contributed by AV, 21-Aug-2019.) (Revised by AV, 19-Dec-2019.)
theorem scmatmulcl (A2 B2 R S E N X Y c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq E (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq S (co N R cscmat) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R crg)) (wa (wcel X S) (wcel Y S))) (wcel (co X Y (cfv A2 cmulr)) S) $;

--| The set of scalar matrices is a subgroup of the matrix group/algebra. (Contributed by AV, 20-Aug-2019.) (Revised by AV, 19-Dec-2019.)
theorem scmatsgrp (A2 B2 R S E N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq E (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq S (co N R cscmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel S (cfv A2 csubg)) $;

--| The set of scalar matrices is a subring of the matrix ring/algebra. (Contributed by AV, 21-Aug-2019.) (Revised by AV, 19-Dec-2019.)
theorem scmatsrng (A2 B2 R S E N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq E (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq S (co N R cscmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel S (cfv A2 csubrg)) $;

--| The subring of scalar matrices (over a commutative ring) is a commutative ring. (Contributed by AV, 21-Aug-2019.)
theorem scmatcrng (A2 B2 C R S E N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq E (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq S (co N R cscmat) $ >
  $ wceq C (co A2 S cress) $ >
  $ wi (wa (wcel N cfn) (wcel R ccrg)) (wcel C ccrg) $;

--| The set of scalar matrices is a subgroup of the group/ring of diagonal matrices. (Contributed by AV, 21-Aug-2019.)
theorem scmatsgrp1 (A2 B2 C D R S E N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq E (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq S (co N R cscmat) $ >
  $ wceq D (co N R cdmat) $ >
  $ wceq C (co A2 D cress) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel S (cfv C csubg)) $;

--| The set of scalar matrices is a subring of the ring of diagonal matrices. (Contributed by AV, 21-Aug-2019.)
theorem scmatsrng1 (A2 B2 C D R S E N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq E (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq S (co N R cscmat) $ >
  $ wceq D (co N R cdmat) $ >
  $ wceq C (co A2 D cress) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel S (cfv C csubrg)) $;

--| Closure of the scalar multiplication in the ring of scalar matrices. ( ~ matvscl analog.) (Contributed by AV, 24-Dec-2019.)
theorem smatvscl (A2 C R S c_as K N X: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq S (co N R cscmat) $ >
  $ wceq c_as (cfv A2 cvsca) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R crg)) (wa (wcel C K) (wcel X S))) (wcel (co C X c_as) S) $;

--| The set of scalar matrices is a linear subspace of the matrix algebra. (Contributed by AV, 25-Dec-2019.)
theorem scmatlss (A2 R S N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq S (co N R cscmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel S (cfv A2 clss)) $;

--| The set of scalar matrices is the base set of the ring of corresponding scalar matrices. (Contributed by AV, 26-Dec-2019.)
theorem scmatstrbas (A2 C R S N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq C (co N R cscmat) $ >
  $ wceq S (co A2 C cress) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wceq (cfv S cbs) C) $;

--| The value of the ring homomorphism ` F ` . (Contributed by AV, 22-Dec-2019.)
theorem scmatrhmval {x3: setvar} (A2: class x3) (R c_1: class) (F: class x3) (c_as K: class) (N: class x3) (V X: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_as (cfv A2 cvsca) $ >
  $ wceq F (cmpt x3 K (co (cv x3) c_1 c_as)) $ >
  $ wi (wa (wcel R V) (wcel X K)) (wceq (cfv X F) (co X c_1 c_as)) $;

--| The value of the ring homomorphism ` F ` is a scalar matrix. (Contributed by AV, 22-Dec-2019.)
theorem scmatrhmcl {x3: setvar} (A2 C: class x3) (R c_1: class) (F: class x3) (c_as K: class) (N: class x3) (X: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_as (cfv A2 cvsca) $ >
  $ wceq F (cmpt x3 K (co (cv x3) c_1 c_as)) $ >
  $ wceq C (co N R cscmat) $ >
  $ wi (w3a (wcel N cfn) (wcel R crg) (wcel X K)) (wcel (cfv X F) C) $;

--| There is a function from a ring to any ring of scalar matrices over this ring. (Contributed by AV, 25-Dec-2019.)
theorem scmatf {x3: setvar} (A2: class x3) (C R c_1: class) (F: class x3) (c_as K N: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_as (cfv A2 cvsca) $ >
  $ wceq F (cmpt x3 K (co (cv x3) c_1 c_as)) $ >
  $ wceq C (co N R cscmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wf K C F) $;

--| There is a function from a ring onto any ring of scalar matrices over this ring. (Contributed by AV, 26-Dec-2019.)
theorem scmatfo {x3: setvar} (A2: class x3) (C R c_1: class) (F: class x3) (c_as K N: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_as (cfv A2 cvsca) $ >
  $ wceq F (cmpt x3 K (co (cv x3) c_1 c_as)) $ >
  $ wceq C (co N R cscmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wfo K C F) $;

--| There is a 1-1 function from a ring to any ring of scalar matrices with positive dimension over this ring. (Contributed by AV, 25-Dec-2019.)
theorem scmatf1 {x3: setvar} (A2: class x3) (C R c_1: class) (F: class x3) (c_as K N: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_as (cfv A2 cvsca) $ >
  $ wceq F (cmpt x3 K (co (cv x3) c_1 c_as)) $ >
  $ wceq C (co N R cscmat) $ >
  $ wi (w3a (wcel N cfn) (wne N c0) (wcel R crg)) (wf1 K C F) $;

--| There is a bijection between a ring and any ring of scalar matrices with positive dimension over this ring. (Contributed by AV, 26-Dec-2019.)
theorem scmatf1o {x3: setvar} (A2: class x3) (C R c_1: class) (F: class x3) (c_as K N: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_as (cfv A2 cvsca) $ >
  $ wceq F (cmpt x3 K (co (cv x3) c_1 c_as)) $ >
  $ wceq C (co N R cscmat) $ >
  $ wi (w3a (wcel N cfn) (wne N c0) (wcel R crg)) (wf1o K C F) $;

--| There is a group homomorphism from the additive group of a ring to the additive group of the ring of scalar matrices over this ring. (Contributed by AV, 22-Dec-2019.)
theorem scmatghm {x3: setvar} (A2: class x3) (C R: class) (S: class x3) (c_1: class) (F: class x3) (c_as K N: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_as (cfv A2 cvsca) $ >
  $ wceq F (cmpt x3 K (co (cv x3) c_1 c_as)) $ >
  $ wceq C (co N R cscmat) $ >
  $ wceq S (co A2 C cress) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel F (co R S cghm)) $;

--| There is a monoid homomorphism from the multiplicative group of a ring to the multiplicative group of the ring of scalar matrices over this ring. (Contributed by AV, 29-Dec-2019.)
theorem scmatmhm {x3: setvar} (A2: class x3) (C R: class) (S T: class x3) (c_1: class) (F: class x3) (c_as K: class) (M: class x3) (N: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_as (cfv A2 cvsca) $ >
  $ wceq F (cmpt x3 K (co (cv x3) c_1 c_as)) $ >
  $ wceq C (co N R cscmat) $ >
  $ wceq S (co A2 C cress) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq T (cfv S cmgp) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel F (co M T cmhm)) $;

--| There is a ring homomorphism from a ring to the ring of scalar matrices over this ring. (Contributed by AV, 29-Dec-2019.)
theorem scmatrhm {x3: setvar} (A2: class x3) (C R: class) (S: class x3) (c_1: class) (F: class x3) (c_as K N: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_as (cfv A2 cvsca) $ >
  $ wceq F (cmpt x3 K (co (cv x3) c_1 c_as)) $ >
  $ wceq C (co N R cscmat) $ >
  $ wceq S (co A2 C cress) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel F (co R S crh)) $;

--| There is a ring isomorphism from a ring to the ring of scalar matrices over this ring with positive dimension. (Contributed by AV, 29-Dec-2019.)
theorem scmatrngiso {x3: setvar} (A2: class x3) (C R: class) (S: class x3) (c_1: class) (F: class x3) (c_as K N: class):
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_as (cfv A2 cvsca) $ >
  $ wceq F (cmpt x3 K (co (cv x3) c_1 c_as)) $ >
  $ wceq C (co N R cscmat) $ >
  $ wceq S (co A2 C cress) $ >
  $ wi (w3a (wcel N cfn) (wne N c0) (wcel R crg)) (wcel F (co R S crs)) $;

--| A ring is isomorphic to every ring of scalar matrices over this ring with positive dimension. (Contributed by AV, 29-Dec-2019.)
theorem scmatric (A2 C R S N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq C (co N R cscmat) $ >
  $ wceq S (co A2 C cress) $ >
  $ wi (w3a (wcel N cfn) (wne N c0) (wcel R crg)) (wbr R S cric) $;

--| The empty matrix over a ring is a scalar matrix (and therefore, by ~ scmatdmat , also a diagonal matrix). (Contributed by AV, 21-Dec-2019.)
theorem mat0scmat (R: class):
  $ wi (wcel R crg) (wcel c0 (co c0 R cscmat)) $;

--| A 1-dimensional matrix over a ring is always a scalar matrix (and therefore, by ~ scmatdmat , also a diagonal matrix). (Contributed by AV, 21-Dec-2019.)
theorem mat1scmat (A2 B2 R M N V: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (w3a (wcel N V) (wceq (cfv N chash) c1) (wcel R crg)) (wi (wcel M B2) (wcel M (co N R cscmat))) $;

--| Syntax for the operator for the multiplication of a vector with a matrix.
term cmvmul: class;

--| The operator which multiplies an M x N -matrix with an N-dimensional vector. (Contributed by AV, 23-Feb-2019.)
axiom df_mvmul {x3 y1 i j m n o r: setvar}:
  $ wceq cmvmul (cmpo r o cvv cvv (csb m (cfv (cv o) c1st) (csb n (cfv (cv o) c2nd) (cmpo x3 y1 (co (cfv (cv r) cbs) (cxp (cv m) (cv n)) cmap) (co (cfv (cv r) cbs) (cv n) cmap) (cmpt i (cv m) (co (cv r) (cmpt j (cv n) (co (co (cv i) (cv j) (cv x3)) (cfv (cv j) (cv y1)) (cfv (cv r) cmulr))) cgsu)))))) $;

--| Functional value of the matrix vector multiplication operator. (Contributed by AV, 23-Feb-2019.)
theorem mvmulfval {x3 y1 i j: setvar} (ph: wff) (B2: class i j) (R: class) (c_x: class j) (c_xp: class x3 y1 i j) (M N: class) (V: class x3 y1 i j):
  $ wceq c_xp (co R (cop M N) cmvmul) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wceq c_xp (cmpo x3 y1 (co B2 (cxp M N) cmap) (co B2 N cmap) (cmpt i M (co R (cmpt j N (co (co (cv i) (cv j) (cv x3)) (cfv (cv j) (cv y1)) c_x)) cgsu)))) $;

--| Multiplication of a vector with a matrix. (Contributed by AV, 23-Feb-2019.)
theorem mvmulval {i j: setvar} (ph: wff) (B2: class i j) (R: class) (c_x: class j) (c_xp: class i j) (M N: class) (V: class i j) (X Y: class):
  $ wceq c_xp (co R (cop M N) cmvmul) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel X (co B2 (cxp M N) cmap)) $ >
  $ wi ph (wcel Y (co B2 N cmap)) $ >
  $ wi ph (wceq (co X Y c_xp) (cmpt i M (co R (cmpt j N (co (co (cv i) (cv j) X) (cfv (cv j) Y) c_x)) cgsu))) $;

--| A cell/element in the vector resulting from a multiplication of a vector with a matrix. (Contributed by AV, 23-Feb-2019.)
theorem mvmulfv {j: setvar} (ph: wff) (B2: class j) (R: class) (c_x c_xp: class j) (I M N: class) (V: class j) (X Y: class):
  $ wceq c_xp (co R (cop M N) cmvmul) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel X (co B2 (cxp M N) cmap)) $ >
  $ wi ph (wcel Y (co B2 N cmap)) $ >
  $ wi ph (wcel I M) $ >
  $ wi ph (wceq (cfv I (co X Y c_xp)) (co R (cmpt j N (co (co I (cv j) X) (cfv (cv j) Y) c_x)) cgsu)) $;

--| Multiplication of a vector with a square matrix. (Contributed by AV, 23-Feb-2019.)
theorem mavmulval {i j: setvar} (ph: wff) (A2 B2: class i j) (R: class) (c_x: class j) (c_xp: class i j) (N: class) (V: class i j) (X Y: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_xp (co R (cop N N) cmvmul) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel X (cfv A2 cbs)) $ >
  $ wi ph (wcel Y (co B2 N cmap)) $ >
  $ wi ph (wceq (co X Y c_xp) (cmpt i N (co R (cmpt j N (co (co (cv i) (cv j) X) (cfv (cv j) Y) c_x)) cgsu))) $;

--| A cell/element in the vector resulting from a multiplication of a vector with a square matrix. (Contributed by AV, 6-Dec-2018.) (Revised by AV, 18-Feb-2019.) (Revised by AV, 23-Feb-2019.)
theorem mavmulfv {j: setvar} (ph: wff) (A2 B2: class j) (R: class) (c_x c_xp: class j) (I N: class) (V: class j) (X Y: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_xp (co R (cop N N) cmvmul) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel X (cfv A2 cbs)) $ >
  $ wi ph (wcel Y (co B2 N cmap)) $ >
  $ wi ph (wcel I N) $ >
  $ wi ph (wceq (cfv I (co X Y c_xp)) (co R (cmpt j N (co (co I (cv j) X) (cfv (cv j) Y) c_x)) cgsu)) $;

--| Multiplication of an NxN matrix with an N-dimensional vector results in an N-dimensional vector. (Contributed by AV, 6-Dec-2018.) (Revised by AV, 23-Feb-2019.) (Proof shortened by AV, 23-Jul-2019.)
theorem mavmulcl (ph: wff) (A2 B2 R c_x c_xp N X Y: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_xp (co R (cop N N) cmvmul) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel X (cfv A2 cbs)) $ >
  $ wi ph (wcel Y (co B2 N cmap)) $ >
  $ wi ph (wcel (co X Y c_xp) (co B2 N cmap)) $;

--| Multiplication of the identity NxN matrix with an N-dimensional vector results in the vector itself. (Contributed by AV, 9-Feb-2019.) (Revised by AV, 23-Feb-2019.)
theorem _1mavmul (ph: wff) (A2 B2 R c_x N Y: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (co R (cop N N) cmvmul) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel Y (co B2 N cmap)) $ >
  $ wi ph (wceq (co (cfv A2 cur) Y c_x) Y) $;

--| Associativity of the multiplication of two NxN matrices with an N-dimensional vector. (Contributed by AV, 9-Feb-2019.) (Revised by AV, 25-Feb-2019.) (Proof shortened by AV, 22-Jul-2019.)
theorem mavmulass (ph: wff) (A2 B2 R c_x c_xp N X Y Z: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (co R (cop N N) cmvmul) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel Y (co B2 N cmap)) $ >
  $ wceq c_xp (co R (cotp N N N) cmmul) $ >
  $ wi ph (wcel X (cfv A2 cbs)) $ >
  $ wi ph (wcel Z (cfv A2 cbs)) $ >
  $ wi ph (wceq (co (co X Z c_xp) Y c_x) (co X (co Z Y c_x) c_x)) $;

--| The domain of the matrix vector multiplication function. (Contributed by AV, 27-Feb-2019.)
theorem mavmuldm (B2 C D R c_x M N V: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (co B2 (cxp M N) cmap) $ >
  $ wceq D (co B2 N cmap) $ >
  $ wceq c_x (co R (cop M N) cmvmul) $ >
  $ wi (w3a (wcel R V) (wcel M cfn) (wcel N cfn)) (wceq (cdm c_x) (cxp C D)) $;

--| Every solution of the equation ` A * X = Y ` for a matrix ` A ` and a vector ` B ` is a vector. (Contributed by AV, 27-Feb-2019.)
theorem mavmulsolcl (A2 B2 C D R c_x E M N V X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (co B2 (cxp M N) cmap) $ >
  $ wceq D (co B2 N cmap) $ >
  $ wceq c_x (co R (cop M N) cmvmul) $ >
  $ wceq E (co B2 M cmap) $ >
  $ wi (wa (w3a (wcel M cfn) (wcel N cfn) (wne M c0)) (wa (wcel R V) (wcel Y E))) (wi (wceq (co A2 X c_x) Y) (wcel X D)) $;

--| Multiplication of a 0-dimensional matrix with a 0-dimensional vector. (Contributed by AV, 28-Feb-2019.)
theorem mavmul0 (R c_x N V: class):
  $ wceq c_x (co R (cop N N) cmvmul) $ >
  $ wi (wa (wceq N c0) (wcel R V)) (wceq (co c0 c0 c_x) c0) $;

--| The result of the 0-dimensional multiplication of a matrix with a vector is always the empty set. (Contributed by AV, 1-Mar-2019.)
theorem mavmul0g (R c_x N V X Y: class):
  $ wceq c_x (co R (cop N N) cmvmul) $ >
  $ wi (wa (wceq N c0) (wcel R V)) (wceq (co X Y c_x) c0) $;

--| The multiplication of an MxN matrix with an N-dimensional vector corresponds to the matrix multiplication of an MxN matrix with an Nx1 matrix. (Contributed by AV, 14-Mar-2019.)
theorem mvmumamul1 {i j: setvar} (ph: wff) (A2 B2 R c_x c_xp M: class i j) (N Y Z: class):
  $ wceq c_xp (co R (cotp M N (csn c0)) cmmul) $ >
  $ wceq c_x (co R (cop M N) cmvmul) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel M cfn) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel A2 (co B2 (cxp M N) cmap)) $ >
  $ wi ph (wcel Y (co B2 N cmap)) $ >
  $ wi ph (wcel Z (co B2 (cxp N (csn c0)) cmap)) $ >
  $ wi ph (wi (wral j (wceq (cfv (cv j) Y) (co (cv j) c0 Z)) N) (wral i (wceq (cfv (cv i) (co A2 Y c_x)) (co (cv i) c0 (co A2 Z c_xp))) M)) $;

--| The multiplication of an NxN matrix with an N-dimensional vector corresponds to the matrix multiplication of an NxN matrix with an Nx1 matrix. (Contributed by AV, 14-Mar-2019.)
theorem mavmumamul1 {i j: setvar} (ph: wff) (A2 B2 R c_x c_xp: class i j) (N: class) (X: class i j) (Y Z: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_xp (co R (cotp N N (csn c0)) cmmul) $ >
  $ wceq c_x (co R (cop N N) cmvmul) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel X (cfv A2 cbs)) $ >
  $ wi ph (wcel Y (co B2 N cmap)) $ >
  $ wi ph (wcel Z (co B2 (cxp N (csn c0)) cmap)) $ >
  $ wi ph (wi (wral j (wceq (cfv (cv j) Y) (co (cv j) c0 Z)) N) (wral i (wceq (cfv (cv i) (co X Y c_x)) (co (cv i) c0 (co X Z c_xp))) N)) $;

--| Syntax for the row replacing function for a square matrix.
term cmarrep: class;

--| Syntax for the function replacing a column of a matrix by a vector.
term cmatrepV: class;

--| Define the matrices whose k-th row is replaced by 0's and an arbitrary element of the underlying ring at the l-th column. (Contributed by AV, 12-Feb-2019.)
axiom df_marrep {i j k m n s1 r l: setvar}:
  $ wceq cmarrep (cmpo n r cvv cvv (cmpo m s1 (cfv (co (cv n) (cv r) cmat) cbs) (cfv (cv r) cbs) (cmpo k l (cv n) (cv n) (cmpo i j (cv n) (cv n) (cif (wceq (cv i) (cv k)) (cif (wceq (cv j) (cv l)) (cv s1) (cfv (cv r) c0g)) (co (cv i) (cv j) (cv m))))))) $;

--| Function replacing a column of a matrix by a vector. (Contributed by AV, 9-Feb-2019.) (Revised by AV, 26-Feb-2019.)
axiom df_marepv {v i j k m n r: setvar}:
  $ wceq cmatrepV (cmpo n r cvv cvv (cmpo m v (cfv (co (cv n) (cv r) cmat) cbs) (co (cfv (cv r) cbs) (cv n) cmap) (cmpt k (cv n) (cmpo i j (cv n) (cv n) (cif (wceq (cv j) (cv k)) (cfv (cv i) (cv v)) (co (cv i) (cv j) (cv m))))))) $;

--| First substitution for the definition of the matrix row replacement function. (Contributed by AV, 12-Feb-2019.) (Proof shortened by AV, 2-Mar-2024.)
theorem marrepfval {i j k m s1 l: setvar} (A2: class i j k m s1 l) (B2: class i j k l) (Q: class i j k m s1 l) (R N: class) (c_0: class i j k m s1 l):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq Q (co N R cmarrep) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq Q (cmpo m s1 B2 (cfv R cbs) (cmpo k l N N (cmpo i j N N (cif (wceq (cv i) (cv k)) (cif (wceq (cv j) (cv l)) (cv s1) c_0) (co (cv i) (cv j) (cv m)))))) $;

--| Second substitution for the definition of the matrix row replacement function. (Contributed by AV, 12-Feb-2019.)
theorem marrepval0 {i j k l: setvar} (A2 B2 Q: class i j k l) (R S M N: class) (c_0: class i j k l):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq Q (co N R cmarrep) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel M B2) (wcel S (cfv R cbs))) (wceq (co M S Q) (cmpo k l N N (cmpo i j N N (cif (wceq (cv i) (cv k)) (cif (wceq (cv j) (cv l)) S c_0) (co (cv i) (cv j) M))))) $;

--| Third substitution for the definition of the matrix row replacement function. (Contributed by AV, 12-Feb-2019.)
theorem marrepval {i j: setvar} (A2 B2 Q: class i j) (R S K L M N: class) (c_0: class i j):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq Q (co N R cmarrep) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wa (wcel M B2) (wcel S (cfv R cbs))) (wa (wcel K N) (wcel L N))) (wceq (co K L (co M S Q)) (cmpo i j N N (cif (wceq (cv i) K) (cif (wceq (cv j) L) S c_0) (co (cv i) (cv j) M)))) $;

--| An entry of a matrix with a replaced row. (Contributed by AV, 12-Feb-2019.)
theorem marrepeval (A2 B2 Q R S I J K L M N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq Q (co N R cmarrep) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wa (wcel M B2) (wcel S (cfv R cbs))) (wa (wcel K N) (wcel L N)) (wa (wcel I N) (wcel J N))) (wceq (co I J (co K L (co M S Q))) (cif (wceq I K) (cif (wceq J L) S c_0) (co I J M))) $;

--| Closure of the row replacement function for square matrices. (Contributed by AV, 13-Feb-2019.)
theorem marrepcl (A2 B2 R S K L M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (wa (w3a (wcel R crg) (wcel M B2) (wcel S (cfv R cbs))) (wa (wcel K N) (wcel L N))) (wcel (co K L (co M S (co N R cmarrep))) B2) $;

--| First substitution for the definition of the function replacing a column of a matrix by a vector. (Contributed by AV, 14-Feb-2019.) (Revised by AV, 26-Feb-2019.) (Proof shortened by AV, 2-Mar-2024.)
theorem marepvfval {v i j k m: setvar} (A2: class v i j k m) (B2: class i j k) (Q: class v i j k m) (R N: class) (V: class i j k):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq Q (co N R cmatrepV) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq Q (cmpo m v B2 V (cmpt k N (cmpo i j N N (cif (wceq (cv j) (cv k)) (cfv (cv i) (cv v)) (co (cv i) (cv j) (cv m)))))) $;

--| Second substitution for the definition of the function replacing a column of a matrix by a vector. (Contributed by AV, 14-Feb-2019.) (Revised by AV, 26-Feb-2019.)
theorem marepvval0 {i j k: setvar} (A2 B2: class i j k) (C: class) (Q: class i j k) (R M N: class) (V: class i j k):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq Q (co N R cmatrepV) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wi (wa (wcel M B2) (wcel C V)) (wceq (co M C Q) (cmpt k N (cmpo i j N N (cif (wceq (cv j) (cv k)) (cfv (cv i) C) (co (cv i) (cv j) M))))) $;

--| Third substitution for the definition of the function replacing a column of a matrix by a vector. (Contributed by AV, 14-Feb-2019.) (Revised by AV, 26-Feb-2019.)
theorem marepvval {i j: setvar} (A2 B2: class i j) (C: class) (Q: class i j) (R K M N: class) (V: class i j):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq Q (co N R cmatrepV) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wi (w3a (wcel M B2) (wcel C V) (wcel K N)) (wceq (cfv K (co M C Q)) (cmpo i j N N (cif (wceq (cv j) K) (cfv (cv i) C) (co (cv i) (cv j) M)))) $;

--| An entry of a matrix with a replaced column. (Contributed by AV, 14-Feb-2019.) (Revised by AV, 26-Feb-2019.)
theorem marepveval (A2 B2 C Q R I J K M N V: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq Q (co N R cmatrepV) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wi (wa (w3a (wcel M B2) (wcel C V) (wcel K N)) (wa (wcel I N) (wcel J N))) (wceq (co I J (cfv K (co M C Q))) (cif (wceq J K) (cfv I C) (co I J M))) $;

--| Closure of the column replacement function for square matrices. (Contributed by AV, 14-Feb-2019.) (Revised by AV, 26-Feb-2019.)
theorem marepvcl (A2 B2 C R K M N V: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wi (wa (wcel R crg) (w3a (wcel M B2) (wcel C V) (wcel K N))) (wcel (cfv K (co M C (co N R cmatrepV))) B2) $;

--| Closure of the column replacement function for identity matrices. (Contributed by AV, 15-Feb-2019.) (Revised by AV, 26-Feb-2019.)
theorem ma1repvcl (A2 B2 C R c_1 K N V: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wi (wa (wa (wcel R crg) (wcel N cfn)) (wa (wcel C V) (wcel K N))) (wcel (cfv K (co c_1 C (co N R cmatrepV))) B2) $;

--| An entry of an identity matrix with a replaced column. (Contributed by AV, 16-Feb-2019.) (Revised by AV, 26-Feb-2019.)
theorem ma1repveval (A2 B2 C R c_1 E I J K M N V c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq E (cfv K (co c_1 C (co N R cmatrepV))) $ >
  $ wi (w3a (wcel R crg) (w3a (wcel M B2) (wcel C V) (wcel K N)) (wa (wcel I N) (wcel J N))) (wceq (co I J E) (cif (wceq J K) (cfv I C) (cif (wceq J I) (cfv R cur) c_0))) $;

--| Element by element multiplication of a matrix with an identity matrix with a column replaced by a vector. (Contributed by AV, 16-Feb-2019.) (Revised by AV, 26-Feb-2019.)
theorem mulmarep1el (A2 B2 C R c_1 E I J K L N V X c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq E (cfv K (co c_1 C (co N R cmatrepV))) $ >
  $ wi (w3a (wcel R crg) (w3a (wcel X B2) (wcel C V) (wcel K N)) (w3a (wcel I N) (wcel J N) (wcel L N))) (wceq (co (co I L X) (co L J E) (cfv R cmulr)) (cif (wceq J K) (co (co I L X) (cfv L C) (cfv R cmulr)) (cif (wceq J L) (co I L X) c_0))) $;

--| The sum of element by element multiplications of a matrix with an identity matrix with a column replaced by a vector. (Contributed by AV, 16-Feb-2019.) (Revised by AV, 26-Feb-2019.)
theorem mulmarep1gsum1 {l: setvar} (A2: class l) (B2 C R: class) (c_1 E: class l) (I J K N V X c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq E (cfv K (co c_1 C (co N R cmatrepV))) $ >
  $ wi (w3a (wcel R crg) (w3a (wcel X B2) (wcel C V) (wcel K N)) (w3a (wcel I N) (wcel J N) (wne J K))) (wceq (co R (cmpt l N (co (co I (cv l) X) (co (cv l) J E) (cfv R cmulr))) cgsu) (co I J X)) $;

--| The sum of element by element multiplications of a matrix with an identity matrix with a column replaced by a vector. (Contributed by AV, 18-Feb-2019.) (Revised by AV, 26-Feb-2019.)
theorem mulmarep1gsum2 {l: setvar} (A2 B2 C R c_xp: class) (c_1 E: class l) (I J K N V X c_0 Z: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq E (cfv K (co c_1 C (co N R cmatrepV))) $ >
  $ wceq c_xp (co R (cop N N) cmvmul) $ >
  $ wi (w3a (wcel R crg) (w3a (wcel X B2) (wcel C V) (wcel K N)) (w3a (wcel I N) (wcel J N) (wceq (co X C c_xp) Z))) (wceq (co R (cmpt l N (co (co I (cv l) X) (co (cv l) J E) (cfv R cmulr))) cgsu) (cif (wceq J K) (cfv I Z) (co I J X))) $;

--| Replacing the ith row by 0's and the ith component of a (column) vector at the diagonal position for the identity matrix with the ith column replaced by the vector results in the matrix itself. (Contributed by AV, 14-Feb-2019.) (Revised by AV, 27-Feb-2019.)
theorem _1marepvmarrepid (R c_1 I N V X Z: class):
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq c_1 (cfv (co N R cmat) cur) $ >
  $ wceq X (cfv I (co c_1 Z (co N R cmatrepV))) $ >
  $ wi (wa (wa (wcel R crg) (wcel N cfn)) (wa (wcel I N) (wcel Z V))) (wceq (co I I (co X (cfv I Z) (co N R cmarrep))) X) $;

--| Syntax for submatrices of a square matrix.
term csubma: class;

--| Define the submatrices of a square matrix. A submatrix is obtained by deleting a row and a column of the original matrix. Since the indices of a matrix need not to be sequential integers, it does not matter that there may be gaps in the numbering of the indices for the submatrix. The determinants of such submatrices are called the "minors" of the original matrix. (Contributed by AV, 27-Dec-2018.)
axiom df_subma {i j k m n r l: setvar}:
  $ wceq csubma (cmpo n r cvv cvv (cmpt m (cfv (co (cv n) (cv r) cmat) cbs) (cmpo k l (cv n) (cv n) (cmpo i j (cdif (cv n) (csn (cv k))) (cdif (cv n) (csn (cv l))) (co (cv i) (cv j) (cv m)))))) $;

--| Any subset of the index set of a square matrix defines a submatrix of the matrix. (Contributed by AV, 1-Jan-2019.)
theorem submabas {i j: setvar} (A2: class i j) (B2 D R M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (wa (wcel M B2) (wss D N)) (wcel (cmpo i j D D (co (cv i) (cv j) M)) (cfv (co D R cmat) cbs)) $;

--| First substitution for a submatrix. (Contributed by AV, 28-Dec-2018.)
theorem submafval {i j k m l: setvar} (A2: class i j k m l) (B2: class i j k l) (Q: class i j k m l) (R N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq Q (co N R csubma) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq Q (cmpt m B2 (cmpo k l N N (cmpo i j (cdif N (csn (cv k))) (cdif N (csn (cv l))) (co (cv i) (cv j) (cv m))))) $;

--| Second substitution for a submatrix. (Contributed by AV, 28-Dec-2018.)
theorem submaval0 {i j k l: setvar} (A2 B2 Q: class i j k l) (R M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq Q (co N R csubma) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (wcel M B2) (wceq (cfv M Q) (cmpo k l N N (cmpo i j (cdif N (csn (cv k))) (cdif N (csn (cv l))) (co (cv i) (cv j) M)))) $;

--| Third substitution for a submatrix. (Contributed by AV, 28-Dec-2018.)
theorem submaval {i j: setvar} (A2 B2 Q: class i j) (R K L M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq Q (co N R csubma) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (w3a (wcel M B2) (wcel K N) (wcel L N)) (wceq (co K L (cfv M Q)) (cmpo i j (cdif N (csn K)) (cdif N (csn L)) (co (cv i) (cv j) M))) $;

--| An entry of a submatrix of a square matrix. (Contributed by AV, 28-Dec-2018.)
theorem submaeval (A2 B2 Q R I J K L M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq Q (co N R csubma) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (w3a (wcel M B2) (wa (wcel K N) (wcel L N)) (wa (wcel I (cdif N (csn K))) (wcel J (cdif N (csn L))))) (wceq (co I J (co K L (cfv M Q))) (co I J M)) $;

--| The submatrix of the identity matrix with the ith column replaced by the vector obtained by removing the ith row and the ith column is an identity matrix. (Contributed by AV, 14-Feb-2019.) (Revised by AV, 27-Feb-2019.)
theorem _1marepvsma1 (R c_1 I N V X Z: class):
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq c_1 (cfv (co N R cmat) cur) $ >
  $ wceq X (cfv I (co c_1 Z (co N R cmatrepV))) $ >
  $ wi (wa (wa (wcel R crg) (wcel N cfn)) (wa (wcel I N) (wcel Z V))) (wceq (co I I (cfv X (co N R csubma))) (cfv (co (cdif N (csn I)) R cmat) cur)) $;

--| Syntax for the matrix determinant function.
term cmdat: class;

--| Determinant of a square matrix. This definition is based on Leibniz' Formula (see ~ mdetleib ). The properties of the axiomatic definition of a determinant according to [Weierstrass] p. 272 are derived from this definition as theorems: "The determinant function is the unique multilinear, alternating and normalized function from the algebra of square matrices of the same dimension over a commutative ring to this ring". Functionality is shown by ~ mdetf . Multilineary means "linear for each row" - the additivity is shown by ~ mdetrlin , the homogeneity by ~ mdetrsca . Furthermore, it is shown that the determinant function is alternating (see ~ mdetralt ) and normalized (see ~ mdet1 ). Finally, uniqueness is shown by ~ mdetuni . As a consequence, the "determinant of a square matrix" is the function value of the determinant function for this square matrix, see ~ mdetleib . (Contributed by Stefan O'Rear, 9-Sep-2015.) (Revised by SO, 10-Jul-2018.)
axiom df_mdet {x3 m n r p: setvar}:
  $ wceq cmdat (cmpo n r cvv cvv (cmpt m (cfv (co (cv n) (cv r) cmat) cbs) (co (cv r) (cmpt p (cfv (cfv (cv n) csymg) cbs) (co (cfv (cv p) (ccom (cfv (cv r) czrh) (cfv (cv n) cpsgn))) (co (cfv (cv r) cmgp) (cmpt x3 (cv n) (co (cfv (cv x3) (cv p)) (cv x3) (cv m))) cgsu) (cfv (cv r) cmulr))) cgsu))) $;

--| First substitution for the determinant definition. (Contributed by Stefan O'Rear, 9-Sep-2015.) (Revised by SO, 9-Jul-2018.)
theorem mdetfval {x3 m p: setvar} (A2: class x3 m p) (B2: class x3 p) (D: class x3 m p) (P: class x3 p) (R: class) (S c_x U: class x3 p) (N: class) (Y: class x3 p):
  $ wceq D (co N R cmdat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq U (cfv R cmgp) $ >
  $ wceq D (cmpt m B2 (co R (cmpt p P (co (cfv (cv p) (ccom Y S)) (co U (cmpt x3 N (co (cfv (cv x3) (cv p)) (cv x3) (cv m))) cgsu) c_x)) cgsu)) $;

--| Full substitution of our determinant definition (also known as Leibniz' Formula, expanding by columns). Proposition 4.6 in [Lang] p. 514. (Contributed by Stefan O'Rear, 3-Oct-2015.) (Revised by SO, 9-Jul-2018.)
theorem mdetleib {x3 p: setvar} (A2 B2 D P: class x3 p) (R: class) (S c_x U: class x3 p) (M N: class) (Y: class x3 p):
  $ wceq D (co N R cmdat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq U (cfv R cmgp) $ >
  $ wi (wcel M B2) (wceq (cfv M D) (co R (cmpt p P (co (cfv (cv p) (ccom Y S)) (co U (cmpt x3 N (co (cfv (cv x3) (cv p)) (cv x3) M)) cgsu) c_x)) cgsu)) $;

--| Leibniz' formula can also be expanded by rows. (Contributed by Stefan O'Rear, 9-Jul-2018.) (Proof shortened by AV, 23-Jul-2019.)
theorem mdetleib2 {x3 p: setvar} (A2: class x3 p) (B2: class) (D: class x3 p) (P R: class) (S c_x U: class x3) (M N: class) (Y: class x3):
  $ wceq D (co N R cmdat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq U (cfv R cmgp) $ >
  $ wi (wa (wcel R ccrg) (wcel M B2)) (wceq (cfv M D) (co R (cmpt p P (co (cfv (cv p) (ccom Y S)) (co U (cmpt x3 N (co (cv x3) (cfv (cv x3) (cv p)) M)) cgsu) c_x)) cgsu)) $;

--| The determinant is not defined for an infinite matrix. (Contributed by AV, 27-Dec-2018.)
theorem nfimdetndef (D R N: class):
  $ wceq D (co N R cmdat) $ >
  $ wi (wnel N cfn) (wceq D c0) $;

--| First substitution of an alternative determinant definition. (Contributed by Stefan O'Rear, 9-Sep-2015.) (Revised by AV, 27-Dec-2018.)
theorem mdetfval1 {x3 m p: setvar} (A2: class x3 m p) (B2: class x3) (D: class x3 m p) (P: class x3) (R: class) (S c_x U: class x3 p) (N: class) (Y: class x3 p):
  $ wceq D (co N R cmdat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq U (cfv R cmgp) $ >
  $ wceq D (cmpt m B2 (co R (cmpt p P (co (cfv (cfv (cv p) S) Y) (co U (cmpt x3 N (co (cfv (cv x3) (cv p)) (cv x3) (cv m))) cgsu) c_x)) cgsu)) $;

--| Full substitution of an alternative determinant definition (also known as Leibniz' Formula). (Contributed by Stefan O'Rear, 3-Oct-2015.) (Revised by AV, 26-Dec-2018.)
theorem mdetleib1 {x3 p: setvar} (A2: class x3 p) (B2: class x3) (D: class x3 p) (P: class x3) (R: class) (S c_x U: class x3 p) (M N: class) (Y: class x3 p):
  $ wceq D (co N R cmdat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq U (cfv R cmgp) $ >
  $ wi (wcel M B2) (wceq (cfv M D) (co R (cmpt p P (co (cfv (cfv (cv p) S) Y) (co U (cmpt x3 N (co (cfv (cv x3) (cv p)) (cv x3) M)) cgsu) c_x)) cgsu)) $;

--| The determinant function for 0-dimensional matrices on a given ring is the function mapping the empty set to the unity element of that ring. (Contributed by AV, 28-Feb-2019.)
theorem mdet0pr (R: class):
  $ wi (wcel R crg) (wceq (co c0 R cmdat) (csn (cop c0 (cfv R cur)))) $;

--| The determinant function for 0-dimensional matrices on a given ring is a bijection from the singleton containing the empty set (empty matrix) onto the singleton containing the unity element of that ring. (Contributed by AV, 28-Feb-2019.)
theorem mdet0f1o (R: class):
  $ wi (wcel R crg) (wf1o (csn c0) (csn (cfv R cur)) (co c0 R cmdat)) $;

--| The determinant of the empty matrix on a given ring is the unity element of that ring. (Contributed by AV, 28-Feb-2019.)
theorem mdet0fv0 (R: class):
  $ wi (wcel R crg) (wceq (cfv c0 (co c0 R cmdat)) (cfv R cur)) $;

--| Functionality of the determinant, see also definition in [Lang] p. 513. (Contributed by Stefan O'Rear, 9-Jul-2018.) (Proof shortened by AV, 23-Jul-2019.)
theorem mdetf (A2 B2 D R K N: class):
  $ wceq D (co N R cmdat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi (wcel R ccrg) (wf B2 K D) $;

--| The determinant evaluates to an element of the base ring. (Contributed by Stefan O'Rear, 9-Sep-2015.) (Revised by AV, 7-Feb-2019.)
theorem mdetcl (A2 B2 D R K M N: class):
  $ wceq D (co N R cmdat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi (wa (wcel R ccrg) (wcel M B2)) (wcel (cfv M D) K) $;

--| The determinant of a 1-dimensional matrix equals its (single) entry. (Contributed by AV, 6-Aug-2019.)
theorem m1detdiag (A2 B2 D R I M N V: class):
  $ wceq D (co N R cmdat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (w3a (wcel R ccrg) (wa (wceq N (csn I)) (wcel I V)) (wcel M B2)) (wceq (cfv M D) (co I I M)) $;

--| Lemma for ~ mdetdiag . Previously part of proof for ~ mdet1 . (Contributed by SO, 10-Jul-2018.) (Revised by AV, 17-Aug-2019.)
theorem mdetdiaglem {i j k: setvar} (A2: class i j k) (B2: class i j) (D: class i j k) (P: class) (R: class i j) (S c_x: class i j k) (G H: class i j) (M N c_0: class) (Z: class i j k):
  $ wceq D (co N R cmdat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq H (cfv (cfv N csymg) cbs) $ >
  $ wceq Z (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (w3a (wcel R ccrg) (wcel N cfn) (wcel M B2)) (wral i (wral j (wi (wne (cv i) (cv j)) (wceq (co (cv i) (cv j) M) c_0)) N) N) (wa (wcel P H) (wne P (cres cid N)))) (wceq (co (cfv P (ccom Z S)) (co G (cmpt k N (co (cfv (cv k) P) (cv k) M)) cgsu) c_x) c_0) $;

--| The determinant of a diagonal matrix is the product of the entries in the diagonal. (Contributed by AV, 17-Aug-2019.)
theorem mdetdiag {i j k: setvar} (A2: class i j k) (B2: class i j) (D: class i j k) (R G: class i j) (M N c_0: class):
  $ wceq D (co N R cmdat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel R ccrg) (wcel N cfn) (wcel M B2)) (wi (wral i (wral j (wi (wne (cv i) (cv j)) (wceq (co (cv i) (cv j) M) c_0)) N) N) (wceq (cfv M D) (co G (cmpt k N (co (cv k) (cv k) M)) cgsu))) $;

--| The determinant of a diagonal matrix with identical entries is the power of the entry in the diagonal. (Contributed by AV, 17-Aug-2019.)
theorem mdetdiagid {i j: setvar} (A2: class i j) (B2 C: class) (D: class i j) (R: class) (c_x G: class i j) (M N X c_0: class):
  $ wceq D (co N R cmdat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq C (cfv R cbs) $ >
  $ wceq c_x (cfv G cmg) $ >
  $ wi (wa (wa (wcel R ccrg) (wcel N cfn)) (wa (wcel M B2) (wcel X C))) (wi (wral i (wral j (wceq (co (cv i) (cv j) M) (cif (wceq (cv i) (cv j)) X c_0)) N) N) (wceq (cfv M D) (co (cfv N chash) X c_x))) $;

--| The determinant of the identity matrix is 1, i.e. the determinant function is normalized, see also definition in [Lang] p. 513. (Contributed by SO, 10-Jul-2018.) (Proof shortened by AV, 25-Nov-2019.)
theorem mdet1 (A2 D R c_1 I N: class):
  $ wceq D (co N R cmdat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq I (cfv A2 cur) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R ccrg) (wcel N cfn)) (wceq (cfv I D) c_1) $;

--| The determinant function is additive for each row: The matrices X, Y, Z are identical except for the I's row, and the I's row of the matrix X is the componentwise sum of the I's row of the matrices Y and Z. In this case the determinant of X is the sum of the determinants of Y and Z. (Contributed by SO, 9-Jul-2018.) (Proof shortened by AV, 23-Jul-2019.)
theorem mdetrlin (ph: wff) (A2 B2 D c_pl R I N X Y Z: class):
  $ wceq D (co N R cmdat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel I N) $ >
  $ wi ph (wceq (cres X (cxp (csn I) N)) (co (cres Y (cxp (csn I) N)) (cres Z (cxp (csn I) N)) (cof c_pl))) $ >
  $ wi ph (wceq (cres X (cxp (cdif N (csn I)) N)) (cres Y (cxp (cdif N (csn I)) N))) $ >
  $ wi ph (wceq (cres X (cxp (cdif N (csn I)) N)) (cres Z (cxp (cdif N (csn I)) N))) $ >
  $ wi ph (wceq (cfv X D) (co (cfv Y D) (cfv Z D) c_pl)) $;

--| The determinant function is homogeneous for each row: If the matrices ` X ` and ` Z ` are identical except for the ` I ` -th row, and the ` I ` -th row of the matrix ` X ` is the componentwise product of the ` I ` -th row of the matrix ` Z ` and the scalar ` Y ` , then the determinant of ` X ` is the determinant of ` Z ` multiplied by ` Y ` . (Contributed by SO, 9-Jul-2018.) (Proof shortened by AV, 23-Jul-2019.)
theorem mdetrsca (ph: wff) (A2 B2 D R c_x I K N X Y Z: class):
  $ wceq D (co N R cmdat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y K) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel I N) $ >
  $ wi ph (wceq (cres X (cxp (csn I) N)) (co (cxp (cxp (csn I) N) (csn Y)) (cres Z (cxp (csn I) N)) (cof c_x))) $ >
  $ wi ph (wceq (cres X (cxp (cdif N (csn I)) N)) (cres Z (cxp (cdif N (csn I)) N))) $ >
  $ wi ph (wceq (cfv X D) (co Y (cfv Z D) c_x)) $;

--| The determinant function is homogeneous for each row (matrices are given explicitly by their entries). (Contributed by SO, 16-Jul-2018.)
theorem mdetrsca2 {i j: setvar} (ph: wff) (D R: class i j) (c_x F I K N: class) (X Y: class i j):
  $ wceq D (co N R cmdat) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi (w3a ph (wcel (cv i) N) (wcel (cv j) N)) (wcel X K) $ >
  $ wi (w3a ph (wcel (cv i) N) (wcel (cv j) N)) (wcel Y K) $ >
  $ wi ph (wcel F K) $ >
  $ wi ph (wcel I N) $ >
  $ wi ph (wceq (cfv (cmpo i j N N (cif (wceq (cv i) I) (co F X c_x) Y)) D) (co F (cfv (cmpo i j N N (cif (wceq (cv i) I) X Y)) D) c_x)) $;

--| The determinant of a matrix with a row containing only 0's is 0. (Contributed by SO, 16-Jul-2018.)
theorem mdetr0 {i j: setvar} (ph: wff) (D: class i j) (R I K N: class) (X: class i j) (c_0: class):
  $ wceq D (co N R cmdat) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi (w3a ph (wcel (cv i) N) (wcel (cv j) N)) (wcel X K) $ >
  $ wi ph (wcel I N) $ >
  $ wi ph (wceq (cfv (cmpo i j N N (cif (wceq (cv i) I) c_0 X)) D) c_0) $;

--| The determinant of the zero matrix (of dimension greater 0!) is 0. (Contributed by AV, 17-Aug-2019.) (Revised by AV, 3-Jul-2022.)
theorem mdet0 (A2 D R N c_0 Z: class):
  $ wceq D (co N R cmdat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq Z (cfv A2 c0g) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel R ccrg) (wcel N cfn) (wne N c0)) (wceq (cfv Z D) c_0) $;

--| The determinant function is additive for each row (matrices are given explicitly by their entries). (Contributed by SO, 16-Jul-2018.)
theorem mdetrlin2 {i j: setvar} (ph: wff) (D: class i j) (c_pl: class) (R: class i j) (I K N: class) (X Y Z: class i j):
  $ wceq D (co N R cmdat) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi (w3a ph (wcel (cv i) N) (wcel (cv j) N)) (wcel X K) $ >
  $ wi (w3a ph (wcel (cv i) N) (wcel (cv j) N)) (wcel Y K) $ >
  $ wi (w3a ph (wcel (cv i) N) (wcel (cv j) N)) (wcel Z K) $ >
  $ wi ph (wcel I N) $ >
  $ wi ph (wceq (cfv (cmpo i j N N (cif (wceq (cv i) I) (co X Y c_pl) Z)) D) (co (cfv (cmpo i j N N (cif (wceq (cv i) I) X Z)) D) (cfv (cmpo i j N N (cif (wceq (cv i) I) Y Z)) D) c_pl)) $;

--| The determinant function is alternating regarding rows: if a matrix has two identical rows, its determinant is 0. Corollary 4.9 in [Lang] p. 515. (Contributed by SO, 10-Jul-2018.) (Proof shortened by AV, 23-Jul-2018.)
theorem mdetralt {a: setvar} (ph: wff a) (A2 B2 D R: class a) (I J N X: class) (c_0: class a):
  $ wceq D (co N R cmdat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel I N) $ >
  $ wi ph (wcel J N) $ >
  $ wi ph (wne I J) $ >
  $ wi ph (wral a (wceq (co I (cv a) X) (co J (cv a) X)) N) $ >
  $ wi ph (wceq (cfv X D) c_0) $;

--| The determinant function is alternating regarding rows (matrix is given explicitly by its entries). (Contributed by SO, 16-Jul-2018.)
theorem mdetralt2 {i j: setvar} (ph: wff) (D R: class i j) (I J K N: class) (X: class j) (Y c_0: class i j):
  $ wceq D (co N R cmdat) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi (wa ph (wcel (cv j) N)) (wcel X K) $ >
  $ wi (w3a ph (wcel (cv i) N) (wcel (cv j) N)) (wcel Y K) $ >
  $ wi ph (wcel I N) $ >
  $ wi ph (wcel J N) $ >
  $ wi ph (wne I J) $ >
  $ wi ph (wceq (cfv (cmpo i j N N (cif (wceq (cv i) I) X (cif (wceq (cv i) J) X Y))) D) c_0) $;

--| The determinant function is multilinear (additive and homogeneous for each row (matrices are given explicitly by their entries). Corollary 4.9 in [Lang] p. 515. (Contributed by SO, 16-Jul-2018.)
theorem mdetero {i j: setvar} (ph: wff) (D: class i j) (c_pl: class) (R: class i j) (c_x I J K N W: class) (X Y: class j) (Z: class i j):
  $ wceq D (co N R cmdat) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi (wa ph (wcel (cv j) N)) (wcel X K) $ >
  $ wi (wa ph (wcel (cv j) N)) (wcel Y K) $ >
  $ wi (w3a ph (wcel (cv i) N) (wcel (cv j) N)) (wcel Z K) $ >
  $ wi ph (wcel W K) $ >
  $ wi ph (wcel I N) $ >
  $ wi ph (wcel J N) $ >
  $ wi ph (wne I J) $ >
  $ wi ph (wceq (cfv (cmpo i j N N (cif (wceq (cv i) I) (co X (co W Y c_x) c_pl) (cif (wceq (cv i) J) Y Z))) D) (cfv (cmpo i j N N (cif (wceq (cv i) I) X (cif (wceq (cv i) J) Y Z))) D)) $;

--| Determinant is invariant under transposition. Proposition 4.8 in [Lang] p. 514. (Contributed by Stefan O'Rear, 9-Jul-2018.)
theorem mdettpos (A2 B2 D R M N: class):
  $ wceq D (co N R cmdat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (wa (wcel R ccrg) (wcel M B2)) (wceq (cfv (ctpos M) D) (cfv M D)) $;

--| Lemma for ~ mdetuni . (Contributed by SO, 14-Jul-2018.)
theorem mdetunilem1 {x3 y1 z w: setvar} (ph: wff) (A2 B2 D c_pl R c_x c_1 E F G K N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wf B2 K D) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wi (wa (wne (cv y1) (cv z)) (wral w (wceq (co (cv y1) (cv w) (cv x3)) (co (cv z) (cv w) (cv x3))) N)) (wceq (cfv (cv x3) D) c_0)) N) N) B2) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wral w (wi (w3a (wceq (cres (cv x3) (cxp (csn (cv w)) N)) (co (cres (cv y1) (cxp (csn (cv w)) N)) (cres (cv z) (cxp (csn (cv w)) N)) (cof c_pl))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv y1) (cxp (cdif N (csn (cv w))) N))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv z) (cxp (cdif N (csn (cv w))) N)))) (wceq (cfv (cv x3) D) (co (cfv (cv y1) D) (cfv (cv z) D) c_pl))) N) B2) B2) B2) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wral w (wi (wa (wceq (cres (cv x3) (cxp (csn (cv w)) N)) (co (cxp (cxp (csn (cv w)) N) (csn (cv y1))) (cres (cv z) (cxp (csn (cv w)) N)) (cof c_x))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv z) (cxp (cdif N (csn (cv w))) N)))) (wceq (cfv (cv x3) D) (co (cv y1) (cfv (cv z) D) c_x))) N) B2) K) B2) $ >
  $ wi (wa (w3a ph (wcel E B2) (wral w (wceq (co F (cv w) E) (co G (cv w) E)) N)) (w3a (wcel F N) (wcel G N) (wne F G))) (wceq (cfv E D) c_0) $;

--| Lemma for ~ mdetuni . (Contributed by SO, 15-Jul-2018.)
theorem mdetunilem2 {x3 y1 z w a b: setvar} (ph ps: wff) (A2 B2 D c_pl: class) (R c_x: class a b) (c_1 E: class) (F: class b) (G: class) (H: class a b) (K N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wf B2 K D) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wi (wa (wne (cv y1) (cv z)) (wral w (wceq (co (cv y1) (cv w) (cv x3)) (co (cv z) (cv w) (cv x3))) N)) (wceq (cfv (cv x3) D) c_0)) N) N) B2) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wral w (wi (w3a (wceq (cres (cv x3) (cxp (csn (cv w)) N)) (co (cres (cv y1) (cxp (csn (cv w)) N)) (cres (cv z) (cxp (csn (cv w)) N)) (cof c_pl))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv y1) (cxp (cdif N (csn (cv w))) N))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv z) (cxp (cdif N (csn (cv w))) N)))) (wceq (cfv (cv x3) D) (co (cfv (cv y1) D) (cfv (cv z) D) c_pl))) N) B2) B2) B2) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wral w (wi (wa (wceq (cres (cv x3) (cxp (csn (cv w)) N)) (co (cxp (cxp (csn (cv w)) N) (csn (cv y1))) (cres (cv z) (cxp (csn (cv w)) N)) (cof c_x))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv z) (cxp (cdif N (csn (cv w))) N)))) (wceq (cfv (cv x3) D) (co (cv y1) (cfv (cv z) D) c_x))) N) B2) K) B2) $ >
  $ wi ps ph $ >
  $ wi ps (w3a (wcel E N) (wcel G N) (wne E G)) $ >
  $ wi (wa ps (wcel (cv b) N)) (wcel F K) $ >
  $ wi (w3a ps (wcel (cv a) N) (wcel (cv b) N)) (wcel H K) $ >
  $ wi ps (wceq (cfv (cmpo a b N N (cif (wceq (cv a) E) F (cif (wceq (cv a) G) F H))) D) c_0) $;

--| Lemma for ~ mdetuni . (Contributed by SO, 15-Jul-2018.)
theorem mdetunilem3 {x3 y1 z w: setvar} (ph: wff) (A2 B2 D c_pl R c_x c_1 E F G H K N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wf B2 K D) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wi (wa (wne (cv y1) (cv z)) (wral w (wceq (co (cv y1) (cv w) (cv x3)) (co (cv z) (cv w) (cv x3))) N)) (wceq (cfv (cv x3) D) c_0)) N) N) B2) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wral w (wi (w3a (wceq (cres (cv x3) (cxp (csn (cv w)) N)) (co (cres (cv y1) (cxp (csn (cv w)) N)) (cres (cv z) (cxp (csn (cv w)) N)) (cof c_pl))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv y1) (cxp (cdif N (csn (cv w))) N))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv z) (cxp (cdif N (csn (cv w))) N)))) (wceq (cfv (cv x3) D) (co (cfv (cv y1) D) (cfv (cv z) D) c_pl))) N) B2) B2) B2) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wral w (wi (wa (wceq (cres (cv x3) (cxp (csn (cv w)) N)) (co (cxp (cxp (csn (cv w)) N) (csn (cv y1))) (cres (cv z) (cxp (csn (cv w)) N)) (cof c_x))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv z) (cxp (cdif N (csn (cv w))) N)))) (wceq (cfv (cv x3) D) (co (cv y1) (cfv (cv z) D) c_x))) N) B2) K) B2) $ >
  $ wi (w3a (w3a ph (wcel E B2) (wcel F B2)) (w3a (wcel G B2) (wcel H N) (wceq (cres E (cxp (csn H) N)) (co (cres F (cxp (csn H) N)) (cres G (cxp (csn H) N)) (cof c_pl)))) (wa (wceq (cres E (cxp (cdif N (csn H)) N)) (cres F (cxp (cdif N (csn H)) N))) (wceq (cres E (cxp (cdif N (csn H)) N)) (cres G (cxp (cdif N (csn H)) N))))) (wceq (cfv E D) (co (cfv F D) (cfv G D) c_pl)) $;

--| Lemma for ~ mdetuni . (Contributed by SO, 15-Jul-2018.)
theorem mdetunilem4 {x3 y1 z w: setvar} (ph: wff) (A2 B2 D c_pl R c_x c_1 E F G H K N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wf B2 K D) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wi (wa (wne (cv y1) (cv z)) (wral w (wceq (co (cv y1) (cv w) (cv x3)) (co (cv z) (cv w) (cv x3))) N)) (wceq (cfv (cv x3) D) c_0)) N) N) B2) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wral w (wi (w3a (wceq (cres (cv x3) (cxp (csn (cv w)) N)) (co (cres (cv y1) (cxp (csn (cv w)) N)) (cres (cv z) (cxp (csn (cv w)) N)) (cof c_pl))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv y1) (cxp (cdif N (csn (cv w))) N))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv z) (cxp (cdif N (csn (cv w))) N)))) (wceq (cfv (cv x3) D) (co (cfv (cv y1) D) (cfv (cv z) D) c_pl))) N) B2) B2) B2) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wral w (wi (wa (wceq (cres (cv x3) (cxp (csn (cv w)) N)) (co (cxp (cxp (csn (cv w)) N) (csn (cv y1))) (cres (cv z) (cxp (csn (cv w)) N)) (cof c_x))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv z) (cxp (cdif N (csn (cv w))) N)))) (wceq (cfv (cv x3) D) (co (cv y1) (cfv (cv z) D) c_x))) N) B2) K) B2) $ >
  $ wi (w3a ph (w3a (wcel E B2) (wcel F K) (wcel G B2)) (w3a (wcel H N) (wceq (cres E (cxp (csn H) N)) (co (cxp (cxp (csn H) N) (csn F)) (cres G (cxp (csn H) N)) (cof c_x))) (wceq (cres E (cxp (cdif N (csn H)) N)) (cres G (cxp (cdif N (csn H)) N))))) (wceq (cfv E D) (co F (cfv G D) c_x)) $;

--| Lemma for ~ mdetuni . (Contributed by SO, 15-Jul-2018.)
theorem mdetunilem5 {x3 y1 z w a b: setvar} (ph ps: wff) (A2 B2 D c_pl: class) (R c_x: class a b) (c_1 E: class) (F G H: class a b) (K N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wf B2 K D) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wi (wa (wne (cv y1) (cv z)) (wral w (wceq (co (cv y1) (cv w) (cv x3)) (co (cv z) (cv w) (cv x3))) N)) (wceq (cfv (cv x3) D) c_0)) N) N) B2) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wral w (wi (w3a (wceq (cres (cv x3) (cxp (csn (cv w)) N)) (co (cres (cv y1) (cxp (csn (cv w)) N)) (cres (cv z) (cxp (csn (cv w)) N)) (cof c_pl))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv y1) (cxp (cdif N (csn (cv w))) N))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv z) (cxp (cdif N (csn (cv w))) N)))) (wceq (cfv (cv x3) D) (co (cfv (cv y1) D) (cfv (cv z) D) c_pl))) N) B2) B2) B2) $ >

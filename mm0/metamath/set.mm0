  $ wi ph (w3a (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I)) (wss (cpr C D) (cfv L I))) $ >
  $ wi ph (wral k (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cfv (cfv (cv k) F) I)) (co cc0 (cfv F chash) cfzo)) $;

--| Construction of a walk from two given edges in a graph. (Contributed by AV, 7-Feb-2021.) (Revised by AV, 24-Mar-2021.)
theorem _3wlkd (ph: wff) (A2 B2 C D P F G I J K L V: class):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wi ph (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) $ >
  $ wi ph (w3a (wa (wne A2 B2) (wne A2 C)) (wa (wne B2 C) (wne B2 D)) (wne C D)) $ >
  $ wi ph (w3a (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I)) (wss (cpr C D) (cfv L I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (cfv G cwlks)) $;

--| A walk of length 3 from one vertex to another, different vertex via a third vertex. (Contributed by AV, 8-Feb-2021.) (Revised by AV, 24-Mar-2021.)
theorem _3wlkond (ph: wff) (A2 B2 C D P F G I J K L V: class):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wi ph (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) $ >
  $ wi ph (w3a (wa (wne A2 B2) (wne A2 C)) (wa (wne B2 C) (wne B2 D)) (wne C D)) $ >
  $ wi ph (w3a (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I)) (wss (cpr C D) (cfv L I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (co A2 D (cfv G cwlkson))) $;

--| Construction of a trail from two given edges in a graph. (Contributed by Alexander van der Vekens, 13-Nov-2017.) (Revised by AV, 8-Feb-2021.) (Revised by AV, 24-Mar-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem _3trld (ph: wff) (A2 B2 C D P F G I J K L V: class):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wi ph (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) $ >
  $ wi ph (w3a (wa (wne A2 B2) (wne A2 C)) (wa (wne B2 C) (wne B2 D)) (wne C D)) $ >
  $ wi ph (w3a (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I)) (wss (cpr C D) (cfv L I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (w3a (wne J K) (wne J L) (wne K L)) $ >
  $ wi ph (wbr F P (cfv G ctrls)) $;

--| A trail of length 3 from one vertex to another, different vertex via a third vertex. (Contributed by AV, 8-Feb-2021.) (Revised by AV, 24-Mar-2021.)
theorem _3trlond (ph: wff) (A2 B2 C D P F G I J K L V: class):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wi ph (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) $ >
  $ wi ph (w3a (wa (wne A2 B2) (wne A2 C)) (wa (wne B2 C) (wne B2 D)) (wne C D)) $ >
  $ wi ph (w3a (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I)) (wss (cpr C D) (cfv L I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (w3a (wne J K) (wne J L) (wne K L)) $ >
  $ wi ph (wbr F P (co A2 D (cfv G ctrlson))) $;

--| A path of length 3 from one vertex to another vertex via a third vertex. (Contributed by Alexander van der Vekens, 6-Dec-2017.) (Revised by AV, 10-Feb-2021.) (Revised by AV, 24-Mar-2021.)
theorem _3pthd (ph: wff) (A2 B2 C D P F G I J K L V: class):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wi ph (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) $ >
  $ wi ph (w3a (wa (wne A2 B2) (wne A2 C)) (wa (wne B2 C) (wne B2 D)) (wne C D)) $ >
  $ wi ph (w3a (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I)) (wss (cpr C D) (cfv L I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (w3a (wne J K) (wne J L) (wne K L)) $ >
  $ wi ph (wbr F P (cfv G cpths)) $;

--| A path of length 3 from one vertex to another, different vertex via a third vertex. (Contributed by AV, 10-Feb-2021.) (Revised by AV, 24-Mar-2021.)
theorem _3pthond (ph: wff) (A2 B2 C D P F G I J K L V: class):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wi ph (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) $ >
  $ wi ph (w3a (wa (wne A2 B2) (wne A2 C)) (wa (wne B2 C) (wne B2 D)) (wne C D)) $ >
  $ wi ph (w3a (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I)) (wss (cpr C D) (cfv L I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (w3a (wne J K) (wne J L) (wne K L)) $ >
  $ wi ph (wbr F P (co A2 D (cfv G cpthson))) $;

--| A simple path of length 3 from one vertex to another, different vertex via a third vertex. (Contributed by AV, 10-Feb-2021.) (Revised by AV, 24-Mar-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem _3spthd (ph: wff) (A2 B2 C D P F G I J K L V: class):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wi ph (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) $ >
  $ wi ph (w3a (wa (wne A2 B2) (wne A2 C)) (wa (wne B2 C) (wne B2 D)) (wne C D)) $ >
  $ wi ph (w3a (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I)) (wss (cpr C D) (cfv L I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (w3a (wne J K) (wne J L) (wne K L)) $ >
  $ wi ph (wne A2 D) $ >
  $ wi ph (wbr F P (cfv G cspths)) $;

--| A simple path of length 3 from one vertex to another, different vertex via a third vertex. (Contributed by AV, 10-Feb-2021.) (Revised by AV, 24-Mar-2021.)
theorem _3spthond (ph: wff) (A2 B2 C D P F G I J K L V: class):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wi ph (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) $ >
  $ wi ph (w3a (wa (wne A2 B2) (wne A2 C)) (wa (wne B2 C) (wne B2 D)) (wne C D)) $ >
  $ wi ph (w3a (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I)) (wss (cpr C D) (cfv L I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (w3a (wne J K) (wne J L) (wne K L)) $ >
  $ wi ph (wne A2 D) $ >
  $ wi ph (wbr F P (co A2 D (cfv G cspthson))) $;

--| Construction of a 3-cycle from three given edges in a graph. (Contributed by Alexander van der Vekens, 13-Nov-2017.) (Revised by AV, 10-Feb-2021.) (Revised by AV, 24-Mar-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem _3cycld (ph: wff) (A2 B2 C D P F G I J K L V: class):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wi ph (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) $ >
  $ wi ph (w3a (wa (wne A2 B2) (wne A2 C)) (wa (wne B2 C) (wne B2 D)) (wne C D)) $ >
  $ wi ph (w3a (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I)) (wss (cpr C D) (cfv L I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (w3a (wne J K) (wne J L) (wne K L)) $ >
  $ wi ph (wceq A2 D) $ >
  $ wi ph (wbr F P (cfv G ccycls)) $;

--| Construction of a 3-cycle from three given edges in a graph, containing an endpoint of one of these edges. (Contributed by Alexander van der Vekens, 17-Nov-2017.) (Revised by AV, 10-Feb-2021.) (Revised by AV, 24-Mar-2021.)
theorem _3cyclpd (ph: wff) (A2 B2 C D P F G I J K L V: class):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wi ph (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) $ >
  $ wi ph (w3a (wa (wne A2 B2) (wne A2 C)) (wa (wne B2 C) (wne B2 D)) (wne C D)) $ >
  $ wi ph (w3a (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I)) (wss (cpr C D) (cfv L I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (w3a (wne J K) (wne J L) (wne K L)) $ >
  $ wi ph (wceq A2 D) $ >
  $ wi ph (w3a (wbr F P (cfv G ccycls)) (wceq (cfv F chash) c3) (wceq (cfv cc0 P) A2)) $;

--| If there is a cycle of length 3 in a pseudograph, there are three distinct vertices in the graph which are mutually connected by edges. (Contributed by Alexander van der Vekens, 9-Nov-2017.)
theorem upgr3v3e3cycl {a b c: setvar} (P E: class) (F G: class a b c) (V: class):
  $ wceq E (cfv G cedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi (w3a (wcel G cupgr) (wbr F P (cfv G ccycls)) (wceq (cfv F chash) c3)) (wrex a (wrex b (wrex c (wa (w3a (wcel (cpr (cv a) (cv b)) E) (wcel (cpr (cv b) (cv c)) E) (wcel (cpr (cv c) (cv a)) E)) (w3a (wne (cv a) (cv b)) (wne (cv b) (cv c)) (wne (cv c) (cv a)))) V) V) V) $;

--| Lemma for ~ uhgr3cyclex . (Contributed by AV, 12-Feb-2021.)
theorem uhgr3cyclexlem (A2 B2 C E G I J K V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wa (wa (wa (wcel A2 V) (wcel B2 V)) (wne A2 B2)) (wa (wa (wcel J (cdm I)) (wceq (cpr B2 C) (cfv J I))) (wa (wcel K (cdm I)) (wceq (cpr C A2) (cfv K I))))) (wne J K) $;

--| If there are three different vertices in a hypergraph which are mutually connected by edges, there is a 3-cycle in the graph containing one of these vertices. (Contributed by Alexander van der Vekens, 17-Nov-2017.) (Revised by AV, 12-Feb-2021.)
theorem uhgr3cyclex {f2 p: setvar} (A2 B2 C: class) (E: class f2 p) (G: class) (V: class f2 p):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (wcel G cuhgr) (wa (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) (w3a (wne A2 B2) (wne A2 C) (wne B2 C))) (w3a (wcel (cpr A2 B2) E) (wcel (cpr B2 C) E) (wcel (cpr C A2) E))) (wex f2 (wex p (w3a (wbr (cv f2) (cv p) (cfv G ccycls)) (wceq (cfv (cv f2) chash) c3) (wceq (cfv cc0 (cv p)) A2)))) $;

--| If there are three (different) vertices in a multigraph which are mutually connected by edges, there is a 3-cycle in the graph containing one of these vertices. (Contributed by Alexander van der Vekens, 17-Nov-2017.) (Revised by AV, 12-Feb-2021.)
theorem umgr3cyclex {f2 p: setvar} (A2 B2 C: class) (E: class f2 p) (G: class) (V: class f2 p):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (wcel G cumgr) (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) (w3a (wcel (cpr A2 B2) E) (wcel (cpr B2 C) E) (wcel (cpr C A2) E))) (wex f2 (wex p (w3a (wbr (cv f2) (cv p) (cfv G ccycls)) (wceq (cfv (cv f2) chash) c3) (wceq (cfv cc0 (cv p)) A2)))) $;

--| If and only if there is a 3-cycle in a multigraph, there are three (different) vertices in the graph which are mutually connected by edges. (Contributed by Alexander van der Vekens, 14-Nov-2017.) (Revised by AV, 12-Feb-2021.)
theorem umgr3v3e3cycl {f2 p a b c: setvar} (E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel G cumgr) (wb (wex f2 (wex p (wa (wbr (cv f2) (cv p) (cfv G ccycls)) (wceq (cfv (cv f2) chash) c3)))) (wrex a (wrex b (wrex c (w3a (wcel (cpr (cv a) (cv b)) E) (wcel (cpr (cv b) (cv c)) E) (wcel (cpr (cv c) (cv a)) E)) V) V) V)) $;

--| If there is a cycle of length 4 in a pseudograph, there are four (different) vertices in the graph which are mutually connected by edges. (Contributed by Alexander van der Vekens, 9-Nov-2017.) (Revised by AV, 13-Feb-2021.)
theorem upgr4cycl4dv4e {a b c d: setvar} (P E: class) (F G: class a b c d) (V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (wcel G cupgr) (wbr F P (cfv G ccycls)) (wceq (cfv F chash) c4)) (wrex a (wrex b (wrex c (wrex d (wa (wa (wa (wcel (cpr (cv a) (cv b)) E) (wcel (cpr (cv b) (cv c)) E)) (wa (wcel (cpr (cv c) (cv d)) E) (wcel (cpr (cv d) (cv a)) E))) (wa (w3a (wne (cv a) (cv b)) (wne (cv a) (cv c)) (wne (cv a) (cv d))) (w3a (wne (cv b) (cv c)) (wne (cv b) (cv d)) (wne (cv c) (cv d))))) V) V) V) V) $;

--| Extend class notation with connected graphs.
term cconngr: class;

--| Define the class of all connected graphs. A graph is called _connected_ if there is a path between every pair of (distinct) vertices. The distinctness of the vertices is not necessary for the definition, because there is always a path (of length 0) from a vertex to itself, see ~ 0pthonv and ~ dfconngr1 . (Contributed by Alexander van der Vekens, 2-Dec-2017.) (Revised by AV, 15-Feb-2021.)
axiom df_conngr {v f2 g2 k n p: setvar}:
  $ wceq cconngr (cab g2 (wsbc v (wral k (wral n (wex f2 (wex p (wbr (cv f2) (cv p) (co (cv k) (cv n) (cfv (cv g2) cpthson))))) (cv v)) (cv v)) (cfv (cv g2) cvtx))) $;

--| Alternative definition of the class of all connected graphs, requiring paths between distinct vertices. (Contributed by Alexander van der Vekens, 3-Dec-2017.) (Revised by AV, 15-Feb-2021.)
theorem dfconngr1 {v f2 g2 k n p: setvar}:
  $ wceq cconngr (cab g2 (wsbc v (wral k (wral n (wex f2 (wex p (wbr (cv f2) (cv p) (co (cv k) (cv n) (cfv (cv g2) cpthson))))) (cdif (cv v) (csn (cv k)))) (cv v)) (cfv (cv g2) cvtx))) $;

--| The property of being a connected graph. (Contributed by Alexander van der Vekens, 2-Dec-2017.) (Revised by AV, 15-Feb-2021.)
theorem isconngr {f2 k n p: setvar} (G: class) (V: class f2 p) (W: class f2 k n p):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G W) (wb (wcel G cconngr) (wral k (wral n (wex f2 (wex p (wbr (cv f2) (cv p) (co (cv k) (cv n) (cfv G cpthson))))) V) V)) $;

--| The property of being a connected graph. (Contributed by Alexander van der Vekens, 2-Dec-2017.) (Revised by AV, 15-Feb-2021.)
theorem isconngr1 {f2 k n p: setvar} (G: class) (V: class f2 p) (W: class f2 k n p):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G W) (wb (wcel G cconngr) (wral k (wral n (wex f2 (wex p (wbr (cv f2) (cv p) (co (cv k) (cv n) (cfv G cpthson))))) (cdif V (csn (cv k)))) V)) $;

--| A complete hypergraph is connected. (Contributed by Alexander van der Vekens, 4-Dec-2017.) (Revised by AV, 15-Feb-2021.)
theorem cusconngr (G: class):
  $ wi (wa (wcel G cuhgr) (wcel G ccplgr)) (wcel G cconngr) $;

--| A graph without vertices is connected. (Contributed by Alexander van der Vekens, 2-Dec-2017.) (Revised by AV, 15-Feb-2021.)
theorem _0conngr:
  $ wcel c0 cconngr $;

--| A graph without vertices is connected. (Contributed by Alexander van der Vekens, 2-Dec-2017.) (Revised by AV, 15-Feb-2021.)
theorem _0vconngr (G W: class):
  $ wi (wa (wcel G W) (wceq (cfv G cvtx) c0)) (wcel G cconngr) $;

--| A graph with (at most) one vertex is connected. (Contributed by Alexander van der Vekens, 2-Dec-2017.) (Revised by AV, 15-Feb-2021.)
theorem _1conngr (G N W: class):
  $ wi (wa (wcel G W) (wceq (cfv G cvtx) (csn N))) (wcel G cconngr) $;

--| A vertex in a connected graph with more than one vertex is incident with at least one edge. Formerly part of proof for ~ vdgn0frgrv2 . (Contributed by Alexander van der Vekens, 9-Dec-2017.) (Revised by AV, 4-Apr-2021.)
theorem conngrv2edg {e: setvar} (G I N: class) (V: class e):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (w3a (wcel G cconngr) (wcel N V) (wbr c1 (cfv V chash) clt)) (wrex e (wcel N (cv e)) (crn I)) $;

--| A vertex in a connected multigraph with more than one vertex cannot have degree 0. (Contributed by Alexander van der Vekens, 9-Dec-2017.) (Revised by AV, 4-Apr-2021.)
theorem vdn0conngrumgrv2 (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wa (wcel G cconngr) (wcel G cumgr)) (wa (wcel N V) (wbr c1 (cfv V chash) clt))) (wne (cfv N (cfv G cvtxdg)) cc0) $;

--| Extend class notation with Eulerian paths.
term ceupth: class;

--| Define the set of all Eulerian paths on an arbitrary graph. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 18-Feb-2021.)
axiom df_eupth {f2 g2 p: setvar}:
  $ wceq ceupth (cmpt g2 cvv (copab f2 p (wa (wbr (cv f2) (cv p) (cfv (cv g2) ctrls)) (wfo (co cc0 (cfv (cv f2) chash) cfzo) (cdm (cfv (cv g2) ciedg)) (cv f2))))) $;

--| The set ` ( EulerPaths `` G ) ` of all Eulerian paths on ` G ` is a set of pairs by our definition of an Eulerian path, and so is a relation. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 18-Feb-2021.)
theorem releupth (G: class):
  $ wrel (cfv G ceupth) $;

--| The Eulerian paths on the graph ` G ` . (Contributed by AV, 18-Feb-2021.) (Revised by AV, 29-Oct-2021.)
theorem eupths {f2 p: setvar} (G: class) (I: class f2 p):
  $ wceq I (cfv G ciedg) $ >
  $ wceq (cfv G ceupth) (copab f2 p (wa (wbr (cv f2) (cv p) (cfv G ctrls)) (wfo (co cc0 (cfv (cv f2) chash) cfzo) (cdm I) (cv f2)))) $;

--| The property " ` <. F , P >. ` is an Eulerian path on the graph ` G ` ". An Eulerian path is defined as bijection ` F ` from the edges to a set ` 0 ... ( N - 1 ) ` and a function ` P : ( 0 ... N ) --> V ` into the vertices such that for each ` 0 <_ k < N ` , ` F ( k ) ` is an edge from ` P ( k ) ` to ` P ( k + 1 ) ` . (Since the edges are undirected and there are possibly many edges between any two given vertices, we need to list both the edges and the vertices of the path separately.) (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Mario Carneiro, 3-May-2015.) (Revised by AV, 18-Feb-2021.) (Revised by AV, 30-Oct-2021.)
theorem iseupth (P F G I: class):
  $ wceq I (cfv G ciedg) $ >
  $ wb (wbr F P (cfv G ceupth)) (wa (wbr F P (cfv G ctrls)) (wfo (co cc0 (cfv F chash) cfzo) (cdm I) F)) $;

--| The property " ` <. F , P >. ` is an Eulerian path on the graph ` G ` ". An Eulerian path is defined as bijection ` F ` from the edges to a set ` 0 ... ( N - 1 ) ` and a function ` P : ( 0 ... N ) --> V ` into the vertices such that for each ` 0 <_ k < N ` , ` F ( k ) ` is an edge from ` P ( k ) ` to ` P ( k + 1 ) ` . (Since the edges are undirected and there are possibly many edges between any two given vertices, we need to list both the edges and the vertices of the path separately.) (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Mario Carneiro, 3-May-2015.) (Revised by AV, 18-Feb-2021.) (Revised by AV, 30-Oct-2021.)
theorem iseupthf1o (P F G I: class):
  $ wceq I (cfv G ciedg) $ >
  $ wb (wbr F P (cfv G ceupth)) (wa (wbr F P (cfv G cwlks)) (wf1o (co cc0 (cfv F chash) cfzo) (cdm I) F)) $;

--| Properties of an Eulerian path. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 18-Feb-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem eupthi (P F G I: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wbr F P (cfv G ceupth)) (wa (wbr F P (cfv G cwlks)) (wf1o (co cc0 (cfv F chash) cfzo) (cdm I) F)) $;

--| The ` F ` function in an Eulerian path is a bijection from a half-open range of nonnegative integers to the set of edges. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 18-Feb-2021.)
theorem eupthf1o (P F G I: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wbr F P (cfv G ceupth)) (wf1o (co cc0 (cfv F chash) cfzo) (cdm I) F) $;

--| Any graph with an Eulerian path is of finite size, i.e. with a finite number of edges. (Contributed by Mario Carneiro, 7-Apr-2015.) (Revised by AV, 18-Feb-2021.)
theorem eupthfi (P F G I: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wbr F P (cfv G ceupth)) (wcel (cdm I) cfn) $;

--| The ` N ` -th edge in an eulerian path is the edge having ` P ( N ) ` and ` P ( N + 1 ) ` as endpoints . (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 18-Feb-2021.)
theorem eupthseg (P F G I N: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wa (wbr F P (cfv G ceupth)) (wcel N (co cc0 (cfv F chash) cfzo))) (wss (cpr (cfv N P) (cfv (co N c1 caddc) P)) (cfv (cfv N F) I)) $;

--| The property " ` <. F , P >. ` is an Eulerian path on the pseudograph ` G ` ". (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Mario Carneiro, 3-May-2015.) (Revised by AV, 18-Feb-2021.) (Revised by AV, 30-Oct-2021.)
theorem upgriseupth {k: setvar} (P F G I V: class):
  $ wceq I (cfv G ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G cupgr) (wb (wbr F P (cfv G ceupth)) (w3a (wf1o (co cc0 (cfv F chash) cfzo) (cdm I) F) (wf (co cc0 (cfv F chash) cfz) V P) (wral k (wceq (cfv (cfv (cv k) F) I) (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P))) (co cc0 (cfv F chash) cfzo)))) $;

--| Properties of an Eulerian path in a pseudograph. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 18-Feb-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem upgreupthi {k: setvar} (P F G I V: class):
  $ wceq I (cfv G ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cupgr) (wbr F P (cfv G ceupth))) (w3a (wf1o (co cc0 (cfv F chash) cfzo) (cdm I) F) (wf (co cc0 (cfv F chash) cfz) V P) (wral k (wceq (cfv (cfv (cv k) F) I) (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P))) (co cc0 (cfv F chash) cfzo))) $;

--| The ` N ` -th edge in an eulerian path is the edge from ` P ( N ) ` to ` P ( N + 1 ) ` . (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 18-Feb-2021.)
theorem upgreupthseg (P F G I N: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (w3a (wcel G cupgr) (wbr F P (cfv G ceupth)) (wcel N (co cc0 (cfv F chash) cfzo))) (wceq (cfv (cfv N F) I) (cpr (cfv N P) (cfv (co N c1 caddc) P))) $;

--| An Eulerian path has length ` # ( F ) ` , which is an integer. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 18-Feb-2021.)
theorem eupthcl (P F G: class):
  $ wi (wbr F P (cfv G ceupth)) (wcel (cfv F chash) cn0) $;

--| An Eulerian path is a trail. (Contributed by Alexander van der Vekens, 24-Nov-2017.) (Revised by AV, 18-Feb-2021.)
theorem eupthistrl (P F G: class):
  $ wi (wbr F P (cfv G ceupth)) (wbr F P (cfv G ctrls)) $;

--| An Eulerian path is a walk. (Contributed by AV, 6-Apr-2021.)
theorem eupthiswlk (P F G: class):
  $ wi (wbr F P (cfv G ceupth)) (wbr F P (cfv G cwlks)) $;

--| The ` P ` function in an Eulerian path is a function from a finite sequence of nonnegative integers to the vertices. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 18-Feb-2021.)
theorem eupthpf (P F G: class):
  $ wi (wbr F P (cfv G ceupth)) (wf (co cc0 (cfv F chash) cfz) (cfv G cvtx) P) $;

--| There is an Eulerian path on an empty graph, i.e. a graph with at least one vertex, but without an edge. (Contributed by Mario Carneiro, 7-Apr-2015.) (Revised by AV, 5-Mar-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem eupth0 (A2 G I V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wa (wcel A2 V) (wceq I c0)) (wbr c0 (csn (cop cc0 A2)) (cfv G ceupth)) $;

--| The restriction ` <. H , Q >. ` of an Eulerian path ` <. F , P >. ` to an initial segment of the path (of length ` N ` ) forms an Eulerian path on the subgraph ` S ` consisting of the edges in the initial segment. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Mario Carneiro, 3-May-2015.) (Revised by AV, 6-Mar-2021.) Hypothesis revised using the prefix operation. (Revised by AV, 30-Nov-2022.)
theorem eupthres (ph: wff) (P Q S F G H I N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (cfv G ceupth)) $ >
  $ wi ph (wcel N (co cc0 (cfv F chash) cfzo)) $ >
  $ wi ph (wceq (cfv S ciedg) (cres I (cima F (co cc0 N cfzo)))) $ >
  $ wceq H (co F N cpfx) $ >
  $ wceq Q (cres P (co cc0 N cfz)) $ >
  $ wceq (cfv S cvtx) V $ >
  $ wi ph (wbr H Q (cfv S ceupth)) $;

--| Append one path segment to an Eulerian path ` <. F , P >. ` to become an Eulerian path ` <. H , Q >. ` of the supergraph ` S ` obtained by adding the new edge to the graph ` G ` . (Contributed by Mario Carneiro, 7-Apr-2015.) (Revised by AV, 7-Mar-2021.) (Proof shortened by AV, 30-Oct-2021.) (Revised by AV, 8-Apr-2024.)
theorem eupthp1 (ph: wff) (B2 C P Q S E F G H I N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wfun I) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wn (wcel B2 (cdm I))) $ >
  $ wi ph (wbr F P (cfv G ceupth)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel E (cfv G cedg)) $ >
  $ wi ph (wss (cpr (cfv N P) C) E) $ >
  $ wceq (cfv S ciedg) (cun I (csn (cop B2 E))) $ >
  $ wceq H (cun F (csn (cop N B2))) $ >
  $ wceq Q (cun P (csn (cop (co N c1 caddc) C))) $ >
  $ wceq (cfv S cvtx) V $ >
  $ wi (wa ph (wceq C (cfv N P))) (wceq E (csn C)) $ >
  $ wi ph (wbr H Q (cfv S ceupth)) $;

--| Append one path segment to an Eulerian path ` <. F , P >. ` which may not be an (Eulerian) circuit to become an Eulerian circuit ` <. H , Q >. ` of the supergraph ` S ` obtained by adding the new edge to the graph ` G ` . (Contributed by AV, 11-Mar-2021.) (Proof shortened by AV, 30-Oct-2021.) (Revised by AV, 8-Apr-2024.)
theorem eupth2eucrct (ph: wff) (B2 C P Q S E F G H I N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wfun I) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wn (wcel B2 (cdm I))) $ >
  $ wi ph (wbr F P (cfv G ceupth)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel E (cfv G cedg)) $ >
  $ wi ph (wss (cpr (cfv N P) C) E) $ >
  $ wceq (cfv S ciedg) (cun I (csn (cop B2 E))) $ >
  $ wceq H (cun F (csn (cop N B2))) $ >
  $ wceq Q (cun P (csn (cop (co N c1 caddc) C))) $ >
  $ wceq (cfv S cvtx) V $ >
  $ wi (wa ph (wceq C (cfv N P))) (wceq E (csn C)) $ >
  $ wi ph (wceq C (cfv cc0 P)) $ >
  $ wi ph (wa (wbr H Q (cfv S ceupth)) (wbr H Q (cfv S ccrcts))) $;

--| Lemma for ~ eupth2 . (Contributed by Mario Carneiro, 8-Apr-2015.)
theorem eupth2lem1 (A2 B2 U V: class):
  $ wi (wcel U V) (wb (wcel U (cif (wceq A2 B2) c0 (cpr A2 B2))) (wa (wne A2 B2) (wo (wceq U A2) (wceq U B2)))) $;

--| Lemma for ~ eupth2 . (Contributed by Mario Carneiro, 8-Apr-2015.)
theorem eupth2lem2 (A2 B2 C U: class):
  $ wcel B2 cvv $ >
  $ wi (wa (wne B2 C) (wceq B2 U)) (wb (wn (wcel U (cif (wceq A2 B2) c0 (cpr A2 B2)))) (wcel U (cif (wceq A2 C) c0 (cpr A2 C)))) $;

--| Lemma for ~ trlsegvdeg . (Contributed by AV, 20-Feb-2021.)
theorem trlsegvdeglem1 (ph: wff) (P U F G I N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wfun I) $ >
  $ wi ph (wcel N (co cc0 (cfv F chash) cfzo)) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wbr F P (cfv G ctrls)) $ >
  $ wi ph (wa (wcel (cfv N P) V) (wcel (cfv (co N c1 caddc) P) V)) $;

--| Lemma for ~ trlsegvdeg . (Contributed by AV, 20-Feb-2021.)
theorem trlsegvdeglem2 (ph: wff) (P U F G I N V X Y Z: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wfun I) $ >
  $ wi ph (wcel N (co cc0 (cfv F chash) cfzo)) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wbr F P (cfv G ctrls)) $ >
  $ wi ph (wceq (cfv X cvtx) V) $ >
  $ wi ph (wceq (cfv Y cvtx) V) $ >
  $ wi ph (wceq (cfv Z cvtx) V) $ >
  $ wi ph (wceq (cfv X ciedg) (cres I (cima F (co cc0 N cfzo)))) $ >
  $ wi ph (wceq (cfv Y ciedg) (csn (cop (cfv N F) (cfv (cfv N F) I)))) $ >
  $ wi ph (wceq (cfv Z ciedg) (cres I (cima F (co cc0 N cfz)))) $ >
  $ wi ph (wfun (cfv X ciedg)) $;


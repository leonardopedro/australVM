  $ wi ph (wa (wcel Y crp) (wbr c1 Y cle)) $ >
  $ wi ph (wa (wcel X crp) (wbr Y X clt)) $ >
  $ wi ph (wcel C crp) $ >
  $ wceq W (co (co (co Y (co c4 (co L E cmul) cdiv) caddc) c2 cexp) (co (co (co X (co K c2 cexp) cmul) c4 cexp) (cfv (co (co (co (cdc c3 c2) B2 cmul) (co (co U E cmin) (co L (co E c2 cexp) cmul) cmul) cdiv) (co (co U c3 cmul) C caddc) cmul) ce) caddc) caddc) $ >
  $ wi ph (wcel Z (co W cpnf cico)) $ >
  $ wceq M (co (cfv (co (cfv X clog) (cfv K clog) cdiv) cfl) c1 caddc) $ >
  $ wceq N (cfv (co (co (cfv Z clog) (cfv K clog) cdiv) c2 cdiv) cfl) $ >
  $ wi ph (wral z (wbr (cfv (co (cfv (cv z) R) (cv z) cdiv) cabs) U cle) (co Y cpnf cico)) $ >
  $ wi ph (wral y1 (wrex z (wa (wa (wbr (cv y1) (cv z) clt) (wbr (co (co c1 (co L E cmul) caddc) (cv z) cmul) (co K (cv y1) cmul) clt)) (wral u (wbr (cfv (co (cfv (cv u) R) (cv u) cdiv) cabs) E cle) (co (cv z) (co (co c1 (co L E cmul) caddc) (cv z) cmul) cicc))) crp) (co X cpnf cioo)) $ >
  $ wceq O (co (co (cfv (co Z (co K (co J c1 caddc) cexp) cdiv) cfl) c1 caddc) (cfv (co Z (co K J cexp) cdiv) cfl) cfz) $ >

  $ wceq c_1 (cfv F cur) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq S (cfv C csca) $ >
  $ wceq I (cfv S cur) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq I c_1) $;

--| The unit scalar of the closed kernel dual of a vector space. (Contributed by NM, 11-Jun-2015.)
theorem lcdneg (ph: wff) (C R S U H K M N W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq M (cfv R cminusg) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq S (cfv C csca) $ >
  $ wceq N (cfv S cminusg) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq N M) $;

--| The zero functional in the set of functionals with closed kernels. (Contributed by NM, 20-Mar-2015.)
theorem lcd0v (ph: wff) (C R U H K O V W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq O (cfv C c0g) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq O (cxp V (csn c_0))) $;

--| The zero functional in the set of functionals with closed kernels. (Contributed by NM, 27-Mar-2015.)
theorem lcd0v2 (ph: wff) (C D U H K O W c_0: class):

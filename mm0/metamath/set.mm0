  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Z) N)) $ >
  $ wi ph (wne (cfv (csn Y) N) (cfv (csn T) N)) $ >
  $ wi ph (wne (cfv (csn Z) N) (cfv (csn T) N)) $ >
  $ wi ph (wcel T (cdif V (csn c_0))) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn T) N)) $ >
  $ wi ph (wceq (cfv (cotp Y (cfv (cotp X F Y) I) T) I) (cfv (cotp Z (cfv (cotp X F Z) I) T) I)) $;

--| Part of Part (8) in [Baer] p. 48. (Contributed by NM, 13-May-2015.)
theorem mapdh8j {x3 h: setvar} (ph: wff x3) (C: class x3) (D: class) (Q: class h) (R T: class) (U: class x3) (F: class) (H: class x3 h) (I J: class) (K: class x3 h) (M c_mi N: class) (V: class x3) (W: class x3 h) (X Y c_0 Z: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq Q (cfv C c0g) $ >
  $ wceq J (cfv C clspn) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq I (cmpt x3 cvv (cif (wceq (cfv (cv x3) c2nd) c_0) Q (crio h (wa (wceq (cfv (cfv (csn (cfv (cv x3) c2nd)) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co (cfv (cfv (cv x3) c1st) c1st) (cfv (cv x3) c2nd) c_mi)) N) M) (cfv (csn (co (cfv (cfv (cv x3) c1st) c2nd) (cv h) R)) J))) D))) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn F) J)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel Z (cdif V (csn c_0))) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Z) N)) $ >
  $ wi ph (wne (cfv (csn Y) N) (cfv (csn T) N)) $ >
  $ wi ph (wne (cfv (csn Z) N) (cfv (csn T) N)) $ >
  $ wi ph (wcel T (cdif V (csn c_0))) $ >
  $ wi ph (wceq (cfv (cotp Y (cfv (cotp X F Y) I) T) I) (cfv (cotp Z (cfv (cotp X F Z) I) T) I)) $;

--| Part (8) in [Baer] p. 48. Given a reference vector ` X ` , the value of function ` I ` at a vector ` T ` is independent of the choice of auxiliary vectors ` Y ` and ` Z ` . Unlike Baer's, our version does not require ` X ` , ` Y ` , and ` Z ` to be independent, and also is defined for all ` Y ` and ` Z ` that are not colinear with ` X ` or ` T ` . We do this to make the definition of Baer's sigma function more straightforward. (This part eliminates ` T =/= .0. ` .) (Contributed by NM, 13-May-2015.)
theorem mapdh8 {x3 h: setvar} (ph: wff x3) (C: class x3) (D: class) (Q: class h) (R T: class) (U: class x3) (F: class) (H: class x3 h) (I J: class) (K: class x3 h) (M c_mi N: class) (V: class x3) (W: class x3 h) (X Y c_0 Z: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq Q (cfv C c0g) $ >
  $ wceq J (cfv C clspn) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq I (cmpt x3 cvv (cif (wceq (cfv (cv x3) c2nd) c_0) Q (crio h (wa (wceq (cfv (cfv (csn (cfv (cv x3) c2nd)) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co (cfv (cfv (cv x3) c1st) c1st) (cfv (cv x3) c2nd) c_mi)) N) M) (cfv (csn (co (cfv (cfv (cv x3) c1st) c2nd) (cv h) R)) J))) D))) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn F) J)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel Z (cdif V (csn c_0))) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Z) N)) $ >
  $ wi ph (wne (cfv (csn Y) N) (cfv (csn T) N)) $ >
  $ wi ph (wne (cfv (csn Z) N) (cfv (csn T) N)) $ >
  $ wi ph (wcel T V) $ >
  $ wi ph (wceq (cfv (cotp Y (cfv (cotp X F Y) I) T) I) (cfv (cotp Z (cfv (cotp X F Z) I) T) I)) $;

--| Lemma for part (9) in [Baer] p. 48. TODO: why is this 50% larger than ~ mapdh9aOLDN ? (Contributed by NM, 14-May-2015.)
theorem mapdh9a {x3 y1 z h: setvar} (ph: wff x3) (C: class x3 y1 z) (D: class) (Q: class y1 z h) (R: class y1 z) (T: class) (U: class x3 y1) (F: class) (H: class x3 y1 z h) (I: class) (J: class y1 z) (K: class x3 y1 z h) (M c_mi: class y1 z) (N: class) (V: class x3) (W: class x3 y1 z h) (X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq Q (cfv C c0g) $ >
  $ wceq J (cfv C clspn) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq I (cmpt x3 cvv (cif (wceq (cfv (cv x3) c2nd) c_0) Q (crio h (wa (wceq (cfv (cfv (csn (cfv (cv x3) c2nd)) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co (cfv (cfv (cv x3) c1st) c1st) (cfv (cv x3) c2nd) c_mi)) N) M) (cfv (csn (co (cfv (cfv (cv x3) c1st) c2nd) (cv h) R)) J))) D))) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn F) J)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel T V) $ >
  $ wi ph (wreu y1 (wral z (wi (wn (wcel (cv z) (cun (cfv (csn X) N) (cfv (csn T) N)))) (wceq (cv y1) (cfv (cotp (cv z) (cfv (cotp X F (cv z)) I) T) I))) V) D) $;

--| Lemma for part (9) in [Baer] p. 48. (Contributed by NM, 14-May-2015.) (New usage is discouraged.)
theorem mapdh9aOLDN {x3 y1 z h: setvar} (ph: wff x3) (C: class x3 y1 z) (D: class) (Q: class y1 z h) (R: class y1 z) (T: class) (U: class x3 y1) (F: class) (H: class x3 y1 z h) (I: class) (J: class y1 z) (K: class x3 y1 z h) (M c_mi: class y1 z) (N: class) (V: class x3) (W: class x3 y1 z h) (X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq Q (cfv C c0g) $ >
  $ wceq J (cfv C clspn) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq I (cmpt x3 cvv (cif (wceq (cfv (cv x3) c2nd) c_0) Q (crio h (wa (wceq (cfv (cfv (csn (cfv (cv x3) c2nd)) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co (cfv (cfv (cv x3) c1st) c1st) (cfv (cv x3) c2nd) c_mi)) N) M) (cfv (csn (co (cfv (cfv (cv x3) c1st) c2nd) (cv h) R)) J))) D))) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn F) J)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel T V) $ >
  $ wi ph (wreu y1 (wral z (wi (wn (wcel (cv z) (cfv (cpr X T) N))) (wceq (cv y1) (cfv (cotp (cv z) (cfv (cotp X F (cv z)) I) T) I))) V) D) $;

--| Extend class notation with preliminary map from vectors to functionals in the closed kernel dual space.
term chdma1: class;

--| Extend class notation with map from vectors to functionals in the closed kernel dual space.
term chdma: class;

--| Define preliminary map from vectors to functionals in the closed kernel dual space. See ~ hdmap1fval description for more details. (Contributed by NM, 14-May-2015.)
axiom df_hdmap1 {x3 w v u h j k m n a c d: setvar}:
  $ wceq chdma1 (cmpt k cvv (cmpt w (cfv (cv k) clh) (cab a (wsbc u (wsbc v (wsbc n (wsbc c (wsbc d (wsbc j (wsbc m (wcel (cv a) (cmpt x3 (cxp (cxp (cv v) (cv d)) (cv v)) (cif (wceq (cfv (cv x3) c2nd) (cfv (cv u) c0g)) (cfv (cv c) c0g) (crio h (wa (wceq (cfv (cfv (csn (cfv (cv x3) c2nd)) (cv n)) (cv m)) (cfv (csn (cv h)) (cv j))) (wceq (cfv (cfv (csn (co (cfv (cfv (cv x3) c1st) c1st) (cfv (cv x3) c2nd) (cfv (cv u) csg))) (cv n)) (cv m)) (cfv (csn (co (cfv (cfv (cv x3) c1st) c2nd) (cv h) (cfv (cv c) csg))) (cv j)))) (cv d))))) (cfv (cv w) (cfv (cv k) cmpd))) (cfv (cv c) clspn)) (cfv (cv c) cbs)) (cfv (cv w) (cfv (cv k) clcd))) (cfv (cv u) clspn)) (cfv (cv u) cbs)) (cfv (cv w) (cfv (cv k) cdvh)))))) $;

--| Define map from vectors to functionals in the closed kernel dual space. See ~ hdmapfval description for more details. (Contributed by NM, 15-May-2015.)
axiom df_hdmap {y1 z w v u t e i k a: setvar}:
  $ wceq chdma (cmpt k cvv (cmpt w (cfv (cv k) clh) (cab a (wsbc e (wsbc u (wsbc v (wsbc i (wcel (cv a) (cmpt t (cv v) (crio y1 (wral z (wi (wn (wcel (cv z) (cun (cfv (csn (cv e)) (cfv (cv u) clspn)) (cfv (csn (cv t)) (cfv (cv u) clspn))))) (wceq (cv y1) (cfv (cotp (cv z) (cfv (cotp (cv e) (cfv (cv e) (cfv (cv w) (cfv (cv k) chvm))) (cv z)) (cv i)) (cv t)) (cv i)))) (cv v)) (cfv (cfv (cv w) (cfv (cv k) clcd)) cbs)))) (cfv (cv w) (cfv (cv k) chdma1))) (cfv (cv u) cbs)) (cfv (cv w) (cfv (cv k) cdvh))) (cop (cres cid (cfv (cv k) cbs)) (cres cid (cfv (cv w) (cfv (cv k) cltrn)))))))) $;

--| Preliminary map from vectors to functionals in the closed kernel dual space. (Contributed by NM, 14-May-2015.)
theorem hdmap1ffval {x3 w v u h j m n a c d: setvar} (H: class x3 v u h j m n a c d) (K: class x3 h) (X: class x3 w v u h j m n a c d):
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K X) (wceq (cfv K chdma1) (cmpt w H (cab a (wsbc u (wsbc v (wsbc n (wsbc c (wsbc d (wsbc j (wsbc m (wcel (cv a) (cmpt x3 (cxp (cxp (cv v) (cv d)) (cv v)) (cif (wceq (cfv (cv x3) c2nd) (cfv (cv u) c0g)) (cfv (cv c) c0g) (crio h (wa (wceq (cfv (cfv (csn (cfv (cv x3) c2nd)) (cv n)) (cv m)) (cfv (csn (cv h)) (cv j))) (wceq (cfv (cfv (csn (co (cfv (cfv (cv x3) c1st) c1st) (cfv (cv x3) c2nd) (cfv (cv u) csg))) (cv n)) (cv m)) (cfv (csn (co (cfv (cfv (cv x3) c1st) c2nd) (cv h) (cfv (cv c) csg))) (cv j)))) (cv d))))) (cfv (cv w) (cfv K cmpd))) (cfv (cv c) clspn)) (cfv (cv c) cbs)) (cfv (cv w) (cfv K clcd))) (cfv (cv u) clspn)) (cfv (cv u) cbs)) (cfv (cv w) (cfv K cdvh)))))) $;

--| Preliminary map from vectors to functionals in the closed kernel dual space. TODO: change span ` J ` to the convention ` L ` for this section. (Contributed by NM, 15-May-2015.)
theorem hdmap1fval {x3 h: setvar} (ph: wff x3 h) (A2: class x3 h) (C D: class) (Q R: class x3 h) (U: class) (H I: class x3 h) (J: class) (K: class x3 h) (M: class) (c_mi: class x3 h) (N V: class) (W c_0: class x3 h):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq Q (cfv C c0g) $ >
  $ wceq J (cfv C clspn) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq I (cfv W (cfv K chdma1)) $ >
  $ wi ph (wa (wcel K A2) (wcel W H)) $ >
  $ wi ph (wceq I (cmpt x3 (cxp (cxp V D) V) (cif (wceq (cfv (cv x3) c2nd) c_0) Q (crio h (wa (wceq (cfv (cfv (csn (cfv (cv x3) c2nd)) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co (cfv (cfv (cv x3) c1st) c1st) (cfv (cv x3) c2nd) c_mi)) N) M) (cfv (csn (co (cfv (cfv (cv x3) c1st) c2nd) (cv h) R)) J))) D)))) $;

--| Value of preliminary map from vectors to functionals in the closed kernel dual space. (Contributed by NM, 15-May-2015.)
theorem hdmap1vallem {h: setvar} (ph: wff h) (A2: class h) (C D: class) (Q R: class h) (T U: class) (H I: class h) (J: class) (K: class h) (M: class) (c_mi: class h) (N V: class) (W c_0: class h):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq Q (cfv C c0g) $ >
  $ wceq J (cfv C clspn) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq I (cfv W (cfv K chdma1)) $ >
  $ wi ph (wa (wcel K A2) (wcel W H)) $ >
  $ wi ph (wcel T (cxp (cxp V D) V)) $ >
  $ wi ph (wceq (cfv T I) (cif (wceq (cfv T c2nd) c_0) Q (crio h (wa (wceq (cfv (cfv (csn (cfv T c2nd)) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co (cfv (cfv T c1st) c1st) (cfv T c2nd) c_mi)) N) M) (cfv (csn (co (cfv (cfv T c1st) c2nd) (cv h) R)) J))) D))) $;

--| Value of preliminary map from vectors to functionals in the closed kernel dual space. (Restatement of ~ mapdhval .) TODO: change ` I = ( x e. _V |-> ` ... to ` ( ph -> ( I `` <. X , F , Y > ) = ` ... in e.g. ~ mapdh8 to shorten proofs with no $d on ` x ` . (Contributed by NM, 15-May-2015.)
theorem hdmap1val {h: setvar} (ph: wff) (A2: class h) (C D: class) (Q R: class h) (U F: class) (H I: class h) (J: class) (K: class h) (M: class) (c_mi: class h) (N V: class) (W: class h) (X Y: class) (c_0: class h):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq Q (cfv C c0g) $ >
  $ wceq J (cfv C clspn) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq I (cfv W (cfv K chdma1)) $ >
  $ wi ph (wa (wcel K A2) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wceq (cfv (cotp X F Y) I) (cif (wceq Y c_0) Q (crio h (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co F (cv h) R)) J))) D))) $;

--| Value of preliminary map from vectors to functionals at zero. (Restated ~ mapdhval0 .) (Contributed by NM, 17-May-2015.)
theorem hdmap1val0 (ph: wff) (C D Q U F H I K V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq Q (cfv C c0g) $ >
  $ wceq I (cfv W (cfv K chdma1)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (cfv (cotp X F c_0) I) Q) $;

--| Value of preliminary map from vectors to functionals in the closed kernel dual space, for nonzero ` Y ` . (Contributed by NM, 16-May-2015.)
theorem hdmap1val2 {h: setvar} (ph: wff) (C D: class) (R: class h) (U F: class) (H I K: class h) (L M: class) (c_mi: class h) (N V: class) (W: class h) (X Y: class) (c_0: class h):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq L (cfv C clspn) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq I (cfv W (cfv K chdma1)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wceq (cfv (cotp X F Y) I) (crio h (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv h)) L)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co F (cv h) R)) L))) D)) $;

--| The defining equation for h(x,x',y)=y' in part (2) in [Baer] p. 45 line 24. (Contributed by NM, 16-May-2015.)
theorem hdmap1eq (ph: wff) (C D R U F G H I K L M c_mi N V W X Y c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq L (cfv C clspn) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq I (cfv W (cfv K chdma1)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel G D) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn F) L)) $ >
  $ wi ph (wb (wceq (cfv (cotp X F Y) I) G) (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn G) L)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co F G R)) L)))) $;

--| Frequently used lemma to change bound variables in ` L ` hypothesis. (Contributed by NM, 15-May-2015.)
theorem hdmap1cbv {x3 y1 h i: setvar} (D: class) (Q: class h i) (R J: class) (L: class x3 y1 h i) (M c_mi N: class) (c_0: class h i):
  $ wceq L (cmpt x3 cvv (cif (wceq (cfv (cv x3) c2nd) c_0) Q (crio h (wa (wceq (cfv (cfv (csn (cfv (cv x3) c2nd)) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co (cfv (cfv (cv x3) c1st) c1st) (cfv (cv x3) c2nd) c_mi)) N) M) (cfv (csn (co (cfv (cfv (cv x3) c1st) c2nd) (cv h) R)) J))) D))) $ >
  $ wceq L (cmpt y1 cvv (cif (wceq (cfv (cv y1) c2nd) c_0) Q (crio i (wa (wceq (cfv (cfv (csn (cfv (cv y1) c2nd)) N) M) (cfv (csn (cv i)) J)) (wceq (cfv (cfv (csn (co (cfv (cfv (cv y1) c1st) c1st) (cfv (cv y1) c2nd) c_mi)) N) M) (cfv (csn (co (cfv (cfv (cv y1) c1st) c2nd) (cv i) R)) J))) D))) $;

--| Connect the value of the preliminary map from vectors to functionals ` I ` to the hypothesis ` L ` used by earlier theorems. Note: the ` X e. ( V \ { .0. } ) ` hypothesis could be the more general ` X e. V ` but the former will be easier to use. TODO: use the ` I ` function directly in those theorems, so this theorem becomes unnecessary? TODO: The ~ hdmap1cbv is probably unnecessary, but it would mean different $d's later on. (Contributed by NM, 15-May-2015.)
theorem hdmap1valc {x3 h: setvar} (ph: wff x3 h) (C: class x3 h) (D: class) (Q: class h) (R: class) (U F H I: class x3 h) (J: class) (K L: class x3 h) (M c_mi N: class) (V W X Y: class x3 h) (c_0: class h):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq Q (cfv C c0g) $ >
  $ wceq J (cfv C clspn) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq I (cfv W (cfv K chdma1)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wcel Y V) $ >
  $ wceq L (cmpt x3 cvv (cif (wceq (cfv (cv x3) c2nd) c_0) Q (crio h (wa (wceq (cfv (cfv (csn (cfv (cv x3) c2nd)) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co (cfv (cfv (cv x3) c1st) c1st) (cfv (cv x3) c2nd) c_mi)) N) M) (cfv (csn (co (cfv (cfv (cv x3) c1st) c2nd) (cv h) R)) J))) D))) $ >
  $ wi ph (wceq (cfv (cotp X F Y) I) (cfv (cotp X F Y) L)) $;


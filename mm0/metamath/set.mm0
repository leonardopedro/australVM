  $ wceq E (co (co (cv p) (cv q) c_or) (co D (co (co (cv s1) (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq G (cmpt x3 B2 (cif (wa (wne (cv p) (cv q)) (wn (wbr (cv x3) W c_le))) (crio z (wral s1 (wi (wa (wn (wbr (cv s1) W c_le)) (wceq (co (cv s1) (co (cv x3) W c_an) c_or) (cv x3))) (wceq (cv z) (co (cif (wbr (cv s1) (co (cv p) (cv q) c_or) c_le) (crio y1 (wral t (wi (wa (wn (wbr (cv t) W c_le)) (wn (wbr (cv t) (co (cv p) (cv q) c_or) c_le))) (wceq (cv y1) E)) A2) B2) (csb t (cv s1) D)) (co (cv x3) W c_an) c_or))) A2) B2) (cv x3))) $ >
  $ wi (wceq F G) (wb ps ch) $ >

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (Proof shortened by Mario Carneiro, 22-Dec-2016.) (New usage is discouraged.)
theorem bnj1366 {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class) (B2: class x3 y1):
  $ wb ps (w3a (wcel A2 cvv) (wral x3 (weu y1 ph) A2) (wceq B2 (cab y1 (wrex x3 ph A2)))) $ >
  $ wi ps (wcel B2 cvv) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1379 {x3 y1 z f2 g2: setvar} (ph: wff x3 y1 z f2) (ps: wff f2 g2) (ch th ta: wff x3 y1 z f2 g2) (A2: class) (D: class y1 z f2 g2):
  $ wb ph (wral f2 (wfun (cv f2)) A2) $ >
  $ wceq D (cin (cdm (cv f2)) (cdm (cv g2))) $ >
  $ wb ps (wa ph (wral f2 (wral g2 (wceq (cres (cv f2) D) (cres (cv g2) D)) A2) A2)) $ >
  $ wb ch (w3a ps (wcel (cop (cv x3) (cv y1)) (cuni A2)) (wcel (cop (cv x3) (cv z)) (cuni A2))) $ >
  $ wb th (w3a ch (wcel (cv f2) A2) (wcel (cop (cv x3) (cv y1)) (cv f2))) $ >
  $ wb ta (w3a th (wcel (cv g2) A2) (wcel (cop (cv x3) (cv z)) (cv g2))) $ >
  $ wi ps (wfun (cuni A2)) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1383 {f2 g2: setvar} (ph: wff f2) (ps: wff f2 g2) (A2: class) (D: class f2 g2):
  $ wb ph (wral f2 (wfun (cv f2)) A2) $ >
  $ wceq D (cin (cdm (cv f2)) (cdm (cv g2))) $ >
  $ wb ps (wa ph (wral f2 (wral g2 (wceq (cres (cv f2) D) (cres (cv g2) D)) A2) A2)) $ >
  $ wi ps (wfun (cuni A2)) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1385 {x3 f2 g2 h: setvar} (ph ps: wff x3 f2 g2 h) (A2: class f2) (D: class x3 f2 g2) (E: class x3 g2 h) (bnjwphm: wff x3 f2 h) (bnjwpsm: wff x3 f2 g2 h):
  $ wb ph (wral f2 (wfun (cv f2)) A2) $ >
  $ wceq D (cin (cdm (cv f2)) (cdm (cv g2))) $ >
  $ wb ps (wa ph (wral f2 (wral g2 (wceq (cres (cv f2) D) (cres (cv g2) D)) A2) A2)) $ >
  $ wi (wcel (cv x3) A2) (wal f2 (wcel (cv x3) A2)) $ >
  $ wb bnjwphm (wral h (wfun (cv h)) A2) $ >
  $ wceq E (cin (cdm (cv h)) (cdm (cv g2))) $ >
  $ wb bnjwpsm (wa bnjwphm (wral h (wral g2 (wceq (cres (cv h) E) (cres (cv g2) E)) A2) A2)) $ >
  $ wi ps (wfun (cuni A2)) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1386 {x3 f2 g2: setvar} (ph ps: wff x3 f2 g2) (A2: class f2) (D: class x3 f2 g2):
  $ wb ph (wral f2 (wfun (cv f2)) A2) $ >
  $ wceq D (cin (cdm (cv f2)) (cdm (cv g2))) $ >
  $ wb ps (wa ph (wral f2 (wral g2 (wceq (cres (cv f2) D) (cres (cv g2) D)) A2) A2)) $ >
  $ wi (wcel (cv x3) A2) (wal f2 (wcel (cv x3) A2)) $ >
  $ wi ps (wfun (cuni A2)) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1397 {x3: setvar} (ph ps: wff x3):
  $ wi ph (wex x3 ps) $ >
  $ wi ps (wal x3 ps) $ >
  $ wi ph ps $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1400 {x3 y1: setvar} (A2: class x3):
  $ wi (wcel (cv y1) A2) (wal x3 (wcel (cv y1) A2)) $ >
  $ wceq (cdm (cuni A2)) (ciun x3 A2 (cdm (cv x3))) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1405 {y1: setvar} (ph: wff y1) (A2 B2: class y1) (X: class):
  $ wi ph (wcel X (ciun y1 A2 B2)) $ >
  $ wi ph (wrex y1 (wcel X B2) A2) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1422 (ph: wff) (A2 B2: class):
  $ wi ph (wfun A2) $ >
  $ wi ph (wceq (cdm A2) B2) $ >
  $ wi ph (wfn A2 B2) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1424 (A2 B2 C D: class):
  $ wceq A2 (cun B2 C) $ >
  $ wi (wcel D A2) (wo (wcel D B2) (wcel D C)) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1436 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wceq A2 (cab x3 ph) $ >
  $ wi (wcel (cv x3) A2) ph $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) Add disjoint variable condition to avoid ~ ax-13 . See ~ bnj1441g for a less restrictive version requiring more axioms. (Revised by GG, 20-Jan-2024.) (New usage is discouraged.)
theorem bnj1441 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class x3 y1 z):
  $ wi (wcel (cv x3) A2) (wal y1 (wcel (cv x3) A2)) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi (wcel (cv z) (crab x3 ph A2)) (wal y1 (wcel (cv z) (crab x3 ph A2))) $;

--| First-order logic and set theory. See ~ bnj1441 for a version with more disjoint variable conditions, but not requiring ~ ax-13 . (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1441g {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class x3 y1 z):
  $ wi (wcel (cv x3) A2) (wal y1 (wcel (cv x3) A2)) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi (wcel (cv z) (crab x3 ph A2)) (wal y1 (wcel (cv z) (crab x3 ph A2))) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1454 {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wceq A2 (cab x3 ph) $ >
  $ wi (wcel B2 cvv) (wb (wcel B2 A2) (wsbc x3 ph B2)) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1459 {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wb ps (wa ph (wcel (cv x3) A2)) $ >
  $ wi ps ch $ >
  $ wi ph (wral x3 ch A2) $;

--| Conversion of implicit substitution to explicit class substitution. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1464 {x3: setvar} (ph ps: wff x3) (A2 V: class):
  $ wi ps (wal x3 ps) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) ps) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1465 {x3: setvar} (ph ps ch: wff x3) (A2 V: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi ps (wal x3 ps) $ >
  $ wi ch ps $ >
  $ wi (wa ch (wcel A2 V)) (wex x3 ph) $;

--| Conversion of implicit substitution to explicit class substitution. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1468 {x3 y1: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wi ps (wal x3 ps) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel (cv y1) A2) (wal x3 (wcel (cv y1) A2)) $ >
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) ps) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1476 {x3: setvar} (ph ps: wff x3) (A2 D: class x3):
  $ wceq D (crab x3 (wn ph) A2) $ >
  $ wi ps (wceq D c0) $ >
  $ wi ps (wral x3 ph A2) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1502 (ph: wff) (A2 F G: class):
  $ wi ph (wfun F) $ >
  $ wi ph (wss G F) $ >
  $ wi ph (wcel A2 (cdm G)) $ >
  $ wi ph (wceq (cfv A2 F) (cfv A2 G)) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1503 (ph: wff) (A2 F G: class):
  $ wi ph (wfun F) $ >
  $ wi ph (wss G F) $ >
  $ wi ph (wss A2 (cdm G)) $ >
  $ wi ph (wceq (cres F A2) (cres G A2)) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1517 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wceq A2 (cab x3 (wa ph ps)) $ >
  $ wi (wcel (cv x3) A2) ps $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1521 {x3: setvar} (ph ch th: wff x3) (B2: class x3):
  $ wi ch (wrex x3 ph B2) $ >
  $ wb th (w3a ch (wcel (cv x3) B2) ph) $ >
  $ wi ch (wal x3 ch) $ >
  $ wi ch (wex x3 th) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1533 {z: setvar} (th: wff z) (A2 B2 C D E: class z):
  $ wi th (wral z (wn (wcel (cv z) D)) B2) $ >
  $ wss B2 A2 $ >
  $ wceq D (crab z (wne C E) A2) $ >
  $ wi th (wral z (wceq C E) B2) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1534 {x3 z w: setvar} (A2: class) (D: class x3 z w) (F: class x3) (H: class):
  $ wceq D (crab x3 (wne (cfv (cv x3) F) (cfv (cv x3) H)) A2) $ >
  $ wi (wcel (cv w) F) (wal x3 (wcel (cv w) F)) $ >
  $ wceq D (crab z (wne (cfv (cv z) F) (cfv (cv z) H)) A2) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1536 {x3: setvar} (ph: wff x3) (A2: class x3) (B2 F G: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wfn G A2) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wral x3 (wceq (cfv (cv x3) F) (cfv (cv x3) G)) B2) $ >
  $ wi ph (wceq (cres F B2) (cres G B2)) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1538 {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wceq A2 (crab x3 ph B2) $ >
  $ wi (wcel (cv x3) A2) ph $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1541 (ph ps: wff) (A2 B2: class):
  $ wb ph (wa ps (wne A2 B2)) $ >
  $ wn ph $ >
  $ wi ps (wceq A2 B2) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1542 {x3 w: setvar} (ph: wff x3 w) (A2: class w) (F: class x3) (G: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wfn G A2) $ >
  $ wi ph (wne F G) $ >
  $ wi (wcel (cv w) F) (wal x3 (wcel (cv w) F)) $ >
  $ wi ph (wrex x3 (wne (cfv (cv x3) F) (cfv (cv x3) G)) A2) $;

--| Well-founded induction restricted to a set ( ` A e. _V ` ). The proof has been taken from Chapter 4 of Don Monk's notes on Set Theory. See ~ http://euclid.colorado.edu/~~monkd/setth.pdf . (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj110 {x3 y1: setvar} (ph: wff x3) (ps: wff x3 y1) (A2 R: class):
  $ wcel A2 cvv $ >
  $ wb ps (wral y1 (wi (wbr (cv y1) (cv x3) R) (wsbc x3 ph (cv y1))) A2) $ >
  $ wi (wa (wfr A2 R) (wral x3 (wi ps ph) A2)) (wral x3 ph A2) $;

--| Well-founded induction restricted to a set ( ` A e. _V ` ). The proof has been taken from Chapter 4 of Don Monk's notes on Set Theory. See ~ http://euclid.colorado.edu/~~monkd/setth.pdf . (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj157 {x3 y1: setvar} (ph: wff x3) (ps: wff x3 y1) (A2 R: class):
  $ wb ps (wral y1 (wi (wbr (cv y1) (cv x3) R) (wsbc x3 ph (cv y1))) A2) $ >
  $ wcel A2 cvv $ >
  $ wfr A2 R $ >
  $ wi (wral x3 (wi ps ph) A2) (wral x3 ph A2) $;

--| Technical lemma for ~ bnj60 . This lemma may no longer be used or have become an indirect lemma of the theorem in question (i.e. a lemma of a lemma... of the theorem). (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj66 {x3 f2 g2 d: setvar} (A2: class x3 g2 d) (B2: class x3 d) (C: class x3 f2 g2 d) (R: class x3 g2 d) (G: class x3 d) (Y: class x3 f2 d):
  $ wceq B2 (cab d (wa (wss (cv d) A2) (wral x3 (wss (c_bnj14 A2 R (cv x3)) (cv d)) (cv d)))) $ >
  $ wceq Y (cop (cv x3) (cres (cv f2) (c_bnj14 A2 R (cv x3)))) $ >
  $ wceq C (cab f2 (wrex d (wa (wfn (cv f2) (cv d)) (wral x3 (wceq (cfv (cv x3) (cv f2)) (cfv Y G)) (cv d))) B2)) $ >
  $ wi (wcel (cv g2) C) (wrel (cv g2)) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj91 {x3 y1 f2: setvar} (ph: wff x3 y1 f2) (A2 R: class x3 f2) (Z: class x3 y1 f2):
  $ wb ph (wceq (cfv c0 (cv f2)) (c_bnj14 A2 R (cv x3))) $ >
  $ wcel Z cvv $ >
  $ wb (wsbc y1 ph Z) (wceq (cfv c0 (cv f2)) (c_bnj14 A2 R (cv x3))) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj92 {y1 f2 i n: setvar} (ps: wff y1 f2 i n) (A2 R: class y1 f2 i) (Z: class y1 f2 n):
  $ wb ps (wral i (wi (wcel (csuc (cv i)) (cv n)) (wceq (cfv (csuc (cv i)) (cv f2)) (ciun y1 (cfv (cv i) (cv f2)) (c_bnj14 A2 R (cv y1))))) com) $ >
  $ wcel Z cvv $ >
  $ wb (wsbc n ps Z) (wral i (wi (wcel (csuc (cv i)) Z) (wceq (cfv (csuc (cv i)) (cv f2)) (ciun y1 (cfv (cv i) (cv f2)) (c_bnj14 A2 R (cv y1))))) com) $;

--| Technical lemma for ~ bnj97 . This lemma may no longer be used or have become an indirect lemma of the theorem in question (i.e. a lemma of a lemma... of the theorem). (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj93 {x3: setvar} (A2 R: class):
  $ wi (wa (w_bnj15 A2 R) (wcel (cv x3) A2)) (wcel (c_bnj14 A2 R (cv x3)) cvv) $;

--| Technical lemma for ~ bnj124 . This lemma may no longer be used or have become an indirect lemma of the theorem in question (i.e. a lemma of a lemma... of the theorem). (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj95 {x3: setvar} (A2 R F: class x3):
  $ wceq F (csn (cop c0 (c_bnj14 A2 R (cv x3)))) $ >
  $ wcel F cvv $;

--| Technical lemma for ~ bnj150 . This lemma may no longer be used or have become an indirect lemma of the theorem in question (i.e. a lemma of a lemma... of the theorem). (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (Revised by Mario Carneiro, 6-May-2015.) (New usage is discouraged.)
theorem bnj96 {x3: setvar} (A2 R: class) (F: class x3):
  $ wceq F (csn (cop c0 (c_bnj14 A2 R (cv x3)))) $ >
  $ wi (wa (w_bnj15 A2 R) (wcel (cv x3) A2)) (wceq (cdm F) c1o) $;

--| Technical lemma for ~ bnj150 . This lemma may no longer be used or have become an indirect lemma of the theorem in question (i.e. a lemma of a lemma... of the theorem). (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj97 {x3: setvar} (A2 R: class) (F: class x3):
  $ wceq F (csn (cop c0 (c_bnj14 A2 R (cv x3)))) $ >
  $ wi (wa (w_bnj15 A2 R) (wcel (cv x3) A2)) (wceq (cfv c0 F) (c_bnj14 A2 R (cv x3))) $;

--| Technical lemma for ~ bnj150 . This lemma may no longer be used or have become an indirect lemma of the theorem in question (i.e. a lemma of a lemma... of the theorem). (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj98 {y1 i: setvar} (A2 R F: class y1 i):
  $ wral i (wi (wcel (csuc (cv i)) c1o) (wceq (cfv (csuc (cv i)) F) (ciun y1 (cfv (cv i) F) (c_bnj14 A2 R (cv y1))))) com $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj106 {y1 f2 i n: setvar} (ps: wff y1 f2 i n) (A2 R: class y1 i) (F: class n):
  $ wb ps (wral i (wi (wcel (csuc (cv i)) (cv n)) (wceq (cfv (csuc (cv i)) (cv f2)) (ciun y1 (cfv (cv i) (cv f2)) (c_bnj14 A2 R (cv y1))))) com) $ >
  $ wcel F cvv $ >
  $ wb (wsbc f2 (wsbc n ps c1o) F) (wral i (wi (wcel (csuc (cv i)) c1o) (wceq (cfv (csuc (cv i)) F) (ciun y1 (cfv (cv i) F) (c_bnj14 A2 R (cv y1))))) com) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj118 {x3 f2 n: setvar} (ph: wff x3 f2 n) (A2 R: class x3 f2) (bnjwphm: wff x3 f2 n):
  $ wb ph (wceq (cfv c0 (cv f2)) (c_bnj14 A2 R (cv x3))) $ >
  $ wb bnjwphm (wsbc n ph c1o) $ >
  $ wb bnjwphm (wceq (cfv c0 (cv f2)) (c_bnj14 A2 R (cv x3))) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj121 {x3 f2 n: setvar} (ph ps ze: wff x3 f2 n) (A2 R: class x3 f2) (bnjwphm bnjwpsm bnjwzem: wff x3 f2 n):
  $ wb ze (wi (wa (w_bnj15 A2 R) (wcel (cv x3) A2)) (w3a (wfn (cv f2) (cv n)) ph ps)) $ >
  $ wb bnjwzem (wsbc n ze c1o) $ >
  $ wb bnjwphm (wsbc n ph c1o) $ >
  $ wb bnjwpsm (wsbc n ps c1o) $ >
  $ wb bnjwzem (wi (wa (w_bnj15 A2 R) (wcel (cv x3) A2)) (w3a (wfn (cv f2) c1o) bnjwphm bnjwpsm)) $;

--| Technical lemma for ~ bnj150 . This lemma may no longer be used or have become an indirect lemma of the theorem in question (i.e. a lemma of a lemma... of the theorem). (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (Proof shortened by Mario Carneiro, 22-Dec-2016.) (New usage is discouraged.)
theorem bnj124 {x3 f2: setvar} (A2 R: class x3) (F: class x3 f2) (bnjwphm bnjwpsm bnjwzem bnjwphn bnjwpsn bnjwzen: wff x3 f2):
  $ wceq F (csn (cop c0 (c_bnj14 A2 R (cv x3)))) $ >
  $ wb bnjwphn (wsbc f2 bnjwphm F) $ >
  $ wb bnjwpsn (wsbc f2 bnjwpsm F) $ >
  $ wb bnjwzen (wsbc f2 bnjwzem F) $ >
  $ wb bnjwzem (wi (wa (w_bnj15 A2 R) (wcel (cv x3) A2)) (w3a (wfn (cv f2) c1o) bnjwphm bnjwpsm)) $ >
  $ wb bnjwzen (wi (wa (w_bnj15 A2 R) (wcel (cv x3) A2)) (w3a (wfn F c1o) bnjwphn bnjwpsn)) $;

--| Technical lemma for ~ bnj150 . This lemma may no longer be used or have become an indirect lemma of the theorem in question (i.e. a lemma of a lemma... of the theorem). (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj125 {x3 f2 n: setvar} (ph: wff x3 f2 n) (A2 R: class x3) (F: class x3 n) (bnjwphm bnjwphn: wff x3 f2 n):
  $ wb ph (wceq (cfv c0 (cv f2)) (c_bnj14 A2 R (cv x3))) $ >
  $ wb bnjwphm (wsbc n ph c1o) $ >
  $ wb bnjwphn (wsbc f2 bnjwphm F) $ >
  $ wceq F (csn (cop c0 (c_bnj14 A2 R (cv x3)))) $ >
  $ wb bnjwphn (wceq (cfv c0 F) (c_bnj14 A2 R (cv x3))) $;

--| Technical lemma for ~ bnj150 . This lemma may no longer be used or have become an indirect lemma of the theorem in question (i.e. a lemma of a lemma... of the theorem). (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj126 {x3 y1 f2 i n: setvar} (ps: wff x3 y1 f2 i n) (A2 R: class x3 y1 i) (F: class x3 n) (bnjwpsm bnjwpsn: wff x3 y1 f2 i n):
  $ wb ps (wral i (wi (wcel (csuc (cv i)) (cv n)) (wceq (cfv (csuc (cv i)) (cv f2)) (ciun y1 (cfv (cv i) (cv f2)) (c_bnj14 A2 R (cv y1))))) com) $ >
  $ wb bnjwpsm (wsbc n ps c1o) $ >
  $ wb bnjwpsn (wsbc f2 bnjwpsm F) $ >
  $ wceq F (csn (cop c0 (c_bnj14 A2 R (cv x3)))) $ >
  $ wb bnjwpsn (wral i (wi (wcel (csuc (cv i)) c1o) (wceq (cfv (csuc (cv i)) F) (ciun y1 (cfv (cv i) F) (c_bnj14 A2 R (cv y1))))) com) $;

--| Technical lemma for ~ bnj151 . This lemma may no longer be used or have become an indirect lemma of the theorem in question (i.e. a lemma of a lemma... of the theorem). (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj130 {x3 f2 n: setvar} (ph ps th: wff x3 f2 n) (A2 R: class x3 f2) (bnjwphm bnjwpsm bnjwthm: wff x3 f2 n):
  $ wb th (wi (wa (w_bnj15 A2 R) (wcel (cv x3) A2)) (weu f2 (w3a (wfn (cv f2) (cv n)) ph ps))) $ >
  $ wb bnjwphm (wsbc n ph c1o) $ >
  $ wb bnjwpsm (wsbc n ps c1o) $ >
  $ wb bnjwthm (wsbc n th c1o) $ >

theorem _1lt10:
  $ wbr c1 c10 clt $;

--| 0 is not equal to 2. (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem _0ne2:
  $ wne cc0 c2 $;

--| 1 is not equal to 2. (Contributed by NM, 19-Oct-2012.)
theorem _1ne2:
  $ wne c1 c2 $;

--| 1 is less than or equal to 2 (common case). (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem _1le2:
  $ wbr c1 c2 cle $;

--| 2 is a nonzero complex number (common case). (Contributed by David A. Wheeler, 7-Dec-2018.)
theorem _2cnne0:
  $ wa (wcel c2 cc) (wne c2 cc0) $;

--| 2 is a nonzero real number (common case). (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem _2rene0:
  $ wa (wcel c2 cr) (wne c2 cc0) $;

--| 1 is less than or equal to 3. (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem _1le3:
  $ wbr c1 c3 cle $;

--| ` -u 1 x. -u 1 ` is 1 (common case). (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem neg1mulneg1e1:
  $ wceq (co (cneg c1) (cneg c1) cmul) c1 $;

--| One-half is real. (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem halfre:
  $ wcel (co c1 c2 cdiv) cr $;

--| One-half is complex. (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem halfcn:
  $ wcel (co c1 c2 cdiv) cc $;

--| One-half is greater than zero. (Contributed by NM, 24-Feb-2005.)
theorem halfgt0:
  $ wbr cc0 (co c1 c2 cdiv) clt $;

--| One-half is not negative. (Contributed by AV, 7-Jun-2020.)
theorem halfge0:
  $ wbr cc0 (co c1 c2 cdiv) cle $;

--| One-half is less than one. (Contributed by NM, 24-Feb-2005.)
theorem halflt1:
  $ wbr (co c1 c2 cdiv) c1 clt $;

--| Prove that 1 - 1/2 = 1/2. (Contributed by David A. Wheeler, 4-Jan-2017.)
theorem _1mhlfehlf:
  $ wceq (co c1 (co c1 c2 cdiv) cmin) (co c1 c2 cdiv) $;

--| An eighth of four thirds is a sixth. (Contributed by Paul Chapman, 24-Nov-2007.)
theorem _8th4div3:
  $ wceq (co (co c1 c8 cdiv) (co c4 c3 cdiv) cmul) (co c1 c6 cdiv) $;

--| One half plus or minus one sixth. (Contributed by Paul Chapman, 17-Jan-2008.)
theorem halfpm6th:
  $ wa (wceq (co (co c1 c2 cdiv) (co c1 c6 cdiv) cmin) (co c1 c3 cdiv)) (wceq (co (co c1 c2 cdiv) (co c1 c6 cdiv) caddc) (co c2 c3 cdiv)) $;

--| i times 0 equals 0 (common case). (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem it0e0:
  $ wceq (co ci cc0 cmul) cc0 $;

--| ` ( 2 x. _i ) e. CC ` (common case). (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem _2mulicn:
  $ wcel (co c2 ci cmul) cc $;

--| The imaginary unit ` _i ` is apart from zero. (Contributed by Jim Kingdon, 9-Mar-2020.)
theorem iap0:
  $ wbr ci cc0 cap $;

--| ` 2 x. _i ` is apart from zero. (Contributed by Jim Kingdon, 9-Mar-2020.)
theorem _2muliap0:
  $ wbr (co c2 ci cmul) cc0 cap $;

--| ` ( 2 x. _i ) =/= 0 ` . See also ~ 2muliap0 . (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem _2muline0:
  $ wne (co c2 ci cmul) cc0 $;

--| Closure of half of a number (common case). (Contributed by NM, 1-Jan-2006.)
theorem halfcl (A2: class):
  $ wi (wcel A2 cc) (wcel (co A2 c2 cdiv) cc) $;

--| Real closure of half. (Contributed by NM, 1-Jan-2006.)
theorem rehalfcl (A2: class):
  $ wi (wcel A2 cr) (wcel (co A2 c2 cdiv) cr) $;

--| Half of a number is zero iff the number is zero. (Contributed by NM, 20-Apr-2006.)
theorem half0 (A2: class):
  $ wi (wcel A2 cc) (wb (wceq (co A2 c2 cdiv) cc0) (wceq A2 cc0)) $;

--| Two halves make a whole. (Contributed by NM, 11-Apr-2005.)
theorem _2halves (A2: class):
  $ wi (wcel A2 cc) (wceq (co (co A2 c2 cdiv) (co A2 c2 cdiv) caddc) A2) $;

--| A number is positive iff its half is positive. (Contributed by NM, 10-Apr-2005.)
theorem halfpos2 (A2: class):
  $ wi (wcel A2 cr) (wb (wbr cc0 A2 clt) (wbr cc0 (co A2 c2 cdiv) clt)) $;

--| A positive number is greater than its half. (Contributed by NM, 28-Oct-2004.) (Proof shortened by Mario Carneiro, 27-May-2016.)
theorem halfpos (A2: class):
  $ wi (wcel A2 cr) (wb (wbr cc0 A2 clt) (wbr (co A2 c2 cdiv) A2 clt)) $;

--| A number is nonnegative iff its half is nonnegative. (Contributed by NM, 9-Dec-2005.)
theorem halfnneg2 (A2: class):
  $ wi (wcel A2 cr) (wb (wbr cc0 A2 cle) (wbr cc0 (co A2 c2 cdiv) cle)) $;

--| Closure of half-sum and half-difference. (Contributed by Paul Chapman, 12-Oct-2007.)
theorem halfaddsubcl (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wa (wcel (co (co A2 B2 caddc) c2 cdiv) cc) (wcel (co (co A2 B2 cmin) c2 cdiv) cc)) $;

--| Sum and difference of half-sum and half-difference. (Contributed by Paul Chapman, 12-Oct-2007.)
theorem halfaddsub (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wa (wceq (co (co (co A2 B2 caddc) c2 cdiv) (co (co A2 B2 cmin) c2 cdiv) caddc) A2) (wceq (co (co (co A2 B2 caddc) c2 cdiv) (co (co A2 B2 cmin) c2 cdiv) cmin) B2)) $;

--| A sum is less than the whole if each term is less than half. (Contributed by NM, 13-Dec-2006.)
theorem lt2halves (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wi (wa (wbr A2 (co C c2 cdiv) clt) (wbr B2 (co C c2 cdiv) clt)) (wbr (co A2 B2 caddc) C clt)) $;

--| Sum is less than product for numbers greater than 2. (Contributed by Stefan Allan, 24-Sep-2010.)
theorem addltmul (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wcel B2 cr)) (wa (wbr c2 A2 clt) (wbr c2 B2 clt))) (wbr (co A2 B2 caddc) (co A2 B2 cmul) clt) $;

--| There is no smallest positive real number. (Contributed by NM, 28-Oct-2004.)
theorem nominpos {x3 y1: setvar}:
  $ wn (wrex x3 (wa (wbr cc0 (cv x3) clt) (wn (wrex y1 (wa (wbr cc0 (cv y1) clt) (wbr (cv y1) (cv x3) clt)) cr))) cr) $;

--| Ordering property for average. (Contributed by Mario Carneiro, 28-May-2014.)
theorem avglt1 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr A2 B2 clt) (wbr A2 (co (co A2 B2 caddc) c2 cdiv) clt)) $;

--| Ordering property for average. (Contributed by Mario Carneiro, 28-May-2014.)
theorem avglt2 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr A2 B2 clt) (wbr (co (co A2 B2 caddc) c2 cdiv) B2 clt)) $;

--| Ordering property for average. (Contributed by Mario Carneiro, 28-May-2014.)
theorem avgle1 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr A2 B2 cle) (wbr A2 (co (co A2 B2 caddc) c2 cdiv) cle)) $;

--| Ordering property for average. (Contributed by Jeff Hankins, 15-Sep-2013.) (Revised by Mario Carneiro, 28-May-2014.)
theorem avgle2 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr A2 B2 cle) (wbr (co (co A2 B2 caddc) c2 cdiv) B2 cle)) $;

--| Two times a number. (Contributed by Mario Carneiro, 27-May-2016.)
theorem _2timesd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co c2 A2 cmul) (co A2 A2 caddc)) $;

--| A number times 2. (Contributed by Mario Carneiro, 27-May-2016.)
theorem times2d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co A2 c2 cmul) (co A2 A2 caddc)) $;

--| Closure of half of a number (frequently used special case). (Contributed by Mario Carneiro, 27-May-2016.)
theorem halfcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel (co A2 c2 cdiv) cc) $;

--| Two halves make a whole. (Contributed by Mario Carneiro, 27-May-2016.)
theorem _2halvesd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co (co A2 c2 cdiv) (co A2 c2 cdiv) caddc) A2) $;

--| Real closure of half. (Contributed by Mario Carneiro, 27-May-2016.)
theorem rehalfcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel (co A2 c2 cdiv) cr) $;

--| A sum is less than the whole if each term is less than half. (Contributed by Mario Carneiro, 27-May-2016.)
theorem lt2halvesd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wbr A2 (co C c2 cdiv) clt) $ >
  $ wi ph (wbr B2 (co C c2 cdiv) clt) $ >
  $ wi ph (wbr (co A2 B2 caddc) C clt) $;

--| Half a real number is real. Inference form. (Contributed by David Moews, 28-Feb-2017.)
theorem rehalfcli (A2: class):
  $ wcel A2 cr $ >
  $ wcel (co A2 c2 cdiv) cr $;

--| Adding two times 1 to a number. (Contributed by AV, 22-Sep-2018.)
theorem add1p1 (N: class):
  $ wi (wcel N cc) (wceq (co (co N c1 caddc) c1 caddc) (co N c2 caddc)) $;

--| Subtracting two times 1 from a number. (Contributed by AV, 23-Oct-2018.)
theorem sub1m1 (N: class):
  $ wi (wcel N cc) (wceq (co (co N c1 cmin) c1 cmin) (co N c2 cmin)) $;

--| Subtracting 2 and afterwards 1 from a number results in the difference between the number and 3. (Contributed by Alexander van der Vekens, 16-Sep-2018.)
theorem cnm2m1cnm3 (A2: class):
  $ wi (wcel A2 cc) (wceq (co (co A2 c2 cmin) c1 cmin) (co A2 c3 cmin)) $;

--| An integer greater than 5, divided by 4 and increased by 1, is less than or equal to the half of the integer minus 1. (Contributed by AV, 8-Jul-2021.)
theorem div4p1lem1div2 (N: class):
  $ wi (wa (wcel N cr) (wbr c6 N cle)) (wbr (co (co N c4 cdiv) c1 caddc) (co (co N c1 cmin) c2 cdiv) cle) $;

--| Archimedean property of real numbers. For any real number, there is an integer greater than it. Theorem I.29 of [Apostol] p. 26. (Contributed by NM, 21-Jan-1997.)
theorem arch {n: setvar} (A2: class):
  $ wi (wcel A2 cr) (wrex n (wbr A2 (cv n) clt) cn) $;

--| There exists a positive integer whose reciprocal is less than a given positive real. Exercise 3 of [Apostol] p. 28. (Contributed by NM, 8-Nov-2004.)
theorem nnrecl {n: setvar} (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 clt)) (wrex n (wbr (co c1 (cv n) cdiv) A2 clt) cn) $;

--| A bounded real sequence ` A ( k ) ` is less than or equal to at least one of its indices. (Contributed by NM, 18-Jan-2008.)
theorem bndndx {x3 k: setvar} (A2: class k):
  $ wi (wrex x3 (wral k (wa (wcel A2 cr) (wbr A2 (cv x3) cle)) cn) cr) (wrex k (wbr A2 (cv k) cle) cn) $;

--| Extend class notation to include the class of nonnegative integers.
term cn0: class;

--| Define the set of nonnegative integers. (Contributed by Raph Levien, 10-Dec-2002.)
axiom df_n0:
  $ wceq cn0 (cun cn (csn cc0)) $;

--| Nonnegative integers expressed in terms of naturals and zero. (Contributed by Raph Levien, 10-Dec-2002.)
theorem elnn0 (A2: class):
  $ wb (wcel A2 cn0) (wo (wcel A2 cn) (wceq A2 cc0)) $;

--| Positive naturals are a subset of nonnegative integers. (Contributed by Raph Levien, 10-Dec-2002.)
theorem nnssnn0:
  $ wss cn cn0 $;

--| Nonnegative integers are a subset of the reals. (Contributed by Raph Levien, 10-Dec-2002.)
theorem nn0ssre:
  $ wss cn0 cr $;

--| Nonnegative integers are a subset of the complex numbers.) (Contributed by NM, 9-May-2004.)
theorem nn0sscn:
  $ wss cn0 cc $;

--| The set of nonnegative integers exists. (Contributed by NM, 18-Jul-2004.)
theorem nn0ex:
  $ wcel cn0 cvv $;

--| A positive integer is a nonnegative integer. (Contributed by NM, 9-May-2004.)
theorem nnnn0 (A2: class):
  $ wi (wcel A2 cn) (wcel A2 cn0) $;

--| A positive integer is a nonnegative integer. (Contributed by NM, 20-Jun-2005.)
theorem nnnn0i (N: class):
  $ wcel N cn $ >
  $ wcel N cn0 $;

--| A nonnegative integer is a real number. (Contributed by NM, 9-May-2004.)
theorem nn0re (A2: class):
  $ wi (wcel A2 cn0) (wcel A2 cr) $;

--| A nonnegative integer is a complex number. (Contributed by NM, 9-May-2004.)
theorem nn0cn (A2: class):
  $ wi (wcel A2 cn0) (wcel A2 cc) $;

--| A nonnegative integer is a real number. (Contributed by NM, 14-May-2003.)
theorem nn0rei (A2: class):
  $ wcel A2 cn0 $ >
  $ wcel A2 cr $;

--| A nonnegative integer is a complex number. (Contributed by NM, 14-May-2003.)
theorem nn0cni (A2: class):
  $ wcel A2 cn0 $ >
  $ wcel A2 cc $;

--| The set of positive integers defined in terms of nonnegative integers. (Contributed by NM, 23-Sep-2007.) (Proof shortened by Mario Carneiro, 13-Feb-2013.)
theorem dfn2:
  $ wceq cn (cdif cn0 (csn cc0)) $;

--| The positive integer property expressed in terms of difference from zero. (Contributed by Stefan O'Rear, 12-Sep-2015.)
theorem elnnne0 (N: class):
  $ wb (wcel N cn) (wa (wcel N cn0) (wne N cc0)) $;

--| 0 is a nonnegative integer. (Contributed by Raph Levien, 10-Dec-2002.)
theorem _0nn0:
  $ wcel cc0 cn0 $;

--| 1 is a nonnegative integer. (Contributed by Raph Levien, 10-Dec-2002.)
theorem _1nn0:
  $ wcel c1 cn0 $;

--| 2 is a nonnegative integer. (Contributed by Raph Levien, 10-Dec-2002.)
theorem _2nn0:
  $ wcel c2 cn0 $;

--| 3 is a nonnegative integer. (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem _3nn0:
  $ wcel c3 cn0 $;

--| 4 is a nonnegative integer. (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem _4nn0:
  $ wcel c4 cn0 $;

--| 5 is a nonnegative integer. (Contributed by Mario Carneiro, 19-Apr-2015.)
theorem _5nn0:
  $ wcel c5 cn0 $;

--| 6 is a nonnegative integer. (Contributed by Mario Carneiro, 19-Apr-2015.)
theorem _6nn0:
  $ wcel c6 cn0 $;

--| 7 is a nonnegative integer. (Contributed by Mario Carneiro, 19-Apr-2015.)
theorem _7nn0:
  $ wcel c7 cn0 $;

--| 8 is a nonnegative integer. (Contributed by Mario Carneiro, 19-Apr-2015.)
theorem _8nn0:
  $ wcel c8 cn0 $;

--| 9 is a nonnegative integer. (Contributed by Mario Carneiro, 19-Apr-2015.)
theorem _9nn0:
  $ wcel c9 cn0 $;

--| 10 is a nonnegative integer. (Contributed by Mario Carneiro, 19-Apr-2015.)
theorem _10nn0:
  $ wcel c10 cn0 $;

--| A nonnegative integer is greater than or equal to zero. (Contributed by NM, 9-May-2004.) (Revised by Mario Carneiro, 16-May-2014.)
theorem nn0ge0 (N: class):
  $ wi (wcel N cn0) (wbr cc0 N cle) $;

--| A nonnegative integer is not less than zero. (Contributed by NM, 9-May-2004.) (Revised by Mario Carneiro, 27-May-2016.)
theorem nn0nlt0 (A2: class):
  $ wi (wcel A2 cn0) (wn (wbr A2 cc0 clt)) $;

--| Nonnegative integers are nonnegative. (Contributed by Raph Levien, 10-Dec-2002.)
theorem nn0ge0i (N: class):
  $ wcel N cn0 $ >
  $ wbr cc0 N cle $;

--| A nonnegative integer is less than or equal to zero iff it is equal to zero. (Contributed by NM, 9-Dec-2005.)
theorem nn0le0eq0 (N: class):
  $ wi (wcel N cn0) (wb (wbr N cc0 cle) (wceq N cc0)) $;

--| A nonnegative integer increased by 1 is greater than 0. (Contributed by Alexander van der Vekens, 3-Oct-2018.)
theorem nn0p1gt0 (N: class):
  $ wi (wcel N cn0) (wbr cc0 (co N c1 caddc) clt) $;

--| A positive integer plus a nonnegative integer is a positive integer. (Contributed by NM, 20-Apr-2005.) (Proof shortened by Mario Carneiro, 16-May-2014.)
theorem nnnn0addcl (M N: class):
  $ wi (wa (wcel M cn) (wcel N cn0)) (wcel (co M N caddc) cn) $;

--| A nonnegative integer plus a positive integer is a positive integer. (Contributed by NM, 22-Dec-2005.)
theorem nn0nnaddcl (M N: class):
  $ wi (wa (wcel M cn0) (wcel N cn)) (wcel (co M N caddc) cn) $;

--| The result of subtracting a positive integer from 0 is not a nonnegative integer. (Contributed by Alexander van der Vekens, 19-Mar-2018.)
theorem _0mnnnnn0 (N: class):
  $ wi (wcel N cn) (wnel (co cc0 N cmin) cn0) $;

--| If ` S ` is closed under addition, then so is ` S u. { 0 } ` . (Contributed by Mario Carneiro, 17-Jul-2014.)
theorem un0addcl (ph: wff) (S T M N: class):
  $ wi ph (wss S cc) $ >
  $ wceq T (cun S (csn cc0)) $ >
  $ wi (wa ph (wa (wcel M S) (wcel N S))) (wcel (co M N caddc) S) $ >
  $ wi (wa ph (wa (wcel M T) (wcel N T))) (wcel (co M N caddc) T) $;

--| If ` S ` is closed under multiplication, then so is ` S u. { 0 } ` . (Contributed by Mario Carneiro, 17-Jul-2014.)
theorem un0mulcl (ph: wff) (S T M N: class):
  $ wi ph (wss S cc) $ >
  $ wceq T (cun S (csn cc0)) $ >
  $ wi (wa ph (wa (wcel M S) (wcel N S))) (wcel (co M N cmul) S) $ >
  $ wi (wa ph (wa (wcel M T) (wcel N T))) (wcel (co M N cmul) T) $;

--| Closure of addition of nonnegative integers. (Contributed by Raph Levien, 10-Dec-2002.) (Proof shortened by Mario Carneiro, 17-Jul-2014.)
theorem nn0addcl (M N: class):
  $ wi (wa (wcel M cn0) (wcel N cn0)) (wcel (co M N caddc) cn0) $;

--| Closure of multiplication of nonnegative integers. (Contributed by NM, 22-Jul-2004.) (Proof shortened by Mario Carneiro, 17-Jul-2014.)
theorem nn0mulcl (M N: class):
  $ wi (wa (wcel M cn0) (wcel N cn0)) (wcel (co M N cmul) cn0) $;

--| Closure of addition of nonnegative integers, inference form. (Contributed by Raph Levien, 10-Dec-2002.)
theorem nn0addcli (M N: class):
  $ wcel M cn0 $ >
  $ wcel N cn0 $ >
  $ wcel (co M N caddc) cn0 $;

--| Closure of multiplication of nonnegative integers, inference form. (Contributed by Raph Levien, 10-Dec-2002.)
theorem nn0mulcli (M N: class):
  $ wcel M cn0 $ >
  $ wcel N cn0 $ >
  $ wcel (co M N cmul) cn0 $;

--| A nonnegative integer plus 1 is a positive integer. (Contributed by Raph Levien, 30-Jun-2006.) (Revised by Mario Carneiro, 16-May-2014.)
theorem nn0p1nn (N: class):
  $ wi (wcel N cn0) (wcel (co N c1 caddc) cn) $;

--| Second Peano postulate for nonnegative integers. (Contributed by NM, 9-May-2004.)
theorem peano2nn0 (N: class):
  $ wi (wcel N cn0) (wcel (co N c1 caddc) cn0) $;

--| A positive integer minus 1 is a nonnegative integer. (Contributed by Jason Orendorff, 24-Jan-2007.) (Revised by Mario Carneiro, 16-May-2014.)
theorem nnm1nn0 (N: class):
  $ wi (wcel N cn) (wcel (co N c1 cmin) cn0) $;

--| The nonnegative integer property expressed in terms of positive integers. (Contributed by NM, 10-May-2004.) (Proof shortened by Mario Carneiro, 16-May-2014.)
theorem elnn0nn (N: class):
  $ wb (wcel N cn0) (wa (wcel N cc) (wcel (co N c1 caddc) cn)) $;

--| The positive integer property expressed in terms of nonnegative integers. (Contributed by NM, 10-May-2004.)
theorem elnnnn0 (N: class):
  $ wb (wcel N cn) (wa (wcel N cc) (wcel (co N c1 cmin) cn0)) $;

--| The positive integer property expressed in terms of nonnegative integers. (Contributed by NM, 1-Sep-2005.)
theorem elnnnn0b (N: class):
  $ wb (wcel N cn) (wa (wcel N cn0) (wbr cc0 N clt)) $;

--| The positive integer property expressed in terms of nonnegative integers. (Contributed by NM, 10-Jan-2006.)
theorem elnnnn0c (N: class):
  $ wb (wcel N cn) (wa (wcel N cn0) (wbr c1 N cle)) $;

--| A number is less than or equal to itself plus a nonnegative integer. (Contributed by NM, 10-Mar-2005.)
theorem nn0addge1 (A2 N: class):
  $ wi (wa (wcel A2 cr) (wcel N cn0)) (wbr A2 (co A2 N caddc) cle) $;

--| A number is less than or equal to itself plus a nonnegative integer. (Contributed by NM, 10-Mar-2005.)
theorem nn0addge2 (A2 N: class):
  $ wi (wa (wcel A2 cr) (wcel N cn0)) (wbr A2 (co N A2 caddc) cle) $;

--| A number is less than or equal to itself plus a nonnegative integer. (Contributed by NM, 10-Mar-2005.)
theorem nn0addge1i (A2 N: class):
  $ wcel A2 cr $ >
  $ wcel N cn0 $ >
  $ wbr A2 (co A2 N caddc) cle $;

--| A number is less than or equal to itself plus a nonnegative integer. (Contributed by NM, 10-Mar-2005.)
theorem nn0addge2i (A2 N: class):
  $ wcel A2 cr $ >
  $ wcel N cn0 $ >
  $ wbr A2 (co N A2 caddc) cle $;

--| A nonnegative integer is less than or equal to twice itself. (Contributed by Raph Levien, 10-Dec-2002.)
theorem nn0le2xi (N: class):
  $ wcel N cn0 $ >
  $ wbr N (co c2 N cmul) cle $;

--| 'Less than or equal to' implies 'less than or equal to twice' for nonnegative integers. (Contributed by Raph Levien, 10-Dec-2002.)
theorem nn0lele2xi (M N: class):
  $ wcel M cn0 $ >
  $ wcel N cn0 $ >
  $ wi (wbr N M cle) (wbr N (co c2 M cmul) cle) $;

--| Two ways to write the support of a function on ` NN0 ` . (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem nn0supp (F I: class):
  $ wi (wf I cn0 F) (wceq (cima (ccnv F) (cdif cvv (csn cc0))) (cima (ccnv F) cn)) $;

--| A positive integer is a nonnegative integer. (Contributed by Mario Carneiro, 27-May-2016.)
theorem nnnn0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel A2 cn0) $;

--| A nonnegative integer is a real number. (Contributed by Mario Carneiro, 27-May-2016.)
theorem nn0red (ph: wff) (A2: class):
  $ wi ph (wcel A2 cn0) $ >
  $ wi ph (wcel A2 cr) $;

--| A nonnegative integer is a complex number. (Contributed by Mario Carneiro, 27-May-2016.)
theorem nn0cnd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cn0) $ >
  $ wi ph (wcel A2 cc) $;

--| A nonnegative integer is greater than or equal to zero. (Contributed by Mario Carneiro, 27-May-2016.)
theorem nn0ge0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cn0) $ >
  $ wi ph (wbr cc0 A2 cle) $;

--| Closure of addition of nonnegative integers, inference form. (Contributed by Mario Carneiro, 27-May-2016.)
theorem nn0addcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cn0) $ >
  $ wi ph (wcel B2 cn0) $ >
  $ wi ph (wcel (co A2 B2 caddc) cn0) $;

--| Closure of multiplication of nonnegative integers, inference form. (Contributed by Mario Carneiro, 27-May-2016.)
theorem nn0mulcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cn0) $ >
  $ wi ph (wcel B2 cn0) $ >
  $ wi ph (wcel (co A2 B2 cmul) cn0) $;

--| Closure law for addition of reals, restricted to nonnegative integers. (Contributed by Alexander van der Vekens, 6-Apr-2018.)
theorem nn0readdcl (A2 B2: class):
  $ wi (wa (wcel A2 cn0) (wcel B2 cn0)) (wcel (co A2 B2 caddc) cr) $;

--| If a nonnegative integer is greater than or equal to two, the integer decreased by 1 is a positive integer. (Contributed by Alexander van der Vekens, 1-Aug-2018.) (Revised by AV, 4-Jan-2020.)
theorem nn0ge2m1nn (N: class):
  $ wi (wa (wcel N cn0) (wbr c2 N cle)) (wcel (co N c1 cmin) cn) $;

--| If a nonnegative integer is greater than or equal to two, the integer decreased by 1 is also a nonnegative integer. (Contributed by Alexander van der Vekens, 1-Aug-2018.)
theorem nn0ge2m1nn0 (N: class):
  $ wi (wa (wcel N cn0) (wbr c2 N cle)) (wcel (co N c1 cmin) cn0) $;

--| Closure law for dividing of a nonnegative integer by a positive integer. (Contributed by Alexander van der Vekens, 14-Apr-2018.)
theorem nn0nndivcl (K L: class):
  $ wi (wa (wcel K cn0) (wcel L cn)) (wcel (co K L cdiv) cr) $;

--| Extend class notation to include the class of integers.
term cz: class;

--| Define the set of integers, which are the positive and negative integers together with zero. Definition of integers in [Apostol] p. 22. The letter Z abbreviates the German word Zahlen meaning "numbers." (Contributed by NM, 8-Jan-2002.)
axiom df_z {n: setvar}:
  $ wceq cz (crab n (w3o (wceq (cv n) cc0) (wcel (cv n) cn) (wcel (cneg (cv n)) cn)) cr) $;

--| Membership in the set of integers. (Contributed by NM, 8-Jan-2002.)
theorem elz (N: class):
  $ wb (wcel N cz) (wa (wcel N cr) (w3o (wceq N cc0) (wcel N cn) (wcel (cneg N) cn))) $;

--| The negative of a positive integer is an integer. (Contributed by NM, 12-Jan-2002.)
theorem nnnegz (N: class):
  $ wi (wcel N cn) (wcel (cneg N) cz) $;

--| An integer is a real. (Contributed by NM, 8-Jan-2002.)
theorem zre (N: class):
  $ wi (wcel N cz) (wcel N cr) $;

--| An integer is a complex number. (Contributed by NM, 9-May-2004.)
theorem zcn (N: class):
  $ wi (wcel N cz) (wcel N cc) $;

--| An integer is a real number. (Contributed by NM, 14-Jul-2005.)
theorem zrei (A2: class):
  $ wcel A2 cz $ >
  $ wcel A2 cr $;

--| The integers are a subset of the reals. (Contributed by NM, 2-Aug-2004.)
theorem zssre:
  $ wss cz cr $;

--| The integers are a subset of the complex numbers. (Contributed by NM, 2-Aug-2004.)
theorem zsscn:
  $ wss cz cc $;

--| The set of integers exists. (Contributed by NM, 30-Jul-2004.) (Revised by Mario Carneiro, 17-Nov-2014.)
theorem zex:
  $ wcel cz cvv $;

--| Positive integer property expressed in terms of integers. (Contributed by NM, 8-Jan-2002.)
theorem elnnz (N: class):
  $ wb (wcel N cn) (wa (wcel N cz) (wbr cc0 N clt)) $;

--| Zero is an integer. (Contributed by NM, 12-Jan-2002.)
theorem _0z:
  $ wcel cc0 cz $;

--| Zero is an integer, deductive form (common case). (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem _0zd (ph: wff):
  $ wi ph (wcel cc0 cz) $;

--| Nonnegative integer property expressed in terms of integers. (Contributed by NM, 9-May-2004.)
theorem elnn0z (N: class):
  $ wb (wcel N cn0) (wa (wcel N cz) (wbr cc0 N cle)) $;

--| Integer property expressed in terms nonnegative integers and positive integers. (Contributed by NM, 10-May-2004.)
theorem elznn0nn (N: class):
  $ wb (wcel N cz) (wo (wcel N cn0) (wa (wcel N cr) (wcel (cneg N) cn))) $;

--| Integer property expressed in terms of nonnegative integers. (Contributed by NM, 9-May-2004.)
theorem elznn0 (N: class):
  $ wb (wcel N cz) (wa (wcel N cr) (wo (wcel N cn0) (wcel (cneg N) cn0))) $;

--| Integer property expressed in terms of positive integers and nonnegative integers. (Contributed by NM, 12-Jul-2005.)
theorem elznn (N: class):
  $ wb (wcel N cz) (wa (wcel N cr) (wo (wcel N cn) (wcel (cneg N) cn0))) $;

--| Positive integers are a subset of integers. (Contributed by NM, 9-Jan-2002.)
theorem nnssz:
  $ wss cn cz $;

--| Nonnegative integers are a subset of the integers. (Contributed by NM, 9-May-2004.)
theorem nn0ssz:
  $ wss cn0 cz $;

--| A positive integer is an integer. (Contributed by NM, 9-May-2004.)
theorem nnz (N: class):
  $ wi (wcel N cn) (wcel N cz) $;

--| A nonnegative integer is an integer. (Contributed by NM, 9-May-2004.)
theorem nn0z (N: class):
  $ wi (wcel N cn0) (wcel N cz) $;

--| A positive integer is an integer. (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem nnzi (N: class):
  $ wcel N cn $ >
  $ wcel N cz $;

--| A nonnegative integer is an integer. (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem nn0zi (N: class):
  $ wcel N cn0 $ >
  $ wcel N cz $;

--| Positive integer property expressed in terms of integers. (Contributed by NM, 10-May-2004.) (Proof shortened by Mario Carneiro, 16-May-2014.)
theorem elnnz1 (N: class):
  $ wb (wcel N cn) (wa (wcel N cz) (wbr c1 N cle)) $;

--| Positive integers expressed as a subset of integers. (Contributed by NM, 3-Oct-2004.)
theorem nnzrab {x3: setvar}:
  $ wceq cn (crab x3 (wbr c1 (cv x3) cle) cz) $;

--| Nonnegative integers expressed as a subset of integers. (Contributed by NM, 3-Oct-2004.)
theorem nn0zrab {x3: setvar}:
  $ wceq cn0 (crab x3 (wbr cc0 (cv x3) cle) cz) $;

--| One is an integer. (Contributed by NM, 10-May-2004.)
theorem _1z:
  $ wcel c1 cz $;

--| 1 is an integer, deductive form (common case). (Contributed by David A. Wheeler, 6-Dec-2018.)
theorem _1zzd (ph: wff):
  $ wi ph (wcel c1 cz) $;

--| Two is an integer. (Contributed by NM, 10-May-2004.)
theorem _2z:
  $ wcel c2 cz $;

--| 3 is an integer. (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem _3z:
  $ wcel c3 cz $;

--| 4 is an integer. (Contributed by BJ, 26-Mar-2020.)
theorem _4z:
  $ wcel c4 cz $;

--| Closure law for negative integers. (Contributed by NM, 9-May-2004.)
theorem znegcl (N: class):
  $ wi (wcel N cz) (wcel (cneg N) cz) $;

--| -1 is an integer (common case). (Contributed by David A. Wheeler, 5-Dec-2018.)
theorem neg1z:
  $ wcel (cneg c1) cz $;

--| A number is an integer iff its negative is. (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem znegclb (A2: class):
  $ wi (wcel A2 cc) (wb (wcel A2 cz) (wcel (cneg A2) cz)) $;

--| The negative of a nonnegative integer is an integer. (Contributed by NM, 9-May-2004.)
theorem nn0negz (N: class):
  $ wi (wcel N cn0) (wcel (cneg N) cz) $;

--| The negative of a nonnegative integer is an integer. (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem nn0negzi (N: class):
  $ wcel N cn0 $ >
  $ wcel (cneg N) cz $;

--| Second Peano postulate generalized to integers. (Contributed by NM, 13-Feb-2005.)
theorem peano2z (N: class):
  $ wi (wcel N cz) (wcel (co N c1 caddc) cz) $;

--| Lemma for ~ zaddcl . Special case in which ` N ` is a positive integer. (Contributed by Jim Kingdon, 14-Mar-2020.)
theorem zaddcllempos (M N: class):
  $ wi (wa (wcel M cz) (wcel N cn)) (wcel (co M N caddc) cz) $;

--| "Reverse" second Peano postulate for integers. (Contributed by NM, 12-Sep-2005.)
theorem peano2zm (N: class):
  $ wi (wcel N cz) (wcel (co N c1 cmin) cz) $;

--| Lemma for ~ zaddcl . Special case in which ` -u N ` is a positive integer. (Contributed by Jim Kingdon, 14-Mar-2020.)
theorem zaddcllemneg (M N: class):
  $ wi (w3a (wcel M cz) (wcel N cr) (wcel (cneg N) cn)) (wcel (co M N caddc) cz) $;

--| Closure of addition of integers. (Contributed by NM, 9-May-2004.) (Proof shortened by Mario Carneiro, 16-May-2014.)
theorem zaddcl (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wcel (co M N caddc) cz) $;

--| Closure of subtraction of integers. (Contributed by NM, 11-May-2004.)
theorem zsubcl (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wcel (co M N cmin) cz) $;

--| Integer trichotomy (with zero). (Contributed by Jim Kingdon, 14-Mar-2020.)
theorem ztri3or0 (N: class):
  $ wi (wcel N cz) (w3o (wbr N cc0 clt) (wceq N cc0) (wbr cc0 N clt)) $;

--| Integer trichotomy. (Contributed by Jim Kingdon, 14-Mar-2020.)
theorem ztri3or (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (w3o (wbr M N clt) (wceq M N) (wbr N M clt)) $;

--| Trichotomy law. (Contributed by Jim Kingdon, 27-Mar-2020.)
theorem zletric (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wo (wbr A2 B2 cle) (wbr B2 A2 cle)) $;

--| Trichotomy law. (Contributed by Jim Kingdon, 17-Apr-2020.)
theorem zlelttric (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wo (wbr A2 B2 cle) (wbr B2 A2 clt)) $;

--| 'Less than' expressed in terms of 'less than or equal to'. (Contributed by Jim Kingdon, 14-Mar-2020.)
theorem zltnle (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wb (wbr A2 B2 clt) (wn (wbr B2 A2 cle))) $;

--| Integer 'Less than or equal to' expressed in terms of 'less than' or 'equals'. (Contributed by Jim Kingdon, 8-Apr-2020.)
theorem zleloe (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wb (wbr A2 B2 cle) (wo (wbr A2 B2 clt) (wceq A2 B2))) $;

--| An integer is not a positive integer iff it is less than one. (Contributed by NM, 13-Jul-2005.)
theorem znnnlt1 (N: class):
  $ wi (wcel N cz) (wb (wn (wcel N cn)) (wbr N c1 clt)) $;

--| Transitive law of ordering for integers. (Contributed by Alexander van der Vekens, 3-Apr-2018.)
theorem zletr (J K L: class):
  $ wi (w3a (wcel J cz) (wcel K cz) (wcel L cz)) (wi (wa (wbr J K cle) (wbr K L cle)) (wbr J L cle)) $;

--| Reverse closure law for addition of integers. (Contributed by NM, 11-May-2004.)
theorem zrevaddcl (M N: class):
  $ wi (wcel N cz) (wb (wa (wcel M cc) (wcel (co M N caddc) cz)) (wcel M cz)) $;

--| The positive difference of unequal integers is a positive integer. (Generalization of ~ nnsub .) (Contributed by NM, 11-May-2004.)
theorem znnsub (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr M N clt) (wcel (co N M cmin) cn)) $;

--| Closure of multiplication of integers. (Contributed by NM, 30-Jul-2004.)
theorem zmulcl (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wcel (co M N cmul) cz) $;

--| Integer ordering relation. (Contributed by NM, 10-May-2004.) (Proof shortened by Mario Carneiro, 16-May-2014.)
theorem zltp1le (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr M N clt) (wbr (co M c1 caddc) N cle)) $;

--| Integer ordering relation. (Contributed by NM, 10-May-2004.)
theorem zleltp1 (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr M N cle) (wbr M (co N c1 caddc) clt)) $;

--| Integer ordering relation. (Contributed by NM, 13-Nov-2004.)
theorem zlem1lt (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr M N cle) (wbr (co M c1 cmin) N clt)) $;

--| Integer ordering relation. (Contributed by NM, 13-Nov-2004.)
theorem zltlem1 (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr M N clt) (wbr M (co N c1 cmin) cle)) $;

--| An integer greater than ` 0 ` is greater than or equal to ` 1 ` . (Contributed by AV, 14-Oct-2018.)
theorem zgt0ge1 (Z: class):
  $ wi (wcel Z cz) (wb (wbr cc0 Z clt) (wbr c1 Z cle)) $;

--| Positive integer ordering relation. (Contributed by NM, 13-Aug-2001.) (Proof shortened by Mario Carneiro, 16-May-2014.)
theorem nnleltp1 (A2 B2: class):
  $ wi (wa (wcel A2 cn) (wcel B2 cn)) (wb (wbr A2 B2 cle) (wbr A2 (co B2 c1 caddc) clt)) $;

--| Positive integer ordering relation. (Contributed by NM, 19-Aug-2001.)
theorem nnltp1le (A2 B2: class):
  $ wi (wa (wcel A2 cn) (wcel B2 cn)) (wb (wbr A2 B2 clt) (wbr (co A2 c1 caddc) B2 cle)) $;

--| Closure of addition of positive integers minus one. (Contributed by NM, 6-Aug-2003.) (Proof shortened by Mario Carneiro, 16-May-2014.)
theorem nnaddm1cl (A2 B2: class):
  $ wi (wa (wcel A2 cn) (wcel B2 cn)) (wcel (co (co A2 B2 caddc) c1 cmin) cn) $;

--| Nonnegative integer ordering relation. (Contributed by Raph Levien, 10-Dec-2002.) (Proof shortened by Mario Carneiro, 16-May-2014.)
theorem nn0ltp1le (M N: class):
  $ wi (wa (wcel M cn0) (wcel N cn0)) (wb (wbr M N clt) (wbr (co M c1 caddc) N cle)) $;

--| Nonnegative integer ordering relation. (Contributed by Raph Levien, 10-Apr-2004.)
theorem nn0leltp1 (M N: class):
  $ wi (wa (wcel M cn0) (wcel N cn0)) (wb (wbr M N cle) (wbr M (co N c1 caddc) clt)) $;

--| Nonnegative integer ordering relation. (Contributed by NM, 10-May-2004.) (Proof shortened by Mario Carneiro, 16-May-2014.)
theorem nn0ltlem1 (M N: class):
  $ wi (wa (wcel M cn0) (wcel N cn0)) (wb (wbr M N clt) (wbr M (co N c1 cmin) cle)) $;

--| The nonnegative difference of integers is a nonnegative integer. (Generalization of ~ nn0sub .) (Contributed by NM, 14-Jul-2005.)
theorem znn0sub (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr M N cle) (wcel (co N M cmin) cn0)) $;

--| Subtraction of nonnegative integers. (Contributed by NM, 9-May-2004.)
theorem nn0sub (M N: class):
  $ wi (wa (wcel M cn0) (wcel N cn0)) (wb (wbr M N cle) (wcel (co N M cmin) cn0)) $;

--| A nonnegative integer which is neither 0 nor 1 is greater than or equal to 2. (Contributed by Alexander van der Vekens, 6-Dec-2017.)
theorem nn0n0n1ge2 (N: class):
  $ wi (w3a (wcel N cn0) (wne N cc0) (wne N c1)) (wbr c2 N cle) $;

--| Membership in the set of integers. Commonly used in constructions of the integers as equivalence classes under subtraction of the positive integers. (Contributed by Mario Carneiro, 16-May-2014.)
theorem elz2 {x3 y1: setvar} (N: class):
  $ wb (wcel N cz) (wrex x3 (wrex y1 (wceq N (co (cv x3) (cv y1) cmin)) cn) cn) $;

--| Alternative definition of the integers, based on ~ elz2 . (Contributed by Mario Carneiro, 16-May-2014.)
theorem dfz2:
  $ wceq cz (cima cmin (cxp cn cn)) $;

--| Subtraction of nonnegative integers. (Contributed by NM, 4-Sep-2005.)
theorem nn0sub2 (M N: class):
  $ wi (w3a (wcel M cn0) (wcel N cn0) (wbr M N cle)) (wcel (co N M cmin) cn0) $;

--| Apartness is equivalent to not equal for integers. (Contributed by Jim Kingdon, 14-Mar-2020.)
theorem zapne (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr M N cap) (wne M N)) $;

--| Equality of integers is decidable. (Contributed by Jim Kingdon, 14-Mar-2020.)
theorem zdceq (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wdc (wceq A2 B2)) $;

--| Integer ` <_ ` is decidable. (Contributed by Jim Kingdon, 7-Apr-2020.)
theorem zdcle (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wdc (wbr A2 B2 cle)) $;

--| Integer ` < ` is decidable. (Contributed by Jim Kingdon, 1-Jun-2020.)
theorem zdclt (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wdc (wbr A2 B2 clt)) $;

--| Integer 'Less than' expressed in terms of 'less than or equal to'. Also see ~ ltleap which is a similar result for real numbers. (Contributed by Jim Kingdon, 14-Mar-2020.)
theorem zltlen (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wb (wbr A2 B2 clt) (wa (wbr A2 B2 cle) (wne B2 A2))) $;

--| A nonnegative integer is neither 0 nor 1 if and only if it is greater than or equal to 2. (Contributed by Alexander van der Vekens, 17-Jan-2018.)
theorem nn0n0n1ge2b (N: class):
  $ wi (wcel N cn0) (wb (wa (wne N cc0) (wne N c1)) (wbr c2 N cle)) $;

--| A nonnegative integer less than ` 1 ` is ` 0 ` . (Contributed by Paul Chapman, 22-Jun-2011.)
theorem nn0lt10b (N: class):
  $ wi (wcel N cn0) (wb (wbr N c1 clt) (wceq N cc0)) $;

--| A nonnegative integer less than 2 must be 0 or 1. (Contributed by Alexander van der Vekens, 16-Sep-2018.)
theorem nn0lt2 (N: class):
  $ wi (wa (wcel N cn0) (wbr N c2 clt)) (wo (wceq N cc0) (wceq N c1)) $;

--| Nonnegative integer ordering relation. (Contributed by NM, 21-Jun-2005.)
theorem nn0lem1lt (M N: class):
  $ wi (wa (wcel M cn0) (wcel N cn0)) (wb (wbr M N cle) (wbr (co M c1 cmin) N clt)) $;

--| Positive integer ordering relation. (Contributed by NM, 21-Jun-2005.)
theorem nnlem1lt (M N: class):
  $ wi (wa (wcel M cn) (wcel N cn)) (wb (wbr M N cle) (wbr (co M c1 cmin) N clt)) $;

--| Positive integer ordering relation. (Contributed by NM, 21-Jun-2005.)
theorem nnltlem1 (M N: class):
  $ wi (wa (wcel M cn) (wcel N cn)) (wb (wbr M N clt) (wbr M (co N c1 cmin) cle)) $;

--| A positive integer decreased by 1 is greater than or equal to 0. (Contributed by AV, 30-Oct-2018.)
theorem nnm1ge0 (N: class):
  $ wi (wcel N cn) (wbr cc0 (co N c1 cmin) cle) $;

--| Division of a nonnegative integer by a positive number is not negative. (Contributed by Alexander van der Vekens, 14-Apr-2018.)
theorem nn0ge0div (K L: class):
  $ wi (wa (wcel K cn0) (wcel L cn)) (wbr cc0 (co K L cdiv) cle) $;

--| Two ways to express " ` M ` divides ` N ` . (Contributed by NM, 3-Oct-2008.)
theorem zdiv {k: setvar} (M N: class):
  $ wi (wa (wcel M cn) (wcel N cz)) (wb (wrex k (wceq (co M (cv k) cmul) N) cz) (wcel (co N M cdiv) cz)) $;

--| Property of divisibility: if ` D ` divides ` A ` and ` B ` then it divides ` A + B ` . (Contributed by NM, 3-Oct-2008.)
theorem zdivadd (A2 B2 D: class):
  $ wi (wa (w3a (wcel D cn) (wcel A2 cz) (wcel B2 cz)) (wa (wcel (co A2 D cdiv) cz) (wcel (co B2 D cdiv) cz))) (wcel (co (co A2 B2 caddc) D cdiv) cz) $;

--| Property of divisibility: if ` D ` divides ` A ` then it divides ` B x. A ` . (Contributed by NM, 3-Oct-2008.)
theorem zdivmul (A2 B2 D: class):
  $ wi (wa (w3a (wcel D cn) (wcel A2 cz) (wcel B2 cz)) (wcel (co A2 D cdiv) cz)) (wcel (co (co B2 A2 cmul) D cdiv) cz) $;

--| An extensionality-like property for integer ordering. (Contributed by NM, 29-Oct-2005.)
theorem zextle {k: setvar} (M N: class):
  $ wi (w3a (wcel M cz) (wcel N cz) (wral k (wb (wbr (cv k) M cle) (wbr (cv k) N cle)) cz)) (wceq M N) $;

--| An extensionality-like property for integer ordering. (Contributed by NM, 29-Oct-2005.)
theorem zextlt {k: setvar} (M N: class):
  $ wi (w3a (wcel M cz) (wcel N cz) (wral k (wb (wbr (cv k) M clt) (wbr (cv k) N clt)) cz)) (wceq M N) $;

--| The reciprocal of a number greater than 1 is not an integer. (Contributed by NM, 3-May-2005.)
theorem recnz (A2: class):
  $ wi (wa (wcel A2 cr) (wbr c1 A2 clt)) (wn (wcel (co c1 A2 cdiv) cz)) $;

--| A number between an integer and its successor is not an integer. (Contributed by NM, 3-May-2005.)
theorem btwnnz (A2 B2: class):
  $ wi (w3a (wcel A2 cz) (wbr A2 B2 clt) (wbr B2 (co A2 c1 caddc) clt)) (wn (wcel B2 cz)) $;

--| A larger number does not divide a smaller positive integer. (Contributed by NM, 3-May-2005.)
theorem gtndiv (A2 B2: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cn) (wbr B2 A2 clt)) (wn (wcel (co B2 A2 cdiv) cz)) $;

--| One-half is not an integer. (Contributed by NM, 31-Jul-2004.)
theorem halfnz:
  $ wn (wcel (co c1 c2 cdiv) cz) $;

--| Two ways to express " ` A ` is a prime number (or 1)." (Contributed by NM, 4-May-2005.)
theorem prime {x3: setvar} (A2: class):
  $ wi (wcel A2 cn) (wb (wral x3 (wi (wcel (co A2 (cv x3) cdiv) cn) (wo (wceq (cv x3) c1) (wceq (cv x3) A2))) cn) (wral x3 (wi (w3a (wbr c1 (cv x3) clt) (wbr (cv x3) A2 cle) (wcel (co A2 (cv x3) cdiv) cn)) (wceq (cv x3) A2)) cn)) $;

--| The square of a nonzero integer is a positive integer. (Contributed by NM, 2-Aug-2004.)
theorem msqznn (A2: class):
  $ wi (wa (wcel A2 cz) (wne A2 cc0)) (wcel (co A2 A2 cmul) cn) $;

--| No even integer equals an odd integer (i.e. no integer can be both even and odd). Exercise 10(a) of [Apostol] p. 28. (Contributed by NM, 31-Jul-2004.) (Proof shortened by Mario Carneiro, 18-May-2014.)
theorem zneo (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wne (co c2 A2 cmul) (co (co c2 B2 cmul) c1 caddc)) $;

--| A positive integer is even or odd. (Contributed by Jim Kingdon, 15-Mar-2020.)
theorem nneoor (N: class):
  $ wi (wcel N cn) (wo (wcel (co N c2 cdiv) cn) (wcel (co (co N c1 caddc) c2 cdiv) cn)) $;

--| A positive integer is even or odd but not both. (Contributed by NM, 1-Jan-2006.) (Proof shortened by Mario Carneiro, 18-May-2014.)
theorem nneo (N: class):
  $ wi (wcel N cn) (wb (wcel (co N c2 cdiv) cn) (wn (wcel (co (co N c1 caddc) c2 cdiv) cn))) $;

--| A positive integer is even or odd but not both. (Contributed by NM, 20-Aug-2001.)
theorem nneoi (N: class):
  $ wcel N cn $ >
  $ wb (wcel (co N c2 cdiv) cn) (wn (wcel (co (co N c1 caddc) c2 cdiv) cn)) $;

--| An integer is even or odd. (Contributed by NM, 1-Jan-2006.)
theorem zeo (N: class):
  $ wi (wcel N cz) (wo (wcel (co N c2 cdiv) cz) (wcel (co (co N c1 caddc) c2 cdiv) cz)) $;

--| An integer is even or odd but not both. (Contributed by Mario Carneiro, 12-Sep-2015.)
theorem zeo2 (N: class):
  $ wi (wcel N cz) (wb (wcel (co N c2 cdiv) cz) (wn (wcel (co (co N c1 caddc) c2 cdiv) cz))) $;

--| Second Peano postulate for upper integers. (Contributed by NM, 3-Oct-2004.)
theorem peano2uz2 {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 (crab x3 (wbr A2 (cv x3) cle) cz))) (wcel (co B2 c1 caddc) (crab x3 (wbr A2 (cv x3) cle) cz)) $;

--| Peano's inductive postulate for upper integers. (Contributed by NM, 6-Jul-2005.) (Revised by Mario Carneiro, 25-Jul-2013.)
theorem peano5uzti {x3 k: setvar} (A2 N: class):
  $ wi (wcel N cz) (wi (wa (wcel N A2) (wral x3 (wcel (co (cv x3) c1 caddc) A2) A2)) (wss (crab k (wbr N (cv k) cle) cz) A2)) $;

--| Peano's inductive postulate for upper integers. (Contributed by NM, 6-Jul-2005.) (Revised by Mario Carneiro, 3-May-2014.)
theorem peano5uzi {x3 k: setvar} (A2 N: class):
  $ wcel N cz $ >
  $ wi (wa (wcel N A2) (wral x3 (wcel (co (cv x3) c1 caddc) A2) A2)) (wss (crab k (wbr N (cv k) cle) cz) A2) $;

--| An expression for the upper integers that start at ` N ` that is analogous to ~ dfnn2 for positive integers. (Contributed by NM, 6-Jul-2005.) (Proof shortened by Mario Carneiro, 3-May-2014.)
theorem dfuzi {x3 y1 z: setvar} (N: class):
  $ wcel N cz $ >
  $ wceq (crab z (wbr N (cv z) cle) cz) (cint (cab x3 (wa (wcel N (cv x3)) (wral y1 (wcel (co (cv y1) c1 caddc) (cv x3)) (cv x3))))) $;

--| Induction on the upper integers that start at ` M ` . The first four hypotheses give us the substitution instances we need; the last two are the basis and the induction step. (Contributed by NM, 5-Jul-2005.)
theorem uzind {j k: setvar} (ph: wff j) (ps ch th ta: wff k) (M: class) (N: class k):
  $ wi (wceq (cv j) M) (wb ph ps) $ >
  $ wi (wceq (cv j) (cv k)) (wb ph ch) $ >
  $ wi (wceq (cv j) (co (cv k) c1 caddc)) (wb ph th) $ >
  $ wi (wceq (cv j) N) (wb ph ta) $ >
  $ wi (wcel M cz) ps $ >
  $ wi (w3a (wcel M cz) (wcel (cv k) cz) (wbr M (cv k) cle)) (wi ch th) $ >
  $ wi (w3a (wcel M cz) (wcel N cz) (wbr M N cle)) ta $;

--| Induction on the upper integers that start _after_ an integer ` M ` . The first four hypotheses give us the substitution instances we need; the last two are the basis and the induction step. (Contributed by NM, 25-Jul-2005.)
theorem uzind2 {j k: setvar} (ph: wff j) (ps ch th ta: wff k) (M: class) (N: class k):
  $ wi (wceq (cv j) (co M c1 caddc)) (wb ph ps) $ >
  $ wi (wceq (cv j) (cv k)) (wb ph ch) $ >
  $ wi (wceq (cv j) (co (cv k) c1 caddc)) (wb ph th) $ >
  $ wi (wceq (cv j) N) (wb ph ta) $ >
  $ wi (wcel M cz) ps $ >
  $ wi (w3a (wcel M cz) (wcel (cv k) cz) (wbr M (cv k) clt)) (wi ch th) $ >
  $ wi (w3a (wcel M cz) (wcel N cz) (wbr M N clt)) ta $;

--| Induction on the upper integers that start at an integer ` M ` . The first four hypotheses give us the substitution instances we need, and the last two are the basis and the induction step. (Contributed by NM, 26-Jul-2005.)
theorem uzind3 {j k m: setvar} (ph: wff j k) (ps ch th ta: wff k m) (M: class) (N: class m):
  $ wi (wceq (cv j) M) (wb ph ps) $ >
  $ wi (wceq (cv j) (cv m)) (wb ph ch) $ >
  $ wi (wceq (cv j) (co (cv m) c1 caddc)) (wb ph th) $ >
  $ wi (wceq (cv j) N) (wb ph ta) $ >
  $ wi (wcel M cz) ps $ >
  $ wi (wa (wcel M cz) (wcel (cv m) (crab k (wbr M (cv k) cle) cz))) (wi ch th) $ >
  $ wi (wa (wcel M cz) (wcel N (crab k (wbr M (cv k) cle) cz))) ta $;

--| Principle of Mathematical Induction (inference schema) on nonnegative integers. The first four hypotheses give us the substitution instances we need; the last two are the basis and the induction step. (Contributed by NM, 13-May-2004.)
theorem nn0ind {x3 y1: setvar} (ph: wff x3) (ps ch th ta: wff y1) (A2: class y1):
  $ wi (wceq (cv x3) cc0) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (co (cv y1) c1 caddc)) (wb ph th) $ >
  $ wi (wceq (cv x3) A2) (wb ph ta) $ >
  $ ps $ >
  $ wi (wcel (cv y1) cn0) (wi ch th) $ >
  $ wi (wcel A2 cn0) ta $;

--| Induction on the integers from ` M ` to ` N ` inclusive . The first four hypotheses give us the substitution instances we need; the last two are the basis and the induction step. (Contributed by Paul Chapman, 31-Mar-2011.)
theorem fzind {x3 y1: setvar} (ph: wff x3) (ps ch th ta: wff y1) (K: class y1) (M N: class):
  $ wi (wceq (cv x3) M) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (co (cv y1) c1 caddc)) (wb ph th) $ >
  $ wi (wceq (cv x3) K) (wb ph ta) $ >
  $ wi (w3a (wcel M cz) (wcel N cz) (wbr M N cle)) ps $ >
  $ wi (wa (wa (wcel M cz) (wcel N cz)) (w3a (wcel (cv y1) cz) (wbr M (cv y1) cle) (wbr (cv y1) N clt))) (wi ch th) $ >
  $ wi (wa (wa (wcel M cz) (wcel N cz)) (w3a (wcel K cz) (wbr M K cle) (wbr K N cle))) ta $;

--| Induction on the integers from ` 0 ` to ` N ` inclusive . The first four hypotheses give us the substitution instances we need; the last two are the basis and the induction step. (Contributed by Paul Chapman, 31-Mar-2011.)
theorem fnn0ind {x3 y1: setvar} (ph: wff x3) (ps ch th ta: wff y1) (K: class y1) (N: class):
  $ wi (wceq (cv x3) cc0) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (co (cv y1) c1 caddc)) (wb ph th) $ >
  $ wi (wceq (cv x3) K) (wb ph ta) $ >
  $ wi (wcel N cn0) ps $ >
  $ wi (w3a (wcel N cn0) (wcel (cv y1) cn0) (wbr (cv y1) N clt)) (wi ch th) $ >
  $ wi (w3a (wcel N cn0) (wcel K cn0) (wbr K N cle)) ta $;

--| Principle of Mathematical Induction (inference schema) on nonnegative integers. The first four hypotheses give us the substitution instances we need; the last two are the basis and the induction step. Raph Levien remarks: "This seems a bit painful. I wonder if an explicit substitution version would be easier." (Contributed by Raph Levien, 10-Apr-2004.)
theorem nn0ind_raph {x3 y1: setvar} (ph: wff x3) (ps ch th ta: wff y1) (A2: class y1):
  $ wi (wceq (cv x3) cc0) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (co (cv y1) c1 caddc)) (wb ph th) $ >
  $ wi (wceq (cv x3) A2) (wb ph ta) $ >
  $ ps $ >
  $ wi (wcel (cv y1) cn0) (wi ch th) $ >
  $ wi (wcel A2 cn0) ta $;

--| Principle of Mathematical Induction on all integers, deduction version. The first five hypotheses give the substitutions; the last three are the basis, the induction, and the extension to negative numbers. (Contributed by Paul Chapman, 17-Apr-2009.) (Proof shortened by Mario Carneiro, 4-Jan-2017.)
theorem zindd {x3 y1: setvar} (ph: wff x3) (ps ch th ta et: wff y1) (ze: wff) (A2: class y1):
  $ wi (wceq (cv x3) cc0) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (co (cv y1) c1 caddc)) (wb ph ta) $ >
  $ wi (wceq (cv x3) (cneg (cv y1))) (wb ph th) $ >
  $ wi (wceq (cv x3) A2) (wb ph et) $ >
  $ wi ze ps $ >
  $ wi ze (wi (wcel (cv y1) cn0) (wi ch ta)) $ >
  $ wi ze (wi (wcel (cv y1) cn) (wi ch th)) $ >
  $ wi ze (wi (wcel A2 cz) et) $;

--| Any real number can be sandwiched between two integers. Exercise 2 of [Apostol] p. 28. (Contributed by NM, 10-Nov-2004.)
theorem btwnz {x3 y1: setvar} (A2: class):
  $ wi (wcel A2 cr) (wa (wrex x3 (wbr (cv x3) A2 clt) cz) (wrex y1 (wbr A2 (cv y1) clt) cz)) $;

--| Any real number can be sandwiched between two integers. Exercise 2 of [Apostol] p. 28. (Contributed by NM, 10-Nov-2004.)
theorem btwnz_b {x3: setvar} (A2: class):
  $ wi (wcel A2 cr) (wa (wrex x3 (wbr (cv x3) A2 clt) cz) (wrex x3 (wbr A2 (cv x3) clt) cz)) $;

--| A positive integer is an integer. (Contributed by Mario Carneiro, 28-May-2016.)
theorem nn0zd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cn0) $ >
  $ wi ph (wcel A2 cz) $;

--| A nonnegative integer is an integer. (Contributed by Mario Carneiro, 28-May-2016.)
theorem nnzd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel A2 cz) $;

--| An integer is a real number. (Contributed by Mario Carneiro, 28-May-2016.)
theorem zred (ph: wff) (A2: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel A2 cr) $;

--| An integer is a complex number. (Contributed by Mario Carneiro, 28-May-2016.)
theorem zcnd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel A2 cc) $;

--| Closure law for negative integers. (Contributed by Mario Carneiro, 28-May-2016.)
theorem znegcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel (cneg A2) cz) $;

--| Deduction from second Peano postulate generalized to integers. (Contributed by Mario Carneiro, 28-May-2016.)
theorem peano2zd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel (co A2 c1 caddc) cz) $;

--| Closure of addition of integers. (Contributed by Mario Carneiro, 28-May-2016.)
theorem zaddcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel B2 cz) $ >
  $ wi ph (wcel (co A2 B2 caddc) cz) $;

--| Closure of subtraction of integers. (Contributed by Mario Carneiro, 28-May-2016.)
theorem zsubcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel B2 cz) $ >
  $ wi ph (wcel (co A2 B2 cmin) cz) $;

--| Closure of multiplication of integers. (Contributed by Mario Carneiro, 28-May-2016.)
theorem zmulcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel B2 cz) $ >
  $ wi ph (wcel (co A2 B2 cmul) cz) $;

--| Increasing an integer by 2 results in an integer. (Contributed by Alexander van der Vekens, 16-Sep-2018.)
theorem zadd2cl (N: class):
  $ wi (wcel N cz) (wcel (co N c2 caddc) cz) $;

--| Constant used for decimal constructor.
term cdc (A2 B2: class): class;

--| Define the "decimal constructor", which is used to build up "decimal integers" or "numeric terms" in base 10. For example, ` ( ; ; ; 1 0 0 0 + ; ; ; 2 0 0 0 ) = ; ; ; 3 0 0 0 ` . (Contributed by Mario Carneiro, 17-Apr-2015.)
axiom df_dec (A2 B2: class):
  $ wceq (cdc A2 B2) (co (co c10 A2 cmul) B2 caddc) $;

--| Equality theorem for the decimal constructor. (Contributed by Mario Carneiro, 17-Apr-2015.)
theorem deceq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cdc A2 C) (cdc B2 C)) $;

--| Equality theorem for the decimal constructor. (Contributed by Mario Carneiro, 17-Apr-2015.)
theorem deceq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cdc C A2) (cdc C B2)) $;

--| Equality theorem for the decimal constructor. (Contributed by Mario Carneiro, 17-Apr-2015.)
theorem deceq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cdc A2 C) (cdc B2 C) $;

--| Equality theorem for the decimal constructor. (Contributed by Mario Carneiro, 17-Apr-2015.)
theorem deceq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cdc C A2) (cdc C B2) $;

--| Equality theorem for the decimal constructor. (Contributed by Mario Carneiro, 17-Apr-2015.)
theorem deceq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (cdc A2 C) (cdc B2 D) $;

--| Closure for a numeral (with units place). (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem numnncl (A2 B2 T: class):
  $ wcel T cn0 $ >
  $ wcel A2 cn0 $ >
  $ wcel B2 cn $ >
  $ wcel (co (co T A2 cmul) B2 caddc) cn $;

--| Add a zero in the units place. (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem num0u (A2 T: class):
  $ wcel T cn0 $ >
  $ wcel A2 cn0 $ >
  $ wceq (co T A2 cmul) (co (co T A2 cmul) cc0 caddc) $;

--| Add a zero in the higher places. (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem num0h (A2 T: class):
  $ wcel T cn0 $ >
  $ wcel A2 cn0 $ >
  $ wceq A2 (co (co T cc0 cmul) A2 caddc) $;

--| Closure for a decimal integer (with units place). (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem numcl (A2 B2 T: class):
  $ wcel T cn0 $ >
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel (co (co T A2 cmul) B2 caddc) cn0 $;

--| The successor of a decimal integer (no carry). (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem numsuc (A2 B2 C T N: class):
  $ wcel T cn0 $ >
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wceq (co B2 c1 caddc) C $ >
  $ wceq N (co (co T A2 cmul) B2 caddc) $ >
  $ wceq (co N c1 caddc) (co (co T A2 cmul) C caddc) $;

--| Closure for a numeral. (Contributed by Mario Carneiro, 17-Apr-2015.)
theorem decnncl (A2 B2: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn $ >
  $ wcel (cdc A2 B2) cn $;

--| Closure for a numeral. (Contributed by Mario Carneiro, 17-Apr-2015.)
theorem deccl (A2 B2: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel (cdc A2 B2) cn0 $;

--| Add a zero in the units place. (Contributed by Mario Carneiro, 17-Apr-2015.)
theorem dec0u (A2: class):
  $ wcel A2 cn0 $ >
  $ wceq (co c10 A2 cmul) (cdc A2 cc0) $;

--| Add a zero in the higher places. (Contributed by Mario Carneiro, 17-Apr-2015.)
theorem dec0h (A2: class):
  $ wcel A2 cn0 $ >
  $ wceq A2 (cdc cc0 A2) $;

--| Closure for a decimal integer (zero units place). (Contributed by Mario Carneiro, 9-Mar-2015.)
theorem numnncl2 (A2 T: class):
  $ wcel T cn $ >
  $ wcel A2 cn $ >
  $ wcel (co (co T A2 cmul) cc0 caddc) cn $;

--| Closure for a decimal integer (zero units place). (Contributed by Mario Carneiro, 17-Apr-2015.)
theorem decnncl2 (A2: class):
  $ wcel A2 cn $ >
  $ wcel (cdc A2 cc0) cn $;

--| Comparing two decimal integers (equal higher places). (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem numlt (A2 B2 C T: class):
  $ wcel T cn $ >
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn $ >
  $ wbr B2 C clt $ >
  $ wbr (co (co T A2 cmul) B2 caddc) (co (co T A2 cmul) C caddc) clt $;

--| Comparing two decimal integers (unequal higher places). (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem numltc (A2 B2 C D T: class):
  $ wcel T cn $ >
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wcel D cn0 $ >
  $ wbr C T clt $ >
  $ wbr A2 B2 clt $ >
  $ wbr (co (co T A2 cmul) C caddc) (co (co T B2 cmul) D caddc) clt $;

--| Comparing two decimal integers (equal higher places). (Contributed by Mario Carneiro, 17-Apr-2015.)
theorem declt (A2 B2 C: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn $ >
  $ wbr B2 C clt $ >
  $ wbr (cdc A2 B2) (cdc A2 C) clt $;

--| Comparing two decimal integers (unequal higher places). (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem decltc (A2 B2 C D: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wcel D cn0 $ >
  $ wbr C c10 clt $ >
  $ wbr A2 B2 clt $ >
  $ wbr (cdc A2 C) (cdc B2 D) clt $;

--| The successor of a decimal integer (no carry). (Contributed by Mario Carneiro, 17-Apr-2015.)
theorem decsuc (A2 B2 C N: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wceq (co B2 c1 caddc) C $ >
  $ wceq N (cdc A2 B2) $ >
  $ wceq (co N c1 caddc) (cdc A2 C) $;

--| Comparing a digit to a decimal integer. (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem numlti (A2 B2 C T: class):
  $ wcel T cn $ >
  $ wcel A2 cn $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wbr C T clt $ >
  $ wbr C (co (co T A2 cmul) B2 caddc) clt $;

--| Comparing a digit to a decimal integer. (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem declti (A2 B2 C: class):
  $ wcel A2 cn $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wbr C c10 clt $ >
  $ wbr C (cdc A2 B2) clt $;

--| The successor of a decimal integer (with carry). (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem numsucc (A2 B2 T N Y: class):
  $ wcel Y cn0 $ >
  $ wceq T (co Y c1 caddc) $ >
  $ wcel A2 cn0 $ >
  $ wceq (co A2 c1 caddc) B2 $ >
  $ wceq N (co (co T A2 cmul) Y caddc) $ >
  $ wceq (co N c1 caddc) (co (co T B2 cmul) cc0 caddc) $;

--| The successor of a decimal integer (with carry). (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem decsucc (A2 B2 N: class):
  $ wcel A2 cn0 $ >
  $ wceq (co A2 c1 caddc) B2 $ >
  $ wceq N (cdc A2 c9) $ >
  $ wceq (co N c1 caddc) (cdc B2 cc0) $;

--| The successor of zero. (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem _1e0p1:
  $ wceq c1 (co cc0 c1 caddc) $;

--| Ten plus an integer. (Contributed by Mario Carneiro, 19-Apr-2015.)
theorem dec10p (A2: class):
  $ wceq (co c10 A2 caddc) (cdc c1 A2) $;

--| The decimal form of 10. NB: In our presentations of large numbers later on, we will use our symbol for 10 at the highest digits when advantageous, because we can use this theorem to convert back to "long form" (where each digit is in the range 0-9) with no extra effort. However, we _cannot_ do this for lower digits while maintaining the ease of use of the decimal system, since it requires nontrivial number knowledge (more than just equality theorems) to convert back. (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem dec10:
  $ wceq c10 (cdc c1 cc0) $;

--| Perform a multiply-add of two decimal integers ` M ` and ` N ` against a fixed multiplicand ` P ` (no carry). (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem numma (A2 B2 C D P T E F M N: class):
  $ wcel T cn0 $ >
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wcel D cn0 $ >
  $ wceq M (co (co T A2 cmul) B2 caddc) $ >
  $ wceq N (co (co T C cmul) D caddc) $ >
  $ wcel P cn0 $ >
  $ wceq (co (co A2 P cmul) C caddc) E $ >
  $ wceq (co (co B2 P cmul) D caddc) F $ >
  $ wceq (co (co M P cmul) N caddc) (co (co T E cmul) F caddc) $;

--| Perform a multiply-add of two decimal integers ` M ` and ` N ` against a fixed multiplicand ` P ` (with carry). (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem nummac (A2 B2 C D P T E F G M N: class):
  $ wcel T cn0 $ >
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wcel D cn0 $ >
  $ wceq M (co (co T A2 cmul) B2 caddc) $ >
  $ wceq N (co (co T C cmul) D caddc) $ >
  $ wcel P cn0 $ >
  $ wcel F cn0 $ >
  $ wcel G cn0 $ >
  $ wceq (co (co A2 P cmul) (co C G caddc) caddc) E $ >
  $ wceq (co (co B2 P cmul) D caddc) (co (co T G cmul) F caddc) $ >
  $ wceq (co (co M P cmul) N caddc) (co (co T E cmul) F caddc) $;

--| Perform a multiply-add of two decimal integers ` M ` and ` N ` against a fixed multiplicand ` P ` (with carry). (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem numma2c (A2 B2 C D P T E F G M N: class):

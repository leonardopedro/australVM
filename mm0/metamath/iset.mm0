--| A syllogism inference. (Contributed by NM, 22-Aug-1995.)
theorem syl3an1 (ph ps ch th ta: wff):
  $ wi ph ps $ >
  $ wi (w3a ps ch th) ta $ >
  $ wi (w3a ph ch th) ta $;

--| A syllogism inference. (Contributed by NM, 22-Aug-1995.)
theorem syl3an2 (ph ps ch th ta: wff):
  $ wi ph ch $ >
  $ wi (w3a ps ch th) ta $ >
  $ wi (w3a ps ph th) ta $;

--| A syllogism inference. (Contributed by NM, 22-Aug-1995.)
theorem syl3an3 (ph ps ch th ta: wff):
  $ wi ph th $ >
  $ wi (w3a ps ch th) ta $ >
  $ wi (w3a ps ch ph) ta $;

--| A syllogism inference. (Contributed by NM, 22-Aug-1995.)
theorem syl3an1b (ph ps ch th ta: wff):
  $ wb ph ps $ >
  $ wi (w3a ps ch th) ta $ >
  $ wi (w3a ph ch th) ta $;

--| A syllogism inference. (Contributed by NM, 22-Aug-1995.)
theorem syl3an2b (ph ps ch th ta: wff):
  $ wb ph ch $ >
  $ wi (w3a ps ch th) ta $ >
  $ wi (w3a ps ph th) ta $;

--| A syllogism inference. (Contributed by NM, 22-Aug-1995.)
theorem syl3an3b (ph ps ch th ta: wff):
  $ wb ph th $ >
  $ wi (w3a ps ch th) ta $ >
  $ wi (w3a ps ch ph) ta $;

--| A syllogism inference. (Contributed by NM, 22-Aug-1995.)
theorem syl3an1br (ph ps ch th ta: wff):
  $ wb ps ph $ >
  $ wi (w3a ps ch th) ta $ >
  $ wi (w3a ph ch th) ta $;

--| A syllogism inference. (Contributed by NM, 22-Aug-1995.)
theorem syl3an2br (ph ps ch th ta: wff):
  $ wb ch ph $ >
  $ wi (w3a ps ch th) ta $ >
  $ wi (w3a ps ph th) ta $;

--| A syllogism inference. (Contributed by NM, 22-Aug-1995.)
theorem syl3an3br (ph ps ch th ta: wff):
  $ wb th ph $ >
  $ wi (w3a ps ch th) ta $ >
  $ wi (w3a ps ch ph) ta $;

--| A triple syllogism inference. (Contributed by NM, 13-May-2004.)
theorem syl3an (ph ps ch th ta et ze: wff):
  $ wi ph ps $ >
  $ wi ch th $ >
  $ wi ta et $ >
  $ wi (w3a ps th et) ze $ >
  $ wi (w3a ph ch ta) ze $;

--| A triple syllogism inference. (Contributed by NM, 15-Oct-2005.)
theorem syl3anb (ph ps ch th ta et ze: wff):
  $ wb ph ps $ >
  $ wb ch th $ >
  $ wb ta et $ >
  $ wi (w3a ps th et) ze $ >
  $ wi (w3a ph ch ta) ze $;

--| A triple syllogism inference. (Contributed by NM, 29-Dec-2011.)
theorem syl3anbr (ph ps ch th ta et ze: wff):
  $ wb ps ph $ >
  $ wb th ch $ >
  $ wb et ta $ >
  $ wi (w3a ps th et) ze $ >
  $ wi (w3a ph ch ta) ze $;

--| A syllogism inference. (Contributed by NM, 20-May-2007.)
theorem syld3an3 (ph ps ch th ta: wff):
  $ wi (w3a ph ps ch) th $ >
  $ wi (w3a ph ps th) ta $ >
  $ wi (w3a ph ps ch) ta $;

--| A syllogism inference. (Contributed by NM, 7-Jul-2008.)
theorem syld3an1 (ph ps ch th ta: wff):
  $ wi (w3a ch ps th) ph $ >
  $ wi (w3a ph ps th) ta $ >
  $ wi (w3a ch ps th) ta $;

--| A syllogism inference. (Contributed by NM, 20-May-2007.)
theorem syld3an2 (ph ps ch th ta: wff):
  $ wi (w3a ph ch th) ps $ >
  $ wi (w3a ph ps th) ta $ >
  $ wi (w3a ph ch th) ta $;

--| A syllogism inference. (Contributed by NM, 24-Feb-2005.)
theorem syl3anl1 (ph ps ch th ta et: wff):
  $ wi ph ps $ >
  $ wi (wa (w3a ps ch th) ta) et $ >
  $ wi (wa (w3a ph ch th) ta) et $;

--| A syllogism inference. (Contributed by NM, 24-Feb-2005.)
theorem syl3anl2 (ph ps ch th ta et: wff):
  $ wi ph ch $ >
  $ wi (wa (w3a ps ch th) ta) et $ >
  $ wi (wa (w3a ps ph th) ta) et $;

--| A syllogism inference. (Contributed by NM, 24-Feb-2005.)
theorem syl3anl3 (ph ps ch th ta et: wff):
  $ wi ph th $ >
  $ wi (wa (w3a ps ch th) ta) et $ >
  $ wi (wa (w3a ps ch ph) ta) et $;

--| A triple syllogism inference. (Contributed by NM, 24-Dec-2006.)
theorem syl3anl (ph ps ch th ta et ze si: wff):
  $ wi ph ps $ >
  $ wi ch th $ >
  $ wi ta et $ >
  $ wi (wa (w3a ps th et) ze) si $ >
  $ wi (wa (w3a ph ch ta) ze) si $;

--| A syllogism inference. (Contributed by NM, 31-Jul-2007.)
theorem syl3anr1 (ph ps ch th ta et: wff):
  $ wi ph ps $ >
  $ wi (wa ch (w3a ps th ta)) et $ >
  $ wi (wa ch (w3a ph th ta)) et $;

--| A syllogism inference. (Contributed by NM, 1-Aug-2007.)
theorem syl3anr2 (ph ps ch th ta et: wff):
  $ wi ph th $ >
  $ wi (wa ch (w3a ps th ta)) et $ >
  $ wi (wa ch (w3a ps ph ta)) et $;

--| A syllogism inference. (Contributed by NM, 23-Aug-2007.)
theorem syl3anr3 (ph ps ch th ta et: wff):
  $ wi ph ta $ >
  $ wi (wa ch (w3a ps th ta)) et $ >
  $ wi (wa ch (w3a ps th ph)) et $;

--| Importation inference (undistribute conjunction). (Contributed by NM, 14-Aug-1995.)
theorem _3impdi (ph ps ch th: wff):
  $ wi (wa (wa ph ps) (wa ph ch)) th $ >
  $ wi (w3a ph ps ch) th $;

--| Importation inference (undistribute conjunction). (Contributed by NM, 20-Aug-1995.)
theorem _3impdir (ph ps ch th: wff):
  $ wi (wa (wa ph ps) (wa ch ps)) th $ >
  $ wi (w3a ph ch ps) th $;

--| Inference from idempotent law for conjunction. (Contributed by NM, 7-Mar-2008.)
theorem _3anidm12 (ph ps ch: wff):
  $ wi (w3a ph ph ps) ch $ >
  $ wi (wa ph ps) ch $;

--| Inference from idempotent law for conjunction. (Contributed by NM, 7-Mar-2008.)
theorem _3anidm13 (ph ps ch: wff):
  $ wi (w3a ph ps ph) ch $ >
  $ wi (wa ph ps) ch $;

--| Inference from idempotent law for conjunction. (Contributed by NM, 1-Feb-2007.)
theorem _3anidm23 (ph ps ch: wff):
  $ wi (w3a ph ps ps) ch $ >
  $ wi (wa ph ps) ch $;

--| Infer implication from triple disjunction. (Contributed by NM, 26-Sep-2006.)
theorem _3ori (ph ps ch: wff):
  $ w3o ph ps ch $ >
  $ wi (wa (wn ph) (wn ps)) ch $;

--| Disjunction of 3 antecedents. (Contributed by NM, 8-Apr-1994.)
theorem _3jao (ph ps ch th: wff):
  $ wi (w3a (wi ph ps) (wi ch ps) (wi th ps)) (wi (w3o ph ch th) ps) $;

--| Disjunction of 3 antecedents. (Contributed by NM, 13-Sep-2011.)
theorem _3jaob (ph ps ch th: wff):
  $ wb (wi (w3o ph ch th) ps) (w3a (wi ph ps) (wi ch ps) (wi th ps)) $;

--| Disjunction of 3 antecedents (inference). (Contributed by NM, 12-Sep-1995.)
theorem _3jaoi (ph ps ch th: wff):
  $ wi ph ps $ >
  $ wi ch ps $ >
  $ wi th ps $ >
  $ wi (w3o ph ch th) ps $;

--| Disjunction of 3 antecedents (deduction). (Contributed by NM, 14-Oct-2005.)
theorem _3jaod (ph ps ch th ta: wff):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi th ch) $ >
  $ wi ph (wi ta ch) $ >
  $ wi ph (wi (w3o ps th ta) ch) $;

--| Disjunction of 3 antecedents (inference). (Contributed by NM, 14-Oct-2005.)
theorem _3jaoian (ph ps ch th ta: wff):
  $ wi (wa ph ps) ch $ >
  $ wi (wa th ps) ch $ >
  $ wi (wa ta ps) ch $ >
  $ wi (wa (w3o ph th ta) ps) ch $;

--| Disjunction of 3 antecedents (deduction). (Contributed by NM, 14-Oct-2005.)
theorem _3jaodan (ph ps ch th ta: wff):
  $ wi (wa ph ps) ch $ >
  $ wi (wa ph th) ch $ >
  $ wi (wa ph ta) ch $ >
  $ wi (wa ph (w3o ps th ta)) ch $;

--| Eliminate a 3-way disjunction in a deduction. (Contributed by Thierry Arnoux, 13-Apr-2018.)
theorem mpjao3dan (ph ps ch th ta: wff):
  $ wi (wa ph ps) ch $ >
  $ wi (wa ph th) ch $ >
  $ wi (wa ph ta) ch $ >
  $ wi ph (w3o ps th ta) $ >
  $ wi ph ch $;

--| Inference conjoining and disjoining the antecedents of three implications. (Contributed by Jeff Hankins, 15-Aug-2009.) (Proof shortened by Andrew Salmon, 13-May-2011.)
theorem _3jaao (ph ps ch th ta et ze: wff):
  $ wi ph (wi ps ch) $ >
  $ wi th (wi ta ch) $ >
  $ wi et (wi ze ch) $ >
  $ wi (w3a ph th et) (wi (w3o ps ta ze) ch) $;

--| Triple disjunction implies negated triple conjunction. (Contributed by Jim Kingdon, 23-Dec-2018.)
theorem _3ianorr (ph ps ch: wff):
  $ wi (w3o (wn ph) (wn ps) (wn ch)) (wn (w3a ph ps ch)) $;

--| Nested syllogism inference conjoining 3 dissimilar antecedents. (Contributed by NM, 1-May-1995.)
theorem syl3an9b (ph ps ch th ta et ze: wff):
  $ wi ph (wb ps ch) $ >
  $ wi th (wb ch ta) $ >
  $ wi et (wb ta ze) $ >
  $ wi (w3a ph th et) (wb ps ze) $;

--| Deduction joining 3 equivalences to form equivalence of disjunctions. (Contributed by NM, 20-Apr-1994.)
theorem _3orbi123d (ph ps ch th ta et ze: wff):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb th ta) $ >
  $ wi ph (wb et ze) $ >
  $ wi ph (wb (w3o ps th et) (w3o ch ta ze)) $;

--| Deduction joining 3 equivalences to form equivalence of conjunctions. (Contributed by NM, 22-Apr-1994.)
theorem _3anbi123d (ph ps ch th ta et ze: wff):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb th ta) $ >
  $ wi ph (wb et ze) $ >
  $ wi ph (wb (w3a ps th et) (w3a ch ta ze)) $;

--| Deduction conjoining and adding a conjunct to equivalences. (Contributed by NM, 8-Sep-2006.)
theorem _3anbi12d (ph ps ch th ta et: wff):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb th ta) $ >
  $ wi ph (wb (w3a ps th et) (w3a ch ta et)) $;

--| Deduction conjoining and adding a conjunct to equivalences. (Contributed by NM, 8-Sep-2006.)
theorem _3anbi13d (ph ps ch th ta et: wff):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb th ta) $ >
  $ wi ph (wb (w3a ps et th) (w3a ch et ta)) $;

--| Deduction conjoining and adding a conjunct to equivalences. (Contributed by NM, 8-Sep-2006.)
theorem _3anbi23d (ph ps ch th ta et: wff):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb th ta) $ >
  $ wi ph (wb (w3a et ps th) (w3a et ch ta)) $;

--| Deduction adding conjuncts to an equivalence. (Contributed by NM, 8-Sep-2006.)
theorem _3anbi1d (ph ps ch th ta: wff):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (w3a ps th ta) (w3a ch th ta)) $;

--| Deduction adding conjuncts to an equivalence. (Contributed by NM, 8-Sep-2006.)
theorem _3anbi2d (ph ps ch th ta: wff):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (w3a th ps ta) (w3a th ch ta)) $;

--| Deduction adding conjuncts to an equivalence. (Contributed by NM, 8-Sep-2006.)
theorem _3anbi3d (ph ps ch th ta: wff):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (w3a th ta ps) (w3a th ta ch)) $;

--| Deduction joining 3 implications to form implication of conjunctions. (Contributed by NM, 24-Feb-2005.)
theorem _3anim123d (ph ps ch th ta et ze: wff):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi th ta) $ >
  $ wi ph (wi et ze) $ >
  $ wi ph (wi (w3a ps th et) (w3a ch ta ze)) $;

--| Deduction joining 3 implications to form implication of disjunctions. (Contributed by NM, 4-Apr-1997.)
theorem _3orim123d (ph ps ch th ta et ze: wff):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi th ta) $ >
  $ wi ph (wi et ze) $ >
  $ wi ph (wi (w3o ps th et) (w3o ch ta ze)) $;

--| Rearrangement of 6 conjuncts. (Contributed by NM, 13-Mar-1995.)
theorem an6 (ph ps ch th ta et: wff):
  $ wb (wa (w3a ph ps ch) (w3a th ta et)) (w3a (wa ph th) (wa ps ta) (wa ch et)) $;

--| Analog of ~ an4 for triple conjunction. (Contributed by Scott Fenton, 16-Mar-2011.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem _3an6 (ph ps ch th ta et: wff):
  $ wb (w3a (wa ph ps) (wa ch th) (wa ta et)) (wa (w3a ph ch ta) (w3a ps th et)) $;

--| Analog of ~ or4 for triple conjunction. (Contributed by Scott Fenton, 16-Mar-2011.)
theorem _3or6 (ph ps ch th ta et: wff):
  $ wb (w3o (wo ph ps) (wo ch th) (wo ta et)) (wo (w3o ph ch ta) (w3o ps th et)) $;

--| An inference based on modus ponens. (Contributed by NM, 21-Nov-1994.)
theorem mp3an1 (ph ps ch th: wff):
  $ ph $ >
  $ wi (w3a ph ps ch) th $ >
  $ wi (wa ps ch) th $;

--| An inference based on modus ponens. (Contributed by NM, 21-Nov-1994.)
theorem mp3an2 (ph ps ch th: wff):
  $ ps $ >
  $ wi (w3a ph ps ch) th $ >
  $ wi (wa ph ch) th $;

--| An inference based on modus ponens. (Contributed by NM, 21-Nov-1994.)
theorem mp3an3 (ph ps ch th: wff):
  $ ch $ >
  $ wi (w3a ph ps ch) th $ >
  $ wi (wa ph ps) th $;

--| An inference based on modus ponens. (Contributed by NM, 13-Jul-2005.)
theorem mp3an12 (ph ps ch th: wff):
  $ ph $ >
  $ ps $ >
  $ wi (w3a ph ps ch) th $ >
  $ wi ch th $;

--| An inference based on modus ponens. (Contributed by NM, 14-Jul-2005.)
theorem mp3an13 (ph ps ch th: wff):
  $ ph $ >
  $ ch $ >
  $ wi (w3a ph ps ch) th $ >
  $ wi ps th $;

--| An inference based on modus ponens. (Contributed by NM, 14-Jul-2005.)
theorem mp3an23 (ph ps ch th: wff):
  $ ps $ >
  $ ch $ >
  $ wi (w3a ph ps ch) th $ >
  $ wi ph th $;

--| An inference based on modus ponens. (Contributed by NM, 5-Jul-2005.)
theorem mp3an1i (ph ps ch th ta: wff):
  $ ps $ >
  $ wi ph (wi (w3a ps ch th) ta) $ >
  $ wi ph (wi (wa ch th) ta) $;

--| An inference based on modus ponens. (Contributed by NM, 24-Feb-2005.)
theorem mp3anl1 (ph ps ch th ta: wff):
  $ ph $ >
  $ wi (wa (w3a ph ps ch) th) ta $ >
  $ wi (wa (wa ps ch) th) ta $;

--| An inference based on modus ponens. (Contributed by NM, 24-Feb-2005.)
theorem mp3anl2 (ph ps ch th ta: wff):
  $ ps $ >
  $ wi (wa (w3a ph ps ch) th) ta $ >
  $ wi (wa (wa ph ch) th) ta $;

--| An inference based on modus ponens. (Contributed by NM, 24-Feb-2005.)
theorem mp3anl3 (ph ps ch th ta: wff):
  $ ch $ >
  $ wi (wa (w3a ph ps ch) th) ta $ >
  $ wi (wa (wa ph ps) th) ta $;

--| An inference based on modus ponens. (Contributed by NM, 4-Nov-2006.)
theorem mp3anr1 (ph ps ch th ta: wff):
  $ ps $ >
  $ wi (wa ph (w3a ps ch th)) ta $ >
  $ wi (wa ph (wa ch th)) ta $;

--| An inference based on modus ponens. (Contributed by NM, 24-Nov-2006.)
theorem mp3anr2 (ph ps ch th ta: wff):
  $ ch $ >
  $ wi (wa ph (w3a ps ch th)) ta $ >
  $ wi (wa ph (wa ps th)) ta $;

--| An inference based on modus ponens. (Contributed by NM, 19-Oct-2007.)
theorem mp3anr3 (ph ps ch th ta: wff):
  $ th $ >
  $ wi (wa ph (w3a ps ch th)) ta $ >
  $ wi (wa ph (wa ps ch)) ta $;

--| An inference based on modus ponens. (Contributed by NM, 14-May-1999.)
theorem mp3an (ph ps ch th: wff):
  $ ph $ >
  $ ps $ >
  $ ch $ >
  $ wi (w3a ph ps ch) th $ >
  $ th $;

--| An inference based on modus ponens. (Contributed by NM, 8-Nov-2007.)
theorem mpd3an3 (ph ps ch th: wff):
  $ wi (wa ph ps) ch $ >
  $ wi (w3a ph ps ch) th $ >
  $ wi (wa ph ps) th $;

--| An inference based on modus ponens. (Contributed by NM, 4-Dec-2006.)
theorem mpd3an23 (ph ps ch th: wff):
  $ wi ph ps $ >
  $ wi ph ch $ >
  $ wi (w3a ph ps ch) th $ >
  $ wi ph th $;

--| Infer implication from a logical equivalence. Similar to ~ biimpa . (Contributed by NM, 4-Sep-2005.)
theorem biimp3a (ph ps ch th: wff):
  $ wi (wa ph ps) (wb ch th) $ >
  $ wi (w3a ph ps ch) th $;

--| Infer implication from a logical equivalence. Similar to ~ biimpar . (Contributed by NM, 2-Jan-2009.)
theorem biimp3ar (ph ps ch th: wff):
  $ wi (wa ph ps) (wb ch th) $ >
  $ wi (w3a ph ps th) ch $;

--| Inference that undistributes a triple conjunction in the antecedent. (Contributed by NM, 18-Apr-2007.)
theorem _3anandis (ph ps ch th ta: wff):
  $ wi (w3a (wa ph ps) (wa ph ch) (wa ph th)) ta $ >
  $ wi (wa ph (w3a ps ch th)) ta $;

--| Inference that undistributes a triple conjunction in the antecedent. (Contributed by NM, 25-Jul-2006.) (Revised by NM, 18-Apr-2007.)
theorem _3anandirs (ph ps ch th ta: wff):
  $ wi (w3a (wa ph th) (wa ps th) (wa ch th)) ta $ >
  $ wi (wa (w3a ph ps ch) th) ta $;

--| Deduction form of disjunctive syllogism. (Contributed by Jim Kingdon, 9-Dec-2017.)
theorem ecased (ph ps ch: wff):
  $ wi ph (wn ch) $ >
  $ wi ph (wo ps ch) $ >
  $ wi ph ps $;

--| Variation of ~ ecased with three disjuncts instead of two. (Contributed by NM, 22-Apr-1994.) (Revised by Jim Kingdon, 9-Dec-2017.)
theorem ecase23d (ph ps ch th: wff):
  $ wi ph (wn ch) $ >
  $ wi ph (wn th) $ >
  $ wi ph (w3o ps ch th) $ >
  $ wi ph ps $;

pure sort setvar;

--| Extend wff definition to include the universal quantifier ('for all'). ` A. x ph ` is read " ` ph ` (phi) is true for all ` x ` ." Typically, in its final application ` ph ` would be replaced with a wff containing a (free) occurrence of the variable ` x ` , for example ` x = y ` . In a universe with a finite number of objects, "for all" is equivalent to a big conjunction (AND) with one wff for each possible case of ` x ` . When the universe is infinite (as with set theory), such a propositional-calculus equivalent is not possible because an infinitely long formula has no meaning, but conceptually the idea is the same.
term wal {x: setvar} (ph: wff x): wff;

sort class;

--| This syntax construction states that a variable ` x ` , which has been declared to be a setvar variable by $f statement vx, is also a class expression. This can be justified informally as follows. We know that the class builder ` { y | y e. x } ` is a class by ~ cab . Since (when ` y ` is distinct from ` x ` ) we have ` x = { y | y e. x } ` by ~ cvjust , we can argue that the syntax " ` class x ` " can be viewed as an abbreviation for " ` class { y | y e. x } ` ". See the discussion under the definition of class in [Jech] p. 4 showing that "Every set can be considered to be a class." While it is tempting and perhaps occasionally useful to view ~ cv as a "type conversion" from a setvar variable to a class variable, keep in mind that ~ cv is intrinsically no different from any other class-building syntax such as ~ cab , ~ cun , or ~ c0 . For a general discussion of the theory of classes and the role of ~ cv , see ~ http://us.metamath.org/mpeuni/mmset.html#class . (The description above applies to set theory, not predicate calculus. The purpose of introducing ` class x ` here, and not in set theory where it belongs, is to allow us to express i.e. "prove" the ~ weq of predicate calculus from the ~ wceq of set theory, so that we don't overload the ` = ` connective with two syntax definitions. This is done to prevent ambiguity that would complicate some Metamath parsers.)
term cv (x1: setvar): class;

--| Extend wff definition to include class equality. For a general discussion of the theory of classes, see ~ http://us.metamath.org/mpeuni/mmset.html#class . (The purpose of introducing ` wff A = B ` here, and not in set theory where it belongs, is to allow us to express i.e. "prove" the ~ weq of predicate calculus in terms of the ~ wceq of set theory, so that we don't "overload" the ` = ` connective with two syntax definitions. This is done to prevent ambiguity that would complicate some Metamath parsers. For example, some parsers - although not the Metamath program - stumble on the fact that the ` = ` in ` x = y ` could be the ` = ` of either ~ weq or ~ wceq , although mathematically it makes no difference. The class variables ` A ` and ` B ` are introduced temporarily for the purpose of this definition but otherwise not used in predicate calculus. See ~ df-cleq for more information on the set theory usage of ~ wceq .)
term wceq (A B: class): wff;

--| ` T. ` is a wff.
term wtru: wff;

--| Soundness justification theorem for ~ df-tru . (Contributed by Mario Carneiro, 17-Nov-2013.) (Revised by NM, 11-Jul-2019.)
theorem trujust {x2 y: setvar}:
  $ wb (wi (wal x2 (wceq (cv x2) (cv x2))) (wal x2 (wceq (cv x2) (cv x2)))) (wi (wal y (wceq (cv y) (cv y))) (wal y (wceq (cv y) (cv y)))) $;

--| Definition of the truth value "true", or "verum", denoted by ` T. ` . This is a tautology, as proved by ~ tru . In this definition, an instance of ~ id is used as the definiens, although any tautology, such as an axiom, can be used in its place. This particular ~ id instance was chosen so this definition can be checked by the same algorithm that is used for predicate calculus. This definition should be referenced directly only by ~ tru , and other proofs should depend on ~ tru (directly or indirectly) instead of this definition, since there are many alternative ways to define ` T. ` . (Contributed by Anthony Hart, 13-Oct-2010.) (Revised by NM, 11-Jul-2019.) (New usage is discouraged.)
axiom df_tru {x2: setvar}:
  $ wb wtru (wi (wal x2 (wceq (cv x2) (cv x2))) (wal x2 (wceq (cv x2) (cv x2)))) $;

--| The truth value ` T. ` is provable. (Contributed by Anthony Hart, 13-Oct-2010.)
theorem tru:
  $ wtru $;

--| ` F. ` is a wff.
term wfal: wff;

--| Definition of the truth value "false", or "falsum", denoted by ` F. ` . See also ~ df-tru . (Contributed by Anthony Hart, 22-Oct-2010.)
axiom df_fal:
  $ wb wfal (wn wtru) $;

--| The truth value ` F. ` is refutable. (Contributed by Anthony Hart, 22-Oct-2010.) (Proof shortened by Mel L. O'Cat, 11-Mar-2012.)
theorem fal:
  $ wn wfal $;

--| An alternate definition of "true". (Contributed by Anthony Hart, 13-Oct-2010.) (Revised by BJ, 12-Jul-2019.) (New usage is discouraged.)
theorem dftru2 (ph: wff):
  $ wb wtru (wi ph ph) $;

--| Eliminate ` T. ` as an antecedent. A proposition implied by ` T. ` is true. (Contributed by Mario Carneiro, 13-Mar-2014.)
theorem trud (ph: wff):
  $ wi wtru ph $ >
  $ ph $;

--| A proposition is equivalent to itself being equivalent to ` T. ` . (Contributed by Anthony Hart, 14-Aug-2011.)
theorem tbtru (ph: wff):
  $ wb ph (wb ph wtru) $;

--| The negation of a proposition is equivalent to itself being equivalent to ` F. ` . (Contributed by Anthony Hart, 14-Aug-2011.)
theorem nbfal (ph: wff):
  $ wb (wn ph) (wb ph wfal) $;

--| A theorem is equivalent to truth. (Contributed by Mario Carneiro, 9-May-2015.)
theorem bitru (ph: wff):
  $ ph $ >
  $ wb ph wtru $;

--| A contradiction is equivalent to falsehood. (Contributed by Mario Carneiro, 9-May-2015.)
theorem bifal (ph: wff):
  $ wn ph $ >
  $ wb ph wfal $;

--| The truth value ` F. ` implies anything. Also called the principle of explosion, or "ex falso quodlibet". (Contributed by FL, 20-Mar-2011.) (Proof shortened by Anthony Hart, 1-Aug-2011.)
theorem falim (ph: wff):
  $ wi wfal ph $;

--| The truth value ` F. ` implies anything. (Contributed by Mario Carneiro, 9-Feb-2017.)
theorem falimd (ph ps: wff):
  $ wi (wa ph wfal) ps $;

--| Anything implies ` T. ` . (Contributed by FL, 20-Mar-2011.) (Proof shortened by Anthony Hart, 1-Aug-2011.)
theorem a1tru (ph: wff):
  $ wi ph wtru $;

--| True can be removed from a conjunction. (Contributed by FL, 20-Mar-2011.) (Proof shortened by Wolf Lammen, 21-Jul-2019.)
theorem truan (ph: wff):
  $ wb (wa wtru ph) ph $;

--| Obsolete proof of ~ truan as of 21-Jul-2019. (Contributed by FL, 20-Mar-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem truanOLD (ph: wff):
  $ wb (wa wtru ph) ph $;

--| Given falsum, we can define the negation of a wff ` ph ` as the statement that a contradiction follows from assuming ` ph ` . (Contributed by Mario Carneiro, 9-Feb-2017.) (Proof shortened by Wolf Lammen, 21-Jul-2019.)
theorem dfnot (ph: wff):
  $ wb (wn ph) (wi ph wfal) $;

--| Negation introduction rule from natural deduction. (Contributed by Mario Carneiro, 9-Feb-2017.)
theorem inegd (ph ps: wff):
  $ wi (wa ph ps) wfal $ >
  $ wi ph (wn ps) $;

--| If a wff and its negation are provable, then falsum is provable. (Contributed by Mario Carneiro, 9-Feb-2017.)
theorem pm2_21fal (ph ps: wff):
  $ wi ph ps $ >
  $ wi ph (wn ps) $ >
  $ wi ph wfal $;

--| Negation inferred from embedded conjunct. (Contributed by NM, 20-Aug-1993.) (Proof rewritten by Jim Kingdon, 4-May-2018.)
theorem pclem6 (ph ps: wff):
  $ wi (wb ph (wa ps (wn ph))) (wn ps) $;

--| Extend wff definition to include exclusive disjunction ('xor').
term wxo (ph ps: wff): wff;

--| Define exclusive disjunction (logical 'xor'). Return true if either the left or right, but not both, are true. Contrast with ` /\ ` ( ~ wa ), ` \/ ` ( ~ wo ), and ` -> ` ( ~ wi ) . (Contributed by FL, 22-Nov-2010.) (Modified by Jim Kingdon, 1-Mar-2018.)
axiom df_xor (ph ps: wff):
  $ wb (wxo ph ps) (wa (wo ph ps) (wn (wa ph ps))) $;

--| One way of defining exclusive or. Equivalent to ~ df-xor . (Contributed by Jim Kingdon and Mario Carneiro, 1-Mar-2018.)
theorem xoranor (ph ps: wff):
  $ wb (wxo ph ps) (wa (wo ph ps) (wo (wn ph) (wn ps))) $;

--| This tautology shows that xor is really exclusive. (Contributed by FL, 22-Nov-2010.) (Proof rewritten by Jim Kingdon, 5-May-2018.)
theorem excxor (ph ps: wff):
  $ wb (wxo ph ps) (wo (wa ph (wn ps)) (wa (wn ph) ps)) $;

--| XOR implies OR. (Contributed by BJ, 19-Apr-2019.)
theorem xoror (ph ps: wff):
  $ wi (wxo ph ps) (wo ph ps) $;

--| Deduction joining an equivalence and a left operand to form equivalence of exclusive-or. (Contributed by Jim Kingdon, 7-Oct-2018.)
theorem xorbi2d (ph ps ch th: wff):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wxo th ps) (wxo th ch)) $;

--| Deduction joining an equivalence and a right operand to form equivalence of exclusive-or. (Contributed by Jim Kingdon, 7-Oct-2018.)
theorem xorbi1d (ph ps ch th: wff):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wxo ps th) (wxo ch th)) $;

--| Deduction joining two equivalences to form equivalence of exclusive-or. (Contributed by Jim Kingdon, 7-Oct-2018.)
theorem xorbi12d (ph ps ch th ta: wff):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb th ta) $ >
  $ wi ph (wb (wxo ps th) (wxo ch ta)) $;

--| Equality property for XOR. (Contributed by Mario Carneiro, 4-Sep-2016.)
theorem xorbi12i (ph ps ch th: wff):
  $ wb ph ps $ >
  $ wb ch th $ >
  $ wb (wxo ph ch) (wxo ps th) $;

--| A consequence of exclusive or. In classical logic the converse also holds. (Contributed by Jim Kingdon, 8-Mar-2018.)
theorem xorbin (ph ps: wff):
  $ wi (wxo ph ps) (wb ph (wn ps)) $;

--| One direction of ~ pm5.18dc , which holds for all propositions, not just decidable propositions. (Contributed by Jim Kingdon, 10-Mar-2018.)
theorem pm5_18im (ph ps: wff):
  $ wi (wb ph ps) (wn (wb ph (wn ps))) $;

--| A consequence of exclusive or. For decidable propositions this is an equivalence, as seen at ~ xornbidc . (Contributed by Jim Kingdon, 10-Mar-2018.)
theorem xornbi (ph ps: wff):
  $ wi (wxo ph ps) (wn (wb ph ps)) $;

--| Two ways to express "exclusive or" between decidable propositions. (Contributed by Jim Kingdon, 12-Apr-2018.)
theorem xor3dc (ph ps: wff):
  $ wi (wdc ph) (wi (wdc ps) (wb (wn (wb ph ps)) (wb ph (wn ps)))) $;

--| ` \/_ ` is commutative. (Contributed by David A. Wheeler, 6-Oct-2018.)
theorem xorcom (ph ps: wff):
  $ wb (wxo ph ps) (wxo ps ph) $;

--| A decidable proposition is equivalent to a decidable proposition or its negation. Based on theorem *5.15 of [WhiteheadRussell] p. 124. (Contributed by Jim Kingdon, 18-Apr-2018.)
theorem pm5_15dc (ph ps: wff):
  $ wi (wdc ph) (wi (wdc ps) (wo (wb ph ps) (wb ph (wn ps)))) $;

--| Two ways to express "exclusive or" between decidable propositions. (Contributed by Jim Kingdon, 17-Apr-2018.)
theorem xor2dc (ph ps: wff):
  $ wi (wdc ph) (wi (wdc ps) (wb (wn (wb ph ps)) (wa (wo ph ps) (wn (wa ph ps))))) $;

--| Exclusive or is equivalent to negated biconditional for decidable propositions. (Contributed by Jim Kingdon, 27-Apr-2018.)
theorem xornbidc (ph ps: wff):
  $ wi (wdc ph) (wi (wdc ps) (wb (wxo ph ps) (wn (wb ph ps)))) $;

--| Two ways to express "exclusive or" between decidable propositions. Theorem *5.22 of [WhiteheadRussell] p. 124, but for decidable propositions. (Contributed by Jim Kingdon, 5-May-2018.)
theorem xordc (ph ps: wff):
  $ wi (wdc ph) (wi (wdc ps) (wb (wn (wb ph ps)) (wo (wa ph (wn ps)) (wa ps (wn ph))))) $;

--| Exclusive or implies the left proposition is decidable. (Contributed by Jim Kingdon, 12-Mar-2018.)
theorem xordc1 (ph ps: wff):
  $ wi (wxo ph ps) (wdc ph) $;

--| Move negation outside of biconditional, for decidable propositions. Compare Theorem *5.18 of [WhiteheadRussell] p. 124. (Contributed by Jim Kingdon, 18-Apr-2018.)
theorem nbbndc (ph ps: wff):
  $ wi (wdc ph) (wi (wdc ps) (wb (wb (wn ph) ps) (wn (wb ph ps)))) $;

--| Associative law for the biconditional, for decidable propositions. The classical version (without the decidability conditions) is an axiom of system DS in Vladimir Lifschitz, "On calculational proofs", Annals of Pure and Applied Logic, 113:207-224, 2002, ~ http://www.cs.utexas.edu/users/ai-lab/pub-view.php?PubID=26805 , and, interestingly, was not included in _Principia Mathematica_ but was apparently first noted by Jan Lukasiewicz circa 1923. (Contributed by Jim Kingdon, 4-May-2018.)
theorem biassdc (ph ps ch: wff):
  $ wi (wdc ph) (wi (wdc ps) (wi (wdc ch) (wb (wb (wb ph ps) ch) (wb ph (wb ps ch))))) $;

--| Lukasiewicz's shortest axiom for equivalential calculus (but modified to require decidable propositions). Storrs McCall, ed., _Polish Logic 1920-1939_ (Oxford, 1967), p. 96. (Contributed by Jim Kingdon, 5-May-2018.)
theorem bilukdc (ph ps ch: wff):
  $ wi (wa (wa (wdc ph) (wdc ps)) (wdc ch)) (wb (wb ph ps) (wb (wb ch ps) (wb ph ch))) $;

--| An alternate definition of the biconditional for decidable propositions. Theorem *5.23 of [WhiteheadRussell] p. 124, but with decidability conditions. (Contributed by Jim Kingdon, 5-May-2018.)
theorem dfbi3dc (ph ps: wff):
  $ wi (wdc ph) (wi (wdc ps) (wb (wb ph ps) (wo (wa ph ps) (wa (wn ph) (wn ps))))) $;

--| Theorem *5.24 of [WhiteheadRussell] p. 124, but for decidable propositions. (Contributed by Jim Kingdon, 5-May-2018.)
theorem pm5_24dc (ph ps: wff):
  $ wi (wdc ph) (wi (wdc ps) (wb (wn (wo (wa ph ps) (wa (wn ph) (wn ps)))) (wo (wa ph (wn ps)) (wa ps (wn ph))))) $;

--| Conjunction distributes over exclusive-or, for decidable propositions. This is one way to interpret the distributive law of multiplication over addition in modulo 2 arithmetic. (Contributed by Jim Kingdon, 14-Jul-2018.)
theorem xordidc (ph ps ch: wff):
  $ wi (wdc ph) (wi (wdc ps) (wi (wdc ch) (wb (wa ph (wxo ps ch)) (wxo (wa ph ps) (wa ph ch))))) $;

--| Conjunction distributes over exclusive-or. (Contributed by Mario Carneiro and Jim Kingdon, 7-Oct-2018.)
theorem anxordi (ph ps ch: wff):
  $ wb (wa ph (wxo ps ch)) (wxo (wa ph ps) (wa ph ch)) $;

--| A ` /\ ` identity. (Contributed by Anthony Hart, 22-Oct-2010.)
theorem truantru:
  $ wb (wa wtru wtru) wtru $;

--| A ` /\ ` identity. (Contributed by Anthony Hart, 22-Oct-2010.)
theorem truanfal:
  $ wb (wa wtru wfal) wfal $;

--| A ` /\ ` identity. (Contributed by David A. Wheeler, 23-Feb-2018.)
theorem falantru:
  $ wb (wa wfal wtru) wfal $;

--| A ` /\ ` identity. (Contributed by Anthony Hart, 22-Oct-2010.)
theorem falanfal:
  $ wb (wa wfal wfal) wfal $;

--| A ` \/ ` identity. (Contributed by Anthony Hart, 22-Oct-2010.) (Proof shortened by Andrew Salmon, 13-May-2011.)
theorem truortru:
  $ wb (wo wtru wtru) wtru $;

--| A ` \/ ` identity. (Contributed by Anthony Hart, 22-Oct-2010.)
theorem truorfal:
  $ wb (wo wtru wfal) wtru $;

--| A ` \/ ` identity. (Contributed by Anthony Hart, 22-Oct-2010.)
theorem falortru:
  $ wb (wo wfal wtru) wtru $;

--| A ` \/ ` identity. (Contributed by Anthony Hart, 22-Oct-2010.) (Proof shortened by Andrew Salmon, 13-May-2011.)
theorem falorfal:
  $ wb (wo wfal wfal) wfal $;

--| A ` -> ` identity. (Contributed by Anthony Hart, 22-Oct-2010.)
theorem truimtru:
  $ wb (wi wtru wtru) wtru $;

--| A ` -> ` identity. (Contributed by Anthony Hart, 22-Oct-2010.) (Proof shortened by Andrew Salmon, 13-May-2011.)
theorem truimfal:
  $ wb (wi wtru wfal) wfal $;

--| A ` -> ` identity. (Contributed by Anthony Hart, 22-Oct-2010.)
theorem falimtru:
  $ wb (wi wfal wtru) wtru $;

--| A ` -> ` identity. (Contributed by Anthony Hart, 22-Oct-2010.)
theorem falimfal:
  $ wb (wi wfal wfal) wtru $;

--| A ` -. ` identity. (Contributed by Anthony Hart, 22-Oct-2010.)
theorem nottru:
  $ wb (wn wtru) wfal $;

--| A ` -. ` identity. (Contributed by Anthony Hart, 22-Oct-2010.) (Proof shortened by Andrew Salmon, 13-May-2011.)
theorem notfal:
  $ wb (wn wfal) wtru $;

--| A ` <-> ` identity. (Contributed by Anthony Hart, 22-Oct-2010.) (Proof shortened by Andrew Salmon, 13-May-2011.)
theorem trubitru:
  $ wb (wb wtru wtru) wtru $;

--| A ` <-> ` identity. (Contributed by David A. Wheeler, 23-Feb-2018.)
theorem trubifal:
  $ wb (wb wtru wfal) wfal $;

--| A ` <-> ` identity. (Contributed by Anthony Hart, 22-Oct-2010.) (Proof shortened by Andrew Salmon, 13-May-2011.)
theorem falbitru:
  $ wb (wb wfal wtru) wfal $;

--| A ` <-> ` identity. (Contributed by Anthony Hart, 22-Oct-2010.) (Proof shortened by Andrew Salmon, 13-May-2011.)
theorem falbifal:
  $ wb (wb wfal wfal) wtru $;

--| A ` \/_ ` identity. (Contributed by David A. Wheeler, 2-Mar-2018.)
theorem truxortru:
  $ wb (wxo wtru wtru) wfal $;

--| A ` \/_ ` identity. (Contributed by David A. Wheeler, 2-Mar-2018.)
theorem truxorfal:
  $ wb (wxo wtru wfal) wtru $;

--| A ` \/_ ` identity. (Contributed by David A. Wheeler, 2-Mar-2018.)
theorem falxortru:
  $ wb (wxo wfal wtru) wtru $;

--| A ` \/_ ` identity. (Contributed by David A. Wheeler, 2-Mar-2018.)
theorem falxorfal:
  $ wb (wxo wfal wfal) wfal $;

--| Modus ponendo tollens 1, one of the "indemonstrables" in Stoic logic. See rule 1 on [Lopez-Astorga] p. 12 , rule 1 on [Sanford] p. 40, and rule A3 in [Hitchcock] p. 5. Sanford describes this rule second (after ~ mptxor ) as a "safer, and these days much more common" version of modus ponendo tollens because it avoids confusion between inclusive-or and exclusive-or. (Contributed by David A. Wheeler, 3-Jul-2016.)
theorem mptnan (ph ps: wff):
  $ ph $ >
  $ wn (wa ph ps) $ >
  $ wn ps $;

--| Modus ponendo tollens 2, one of the "indemonstrables" in Stoic logic. Note that this uses exclusive-or ` \/_ ` . See rule 2 on [Lopez-Astorga] p. 12 , rule 4 on [Sanford] p. 39 and rule A4 in [Hitchcock] p. 5 . (Contributed by David A. Wheeler, 2-Mar-2018.)
theorem mptxor (ph ps: wff):
  $ ph $ >
  $ wxo ph ps $ >
  $ wn ps $;

--| Modus tollendo ponens (inclusive-or version), aka disjunctive syllogism. This is similar to ~ mtpxor , one of the five original "indemonstrables" in Stoic logic. However, in Stoic logic this rule used exclusive-or, while the name modus tollendo ponens often refers to a variant of the rule that uses inclusive-or instead. The rule says, "if ` ph ` is not true, and ` ph ` or ` ps ` (or both) are true, then ` ps ` must be true." An alternative phrasing is, "Once you eliminate the impossible, whatever remains, no matter how improbable, must be the truth." -- Sherlock Holmes (Sir Arthur Conan Doyle, 1890: The Sign of the Four, ch. 6). (Contributed by David A. Wheeler, 3-Jul-2016.) (Proof shortened by Wolf Lammen, 11-Nov-2017.)
theorem mtpor (ph ps: wff):
  $ wn ph $ >
  $ wo ph ps $ >
  $ ps $;

--| Modus tollendo ponens (original exclusive-or version), aka disjunctive syllogism, similar to ~ mtpor , one of the five "indemonstrables" in Stoic logic. The rule says, "if ` ph ` is not true, and either ` ph ` or ` ps ` (exclusively) are true, then ` ps ` must be true." Today the name "modus tollendo ponens" often refers to a variant, the inclusive-or version as defined in ~ mtpor . See rule 3 on [Lopez-Astorga] p. 12 (note that the "or" is the same as ~ mptxor , that is, it is exclusive-or ~ df-xor ), rule 3 of [Sanford] p. 39 (where it is not as clearly stated which kind of "or" is used but it appears to be in the same sense as ~ mptxor ), and rule A5 in [Hitchcock] p. 5 (exclusive-or is expressly used). (Contributed by David A. Wheeler, 4-Jul-2016.) (Proof shortened by Wolf Lammen, 11-Nov-2017.) (Proof shortened by BJ, 19-Apr-2019.)
theorem mtpxor (ph ps: wff):
  $ wn ph $ >
  $ wxo ph ps $ >
  $ ps $;

--| Stoic logic Thema 2 version a. Statement T2 of [Bobzien] p. 117 shows a reconstructed version of Stoic logic thema 2 as follows: "When from two assertibles a third follows, and from the third and one (or both) of the two another follows, then this other follows from the first two." Bobzien uses constructs such as ` ph ` , ` ps |- ch ` ; in Metamath we will represent that construct as ` ph /\ ps -> ch ` . This version a is without the phrase "or both"; see ~ stoic2b for the version with the phrase "or both". We already have this rule as ~ syldan , so here we show the equivalence and discourage its use. (New usage is discouraged.) (Contributed by David A. Wheeler, 17-Feb-2019.)
theorem stoic2a (ph ps ch th: wff):
  $ wi (wa ph ps) ch $ >
  $ wi (wa ph ch) th $ >
  $ wi (wa ph ps) th $;

--| Stoic logic Thema 2 version b. See ~ stoic2a . Version b is with the phrase "or both". We already have this rule as ~ mpd3an3 , so here we prove the equivalence and discourage its use. (New usage is discouraged.) (Contributed by David A. Wheeler, 17-Feb-2019.)
theorem stoic2b (ph ps ch th: wff):
  $ wi (wa ph ps) ch $ >
  $ wi (w3a ph ps ch) th $ >
  $ wi (wa ph ps) th $;

--| Stoic logic Thema 3. Statement T3 of [Bobzien] p. 116-117 discusses Stoic logic thema 3. "When from two (assemblies) a third follows, and from the one that follows (i.e., the third) together with another, external external assumption, another follows, then other follows from the first two and the externally co-assumed one. (Simp. Cael. 237.2-4)" (Contributed by David A. Wheeler, 17-Feb-2019.)
theorem stoic3 (ph ps ch th ta: wff):
  $ wi (wa ph ps) ch $ >
  $ wi (wa ch th) ta $ >
  $ wi (w3a ph ps th) ta $;

--| Stoic logic Thema 4 version a. Statement T4 of [Bobzien] p. 117 shows a reconstructed version of Stoic logic thema 4: "When from two assertibles a third follows, and from the third and one (or both) of the two and one (or more) external assertible(s) another follows, then this other follows from the first two and the external(s)." We use ` th ` to represent the "external" assertibles. This is version a, which is without the phrase "or both"; see ~ stoic4b for the version with the phrase "or both". (Contributed by David A. Wheeler, 17-Feb-2019.)
theorem stoic4a (ph ps ch th ta: wff):
  $ wi (wa ph ps) ch $ >
  $ wi (w3a ch ph th) ta $ >
  $ wi (w3a ph ps th) ta $;

--| Stoic logic Thema 4 version b. This is version b, which is with the phrase "or both". See ~ stoic4a for more information. (Contributed by David A. Wheeler, 17-Feb-2019.)
theorem stoic4b (ph ps ch th ta: wff):
  $ wi (wa ph ps) ch $ >
  $ wi (wa (w3a ch ph ps) th) ta $ >
  $ wi (w3a ph ps th) ta $;

--| A syllogism deduction combined with conjoining antecedents. (Contributed by Alan Sare, 28-Oct-2011.)
theorem syl6an (ph ps ch th ta: wff):
  $ wi ph ps $ >
  $ wi ph (wi ch th) $ >
  $ wi (wa ps th) ta $ >
  $ wi ph (wi ch ta) $;

--| A nested syllogism inference. (Contributed by Alan Sare, 17-Jul-2011.)
theorem syl10 (ph ps ch th ta et: wff):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi ps (wi th ta)) $ >
  $ wi ch (wi ta et) $ >
  $ wi ph (wi ps (wi th et)) $;

--| Exportation implication also converting head from biconditional to conditional. (Contributed by Alan Sare, 31-Dec-2011.)
theorem exbir (ph ps ch th: wff):
  $ wi (wi (wa ph ps) (wb ch th)) (wi ph (wi ps (wi th ch))) $;

--| ~ impexp with a 3-conjunct antecedent. (Contributed by Alan Sare, 31-Dec-2011.)
theorem _3impexp (ph ps ch th: wff):
  $ wb (wi (w3a ph ps ch) th) (wi ph (wi ps (wi ch th))) $;

--| ~ 3impexp with biconditional consequent of antecedent that is commuted in consequent. (Contributed by Alan Sare, 31-Dec-2011.)
theorem _3impexpbicom (ph ps ch th ta: wff):
  $ wb (wi (w3a ph ps ch) (wb th ta)) (wi ph (wi ps (wi ch (wb ta th)))) $;

--| Deduction form of ~ 3impexpbicom . (Contributed by Alan Sare, 31-Dec-2011.)
theorem _3impexpbicomi (ph ps ch th ta: wff):
  $ wi (w3a ph ps ch) (wb th ta) $ >
  $ wi ph (wi ps (wi ch (wb ta th))) $;

--| Closed form of ~ ancoms . (Contributed by Alan Sare, 31-Dec-2011.)
theorem ancomsimp (ph ps ch: wff):
  $ wb (wi (wa ph ps) ch) (wi (wa ps ph) ch) $;

--| Deduction form of ~ expcom . (Contributed by Alan Sare, 22-Jul-2012.)
theorem expcomd (ph ps ch th: wff):
  $ wi ph (wi (wa ps ch) th) $ >
  $ wi ph (wi ch (wi ps th)) $;

--| Commuted form of ~ expd . (Contributed by Alan Sare, 18-Mar-2012.)
theorem expdcom (ph ps ch th: wff):
  $ wi ph (wi (wa ps ch) th) $ >
  $ wi ps (wi ch (wi ph th)) $;

--| Implication form of ~ simplbi2com . (Contributed by Alan Sare, 22-Jul-2012.)
theorem simplbi2comg (ph ps ch: wff):
  $ wi (wb ph (wa ps ch)) (wi ch (wi ps ph)) $;

--| A deduction eliminating a conjunct, similar to ~ simplbi2 . (Contributed by Alan Sare, 22-Jul-2012.) (Proof shortened by Wolf Lammen, 10-Nov-2012.)
theorem simplbi2com (ph ps ch: wff):
  $ wb ph (wa ps ch) $ >
  $ wi ch (wi ps ph) $;

--| A syllogism inference combined with contraction. (Contributed by Alan Sare, 18-Mar-2012.)
theorem syl6ci (ph ps ch th ta: wff):
  $ wi ph (wi ps ch) $ >
  $ wi ph th $ >
  $ wi ch (wi th ta) $ >
  $ wi ph (wi ps ta) $;

--| A syllogism combined with a modus ponens inference. (Contributed by Alan Sare, 25-Jul-2011.)
theorem mpisyl (ph ps ch th: wff):
  $ wi ph ps $ >
  $ ch $ >
  $ wi ps (wi ch th) $ >
  $ wi ph th $;

--| Axiom of Quantified Implication. Axiom C4 of [Monk2] p. 105. (Contributed by NM, 5-Aug-1993.)
axiom ax_5 {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wi ph ps)) (wi (wal x3 ph) (wal x3 ps)) $;

--| Axiom of Quantifier Commutation. This axiom says universal quantifiers can be swapped. One of the predicate logic axioms which do not involve equality. Axiom scheme C6' in [Megill] p. 448 (p. 16 of the preprint). Also appears as Lemma 12 of [Monk2] p. 109 and Axiom C5-3 of [Monk2] p. 113. (Contributed by NM, 5-Aug-1993.)
axiom ax_7 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wal y1 ph)) (wal y1 (wal x3 ph)) $;

--| Axiom of Quantifier Commutation. This axiom says universal quantifiers can be swapped. One of the predicate logic axioms which do not involve equality. Axiom scheme C6' in [Megill] p. 448 (p. 16 of the preprint). Also appears as Lemma 12 of [Monk2] p. 109 and Axiom C5-3 of [Monk2] p. 113. (Contributed by NM, 5-Aug-1993.)
axiom ax_7_b {x3: setvar} (ph: wff x3):
  $ wi (wal x3 (wal x3 ph)) (wal x3 (wal x3 ph)) $;

--| Rule of Generalization. The postulated inference rule of predicate calculus. See e.g. Rule 2 of [Hamilton] p. 74. This rule says that if something is unconditionally true, then it is true for all values of a variable. For example, if we have proved ` x = x ` , we can conclude ` A. x x = x ` or even ` A. y x = x ` . Theorem ~ spi shows we can go the other way also: in other words we can add or remove universal quantifiers from the beginning of any theorem as required. (Contributed by NM, 5-Aug-1993.)
axiom ax_gen {x3: setvar} (ph: wff x3):
  $ ph $ >
  $ wal x3 ph $;

--| Generalization applied twice. (Contributed by NM, 30-Apr-1998.)
theorem gen2 {x3 y1: setvar} (ph: wff x3 y1):
  $ ph $ >
  $ wal x3 (wal y1 ph) $;

--| Modus ponens combined with generalization. (Contributed by NM, 24-May-1994.)
theorem mpg {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 ph) ps $ >
  $ ph $ >
  $ ps $;

--| Modus ponens on biconditional combined with generalization. (Contributed by NM, 24-May-1994.) (Proof shortened by Stefan Allan, 28-Oct-2008.)
theorem mpgbi {x3: setvar} (ph ps: wff x3):
  $ wb (wal x3 ph) ps $ >
  $ ph $ >
  $ ps $;

--| Modus ponens on biconditional combined with generalization. (Contributed by NM, 24-May-1994.) (Proof shortened by Stefan Allan, 28-Oct-2008.)
theorem mpgbir {x3: setvar} (ph ps: wff x3):
  $ wb ph (wal x3 ps) $ >
  $ ps $ >
  $ ph $;

--| Swap quantifiers in an antecedent. (Contributed by NM, 5-Aug-1993.)
theorem a7s {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wal y1 ph)) ps $ >
  $ wi (wal y1 (wal x3 ph)) ps $;

--| Inference quantifying both antecedent and consequent. (Contributed by NM, 5-Aug-1993.)
theorem alimi {x3: setvar} (ph ps: wff x3):
  $ wi ph ps $ >
  $ wi (wal x3 ph) (wal x3 ps) $;

--| Inference doubly quantifying both antecedent and consequent. (Contributed by NM, 3-Feb-2005.)
theorem _2alimi {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph ps $ >
  $ wi (wal x3 (wal y1 ph)) (wal x3 (wal y1 ps)) $;

--| Theorem 19.20 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.) (Proof shortened by O'Cat, 30-Mar-2008.)
theorem alim {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wi ph ps)) (wi (wal x3 ph) (wal x3 ps)) $;

--| Inference quantifying antecedent, nested antecedent, and consequent. (Contributed by NM, 5-Aug-1993.)
theorem al2imi {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wi ps ch) $ >
  $ wi (wal x3 ph) (wi (wal x3 ps) (wal x3 ch)) $;

--| Variant of ~ al2imi with conjunctive antecedent. (Contributed by Andrew Salmon, 8-Jun-2011.)
theorem alanimi {x3: setvar} (ph ps ch: wff x3):
  $ wi (wa ph ps) ch $ >
  $ wi (wa (wal x3 ph) (wal x3 ps)) (wal x3 ch) $;

--| Extend wff definition to include the not-free predicate.
term wnf {x3: setvar} (ph: wff x3): wff;

--| Define the not-free predicate for wffs. This is read " ` x ` is not free in ` ph ` ". Not-free means that the value of ` x ` cannot affect the value of ` ph ` , e.g., any occurrence of ` x ` in ` ph ` is effectively bound by a "for all" or something that expands to one (such as "there exists"). In particular, substitution for a variable not free in a wff does not affect its value ( ~ sbf ). An example of where this is used is ~ stdpc5 . See ~ nf2 for an alternative definition which does not involve nested quantifiers on the same variable. Not-free is a commonly used constraint, so it is useful to have a notation for it. Surprisingly, there is no common formal notation for it, so here we devise one. Our definition lets us work with the not-free notion within the logic itself rather than as a metalogical side condition. To be precise, our definition really means "effectively not free," because it is slightly less restrictive than the usual textbook definition for not-free (which only considers syntactic freedom). For example, ` x ` is effectively not free in the bare expression ` x = x ` , even though ` x ` would be considered free in the usual textbook definition, because the value of ` x ` in the expression ` x = x ` cannot affect the truth of the expression (and thus substitution will not change the result). (Contributed by Mario Carneiro, 11-Aug-2016.)
axiom df_nf {x3: setvar} (ph: wff x3):
  $ wb (wnf x3 ph) (wal x3 (wi ph (wal x3 ph))) $;

--| Deduce that ` x ` is not free in ` ph ` from the definition. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfi {x3: setvar} (ph: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wnf x3 ph $;

--| No variable is (effectively) free in a theorem. This and later "hypothesis-building" lemmas, with labels starting "hb...", allow us to construct proofs of formulas of the form ` |- ( ph -> A. x ph ) ` from smaller formulas of this form. These are useful for constructing hypotheses that state " ` x ` is (effectively) not free in ` ph ` ." (Contributed by NM, 5-Aug-1993.)
theorem hbth {x3: setvar} (ph: wff x3):
  $ ph $ >
  $ wi ph (wal x3 ph) $;

--| No variable is (effectively) free in a theorem. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfth {x3: setvar} (ph: wff x3):
  $ ph $ >
  $ wnf x3 ph $;

--| No variable is (effectively) free in a non-theorem. (Contributed by Mario Carneiro, 6-Dec-2016.)
theorem nfnth {x3: setvar} (ph: wff x3):
  $ wn ph $ >
  $ wnf x3 ph $;

--| The true constant has no free variables. (This can also be proven in one step with ~ nfv , but this proof does not use ~ ax-17 .) (Contributed by Mario Carneiro, 6-Oct-2016.)
theorem nftru {x3: setvar}:
  $ wnf x3 wtru $;

--| Deduction from Theorem 19.20 of [Margaris] p. 90. (Contributed by NM, 4-Jan-2002.)
theorem alimdh {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wal x3 ps) (wal x3 ch)) $;

--| Theorem 19.15 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.)
theorem albi {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wb ph ps)) (wb (wal x3 ph) (wal x3 ps)) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.) (New usage is discouraged.)
theorem alrimih {x3: setvar} (ph ps: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph ps $ >
  $ wi ph (wal x3 ps) $;

--| Inference adding universal quantifier to both sides of an equivalence. (Contributed by NM, 7-Aug-1994.)
theorem albii {x3: setvar} (ph ps: wff x3):
  $ wb ph ps $ >
  $ wb (wal x3 ph) (wal x3 ps) $;

--| Inference adding 2 universal quantifiers to both sides of an equivalence. (Contributed by NM, 9-Mar-1997.)
theorem _2albii {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb ph ps $ >
  $ wb (wal x3 (wal y1 ph)) (wal x3 (wal y1 ps)) $;

--| A utility lemma to transfer a bound-variable hypothesis builder into a definition. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem hbxfrbi {x3: setvar} (ph ps: wff x3):
  $ wb ph ps $ >
  $ wi ps (wal x3 ps) $ >
  $ wi ph (wal x3 ph) $;

--| Equality theorem for not-free. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfbii {x3: setvar} (ph ps: wff x3):
  $ wb ph ps $ >
  $ wb (wnf x3 ph) (wnf x3 ps) $;

--| A utility lemma to transfer a bound-variable hypothesis builder into a definition. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfxfr {x3: setvar} (ph ps: wff x3):
  $ wb ph ps $ >
  $ wnf x3 ps $ >
  $ wnf x3 ph $;

--| A utility lemma to transfer a bound-variable hypothesis builder into a definition. (Contributed by Mario Carneiro, 24-Sep-2016.)
theorem nfxfrd {x3: setvar} (ph ps ch: wff x3):
  $ wb ph ps $ >
  $ wi ch (wnf x3 ps) $ >
  $ wi ch (wnf x3 ph) $;

--| Swap quantifiers in an antecedent. (Contributed by NM, 11-May-1993.)
theorem alcoms {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wal y1 ph)) ps $ >
  $ wi (wal y1 (wal x3 ph)) ps $;

--| If ` x ` is not free in ` ph ` , it is not free in ` A. y ph ` . (Contributed by NM, 5-Aug-1993.)
theorem hbal {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi (wal y1 ph) (wal x3 (wal y1 ph)) $;

--| Theorem 19.5 of [Margaris] p. 89. (Contributed by NM, 5-Aug-1993.)
theorem alcom {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wal x3 (wal y1 ph)) (wal y1 (wal x3 ph)) $;

--| Deduction from Theorem 19.21 of [Margaris] p. 90. (Contributed by NM, 10-Feb-1997.) (Proof shortened by Andrew Salmon, 13-May-2011.)
theorem alrimdh {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ps (wal x3 ps) $ >
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi ps (wal x3 ch)) $;

--| Formula-building rule for universal quantifier (deduction rule). (Contributed by NM, 5-Aug-1993.)
theorem albidh {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wal x3 ps) (wal x3 ch)) $;

--| Theorem 19.26 of [Margaris] p. 90. Also Theorem *10.22 of [WhiteheadRussell] p. 119. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Wolf Lammen, 4-Jul-2014.)
theorem _19_26 {x3: setvar} (ph ps: wff x3):
  $ wb (wal x3 (wa ph ps)) (wa (wal x3 ph) (wal x3 ps)) $;

--| Theorem 19.26 of [Margaris] p. 90 with two quantifiers. (Contributed by NM, 3-Feb-2005.)
theorem _19_26_2 {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb (wal x3 (wal y1 (wa ph ps))) (wa (wal x3 (wal y1 ph)) (wal x3 (wal y1 ps))) $;

--| Theorem 19.26 of [Margaris] p. 90 with triple conjunction. (Contributed by NM, 13-Sep-2011.)
theorem _19_26_3an {x3: setvar} (ph ps ch: wff x3):
  $ wb (wal x3 (w3a ph ps ch)) (w3a (wal x3 ph) (wal x3 ps) (wal x3 ch)) $;

--| Theorem 19.33 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.)
theorem _19_33 {x3: setvar} (ph ps: wff x3):
  $ wi (wo (wal x3 ph) (wal x3 ps)) (wal x3 (wo ph ps)) $;

--| Theorem *11.21 in [WhiteheadRussell] p. 160. (Contributed by Andrew Salmon, 24-May-2011.)
theorem alrot3 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wb (wal x3 (wal y1 (wal z ph))) (wal y1 (wal z (wal x3 ph))) $;

--| Rotate 4 universal quantifiers twice. (Contributed by NM, 2-Feb-2005.) (Proof shortened by Wolf Lammen, 28-Jun-2014.)
theorem alrot4 {x3 y1 z w: setvar} (ph: wff x3 y1 z w):
  $ wb (wal x3 (wal y1 (wal z (wal w ph)))) (wal z (wal w (wal x3 (wal y1 ph)))) $;

--| Split a biconditional and distribute quantifier. (Contributed by NM, 18-Aug-1993.)
theorem albiim {x3: setvar} (ph ps: wff x3):
  $ wb (wal x3 (wb ph ps)) (wa (wal x3 (wi ph ps)) (wal x3 (wi ps ph))) $;

--| Split a biconditional and distribute 2 quantifiers. (Contributed by NM, 3-Feb-2005.)
theorem _2albiim {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb (wal x3 (wal y1 (wb ph ps))) (wa (wal x3 (wal y1 (wi ph ps))) (wal x3 (wal y1 (wi ps ph)))) $;

--| Deduction form of bound-variable hypothesis builder ~ hban . (Contributed by NM, 2-Jan-2002.)
theorem hband {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wi ps (wal x3 ps)) $ >
  $ wi ph (wi ch (wal x3 ch)) $ >
  $ wi ph (wi (wa ps ch) (wal x3 (wa ps ch))) $;

--| Deduction form of bound-variable hypothesis builder ~ hb3an . (Contributed by NM, 17-Feb-2013.)
theorem hb3and {x3: setvar} (ph ps ch th: wff x3):
  $ wi ph (wi ps (wal x3 ps)) $ >
  $ wi ph (wi ch (wal x3 ch)) $ >
  $ wi ph (wi th (wal x3 th)) $ >
  $ wi ph (wi (w3a ps ch th) (wal x3 (w3a ps ch th))) $;

--| Deduction form of bound-variable hypothesis builder ~ hbal . (Contributed by NM, 2-Jan-2002.)
theorem hbald {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wi ps (wal x3 ps)) $ >
  $ wi ph (wi (wal y1 ps) (wal x3 (wal y1 ps))) $;

--| Extend wff definition to include the existential quantifier ("there exists").
term wex {x3: setvar} (ph: wff x3): wff;

--| ` x ` is bound in ` E. x ph ` . One of the axioms of predicate logic. (Contributed by Mario Carneiro, 31-Jan-2015.)
axiom ax_ie1 {x3: setvar} (ph: wff x3):
  $ wi (wex x3 ph) (wal x3 (wex x3 ph)) $;

--| Define existential quantification. ` E. x ph ` means "there exists at least one set ` x ` such that ` ph ` is true." One of the axioms of predicate logic. (Contributed by Mario Carneiro, 31-Jan-2015.)
axiom ax_ie2 {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wi ps (wal x3 ps))) (wb (wal x3 (wi ph ps)) (wi (wex x3 ph) ps)) $;

--| ` x ` is not free in ` E. x ph ` . (Contributed by NM, 5-Aug-1993.)
theorem hbe1 {x3: setvar} (ph: wff x3):
  $ wi (wex x3 ph) (wal x3 (wex x3 ph)) $;

--| ` x ` is not free in ` E. x ph ` . (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfe1 {x3: setvar} (ph: wff x3):
  $ wnf x3 (wex x3 ph) $;

--| Closed form of Theorem 19.23 of [Margaris] p. 90. (Contributed by NM, 7-Nov-2005.) (Revised by Mario Carneiro, 1-Feb-2015.)
theorem _19_23ht {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wi ps (wal x3 ps))) (wb (wal x3 (wi ph ps)) (wi (wex x3 ph) ps)) $;

--| Theorem 19.23 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 1-Feb-2015.)
theorem _19_23h {x3: setvar} (ph ps: wff x3):
  $ wi ps (wal x3 ps) $ >
  $ wb (wal x3 (wi ph ps)) (wi (wex x3 ph) ps) $;

--| Theorem 19.7 of [Margaris] p. 89. To read this intuitionistically, think of it as "if ` ph ` can be refuted for all ` x ` , then it is not possible to find an ` x ` for which ` ph ` holds" (and likewise for the converse). Comparing this with ~ dfexdc illustrates that statements which look similar (to someone used to classical logic) can be different intuitionistically due to different placement of negations. (Contributed by NM, 5-Aug-1993.) (Revised by NM, 1-Feb-2015.) (Revised by Mario Carneiro, 12-May-2015.)
theorem alnex {x3: setvar} (ph: wff x3):
  $ wb (wal x3 (wn ph)) (wn (wex x3 ph)) $;

--| Generalization rule for negated wff. (Contributed by NM, 18-May-1994.)
theorem nex {x3: setvar} (ph: wff x3):
  $ wn ph $ >
  $ wn (wex x3 ph) $;

--| Defining ` E. x ph ` given decidability. It is common in classical logic to define ` E. x ph ` as ` -. A. x -. ph ` but in intuitionistic logic without a decidability condition, that is only an implication not an equivalence, as seen at ~ exalim . (Contributed by Jim Kingdon, 15-Mar-2018.)
theorem dfexdc {x3: setvar} (ph: wff x3):
  $ wi (wdc (wex x3 ph)) (wb (wex x3 ph) (wn (wal x3 (wn ph)))) $;

--| One direction of a classical definition of existential quantification. One direction of Definition of [Margaris] p. 49. For a decidable proposition, this is an equivalence, as seen as ~ dfexdc . (Contributed by Jim Kingdon, 29-Jul-2018.)
theorem exalim {x3: setvar} (ph: wff x3):
  $ wi (wex x3 ph) (wn (wal x3 (wn ph))) $;

--| Extend wff definition to include the membership connective between classes. (The purpose of introducing ` wff A e. B ` here is to allow us to express i.e. "prove" the ~ wel of predicate calculus in terms of the ~ wceq of set theory, so that we don't "overload" the ` e. ` connective with two syntax definitions. This is done to prevent ambiguity that would complicate some Metamath parsers. The class variables ` A ` and ` B ` are introduced temporarily for the purpose of this definition but otherwise not used in predicate calculus.)
term wcel (A1 B1: class): wff;

--| Axiom of Equality. One of the equality and substitution axioms of predicate calculus with equality. This is similar to, but not quite, a transitive law for equality (proved later as ~ equtr ). Axiom scheme C8' in [Megill] p. 448 (p. 16 of the preprint). Also appears as Axiom C7 of [Monk2] p. 105. Axioms ~ ax-8 through ~ ax-16 are the axioms having to do with equality, substitution, and logical properties of our binary predicate ` e. ` (which later in set theory will mean "is a member of"). Note that all axioms except ~ ax-16 and ~ ax-17 are still valid even when ` x ` , ` y ` , and ` z ` are replaced with the same variable because they do not have any distinct variable (Metamath's $d) restrictions. Distinct variable restrictions are required for ~ ax-16 and ~ ax-17 only. (Contributed by NM, 5-Aug-1993.)
axiom ax_8 (x3 y1 z: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wi (wceq (cv x3) (cv z)) (wceq (cv y1) (cv z))) $;

--| Axiom of Equality. One of the equality and substitution axioms of predicate calculus with equality. This is similar to, but not quite, a transitive law for equality (proved later as ~ equtr ). Axiom scheme C8' in [Megill] p. 448 (p. 16 of the preprint). Also appears as Axiom C7 of [Monk2] p. 105. Axioms ~ ax-8 through ~ ax-16 are the axioms having to do with equality, substitution, and logical properties of our binary predicate ` e. ` (which later in set theory will mean "is a member of"). Note that all axioms except ~ ax-16 and ~ ax-17 are still valid even when ` x ` , ` y ` , and ` z ` are replaced with the same variable because they do not have any distinct variable (Metamath's $d) restrictions. Distinct variable restrictions are required for ~ ax-16 and ~ ax-17 only. (Contributed by NM, 5-Aug-1993.)
axiom ax_8_b (x3: setvar):
  $ wi (wceq (cv x3) (cv x3)) (wi (wceq (cv x3) (cv x3)) (wceq (cv x3) (cv x3))) $;

--| Axiom of Equality. One of the equality and substitution axioms of predicate calculus with equality. This is similar to, but not quite, a transitive law for equality (proved later as ~ equtr ). Axiom scheme C8' in [Megill] p. 448 (p. 16 of the preprint). Also appears as Axiom C7 of [Monk2] p. 105. Axioms ~ ax-8 through ~ ax-16 are the axioms having to do with equality, substitution, and logical properties of our binary predicate ` e. ` (which later in set theory will mean "is a member of"). Note that all axioms except ~ ax-16 and ~ ax-17 are still valid even when ` x ` , ` y ` , and ` z ` are replaced with the same variable because they do not have any distinct variable (Metamath's $d) restrictions. Distinct variable restrictions are required for ~ ax-16 and ~ ax-17 only. (Contributed by NM, 5-Aug-1993.)
axiom ax_8_b1 (x3 y1: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wi (wceq (cv x3) (cv x3)) (wceq (cv y1) (cv x3))) $;

--| Axiom of Equality. One of the equality and substitution axioms of predicate calculus with equality. This is similar to, but not quite, a transitive law for equality (proved later as ~ equtr ). Axiom scheme C8' in [Megill] p. 448 (p. 16 of the preprint). Also appears as Axiom C7 of [Monk2] p. 105. Axioms ~ ax-8 through ~ ax-16 are the axioms having to do with equality, substitution, and logical properties of our binary predicate ` e. ` (which later in set theory will mean "is a member of"). Note that all axioms except ~ ax-16 and ~ ax-17 are still valid even when ` x ` , ` y ` , and ` z ` are replaced with the same variable because they do not have any distinct variable (Metamath's $d) restrictions. Distinct variable restrictions are required for ~ ax-16 and ~ ax-17 only. (Contributed by NM, 5-Aug-1993.)
axiom ax_8_b2 (x3 y1: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wi (wceq (cv x3) (cv y1)) (wceq (cv y1) (cv y1))) $;

--| Axiom of Quantifier Substitution. One of the equality and substitution axioms of predicate calculus with equality. Appears as Lemma L12 in [Megill] p. 445 (p. 12 of the preprint). The original version of this axiom was ~ ax-10o ("o" for "old") and was replaced with this shorter ~ ax-10 in May 2008. The old axiom is proved from this one as theorem ~ ax10o . Conversely, this axiom is proved from ~ ax-10o as theorem ~ ax10 . (Contributed by NM, 5-Aug-1993.)
axiom ax_10 {x3 y1: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal y1 (wceq (cv y1) (cv x3))) $;

--| Axiom of Quantifier Substitution. One of the equality and substitution axioms of predicate calculus with equality. Appears as Lemma L12 in [Megill] p. 445 (p. 12 of the preprint). The original version of this axiom was ~ ax-10o ("o" for "old") and was replaced with this shorter ~ ax-10 in May 2008. The old axiom is proved from this one as theorem ~ ax10o . Conversely, this axiom is proved from ~ ax-10o as theorem ~ ax10 . (Contributed by NM, 5-Aug-1993.)
axiom ax_10_b {x3: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv x3))) (wal x3 (wceq (cv x3) (cv x3))) $;

--| Axiom of Variable Substitution. One of the 5 equality axioms of predicate calculus. The final consequent ` A. x ( x = y -> ph ) ` is a way of expressing " ` y ` substituted for ` x ` in wff ` ph ` " (cf. ~ sb6 ). It is based on Lemma 16 of [Tarski] p. 70 and Axiom C8 of [Monk2] p. 105, from which it can be proved by cases. Variants of this axiom which are equivalent in classical logic but which have not been shown to be equivalent for intuitionistic logic are ~ ax11v , ~ ax11v2 and ~ ax-11o . (Contributed by NM, 5-Aug-1993.)
axiom ax_11 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wi (wal y1 ph) (wal x3 (wi (wceq (cv x3) (cv y1)) ph))) $;

--| Axiom of Variable Substitution. One of the 5 equality axioms of predicate calculus. The final consequent ` A. x ( x = y -> ph ) ` is a way of expressing " ` y ` substituted for ` x ` in wff ` ph ` " (cf. ~ sb6 ). It is based on Lemma 16 of [Tarski] p. 70 and Axiom C8 of [Monk2] p. 105, from which it can be proved by cases. Variants of this axiom which are equivalent in classical logic but which have not been shown to be equivalent for intuitionistic logic are ~ ax11v , ~ ax11v2 and ~ ax-11o . (Contributed by NM, 5-Aug-1993.)
axiom ax_11_b {x3: setvar} (ph: wff x3):
  $ wi (wceq (cv x3) (cv x3)) (wi (wal x3 ph) (wal x3 (wi (wceq (cv x3) (cv x3)) ph))) $;

--| Axiom of Quantifier Introduction. One of the equality and substitution axioms of predicate calculus with equality. Informally, it says that whenever ` z ` is distinct from ` x ` and ` y ` , and ` x = y ` is true, then ` x = y ` quantified with ` z ` is also true. In other words, ` z ` is irrelevant to the truth of ` x = y ` . Axiom scheme C9' in [Megill] p. 448 (p. 16 of the preprint). It apparently does not otherwise appear in the literature but is easily proved from textbook predicate calculus by cases. This axiom has been modified from the original ~ ax-12 for compatibility with intuitionistic logic. (Contributed by Mario Carneiro, 31-Jan-2015.)
axiom ax_i12 {z: setvar} (x3 y1: setvar):
  $ wo (wal z (wceq (cv z) (cv x3))) (wo (wal z (wceq (cv z) (cv y1))) (wal z (wi (wceq (cv x3) (cv y1)) (wal z (wceq (cv x3) (cv y1)))))) $;

--| Axiom of Quantifier Introduction. One of the equality and substitution axioms of predicate calculus with equality. Informally, it says that whenever ` z ` is distinct from ` x ` and ` y ` , and ` x = y ` is true, then ` x = y ` quantified with ` z ` is also true. In other words, ` z ` is irrelevant to the truth of ` x = y ` . Axiom scheme C9' in [Megill] p. 448 (p. 16 of the preprint). It apparently does not otherwise appear in the literature but is easily proved from textbook predicate calculus by cases. This axiom has been modified from the original ~ ax-12 for compatibility with intuitionistic logic. (Contributed by Mario Carneiro, 31-Jan-2015.)
axiom ax_i12_b {z: setvar}:
  $ wo (wal z (wceq (cv z) (cv z))) (wo (wal z (wceq (cv z) (cv z))) (wal z (wi (wceq (cv z) (cv z)) (wal z (wceq (cv z) (cv z)))))) $;

--| Axiom of Quantifier Introduction. One of the equality and substitution axioms of predicate calculus with equality. Informally, it says that whenever ` z ` is distinct from ` x ` and ` y ` , and ` x = y ` is true, then ` x = y ` quantified with ` z ` is also true. In other words, ` z ` is irrelevant to the truth of ` x = y ` . Axiom scheme C9' in [Megill] p. 448 (p. 16 of the preprint). It apparently does not otherwise appear in the literature but is easily proved from textbook predicate calculus by cases. This axiom has been modified from the original ~ ax-12 for compatibility with intuitionistic logic. (Contributed by Mario Carneiro, 31-Jan-2015.)
axiom ax_i12_b1 {z: setvar} (x3: setvar):
  $ wo (wal z (wceq (cv z) (cv x3))) (wo (wal z (wceq (cv z) (cv x3))) (wal z (wi (wceq (cv x3) (cv x3)) (wal z (wceq (cv x3) (cv x3)))))) $;

--| Axiom of Quantifier Introduction. One of the equality and substitution axioms of predicate calculus with equality. Informally, it says that whenever ` z ` is distinct from ` x ` and ` y ` , and ` x = y ` is true, then ` x = y ` quantified with ` z ` is also true. In other words, ` z ` is irrelevant to the truth of ` x = y ` . Axiom scheme C9' in [Megill] p. 448 (p. 16 of the preprint). It apparently does not otherwise appear in the literature but is easily proved from textbook predicate calculus by cases. This axiom has been modified from the original ~ ax-12 for compatibility with intuitionistic logic. (Contributed by Mario Carneiro, 31-Jan-2015.)
axiom ax_i12_b2 {z: setvar} (y1: setvar):
  $ wo (wal z (wceq (cv z) (cv z))) (wo (wal z (wceq (cv z) (cv y1))) (wal z (wi (wceq (cv z) (cv y1)) (wal z (wceq (cv z) (cv y1)))))) $;

--| Axiom of Quantifier Introduction. One of the equality and substitution axioms of predicate calculus with equality. Informally, it says that whenever ` z ` is distinct from ` x ` and ` y ` , and ` x = y ` is true, then ` x = y ` quantified with ` z ` is also true. In other words, ` z ` is irrelevant to the truth of ` x = y ` . Axiom scheme C9' in [Megill] p. 448 (p. 16 of the preprint). It apparently does not otherwise appear in the literature but is easily proved from textbook predicate calculus by cases. This axiom has been modified from the original ~ ax-12 for compatibility with intuitionistic logic. (Contributed by Mario Carneiro, 31-Jan-2015.)
axiom ax_i12_b3 {z: setvar} (x3: setvar):
  $ wo (wal z (wceq (cv z) (cv x3))) (wo (wal z (wceq (cv z) (cv z))) (wal z (wi (wceq (cv x3) (cv z)) (wal z (wceq (cv x3) (cv z)))))) $;

--| Axiom of bundling. The general idea of this axiom is that two variables are either distinct or non-distinct. That idea could be expressed as ` A. z z = x \/ -. A. z z = x ` . However, we instead choose an axiom which has many of the same consequences, but which is different with respect to a universe which contains only one object. ` A. z z = x ` holds if ` z ` and ` x ` are the same variable, likewise for ` z ` and ` y ` , and ` A. x A. z ( x = y -> A. z x = y ) ` holds if ` z ` is distinct from the others (and the universe has at least two objects). As with other statements of the form "x is decidable (either true or false)", this does not entail the full Law of the Excluded Middle (which is the proposition that all statements are decidable), but instead merely the assertion that particular kinds of statements are decidable (or in this case, an assertion similar to decidability). This axiom implies ~ ax-i12 as can be seen at ~ axi12 . Whether ~ ax-bndl can be proved from the remaining axioms including ~ ax-i12 is not known. The reason we call this "bundling" is that a statement without a distinct variable constraint "bundles" together two statements, one in which the two variables are the same and one in which they are different. (Contributed by Mario Carneiro and Jim Kingdon, 14-Mar-2018.)
axiom ax_bndl {x3 z: setvar} (y1: setvar):
  $ wo (wal z (wceq (cv z) (cv x3))) (wo (wal z (wceq (cv z) (cv y1))) (wal x3 (wal z (wi (wceq (cv x3) (cv y1)) (wal z (wceq (cv x3) (cv y1))))))) $;

--| Axiom of Specialization. A quantified wff implies the wff without a quantifier (i.e. an instance, or special case, of the generalized wff). In other words if something is true for all ` x ` , it is true for any specific ` x ` (that would typically occur as a free variable in the wff substituted for ` ph ` ). (A free variable is one that does not occur in the scope of a quantifier: ` x ` and ` y ` are both free in ` x = y ` , but only ` x ` is free in ` A. y x = y ` .) Axiom scheme C5' in [Megill] p. 448 (p. 16 of the preprint). Also appears as Axiom B5 of [Tarski] p. 67 (under his system S2, defined in the last paragraph on p. 77). Note that the converse of this axiom does not hold in general, but a weaker inference form of the converse holds and is expressed as rule ~ ax-gen . Conditional forms of the converse are given by ~ ax-12 , ~ ax-16 , and ~ ax-17 . Unlike the more general textbook Axiom of Specialization, we cannot choose a variable different from ` x ` for the special case. For use, that requires the assistance of equality axioms, and we deal with it later after we introduce the definition of proper substitution - see ~ stdpc4 . (Contributed by NM, 5-Aug-1993.)
axiom ax_4 {x3: setvar} (ph: wff x3):
  $ wi (wal x3 ph) ph $;

--| Specialization. Another name for ~ ax-4 . (Contributed by NM, 21-May-2008.)
theorem sp {x3: setvar} (ph: wff x3):
  $ wi (wal x3 ph) ph $;

--| Rederive the original version of the axiom from ~ ax-i12 . (Contributed by Mario Carneiro, 3-Feb-2015.)
theorem ax_12 {z: setvar} (x3 y1: setvar):
  $ wi (wn (wal z (wceq (cv z) (cv x3)))) (wi (wn (wal z (wceq (cv z) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wal z (wceq (cv x3) (cv y1))))) $;

--| Another name for ~ ax-i12 . (Contributed by NM, 3-Feb-2015.)
theorem ax12or {z: setvar} (x3 y1: setvar):
  $ wo (wal z (wceq (cv z) (cv x3))) (wo (wal z (wceq (cv z) (cv y1))) (wal z (wi (wceq (cv x3) (cv y1)) (wal z (wceq (cv x3) (cv y1)))))) $;

--| Another name for ~ ax-i12 . (Contributed by NM, 3-Feb-2015.)
theorem ax12or_b {z: setvar}:
  $ wo (wal z (wceq (cv z) (cv z))) (wo (wal z (wceq (cv z) (cv z))) (wal z (wi (wceq (cv z) (cv z)) (wal z (wceq (cv z) (cv z)))))) $;

--| Another name for ~ ax-i12 . (Contributed by NM, 3-Feb-2015.)
theorem ax12or_b1 {z: setvar} (x3: setvar):
  $ wo (wal z (wceq (cv z) (cv x3))) (wo (wal z (wceq (cv z) (cv x3))) (wal z (wi (wceq (cv x3) (cv x3)) (wal z (wceq (cv x3) (cv x3)))))) $;

--| Another name for ~ ax-i12 . (Contributed by NM, 3-Feb-2015.)
theorem ax12or_b2 {z: setvar} (y1: setvar):
  $ wo (wal z (wceq (cv z) (cv z))) (wo (wal z (wceq (cv z) (cv y1))) (wal z (wi (wceq (cv z) (cv y1)) (wal z (wceq (cv z) (cv y1)))))) $;

--| Another name for ~ ax-i12 . (Contributed by NM, 3-Feb-2015.)
theorem ax12or_b3 {z: setvar} (x3: setvar):
  $ wo (wal z (wceq (cv z) (cv x3))) (wo (wal z (wceq (cv z) (cv z))) (wal z (wi (wceq (cv x3) (cv z)) (wal z (wceq (cv x3) (cv z)))))) $;

--| Axiom of Equality. One of the equality and substitution axioms for a non-logical predicate in our predicate calculus with equality. It substitutes equal variables into the left-hand side of the ` e. ` binary predicate. Axiom scheme C12' in [Megill] p. 448 (p. 16 of the preprint). It is a special case of Axiom B8 (p. 75) of system S2 of [Tarski] p. 77. "Non-logical" means that the predicate is not a primitive of predicate calculus proper but instead is an extension to it. "Binary" means that the predicate has two arguments. In a system of predicate calculus with equality, like ours, equality is not usually considered to be a non-logical predicate. In systems of predicate calculus without equality, it typically would be. (Contributed by NM, 5-Aug-1993.)
axiom ax_13 (x3 y1 z: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wi (wcel (cv x3) (cv z)) (wcel (cv y1) (cv z))) $;

--| Axiom of Equality. One of the equality and substitution axioms for a non-logical predicate in our predicate calculus with equality. It substitutes equal variables into the left-hand side of the ` e. ` binary predicate. Axiom scheme C12' in [Megill] p. 448 (p. 16 of the preprint). It is a special case of Axiom B8 (p. 75) of system S2 of [Tarski] p. 77. "Non-logical" means that the predicate is not a primitive of predicate calculus proper but instead is an extension to it. "Binary" means that the predicate has two arguments. In a system of predicate calculus with equality, like ours, equality is not usually considered to be a non-logical predicate. In systems of predicate calculus without equality, it typically would be. (Contributed by NM, 5-Aug-1993.)
axiom ax_13_b (x3 y1: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wi (wcel (cv x3) (cv x3)) (wcel (cv y1) (cv x3))) $;

--| Axiom of Equality. One of the equality and substitution axioms for a non-logical predicate in our predicate calculus with equality. It substitutes equal variables into the left-hand side of the ` e. ` binary predicate. Axiom scheme C12' in [Megill] p. 448 (p. 16 of the preprint). It is a special case of Axiom B8 (p. 75) of system S2 of [Tarski] p. 77. "Non-logical" means that the predicate is not a primitive of predicate calculus proper but instead is an extension to it. "Binary" means that the predicate has two arguments. In a system of predicate calculus with equality, like ours, equality is not usually considered to be a non-logical predicate. In systems of predicate calculus without equality, it typically would be. (Contributed by NM, 5-Aug-1993.)
axiom ax_13_b1 (x3 y1: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wi (wcel (cv x3) (cv y1)) (wcel (cv y1) (cv y1))) $;

--| Axiom of Equality. One of the equality and substitution axioms for a non-logical predicate in our predicate calculus with equality. It substitutes equal variables into the right-hand side of the ` e. ` binary predicate. Axiom scheme C13' in [Megill] p. 448 (p. 16 of the preprint). It is a special case of Axiom B8 (p. 75) of system S2 of [Tarski] p. 77. (Contributed by NM, 5-Aug-1993.)
axiom ax_14 (x3 y1 z: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wi (wcel (cv z) (cv x3)) (wcel (cv z) (cv y1))) $;

--| Axiom of Equality. One of the equality and substitution axioms for a non-logical predicate in our predicate calculus with equality. It substitutes equal variables into the right-hand side of the ` e. ` binary predicate. Axiom scheme C13' in [Megill] p. 448 (p. 16 of the preprint). It is a special case of Axiom B8 (p. 75) of system S2 of [Tarski] p. 77. (Contributed by NM, 5-Aug-1993.)
axiom ax_14_b (x3 y1: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wi (wcel (cv x3) (cv x3)) (wcel (cv x3) (cv y1))) $;

--| Axiom of Equality. One of the equality and substitution axioms for a non-logical predicate in our predicate calculus with equality. It substitutes equal variables into the right-hand side of the ` e. ` binary predicate. Axiom scheme C13' in [Megill] p. 448 (p. 16 of the preprint). It is a special case of Axiom B8 (p. 75) of system S2 of [Tarski] p. 77. (Contributed by NM, 5-Aug-1993.)
axiom ax_14_b1 (x3 y1: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wi (wcel (cv y1) (cv x3)) (wcel (cv y1) (cv y1))) $;

--| Bound-variable hypothesis builder for ` x = x ` . This theorem tells us that any variable, including ` x ` , is effectively not free in ` x = x ` , even though ` x ` is technically free according to the traditional definition of free variable. (The proof uses only ~ ax-5 , ~ ax-8 , ~ ax-12 , and ~ ax-gen . This shows that this can be proved without ~ ax-9 , even though the theorem ~ equid cannot be. A shorter proof using ~ ax-9 is obtainable from ~ equid and ~ hbth .) (Contributed by NM, 13-Jan-2011.) (Proof shortened by Wolf Lammen, 23-Mar-2014.)
theorem hbequid {y1: setvar} (x3: setvar):
  $ wi (wceq (cv x3) (cv x3)) (wal y1 (wceq (cv x3) (cv x3))) $;

--| Proof that ~ ax-i12 follows from ~ ax-bndl . So that we can track which theorems rely on ~ ax-bndl , proofs should reference ~ ax-i12 rather than this theorem. (Contributed by Jim Kingdon, 17-Aug-2018.) (New usage is discouraged). (Proof modification is discouraged.)
theorem axi12 {x3 z: setvar} (y1: setvar):
  $ wo (wal z (wceq (cv z) (cv x3))) (wo (wal z (wceq (cv z) (cv y1))) (wal z (wi (wceq (cv x3) (cv y1)) (wal z (wceq (cv x3) (cv y1)))))) $;

--| Commutation law for identical variable specifiers. The antecedent and consequent are true when ` x ` and ` y ` are substituted with the same variable. Lemma L12 in [Megill] p. 445 (p. 12 of the preprint). (Contributed by NM, 5-Aug-1993.)
theorem alequcom {x3 y1: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal y1 (wceq (cv y1) (cv x3))) $;

--| Commutation law for identical variable specifiers. The antecedent and consequent are true when ` x ` and ` y ` are substituted with the same variable. Lemma L12 in [Megill] p. 445 (p. 12 of the preprint). (Contributed by NM, 5-Aug-1993.)
theorem alequcom_b {x3: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv x3))) (wal x3 (wceq (cv x3) (cv x3))) $;

--| A commutation rule for identical variable specifiers. (Contributed by NM, 5-Aug-1993.)
theorem alequcoms {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) ph $ >
  $ wi (wal y1 (wceq (cv y1) (cv x3))) ph $;

--| A commutation rule for identical variable specifiers. (Contributed by NM, 5-Aug-1993.)
theorem alequcoms_b {x3: setvar} (ph: wff x3):
  $ wi (wal x3 (wceq (cv x3) (cv x3))) ph $ >
  $ wi (wal x3 (wceq (cv x3) (cv x3))) ph $;

--| A commutation rule for distinct variable specifiers. (Contributed by NM, 2-Jan-2002.) (Revised by Mario Carneiro, 2-Feb-2015.)
theorem nalequcoms {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) ph $ >
  $ wi (wn (wal y1 (wceq (cv y1) (cv x3)))) ph $;

--| Consequence of the definition of not-free. (Contributed by Mario Carneiro, 26-Sep-2016.)
theorem nfr {x3: setvar} (ph: wff x3):
  $ wi (wnf x3 ph) (wi ph (wal x3 ph)) $;

--| Consequence of the definition of not-free. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfri {x3: setvar} (ph: wff x3):
  $ wnf x3 ph $ >
  $ wi ph (wal x3 ph) $;

--| Consequence of the definition of not-free in a context. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfrd {x3: setvar} (ph ps: wff x3):
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wi ps (wal x3 ps)) $;

--| Deduction from Theorem 19.20 of [Margaris] p. 90. (Contributed by Mario Carneiro, 24-Sep-2016.)
theorem alimd {x3: setvar} (ph ps ch: wff x3):
  $ wnf x3 ph $ >
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wal x3 ps) (wal x3 ch)) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Contributed by Mario Carneiro, 24-Sep-2016.)
theorem alrimi {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wi ph ps $ >
  $ wi ph (wal x3 ps) $;

--| Deduce that ` x ` is not free in ` ps ` in a context. (Contributed by Mario Carneiro, 24-Sep-2016.)
theorem nfd {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wi ph (wi ps (wal x3 ps)) $ >
  $ wi ph (wnf x3 ps) $;

--| Deduce that ` x ` is not free in ` ps ` in a context. (Contributed by Mario Carneiro, 24-Sep-2016.)
theorem nfdh {x3: setvar} (ph ps: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wi ps (wal x3 ps)) $ >
  $ wi ph (wnf x3 ps) $;

--| Moving an antecedent outside ` F/ ` . (Contributed by Jim Kingdon, 23-Mar-2018.)
theorem nfrimi {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wnf x3 (wi ph ps) $ >
  $ wi ph (wnf x3 ps) $;

--| Axiom to quantify a variable over a formula in which it does not occur. Axiom C5 in [Megill] p. 444 (p. 11 of the preprint). Also appears as Axiom B6 (p. 75) of system S2 of [Tarski] p. 77 and Axiom C5-1 of [Monk2] p. 113. (Contributed by NM, 5-Aug-1993.)
axiom ax_17 {x3: setvar} (ph: wff):
  $ wi ph (wal x3 ph) $;

--| ~ ax-17 with antecedent. (Contributed by NM, 1-Mar-2013.)
theorem a17d {x3: setvar} (ph: wff x3) (ps: wff):
  $ wi ph (wi ps (wal x3 ps)) $;

--| If ` x ` is not present in ` ph ` , then ` x ` is not free in ` ph ` . (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfv {x3: setvar} (ph: wff):
  $ wnf x3 ph $;

--| ~ nfv with antecedent. Useful in proofs of deduction versions of bound-variable hypothesis builders such as ~ nfimd . (Contributed by Mario Carneiro, 6-Oct-2016.)
theorem nfvd {x3: setvar} (ph: wff x3) (ps: wff):
  $ wi ph (wnf x3 ps) $;

--| Axiom of Existence. One of the equality and substitution axioms of predicate calculus with equality. One thing this axiom tells us is that at least one thing exists (although ~ ax-4 and possibly others also tell us that, i.e. they are not valid in the empty domain of a "free logic"). In this form (not requiring that ` x ` and ` y ` be distinct) it was used in an axiom system of Tarski (see Axiom B7' in footnote 1 of [KalishMontague] p. 81.) Another name for this theorem is ~ a9e , which has additional remarks. (Contributed by Mario Carneiro, 31-Jan-2015.)
axiom ax_i9 {x3: setvar} (y1: setvar):
  $ wex x3 (wceq (cv x3) (cv y1)) $;

--| Derive ~ ax-9 from ~ ax-i9 , the modified version for intuitionistic logic. Although ~ ax-9 does hold intuistionistically, in intuitionistic logic it is weaker than ~ ax-i9 . (Contributed by NM, 3-Feb-2015.)
theorem ax_9 {x3: setvar} (y1: setvar):
  $ wn (wal x3 (wn (wceq (cv x3) (cv y1)))) $;

--| ~ equid with some quantification and negation without using ~ ax-4 or ~ ax-17 . (Contributed by NM, 13-Jan-2011.) (Proof shortened by Wolf Lammen, 27-Feb-2014.)
theorem equidqe {y1: setvar} (x3: setvar):
  $ wn (wal y1 (wn (wceq (cv x3) (cv x3)))) $;

--| A special case of ~ ax-4 without using ~ ax-4 or ~ ax-17 . (Contributed by NM, 13-Jan-2011.)
theorem ax4sp1 {y1: setvar} (x3: setvar):
  $ wi (wal y1 (wn (wceq (cv x3) (cv x3)))) (wn (wceq (cv x3) (cv x3))) $;

--| ` x ` is not free in ` A. x ph ` . One of the axioms of predicate logic. (Contributed by Mario Carneiro, 31-Jan-2015.)
axiom ax_ial {x3: setvar} (ph: wff x3):
  $ wi (wal x3 ph) (wal x3 (wal x3 ph)) $;

--| Axiom of quantifier collection. (Contributed by Mario Carneiro, 31-Jan-2015.)
axiom ax_i5r {x3: setvar} (ph ps: wff x3):
  $ wi (wi (wal x3 ph) (wal x3 ps)) (wal x3 (wi (wal x3 ph) ps)) $;

--| Inference rule reversing generalization. (Contributed by NM, 5-Aug-1993.)
theorem spi {x3: setvar} (ph: wff x3):
  $ wal x3 ph $ >
  $ ph $;

--| Generalization of antecedent. (Contributed by NM, 5-Aug-1993.)
theorem sps {x3: setvar} (ph ps: wff x3):
  $ wi ph ps $ >
  $ wi (wal x3 ph) ps $;

--| Deduction generalizing antecedent. (Contributed by NM, 17-Aug-1994.)
theorem spsd {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wal x3 ps) ch) $;

--| An equality theorem for effectively not free. (Contributed by Mario Carneiro, 4-Oct-2016.)
theorem nfbidf {x3: setvar} (ph ps ch: wff x3):
  $ wnf x3 ph $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wnf x3 ps) (wnf x3 ch)) $;

--| ` x ` is not free in ` A. x ph ` . Example in Appendix in [Megill] p. 450 (p. 19 of the preprint). Also Lemma 22 of [Monk2] p. 114. (Contributed by NM, 5-Aug-1993.)
theorem hba1 {x3: setvar} (ph: wff x3):
  $ wi (wal x3 ph) (wal x3 (wal x3 ph)) $;

--| ` x ` is not free in ` A. x ph ` . (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfa1 {x3: setvar} (ph: wff x3):
  $ wnf x3 (wal x3 ph) $;

--| Inference generalizing a consequent. (Contributed by NM, 5-Aug-1993.)
theorem a5i {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 ph) ps $ >
  $ wi (wal x3 ph) (wal x3 ps) $;

--| ` x ` is not free in ` F/ x ph ` . (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfnf1 {x3: setvar} (ph: wff x3):
  $ wnf x3 (wnf x3 ph) $;

--| If ` x ` is not free in ` ph ` and ` ps ` , it is not free in ` ( ph -> ps ) ` . (Contributed by NM, 5-Aug-1993.) (Proof shortened by O'Cat, 3-Mar-2008.) (Revised by Mario Carneiro, 2-Feb-2015.)
theorem hbim {x3: setvar} (ph ps: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ps (wal x3 ps) $ >
  $ wi (wi ph ps) (wal x3 (wi ph ps)) $;

--| If ` x ` is not free in ` ph ` and ` ps ` , it is not free in ` ( ph \/ ps ) ` . (Contributed by NM, 5-Aug-1993.) (Revised by NM, 2-Feb-2015.)
theorem hbor {x3: setvar} (ph ps: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ps (wal x3 ps) $ >
  $ wi (wo ph ps) (wal x3 (wo ph ps)) $;

--| If ` x ` is not free in ` ph ` and ` ps ` , it is not free in ` ( ph /\ ps ) ` . (Contributed by NM, 5-Aug-1993.) (Proof shortened by Mario Carneiro, 2-Feb-2015.)
theorem hban {x3: setvar} (ph ps: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ps (wal x3 ps) $ >
  $ wi (wa ph ps) (wal x3 (wa ph ps)) $;

--| If ` x ` is not free in ` ph ` and ` ps ` , it is not free in ` ( ph <-> ps ) ` . (Contributed by NM, 5-Aug-1993.)
theorem hbbi {x3: setvar} (ph ps: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ps (wal x3 ps) $ >
  $ wi (wb ph ps) (wal x3 (wb ph ps)) $;

--| If ` x ` is not free in ` ph ` , ` ps ` , and ` ch ` , it is not free in ` ( ph \/ ps \/ ch ) ` . (Contributed by NM, 14-Sep-2003.)
theorem hb3or {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ps (wal x3 ps) $ >
  $ wi ch (wal x3 ch) $ >
  $ wi (w3o ph ps ch) (wal x3 (w3o ph ps ch)) $;

--| If ` x ` is not free in ` ph ` , ` ps ` , and ` ch ` , it is not free in ` ( ph /\ ps /\ ch ) ` . (Contributed by NM, 14-Sep-2003.)
theorem hb3an {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ps (wal x3 ps) $ >
  $ wi ch (wal x3 ch) $ >
  $ wi (w3a ph ps ch) (wal x3 (w3a ph ps ch)) $;

--| Lemma 24 of [Monk2] p. 114. (Contributed by NM, 29-May-2008.)
theorem hba2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal y1 (wal x3 ph)) (wal x3 (wal y1 (wal x3 ph))) $;

--| Lemma 23 of [Monk2] p. 114. (Contributed by NM, 29-May-2008.)
theorem hbia1 {x3: setvar} (ph ps: wff x3):
  $ wi (wi (wal x3 ph) (wal x3 ps)) (wal x3 (wi (wal x3 ph) (wal x3 ps))) $;

--| A wff may be quantified with a variable not free in it. Theorem 19.3 of [Margaris] p. 89. (Contributed by NM, 5-Aug-1993.) (Revised by NM, 21-May-2007.)
theorem _19_3h {x3: setvar} (ph: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wb (wal x3 ph) ph $;

--| A wff may be quantified with a variable not free in it. Theorem 19.3 of [Margaris] p. 89. (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 24-Sep-2016.)
theorem _19_3 {x3: setvar} (ph: wff x3):
  $ wnf x3 ph $ >
  $ wb (wal x3 ph) ph $;

--| Theorem 19.16 of [Margaris] p. 90. (Contributed by NM, 12-Mar-1993.)
theorem _19_16 {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wi (wal x3 (wb ph ps)) (wb ph (wal x3 ps)) $;

--| Theorem 19.17 of [Margaris] p. 90. (Contributed by NM, 12-Mar-1993.)
theorem _19_17 {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ps $ >
  $ wi (wal x3 (wb ph ps)) (wb (wal x3 ph) ps) $;

--| Theorem 19.21 of [Margaris] p. 90. The hypothesis can be thought of as " ` x ` is not free in ` ph ` ." New proofs should use ~ 19.21 instead. (Contributed by NM, 5-Aug-1993.) (New usage is discouraged.)
theorem _19_21h {x3: setvar} (ph ps: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wb (wal x3 (wi ph ps)) (wi ph (wal x3 ps)) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.)
theorem _19_21bi {x3: setvar} (ph ps: wff x3):
  $ wi ph (wal x3 ps) $ >
  $ wi ph ps $;

--| Inference removing double quantifier. (Contributed by NM, 20-Apr-1994.)
theorem _19_21bbi {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph (wal x3 (wal y1 ps)) $ >
  $ wi ph ps $;

--| Theorem 19.27 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.)
theorem _19_27h {x3: setvar} (ph ps: wff x3):
  $ wi ps (wal x3 ps) $ >
  $ wb (wal x3 (wa ph ps)) (wa (wal x3 ph) ps) $;

--| Theorem 19.27 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.)
theorem _19_27 {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ps $ >
  $ wb (wal x3 (wa ph ps)) (wa (wal x3 ph) ps) $;

--| Theorem 19.28 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.)
theorem _19_28h {x3: setvar} (ph ps: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wb (wal x3 (wa ph ps)) (wa ph (wal x3 ps)) $;

--| Theorem 19.28 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.)
theorem _19_28 {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wb (wal x3 (wa ph ps)) (wa ph (wal x3 ps)) $;

--| A closed form of ~ nfan . (Contributed by Mario Carneiro, 3-Oct-2016.)
theorem nfan1 {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wi ph (wnf x3 ps) $ >
  $ wnf x3 (wa ph ps) $;

--| If ` x ` is not free in ` ph ` and ` ps ` , it is not free in ` ( ph /\ ps ) ` . (Contributed by Mario Carneiro, 11-Aug-2016.) (Proof shortened by Wolf Lammen, 13-Jan-2018.)
theorem nfan {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wnf x3 ps $ >
  $ wnf x3 (wa ph ps) $;

--| If ` x ` is not free in ` ph ` , ` ps ` , and ` ch ` , it is not free in ` ( ph /\ ps /\ ch ) ` . (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nf3an {x3: setvar} (ph ps ch: wff x3):
  $ wnf x3 ph $ >
  $ wnf x3 ps $ >
  $ wnf x3 ch $ >
  $ wnf x3 (w3a ph ps ch) $;

--| If in a context ` x ` is not free in ` ps ` and ` ch ` , it is not free in ` ( ps \/ ch ) ` . (Contributed by Jim Kingdon, 29-Oct-2019.)
theorem nford {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wnf x3 (wo ps ch)) $;

--| If in a context ` x ` is not free in ` ps ` and ` ch ` , it is not free in ` ( ps /\ ch ) ` . (Contributed by Mario Carneiro, 7-Oct-2016.)
theorem nfand {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wnf x3 (wa ps ch)) $;

--| Deduction form of bound-variable hypothesis builder ~ nf3an . (Contributed by NM, 17-Feb-2013.) (Revised by Mario Carneiro, 16-Oct-2016.)
theorem nf3and {x3: setvar} (ph ps ch th: wff x3):
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wnf x3 th) $ >
  $ wi ph (wnf x3 (w3a ps ch th)) $;

--| A closed form of ~ hbim . (Contributed by NM, 5-Aug-1993.)
theorem hbim1 {x3: setvar} (ph ps: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wi ps (wal x3 ps)) $ >
  $ wi (wi ph ps) (wal x3 (wi ph ps)) $;

--| A closed form of ~ nfim . (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 24-Sep-2016.) (Proof shortened by Wolf Lammen, 2-Jan-2018.)
theorem nfim1 {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wi ph (wnf x3 ps) $ >
  $ wnf x3 (wi ph ps) $;

--| If ` x ` is not free in ` ph ` and ` ps ` , it is not free in ` ( ph -> ps ) ` . (Contributed by Mario Carneiro, 11-Aug-2016.) (Proof shortened by Wolf Lammen, 2-Jan-2018.)
theorem nfim {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wnf x3 ps $ >
  $ wnf x3 (wi ph ps) $;

--| Deduction form of bound-variable hypothesis builder ~ hbim . (Contributed by NM, 1-Jan-2002.) (Revised by NM, 2-Feb-2015.)
theorem hbimd {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wi ps (wal x3 ps)) $ >
  $ wi ph (wi ch (wal x3 ch)) $ >
  $ wi ph (wi (wi ps ch) (wal x3 (wi ps ch))) $;

--| If ` x ` is not free in ` ph ` and ` ps ` , it is not free in ` ( ph \/ ps ) ` . (Contributed by Jim Kingdon, 11-Mar-2018.)
theorem nfor {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wnf x3 ps $ >
  $ wnf x3 (wo ph ps) $;

--| Deduction form of bound-variable hypothesis builder ~ hbbi . (Contributed by NM, 1-Jan-2002.)
theorem hbbid {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wi ps (wal x3 ps)) $ >
  $ wi ph (wi ch (wal x3 ch)) $ >
  $ wi ph (wi (wb ps ch) (wal x3 (wb ps ch))) $;

--| If ` x ` is not free in ` ph ` , it is not free in ` A. y ph ` . (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfal {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf x3 (wal y1 ph) $;

--| If ` x ` is not free in ` ph ` , it is not free in ` F/ y ph ` . (Contributed by Mario Carneiro, 11-Aug-2016.) (Proof shortened by Wolf Lammen, 30-Dec-2017.)
theorem nfnf {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf x3 (wnf y1 ph) $;

--| Closed form of ~ nfal . (Contributed by Jim Kingdon, 11-May-2018.)
theorem nfalt {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal y1 (wnf x3 ph)) (wnf x3 (wal y1 ph)) $;

--| Lemma 24 of [Monk2] p. 114. (Contributed by Mario Carneiro, 24-Sep-2016.)
theorem nfa2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 (wal y1 (wal x3 ph)) $;

--| Lemma 23 of [Monk2] p. 114. (Contributed by Mario Carneiro, 24-Sep-2016.)
theorem nfia1 {x3: setvar} (ph ps: wff x3):
  $ wnf x3 (wi (wal x3 ph) (wal x3 ps)) $;

--| Closed form of Theorem 19.21 of [Margaris] p. 90. (Contributed by NM, 27-May-1997.) (New usage is discouraged.)
theorem _19_21ht {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wi ph (wal x3 ph))) (wb (wal x3 (wi ph ps)) (wi ph (wal x3 ps))) $;

--| Closed form of Theorem 19.21 of [Margaris] p. 90. (Contributed by NM, 27-May-1997.)
theorem _19_21t {x3: setvar} (ph ps: wff x3):
  $ wi (wnf x3 ph) (wb (wal x3 (wi ph ps)) (wi ph (wal x3 ps))) $;

--| Theorem 19.21 of [Margaris] p. 90. The hypothesis can be thought of as " ` x ` is not free in ` ph ` ." (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 24-Sep-2016.)
theorem _19_21 {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wb (wal x3 (wi ph ps)) (wi ph (wal x3 ps)) $;

--| An axiom scheme of standard predicate calculus that emulates Axiom 5 of [Mendelson] p. 69. The hypothesis ` F/ x ph ` can be thought of as emulating " ` x ` is not free in ` ph ` ." With this definition, the meaning of "not free" is less restrictive than the usual textbook definition; for example ` x ` would not (for us) be free in ` x = x ` by ~ nfequid . This theorem scheme can be proved as a metatheorem of Mendelson's axiom system, even though it is slightly stronger than his Axiom 5. (Contributed by NM, 22-Sep-1993.) (Revised by Mario Carneiro, 12-Oct-2016.) (Proof shortened by Wolf Lammen, 1-Jan-2018.)
theorem stdpc5 {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wi (wal x3 (wi ph ps)) (wi ph (wal x3 ps)) $;

--| If in a context ` x ` is not free in ` ps ` and ` ch ` , it is not free in ` ( ps -> ch ) ` . (Contributed by Mario Carneiro, 24-Sep-2016.) (Proof shortened by Wolf Lammen, 30-Dec-2017.)
theorem nfimd {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wnf x3 (wi ps ch)) $;

--| Rearrange universal quantifiers. (Contributed by NM, 12-Aug-1993.)
theorem aaanh {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wi ps (wal x3 ps) $ >
  $ wb (wal x3 (wal y1 (wa ph ps))) (wa (wal x3 ph) (wal y1 ps)) $;

--| Rearrange universal quantifiers. (Contributed by NM, 12-Aug-1993.)
theorem aaan {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wb (wal x3 (wal y1 (wa ph ps))) (wa (wal x3 ph) (wal y1 ps)) $;

--| If in a context ` x ` is not free in ` ps ` and ` ch ` , it is not free in ` ( ps <-> ch ) ` . (Contributed by Mario Carneiro, 24-Sep-2016.) (Proof shortened by Wolf Lammen, 29-Dec-2017.)
theorem nfbid {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wnf x3 (wb ps ch)) $;

--| If ` x ` is not free in ` ph ` and ` ps ` , it is not free in ` ( ph <-> ps ) ` . (Contributed by Mario Carneiro, 11-Aug-2016.) (Proof shortened by Wolf Lammen, 2-Jan-2018.)
theorem nfbi {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wnf x3 ps $ >
  $ wnf x3 (wb ph ps) $;

--| If a wff is true, it is true for at least one instance. Special case of Theorem 19.8 of [Margaris] p. 89. (Contributed by NM, 5-Aug-1993.)
theorem _19_8a {x3: setvar} (ph: wff x3):
  $ wi ph (wex x3 ph) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.)
theorem _19_23bi {x3: setvar} (ph ps: wff x3):
  $ wi (wex x3 ph) ps $ >
  $ wi ph ps $;

--| Inference from Theorem 19.23 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 13-May-2011.)
theorem exlimih {x3: setvar} (ph ps: wff x3):
  $ wi ps (wal x3 ps) $ >
  $ wi ph ps $ >
  $ wi (wex x3 ph) ps $;

--| Inference from Theorem 19.23 of [Margaris] p. 90. (Contributed by Mario Carneiro, 24-Sep-2016.)
theorem exlimi {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ps $ >
  $ wi ph ps $ >
  $ wi (wex x3 ph) ps $;

--| Deduction from Theorem 19.23 of [Margaris] p. 90. Similar to ~ exlimdh but with one slightly different hypothesis. (Contributed by Jim Kingdon, 30-Dec-2017.)
theorem exlimd2 {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wi ch (wal x3 ch)) $ >
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wex x3 ps) ch) $;

--| Deduction from Theorem 19.23 of [Margaris] p. 90. (Contributed by NM, 28-Jan-1997.)
theorem exlimdh {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ch (wal x3 ch) $ >
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wex x3 ps) ch) $;

--| Deduction from Theorem 19.9 of [Margaris] p. 89. (Contributed by Mario Carneiro, 24-Sep-2016.) (Proof rewritten by Jim Kingdon, 18-Jun-2018.)
theorem exlimd {x3: setvar} (ph ps ch: wff x3):
  $ wnf x3 ph $ >
  $ wnf x3 ch $ >
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wex x3 ps) ch) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90. This inference, along with our many variants is used to implement a metatheorem called "Rule C" that is given in many logic textbooks. See, for example, Rule C in [Mendelson] p. 81, Rule C in [Margaris] p. 40, or Rule C in Hirst and Hirst's _A Primer for Logic and Proof_ p. 59 (PDF p. 65) at ~ http://www.mathsci.appstate.edu/~~jlh/primer/hirst.pdf . In informal proofs, the statement "Let C be an element such that..." almost always means an implicit application of Rule C. In essence, Rule C states that if we can prove that some element ` x ` exists satisfying a wff, i.e. ` E. x ph ( x ) ` where ` ph ( x ) ` has ` x ` free, then we can use ` ph ( ` C ` ) ` as a hypothesis for the proof where C is a new (ficticious) constant not appearing previously in the proof, nor in any axioms used, nor in the theorem to be proved. The purpose of Rule C is to get rid of the existential quantifier. We cannot do this in Metamath directly. Instead, we use the original ` ph ` (containing ` x ` ) as an antecedent for the main part of the proof. We eventually arrive at ` ( ph -> ps ) ` where ` ps ` is the theorem to be proved and does not contain ` x ` . Then we apply ~ exlimiv to arrive at ` ( E. x ph -> ps ) ` . Finally, we separately prove ` E. x ph ` and detach it with modus ponens ~ ax-mp to arrive at the final theorem ` ps ` . (Contributed by NM, 5-Aug-1993.) (Revised by NM, 25-Jul-2012.)
theorem exlimiv {x3: setvar} (ph: wff x3) (ps: wff):
  $ wi ph ps $ >
  $ wi (wex x3 ph) ps $;

--| Theorem 19.22 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Wolf Lammen, 4-Jul-2014.)
theorem exim {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wi ph ps)) (wi (wex x3 ph) (wex x3 ps)) $;

--| Inference adding existential quantifier to antecedent and consequent. (Contributed by NM, 5-Aug-1993.)
theorem eximi {x3: setvar} (ph ps: wff x3):
  $ wi ph ps $ >
  $ wi (wex x3 ph) (wex x3 ps) $;

--| Inference adding 2 existential quantifiers to antecedent and consequent. (Contributed by NM, 3-Feb-2005.)
theorem _2eximi {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph ps $ >
  $ wi (wex x3 (wex y1 ph)) (wex x3 (wex y1 ps)) $;

--| Inference associated with ~ eximi . (Contributed by BJ, 3-Feb-2018.)
theorem eximii {x3: setvar} (ph ps: wff x3):
  $ wex x3 ph $ >
  $ wi ph ps $ >
  $ wex x3 ps $;

--| A transformation of quantifiers and logical connectives. (Contributed by NM, 19-Aug-1993.)
theorem alinexa {x3: setvar} (ph ps: wff x3):
  $ wb (wal x3 (wi ph (wn ps))) (wn (wex x3 (wa ph ps))) $;

--| Theorem 19.18 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.)
theorem exbi {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wb ph ps)) (wb (wex x3 ph) (wex x3 ps)) $;

--| Inference adding existential quantifier to both sides of an equivalence. (Contributed by NM, 24-May-1994.)
theorem exbii {x3: setvar} (ph ps: wff x3):
  $ wb ph ps $ >
  $ wb (wex x3 ph) (wex x3 ps) $;

--| Inference adding 2 existential quantifiers to both sides of an equivalence. (Contributed by NM, 16-Mar-1995.)
theorem _2exbii {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb ph ps $ >
  $ wb (wex x3 (wex y1 ph)) (wex x3 (wex y1 ps)) $;

--| Inference adding 3 existential quantifiers to both sides of an equivalence. (Contributed by NM, 2-May-1995.)
theorem _3exbii {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wb ph ps $ >
  $ wb (wex x3 (wex y1 (wex z ph))) (wex x3 (wex y1 (wex z ps))) $;

--| Commutation of conjunction inside an existential quantifier. (Contributed by NM, 18-Aug-1993.)
theorem exancom {x3: setvar} (ph ps: wff x3):
  $ wb (wex x3 (wa ph ps)) (wex x3 (wa ps ph)) $;

--| Deduction from Theorem 19.21 of [Margaris] p. 90. (Contributed by Mario Carneiro, 24-Sep-2016.)
theorem alrimdd {x3: setvar} (ph ps ch: wff x3):
  $ wnf x3 ph $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi ps (wal x3 ch)) $;

--| Deduction from Theorem 19.21 of [Margaris] p. 90. (Contributed by Mario Carneiro, 24-Sep-2016.)
theorem alrimd {x3: setvar} (ph ps ch: wff x3):
  $ wnf x3 ph $ >
  $ wnf x3 ps $ >
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi ps (wal x3 ch)) $;

--| Deduction from Theorem 19.22 of [Margaris] p. 90. (Contributed by NM, 20-May-1996.)
theorem eximdh {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wex x3 ps) (wex x3 ch)) $;

--| Deduction from Theorem 19.22 of [Margaris] p. 90. (Contributed by Mario Carneiro, 24-Sep-2016.)
theorem eximd {x3: setvar} (ph ps ch: wff x3):
  $ wnf x3 ph $ >
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wex x3 ps) (wex x3 ch)) $;

--| Deduction for generalization rule for negated wff. (Contributed by NM, 2-Jan-2002.)
theorem nexd {x3: setvar} (ph ps: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wn ps) $ >
  $ wi ph (wn (wex x3 ps)) $;

--| Formula-building rule for existential quantifier (deduction rule). (Contributed by NM, 5-Aug-1993.)
theorem exbidh {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wex x3 ps) (wex x3 ch)) $;

--| Formula-building rule for universal quantifier (deduction rule). (Contributed by Mario Carneiro, 24-Sep-2016.)
theorem albid {x3: setvar} (ph ps ch: wff x3):
  $ wnf x3 ph $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wal x3 ps) (wal x3 ch)) $;

--| Formula-building rule for existential quantifier (deduction rule). (Contributed by Mario Carneiro, 24-Sep-2016.)
theorem exbid {x3: setvar} (ph ps ch: wff x3):
  $ wnf x3 ph $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wex x3 ps) (wex x3 ch)) $;

--| Simplification of an existentially quantified conjunction. (Contributed by Rodolfo Medina, 25-Sep-2010.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem exsimpl {x3: setvar} (ph ps: wff x3):
  $ wi (wex x3 (wa ph ps)) (wex x3 ph) $;

--| Simplification of an existentially quantified conjunction. (Contributed by Rodolfo Medina, 25-Sep-2010.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem exsimpr {x3: setvar} (ph ps: wff x3):
  $ wi (wex x3 (wa ph ps)) (wex x3 ps) $;

--| Theorem 19.6 of [Margaris] p. 89, given a decidability condition. The forward direction holds for all propositions, as seen at ~ alexim . (Contributed by Jim Kingdon, 2-Jun-2018.)
theorem alexdc {x3: setvar} (ph: wff x3):
  $ wi (wal x3 (wdc ph)) (wb (wal x3 ph) (wn (wex x3 (wn ph)))) $;

--| Theorem 19.29 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 13-May-2011.)
theorem _19_29 {x3: setvar} (ph ps: wff x3):
  $ wi (wa (wal x3 ph) (wex x3 ps)) (wex x3 (wa ph ps)) $;

--| Variation of Theorem 19.29 of [Margaris] p. 90. (Contributed by NM, 18-Aug-1993.)
theorem _19_29r {x3: setvar} (ph ps: wff x3):
  $ wi (wa (wex x3 ph) (wal x3 ps)) (wex x3 (wa ph ps)) $;

--| Variation of Theorem 19.29 of [Margaris] p. 90 with double quantification. (Contributed by NM, 3-Feb-2005.)
theorem _19_29r2 {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wa (wex x3 (wex y1 ph)) (wal x3 (wal y1 ps))) (wex x3 (wex y1 (wa ph ps))) $;

--| Variation of Theorem 19.29 of [Margaris] p. 90 with mixed quantification. (Contributed by NM, 11-Feb-2005.)
theorem _19_29x {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wa (wex x3 (wal y1 ph)) (wal x3 (wex y1 ps))) (wex x3 (wex y1 (wa ph ps))) $;

--| Forward direction of Theorem 19.35 of [Margaris] p. 90. The converse holds for classical logic but not (for all propositions) in intuitionistic logic (Contributed by Mario Carneiro, 2-Feb-2015.)
theorem _19_35_1 {x3: setvar} (ph ps: wff x3):
  $ wi (wex x3 (wi ph ps)) (wi (wal x3 ph) (wex x3 ps)) $;

--| Inference from Theorem 19.35 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.) (Revised by NM, 2-Feb-2015.)
theorem _19_35i {x3: setvar} (ph ps: wff x3):
  $ wex x3 (wi ph ps) $ >
  $ wi (wal x3 ph) (wex x3 ps) $;

--| Theorem 19.25 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.) (Revised by NM, 2-Feb-2015.)
theorem _19_25 {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal y1 (wex x3 (wi ph ps))) (wi (wex y1 (wal x3 ph)) (wex y1 (wex x3 ps))) $;

--| Theorem 19.30 of [Margaris] p. 90, with an additional decidability condition. (Contributed by Jim Kingdon, 21-Jul-2018.)
theorem _19_30dc {x3: setvar} (ph ps: wff x3):
  $ wi (wdc (wex x3 ps)) (wi (wal x3 (wo ph ps)) (wo (wal x3 ph) (wex x3 ps))) $;

--| Theorem 19.43 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Mario Carneiro, 2-Feb-2015.)
theorem _19_43 {x3: setvar} (ph ps: wff x3):
  $ wb (wex x3 (wo ph ps)) (wo (wex x3 ph) (wex x3 ps)) $;

--| The antecedent provides a condition implying the converse of ~ 19.33 . Compare Theorem 19.33 of [Margaris] p. 90. This variation of ~ 19.33bdc is intuitionistically valid without a decidability condition. (Contributed by Mario Carneiro, 2-Feb-2015.)
theorem _19_33b2 {x3: setvar} (ph ps: wff x3):
  $ wi (wo (wn (wex x3 ph)) (wn (wex x3 ps))) (wb (wal x3 (wo ph ps)) (wo (wal x3 ph) (wal x3 ps))) $;

--| Converse of ~ 19.33 given ` -. ( E. x ph /\ E. x ps ) ` and a decidability condition. Compare Theorem 19.33 of [Margaris] p. 90. For a version which does not require a decidability condition, see ~ 19.33b2 (Contributed by Jim Kingdon, 23-Apr-2018.)
theorem _19_33bdc {x3: setvar} (ph ps: wff x3):
  $ wi (wdc (wex x3 ph)) (wi (wn (wa (wex x3 ph) (wex x3 ps))) (wb (wal x3 (wo ph ps)) (wo (wal x3 ph) (wal x3 ps)))) $;

--| Theorem 19.40 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.)
theorem _19_40 {x3: setvar} (ph ps: wff x3):
  $ wi (wex x3 (wa ph ps)) (wa (wex x3 ph) (wex x3 ps)) $;

--| Theorem *11.42 in [WhiteheadRussell] p. 163. Theorem 19.40 of [Margaris] p. 90 with 2 quantifiers. (Contributed by Andrew Salmon, 24-May-2011.)
theorem _19_40_2 {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wex x3 (wex y1 (wa ph ps))) (wa (wex x3 (wex y1 ph)) (wex x3 (wex y1 ps))) $;

--| Add/remove a conjunct in the scope of an existential quantifier. (Contributed by Raph Levien, 3-Jul-2006.)
theorem exintrbi {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wi ph ps)) (wb (wex x3 ph) (wex x3 (wa ph ps))) $;

--| Introduce a conjunct in the scope of an existential quantifier. (Contributed by NM, 11-Aug-1993.)
theorem exintr {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wi ph ps)) (wi (wex x3 ph) (wex x3 (wa ph ps))) $;

--| Theorem *10.3 in [WhiteheadRussell] p. 150. (Contributed by Andrew Salmon, 8-Jun-2011.)
theorem alsyl {x3: setvar} (ph ps ch: wff x3):
  $ wi (wa (wal x3 (wi ph ps)) (wal x3 (wi ps ch))) (wal x3 (wi ph ch)) $;

--| If ` x ` is not free in ` ph ` , it is not free in ` E. y ph ` . (Contributed by NM, 5-Aug-1993.) (Revised by NM, 2-Feb-2015.)
theorem hbex {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi (wex y1 ph) (wal x3 (wex y1 ph)) $;

--| If ` x ` is not free in ` ph ` , it is not free in ` E. y ph ` . (Contributed by Mario Carneiro, 11-Aug-2016.) (Proof shortened by Wolf Lammen, 30-Dec-2017.)
theorem nfex {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf x3 (wex y1 ph) $;

--| Theorem 19.2 of [Margaris] p. 89, generalized to use two setvar variables. (Contributed by O'Cat, 31-Mar-2008.)
theorem _19_2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 ph) (wex y1 ph) $;

--| Theorem 19.2 of [Margaris] p. 89, generalized to use two setvar variables. (Contributed by O'Cat, 31-Mar-2008.)
theorem _19_2_b {x3: setvar} (ph: wff x3):
  $ wi (wal x3 ph) (wex x3 ph) $;

--| Theorem 19.24 of [Margaris] p. 90, with an additional hypothesis. The hypothesis is the converse of ~ 19.35-1 , and is a theorem of classical logic, but in intuitionistic logic it will only be provable for some propositions. (Contributed by Jim Kingdon, 22-Jul-2018.)
theorem i19_24 {x3: setvar} (ph ps: wff x3):
  $ wi (wi (wal x3 ph) (wex x3 ps)) (wex x3 (wi ph ps)) $ >
  $ wi (wi (wal x3 ph) (wal x3 ps)) (wex x3 (wi ph ps)) $;

--| Theorem 19.39 of [Margaris] p. 90, with an additional hypothesis. The hypothesis is the converse of ~ 19.35-1 , and is a theorem of classical logic, but in intuitionistic logic it will only be provable for some propositions. (Contributed by Jim Kingdon, 22-Jul-2018.)
theorem i19_39 {x3: setvar} (ph ps: wff x3):
  $ wi (wi (wal x3 ph) (wex x3 ps)) (wex x3 (wi ph ps)) $ >
  $ wi (wi (wex x3 ph) (wex x3 ps)) (wex x3 (wi ph ps)) $;

--| A closed version of one direction of ~ 19.9 . (Contributed by NM, 5-Aug-1993.)
theorem _19_9ht {x3: setvar} (ph: wff x3):
  $ wi (wal x3 (wi ph (wal x3 ph))) (wi (wex x3 ph) ph) $;

--| A closed version of ~ 19.9 . (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 24-Sep-2016.) (Proof shortended by Wolf Lammen, 30-Dec-2017.)
theorem _19_9t {x3: setvar} (ph: wff x3):
  $ wi (wnf x3 ph) (wb (wex x3 ph) ph) $;

--| A wff may be existentially quantified with a variable not free in it. Theorem 19.9 of [Margaris] p. 89. (Contributed by FL, 24-Mar-2007.)
theorem _19_9h {x3: setvar} (ph: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wb (wex x3 ph) ph $;

--| A wff may be existentially quantified with a variable not free in it. Theorem 19.9 of [Margaris] p. 89. (Contributed by FL, 24-Mar-2007.) (Revised by Mario Carneiro, 24-Sep-2016.) (Proof shortened by Wolf Lammen, 30-Dec-2017.)
theorem _19_9 {x3: setvar} (ph: wff x3):
  $ wnf x3 ph $ >
  $ wb (wex x3 ph) ph $;

--| One direction of theorem 19.6 of [Margaris] p. 89. The converse holds given a decidability condition, as seen at ~ alexdc . (Contributed by Jim Kingdon, 2-Jul-2018.)
theorem alexim {x3: setvar} (ph: wff x3):
  $ wi (wal x3 ph) (wn (wex x3 (wn ph))) $;

--| One direction of Theorem 19.14 of [Margaris] p. 90. In classical logic the converse also holds. (Contributed by Jim Kingdon, 15-Jul-2018.)
theorem exnalim {x3: setvar} (ph: wff x3):
  $ wi (wex x3 (wn ph)) (wn (wal x3 ph)) $;

--| A transformation of quantifiers and logical connectives. In classical logic the converse also holds. (Contributed by Jim Kingdon, 15-Jul-2018.)
theorem exanaliim {x3: setvar} (ph ps: wff x3):
  $ wi (wex x3 (wa ph (wn ps))) (wn (wal x3 (wi ph ps))) $;

--| A relationship between two quantifiers and negation. (Contributed by Jim Kingdon, 27-Aug-2018.)
theorem alexnim {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wex y1 (wn ph))) (wn (wex x3 (wal y1 ph))) $;

--| If ` x ` is not free in ` ph ` , it is not free in ` -. ph ` . This theorem doesn't use ~ ax6b compared to ~ hbnt . (Contributed by GD, 27-Jan-2018.)
theorem ax6blem {x3: setvar} (ph: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi (wn ph) (wal x3 (wn ph)) $;

--| Quantified Negation. Axiom C5-2 of [Monk2] p. 113. (Contributed by GD, 27-Jan-2018.)
theorem ax6b {x3: setvar} (ph: wff x3):
  $ wi (wn (wal x3 ph)) (wal x3 (wn (wal x3 ph))) $;

--| ` x ` is not free in ` -. A. x ph ` . (Contributed by NM, 5-Aug-1993.) (Proof shortened by Wolf Lammen, 18-Aug-2014.)
theorem hbn1 {x3: setvar} (ph: wff x3):
  $ wi (wn (wal x3 ph)) (wal x3 (wn (wal x3 ph))) $;

--| Closed theorem version of bound-variable hypothesis builder ~ hbn . (Contributed by NM, 5-Aug-1993.) (Revised by NM, 2-Feb-2015.)
theorem hbnt {x3: setvar} (ph: wff x3):
  $ wi (wal x3 (wi ph (wal x3 ph))) (wi (wn ph) (wal x3 (wn ph))) $;

--| If ` x ` is not free in ` ph ` , it is not free in ` -. ph ` . (Contributed by NM, 5-Aug-1993.)
theorem hbn {x3: setvar} (ph: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi (wn ph) (wal x3 (wn ph)) $;

--| Deduction form of bound-variable hypothesis builder ~ hbn . (Contributed by NM, 3-Jan-2002.)
theorem hbnd {x3: setvar} (ph ps: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wi ps (wal x3 ps)) $ >
  $ wi ph (wi (wn ps) (wal x3 (wn ps))) $;

--| If ` x ` is not free in ` ph ` , then it is not free in ` -. ph ` . (Contributed by Mario Carneiro, 24-Sep-2016.) (Proof shortened by Wolf Lammen, 28-Dec-2017.) (Revised by BJ, 24-Jul-2019.)
theorem nfnt {x3: setvar} (ph: wff x3):
  $ wi (wnf x3 ph) (wnf x3 (wn ph)) $;

--| Deduction associated with ~ nfnt . (Contributed by Mario Carneiro, 24-Sep-2016.)
theorem nfnd {x3: setvar} (ph ps: wff x3):
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wn ps)) $;

--| Inference associated with ~ nfnt . (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfn {x3: setvar} (ph: wff x3):
  $ wnf x3 ph $ >
  $ wnf x3 (wn ph) $;

--| If ` x ` is not free in ` ph ` , it is not free in ` DECID ph ` . (Contributed by Jim Kingdon, 11-Mar-2018.)
theorem nfdc {x3: setvar} (ph: wff x3):
  $ wnf x3 ph $ >
  $ wnf x3 (wdc ph) $;

--| The analog in our predicate calculus of axiom 5 of modal logic S5. (Contributed by NM, 5-Oct-2005.)
theorem modal_5 {x3: setvar} (ph: wff x3):
  $ wi (wn (wal x3 (wn ph))) (wal x3 (wn (wal x3 (wn ph)))) $;

--| A deduction version of one direction of ~ 19.9 . (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 24-Sep-2016.)
theorem _19_9d {x3: setvar} (ph ps: wff x3):
  $ wi ps (wnf x3 ph) $ >
  $ wi ps (wi (wex x3 ph) ph) $;

--| A deduction version of one direction of ~ 19.9 . This is an older variation of this theorem; new proofs should use ~ 19.9d . (Contributed by NM, 5-Aug-1993.) (New usage is discouraged.)
theorem _19_9hd {x3: setvar} (ph ps: wff x3):
  $ wi ps (wal x3 ps) $ >
  $ wi ps (wi ph (wal x3 ph)) $ >
  $ wi ps (wi (wex x3 ph) ph) $;

--| One direction of Theorem 19.11 of [Margaris] p. 89. (Contributed by NM, 5-Aug-1993.)
theorem excomim {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wex x3 (wex y1 ph)) (wex y1 (wex x3 ph)) $;

--| Theorem 19.11 of [Margaris] p. 89. (Contributed by NM, 5-Aug-1993.)
theorem excom {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wex x3 (wex y1 ph)) (wex y1 (wex x3 ph)) $;

--| Theorem 19.12 of [Margaris] p. 89. Assuming the converse is a mistake sometimes made by beginners! (Contributed by NM, 5-Aug-1993.)
theorem _19_12 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wex x3 (wal y1 ph)) (wal y1 (wex x3 ph)) $;

--| Theorem 19.19 of [Margaris] p. 90. (Contributed by NM, 12-Mar-1993.)
theorem _19_19 {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wi (wal x3 (wb ph ps)) (wb ph (wex x3 ps)) $;

--| Theorem 19.21 of [Margaris] p. 90 but with 2 quantifiers. (Contributed by NM, 4-Feb-2005.)
theorem _19_21_2 {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wb (wal x3 (wal y1 (wi ph ps))) (wi ph (wal x3 (wal y1 ps))) $;

--| An alternative definition of ~ df-nf , which does not involve nested quantifiers on the same variable. (Contributed by Mario Carneiro, 24-Sep-2016.)
theorem nf2 {x3: setvar} (ph: wff x3):
  $ wb (wnf x3 ph) (wi (wex x3 ph) (wal x3 ph)) $;

--| An alternative definition of ~ df-nf . (Contributed by Mario Carneiro, 24-Sep-2016.)
theorem nf3 {x3: setvar} (ph: wff x3):
  $ wb (wnf x3 ph) (wal x3 (wi (wex x3 ph) ph)) $;

--| Variable ` x ` is effectively not free in ` ph ` iff ` ph ` is always true or always false, given a decidability condition. The reverse direction, ~ nf4r , holds for all propositions. (Contributed by Jim Kingdon, 21-Jul-2018.)
theorem nf4dc {x3: setvar} (ph: wff x3):
  $ wi (wdc (wex x3 ph)) (wb (wnf x3 ph) (wo (wal x3 ph) (wal x3 (wn ph)))) $;

--| If ` ph ` is always true or always false, then variable ` x ` is effectively not free in ` ph ` . The converse holds given a decidability condition, as seen at ~ nf4dc . (Contributed by Jim Kingdon, 21-Jul-2018.)
theorem nf4r {x3: setvar} (ph: wff x3):
  $ wi (wo (wal x3 ph) (wal x3 (wn ph))) (wnf x3 ph) $;

--| Inference from Theorem 19.36 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.) (Revised by NM, 2-Feb-2015.)
theorem _19_36i {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ps $ >
  $ wex x3 (wi ph ps) $ >
  $ wi (wal x3 ph) ps $;

--| Closed form of ~ 19.36i . One direction of Theorem 19.36 of [Margaris] p. 90. The converse holds in classical logic, but does not hold (for all propositions) in intuitionistic logic. (Contributed by Jim Kingdon, 20-Jun-2018.)
theorem _19_36_1 {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ps $ >
  $ wi (wex x3 (wi ph ps)) (wi (wal x3 ph) ps) $;

--| One direction of Theorem 19.37 of [Margaris] p. 90. The converse holds in classical logic but not, in general, here. (Contributed by Jim Kingdon, 21-Jun-2018.)
theorem _19_37_1 {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wi (wex x3 (wi ph ps)) (wi ph (wex x3 ps)) $;

--| Inference from Theorem 19.37 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.)
theorem _19_37aiv {x3: setvar} (ph: wff) (ps: wff x3):
  $ wex x3 (wi ph ps) $ >
  $ wi ph (wex x3 ps) $;

--| Theorem 19.38 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.)
theorem _19_38 {x3: setvar} (ph ps: wff x3):
  $ wi (wi (wex x3 ph) (wal x3 ps)) (wal x3 (wi ph ps)) $;

--| Closed form of Theorem 19.23 of [Margaris] p. 90. (Contributed by NM, 7-Nov-2005.) (Proof shortened by Wolf Lammen, 2-Jan-2018.)
theorem _19_23t {x3: setvar} (ph ps: wff x3):
  $ wi (wnf x3 ps) (wb (wal x3 (wi ph ps)) (wi (wex x3 ph) ps)) $;

--| Theorem 19.23 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 24-Sep-2016.)
theorem _19_23 {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ps $ >
  $ wb (wal x3 (wi ph ps)) (wi (wex x3 ph) ps) $;

--| Theorem 19.32 of [Margaris] p. 90, where ` ph ` is decidable. (Contributed by Jim Kingdon, 4-Jun-2018.)
theorem _19_32dc {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wi (wdc ph) (wb (wal x3 (wo ph ps)) (wo ph (wal x3 ps))) $;

--| One direction of Theorem 19.32 of [Margaris] p. 90. The converse holds if ` ph ` is decidable, as seen at ~ 19.32dc . (Contributed by Jim Kingdon, 28-Jul-2018.)
theorem _19_32r {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wi (wo ph (wal x3 ps)) (wal x3 (wo ph ps)) $;

--| One direction of Theorem 19.31 of [Margaris] p. 90. The converse holds in classical logic, but not intuitionistic logic. (Contributed by Jim Kingdon, 28-Jul-2018.)
theorem _19_31r {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ps $ >
  $ wi (wo (wal x3 ph) ps) (wal x3 (wo ph ps)) $;

--| Theorem 19.44 of [Margaris] p. 90. (Contributed by NM, 12-Mar-1993.)
theorem _19_44 {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ps $ >
  $ wb (wex x3 (wo ph ps)) (wo (wex x3 ph) ps) $;

--| Theorem 19.45 of [Margaris] p. 90. (Contributed by NM, 12-Mar-1993.)
theorem _19_45 {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wb (wex x3 (wo ph ps)) (wo ph (wex x3 ps)) $;

--| Theorem 19.34 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.)
theorem _19_34 {x3: setvar} (ph ps: wff x3):
  $ wi (wo (wal x3 ph) (wex x3 ps)) (wex x3 (wo ph ps)) $;

--| Theorem 19.41 of [Margaris] p. 90. New proofs should use ~ 19.41 instead. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 25-May-2011.) (New usage is discouraged.)
theorem _19_41h {x3: setvar} (ph ps: wff x3):
  $ wi ps (wal x3 ps) $ >
  $ wb (wex x3 (wa ph ps)) (wa (wex x3 ph) ps) $;

--| Theorem 19.41 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 25-May-2011.) (Proof shortened by Wolf Lammen, 12-Jan-2018.)
theorem _19_41 {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ps $ >
  $ wb (wex x3 (wa ph ps)) (wa (wex x3 ph) ps) $;

--| Theorem 19.42 of [Margaris] p. 90. New proofs should use ~ 19.42 instead. (Contributed by NM, 18-Aug-1993.) (New usage is discouraged.)
theorem _19_42h {x3: setvar} (ph ps: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wb (wex x3 (wa ph ps)) (wa ph (wex x3 ps)) $;

--| Theorem 19.42 of [Margaris] p. 90. (Contributed by NM, 18-Aug-1993.)
theorem _19_42 {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wb (wex x3 (wa ph ps)) (wa ph (wex x3 ps)) $;

--| Swap 1st and 3rd existential quantifiers. (Contributed by NM, 9-Mar-1995.)
theorem excom13 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wb (wex x3 (wex y1 (wex z ph))) (wex z (wex y1 (wex x3 ph))) $;

--| Rotate existential quantifiers. (Contributed by NM, 17-Mar-1995.)
theorem exrot3 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wb (wex x3 (wex y1 (wex z ph))) (wex y1 (wex z (wex x3 ph))) $;

--| Rotate existential quantifiers twice. (Contributed by NM, 9-Mar-1995.)
theorem exrot4 {x3 y1 z w: setvar} (ph: wff x3 y1 z w):
  $ wb (wex x3 (wex y1 (wex z (wex w ph)))) (wex z (wex w (wex x3 (wex y1 ph)))) $;

--| Inference from ~ 19.8a . (Contributed by Jeff Hankins, 26-Jul-2009.)
theorem nexr {x3: setvar} (ph: wff x3):
  $ wn (wex x3 ph) $ >
  $ wn ph $;

--| Place a conjunct in the scope of an existential quantifier. (Contributed by NM, 18-Aug-1993.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem exan {x3: setvar} (ph ps: wff x3):
  $ wa (wex x3 ph) ps $ >
  $ wex x3 (wa ph ps) $;

--| Deduction form of bound-variable hypothesis builder ~ hbex . (Contributed by NM, 2-Jan-2002.)
theorem hbexd {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wi ps (wal x3 ps)) $ >
  $ wi ph (wi (wex y1 ps) (wal x3 (wex y1 ps))) $;

--| Rearrange existential quantifiers. (Contributed by NM, 8-Aug-1994.)
theorem eeor {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wb (wex x3 (wex y1 (wo ph ps))) (wo (wex x3 ph) (wex y1 ps)) $;

--| At least one individual exists. This is not a theorem of free logic, which is sound in empty domains. For such a logic, we would add this theorem as an axiom of set theory (Axiom 0 of [Kunen] p. 10). In the system consisting of ~ ax-5 through ~ ax-14 and ~ ax-17 , all axioms other than ~ ax-9 are believed to be theorems of free logic, although the system without ~ ax-9 is probably not complete in free logic. (Contributed by NM, 5-Aug-1993.) (Revised by NM, 3-Feb-2015.)
theorem a9e {x3: setvar} (y1: setvar):
  $ wex x3 (wceq (cv x3) (cv y1)) $;

--| At least one individual exists. Weaker version of ~ a9e . (Contributed by NM, 3-Aug-2017.)
theorem a9ev {x3: setvar} (y1: setvar):
  $ wex x3 (wceq (cv x3) (cv y1)) $;

--| An implication related to substitution. (Contributed by NM, 5-Aug-1993.) (Revised by NM, 3-Feb-2015.)
theorem ax9o {x3: setvar} (ph: wff x3) (y1: setvar):
  $ wi (wal x3 (wi (wceq (cv x3) (cv y1)) (wal x3 ph))) ph $;

--| Identity law for equality (reflexivity). Lemma 6 of [Tarski] p. 68. This is often an axiom of equality in textbook systems, but we don't need it as an axiom since it can be proved from our other axioms. This proof is similar to Tarski's and makes use of a dummy variable ` y ` . It also works in intuitionistic logic, unlike some other possible ways of proving this theorem. (Contributed by NM, 1-Apr-2005.)
theorem equid (x3: setvar):
  $ wceq (cv x3) (cv x3) $;

--| Bound-variable hypothesis builder for ` x = x ` . This theorem tells us that any variable, including ` x ` , is effectively not free in ` x = x ` , even though ` x ` is technically free according to the traditional definition of free variable. (Contributed by NM, 13-Jan-2011.) (Revised by NM, 21-Aug-2017.)
theorem nfequid {y1: setvar} (x3: setvar):
  $ wnf y1 (wceq (cv x3) (cv x3)) $;

--| One of the two equality axioms of standard predicate calculus, called reflexivity of equality. (The other one is ~ stdpc7 .) Axiom 6 of [Mendelson] p. 95. Mendelson doesn't say why he prepended the redundant quantifier, but it was probably to be compatible with free logic (which is valid in the empty domain). (Contributed by NM, 16-Feb-2005.)
theorem stdpc6 {x3: setvar}:
  $ wal x3 (wceq (cv x3) (cv x3)) $;

--| Commutative law for equality. Lemma 7 of [Tarski] p. 69. (Contributed by NM, 5-Aug-1993.)
theorem equcomi (x3 y1: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wceq (cv y1) (cv x3)) $;

--| Commutative law for equality. Lemma 7 of [Tarski] p. 69. (Contributed by NM, 5-Aug-1993.)
theorem equcomi_b (x3: setvar):
  $ wi (wceq (cv x3) (cv x3)) (wceq (cv x3) (cv x3)) $;

--| Commutative law for equality. (Contributed by NM, 20-Aug-1993.)
theorem equcom (x3 y1: setvar):
  $ wb (wceq (cv x3) (cv y1)) (wceq (cv y1) (cv x3)) $;

--| An inference commuting equality in antecedent. Used to eliminate the need for a syllogism. (Contributed by NM, 5-Aug-1993.)
theorem equcoms {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) ph $ >
  $ wi (wceq (cv y1) (cv x3)) ph $;

--| An inference commuting equality in antecedent. Used to eliminate the need for a syllogism. (Contributed by NM, 5-Aug-1993.)
theorem equcoms_b {x3: setvar} (ph: wff x3):
  $ wi (wceq (cv x3) (cv x3)) ph $ >
  $ wi (wceq (cv x3) (cv x3)) ph $;

--| A transitive law for equality. (Contributed by NM, 23-Aug-1993.)
theorem equtr {x3 y1: setvar} (z: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wi (wceq (cv y1) (cv z)) (wceq (cv x3) (cv z))) $;

--| A transitive law for equality. (Contributed by NM, 23-Aug-1993.)
theorem equtr_b {x3 y1: setvar}:
  $ wi (wceq (cv x3) (cv y1)) (wi (wceq (cv y1) (cv y1)) (wceq (cv x3) (cv y1))) $;

--| A transitive law for equality. Lemma L17 in [Megill] p. 446 (p. 14 of the preprint). (Contributed by NM, 23-Aug-1993.)
theorem equtrr {x3 z: setvar} (y1: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wi (wceq (cv z) (cv x3)) (wceq (cv z) (cv y1))) $;

--| A transitive law for equality. (Contributed by NM, 12-Aug-1993.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem equtr2 {x3 y1 z: setvar}:
  $ wi (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv z))) (wceq (cv x3) (cv y1)) $;

--| An equivalence law for equality. (Contributed by NM, 5-Aug-1993.)
theorem equequ1 {x3 y1: setvar} (z: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wb (wceq (cv x3) (cv z)) (wceq (cv y1) (cv z))) $;

--| An equivalence law for equality. (Contributed by NM, 5-Aug-1993.)
theorem equequ1_b {x3 y1: setvar}:
  $ wi (wceq (cv x3) (cv y1)) (wb (wceq (cv x3) (cv y1)) (wceq (cv y1) (cv y1))) $;

--| An equivalence law for equality. (Contributed by NM, 5-Aug-1993.)
theorem equequ2 {x3 y1 z: setvar}:
  $ wi (wceq (cv x3) (cv y1)) (wb (wceq (cv z) (cv x3)) (wceq (cv z) (cv y1))) $;

--| An identity law for the non-logical predicate. (Contributed by NM, 5-Aug-1993.)
theorem elequ1 {x3 y1: setvar} (z: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wb (wcel (cv x3) (cv z)) (wcel (cv y1) (cv z))) $;

--| An identity law for the non-logical predicate. (Contributed by NM, 5-Aug-1993.)
theorem elequ1_b {x3 y1: setvar}:
  $ wi (wceq (cv x3) (cv y1)) (wb (wcel (cv x3) (cv x3)) (wcel (cv y1) (cv x3))) $;

--| An identity law for the non-logical predicate. (Contributed by NM, 5-Aug-1993.)
theorem elequ1_b1 {x3 y1: setvar}:
  $ wi (wceq (cv x3) (cv y1)) (wb (wcel (cv x3) (cv y1)) (wcel (cv y1) (cv y1))) $;

--| An identity law for the non-logical predicate. (Contributed by NM, 5-Aug-1993.)
theorem elequ2 {x3 y1: setvar} (z: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wb (wcel (cv z) (cv x3)) (wcel (cv z) (cv y1))) $;

--| An identity law for the non-logical predicate. (Contributed by NM, 5-Aug-1993.)
theorem elequ2_b {x3 y1: setvar}:
  $ wi (wceq (cv x3) (cv y1)) (wb (wcel (cv y1) (cv x3)) (wcel (cv y1) (cv y1))) $;

--| Inference that has ~ ax-11 (without ` A. y ` ) as its conclusion and doesn't require ~ ax-10 , ~ ax-11 , or ~ ax-12 for its proof. The hypotheses may be eliminable without one or more of these axioms in special cases. Proof similar to Lemma 16 of [Tarski] p. 70. (Contributed by NM, 20-May-2008.)
theorem ax11i {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi ps (wal x3 ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wi ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph))) $;

--| Show that ~ ax-10o can be derived from ~ ax-10 . An open problem is whether this theorem can be derived from ~ ax-10 and the others when ~ ax-11 is replaced with ~ ax-11o . See theorem ~ ax10 for the rederivation of ~ ax-10 from ~ ax10o . Normally, ~ ax10o should be used rather than ~ ax-10o , except by theorems specifically studying the latter's properties. (Contributed by NM, 16-May-2008.)
theorem ax10o {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi (wal x3 ph) (wal y1 ph)) $;

--| Show that ~ ax-10o can be derived from ~ ax-10 . An open problem is whether this theorem can be derived from ~ ax-10 and the others when ~ ax-11 is replaced with ~ ax-11o . See theorem ~ ax10 for the rederivation of ~ ax-10 from ~ ax10o . Normally, ~ ax10o should be used rather than ~ ax-10o , except by theorems specifically studying the latter's properties. (Contributed by NM, 16-May-2008.)
theorem ax10o_b {x3: setvar} (ph: wff x3):
  $ wi (wal x3 (wceq (cv x3) (cv x3))) (wi (wal x3 ph) (wal x3 ph)) $;

--| Axiom ~ ax-10o ("o" for "old") was the original version of ~ ax-10 , before it was discovered (in May 2008) that the shorter ~ ax-10 could replace it. It appears as Axiom scheme C11' in [Megill] p. 448 (p. 16 of the preprint). This axiom is redundant, as shown by theorem ~ ax10o . Normally, ~ ax10o should be used rather than ~ ax-10o , except by theorems specifically studying the latter's properties. (Contributed by NM, 5-Aug-1993.) (New usage is discouraged.)
axiom ax_10o {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi (wal x3 ph) (wal y1 ph)) $;

--| Rederivation of ~ ax-10 from original version ~ ax-10o . See theorem ~ ax10o for the derivation of ~ ax-10o from ~ ax-10 . This theorem should not be referenced in any proof. Instead, use ~ ax-10 above so that uses of ~ ax-10 can be more easily identified. (Contributed by NM, 16-May-2008.) (New usage is discouraged.)
theorem ax10 {x3 y1: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal y1 (wceq (cv y1) (cv x3))) $;

--| All variables are effectively bound in an identical variable specifier. (Contributed by NM, 5-Aug-1993.) (Revised by NM, 3-Feb-2015.)
theorem hbae {x3 y1 z: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal z (wal x3 (wceq (cv x3) (cv y1)))) $;

--| All variables are effectively bound in an identical variable specifier. (Contributed by NM, 5-Aug-1993.) (Revised by NM, 3-Feb-2015.)
theorem hbae_b {x3: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv x3))) (wal x3 (wal x3 (wceq (cv x3) (cv x3)))) $;

--| All variables are effectively bound in an identical variable specifier. (Contributed by NM, 5-Aug-1993.) (Revised by NM, 3-Feb-2015.)
theorem hbae_b1 {x3 y1: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal x3 (wal x3 (wceq (cv x3) (cv y1)))) $;

--| All variables are effectively bound in an identical variable specifier. (Contributed by NM, 5-Aug-1993.) (Revised by NM, 3-Feb-2015.)
theorem hbae_b2 {x3 y1: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal y1 (wal x3 (wceq (cv x3) (cv y1)))) $;

--| All variables are effectively bound in an identical variable specifier. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfae {x3 y1 z: setvar}:
  $ wnf z (wal x3 (wceq (cv x3) (cv y1))) $;

--| All variables are effectively bound in an identical variable specifier. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfae_b {x3 y1: setvar}:
  $ wnf x3 (wal x3 (wceq (cv x3) (cv y1))) $;

--| All variables are effectively bound in an identical variable specifier. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfae_b1 {x3 y1: setvar}:
  $ wnf y1 (wal x3 (wceq (cv x3) (cv y1))) $;

--| Rule that applies ~ hbae to antecedent. (Contributed by NM, 5-Aug-1993.)
theorem hbaes {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wal z (wal x3 (wceq (cv x3) (cv y1)))) ph $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) ph $;

--| All variables are effectively bound in a distinct variable specifier. Lemma L19 in [Megill] p. 446 (p. 14 of the preprint). (Contributed by NM, 5-Aug-1993.)
theorem hbnae {x3 y1 z: setvar}:
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wal z (wn (wal x3 (wceq (cv x3) (cv y1))))) $;

--| All variables are effectively bound in a distinct variable specifier. Lemma L19 in [Megill] p. 446 (p. 14 of the preprint). (Contributed by NM, 5-Aug-1993.)
theorem hbnae_b {x3 y1: setvar}:
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wal x3 (wn (wal x3 (wceq (cv x3) (cv y1))))) $;

--| All variables are effectively bound in a distinct variable specifier. Lemma L19 in [Megill] p. 446 (p. 14 of the preprint). (Contributed by NM, 5-Aug-1993.)
theorem hbnae_b1 {x3 y1: setvar}:
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wal y1 (wn (wal x3 (wceq (cv x3) (cv y1))))) $;

--| All variables are effectively bound in a distinct variable specifier. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfnae {x3 y1 z: setvar}:
  $ wnf z (wn (wal x3 (wceq (cv x3) (cv y1)))) $;

--| All variables are effectively bound in a distinct variable specifier. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfnae_b {x3 y1: setvar}:
  $ wnf x3 (wn (wal x3 (wceq (cv x3) (cv y1)))) $;

--| Rule that applies ~ hbnae to antecedent. (Contributed by NM, 5-Aug-1993.)
theorem hbnaes {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wal z (wn (wal x3 (wceq (cv x3) (cv y1))))) ph $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) ph $;

--| Rule that applies ~ hbnae to antecedent. (Contributed by NM, 5-Aug-1993.)
theorem hbnaes_b {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wn (wal x3 (wceq (cv x3) (cv y1))))) ph $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) ph $;

--| A commutation rule for distinct variable specifiers. (Contributed by NM, 2-Jan-2002.)
theorem naecoms {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) ph $ >
  $ wi (wn (wal y1 (wceq (cv y1) (cv x3)))) ph $;

--| Lemma used in proofs of substitution properties. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Mario Carneiro, 20-May-2014.)
theorem equs4 {x3: setvar} (ph: wff x3) (y1: setvar):
  $ wi (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) (wex x3 (wa (wceq (cv x3) (cv y1)) ph)) $;

--| A useful equivalence related to substitution. New proofs should use ~ equsal instead. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 12-Aug-2011.) (New usage is discouraged.)
theorem equsalh {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ps (wal x3 ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) ps $;

--| A useful equivalence related to substitution. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 12-Aug-2011.) (Revised by Mario Carneiro, 3-Oct-2016.) (Proof shortened by Wolf Lammen, 5-Feb-2018.)
theorem equsal {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) ps $;

--| A useful equivalence related to substitution. (Contributed by NM, 5-Aug-1993.) (Revised by NM, 3-Feb-2015.)
theorem equsex {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ps (wal x3 ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wex x3 (wa (wceq (cv x3) (cv y1)) ph)) ps $;

--| Deduction form of ~ equsex . (Contributed by Jim Kingdon, 29-Dec-2017.)
theorem equsexd {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wi ch (wal x3 ch)) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi ph (wb (wex x3 (wa (wceq (cv x3) (cv y1)) ps)) ch) $;

--| Formula-building lemma for use with the Distinctor Reduction Theorem. Part of Theorem 9.4 of [Megill] p. 448 (p. 16 of preprint). (Contributed by NM, 24-Nov-1994.)
theorem dral1 {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb ph ps) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wal x3 ph) (wal y1 ps)) $;

--| Formula-building lemma for use with the Distinctor Reduction Theorem. Part of Theorem 9.4 of [Megill] p. 448 (p. 16 of preprint). (Contributed by NM, 24-Nov-1994.)
theorem dral1_b {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wceq (cv x3) (cv x3))) (wb ph ps) $ >
  $ wi (wal x3 (wceq (cv x3) (cv x3))) (wb (wal x3 ph) (wal x3 ps)) $;

--| Formula-building lemma for use with the Distinctor Reduction Theorem. Part of Theorem 9.4 of [Megill] p. 448 (p. 16 of preprint). (Contributed by NM, 27-Feb-2005.)
theorem dral2 {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb ph ps) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wal z ph) (wal z ps)) $;

--| Formula-building lemma for use with the Distinctor Reduction Theorem. Part of Theorem 9.4 of [Megill] p. 448 (p. 16 of preprint). (Contributed by NM, 27-Feb-2005.)
theorem dral2_b {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb ph ps) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wal x3 ph) (wal x3 ps)) $;

--| Formula-building lemma for use with the Distinctor Reduction Theorem. Part of Theorem 9.4 of [Megill] p. 448 (p. 16 of preprint). (Contributed by NM, 27-Feb-2005.)
theorem drex2 {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb ph ps) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wex z ph) (wex z ps)) $;

--| Formula-building lemma for use with the Distinctor Reduction Theorem. Part of Theorem 9.4 of [Megill] p. 448 (p. 16 of preprint). (Contributed by NM, 27-Feb-2005.)
theorem drex2_b {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb ph ps) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wex x3 ph) (wex x3 ps)) $;

--| Formula-building lemma for use with the Distinctor Reduction Theorem. (Contributed by Mario Carneiro, 4-Oct-2016.)
theorem drnf1 {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb ph ps) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wnf x3 ph) (wnf y1 ps)) $;

--| Formula-building lemma for use with the Distinctor Reduction Theorem. (Contributed by Mario Carneiro, 4-Oct-2016.)
theorem drnf2 {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb ph ps) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wnf z ph) (wnf z ps)) $;

--| Formula-building lemma for use with the Distinctor Reduction Theorem. (Contributed by Mario Carneiro, 4-Oct-2016.)
theorem drnf2_b {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb ph ps) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wnf x3 ph) (wnf x3 ps)) $;

--| Closed theorem form of ~ spim . (Contributed by NM, 15-Jan-2008.) (New usage is discouraged.)
theorem spimth {x3: setvar} (ph ps: wff x3) (y1: setvar):
  $ wi (wal x3 (wa (wi ps (wal x3 ps)) (wi (wceq (cv x3) (cv y1)) (wi ph ps)))) (wi (wal x3 ph) ps) $;

--| Closed theorem form of ~ spim . (Contributed by NM, 15-Jan-2008.) (Revised by Mario Carneiro, 17-Oct-2016.) (Proof shortened by Wolf Lammen, 24-Feb-2018.)
theorem spimt {x3: setvar} (ph ps: wff x3) (y1: setvar):
  $ wi (wa (wnf x3 ps) (wal x3 (wi (wceq (cv x3) (cv y1)) (wi ph ps)))) (wi (wal x3 ph) ps) $;

--| Specialization, using implicit substitition. Compare Lemma 14 of [Tarski] p. 70. The ~ spim series of theorems requires that only one direction of the substitution hypothesis hold. (Contributed by NM, 5-Aug-1993.) (Revised by NM, 8-May-2008.) (New usage is discouraged.)
theorem spimh {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ps (wal x3 ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wi ph ps) $ >
  $ wi (wal x3 ph) ps $;

--| Specialization, using implicit substitution. Compare Lemma 14 of [Tarski] p. 70. The ~ spim series of theorems requires that only one direction of the substitution hypothesis hold. (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 3-Oct-2016.) (Proof rewritten by Jim Kingdon, 10-Jun-2018.)
theorem spim {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wi ph ps) $ >
  $ wi (wal x3 ph) ps $;

--| Existential introduction, using implicit substitition. Compare Lemma 14 of [Tarski] p. 70. (Contributed by NM, 7-Aug-1994.) (Revised by NM, 3-Feb-2015.) (New usage is discouraged.)
theorem spimeh {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi (wceq (cv x3) (cv y1)) (wi ph ps) $ >
  $ wi ph (wex x3 ps) $;

--| Deduction version of ~ spime . (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 3-Oct-2016.) (Proof shortened by Wolf Lammen, 19-Feb-2018.)
theorem spimed {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi ch (wnf x3 ph) $ >
  $ wi (wceq (cv x3) (cv y1)) (wi ph ps) $ >
  $ wi ch (wi ph (wex x3 ps)) $;

--| Existential introduction, using implicit substitution. Compare Lemma 14 of [Tarski] p. 70. (Contributed by NM, 7-Aug-1994.) (Revised by Mario Carneiro, 3-Oct-2016.) (Proof shortened by Wolf Lammen, 6-Mar-2018.)
theorem spime {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf x3 ph $ >
  $ wi (wceq (cv x3) (cv y1)) (wi ph ps) $ >
  $ wi ph (wex x3 ps) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Wolf Lammen, 12-May-2018.)
theorem cbv3 {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wi ph ps) $ >
  $ wi (wal x3 ph) (wal y1 ps) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 25-May-2011.) (Proof shortened by Wolf Lammen, 12-May-2018.)
theorem cbv3h {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wi ps (wal x3 ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wi ph ps) $ >
  $ wi (wal x3 ph) (wal y1 ps) $;

--| Rule used to change bound variables, using implicit substitution. Revised to format hypotheses to common style. (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 3-Oct-2016.) (Revised by Wolf Lammen, 13-May-2018.)
theorem cbv1 {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wnf y1 ps) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wi ps ch)) $ >
  $ wi ph (wi (wal x3 ps) (wal y1 ch)) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Wolf Lammen, 13-May-2018.)
theorem cbv1h {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi ph (wi ps (wal y1 ps)) $ >
  $ wi ph (wi ch (wal x3 ch)) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wi ps ch)) $ >
  $ wi (wal x3 (wal y1 ph)) (wi (wal x3 ps) (wal y1 ch)) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by NM, 5-Aug-1993.)
theorem cbv2h {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi ph (wi ps (wal y1 ps)) $ >
  $ wi ph (wi ch (wal x3 ch)) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi (wal x3 (wal y1 ph)) (wb (wal x3 ps) (wal y1 ch)) $;

--| Rule used to change bound variables, using implicit substitution. Revised to align format of hypotheses to common style. (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 3-Oct-2016.) (Revised by Wolf Lammen, 13-May-2018.)
theorem cbv2 {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wnf y1 ps) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi ph (wb (wal x3 ps) (wal y1 ch)) $;

--| Rule used to change bound variables, using implicit substitition. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem cbvalh {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wi ps (wal x3 ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wal x3 ph) (wal y1 ps) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 3-Oct-2016.)
theorem cbval {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wal x3 ph) (wal y1 ps) $;

--| Rule used to change bound variables, using implicit substitition. (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 3-Feb-2015.)
theorem cbvexh {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wi ps (wal x3 ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wex x3 ph) (wex y1 ps) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by NM, 5-Aug-1993.)
theorem cbvex {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wex x3 ph) (wex y1 ps) $;

--| Implicit substitution of ` y ` for ` x ` into a theorem. (Contributed by Raph Levien, 9-Jul-2003.) (Revised by Mario Carneiro, 3-Oct-2016.)
theorem chvar {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ ph $ >
  $ ps $;

--| A variable introduction law for equality. Lemma 15 of [Monk2] p. 109, however we do not require ` z ` to be distinct from ` x ` and ` y ` (making the proof longer). (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem equvini {x3 z: setvar} (y1: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wex z (wa (wceq (cv x3) (cv z)) (wceq (cv z) (cv y1)))) $;

--| A variable elimination law for equality with no distinct variable requirements. (Compare ~ equvini .) (Contributed by NM, 1-Mar-2013.) (Revised by NM, 3-Feb-2015.)
theorem equveli {x3 y1 z: setvar}:
  $ wi (wal z (wb (wceq (cv z) (cv x3)) (wceq (cv z) (cv y1)))) (wceq (cv x3) (cv y1)) $;

--| If ` x ` is not free in ` ph ` , it is not free in ` A. y ph ` . (Contributed by Mario Carneiro, 24-Sep-2016.) (Proof shortened by Wolf Lammen, 6-Jan-2018.)
theorem nfald {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wal y1 ps)) $;

--| If ` x ` is not free in ` ph ` , it is not free in ` E. y ph ` . (Contributed by Mario Carneiro, 24-Sep-2016.) (Proof rewritten by Jim Kingdon, 7-Feb-2018.)
theorem nfexd {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wex y1 ps)) $;

--| Extend wff definition to include proper substitution (read "the wff that results when ` y ` is properly substituted for ` x ` in wff ` ph ` "). (Contributed by NM, 24-Jan-2006.)
term wsb {x3 y1: setvar} (ph: wff x3 y1): wff;

--| Define proper substitution. Remark 9.1 in [Megill] p. 447 (p. 15 of the preprint). For our notation, we use ` [ y / x ] ph ` to mean "the wff that results when ` y ` is properly substituted for ` x ` in the wff ` ph ` ." We can also use ` [ y / x ] ph ` in place of the "free for" side condition used in traditional predicate calculus; see, for example, ~ stdpc4 . Our notation was introduced in Haskell B. Curry's _Foundations of Mathematical Logic_ (1977), p. 316 and is frequently used in textbooks of lambda calculus and combinatory logic. This notation improves the common but ambiguous notation, " ` ph ( y ) ` is the wff that results when ` y ` is properly substituted for ` x ` in ` ph ( x ) ` ." For example, if the original ` ph ( x ) ` is ` x = y ` , then ` ph ( y ) ` is ` y = y ` , from which we obtain that ` ph ( x ) ` is ` x = x ` . So what exactly does ` ph ( x ) ` mean? Curry's notation solves this problem. In most books, proper substitution has a somewhat complicated recursive definition with multiple cases based on the occurrences of free and bound variables in the wff. Instead, we use a single formula that is exactly equivalent and gives us a direct definition. We later prove that our definition has the properties we expect of proper substitution (see theorems ~ sbequ , ~ sbcom2 and ~ sbid2v ). Note that our definition is valid even when ` x ` and ` y ` are replaced with the same variable, as ~ sbid shows. We achieve this by having ` x ` free in the first conjunct and bound in the second. We can also achieve this by using a dummy variable, as the alternate definition ~ dfsb7 shows (which some logicians may prefer because it doesn't mix free and bound variables). Another alternate definition which uses a dummy variable is ~ dfsb7a . When ` x ` and ` y ` are distinct, we can express proper substitution with the simpler expressions of ~ sb5 and ~ sb6 . In classical logic, another possible definition is ` ( x = y /\ ph ) \/ A. x ( x = y -> ph ) ` but we do not have an intuitionistic proof that this is equivalent. There are no restrictions on any of the variables, including what variables may occur in wff ` ph ` . (Contributed by NM, 5-Aug-1993.)
axiom df_sb {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wsb x3 y1 ph) (wa (wi (wceq (cv x3) (cv y1)) ph) (wex x3 (wa (wceq (cv x3) (cv y1)) ph))) $;

--| Define proper substitution. Remark 9.1 in [Megill] p. 447 (p. 15 of the preprint). For our notation, we use ` [ y / x ] ph ` to mean "the wff that results when ` y ` is properly substituted for ` x ` in the wff ` ph ` ." We can also use ` [ y / x ] ph ` in place of the "free for" side condition used in traditional predicate calculus; see, for example, ~ stdpc4 . Our notation was introduced in Haskell B. Curry's _Foundations of Mathematical Logic_ (1977), p. 316 and is frequently used in textbooks of lambda calculus and combinatory logic. This notation improves the common but ambiguous notation, " ` ph ( y ) ` is the wff that results when ` y ` is properly substituted for ` x ` in ` ph ( x ) ` ." For example, if the original ` ph ( x ) ` is ` x = y ` , then ` ph ( y ) ` is ` y = y ` , from which we obtain that ` ph ( x ) ` is ` x = x ` . So what exactly does ` ph ( x ) ` mean? Curry's notation solves this problem. In most books, proper substitution has a somewhat complicated recursive definition with multiple cases based on the occurrences of free and bound variables in the wff. Instead, we use a single formula that is exactly equivalent and gives us a direct definition. We later prove that our definition has the properties we expect of proper substitution (see theorems ~ sbequ , ~ sbcom2 and ~ sbid2v ). Note that our definition is valid even when ` x ` and ` y ` are replaced with the same variable, as ~ sbid shows. We achieve this by having ` x ` free in the first conjunct and bound in the second. We can also achieve this by using a dummy variable, as the alternate definition ~ dfsb7 shows (which some logicians may prefer because it doesn't mix free and bound variables). Another alternate definition which uses a dummy variable is ~ dfsb7a . When ` x ` and ` y ` are distinct, we can express proper substitution with the simpler expressions of ~ sb5 and ~ sb6 . In classical logic, another possible definition is ` ( x = y /\ ph ) \/ A. x ( x = y -> ph ) ` but we do not have an intuitionistic proof that this is equivalent. There are no restrictions on any of the variables, including what variables may occur in wff ` ph ` . (Contributed by NM, 5-Aug-1993.)
axiom df_sb_b {x3: setvar} (ph: wff x3):
  $ wb (wsb x3 x3 ph) (wa (wi (wceq (cv x3) (cv x3)) ph) (wex x3 (wa (wceq (cv x3) (cv x3)) ph))) $;

--| Infer substitution into antecedent and consequent of an implication. (Contributed by NM, 25-Jun-1998.)
theorem sbimi {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph ps $ >
  $ wi (wsb x3 y1 ph) (wsb x3 y1 ps) $;

--| Infer substitution into both sides of a logical equivalence. (Contributed by NM, 5-Aug-1993.)
theorem sbbii {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb ph ps $ >
  $ wb (wsb x3 y1 ph) (wsb x3 y1 ps) $;

--| One direction of a simplified definition of substitution. (Contributed by NM, 5-Aug-1993.)
theorem sb1 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wsb x3 y1 ph) (wex x3 (wa (wceq (cv x3) (cv y1)) ph)) $;

--| One direction of a simplified definition of substitution. (Contributed by NM, 5-Aug-1993.)
theorem sb2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) (wsb x3 y1 ph) $;

--| An equality theorem for substitution. (Contributed by NM, 5-Aug-1993.)
theorem sbequ1 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wi ph (wsb x3 y1 ph)) $;

--| An equality theorem for substitution. (Contributed by NM, 5-Aug-1993.)
theorem sbequ1_b {x3: setvar} (ph: wff x3):
  $ wi (wceq (cv x3) (cv x3)) (wi ph (wsb x3 x3 ph)) $;

--| An equality theorem for substitution. (Contributed by NM, 5-Aug-1993.)
theorem sbequ2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wi (wsb x3 y1 ph) ph) $;

--| An equality theorem for substitution. (Contributed by NM, 5-Aug-1993.)
theorem sbequ2_b {x3: setvar} (ph: wff x3):
  $ wi (wceq (cv x3) (cv x3)) (wi (wsb x3 x3 ph) ph) $;

--| One of the two equality axioms of standard predicate calculus, called substitutivity of equality. (The other one is ~ stdpc6 .) Translated to traditional notation, it can be read: " ` x = y -> ( ph ( x ` , ` x ) -> ph ( x ` , ` y ) ) ` , provided that ` y ` is free for ` x ` in ` ph ( x ` , ` y ) ` ." Axiom 7 of [Mendelson] p. 95. (Contributed by NM, 15-Feb-2005.)
theorem stdpc7 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wi (wsb y1 x3 ph) ph) $;

--| An equality theorem for substitution. (Contributed by NM, 5-Aug-1993.)
theorem sbequ12 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph (wsb x3 y1 ph)) $;

--| An equality theorem for substitution. (Contributed by NM, 5-Aug-1993.)
theorem sbequ12_b {x3: setvar} (ph: wff x3):
  $ wi (wceq (cv x3) (cv x3)) (wb ph (wsb x3 x3 ph)) $;

--| An equality theorem for substitution. (Contributed by NM, 6-Oct-2004.) (Proof shortened by Andrew Salmon, 21-Jun-2011.)
theorem sbequ12r {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wb (wsb y1 x3 ph) ph) $;

--| An equality theorem for substitution. (Contributed by NM, 5-Aug-1993.)
theorem sbequ12a {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wb (wsb x3 y1 ph) (wsb y1 x3 ph)) $;

--| An identity theorem for substitution. Remark 9.1 in [Megill] p. 447 (p. 15 of the preprint). (Contributed by NM, 5-Aug-1993.)
theorem sbid {x3: setvar} (ph: wff x3):
  $ wb (wsb x3 x3 ph) ph $;

--| The specialization axiom of standard predicate calculus. It states that if a statement ` ph ` holds for all ` x ` , then it also holds for the specific case of ` y ` (properly) substituted for ` x ` . Translated to traditional notation, it can be read: " ` A. x ph ( x ) -> ph ( y ) ` , provided that ` y ` is free for ` x ` in ` ph ( x ) ` ." Axiom 4 of [Mendelson] p. 69. (Contributed by NM, 5-Aug-1993.)
theorem stdpc4 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 ph) (wsb x3 y1 ph) $;

--| Substitution for a variable not free in a wff does not affect it. (Contributed by NM, 5-Aug-1993.) (Revised by NM, 17-Oct-2004.)
theorem sbh {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wb (wsb x3 y1 ph) ph $;

--| Substitution for a variable not free in a wff does not affect it. (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 4-Oct-2016.)
theorem sbf {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 ph $ >
  $ wb (wsb x3 y1 ph) ph $;

--| Substitution has no effect on a bound variable. (Contributed by NM, 1-Jul-2005.)
theorem sbf2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wsb x3 y1 (wal x3 ph)) (wal x3 ph) $;

--| Equivalence involving substitution for a variable not free. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 12-Aug-2011.)
theorem sb6x {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wb (wsb x3 y1 ph) (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) $;

--| If ` x ` is not free in ` ph ` , it is not free in ` [ y / x ] ph ` . (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfs1f {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf x3 (wsb x3 y1 ph) $;

--| If ` x ` is not free in ` ph ` , it is not free in ` [ y / x ] ph ` . (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem hbs1f {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi (wsb x3 y1 ph) (wal x3 (wsb x3 y1 ph)) $;

--| Substitution does not change an identical variable specifier. (Contributed by NM, 5-Aug-1993.) (Revised by NM, 21-Dec-2004.)
theorem sbequ5 {x3 y1 z w: setvar}:
  $ wb (wsb z w (wal x3 (wceq (cv x3) (cv y1)))) (wal x3 (wceq (cv x3) (cv y1))) $;

--| Substitution does not change a distinctor. (Contributed by NM, 5-Aug-1993.) (Revised by NM, 14-May-2005.)
theorem sbequ6 {x3 y1 z w: setvar}:
  $ wb (wsb z w (wn (wal x3 (wceq (cv x3) (cv y1))))) (wn (wal x3 (wceq (cv x3) (cv y1)))) $;

--| A substitution into a theorem remains true. (See ~ chvar and ~ chvarv for versions using implicit substitition.) (Contributed by NM, 21-Jan-2004.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem sbt {x3 y1: setvar} (ph: wff x3 y1):
  $ ph $ >
  $ wsb x3 y1 ph $;

--| Substitution applied to an atomic wff. (Contributed by NM, 5-Aug-1993.)
theorem equsb1 {x3 y1: setvar}:
  $ wsb x3 y1 (wceq (cv x3) (cv y1)) $;

--| Substitution applied to an atomic wff. (Contributed by NM, 5-Aug-1993.)
theorem equsb2 {x3 y1: setvar}:
  $ wsb x3 y1 (wceq (cv y1) (cv x3)) $;

--| Conversion of implicit substitution to explicit substitution (deduction version of ~ sbieh ). New proofs should use ~ sbied instead. (Contributed by NM, 30-Jun-1994.) (Proof shortened by Andrew Salmon, 25-May-2011.) (New usage is discouraged.)
theorem sbiedh {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wi ch (wal x3 ch)) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi ph (wb (wsb x3 y1 ps) ch) $;

--| Conversion of implicit substitution to explicit substitution (deduction version of ~ sbie ). (Contributed by NM, 30-Jun-1994.) (Revised by Mario Carneiro, 4-Oct-2016.)
theorem sbied {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wnf x3 ph $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi ph (wb (wsb x3 y1 ps) ch) $;

--| Conversion of implicit substitution to explicit substitution (deduction version of ~ sbie ). (Contributed by NM, 7-Jan-2017.)
theorem sbiedv {x3 y1: setvar} (ph: wff y1) (ps: wff x3 y1) (ch: wff y1):
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wb (wsb x3 y1 ps) ch) $;

--| Conversion of implicit substitution to explicit substitution. New proofs should use ~ sbie instead. (Contributed by NM, 30-Jun-1994.) (New usage is discouraged.)
theorem sbieh {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ps (wal x3 ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wsb x3 y1 ph) ps $;

--| Conversion of implicit substitution to explicit substitution. (Contributed by NM, 30-Jun-1994.) (Revised by Mario Carneiro, 4-Oct-2016.) (Revised by Wolf Lammen, 30-Apr-2018.)
theorem sbie {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wsb x3 y1 ph) ps $;

--| A property related to substitution that unlike ~ equs5 doesn't require a distinctor antecedent. (Contributed by NM, 2-Feb-2007.)
theorem equs5a {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wex x3 (wa (wceq (cv x3) (cv y1)) (wal y1 ph))) (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) $;

--| A property related to substitution that unlike ~ equs5 doesn't require a distinctor antecedent. (Contributed by NM, 2-Feb-2007.) (Revised by NM, 3-Feb-2015.)
theorem equs5e {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wex x3 (wa (wceq (cv x3) (cv y1)) ph)) (wal x3 (wi (wceq (cv x3) (cv y1)) (wex y1 ph))) $;

--| Analogue to ~ ax-11 but for existential quantification. (Contributed by Mario Carneiro and Jim Kingdon, 31-Dec-2017.) (Proved by Mario Carneiro, 9-Feb-2018.)
theorem ax11e {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wi (wex x3 (wa (wceq (cv x3) (cv y1)) ph)) (wex y1 ph)) $;

--| Quantifier Substitution for existential quantifiers. Analogue to ~ ax10o but for ` E. ` rather than ` A. ` . (Contributed by Jim Kingdon, 21-Dec-2017.)
theorem ax10oe {x3 y1: setvar} (ps: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi (wex x3 ps) (wex y1 ps)) $;

--| Formula-building lemma for use with the Distinctor Reduction Theorem. Part of Theorem 9.4 of [Megill] p. 448 (p. 16 of preprint). (Contributed by NM, 27-Feb-2005.) (Revised by NM, 3-Feb-2015.)
theorem drex1 {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb ph ps) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wex x3 ph) (wex y1 ps)) $;

--| Formula-building lemma for use with the Distinctor Reduction Theorem. Part of Theorem 9.4 of [Megill] p. 448 (p. 16 of preprint). (Contributed by NM, 5-Aug-1993.)
theorem drsb1 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wsb x3 z ph) (wsb y1 z ph)) $;

--| Distribution of existential quantifiers, with a bound-variable hypothesis saying that ` y ` is not free in ` ph ` , but ` x ` can be free in ` ph ` (and there is no distinct variable condition on ` x ` and ` y ` ). (Contributed by Jim Kingdon, 25-Feb-2018.)
theorem exdistrfor {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wo (wal x3 (wceq (cv x3) (cv y1))) (wal x3 (wnf y1 ph)) $ >
  $ wi (wex x3 (wex y1 (wa ph ps))) (wex x3 (wa ph (wex y1 ps))) $;

--| A version of ~ sb4 that doesn't require a distinctor antecedent. (Contributed by NM, 2-Feb-2007.)
theorem sb4a {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wsb x3 y1 (wal y1 ph)) (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) $;

--| Two ways of expressing substitution when ` y ` is not free in ` ph ` . (Contributed by NM, 25-Apr-2008.)
theorem equs45f {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wb (wex x3 (wa (wceq (cv x3) (cv y1)) ph)) (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) $;

--| Equivalence for substitution when ` y ` is not free in ` ph ` . (Contributed by NM, 5-Aug-1993.) (Revised by NM, 30-Apr-2008.)
theorem sb6f {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wb (wsb x3 y1 ph) (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) $;

--| Equivalence for substitution when ` y ` is not free in ` ph ` . (Contributed by NM, 5-Aug-1993.) (Revised by NM, 18-May-2008.)
theorem sb5f {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wb (wsb x3 y1 ph) (wex x3 (wa (wceq (cv x3) (cv y1)) ph)) $;

--| One direction of a simplified definition of substitution that unlike ~ sb4 doesn't require a distinctor antecedent. (Contributed by NM, 2-Feb-2007.)
theorem sb4e {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wsb x3 y1 ph) (wal x3 (wi (wceq (cv x3) (cv y1)) (wex y1 ph))) $;

--| Special case of a bound-variable hypothesis builder for substitution. (Contributed by NM, 2-Feb-2007.)
theorem hbsb2a {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wsb x3 y1 (wal y1 ph)) (wal x3 (wsb x3 y1 ph)) $;

--| Special case of a bound-variable hypothesis builder for substitution. (Contributed by NM, 2-Feb-2007.)
theorem hbsb2e {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wsb x3 y1 ph) (wal x3 (wsb x3 y1 (wex y1 ph))) $;

--| If ` y ` is not free in ` ph ` , ` x ` is not free in ` [ y / x ] ph ` . (Contributed by NM, 5-Aug-1993.)
theorem hbsb3 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wi (wsb x3 y1 ph) (wal x3 (wsb x3 y1 ph)) $;

--| If ` y ` is not free in ` ph ` , ` x ` is not free in ` [ y / x ] ph ` . (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfs1 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wnf x3 (wsb x3 y1 ph) $;

--| Version of ~ sbco where ` x ` is not free in ` ph ` . (Contributed by Jim Kingdon, 28-Dec-2017.)
theorem sbcof2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wb (wsb x3 y1 (wsb y1 x3 ph)) (wsb x3 y1 ph) $;

--| A version of ~ spim with a distinct variable requirement instead of a bound variable hypothesis. (Contributed by NM, 5-Aug-1993.)
theorem spimv {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wi ph ps) $ >
  $ wi (wal x3 ph) ps $;

--| A "distinctor elimination" lemma with no restrictions on variables in the consequent, proved without using ~ ax-16 . (Contributed by NM, 8-Nov-2006.) (Proof shortened by Andrew Salmon, 21-Jun-2011.)
theorem aev {x3 y1 z w v: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal z (wceq (cv w) (cv v))) $;

--| A "distinctor elimination" lemma with no restrictions on variables in the consequent, proved without using ~ ax-16 . (Contributed by NM, 8-Nov-2006.) (Proof shortened by Andrew Salmon, 21-Jun-2011.)
theorem aev_b {x3 y1: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal x3 (wceq (cv x3) (cv x3))) $;

--| A "distinctor elimination" lemma with no restrictions on variables in the consequent, proved without using ~ ax-16 . (Contributed by NM, 8-Nov-2006.) (Proof shortened by Andrew Salmon, 21-Jun-2011.)
theorem aev_b1 {x3 y1 z: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal z (wceq (cv x3) (cv z))) $;

--| A "distinctor elimination" lemma with no restrictions on variables in the consequent, proved without using ~ ax-16 . (Contributed by NM, 8-Nov-2006.) (Proof shortened by Andrew Salmon, 21-Jun-2011.)
theorem aev_b2 {x3 y1 z: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal z (wceq (cv z) (cv x3))) $;

--| Theorem showing that ~ ax-16 is redundant if ~ ax-17 is included in the axiom system. The important part of the proof is provided by ~ aev . See ~ ax16ALT for an alternate proof that does not require ~ ax-10 or ~ ax-12 . This theorem should not be referenced in any proof. Instead, use ~ ax-16 below so that theorems needing ~ ax-16 can be more easily identified. (Contributed by NM, 8-Nov-2006.)
theorem ax16 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi ph (wal x3 ph)) $;

--| Axiom of Distinct Variables. The only axiom of predicate calculus requiring that variables be distinct (if we consider ~ ax-17 to be a metatheorem and not an axiom). Axiom scheme C16' in [Megill] p. 448 (p. 16 of the preprint). It apparently does not otherwise appear in the literature but is easily proved from textbook predicate calculus by cases. It is a somewhat bizarre axiom since the antecedent is always false in set theory, but nonetheless it is technically necessary as you can see from its uses. This axiom is redundant if we include ~ ax-17 ; see theorem ~ ax16 . This axiom is obsolete and should no longer be used. It is proved above as theorem ~ ax16 . (Contributed by NM, 5-Aug-1993.) (New usage is discouraged.)
axiom ax_16 {x3: setvar} (ph: wff x3) (y1: setvar):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi ph (wal x3 ph)) $;

--| Quantifier introduction when one pair of variables is distinct. (Contributed by NM, 2-Jan-2002.)
theorem dveeq2 {x3 z: setvar} (y1: setvar):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv z) (cv y1)) (wal x3 (wceq (cv z) (cv y1)))) $;

--| Quantifier introduction when one pair of variables is distinct. Like ~ dveeq2 but connecting ` A. x x = y ` by a disjunction rather than negation and implication makes the theorem stronger in intuitionistic logic. (Contributed by Jim Kingdon, 1-Feb-2018.)
theorem dveeq2or {x3 z: setvar} (y1: setvar):
  $ wo (wal x3 (wceq (cv x3) (cv y1))) (wnf x3 (wceq (cv z) (cv y1))) $;

--| Proof of ~ dvelimf using ~ dveeq2 (shown as the last hypothesis) instead of ~ ax-12 . This shows that ~ ax-12 could be replaced by ~ dveeq2 (the last hypothesis). (Contributed by Andrew Salmon, 21-Jul-2011.)
theorem dvelimfALT2 {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi ph (wal x3 ph) $ >
  $ wi ps (wal z ps) $ >
  $ wi (wceq (cv z) (cv y1)) (wb ph ps) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv z) (cv y1)) (wal x3 (wceq (cv z) (cv y1)))) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi ps (wal x3 ps)) $;

--| A lemma for proving conditionless ZFC axioms. (Contributed by NM, 8-Jan-2002.)
theorem nd5 {x3 y1 z: setvar}:
  $ wi (wn (wal y1 (wceq (cv y1) (cv x3)))) (wi (wceq (cv z) (cv y1)) (wal x3 (wceq (cv z) (cv y1)))) $;

--| Deduction from Theorem 19.23 of [Margaris] p. 90. (Contributed by NM, 27-Apr-1994.)
theorem exlimdv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wex x3 ps) ch) $;

--| Recovery of ~ ax11o from ~ ax11v without using ~ ax-11 . The hypothesis is even weaker than ~ ax11v , with ` z ` both distinct from ` x ` _and_ not occurring in ` ph ` . Thus the hypothesis provides an alternate axiom that can be used in place of ~ ax11o . (Contributed by NM, 2-Feb-2007.)
theorem ax11v2 {x3 y1 z: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv z)) (wi ph (wal x3 (wi (wceq (cv x3) (cv z)) ph))) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) $;

--| Derive ~ ax-11o from a hypothesis in the form of ~ ax-11 . The hypothesis is even weaker than ~ ax-11 , with ` z ` both distinct from ` x ` and not occurring in ` ph ` . Thus the hypothesis provides an alternate axiom that can be used in place of ~ ax11o . (Contributed by NM, 2-Feb-2007.)
theorem ax11a2 {x3 y1 z: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv z)) (wi (wal z ph) (wal x3 (wi (wceq (cv x3) (cv z)) ph))) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) $;

--| Derivation of set.mm's original ~ ax-11o from the shorter ~ ax-11 that has replaced it. An open problem is whether this theorem can be proved without relying on ~ ax-16 or ~ ax-17 . Normally, ~ ax11o should be used rather than ~ ax-11o , except by theorems specifically studying the latter's properties. (Contributed by NM, 3-Feb-2007.)
theorem ax11o {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) $;

--| Axiom ~ ax-11o ("o" for "old") was the original version of ~ ax-11 , before it was discovered (in Jan. 2007) that the shorter ~ ax-11 could replace it. It appears as Axiom scheme C15' in [Megill] p. 448 (p. 16 of the preprint). It is based on Lemma 16 of [Tarski] p. 70 and Axiom C8 of [Monk2] p. 105, from which it can be proved by cases. To understand this theorem more easily, think of " ` -. A. x x = y -> ` ..." as informally meaning "if ` x ` and ` y ` are distinct variables then..." The antecedent becomes false if the same variable is substituted for ` x ` and ` y ` , ensuring the theorem is sound whenever this is the case. In some later theorems, we call an antecedent of the form ` -. A. x x = y ` a "distinctor." This axiom is redundant, as shown by theorem ~ ax11o . This axiom is obsolete and should no longer be used. It is proved above as theorem ~ ax11o . (Contributed by NM, 5-Aug-1993.) (New usage is discouraged.)
axiom ax_11o {x3: setvar} (ph: wff x3) (y1: setvar):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) $;

--| Formula-building rule for universal quantifier (deduction rule). (Contributed by NM, 5-Aug-1993.)
theorem albidv {x3: setvar} (ph: wff) (ps ch: wff x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wal x3 ps) (wal x3 ch)) $;

--| Formula-building rule for existential quantifier (deduction rule). (Contributed by NM, 5-Aug-1993.)
theorem exbidv {x3: setvar} (ph: wff) (ps ch: wff x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wex x3 ps) (wex x3 ch)) $;

--| A bidirectional version of ~ ax-11o . (Contributed by NM, 30-Jun-2006.)
theorem ax11b {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wa (wn (wal x3 (wceq (cv x3) (cv y1)))) (wceq (cv x3) (cv y1))) (wb ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph))) $;

--| This is a version of ~ ax-11o when the variables are distinct. Axiom (C8) of [Monk2] p. 105. (Contributed by NM, 5-Aug-1993.) (Revised by Jim Kingdon, 15-Dec-2017.)
theorem ax11v {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wi ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph))) $;

--| Analogue to ~ ax11v for existential quantification. (Contributed by Jim Kingdon, 9-Jan-2018.)
theorem ax11ev {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wi (wex x3 (wa (wceq (cv x3) (cv y1)) ph)) ph) $;

--| Lemma used in proofs of substitution properties. (Contributed by NM, 5-Aug-1993.)
theorem equs5 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wex x3 (wa (wceq (cv x3) (cv y1)) ph)) (wal x3 (wi (wceq (cv x3) (cv y1)) ph))) $;

--| Lemma used in proofs of substitution properties. Like ~ equs5 but, in intuitionistic logic, replacing negation and implication with disjunction makes this a stronger result. (Contributed by Jim Kingdon, 2-Feb-2018.)
theorem equs5or {x3 y1: setvar} (ph: wff x3 y1):
  $ wo (wal x3 (wceq (cv x3) (cv y1))) (wi (wex x3 (wa (wceq (cv x3) (cv y1)) ph)) (wal x3 (wi (wceq (cv x3) (cv y1)) ph))) $;

--| One direction of a simplified definition of substitution when variables are distinct. (Contributed by NM, 5-Aug-1993.)
theorem sb3 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wex x3 (wa (wceq (cv x3) (cv y1)) ph)) (wsb x3 y1 ph)) $;

--| One direction of a simplified definition of substitution when variables are distinct. (Contributed by NM, 5-Aug-1993.)
theorem sb4 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wsb x3 y1 ph) (wal x3 (wi (wceq (cv x3) (cv y1)) ph))) $;

--| One direction of a simplified definition of substitution when variables are distinct. Similar to ~ sb4 but stronger in intuitionistic logic. (Contributed by Jim Kingdon, 2-Feb-2018.)
theorem sb4or {x3 y1: setvar} (ph: wff x3 y1):
  $ wo (wal x3 (wceq (cv x3) (cv y1))) (wal x3 (wi (wsb x3 y1 ph) (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) $;

--| Simplified definition of substitution when variables are distinct. (Contributed by NM, 27-May-1997.)
theorem sb4b {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wb (wsb x3 y1 ph) (wal x3 (wi (wceq (cv x3) (cv y1)) ph))) $;

--| Simplified definition of substitution when variables are distinct, expressed via disjunction. (Contributed by Jim Kingdon, 18-Mar-2018.)
theorem sb4bor {x3 y1: setvar} (ph: wff x3 y1):
  $ wo (wal x3 (wceq (cv x3) (cv y1))) (wal x3 (wb (wsb x3 y1 ph) (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) $;

--| Bound-variable hypothesis builder for substitution. (Contributed by NM, 5-Aug-1993.)
theorem hbsb2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wsb x3 y1 ph) (wal x3 (wsb x3 y1 ph))) $;

--| Bound-variable hypothesis builder for substitution. Similar to ~ hbsb2 but in intuitionistic logic a disjunction is stronger than an implication. (Contributed by Jim Kingdon, 2-Feb-2018.)
theorem nfsb2or {x3 y1: setvar} (ph: wff x3 y1):
  $ wo (wal x3 (wceq (cv x3) (cv y1))) (wnf x3 (wsb x3 y1 ph)) $;

--| Propositional logic lemma used in the ~ sbequi proof. (Contributed by Jim Kingdon, 1-Feb-2018.)
theorem sbequilem (ph ps ch th ta et: wff):
  $ wo ph (wi ps (wi ch th)) $ >
  $ wo ta (wi ps (wi th et)) $ >
  $ wo ph (wo ta (wi ps (wi ch et))) $;

--| An equality theorem for substitution. (Contributed by NM, 5-Aug-1993.) (Proof modified by Jim Kingdon, 1-Feb-2018.)
theorem sbequi {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wceq (cv x3) (cv y1)) (wi (wsb z x3 ph) (wsb z y1 ph)) $;

--| An equality theorem for substitution. Used in proof of Theorem 9.7 in [Megill] p. 449 (p. 16 of the preprint). (Contributed by NM, 5-Aug-1993.)
theorem sbequ {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wceq (cv x3) (cv y1)) (wb (wsb z x3 ph) (wsb z y1 ph)) $;

--| Formula-building lemma for use with the Distinctor Reduction Theorem. Part of Theorem 9.4 of [Megill] p. 448 (p. 16 of preprint). (Contributed by NM, 27-Feb-2005.)
theorem drsb2 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wsb z x3 ph) (wsb z y1 ph)) $;

--| A specialization theorem, mostly the same as Theorem 19.8 of [Margaris] p. 89. (Contributed by NM, 5-Aug-1993.) (Proof rewritten by Jim Kingdon, 29-Dec-2017.)
theorem spsbe {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wsb x3 y1 ph) (wex x3 ph) $;

--| Specialization of implication. (Contributed by NM, 5-Aug-1993.) (Proof rewritten by Jim Kingdon, 21-Jan-2018.)
theorem spsbim {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wi ph ps)) (wi (wsb x3 y1 ph) (wsb x3 y1 ps)) $;

--| Specialization of biconditional. (Contributed by NM, 5-Aug-1993.) (Proof rewritten by Jim Kingdon, 21-Jan-2018.)
theorem spsbbi {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wb ph ps)) (wb (wsb x3 y1 ph) (wsb x3 y1 ps)) $;

--| Deduction substituting both sides of a biconditional. (Contributed by NM, 5-Aug-1993.)
theorem sbbid {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wsb x3 y1 ps) (wsb x3 y1 ch)) $;

--| Elimination of equality from antecedent after substitution. (Contributed by NM, 5-Aug-1993.) (Proof revised by Jim Kingdon, 20-Jan-2018.)
theorem sbequ8 {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wsb x3 y1 ph) (wsb x3 y1 (wi (wceq (cv x3) (cv y1)) ph)) $;

--| Substitution has no effect on a non-free variable. (Contributed by NM, 30-May-2009.) (Revised by Mario Carneiro, 12-Oct-2016.) (Proof shortened by Wolf Lammen, 3-May-2018.)
theorem sbft {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wnf x3 ph) (wb (wsb x3 y1 ph) ph) $;

--| An identity law for substitution. (Contributed by NM, 5-Aug-1993.)
theorem sbid2h {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wb (wsb x3 y1 (wsb y1 x3 ph)) ph $;

--| An identity law for substitution. (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 6-Oct-2016.)
theorem sbid2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 ph $ >
  $ wb (wsb x3 y1 (wsb y1 x3 ph)) ph $;

--| An idempotent law for substitution. (Contributed by NM, 30-Jun-1994.) (Proof rewritten by Jim Kingdon, 21-Jan-2018.)
theorem sbidm {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wsb x3 y1 (wsb x3 y1 ph)) (wsb x3 y1 ph) $;

--| Reversed substitution. (Contributed by NM, 3-Feb-2005.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem sb5rf {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wb ph (wex y1 (wa (wceq (cv y1) (cv x3)) (wsb x3 y1 ph))) $;

--| Reversed substitution. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem sb6rf {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wb ph (wal y1 (wi (wceq (cv y1) (cv x3)) (wsb x3 y1 ph))) $;

--| Substitution of variable in universal quantifier. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 25-May-2011.) (Proof shortened by Jim Kingdon, 15-Jan-2018.)
theorem sb8h {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wb (wal x3 ph) (wal y1 (wsb x3 y1 ph)) $;

--| Substitution of variable in existential quantifier. (Contributed by NM, 12-Aug-1993.) (Proof rewritten by Jim Kingdon, 15-Jan-2018.)
theorem sb8eh {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wb (wex x3 ph) (wex y1 (wsb x3 y1 ph)) $;

--| Substitution of variable in universal quantifier. (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 6-Oct-2016.) (Proof shortened by Jim Kingdon, 15-Jan-2018.)
theorem sb8 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wb (wal x3 ph) (wal y1 (wsb x3 y1 ph)) $;

--| Substitution of variable in existential quantifier. (Contributed by NM, 12-Aug-1993.) (Revised by Mario Carneiro, 6-Oct-2016.) (Proof shortened by Jim Kingdon, 15-Jan-2018.)
theorem sb8e {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wb (wex x3 ph) (wex y1 (wsb x3 y1 ph)) $;

--| Inference with ~ ax-16 as its conclusion, that doesn't require ~ ax-10 , ~ ax-11 , or ~ ax-12 for its proof. The hypotheses may be eliminable without one or more of these axioms in special cases. (Contributed by NM, 20-May-2008.)
theorem ax16i {x3 z: setvar} (ph: wff x3) (ps: wff x3 z) (y1: setvar):
  $ wi (wceq (cv x3) (cv z)) (wb ph ps) $ >
  $ wi ps (wal x3 ps) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi ph (wal x3 ph)) $;

--| Version of ~ ax16 that doesn't require ~ ax-10 or ~ ax-12 for its proof. (Contributed by NM, 17-May-2008.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax16ALT {x3: setvar} (ph: wff x3) (y1: setvar):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi ph (wal x3 ph)) $;

--| Specialization, using implicit substitition. (Contributed by NM, 30-Aug-1993.)
theorem spv {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wal x3 ph) ps $;

--| Distinct-variable version of ~ spime . (Contributed by NM, 5-Aug-1993.)
theorem spimev {x3 y1: setvar} (ph: wff y1) (ps: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wi ph ps) $ >
  $ wi ph (wex x3 ps) $;

--| Inference from existential specialization, using implicit substitition. (Contributed by NM, 19-Aug-1993.)
theorem speiv {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ ps $ >
  $ wex x3 ph $;

--| A variable introduction law for equality. Lemma 15 of [Monk2] p. 109. (Contributed by NM, 5-Aug-1993.)
theorem equvin {x3 z: setvar} (y1: setvar):
  $ wb (wceq (cv x3) (cv y1)) (wex z (wa (wceq (cv x3) (cv z)) (wceq (cv z) (cv y1)))) $;

--| A generalization of axiom ~ ax-16 . (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem a16g {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi ph (wal z ph)) $;

--| A generalization of axiom ~ ax-16 . (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem a16g_b {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi ph (wal x3 ph)) $;

--| A generalization of axiom ~ ax-16 . (Contributed by NM, 5-Aug-1993.)
theorem a16gb {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb ph (wal z ph)) $;

--| If there is only one element in the universe, then everything satisfies ` F/ ` . (Contributed by Mario Carneiro, 7-Oct-2016.)
theorem a16nf {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wnf z ph) $;

--| If there is only one element in the universe, then everything satisfies ` F/ ` . (Contributed by Mario Carneiro, 7-Oct-2016.)
theorem a16nf_b {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wnf x3 ph) $;

--| Formula-building rule for 2 existential quantifiers (deduction rule). (Contributed by NM, 4-Mar-1997.)
theorem _2albidv {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wal x3 (wal y1 ps)) (wal x3 (wal y1 ch))) $;

--| Formula-building rule for 2 existential quantifiers (deduction rule). (Contributed by NM, 1-May-1995.)
theorem _2exbidv {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wex x3 (wex y1 ps)) (wex x3 (wex y1 ch))) $;

--| Formula-building rule for 3 existential quantifiers (deduction rule). (Contributed by NM, 1-May-1995.)
theorem _3exbidv {x3 y1 z: setvar} (ph: wff) (ps ch: wff x3 y1 z):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wex x3 (wex y1 (wex z ps))) (wex x3 (wex y1 (wex z ch)))) $;

--| Formula-building rule for 4 existential quantifiers (deduction rule). (Contributed by NM, 3-Aug-1995.)
theorem _4exbidv {x3 y1 z w: setvar} (ph: wff) (ps ch: wff x3 y1 z w):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wex x3 (wex y1 (wex z (wex w ps)))) (wex x3 (wex y1 (wex z (wex w ch))))) $;

--| Special case of Theorem 19.9 of [Margaris] p. 89. (Contributed by NM, 28-May-1995.) (Revised by NM, 21-May-2007.)
theorem _19_9v {x3: setvar} (ph: wff):
  $ wb (wex x3 ph) ph $;

--| Existential elimination rule of natural deduction. (Contributed by Mario Carneiro, 9-Feb-2017.)
theorem exlimdd {x3: setvar} (ph ps ch: wff x3):
  $ wnf x3 ph $ >
  $ wnf x3 ch $ >
  $ wi ph (wex x3 ps) $ >
  $ wi (wa ph ps) ch $ >
  $ wi ph ch $;

--| Special case of Theorem 19.21 of [Margaris] p. 90. _Notational convention_: We sometimes suffix with "v" the label of a theorem eliminating a hypothesis such as ` ( ph -> A. x ph ) ` in ~ 19.21 via the use of distinct variable conditions combined with ~ ax-17 . Conversely, we sometimes suffix with "f" the label of a theorem introducing such a hypothesis to eliminate the need for the distinct variable condition; e.g. ~ euf derived from ~ df-eu . The "f" stands for "not free in" which is less restrictive than "does not occur in." (Contributed by NM, 5-Aug-1993.)
theorem _19_21v {x3: setvar} (ph: wff) (ps: wff x3):
  $ wb (wal x3 (wi ph ps)) (wi ph (wal x3 ps)) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.)
theorem alrimiv {x3: setvar} (ph: wff) (ps: wff x3):
  $ wi ph ps $ >
  $ wi ph (wal x3 ps) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Contributed by NM, 31-Jul-1995.)
theorem alrimivv {x3 y1: setvar} (ph: wff) (ps: wff x3 y1):
  $ wi ph ps $ >
  $ wi ph (wal x3 (wal y1 ps)) $;

--| Deduction from Theorem 19.21 of [Margaris] p. 90. (Contributed by NM, 10-Feb-1997.)
theorem alrimdv {x3: setvar} (ph ps: wff) (ch: wff x3):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi ps (wal x3 ch)) $;

--| Apply the definition of not-free in a context. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfdv {x3: setvar} (ph: wff) (ps: wff x3):
  $ wi ph (wi ps (wal x3 ps)) $ >
  $ wi ph (wnf x3 ps) $;

--| Quantification of two variables over a formula in which they do not occur. (Contributed by Alan Sare, 12-Apr-2011.)
theorem _2ax17 {x3 y1: setvar} (ph: wff):
  $ wi ph (wal x3 (wal y1 ph)) $;

--| Deduction from Theorem 19.20 of [Margaris] p. 90. (Contributed by NM, 3-Apr-1994.)
theorem alimdv {x3: setvar} (ph: wff) (ps ch: wff x3):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wal x3 ps) (wal x3 ch)) $;

--| Deduction from Theorem 19.22 of [Margaris] p. 90. (Contributed by NM, 27-Apr-1994.)
theorem eximdv {x3: setvar} (ph: wff) (ps ch: wff x3):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wex x3 ps) (wex x3 ch)) $;

--| Deduction from Theorem 19.22 of [Margaris] p. 90. (Contributed by NM, 27-Apr-2004.)
theorem _2alimdv {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wal x3 (wal y1 ps)) (wal x3 (wal y1 ch))) $;

--| Deduction from Theorem 19.22 of [Margaris] p. 90. (Contributed by NM, 3-Aug-1995.)
theorem _2eximdv {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wex x3 (wex y1 ps)) (wex x3 (wex y1 ch))) $;

--| Special case of Theorem 19.23 of [Margaris] p. 90. (Contributed by NM, 28-Jun-1998.)
theorem _19_23v {x3: setvar} (ph: wff x3) (ps: wff):
  $ wb (wal x3 (wi ph ps)) (wi (wex x3 ph) ps) $;

--| Theorem 19.23 of [Margaris] p. 90 extended to two variables. (Contributed by NM, 10-Aug-2004.)
theorem _19_23vv {x3 y1: setvar} (ph: wff x3 y1) (ps: wff):
  $ wb (wal x3 (wal y1 (wi ph ps))) (wi (wex x3 (wex y1 ph)) ps) $;

--| Two equivalent ways of expressing the proper substitution of ` y ` for ` x ` in ` ph ` , when ` x ` and ` y ` are distinct. Theorem 6.2 of [Quine] p. 40. The proof does not involve ~ df-sb . (Contributed by NM, 14-Apr-2008.)
theorem sb56 {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wex x3 (wa (wceq (cv x3) (cv y1)) ph)) (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) $;

--| Equivalence for substitution. Compare Theorem 6.2 of [Quine] p. 40. Also proved as Lemmas 16 and 17 of [Tarski] p. 70. (Contributed by NM, 18-Aug-1993.) (Revised by NM, 14-Apr-2008.)
theorem sb6 {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wsb x3 y1 ph) (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) $;

--| Equivalence for substitution. Similar to Theorem 6.1 of [Quine] p. 40. (Contributed by NM, 18-Aug-1993.) (Revised by NM, 14-Apr-2008.)
theorem sb5 {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wsb x3 y1 ph) (wex x3 (wa (wceq (cv x3) (cv y1)) ph)) $;

--| Version of ~ sbn where ` x ` and ` y ` are distinct. (Contributed by Jim Kingdon, 18-Dec-2017.)
theorem sbnv {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wsb x3 y1 (wn ph)) (wn (wsb x3 y1 ph)) $;

--| Version of ~ sban where ` x ` and ` y ` are distinct. (Contributed by Jim Kingdon, 24-Dec-2017.)
theorem sbanv {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb (wsb x3 y1 (wa ph ps)) (wa (wsb x3 y1 ph) (wsb x3 y1 ps)) $;

--| Version of ~ sbor where ` x ` and ` y ` are distinct. (Contributed by Jim Kingdon, 3-Feb-2018.)
theorem sborv {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb (wsb x3 y1 (wo ph ps)) (wo (wsb x3 y1 ph) (wsb x3 y1 ps)) $;

--| Forward direction of ~ sbimv . (Contributed by Jim Kingdon, 25-Dec-2017.)
theorem sbi1v {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wsb x3 y1 (wi ph ps)) (wi (wsb x3 y1 ph) (wsb x3 y1 ps)) $;

--| Reverse direction of ~ sbimv . (Contributed by Jim Kingdon, 18-Jan-2018.)
theorem sbi2v {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wi (wsb x3 y1 ph) (wsb x3 y1 ps)) (wsb x3 y1 (wi ph ps)) $;

--| Intuitionistic proof of ~ sbim where ` x ` and ` y ` are distinct. (Contributed by Jim Kingdon, 18-Jan-2018.)
theorem sbimv {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb (wsb x3 y1 (wi ph ps)) (wi (wsb x3 y1 ph) (wsb x3 y1 ps)) $;

--| Version of ~ sblim where ` x ` and ` y ` are distinct. (Contributed by Jim Kingdon, 19-Jan-2018.)
theorem sblimv {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ps (wal x3 ps) $ >
  $ wb (wsb x3 y1 (wi ph ps)) (wi (wsb x3 y1 ph) ps) $;

--| Theorem *11.53 in [WhiteheadRussell] p. 164. (Contributed by Andrew Salmon, 24-May-2011.)
theorem pm11_53 {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wb (wal x3 (wal y1 (wi ph ps))) (wi (wex x3 ph) (wal y1 ps)) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90. (Contributed by NM, 1-Aug-1995.)
theorem exlimivv {x3 y1: setvar} (ph: wff x3 y1) (ps: wff):
  $ wi ph ps $ >
  $ wi (wex x3 (wex y1 ph)) ps $;

--| Deduction from Theorem 19.23 of [Margaris] p. 90. (Contributed by NM, 31-Jul-1995.)
theorem exlimdvv {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wex x3 (wex y1 ps)) ch) $;

--| Existential elimination rule of natural deduction. (Contributed by Mario Carneiro, 15-Jun-2016.)
theorem exlimddv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff):
  $ wi ph (wex x3 ps) $ >
  $ wi (wa ph ps) ch $ >
  $ wi ph ch $;

--| Theorem 19.27 of [Margaris] p. 90. (Contributed by NM, 3-Jun-2004.)
theorem _19_27v {x3: setvar} (ph: wff x3) (ps: wff):
  $ wb (wal x3 (wa ph ps)) (wa (wal x3 ph) ps) $;

--| Theorem 19.28 of [Margaris] p. 90. (Contributed by NM, 25-Mar-2004.)
theorem _19_28v {x3: setvar} (ph: wff) (ps: wff x3):
  $ wb (wal x3 (wa ph ps)) (wa ph (wal x3 ps)) $;

--| Inference from Theorem 19.36 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.)
theorem _19_36aiv {x3: setvar} (ph: wff x3) (ps: wff):
  $ wex x3 (wi ph ps) $ >
  $ wi (wal x3 ph) ps $;

--| Special case of Theorem 19.41 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.)
theorem _19_41v {x3: setvar} (ph: wff x3) (ps: wff):
  $ wb (wex x3 (wa ph ps)) (wa (wex x3 ph) ps) $;

--| Theorem 19.41 of [Margaris] p. 90 with 2 quantifiers. (Contributed by NM, 30-Apr-1995.)
theorem _19_41vv {x3 y1: setvar} (ph: wff x3 y1) (ps: wff):
  $ wb (wex x3 (wex y1 (wa ph ps))) (wa (wex x3 (wex y1 ph)) ps) $;

--| Theorem 19.41 of [Margaris] p. 90 with 3 quantifiers. (Contributed by NM, 30-Apr-1995.)
theorem _19_41vvv {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff):
  $ wb (wex x3 (wex y1 (wex z (wa ph ps)))) (wa (wex x3 (wex y1 (wex z ph))) ps) $;

--| Theorem 19.41 of [Margaris] p. 90 with 4 quantifiers. (Contributed by FL, 14-Jul-2007.)
theorem _19_41vvvv {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (ps: wff):
  $ wb (wex w (wex x3 (wex y1 (wex z (wa ph ps))))) (wa (wex w (wex x3 (wex y1 (wex z ph)))) ps) $;

--| Special case of Theorem 19.42 of [Margaris] p. 90. (Contributed by NM, 5-Aug-1993.)
theorem _19_42v {x3: setvar} (ph: wff) (ps: wff x3):
  $ wb (wex x3 (wa ph ps)) (wa ph (wex x3 ps)) $;

--| Distribution of existential quantifiers. (Contributed by NM, 9-Mar-1995.)
theorem exdistr {x3 y1: setvar} (ph: wff x3) (ps: wff x3 y1):
  $ wb (wex x3 (wex y1 (wa ph ps))) (wex x3 (wa ph (wex y1 ps))) $;

--| Theorem 19.42 of [Margaris] p. 90 with 2 quantifiers. (Contributed by NM, 16-Mar-1995.)
theorem _19_42vv {x3 y1: setvar} (ph: wff) (ps: wff x3 y1):
  $ wb (wex x3 (wex y1 (wa ph ps))) (wa ph (wex x3 (wex y1 ps))) $;

--| Theorem 19.42 of [Margaris] p. 90 with 3 quantifiers. (Contributed by NM, 21-Sep-2011.)
theorem _19_42vvv {x3 y1 z: setvar} (ph: wff) (ps: wff x3 y1 z):
  $ wb (wex x3 (wex y1 (wex z (wa ph ps)))) (wa ph (wex x3 (wex y1 (wex z ps)))) $;

--| Theorem 19.42 of [Margaris] p. 90 with 4 quantifiers. (Contributed by Jim Kingdon, 23-Nov-2019.)
theorem _19_42vvvv {x3 y1 z w: setvar} (ph: wff) (ps: wff x3 y1 z w):
  $ wb (wex w (wex x3 (wex y1 (wex z (wa ph ps))))) (wa ph (wex w (wex x3 (wex y1 (wex z ps))))) $;

--| Distribution of existential quantifiers. (Contributed by NM, 17-Mar-1995.)
theorem exdistr2 {x3 y1 z: setvar} (ph: wff x3) (ps: wff x3 y1 z):
  $ wb (wex x3 (wex y1 (wex z (wa ph ps)))) (wex x3 (wa ph (wex y1 (wex z ps)))) $;

--| Distribution of existential quantifiers. (Contributed by NM, 9-Mar-1995.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem _3exdistr {x3 y1 z: setvar} (ph: wff x3) (ps: wff x3 y1) (ch: wff x3 y1 z):
  $ wb (wex x3 (wex y1 (wex z (w3a ph ps ch)))) (wex x3 (wa ph (wex y1 (wa ps (wex z ch))))) $;

--| Distribution of existential quantifiers. (Contributed by NM, 9-Mar-1995.)
theorem _4exdistr {x3 y1 z w: setvar} (ph: wff x3) (ps: wff x3 y1) (ch: wff x3 y1 z) (th: wff x3 y1 z w):
  $ wb (wex x3 (wex y1 (wex z (wex w (wa (wa ph ps) (wa ch th)))))) (wex x3 (wa ph (wex y1 (wa ps (wex z (wa ch (wex w th))))))) $;

--| Rule used to change bound variables, using implicit substitition. (Contributed by NM, 5-Aug-1993.)
theorem cbvalv {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wal x3 ph) (wal y1 ps) $;

--| Rule used to change bound variables, using implicit substitition. (Contributed by NM, 5-Aug-1993.)
theorem cbvexv {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wex x3 ph) (wex y1 ps) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by NM, 22-Dec-2003.) (Revised by Mario Carneiro, 6-Oct-2016.) (Proof shortened by Wolf Lammen, 22-Apr-2018.)
theorem cbval2 {x3 y1 z w: setvar} (ph ps: wff x3 y1 z w):
  $ wnf z ph $ >
  $ wnf w ph $ >
  $ wnf x3 ps $ >
  $ wnf y1 ps $ >
  $ wi (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) (wb ph ps) $ >
  $ wb (wal x3 (wal y1 ph)) (wal z (wal w ps)) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by NM, 14-Sep-2003.) (Revised by Mario Carneiro, 6-Oct-2016.)
theorem cbvex2 {x3 y1 z w: setvar} (ph ps: wff x3 y1 z w):
  $ wnf z ph $ >
  $ wnf w ph $ >
  $ wnf x3 ps $ >
  $ wnf y1 ps $ >
  $ wi (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) (wb ph ps) $ >
  $ wb (wex x3 (wex y1 ph)) (wex z (wex w ps)) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by NM, 4-Feb-2005.)
theorem cbval2v {x3 y1 z w: setvar} (ph: wff x3 y1) (ps: wff z w):
  $ wi (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) (wb ph ps) $ >
  $ wb (wal x3 (wal y1 ph)) (wal z (wal w ps)) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by NM, 26-Jul-1995.)
theorem cbvex2v {x3 y1 z w: setvar} (ph: wff x3 y1) (ps: wff z w):
  $ wi (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) (wb ph ps) $ >
  $ wb (wex x3 (wex y1 ph)) (wex z (wex w ps)) $;

--| Deduction used to change bound variables, using implicit substitution, particularly useful in conjunction with ~ dvelim . (Contributed by NM, 2-Jan-2002.) (Revised by Mario Carneiro, 6-Oct-2016.) (Revised by Wolf Lammen, 13-May-2018.)
theorem cbvald {x3 y1: setvar} (ph: wff y1) (ps: wff x3 y1) (ch: wff y1):
  $ wnf y1 ph $ >
  $ wi ph (wnf y1 ps) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi ph (wb (wal x3 ps) (wal y1 ch)) $;

--| Deduction used to change bound variables, using implicit substitition, particularly useful in conjunction with ~ dvelim . (Contributed by NM, 2-Jan-2002.) (Proof rewritten by Jim Kingdon, 30-Dec-2017.)
theorem cbvexdh {x3 y1: setvar} (ph: wff y1) (ps: wff x3 y1) (ch: wff y1):
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wi ps (wal y1 ps)) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi ph (wb (wex x3 ps) (wex y1 ch)) $;

--| Deduction used to change bound variables, using implicit substitution, particularly useful in conjunction with ~ dvelim . (Contributed by NM, 2-Jan-2002.) (Revised by Mario Carneiro, 6-Oct-2016.) (Proof rewritten by Jim Kingdon, 10-Jun-2018.)
theorem cbvexd {x3 y1: setvar} (ph: wff y1) (ps: wff x3 y1) (ch: wff y1):
  $ wnf y1 ph $ >
  $ wi ph (wnf y1 ps) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi ph (wb (wex x3 ps) (wex y1 ch)) $;

--| Rule used to change the bound variable in a universal quantifier with implicit substitution. Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem cbvaldva {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1):
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wb (wal x3 ps) (wal y1 ch)) $;

--| Rule used to change the bound variable in an existential quantifier with implicit substitution. Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem cbvexdva {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1):
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wb (wex x3 ps) (wex y1 ch)) $;

--| Rule used to change bound variables, using implicit substitition. (Contributed by NM, 26-Jul-1995.)
theorem cbvex4v {x3 y1 z w v u f1 g: setvar} (ph: wff x3 y1 z w f1 g) (ps: wff z w v u) (ch: wff x3 y1 v u f1 g):
  $ wi (wa (wceq (cv x3) (cv v)) (wceq (cv y1) (cv u))) (wb ph ps) $ >
  $ wi (wa (wceq (cv z) (cv f1)) (wceq (cv w) (cv g))) (wb ps ch) $ >
  $ wb (wex x3 (wex y1 (wex z (wex w ph)))) (wex v (wex u (wex f1 (wex g ch)))) $;

--| Rearrange existential quantifiers. (Contributed by NM, 27-Oct-2010.) (Revised by Mario Carneiro, 6-Oct-2016.)
theorem eean {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wb (wex x3 (wex y1 (wa ph ps))) (wa (wex x3 ph) (wex y1 ps)) $;

--| Rearrange existential quantifiers. (Contributed by NM, 26-Jul-1995.)
theorem eeanv {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wb (wex x3 (wex y1 (wa ph ps))) (wa (wex x3 ph) (wex y1 ps)) $;

--| Rearrange existential quantifiers. (Contributed by NM, 26-Jul-1995.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem eeeanv {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1) (ch: wff z):
  $ wb (wex x3 (wex y1 (wex z (w3a ph ps ch)))) (w3a (wex x3 ph) (wex y1 ps) (wex z ch)) $;

--| Rearrange existential quantifiers. (Contributed by NM, 31-Jul-1995.)
theorem ee4anv {x3 y1 z w: setvar} (ph: wff x3 y1) (ps: wff z w):
  $ wb (wex x3 (wex y1 (wex z (wex w (wa ph ps))))) (wa (wex x3 (wex y1 ph)) (wex z (wex w ps))) $;

--| Rearrange existential quantifiers. (Contributed by Jim Kingdon, 23-Nov-2019.)
theorem ee8anv {x3 y1 z w v u t s: setvar} (ph: wff x3 y1 z w) (ps: wff v u t s):
  $ wb (wex x3 (wex y1 (wex z (wex w (wex v (wex u (wex t (wex s (wa ph ps))))))))) (wa (wex x3 (wex y1 (wex z (wex w ph)))) (wex v (wex u (wex t (wex s ps))))) $;

--| Deduction for generalization rule for negated wff. (Contributed by NM, 5-Aug-1993.)
theorem nexdv {x3: setvar} (ph: wff) (ps: wff x3):
  $ wi ph (wn ps) $ >
  $ wi ph (wn (wex x3 ps)) $;

--| Implicit substitution of ` y ` for ` x ` into a theorem. (Contributed by NM, 20-Apr-1994.)
theorem chvarv {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ ph $ >
  $ ps $;

--| When the class variables of set theory are replaced with setvar variables, this theorem of predicate calculus is the result. This theorem provides part of the justification for the consistency of that definition, which "overloads" the setvar variables in ~ wel with the class variables in ~ wcel . (Contributed by NM, 28-Jan-2004.)
theorem cleljust {x3 z: setvar} (y1: setvar):
  $ wb (wcel (cv x3) (cv y1)) (wex z (wa (wceq (cv z) (cv x3)) (wcel (cv z) (cv y1)))) $;

--| ` x ` is not free in ` [ y / x ] ph ` when ` x ` and ` y ` are distinct. (Contributed by NM, 5-Aug-1993.) (Proof by Jim Kingdon, 16-Dec-2017.) (New usage is discouraged.)
theorem hbs1 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wsb x3 y1 ph) (wal x3 (wsb x3 y1 ph)) $;

--| ` x ` is not free in ` [ y / x ] ph ` when ` x ` and ` y ` are distinct. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfs1v {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 (wsb x3 y1 ph) $;

--| Two ways of expressing " ` x ` is (effectively) not free in ` ph ` ." (Contributed by NM, 29-May-2009.)
theorem sbhb {x3 y1: setvar} (ph: wff x3):
  $ wb (wi ph (wal x3 ph)) (wal y1 (wi ph (wsb x3 y1 ph))) $;

--| This is a version of ~ hbsb with an extra distinct variable constraint, on ` z ` and ` x ` . (Contributed by Jim Kingdon, 25-Dec-2017.)
theorem hbsbv {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi ph (wal z ph) $ >
  $ wi (wsb x3 y1 ph) (wal z (wsb x3 y1 ph)) $;

--| Similar to ~ hbsb but with an extra distinct variable constraint, on ` x ` and ` y ` . (Contributed by Jim Kingdon, 19-Mar-2018.)
theorem nfsbxy {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wnf z ph $ >
  $ wnf z (wsb x3 y1 ph) $;

--| Closed form of ~ nfsbxy . (Contributed by Jim Kingdon, 9-May-2018.)
theorem nfsbxyt {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wal x3 (wnf z ph)) (wnf z (wsb x3 y1 ph)) $;

--| This is a version of ~ sbco2 where ` z ` is distinct from ` x ` and from ` y ` . It is a lemma on the way to proving ~ sbco2v which only requires that ` z ` and ` x ` be distinct. (Contributed by Jim Kingdon, 25-Dec-2017.) (One distinct variable constraint removed by Jim Kingdon, 3-Feb-2018.)
theorem sbco2vlem {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi ph (wal z ph) $ >
  $ wb (wsb z y1 (wsb x3 z ph)) (wsb x3 y1 ph) $;

--| This is a version of ~ sbco2 where ` z ` is distinct from ` x ` . (Contributed by Jim Kingdon, 12-Feb-2018.)
theorem sbco2v {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi ph (wal z ph) $ >
  $ wb (wsb z y1 (wsb x3 z ph)) (wsb x3 y1 ph) $;

--| If ` z ` is not free in ` ph ` , it is not free in ` [ y / x ] ph ` when ` y ` and ` z ` are distinct. (Contributed by Mario Carneiro, 11-Aug-2016.) (Proof rewritten by Jim Kingdon, 19-Mar-2018.)
theorem nfsb {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wnf z ph $ >
  $ wnf z (wsb x3 y1 ph) $;

--| If ` z ` is not free in ` ph ` , it is not free in ` [ y / x ] ph ` when ` y ` and ` z ` are distinct. (Contributed by NM, 12-Aug-1993.) (Proof rewritten by Jim Kingdon, 22-Mar-2018.)
theorem hbsb {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi ph (wal z ph) $ >
  $ wi (wsb x3 y1 ph) (wal z (wsb x3 y1 ph)) $;

--| Lemma for ~ equsb3 . (Contributed by NM, 4-Dec-2005.) (Proof shortened by Andrew Salmon, 14-Jun-2011.)
theorem equsb3lem {x3 y1: setvar} (z: setvar):
  $ wb (wsb y1 x3 (wceq (cv y1) (cv z))) (wceq (cv x3) (cv z)) $;

--| Substitution applied to an atomic wff. (Contributed by Raph Levien and FL, 4-Dec-2005.)
theorem equsb3 {x3 y1: setvar} (z: setvar):
  $ wb (wsb y1 x3 (wceq (cv y1) (cv z))) (wceq (cv x3) (cv z)) $;

--| Negation inside and outside of substitution are equivalent. (Contributed by NM, 5-Aug-1993.) (Proof rewritten by Jim Kingdon, 3-Feb-2018.)
theorem sbn {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wsb x3 y1 (wn ph)) (wn (wsb x3 y1 ph)) $;

--| Implication inside and outside of substitution are equivalent. (Contributed by NM, 5-Aug-1993.) (Proof rewritten by Jim Kingdon, 3-Feb-2018.)
theorem sbim {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb (wsb x3 y1 (wi ph ps)) (wi (wsb x3 y1 ph) (wsb x3 y1 ps)) $;

--| Logical OR inside and outside of substitution are equivalent. (Contributed by NM, 29-Sep-2002.) (Proof rewritten by Jim Kingdon, 3-Feb-2018.)
theorem sbor {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb (wsb x3 y1 (wo ph ps)) (wo (wsb x3 y1 ph) (wsb x3 y1 ps)) $;

--| Conjunction inside and outside of a substitution are equivalent. (Contributed by NM, 5-Aug-1993.) (Proof rewritten by Jim Kingdon, 3-Feb-2018.)
theorem sban {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb (wsb x3 y1 (wa ph ps)) (wa (wsb x3 y1 ph) (wsb x3 y1 ps)) $;

--| Substitution with a variable not free in antecedent affects only the consequent. (Contributed by NM, 5-Aug-1993.)
theorem sbrim {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wb (wsb x3 y1 (wi ph ps)) (wi ph (wsb x3 y1 ps)) $;

--| Substitution with a variable not free in consequent affects only the antecedent. (Contributed by NM, 14-Nov-2013.) (Revised by Mario Carneiro, 4-Oct-2016.)
theorem sblim {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf x3 ps $ >
  $ wb (wsb x3 y1 (wi ph ps)) (wi (wsb x3 y1 ph) ps) $;

--| Conjunction inside and outside of a substitution are equivalent. (Contributed by NM, 14-Dec-2006.)
theorem sb3an {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wb (wsb x3 y1 (w3a ph ps ch)) (w3a (wsb x3 y1 ph) (wsb x3 y1 ps) (wsb x3 y1 ch)) $;

--| Equivalence inside and outside of a substitution are equivalent. (Contributed by NM, 5-Aug-1993.)
theorem sbbi {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb (wsb x3 y1 (wb ph ps)) (wb (wsb x3 y1 ph) (wsb x3 y1 ps)) $;

--| Introduce left biconditional inside of a substitution. (Contributed by NM, 19-Aug-1993.)
theorem sblbis {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wb (wsb x3 y1 ph) ps $ >
  $ wb (wsb x3 y1 (wb ch ph)) (wb (wsb x3 y1 ch) ps) $;

--| Introduce right biconditional inside of a substitution. (Contributed by NM, 18-Aug-1993.)
theorem sbrbis {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wb (wsb x3 y1 ph) ps $ >
  $ wb (wsb x3 y1 (wb ph ch)) (wb ps (wsb x3 y1 ch)) $;

--| Introduce right biconditional inside of a substitution. (Contributed by NM, 18-Aug-1993.)
theorem sbrbif {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi ch (wal x3 ch) $ >
  $ wb (wsb x3 y1 ph) ps $ >
  $ wb (wsb x3 y1 (wb ph ch)) (wb ps ch) $;

--| This is a version of ~ sbco2 where ` z ` is distinct from ` y ` . It is a lemma on the way to proving ~ sbco2 which has no distinct variable constraints. (Contributed by Jim Kingdon, 19-Mar-2018.)
theorem sbco2yz {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wnf z ph $ >
  $ wb (wsb z y1 (wsb x3 z ph)) (wsb x3 y1 ph) $;

--| A composition law for substitution. (Contributed by NM, 30-Jun-1994.) (Proof rewritten by Jim Kingdon, 19-Mar-2018.)
theorem sbco2h {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi ph (wal z ph) $ >
  $ wb (wsb z y1 (wsb x3 z ph)) (wsb x3 y1 ph) $;

--| A composition law for substitution. (Contributed by NM, 30-Jun-1994.) (Revised by Mario Carneiro, 6-Oct-2016.)
theorem sbco2 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wnf z ph $ >
  $ wb (wsb z y1 (wsb x3 z ph)) (wsb x3 y1 ph) $;

--| A composition law for substitution. (Contributed by NM, 5-Aug-1993.)
theorem sbco2d {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal z ph) $ >
  $ wi ph (wi ps (wal z ps)) $ >
  $ wi ph (wb (wsb z y1 (wsb x3 z ps)) (wsb x3 y1 ps)) $;

--| Version of ~ sbco2d with a distinct variable constraint between ` x ` and ` z ` . (Contributed by Jim Kingdon, 19-Feb-2018.)
theorem sbco2vd {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal z ph) $ >
  $ wi ph (wi ps (wal z ps)) $ >
  $ wi ph (wb (wsb z y1 (wsb x3 z ps)) (wsb x3 y1 ps)) $;

--| A composition law for substitution. (Contributed by NM, 5-Aug-1993.)
theorem sbco {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wsb x3 y1 (wsb y1 x3 ph)) (wsb x3 y1 ph) $;

--| Version of ~ sbco3 with a distinct variable constraint between ` x ` and ` y ` . (Contributed by Jim Kingdon, 19-Feb-2018.)
theorem sbco3v {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wb (wsb y1 z (wsb x3 y1 ph)) (wsb x3 z (wsb y1 x3 ph)) $;

--| Relationship between composition and commutativity for substitution. (Contributed by Jim Kingdon, 28-Feb-2018.)
theorem sbcocom {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wb (wsb y1 z (wsb x3 y1 ph)) (wsb y1 z (wsb x3 z ph)) $;

--| Version of ~ sbcom with a distinct variable constraint between ` x ` and ` z ` . (Contributed by Jim Kingdon, 28-Feb-2018.)
theorem sbcomv {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wb (wsb z y1 (wsb x3 y1 ph)) (wsb x3 y1 (wsb z y1 ph)) $;

--| Version of ~ sbcom with distinct variable constraints between ` x ` and ` y ` , and ` y ` and ` z ` . (Contributed by Jim Kingdon, 21-Mar-2018.)
theorem sbcomxyyz {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wb (wsb z y1 (wsb x3 y1 ph)) (wsb x3 y1 (wsb z y1 ph)) $;

--| Version of ~ sbco3 with distinct variable constraints between ` x ` and ` z ` , and ` y ` and ` z ` . Lemma for proving ~ sbco3 . (Contributed by Jim Kingdon, 22-Mar-2018.)
theorem sbco3xzyz {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wb (wsb y1 z (wsb x3 y1 ph)) (wsb x3 z (wsb y1 x3 ph)) $;

--| A composition law for substitution. (Contributed by NM, 5-Aug-1993.) (Proof rewritten by Jim Kingdon, 22-Mar-2018.)
theorem sbco3 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wb (wsb y1 z (wsb x3 y1 ph)) (wsb x3 z (wsb y1 x3 ph)) $;

--| A commutativity law for substitution. (Contributed by NM, 27-May-1997.) (Proof rewritten by Jim Kingdon, 22-Mar-2018.)
theorem sbcom {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wb (wsb z y1 (wsb x3 y1 ph)) (wsb x3 y1 (wsb z y1 ph)) $;

--| Closed form of ~ nfsb . (Contributed by Jim Kingdon, 9-May-2018.)
theorem nfsbt {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wal x3 (wnf z ph)) (wnf z (wsb x3 y1 ph)) $;

--| Deduction version of ~ nfsb . (Contributed by NM, 15-Feb-2013.)
theorem nfsbd {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wnf x3 ph $ >
  $ wi ph (wnf z ps) $ >
  $ wi ph (wnf z (wsb x3 y1 ps)) $;

--| Substitution applied to an atomic membership wff. (Contributed by NM, 7-Nov-2006.) (Proof shortened by Andrew Salmon, 14-Jun-2011.)
theorem elsb3 {x3 y1: setvar} (z: setvar):
  $ wb (wsb y1 x3 (wcel (cv y1) (cv z))) (wcel (cv x3) (cv z)) $;

--| Substitution applied to an atomic membership wff. (Contributed by Rodolfo Medina, 3-Apr-2010.) (Proof shortened by Andrew Salmon, 14-Jun-2011.)
theorem elsb4 {x3 y1: setvar} (z: setvar):
  $ wb (wsb y1 x3 (wcel (cv z) (cv y1))) (wcel (cv z) (cv x3)) $;

--| Like ~ sb9 but with a distinct variable constraint between ` x ` and ` y ` . (Contributed by Jim Kingdon, 28-Feb-2018.)
theorem sb9v {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wal x3 (wsb y1 x3 ph)) (wal y1 (wsb x3 y1 ph)) $;

--| Commutation of quantification and substitution variables. (Contributed by NM, 5-Aug-1993.) (Proof rewritten by Jim Kingdon, 23-Mar-2018.)
theorem sb9 {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wal x3 (wsb y1 x3 ph)) (wal y1 (wsb x3 y1 ph)) $;

--| Commutation of quantification and substitution variables. (Contributed by NM, 5-Aug-1993.) (Proof rewritten by Jim Kingdon, 23-Mar-2018.)
theorem sb9i {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wsb y1 x3 ph)) (wal y1 (wsb x3 y1 ph)) $;

--| Two ways of expressing " ` x ` is (effectively) not free in ` ph ` ." (Contributed by G&eacute;rard Lang, 14-Nov-2013.) (Revised by Mario Carneiro, 6-Oct-2016.)
theorem sbnf2 {x3 y1 z: setvar} (ph: wff x3):
  $ wb (wnf x3 ph) (wal y1 (wal z (wb (wsb x3 y1 ph) (wsb x3 z ph)))) $;

--| Deduction version of ~ hbsb . (Contributed by NM, 15-Feb-2013.) (Proof rewritten by Jim Kingdon, 23-Mar-2018.)
theorem hbsbd {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal z ph) $ >
  $ wi ph (wi ps (wal z ps)) $ >
  $ wi ph (wi (wsb x3 y1 ps) (wal z (wsb x3 y1 ps))) $;

--| Equivalence for double substitution. (Contributed by NM, 3-Feb-2005.)
theorem _2sb5 {x3 y1 z w: setvar} (ph: wff x3 y1 z w):
  $ wb (wsb x3 z (wsb y1 w ph)) (wex x3 (wex y1 (wa (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) ph))) $;

--| Equivalence for double substitution. (Contributed by NM, 3-Feb-2005.)
theorem _2sb6 {x3 y1 z w: setvar} (ph: wff x3 y1 z w):
  $ wb (wsb x3 z (wsb y1 w ph)) (wal x3 (wal y1 (wi (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) ph))) $;

--| Lemma for proving ~ sbcom2 . It is the same as ~ sbcom2 but with additional distinct variable constraints on ` x ` and ` y ` , and on ` w ` and ` z ` . (Contributed by Jim Kingdon, 19-Feb-2018.)
theorem sbcom2v {x3 y1 z w: setvar} (ph: wff x3 y1 z w):
  $ wb (wsb z w (wsb x3 y1 ph)) (wsb x3 y1 (wsb z w ph)) $;

--| Lemma for proving ~ sbcom2 . It is the same as ~ sbcom2v but removes the distinct variable constraint on ` x ` and ` y ` . (Contributed by Jim Kingdon, 19-Feb-2018.)
theorem sbcom2v2 {x3 y1 z w: setvar} (ph: wff x3 y1 z w):
  $ wb (wsb z w (wsb x3 y1 ph)) (wsb x3 y1 (wsb z w ph)) $;

--| Commutativity law for substitution. Used in proof of Theorem 9.7 of [Megill] p. 449 (p. 16 of the preprint). (Contributed by NM, 27-May-1997.) (Proof modified to be intuitionistic by Jim Kingdon, 19-Feb-2018.)
theorem sbcom2 {x3 y1 z w: setvar} (ph: wff x3 y1 z w):
  $ wb (wsb z w (wsb x3 y1 ph)) (wsb x3 y1 (wsb z w ph)) $;

--| Equivalence for substitution. (Contributed by NM, 5-Aug-1993.)
theorem sb6a {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wsb x3 y1 ph) (wal x3 (wi (wceq (cv x3) (cv y1)) (wsb y1 x3 ph))) $;

--| Reversed double substitution. (Contributed by NM, 3-Feb-2005.)
theorem _2sb5rf {x3 y1 z w: setvar} (ph: wff x3 y1 z w):
  $ wi ph (wal z ph) $ >
  $ wi ph (wal w ph) $ >
  $ wb ph (wex z (wex w (wa (wa (wceq (cv z) (cv x3)) (wceq (cv w) (cv y1))) (wsb x3 z (wsb y1 w ph))))) $;

--| Reversed double substitution. (Contributed by NM, 3-Feb-2005.)
theorem _2sb6rf {x3 y1 z w: setvar} (ph: wff x3 y1 z w):
  $ wi ph (wal z ph) $ >
  $ wi ph (wal w ph) $ >
  $ wb ph (wal z (wal w (wi (wa (wceq (cv z) (cv x3)) (wceq (cv w) (cv y1))) (wsb x3 z (wsb y1 w ph))))) $;

--| An alternate definition of proper substitution ~ df-sb . By introducing a dummy variable ` z ` in the definiens, we are able to eliminate any distinct variable restrictions among the variables ` x ` , ` y ` , and ` ph ` of the definiendum. No distinct variable conflicts arise because ` z ` effectively insulates ` x ` from ` y ` . To achieve this, we use a chain of two substitutions in the form of ~ sb5 , first ` z ` for ` x ` then ` y ` for ` z ` . Compare Definition 2.1'' of [Quine] p. 17. Theorem ~ sb7f provides a version where ` ph ` and ` z ` don't have to be distinct. (Contributed by NM, 28-Jan-2004.)
theorem dfsb7 {x3 y1 z: setvar} (ph: wff x3 y1):
  $ wb (wsb x3 y1 ph) (wex z (wa (wceq (cv z) (cv y1)) (wex x3 (wa (wceq (cv x3) (cv z)) ph)))) $;

--| This version of ~ dfsb7 does not require that ` ph ` and ` z ` be distinct. This permits it to be used as a definition for substitution in a formalization that omits the logically redundant axiom ~ ax-17 i.e. that doesn't have the concept of a variable not occurring in a wff. ( ~ df-sb is also suitable, but its mixing of free and bound variables is distasteful to some logicians.) (Contributed by NM, 26-Jul-2006.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem sb7f {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi ph (wal z ph) $ >
  $ wb (wsb x3 y1 ph) (wex z (wa (wceq (cv z) (cv y1)) (wex x3 (wa (wceq (cv x3) (cv z)) ph)))) $;

--| An alternative definition of proper substitution ~ df-sb . Similar to ~ dfsb7a but does not require that ` ph ` and ` z ` be distinct. Similar to ~ sb7f in that it involves a dummy variable ` z ` , but expressed in terms of ` A. ` rather than ` E. ` . (Contributed by Jim Kingdon, 5-Feb-2018.)
theorem sb7af {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wnf z ph $ >
  $ wb (wsb x3 y1 ph) (wal z (wi (wceq (cv z) (cv y1)) (wal x3 (wi (wceq (cv x3) (cv z)) ph)))) $;

--| An alternative definition of proper substitution ~ df-sb . Similar to ~ dfsb7 in that it involves a dummy variable ` z ` , but expressed in terms of ` A. ` rather than ` E. ` . For a version which only requires ` F/ z ph ` rather than ` z ` and ` ph ` being distinct, see ~ sb7af . (Contributed by Jim Kingdon, 5-Feb-2018.)
theorem dfsb7a {x3 y1 z: setvar} (ph: wff x3 y1):
  $ wb (wsb x3 y1 ph) (wal z (wi (wceq (cv z) (cv y1)) (wal x3 (wi (wceq (cv x3) (cv z)) ph)))) $;

--| Hao Wang's identity axiom P6 in Irving Copi, _Symbolic Logic_ (5th ed., 1979), p. 328. In traditional predicate calculus, this is a sole axiom for identity from which the usual ones can be derived. (Contributed by NM, 9-May-2005.)
theorem sb10f {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi ph (wal x3 ph) $ >
  $ wb (wsb z y1 ph) (wex x3 (wa (wceq (cv x3) (cv y1)) (wsb z x3 ph))) $;

--| An identity law for substitution. Used in proof of Theorem 9.7 of [Megill] p. 449 (p. 16 of the preprint). (Contributed by NM, 5-Aug-1993.)
theorem sbid2v {x3 y1: setvar} (ph: wff y1):
  $ wb (wsb x3 y1 (wsb y1 x3 ph)) ph $;

--| Elimination of substitution. (Contributed by NM, 5-Aug-1993.)
theorem sbelx {x3 y1: setvar} (ph: wff y1):
  $ wb ph (wex x3 (wa (wceq (cv x3) (cv y1)) (wsb y1 x3 ph))) $;

--| Elimination of double substitution. (Contributed by NM, 5-Aug-1993.)
theorem sbel2x {x3 y1 z w: setvar} (ph: wff z w):
  $ wb ph (wex x3 (wex y1 (wa (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) (wsb w y1 (wsb z x3 ph))))) $;

--| Move universal quantifier in and out of substitution. Identical to ~ sbal except that it has an additional distinct variable constraint on ` y ` and ` z ` . (Contributed by Jim Kingdon, 29-Dec-2017.)
theorem sbalyz {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wb (wsb y1 z (wal x3 ph)) (wal x3 (wsb y1 z ph)) $;

--| Move universal quantifier in and out of substitution. (Contributed by NM, 5-Aug-1993.) (Proof rewritten by Jim Kingdon, 12-Feb-2018.)
theorem sbal {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wb (wsb y1 z (wal x3 ph)) (wal x3 (wsb y1 z ph)) $;

--| Lemma for proving ~ sbal1 . Same as ~ sbal1 but with an additional distinct variable constraint on ` y ` and ` z ` . (Contributed by Jim Kingdon, 23-Feb-2018.)
theorem sbal1yz {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wn (wal x3 (wceq (cv x3) (cv z)))) (wb (wsb y1 z (wal x3 ph)) (wal x3 (wsb y1 z ph))) $;

--| A theorem used in elimination of disjoint variable restriction on ` x ` and ` y ` by replacing it with a distinctor ` -. A. x x = z ` . (Contributed by NM, 5-Aug-1993.) (Proof rewitten by Jim Kingdon, 24-Feb-2018.)
theorem sbal1 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wn (wal x3 (wceq (cv x3) (cv z)))) (wb (wsb y1 z (wal x3 ph)) (wal x3 (wsb y1 z ph))) $;

--| Move existential quantifier in and out of substitution. Identical to ~ sbex except that it has an additional distinct variable constraint on ` y ` and ` z ` . (Contributed by Jim Kingdon, 29-Dec-2017.)
theorem sbexyz {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wb (wsb y1 z (wex x3 ph)) (wex x3 (wsb y1 z ph)) $;

--| Move existential quantifier in and out of substitution. (Contributed by NM, 27-Sep-2003.) (Proof rewritten by Jim Kingdon, 12-Feb-2018.)
theorem sbex {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wb (wsb y1 z (wex x3 ph)) (wex x3 (wsb y1 z ph)) $;

--| Quantify with new variable inside substitution. (Contributed by NM, 18-Aug-1993.)
theorem sbalv {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wb (wsb x3 y1 ph) ps $ >
  $ wb (wsb x3 y1 (wal z ph)) (wal z ps) $;

--| Lemma for ~ sbco4 . It replaces the temporary variable ` v ` with another temporary variable ` w ` . (Contributed by Jim Kingdon, 26-Sep-2018.)
theorem sbco4lem {x3 y1 w v: setvar} (ph: wff x3 y1):
  $ wb (wsb v x3 (wsb x3 y1 (wsb y1 v ph))) (wsb w x3 (wsb x3 y1 (wsb y1 w ph))) $;

--| Two ways of exchanging two variables. Both sides of the biconditional exchange ` x ` and ` y ` , either via two temporary variables ` u ` and ` v ` , or a single temporary ` w ` . (Contributed by Jim Kingdon, 25-Sep-2018.)
theorem sbco4 {x3 y1 w v u: setvar} (ph: wff x3 y1):
  $ wb (wsb u y1 (wsb v x3 (wsb x3 u (wsb y1 v ph)))) (wsb w x3 (wsb x3 y1 (wsb y1 w ph))) $;

--| An equivalent expression for existence. (Contributed by NM, 2-Feb-2005.)
theorem exsb {x3 y1: setvar} (ph: wff x3):
  $ wb (wex x3 ph) (wex y1 (wal x3 (wi (wceq (cv x3) (cv y1)) ph))) $;

--| An equivalent expression for double existence. (Contributed by NM, 2-Feb-2005.)
theorem _2exsb {x3 y1 z w: setvar} (ph: wff x3 y1):
  $ wb (wex x3 (wex y1 ph)) (wex z (wex w (wal x3 (wal y1 (wi (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) ph))))) $;

--| Version of ~ dvelim that doesn't use ~ ax-10 . Because it has different distinct variable constraints than ~ dvelim and is used in important proofs, it would be better if it had a name which does not end in ALT (ideally more close to set.mm naming). (Contributed by NM, 17-May-2008.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dvelimALT {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi (wceq (cv z) (cv y1)) (wb ph ps) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi ps (wal x3 ps)) $;

--| Like ~ dvelimf but with a distinct variable constraint on ` x ` and ` z ` . (Contributed by Jim Kingdon, 6-Mar-2018.)
theorem dvelimfv {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi ph (wal x3 ph) $ >
  $ wi ps (wal z ps) $ >
  $ wi (wceq (cv z) (cv y1)) (wb ph ps) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi ps (wal x3 ps)) $;

--| A variable not free remains so after substitution with a distinct variable. (Contributed by NM, 5-Aug-1993.) (Proof rewritten by Jim Kingdon, 23-Mar-2018.)
theorem hbsb4 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi ph (wal z ph) $ >
  $ wi (wn (wal z (wceq (cv z) (cv y1)))) (wi (wsb x3 y1 ph) (wal z (wsb x3 y1 ph))) $;

--| A variable not free remains so after substitution with a distinct variable (closed form of ~ hbsb4 ). (Contributed by NM, 7-Apr-2004.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem hbsb4t {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wal x3 (wal z (wi ph (wal z ph)))) (wi (wn (wal z (wceq (cv z) (cv y1)))) (wi (wsb x3 y1 ph) (wal z (wsb x3 y1 ph)))) $;

--| A variable not free remains so after substitution with a distinct variable (closed form of ~ hbsb4 ). (Contributed by NM, 7-Apr-2004.) (Revised by Mario Carneiro, 4-Oct-2016.) (Proof rewritten by Jim Kingdon, 9-May-2018.)
theorem nfsb4t {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wal x3 (wnf z ph)) (wi (wn (wal z (wceq (cv z) (cv y1)))) (wnf z (wsb x3 y1 ph))) $;

--| Version of ~ dvelim without any variable restrictions. (Contributed by NM, 1-Oct-2002.)
theorem dvelimf {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi ph (wal x3 ph) $ >
  $ wi ps (wal z ps) $ >
  $ wi (wceq (cv z) (cv y1)) (wb ph ps) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi ps (wal x3 ps)) $;

--| Deduction form of ~ dvelimf . This version may be useful if we want to avoid ~ ax-17 and use ~ ax-16 instead. (Contributed by NM, 7-Apr-2004.) (Revised by Mario Carneiro, 6-Oct-2016.) (Proof shortened by Wolf Lammen, 11-May-2018.)
theorem dvelimdf {x3 y1 z: setvar} (ph ps ch: wff x3 y1 z):
  $ wnf x3 ph $ >
  $ wnf z ph $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf z ch) $ >
  $ wi ph (wi (wceq (cv z) (cv y1)) (wb ps ch)) $ >
  $ wi ph (wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wnf x3 ch)) $;

--| This theorem can be used to eliminate a distinct variable restriction on ` x ` and ` z ` and replace it with the "distinctor" ` -. A. x x = y ` as an antecedent. ` ph ` normally has ` z ` free and can be read ` ph ( z ) ` , and ` ps ` substitutes ` y ` for ` z ` and can be read ` ph ( y ) ` . We don't require that ` x ` and ` y ` be distinct: if they aren't, the distinctor will become false (in multiple-element domains of discourse) and "protect" the consequent. To obtain a closed-theorem form of this inference, prefix the hypotheses with ` A. x A. z ` , conjoin them, and apply ~ dvelimdf . Other variants of this theorem are ~ dvelimf (with no distinct variable restrictions) and ~ dvelimALT (that avoids ~ ax-10 ). (Contributed by NM, 23-Nov-1994.)
theorem dvelim {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi (wceq (cv z) (cv y1)) (wb ph ps) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi ps (wal x3 ps)) $;

--| Disjunctive distinct variable constraint elimination. A user of this theorem starts with a formula ` ph ` (containing ` z ` ) and a distinct variable constraint between ` x ` and ` z ` . The theorem makes it possible to replace the distinct variable constraint with the disjunct ` A. x x = y ` ( ` ps ` is just a version of ` ph ` with ` y ` substituted for ` z ` ). (Contributed by Jim Kingdon, 11-May-2018.)
theorem dvelimor {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff x3 y1):
  $ wnf x3 ph $ >
  $ wi (wceq (cv z) (cv y1)) (wb ph ps) $ >
  $ wo (wal x3 (wceq (cv x3) (cv y1))) (wnf x3 ps) $;

--| Quantifier introduction when one pair of variables is distinct. (Contributed by NM, 2-Jan-2002.) (Proof rewritten by Jim Kingdon, 19-Feb-2018.)
theorem dveeq1 {x3 z: setvar} (y1: setvar):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv y1) (cv z)) (wal x3 (wceq (cv y1) (cv z)))) $;

--| Quantifier introduction when one pair of variables is distinct. (Contributed by NM, 2-Jan-2002.)
theorem dveel1 {x3 y1: setvar} (z: setvar):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wcel (cv y1) (cv z)) (wal x3 (wcel (cv y1) (cv z)))) $;

--| Quantifier introduction when one pair of variables is distinct. (Contributed by NM, 2-Jan-2002.)
theorem dveel2 {x3 y1: setvar} (z: setvar):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wcel (cv z) (cv y1)) (wal x3 (wcel (cv z) (cv y1)))) $;

--| Move quantifier in and out of substitution. (Contributed by NM, 2-Jan-2002.)
theorem sbal2 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wb (wsb y1 z (wal x3 ph)) (wal x3 (wsb y1 z ph))) $;

--| A variable not free remains so after substitution with a distinct variable. (Contributed by Jim Kingdon, 11-May-2018.)
theorem nfsb4or {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wnf z ph $ >
  $ wo (wal z (wceq (cv z) (cv y1))) (wnf z (wsb x3 y1 ph)) $;

--| Extend wff definition to include existential uniqueness ("there exists a unique ` x ` such that ` ph ` ").
term weu {x3: setvar} (ph: wff x3): wff;

--| Extend wff definition to include uniqueness ("there exists at most one ` x ` such that ` ph ` ").
term wmo {x3: setvar} (ph: wff x3): wff;

--| A soundness justification theorem for ~ df-eu , showing that the definition is equivalent to itself with its dummy variable renamed. Note that ` y ` and ` z ` needn't be distinct variables. (Contributed by NM, 11-Mar-2010.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem eujust {x3 y1 z: setvar} (ph: wff x3):
  $ wb (wex y1 (wal x3 (wb ph (wceq (cv x3) (cv y1))))) (wex z (wal x3 (wb ph (wceq (cv x3) (cv z))))) $;

--| Define existential uniqueness, i.e. "there exists exactly one ` x ` such that ` ph ` ." Definition 10.1 of [BellMachover] p. 97; also Definition *14.02 of [WhiteheadRussell] p. 175. Other possible definitions are given by ~ eu1 , ~ eu2 , ~ eu3 , and ~ eu5 (which in some cases we show with a hypothesis ` ph -> A. y ph ` in place of a distinct variable condition on ` y ` and ` ph ` ). Double uniqueness is tricky: ` E! x E! y ph ` does not mean "exactly one ` x ` and one ` y ` " (see ~ 2eu4 ). (Contributed by NM, 5-Aug-1993.)
axiom df_eu {x3 y1: setvar} (ph: wff x3):
  $ wb (weu x3 ph) (wex y1 (wal x3 (wb ph (wceq (cv x3) (cv y1))))) $;

--| Define "there exists at most one ` x ` such that ` ph ` ." Here we define it in terms of existential uniqueness. Notation of [BellMachover] p. 460, whose definition we show as ~ mo3 . For another possible definition see ~ mo4 . (Contributed by NM, 5-Aug-1993.)
axiom df_mo {x3: setvar} (ph: wff x3):
  $ wb (wmo x3 ph) (wi (wex x3 ph) (weu x3 ph)) $;

--| A version of the existential uniqueness definition with a hypothesis instead of a distinct variable condition. (Contributed by NM, 12-Aug-1993.)
theorem euf {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wb (weu x3 ph) (wex y1 (wal x3 (wb ph (wceq (cv x3) (cv y1))))) $;

--| Formula-building rule for uniqueness quantifier (deduction rule). (Contributed by NM, 9-Jul-1994.)
theorem eubidh {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (weu x3 ps) (weu x3 ch)) $;

--| Formula-building rule for uniqueness quantifier (deduction rule). (Contributed by NM, 9-Jul-1994.)
theorem eubid {x3: setvar} (ph ps ch: wff x3):
  $ wnf x3 ph $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (weu x3 ps) (weu x3 ch)) $;

--| Formula-building rule for uniqueness quantifier (deduction rule). (Contributed by NM, 9-Jul-1994.)
theorem eubidv {x3: setvar} (ph: wff) (ps ch: wff x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (weu x3 ps) (weu x3 ch)) $;

--| Introduce uniqueness quantifier to both sides of an equivalence. (Contributed by NM, 9-Jul-1994.) (Revised by Mario Carneiro, 6-Oct-2016.)
theorem eubii {x3: setvar} (ph ps: wff x3):
  $ wb ph ps $ >
  $ wb (weu x3 ph) (weu x3 ps) $;

--| Bound-variable hypothesis builder for uniqueness. (Contributed by NM, 9-Jul-1994.)
theorem hbeu1 {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wal x3 (weu x3 ph)) $;

--| Bound-variable hypothesis builder for uniqueness. (Contributed by NM, 9-Jul-1994.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem nfeu1 {x3: setvar} (ph: wff x3):
  $ wnf x3 (weu x3 ph) $;

--| Bound-variable hypothesis builder for "at most one." (Contributed by NM, 8-Mar-1995.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem nfmo1 {x3: setvar} (ph: wff x3):
  $ wnf x3 (wmo x3 ph) $;

--| Variable substitution in uniqueness quantifier. (Contributed by NM, 7-Aug-1994.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem sb8eu {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wb (weu x3 ph) (weu y1 (wsb x3 y1 ph)) $;

--| Variable substitution for "at most one." (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem sb8mo {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wb (wmo x3 ph) (wmo y1 (wsb x3 y1 ph)) $;

--| Deduction version of ~ nfeu . Similar to ~ nfeud but has the additional constraint that ` x ` and ` y ` must be distinct. (Contributed by Jim Kingdon, 25-May-2018.)
theorem nfeudv {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (weu y1 ps)) $;

--| Deduction version of ~ nfeu . (Contributed by NM, 15-Feb-2013.) (Revised by Mario Carneiro, 7-Oct-2016.) (Proof rewritten by Jim Kingdon, 25-May-2018.)
theorem nfeud {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (weu y1 ps)) $;

--| Bound-variable hypothesis builder for "at most one." (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem nfmod {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wmo y1 ps)) $;

--| Bound-variable hypothesis builder for existential uniqueness. This is similar to ~ nfeu but has the additional constraint that ` x ` and ` y ` must be distinct. (Contributed by Jim Kingdon, 23-May-2018.)
theorem nfeuv {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf x3 (weu y1 ph) $;

--| Bound-variable hypothesis builder for existential uniqueness. Note that ` x ` and ` y ` needn't be distinct. (Contributed by NM, 8-Mar-1995.) (Revised by Mario Carneiro, 7-Oct-2016.) (Proof rewritten by Jim Kingdon, 23-May-2018.)
theorem nfeu {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf x3 (weu y1 ph) $;

--| Bound-variable hypothesis builder for "at most one." (Contributed by NM, 9-Mar-1995.)
theorem nfmo {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf x3 (wmo y1 ph) $;

--| Bound-variable hypothesis builder for uniqueness. Note that ` x ` and ` y ` needn't be distinct. (Contributed by NM, 8-Mar-1995.) (Proof rewritten by Jim Kingdon, 24-May-2018.)
theorem hbeu {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi (weu y1 ph) (wal x3 (weu y1 ph)) $;

--| Deduction version of ~ hbeu . (Contributed by NM, 15-Feb-2013.) (Proof rewritten by Jim Kingdon, 25-May-2018.)
theorem hbeud {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wi ps (wal x3 ps)) $ >
  $ wi ph (wi (weu y1 ps) (wal x3 (weu y1 ps))) $;

--| Variable substitution in uniqueness quantifier. (Contributed by NM, 7-Aug-1994.) (Revised by Andrew Salmon, 9-Jul-2011.)
theorem sb8euh {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wb (weu x3 ph) (weu y1 (wsb x3 y1 ph)) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by NM, 25-Nov-1994.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem cbveu {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (weu x3 ph) (weu y1 ps) $;

--| An alternate way to express uniqueness used by some authors. Exercise 2(b) of [Margaris] p. 110. (Contributed by NM, 20-Aug-1993.)
theorem eu1 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wb (weu x3 ph) (wex x3 (wa ph (wal y1 (wi (wsb x3 y1 ph) (wceq (cv x3) (cv y1)))))) $;

--| Introduce a disjunct into a uniqueness quantifier. (Contributed by NM, 21-Oct-2005.)
theorem euor {x3: setvar} (ph ps: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi (wa (wn ph) (weu x3 ps)) (weu x3 (wo ph ps)) $;

--| Introduce a disjunct into a uniqueness quantifier. (Contributed by NM, 23-Mar-1995.)
theorem euorv {x3: setvar} (ph: wff) (ps: wff x3):
  $ wi (wa (wn ph) (weu x3 ps)) (weu x3 (wo ph ps)) $;

--| There is at most one of something which does not exist. (Contributed by Jim Kingdon, 2-Jul-2018.)
theorem mo2n {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi (wn (wex x3 ph)) (wex y1 (wal x3 (wi ph (wceq (cv x3) (cv y1))))) $;

--| There is at most one of something which does not exist. (Contributed by Jim Kingdon, 5-Jul-2018.)
theorem mon {x3: setvar} (ph: wff x3):
  $ wi (wn (wex x3 ph)) (wmo x3 ph) $;

--| Existential uniqueness implies existence. (Contributed by NM, 15-Sep-1993.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem euex {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wex x3 ph) $;

--| Existential uniqueness implies "at most one." (Contributed by NM, 8-Jul-1994.)
theorem eumo0 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wi (weu x3 ph) (wex y1 (wal x3 (wi ph (wceq (cv x3) (cv y1))))) $;

--| Existential uniqueness implies "at most one." (Contributed by NM, 23-Mar-1995.) (Proof rewritten by Jim Kingdon, 27-May-2018.)
theorem eumo {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wmo x3 ph) $;

--| "At most one" inferred from existential uniqueness. (Contributed by NM, 5-Apr-1995.)
theorem eumoi {x3: setvar} (ph: wff x3):
  $ weu x3 ph $ >
  $ wmo x3 ph $;

--| Formula-building rule for "at most one" quantifier (deduction rule). (Contributed by NM, 8-Mar-1995.)
theorem mobidh {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wmo x3 ps) (wmo x3 ch)) $;

--| Formula-building rule for "at most one" quantifier (deduction rule). (Contributed by NM, 8-Mar-1995.)
theorem mobid {x3: setvar} (ph ps ch: wff x3):
  $ wnf x3 ph $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wmo x3 ps) (wmo x3 ch)) $;

--| Formula-building rule for "at most one" quantifier (deduction rule). (Contributed by Mario Carneiro, 7-Oct-2016.)
theorem mobidv {x3: setvar} (ph: wff) (ps ch: wff x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wmo x3 ps) (wmo x3 ch)) $;

--| Formula-building rule for "at most one" quantifier (inference rule). (Contributed by NM, 9-Mar-1995.) (Revised by Mario Carneiro, 17-Oct-2016.)
theorem mobii {x3: setvar} (ps ch: wff x3):
  $ wb ps ch $ >
  $ wb (wmo x3 ps) (wmo x3 ch) $;

--| Bound-variable hypothesis builder for "at most one." (Contributed by NM, 8-Mar-1995.)
theorem hbmo1 {x3: setvar} (ph: wff x3):
  $ wi (wmo x3 ph) (wal x3 (wmo x3 ph)) $;

--| Bound-variable hypothesis builder for "at most one." (Contributed by NM, 9-Mar-1995.)
theorem hbmo {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi (wmo y1 ph) (wal x3 (wmo y1 ph)) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by NM, 9-Mar-1995.) (Revised by Andrew Salmon, 8-Jun-2011.)
theorem cbvmo {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wmo x3 ph) (wmo y1 ps) $;

--| An implication between two definitions of "there exists at most one." (Contributed by Jim Kingdon, 25-Jun-2018.)
theorem mo23 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi (wex y1 (wal x3 (wi ph (wceq (cv x3) (cv y1))))) (wal x3 (wal y1 (wi (wa ph (wsb x3 y1 ph)) (wceq (cv x3) (cv y1))))) $;

--| Converse of ~ mo23 with an additional ` E. x ph ` condition. (Contributed by Jim Kingdon, 25-Jun-2018.)
theorem mor {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi (wex x3 ph) (wi (wal x3 (wal y1 (wi (wa ph (wsb x3 y1 ph)) (wceq (cv x3) (cv y1))))) (wex y1 (wal x3 (wi ph (wceq (cv x3) (cv y1)))))) $;

--| Equivalent definitions of "there exists at most one," given decidable existence. (Contributed by Jim Kingdon, 1-Jul-2018.)
theorem modc {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi (wdc (wex x3 ph)) (wb (wex y1 (wal x3 (wi ph (wceq (cv x3) (cv y1))))) (wal x3 (wal y1 (wi (wa ph (wsb x3 y1 ph)) (wceq (cv x3) (cv y1)))))) $;

--| An alternate way of defining existential uniqueness. Definition 6.10 of [TakeutiZaring] p. 26. (Contributed by NM, 8-Jul-1994.)
theorem eu2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wb (weu x3 ph) (wa (wex x3 ph) (wal x3 (wal y1 (wi (wa ph (wsb x3 y1 ph)) (wceq (cv x3) (cv y1)))))) $;

--| An alternate way to express existential uniqueness. (Contributed by NM, 8-Jul-1994.) (New usage is discouraged.)
theorem eu3h {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wb (weu x3 ph) (wa (wex x3 ph) (wex y1 (wal x3 (wi ph (wceq (cv x3) (cv y1)))))) $;

--| An alternate way to express existential uniqueness. (Contributed by NM, 8-Jul-1994.)
theorem eu3 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wb (weu x3 ph) (wa (wex x3 ph) (wex y1 (wal x3 (wi ph (wceq (cv x3) (cv y1)))))) $;

--| Uniqueness in terms of "at most one." (Contributed by NM, 23-Mar-1995.) (Proof rewritten by Jim Kingdon, 27-May-2018.)
theorem eu5 {x3: setvar} (ph: wff x3):
  $ wb (weu x3 ph) (wa (wex x3 ph) (wmo x3 ph)) $;

--| Existence implies "at most one" is equivalent to uniqueness. (Contributed by NM, 5-Apr-2004.)
theorem exmoeu2 {x3: setvar} (ph: wff x3):
  $ wi (wex x3 ph) (wb (wmo x3 ph) (weu x3 ph)) $;

--| Absorption of existence condition by "at most one." (Contributed by NM, 4-Nov-2002.)
theorem moabs {x3: setvar} (ph: wff x3):
  $ wb (wmo x3 ph) (wi (wex x3 ph) (wmo x3 ph)) $;

--| If existence is decidable, something exists or at most one exists. (Contributed by Jim Kingdon, 30-Jun-2018.)
theorem exmodc {x3: setvar} (ph: wff x3):
  $ wi (wdc (wex x3 ph)) (wo (wex x3 ph) (wmo x3 ph)) $;

--| There is at most one of something which does not exist. Unlike ~ exmodc there is no decidability condition. (Contributed by Jim Kingdon, 22-Sep-2018.)
theorem exmonim {x3: setvar} (ph: wff x3):
  $ wi (wn (wex x3 ph)) (wmo x3 ph) $;

--| A condition which implies "at most one." (Contributed by Jim Kingdon, 2-Jul-2018.)
theorem mo2r {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi (wex y1 (wal x3 (wi ph (wceq (cv x3) (cv y1))))) (wmo x3 ph) $;

--| Alternate definition of "at most one." Definition of [BellMachover] p. 460, except that definition has the side condition that ` y ` not occur in ` ph ` in place of our hypothesis. (Contributed by NM, 8-Mar-1995.) (New usage is discouraged.)
theorem mo3h {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wb (wmo x3 ph) (wal x3 (wal y1 (wi (wa ph (wsb x3 y1 ph)) (wceq (cv x3) (cv y1))))) $;

--| Alternate definition of "at most one." Definition of [BellMachover] p. 460, except that definition has the side condition that ` y ` not occur in ` ph ` in place of our hypothesis. (Contributed by NM, 8-Mar-1995.)
theorem mo3 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wb (wmo x3 ph) (wal x3 (wal y1 (wi (wa ph (wsb x3 y1 ph)) (wceq (cv x3) (cv y1))))) $;

--| Alternate definition of "at most one" where existence is decidable. (Contributed by Jim Kingdon, 2-Jul-2018.)
theorem mo2dc {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi (wdc (wex x3 ph)) (wb (wmo x3 ph) (wex y1 (wal x3 (wi ph (wceq (cv x3) (cv y1)))))) $;

--| Introduction of a conjunct into uniqueness quantifier. (Contributed by NM, 19-Feb-2005.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem euan {x3: setvar} (ph ps: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wb (weu x3 (wa ph ps)) (wa ph (weu x3 ps)) $;

--| Introduction of a conjunct into uniqueness quantifier. (Contributed by NM, 23-Mar-1995.)
theorem euanv {x3: setvar} (ph: wff) (ps: wff x3):
  $ wb (weu x3 (wa ph ps)) (wa ph (weu x3 ps)) $;

--| Introduce or eliminate a disjunct in a uniqueness quantifier. (Contributed by NM, 21-Oct-2005.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem euor2 {x3: setvar} (ph ps: wff x3):
  $ wi (wn (wex x3 ph)) (wb (weu x3 (wo ph ps)) (weu x3 ps)) $;

--| Substitution into "at most one". (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem sbmo {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wb (wsb x3 y1 (wmo z ph)) (wmo z (wsb x3 y1 ph)) $;

--| "At most one" expressed using implicit substitution. (Contributed by NM, 10-Apr-2004.)
theorem mo4f {x3 y1: setvar} (ph: wff x3) (ps: wff x3 y1):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wmo x3 ph) (wal x3 (wal y1 (wi (wa ph ps) (wceq (cv x3) (cv y1))))) $;

--| "At most one" expressed using implicit substitution. (Contributed by NM, 26-Jul-1995.)
theorem mo4 {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wmo x3 ph) (wal x3 (wal y1 (wi (wa ph ps) (wceq (cv x3) (cv y1))))) $;

--| Uniqueness using implicit substitution. (Contributed by NM, 26-Jul-1995.)
theorem eu4 {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (weu x3 ph) (wa (wex x3 ph) (wal x3 (wal y1 (wi (wa ph ps) (wceq (cv x3) (cv y1)))))) $;

--| Existence in terms of "at most one" and uniqueness. (Contributed by Jim Kingdon, 3-Jul-2018.)
theorem exmoeudc {x3: setvar} (ph: wff x3):
  $ wi (wdc (wex x3 ph)) (wb (wex x3 ph) (wi (wmo x3 ph) (weu x3 ph))) $;

--| "At most one" is preserved through implication (notice wff reversal). (Contributed by NM, 22-Apr-1995.)
theorem moim {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wi ph ps)) (wi (wmo x3 ps) (wmo x3 ph)) $;

--| "At most one" is preserved through implication (notice wff reversal). (Contributed by NM, 15-Feb-2006.)
theorem moimi {x3: setvar} (ph ps: wff x3):
  $ wi ph ps $ >
  $ wi (wmo x3 ps) (wmo x3 ph) $;

--| Move antecedent outside of "at most one." (Contributed by NM, 28-Jul-1995.)
theorem moimv {x3: setvar} (ph: wff) (ps: wff x3):
  $ wi (wmo x3 (wi ph ps)) (wi ph (wmo x3 ps)) $;

--| Uniqueness implies "at most one" through implication. (Contributed by NM, 22-Apr-1995.)
theorem euimmo {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wi ph ps)) (wi (weu x3 ps) (wmo x3 ph)) $;

--| Add existential uniqueness quantifiers to an implication. Note the reversed implication in the antecedent. (Contributed by NM, 19-Oct-2005.) (Proof shortened by Andrew Salmon, 14-Jun-2011.)
theorem euim {x3: setvar} (ph ps: wff x3):
  $ wi (wa (wex x3 ph) (wal x3 (wi ph ps))) (wi (weu x3 ps) (weu x3 ph)) $;

--| "At most one" is still the case when a conjunct is added. (Contributed by NM, 22-Apr-1995.)
theorem moan {x3: setvar} (ph ps: wff x3):
  $ wi (wmo x3 ph) (wmo x3 (wa ps ph)) $;

--| "At most one" is still true when a conjunct is added. (Contributed by NM, 9-Mar-1995.)
theorem moani {x3: setvar} (ph ps: wff x3):
  $ wmo x3 ph $ >
  $ wmo x3 (wa ps ph) $;

--| "At most one" is still the case when a disjunct is removed. (Contributed by NM, 5-Apr-2004.)
theorem moor {x3: setvar} (ph ps: wff x3):
  $ wi (wmo x3 (wo ph ps)) (wmo x3 ph) $;

--| "At most one" imports disjunction to conjunction. (Contributed by NM, 5-Apr-2004.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem mooran1 {x3: setvar} (ph ps: wff x3):
  $ wi (wo (wmo x3 ph) (wmo x3 ps)) (wmo x3 (wa ph ps)) $;

--| "At most one" exports disjunction to conjunction. (Contributed by NM, 5-Apr-2004.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem mooran2 {x3: setvar} (ph ps: wff x3):
  $ wi (wmo x3 (wo ph ps)) (wa (wmo x3 ph) (wmo x3 ps)) $;

--| Introduction of a conjunct into "at most one" quantifier. (Contributed by NM, 3-Dec-2001.)
theorem moanim {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wb (wmo x3 (wa ph ps)) (wi ph (wmo x3 ps)) $;

--| Introduction of a conjunct into "at most one" quantifier. (Contributed by NM, 23-Mar-1995.)
theorem moanimv {x3: setvar} (ph: wff) (ps: wff x3):
  $ wb (wmo x3 (wa ph ps)) (wi ph (wmo x3 ps)) $;

--| Nested "at most one" and uniqueness quantifiers. (Contributed by NM, 25-Jan-2006.)
theorem moaneu {x3: setvar} (ph: wff x3):
  $ wmo x3 (wa ph (weu x3 ph)) $;

--| Nested "at most one" quantifiers. (Contributed by NM, 25-Jan-2006.)
theorem moanmo {x3: setvar} (ph: wff x3):
  $ wmo x3 (wa ph (wmo x3 ph)) $;

--| "At most one" picks a variable value, eliminating an existential quantifier. (Contributed by NM, 27-Jan-1997.)
theorem mopick {x3: setvar} (ph ps: wff x3):
  $ wi (wa (wmo x3 ph) (wex x3 (wa ph ps))) (wi ph ps) $;

--| Existential uniqueness "picks" a variable value for which another wff is true. If there is only one thing ` x ` such that ` ph ` is true, and there is also an ` x ` (actually the same one) such that ` ph ` and ` ps ` are both true, then ` ph ` implies ` ps ` regardless of ` x ` . This theorem can be useful for eliminating existential quantifiers in a hypothesis. Compare Theorem *14.26 in [WhiteheadRussell] p. 192. (Contributed by NM, 10-Jul-1994.)
theorem eupick {x3: setvar} (ph ps: wff x3):
  $ wi (wa (weu x3 ph) (wex x3 (wa ph ps))) (wi ph ps) $;

--| Version of ~ eupick with closed formulas. (Contributed by NM, 6-Sep-2008.)
theorem eupicka {x3: setvar} (ph ps: wff x3):
  $ wi (wa (weu x3 ph) (wex x3 (wa ph ps))) (wal x3 (wi ph ps)) $;

--| Existential uniqueness "pick" showing wff equivalence. (Contributed by NM, 25-Nov-1994.)
theorem eupickb {x3: setvar} (ph ps: wff x3):
  $ wi (w3a (weu x3 ph) (weu x3 ps) (wex x3 (wa ph ps))) (wb ph ps) $;

--| Theorem *14.26 in [WhiteheadRussell] p. 192. (Contributed by Andrew Salmon, 11-Jul-2011.)
theorem eupickbi {x3: setvar} (ph ps: wff x3):
  $ wi (weu x3 ph) (wb (wex x3 (wa ph ps)) (wal x3 (wi ph ps))) $;

--| "At most one" can show the existence of a common value. In this case we can infer existence of conjunction from a conjunction of existence, and it is one way to achieve the converse of ~ 19.40 . (Contributed by NM, 5-Apr-2004.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem mopick2 {x3: setvar} (ph ps ch: wff x3):
  $ wi (w3a (wmo x3 ph) (wex x3 (wa ph ps)) (wex x3 (wa ph ch))) (wex x3 (w3a ph ps ch)) $;

--| "At most one" double quantification. (Contributed by Jim Kingdon, 5-Jul-2018.)
theorem moexexdc {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi (wdc (wex x3 ph)) (wi (wa (wmo x3 ph) (wal x3 (wmo y1 ps))) (wmo y1 (wex x3 (wa ph ps)))) $;

--| Existential uniqueness and "at most one" double quantification. (Contributed by Jim Kingdon, 28-Dec-2018.)
theorem euexex {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi (wa (weu x3 ph) (wal x3 (wmo y1 ps))) (wmo y1 (wex x3 (wa ph ps))) $;

--| Double quantification with "at most one." (Contributed by NM, 3-Dec-2001.)
theorem _2moex {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wmo x3 (wex y1 ph)) (wal y1 (wmo x3 ph)) $;

--| Double quantification with existential uniqueness. (Contributed by NM, 3-Dec-2001.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem _2euex {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (weu x3 (wex y1 ph)) (wex y1 (weu x3 ph)) $;

--| Double quantification with existential uniqueness and "at most one." (Contributed by NM, 3-Dec-2001.)
theorem _2eumo {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (weu x3 (wmo y1 ph)) (wmo x3 (weu y1 ph)) $;

--| Double existential uniqueness. (Contributed by NM, 3-Dec-2001.)
theorem _2eu2ex {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (weu x3 (weu y1 ph)) (wex x3 (wex y1 ph)) $;

--| A condition allowing swap of "at most one" and existential quantifiers. (Contributed by Jim Kingdon, 6-Jul-2018.)
theorem _2moswapdc {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wdc (wex x3 (wex y1 ph))) (wi (wal x3 (wmo y1 ph)) (wi (wmo x3 (wex y1 ph)) (wmo y1 (wex x3 ph)))) $;

--| A condition allowing swap of uniqueness and existential quantifiers. (Contributed by Jim Kingdon, 7-Jul-2018.)
theorem _2euswapdc {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wdc (wex x3 (wex y1 ph))) (wi (wal x3 (wmo y1 ph)) (wi (weu x3 (wex y1 ph)) (weu y1 (wex x3 ph)))) $;

--| Double existential uniqueness implies double uniqueness quantification. (Contributed by NM, 3-Dec-2001.)
theorem _2exeu {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wa (weu x3 (wex y1 ph)) (weu y1 (wex x3 ph))) (weu x3 (weu y1 ph)) $;

--| This theorem provides us with a definition of double existential uniqueness ("exactly one ` x ` and exactly one ` y ` "). Naively one might think (incorrectly) that it could be defined by ` E! x E! y ph ` . See ~ 2exeu for a one-way implication. (Contributed by NM, 3-Dec-2001.)
theorem _2eu4 {x3 y1 z w: setvar} (ph: wff x3 y1):
  $ wb (wa (weu x3 (wex y1 ph)) (weu y1 (wex x3 ph))) (wa (wex x3 (wex y1 ph)) (wex z (wex w (wal x3 (wal y1 (wi ph (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))))))))) $;

--| Two equivalent expressions for double existential uniqueness. (Contributed by NM, 19-Feb-2005.)
theorem _2eu7 {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wa (weu x3 (wex y1 ph)) (weu y1 (wex x3 ph))) (weu x3 (weu y1 (wa (wex x3 ph) (wex y1 ph)))) $;

--| Equality has existential uniqueness. (Contributed by Stefan Allan, 4-Dec-2008.)
theorem euequ1 {x3 y1: setvar}:
  $ weu x3 (wceq (cv x3) (cv y1)) $;

--| Two ways to express "only one thing exists." The left-hand side requires only one variable to express this. Both sides are false in set theory. (Contributed by NM, 5-Apr-2004.)
theorem exists1 {x3 y1: setvar}:
  $ wb (weu x3 (wceq (cv x3) (cv x3))) (wal x3 (wceq (cv x3) (cv y1))) $;

--| A condition implying that at least two things exist. (Contributed by NM, 10-Apr-2004.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem exists2 {x3: setvar} (ph: wff x3):
  $ wi (wa (wex x3 ph) (wex x3 (wn ph))) (wn (weu x3 (wceq (cv x3) (cv x3)))) $;

--| "Barbara", one of the fundamental syllogisms of Aristotelian logic. All ` ph ` is ` ps ` , and all ` ch ` is ` ph ` , therefore all ` ch ` is ` ps ` . (In Aristotelian notation, AAA-1: MaP and SaM therefore SaP.) For example, given "All men are mortal" and "Socrates is a man", we can prove "Socrates is mortal". If H is the set of men, M is the set of mortal beings, and S is Socrates, these word phrases can be represented as ` A. x ( x e. H -> x e. M ) ` (all men are mortal) and ` A. x ( x = S -> x e. H ) ` (Socrates is a man) therefore ` A. x ( x = S -> x e. M ) ` (Socrates is mortal). Russell and Whitehead note that the "syllogism in Barbara is derived..." from ~ syl . (quote after Theorem *2.06 of [WhiteheadRussell] p. 101). Most of the proof is in ~ alsyl . There are a legion of sources for Barbara, including ~ http://www.friesian.com/aristotl.htm , ~ http://plato.stanford.edu/entries/aristotle-logic/ , and ~ https://en.wikipedia.org/wiki/Syllogism . (Contributed by David A. Wheeler, 24-Aug-2016.)
theorem barbara {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph ps) $ >
  $ wal x3 (wi ch ph) $ >
  $ wal x3 (wi ch ps) $;

--| "Celarent", one of the syllogisms of Aristotelian logic. No ` ph ` is ` ps ` , and all ` ch ` is ` ph ` , therefore no ` ch ` is ` ps ` . (In Aristotelian notation, EAE-1: MeP and SaM therefore SeP.) For example, given the "No reptiles have fur" and "All snakes are reptiles", therefore "No snakes have fur". Example from ~ https://en.wikipedia.org/wiki/Syllogism . (Contributed by David A. Wheeler, 24-Aug-2016.) (Revised by David A. Wheeler, 2-Sep-2016.)
theorem celarent {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph (wn ps)) $ >
  $ wal x3 (wi ch ph) $ >
  $ wal x3 (wi ch (wn ps)) $;

--| "Darii", one of the syllogisms of Aristotelian logic. All ` ph ` is ` ps ` , and some ` ch ` is ` ph ` , therefore some ` ch ` is ` ps ` . (In Aristotelian notation, AII-1: MaP and SiM therefore SiP.) For example, given "All rabbits have fur" and "Some pets are rabbits", therefore "Some pets have fur". Example from ~ https://en.wikipedia.org/wiki/Syllogism . (Contributed by David A. Wheeler, 24-Aug-2016.)
theorem darii {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph ps) $ >
  $ wex x3 (wa ch ph) $ >
  $ wex x3 (wa ch ps) $;

--| "Ferio" ("Ferioque"), one of the syllogisms of Aristotelian logic. No ` ph ` is ` ps ` , and some ` ch ` is ` ph ` , therefore some ` ch ` is not ` ps ` . (In Aristotelian notation, EIO-1: MeP and SiM therefore SoP.) For example, given "No homework is fun" and "Some reading is homework", therefore "Some reading is not fun". This is essentially a logical axiom in Aristotelian logic. Example from ~ https://en.wikipedia.org/wiki/Syllogism . (Contributed by David A. Wheeler, 24-Aug-2016.) (Revised by David A. Wheeler, 2-Sep-2016.)
theorem ferio {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph (wn ps)) $ >
  $ wex x3 (wa ch ph) $ >
  $ wex x3 (wa ch (wn ps)) $;

--| "Barbari", one of the syllogisms of Aristotelian logic. All ` ph ` is ` ps ` , all ` ch ` is ` ph ` , and some ` ch ` exist, therefore some ` ch ` is ` ps ` . (In Aristotelian notation, AAI-1: MaP and SaM therefore SiP.) For example, given "All men are mortal", "All Greeks are men", and "Greeks exist", therefore "Some Greeks are mortal". Note the existence hypothesis (to prove the "some" in the conclusion). Example from ~ https://en.wikipedia.org/wiki/Syllogism . (Contributed by David A. Wheeler, 27-Aug-2016.) (Revised by David A. Wheeler, 30-Aug-2016.)
theorem barbari {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph ps) $ >
  $ wal x3 (wi ch ph) $ >
  $ wex x3 ch $ >
  $ wex x3 (wa ch ps) $;

--| "Celaront", one of the syllogisms of Aristotelian logic. No ` ph ` is ` ps ` , all ` ch ` is ` ph ` , and some ` ch ` exist, therefore some ` ch ` is not ` ps ` . (In Aristotelian notation, EAO-1: MeP and SaM therefore SoP.) For example, given "No reptiles have fur", "All snakes are reptiles.", and "Snakes exist.", prove "Some snakes have no fur". Note the existence hypothesis. Example from ~ https://en.wikipedia.org/wiki/Syllogism . (Contributed by David A. Wheeler, 27-Aug-2016.) (Revised by David A. Wheeler, 2-Sep-2016.)
theorem celaront {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph (wn ps)) $ >
  $ wal x3 (wi ch ph) $ >
  $ wex x3 ch $ >
  $ wex x3 (wa ch (wn ps)) $;

--| "Cesare", one of the syllogisms of Aristotelian logic. No ` ph ` is ` ps ` , and all ` ch ` is ` ps ` , therefore no ` ch ` is ` ph ` . (In Aristotelian notation, EAE-2: PeM and SaM therefore SeP.) Related to ~ celarent . (Contributed by David A. Wheeler, 27-Aug-2016.) (Revised by David A. Wheeler, 13-Nov-2016.)
theorem cesare {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph (wn ps)) $ >
  $ wal x3 (wi ch ps) $ >
  $ wal x3 (wi ch (wn ph)) $;

--| "Camestres", one of the syllogisms of Aristotelian logic. All ` ph ` is ` ps ` , and no ` ch ` is ` ps ` , therefore no ` ch ` is ` ph ` . (In Aristotelian notation, AEE-2: PaM and SeM therefore SeP.) (Contributed by David A. Wheeler, 28-Aug-2016.) (Revised by David A. Wheeler, 2-Sep-2016.)
theorem camestres {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph ps) $ >
  $ wal x3 (wi ch (wn ps)) $ >
  $ wal x3 (wi ch (wn ph)) $;

--| "Festino", one of the syllogisms of Aristotelian logic. No ` ph ` is ` ps ` , and some ` ch ` is ` ps ` , therefore some ` ch ` is not ` ph ` . (In Aristotelian notation, EIO-2: PeM and SiM therefore SoP.) (Contributed by David A. Wheeler, 25-Nov-2016.)
theorem festino {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph (wn ps)) $ >
  $ wex x3 (wa ch ps) $ >
  $ wex x3 (wa ch (wn ph)) $;

--| "Baroco", one of the syllogisms of Aristotelian logic. All ` ph ` is ` ps ` , and some ` ch ` is not ` ps ` , therefore some ` ch ` is not ` ph ` . (In Aristotelian notation, AOO-2: PaM and SoM therefore SoP.) For example, "All informative things are useful", "Some websites are not useful", therefore "Some websites are not informative." (Contributed by David A. Wheeler, 28-Aug-2016.)
theorem baroco {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph ps) $ >
  $ wex x3 (wa ch (wn ps)) $ >
  $ wex x3 (wa ch (wn ph)) $;

--| "Cesaro", one of the syllogisms of Aristotelian logic. No ` ph ` is ` ps ` , all ` ch ` is ` ps ` , and ` ch ` exist, therefore some ` ch ` is not ` ph ` . (In Aristotelian notation, EAO-2: PeM and SaM therefore SoP.) (Contributed by David A. Wheeler, 28-Aug-2016.) (Revised by David A. Wheeler, 2-Sep-2016.)
theorem cesaro {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph (wn ps)) $ >
  $ wal x3 (wi ch ps) $ >
  $ wex x3 ch $ >
  $ wex x3 (wa ch (wn ph)) $;

--| "Camestros", one of the syllogisms of Aristotelian logic. All ` ph ` is ` ps ` , no ` ch ` is ` ps ` , and ` ch ` exist, therefore some ` ch ` is not ` ph ` . (In Aristotelian notation, AEO-2: PaM and SeM therefore SoP.) For example, "All horses have hooves", "No humans have hooves", and humans exist, therefore "Some humans are not horses". (Contributed by David A. Wheeler, 28-Aug-2016.) (Revised by David A. Wheeler, 2-Sep-2016.)
theorem camestros {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph ps) $ >
  $ wal x3 (wi ch (wn ps)) $ >
  $ wex x3 ch $ >
  $ wex x3 (wa ch (wn ph)) $;

--| "Datisi", one of the syllogisms of Aristotelian logic. All ` ph ` is ` ps ` , and some ` ph ` is ` ch ` , therefore some ` ch ` is ` ps ` . (In Aristotelian notation, AII-3: MaP and MiS therefore SiP.) (Contributed by David A. Wheeler, 28-Aug-2016.)
theorem datisi {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph ps) $ >
  $ wex x3 (wa ph ch) $ >
  $ wex x3 (wa ch ps) $;

--| "Disamis", one of the syllogisms of Aristotelian logic. Some ` ph ` is ` ps ` , and all ` ph ` is ` ch ` , therefore some ` ch ` is ` ps ` . (In Aristotelian notation, IAI-3: MiP and MaS therefore SiP.) (Contributed by David A. Wheeler, 28-Aug-2016.)
theorem disamis {x3: setvar} (ph ps ch: wff x3):
  $ wex x3 (wa ph ps) $ >
  $ wal x3 (wi ph ch) $ >
  $ wex x3 (wa ch ps) $;

--| "Ferison", one of the syllogisms of Aristotelian logic. No ` ph ` is ` ps ` , and some ` ph ` is ` ch ` , therefore some ` ch ` is not ` ps ` . (In Aristotelian notation, EIO-3: MeP and MiS therefore SoP.) (Contributed by David A. Wheeler, 28-Aug-2016.) (Revised by David A. Wheeler, 2-Sep-2016.)
theorem ferison {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph (wn ps)) $ >
  $ wex x3 (wa ph ch) $ >
  $ wex x3 (wa ch (wn ps)) $;

--| "Bocardo", one of the syllogisms of Aristotelian logic. Some ` ph ` is not ` ps ` , and all ` ph ` is ` ch ` , therefore some ` ch ` is not ` ps ` . (In Aristotelian notation, OAO-3: MoP and MaS therefore SoP.) For example, "Some cats have no tails", "All cats are mammals", therefore "Some mammals have no tails". A reorder of ~ disamis ; prefer using that instead. (Contributed by David A. Wheeler, 28-Aug-2016.) (New usage is discouraged.)
theorem bocardo {x3: setvar} (ph ps ch: wff x3):
  $ wex x3 (wa ph (wn ps)) $ >
  $ wal x3 (wi ph ch) $ >
  $ wex x3 (wa ch (wn ps)) $;

--| "Felapton", one of the syllogisms of Aristotelian logic. No ` ph ` is ` ps ` , all ` ph ` is ` ch ` , and some ` ph ` exist, therefore some ` ch ` is not ` ps ` . (In Aristotelian notation, EAO-3: MeP and MaS therefore SoP.) For example, "No flowers are animals" and "All flowers are plants", therefore "Some plants are not animals". (Contributed by David A. Wheeler, 28-Aug-2016.) (Revised by David A. Wheeler, 2-Sep-2016.)
theorem felapton {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph (wn ps)) $ >
  $ wal x3 (wi ph ch) $ >
  $ wex x3 ph $ >
  $ wex x3 (wa ch (wn ps)) $;

--| "Darapti", one of the syllogisms of Aristotelian logic. All ` ph ` is ` ps ` , all ` ph ` is ` ch ` , and some ` ph ` exist, therefore some ` ch ` is ` ps ` . (In Aristotelian notation, AAI-3: MaP and MaS therefore SiP.) For example, "All squares are rectangles" and "All squares are rhombuses", therefore "Some rhombuses are rectangles". (Contributed by David A. Wheeler, 28-Aug-2016.)
theorem darapti {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph ps) $ >
  $ wal x3 (wi ph ch) $ >
  $ wex x3 ph $ >
  $ wex x3 (wa ch ps) $;

--| "Calemes", one of the syllogisms of Aristotelian logic. All ` ph ` is ` ps ` , and no ` ps ` is ` ch ` , therefore no ` ch ` is ` ph ` . (In Aristotelian notation, AEE-4: PaM and MeS therefore SeP.) (Contributed by David A. Wheeler, 28-Aug-2016.) (Revised by David A. Wheeler, 2-Sep-2016.)
theorem calemes {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph ps) $ >
  $ wal x3 (wi ps (wn ch)) $ >
  $ wal x3 (wi ch (wn ph)) $;

--| "Dimatis", one of the syllogisms of Aristotelian logic. Some ` ph ` is ` ps ` , and all ` ps ` is ` ch ` , therefore some ` ch ` is ` ph ` . (In Aristotelian notation, IAI-4: PiM and MaS therefore SiP.) For example, "Some pets are rabbits.", "All rabbits have fur", therefore "Some fur bearing animals are pets". Like ~ darii with positions interchanged. (Contributed by David A. Wheeler, 28-Aug-2016.)
theorem dimatis {x3: setvar} (ph ps ch: wff x3):
  $ wex x3 (wa ph ps) $ >
  $ wal x3 (wi ps ch) $ >
  $ wex x3 (wa ch ph) $;

--| "Fresison", one of the syllogisms of Aristotelian logic. No ` ph ` is ` ps ` (PeM), and some ` ps ` is ` ch ` (MiS), therefore some ` ch ` is not ` ph ` (SoP). (In Aristotelian notation, EIO-4: PeM and MiS therefore SoP.) (Contributed by David A. Wheeler, 28-Aug-2016.) (Revised by David A. Wheeler, 2-Sep-2016.)
theorem fresison {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph (wn ps)) $ >
  $ wex x3 (wa ps ch) $ >
  $ wex x3 (wa ch (wn ph)) $;

--| "Calemos", one of the syllogisms of Aristotelian logic. All ` ph ` is ` ps ` (PaM), no ` ps ` is ` ch ` (MeS), and ` ch ` exist, therefore some ` ch ` is not ` ph ` (SoP). (In Aristotelian notation, AEO-4: PaM and MeS therefore SoP.) (Contributed by David A. Wheeler, 28-Aug-2016.) (Revised by David A. Wheeler, 2-Sep-2016.)
theorem calemos {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph ps) $ >
  $ wal x3 (wi ps (wn ch)) $ >
  $ wex x3 ch $ >
  $ wex x3 (wa ch (wn ph)) $;

--| "Fesapo", one of the syllogisms of Aristotelian logic. No ` ph ` is ` ps ` , all ` ps ` is ` ch ` , and ` ps ` exist, therefore some ` ch ` is not ` ph ` . (In Aristotelian notation, EAO-4: PeM and MaS therefore SoP.) (Contributed by David A. Wheeler, 28-Aug-2016.) (Revised by David A. Wheeler, 2-Sep-2016.)
theorem fesapo {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph (wn ps)) $ >
  $ wal x3 (wi ps ch) $ >
  $ wex x3 ps $ >
  $ wex x3 (wa ch (wn ph)) $;

--| "Bamalip", one of the syllogisms of Aristotelian logic. All ` ph ` is ` ps ` , all ` ps ` is ` ch ` , and ` ph ` exist, therefore some ` ch ` is ` ph ` . (In Aristotelian notation, AAI-4: PaM and MaS therefore SiP.) Like ~ barbari . (Contributed by David A. Wheeler, 28-Aug-2016.)
theorem bamalip {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph ps) $ >
  $ wal x3 (wi ps ch) $ >
  $ wex x3 ph $ >
  $ wex x3 (wa ch ph) $;

--| Axiom of Extensionality. It states that two sets are identical if they contain the same elements. Axiom 1 of [Crosilla] p. "Axioms of CZF and IZF" (with unnecessary quantifiers removed). Set theory can also be formulated with a _single_ primitive predicate ` e. ` on top of traditional predicate calculus _without_ equality. In that case the Axiom of Extensionality becomes ` ( A. w ( w e. x <-> w e. y ) -> ( x e. z -> y e. z ) ) ` , and equality ` x = y ` is _defined_ as ` A. w ( w e. x <-> w e. y ) ` . All of the usual axioms of equality then become theorems of set theory. See, for example, Axiom 1 of [TakeutiZaring] p. 8. To use the above "equality-free" version of Extensionality with Metamath's logical axioms, we would rewrite ~ ax-8 through ~ ax-16 with equality expanded according to the above definition. Some of those axioms could be proved from set theory and would be redundant. Not all of them are redundant, since our axioms of predicate calculus make essential use of equality for the proper substitution that is a primitive notion in traditional predicate calculus. A study of such an axiomatization would be an interesting project for someone exploring the foundations of logic. It is important to understand that strictly speaking, all of our set theory axioms are really schemes that represent an infinite number of actual axioms. This is inherent in the design of Metamath ("metavariable math"), which manipulates only metavariables. For example, the metavariable ` x ` in ~ ax-ext can represent any actual variable _v1_, _v2_, _v3_,... . Distinct variable restrictions ($d) prevent us from substituting say _v1_ for both ` x ` and ` z ` . This is in contrast to typical textbook presentations that present actual axioms (except for axioms which involve wff metavariables). In practice, though, the theorems and proofs are essentially the same. The $d restrictions make each of the infinite axioms generated by the ~ ax-ext scheme exactly logically equivalent to each other and in particular to the actual axiom of the textbook version. (Contributed by NM, 5-Aug-1993.)
axiom ax_ext {z: setvar} (x3 y1: setvar):
  $ wi (wal z (wb (wcel (cv z) (cv x3)) (wcel (cv z) (cv y1)))) (wceq (cv x3) (cv y1)) $;

--| A generalization of the Axiom of Extensionality in which ` x ` and ` y ` need not be distinct. (Contributed by NM, 15-Sep-1993.) (Proof shortened by Andrew Salmon, 12-Aug-2011.)
theorem axext3 {x3 z: setvar} (y1: setvar):
  $ wi (wal z (wb (wcel (cv z) (cv x3)) (wcel (cv z) (cv y1)))) (wceq (cv x3) (cv y1)) $;

--| A bidirectional version of Extensionality. Although this theorem "looks" like it is just a definition of equality, it requires the Axiom of Extensionality for its proof under our axiomatization. See the comments for ~ ax-ext . (Contributed by NM, 14-Nov-2008.)
theorem axext4 {x3 y1 z: setvar}:
  $ wb (wceq (cv x3) (cv y1)) (wal z (wb (wcel (cv z) (cv x3)) (wcel (cv z) (cv y1)))) $;

--| Any set defined by a property is the only set defined by that property. Theorem 1.1 of [BellMachover] p. 462. (Contributed by NM, 30-Jun-1994.)
theorem bm1_1 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 ph $ >
  $ wi (wex x3 (wal y1 (wb (wcel (cv y1) (cv x3)) ph))) (weu x3 (wal y1 (wb (wcel (cv y1) (cv x3)) ph))) $;

--| Introduce the class builder or class abstraction notation ("the class of sets ` x ` such that ` ph ` is true"). Our class variables ` A ` , ` B ` , etc. range over class builders (sometimes implicitly). Note that a setvar variable can be expressed as a class builder per theorem ~ cvjust , justifying the assignment of setvar variables to class variables via the use of ~ cv .
term cab {x3: setvar} (ph: wff x3): class;

--| Define class abstraction notation (so-called by Quine), also called a "class builder" in the literature. ` x ` and ` y ` need not be distinct. Definition 2.1 of [Quine] p. 16. Typically, ` ph ` will have ` y ` as a free variable, and " ` { y | ph } ` " is read "the class of all sets ` y ` such that ` ph ( y ) ` is true." We do not define ` { y | ph } ` in isolation but only as part of an expression that extends or "overloads" the ` e. ` relationship. This is our first use of the ` e. ` symbol to connect classes instead of sets. The syntax definition ~ wcel , which extends or "overloads" the ~ wel definition connecting setvar variables, requires that both sides of ` e. ` be a class. In ~ df-cleq and ~ df-clel , we introduce a new kind of variable (class variable) that can substituted with expressions such as ` { y | ph } ` . In the present definition, the ` x ` on the left-hand side is a setvar variable. Syntax definition ~ cv allows us to substitute a setvar variable ` x ` for a class variable: all sets are classes by ~ cvjust (but not necessarily vice-versa). For a full description of how classes are introduced and how to recover the primitive language, see the discussion in Quine (and under ~ abeq2 for a quick overview). Because class variables can be substituted with compound expressions and setvar variables cannot, it is often useful to convert a theorem containing a free setvar variable to a more general version with a class variable. This is called the "axiom of class comprehension" by [Levy] p. 338, who treats the theory of classes as an extralogical extension to our logic and set theory axioms. He calls the construction ` { y | ph } ` a "class term". For a general discussion of the theory of classes, see ~ http://us.metamath.org/mpeuni/mmset.html#class . (Contributed by NM, 5-Aug-1993.)
axiom df_clab {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wcel (cv x3) (cab y1 ph)) (wsb y1 x3 ph) $;

--| Define class abstraction notation (so-called by Quine), also called a "class builder" in the literature. ` x ` and ` y ` need not be distinct. Definition 2.1 of [Quine] p. 16. Typically, ` ph ` will have ` y ` as a free variable, and " ` { y | ph } ` " is read "the class of all sets ` y ` such that ` ph ( y ) ` is true." We do not define ` { y | ph } ` in isolation but only as part of an expression that extends or "overloads" the ` e. ` relationship. This is our first use of the ` e. ` symbol to connect classes instead of sets. The syntax definition ~ wcel , which extends or "overloads" the ~ wel definition connecting setvar variables, requires that both sides of ` e. ` be a class. In ~ df-cleq and ~ df-clel , we introduce a new kind of variable (class variable) that can substituted with expressions such as ` { y | ph } ` . In the present definition, the ` x ` on the left-hand side is a setvar variable. Syntax definition ~ cv allows us to substitute a setvar variable ` x ` for a class variable: all sets are classes by ~ cvjust (but not necessarily vice-versa). For a full description of how classes are introduced and how to recover the primitive language, see the discussion in Quine (and under ~ abeq2 for a quick overview). Because class variables can be substituted with compound expressions and setvar variables cannot, it is often useful to convert a theorem containing a free setvar variable to a more general version with a class variable. This is called the "axiom of class comprehension" by [Levy] p. 338, who treats the theory of classes as an extralogical extension to our logic and set theory axioms. He calls the construction ` { y | ph } ` a "class term". For a general discussion of the theory of classes, see ~ http://us.metamath.org/mpeuni/mmset.html#class . (Contributed by NM, 5-Aug-1993.)
axiom df_clab_b {x3: setvar} (ph: wff x3):
  $ wb (wcel (cv x3) (cab x3 ph)) (wsb x3 x3 ph) $;

--| Simplification of class abstraction notation when the free and bound variables are identical. (Contributed by NM, 5-Aug-1993.)
theorem abid {x3: setvar} (ph: wff x3):
  $ wb (wcel (cv x3) (cab x3 ph)) ph $;

--| Bound-variable hypothesis builder for a class abstraction. (Contributed by NM, 5-Aug-1993.)
theorem hbab1 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wcel (cv y1) (cab x3 ph)) (wal x3 (wcel (cv y1) (cab x3 ph))) $;

--| Bound-variable hypothesis builder for a class abstraction. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfsab1 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 (wcel (cv y1) (cab x3 ph)) $;

--| Bound-variable hypothesis builder for a class abstraction. (Contributed by NM, 1-Mar-1995.)
theorem hbab {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi ph (wal x3 ph) $ >
  $ wi (wcel (cv z) (cab y1 ph)) (wal x3 (wcel (cv z) (cab y1 ph))) $;

--| Bound-variable hypothesis builder for a class abstraction. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfsab {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wnf x3 ph $ >
  $ wnf x3 (wcel (cv z) (cab y1 ph)) $;

--| Define the equality connective between classes. Definition 2.7 of [Quine] p. 18. Also Definition 4.5 of [TakeutiZaring] p. 13; Chapter 4 provides its justification and methods for eliminating it. Note that its elimination will not necessarily result in a single wff in the original language but possibly a "scheme" of wffs. This is an example of a somewhat "risky" definition, meaning that it has a more complex than usual soundness justification (outside of Metamath), because it "overloads" or reuses the existing equality symbol rather than introducing a new symbol. This allows us to make statements that may not hold for the original symbol. For example, it permits us to deduce ` y = z <-> A. x ( x e. y <-> x e. z ) ` , which is not a theorem of logic but rather presupposes the Axiom of Extensionality (see theorem ~ axext4 ). We therefore include this axiom as a hypothesis, so that the use of Extensionality is properly indicated. We could avoid this complication by introducing a new symbol, say =_2, in place of ` = ` . This would also have the advantage of making elimination of the definition straightforward, so that we could eliminate Extensionality as a hypothesis. We would then also have the advantage of being able to identify in various proofs exactly where Extensionality truly comes into play rather than just being an artifact of a definition. One of our theorems would then be ` x ` =_2 ` y <-> x = y ` by invoking Extensionality. However, to conform to literature usage, we retain this overloaded definition. This also makes some proofs shorter and probably easier to read, without the constant switching between two kinds of equality. See also comments under ~ df-clab , ~ df-clel , and ~ abeq2 . In the form of ~ dfcleq , this is called the "axiom of extensionality" by [Levy] p. 338, who treats the theory of classes as an extralogical extension to our logic and set theory axioms. For a general discussion of the theory of classes, see ~ http://us.metamath.org/mpeuni/mmset.html#class . (Contributed by NM, 15-Sep-1993.)
axiom df_cleq {x3 y1 z: setvar} (A2 B2: class y1 z):
  $ wi (wal x3 (wb (wcel (cv x3) (cv y1)) (wcel (cv x3) (cv z)))) (wceq (cv y1) (cv z)) $ >
  $ wb (wceq A2 B2) (wal x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| The same as ~ df-cleq with the hypothesis removed using the Axiom of Extensionality ~ ax-ext . (Contributed by NM, 15-Sep-1993.)
theorem dfcleq {x3: setvar} (A2 B2: class):
  $ wb (wceq A2 B2) (wal x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| Every set is a class. Proposition 4.9 of [TakeutiZaring] p. 13. This theorem shows that a setvar variable can be expressed as a class abstraction. This provides a motivation for the class syntax construction ~ cv , which allows us to substitute a setvar variable for a class variable. See also ~ cab and ~ df-clab . Note that this is not a rigorous justification, because ~ cv is used as part of the proof of this theorem, but a careful argument can be made outside of the formalism of Metamath, for example as is done in Chapter 4 of Takeuti and Zaring. See also the discussion under the definition of class in [Jech] p. 4 showing that "Every set can be considered to be a class." (Contributed by NM, 7-Nov-2006.)
theorem cvjust {y1: setvar} (x3: setvar):
  $ wceq (cv x3) (cab y1 (wcel (cv y1) (cv x3))) $;

--| Define the membership connective between classes. Theorem 6.3 of [Quine] p. 41, or Proposition 4.6 of [TakeutiZaring] p. 13, which we adopt as a definition. See these references for its metalogical justification. Note that like ~ df-cleq it extends or "overloads" the use of the existing membership symbol, but unlike ~ df-cleq it does not strengthen the set of valid wffs of logic when the class variables are replaced with setvar variables (see ~ cleljust ), so we don't include any set theory axiom as a hypothesis. See also comments about the syntax under ~ df-clab . This is called the "axiom of membership" by [Levy] p. 338, who treats the theory of classes as an extralogical extension to our logic and set theory axioms. For a general discussion of the theory of classes, see ~ http://us.metamath.org/mpeuni/mmset.html#class . (Contributed by NM, 5-Aug-1993.)
axiom df_clel {x3: setvar} (A2 B2: class):
  $ wb (wcel A2 B2) (wex x3 (wa (wceq (cv x3) A2) (wcel (cv x3) B2))) $;

--| Infer equality of classes from equivalence of membership. (Contributed by NM, 5-Aug-1993.)
theorem eqriv {x3: setvar} (A2 B2: class):
  $ wb (wcel (cv x3) A2) (wcel (cv x3) B2) $ >
  $ wceq A2 B2 $;

--| Deduce equality of classes from equivalence of membership. (Contributed by NM, 17-Mar-1996.)
theorem eqrdv {x3: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wb (wcel (cv x3) A2) (wcel (cv x3) B2)) $ >
  $ wi ph (wceq A2 B2) $;

--| Deduce equality of classes from an equivalence of membership that depends on the membership variable. (Contributed by NM, 7-Nov-2008.)
theorem eqrdav {x3: setvar} (ph: wff) (A2 B2: class) (C: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel (cv x3) C) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wcel (cv x3) C) $ >
  $ wi (wa ph (wcel (cv x3) C)) (wb (wcel (cv x3) A2) (wcel (cv x3) B2)) $ >
  $ wi ph (wceq A2 B2) $;

--| Law of identity (reflexivity of class equality). Theorem 6.4 of [Quine] p. 41. This law is thought to have originated with Aristotle (_Metaphysics_, Zeta, 17, 1041 a, 10-20). (Thanks to Stefan Allan and BJ for this information.) (Contributed by NM, 5-Aug-1993.) (Revised by BJ, 14-Oct-2017.)
theorem eqid (A2: class):
  $ wceq A2 A2 $;

--| Class identity law with antecedent. (Contributed by NM, 21-Aug-2008.)
theorem eqidd (ph: wff) (A2: class):
  $ wi ph (wceq A2 A2) $;

--| Commutative law for class equality. Theorem 6.5 of [Quine] p. 41. (Contributed by NM, 5-Aug-1993.)
theorem eqcom (A2 B2: class):
  $ wb (wceq A2 B2) (wceq B2 A2) $;

--| Inference applying commutative law for class equality to an antecedent. (Contributed by NM, 5-Aug-1993.)
theorem eqcoms (ph: wff) (A2 B2: class):
  $ wi (wceq A2 B2) ph $ >
  $ wi (wceq B2 A2) ph $;

--| Inference from commutative law for class equality. (Contributed by NM, 5-Aug-1993.)
theorem eqcomi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq B2 A2 $;

--| Deduction from commutative law for class equality. (Contributed by NM, 15-Aug-1994.)
theorem eqcomd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq B2 A2) $;

--| Equality implies equivalence of equalities. (Contributed by NM, 5-Aug-1993.)
theorem eqeq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wceq A2 C) (wceq B2 C)) $;

--| Inference from equality to equivalence of equalities. (Contributed by NM, 5-Aug-1993.)
theorem eqeq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wb (wceq A2 C) (wceq B2 C) $;

--| Deduction from equality to equivalence of equalities. (Contributed by NM, 27-Dec-1993.)
theorem eqeq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wceq A2 C) (wceq B2 C)) $;

--| Equality implies equivalence of equalities. (Contributed by NM, 5-Aug-1993.)
theorem eqeq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wceq C A2) (wceq C B2)) $;

--| Inference from equality to equivalence of equalities. (Contributed by NM, 5-Aug-1993.)
theorem eqeq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wb (wceq C A2) (wceq C B2) $;

--| Deduction from equality to equivalence of equalities. (Contributed by NM, 27-Dec-1993.)
theorem eqeq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wceq C A2) (wceq C B2)) $;

--| Equality relationship among 4 classes. (Contributed by NM, 3-Aug-1994.)
theorem eqeq12 (A2 B2 C D: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wb (wceq A2 C) (wceq B2 D)) $;

--| A useful inference for substituting definitions into an equality. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem eqeq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wb (wceq A2 C) (wceq B2 D) $;

--| A useful inference for substituting definitions into an equality. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem eqeq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wceq A2 C) (wceq B2 D)) $;

--| A useful inference for substituting definitions into an equality. (Contributed by NM, 9-Aug-1994.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem eqeqan12d (ph ps: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ps (wceq C D) $ >
  $ wi (wa ph ps) (wb (wceq A2 C) (wceq B2 D)) $;

--| A useful inference for substituting definitions into an equality. (Contributed by NM, 9-Aug-1994.)
theorem eqeqan12rd (ph ps: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ps (wceq C D) $ >
  $ wi (wa ps ph) (wb (wceq A2 C) (wceq B2 D)) $;

--| Transitive law for class equality. Proposition 4.7(3) of [TakeutiZaring] p. 13. (Contributed by NM, 25-Jan-2004.)
theorem eqtr (A2 B2 C: class):
  $ wi (wa (wceq A2 B2) (wceq B2 C)) (wceq A2 C) $;

--| A transitive law for class equality. (Contributed by NM, 20-May-2005.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem eqtr2 (A2 B2 C: class):
  $ wi (wa (wceq A2 B2) (wceq A2 C)) (wceq B2 C) $;

--| A transitive law for class equality. (Contributed by NM, 20-May-2005.)
theorem eqtr3 (A2 B2 C: class):
  $ wi (wa (wceq A2 C) (wceq B2 C)) (wceq A2 B2) $;

--| An equality transitivity inference. (Contributed by NM, 5-Aug-1993.)
theorem eqtri (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq B2 C $ >
  $ wceq A2 C $;

--| An equality transitivity inference. (Contributed by NM, 21-Feb-1995.)
theorem eqtr2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq B2 C $ >
  $ wceq C A2 $;

--| An equality transitivity inference. (Contributed by NM, 6-May-1994.)
theorem eqtr3i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq A2 C $ >
  $ wceq B2 C $;

--| An equality transitivity inference. (Contributed by NM, 5-Aug-1993.)
theorem eqtr4i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq C B2 $ >
  $ wceq A2 C $;

--| An inference from three chained equalities. (Contributed by NM, 29-Aug-1993.)
theorem _3eqtri (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq B2 C $ >
  $ wceq C D $ >
  $ wceq A2 D $;

--| An inference from three chained equalities. (Contributed by NM, 3-Aug-2006.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem _3eqtrri (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq B2 C $ >
  $ wceq C D $ >
  $ wceq D A2 $;

--| An inference from three chained equalities. (Contributed by NM, 3-Aug-2006.)
theorem _3eqtr2i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C B2 $ >
  $ wceq C D $ >
  $ wceq A2 D $;

--| An inference from three chained equalities. (Contributed by NM, 3-Aug-2006.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem _3eqtr2ri (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C B2 $ >
  $ wceq C D $ >
  $ wceq D A2 $;

--| An inference from three chained equalities. (Contributed by NM, 6-May-1994.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem _3eqtr3i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wceq C D $;

--| An inference from three chained equalities. (Contributed by NM, 15-Aug-2004.)
theorem _3eqtr3ri (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wceq D C $;

--| An inference from three chained equalities. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem _3eqtr4i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C A2 $ >
  $ wceq D B2 $ >
  $ wceq C D $;

--| An inference from three chained equalities. (Contributed by NM, 2-Sep-1995.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem _3eqtr4ri (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C A2 $ >
  $ wceq D B2 $ >
  $ wceq D C $;

--| An equality transitivity deduction. (Contributed by NM, 5-Aug-1993.)
theorem eqtrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq A2 C) $;

--| An equality transitivity deduction. (Contributed by NM, 18-Oct-1999.)
theorem eqtr2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq C A2) $;

--| An equality transitivity equality deduction. (Contributed by NM, 18-Jul-1995.)
theorem eqtr3d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 C) $;

--| An equality transitivity equality deduction. (Contributed by NM, 18-Jul-1995.)
theorem eqtr4d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C B2) $ >
  $ wi ph (wceq A2 C) $;

--| A deduction from three chained equalities. (Contributed by NM, 29-Oct-1995.)
theorem _3eqtrd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq A2 D) $;

--| A deduction from three chained equalities. (Contributed by NM, 4-Aug-2006.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem _3eqtrrd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq D A2) $;

--| A deduction from three chained equalities. (Contributed by NM, 4-Aug-2006.)
theorem _3eqtr2d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq A2 D) $;

--| A deduction from three chained equalities. (Contributed by NM, 4-Aug-2006.)
theorem _3eqtr2rd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq D A2) $;

--| A deduction from three chained equalities. (Contributed by NM, 4-Aug-1995.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem _3eqtr3d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wceq C D) $;

--| A deduction from three chained equalities. (Contributed by NM, 14-Jan-2006.)
theorem _3eqtr3rd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wceq D C) $;

--| A deduction from three chained equalities. (Contributed by NM, 4-Aug-1995.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem _3eqtr4d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C A2) $ >
  $ wi ph (wceq D B2) $ >
  $ wi ph (wceq C D) $;

--| A deduction from three chained equalities. (Contributed by NM, 21-Sep-1995.)
theorem _3eqtr4rd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C A2) $ >
  $ wi ph (wceq D B2) $ >
  $ wi ph (wceq D C) $;

--| An equality transitivity deduction. (Contributed by NM, 5-Aug-1993.)
theorem syl5eq (ph: wff) (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq A2 C) $;

--| An equality transitivity deduction. (Contributed by NM, 29-Mar-1998.)
theorem syl5req (ph: wff) (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq C A2) $;

--| An equality transitivity deduction. (Contributed by NM, 5-Aug-1993.)
theorem syl5eqr (ph: wff) (A2 B2 C: class):
  $ wceq B2 A2 $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq A2 C) $;

--| An equality transitivity deduction. (Contributed by NM, 29-Mar-1998.)
theorem syl5reqr (ph: wff) (A2 B2 C: class):
  $ wceq B2 A2 $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq C A2) $;

--| An equality transitivity deduction. (Contributed by NM, 5-Aug-1993.)
theorem syl6eq (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wceq B2 C $ >
  $ wi ph (wceq A2 C) $;

--| An equality transitivity deduction. (Contributed by NM, 29-Mar-1998.)
theorem syl6req (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wceq B2 C $ >
  $ wi ph (wceq C A2) $;

--| An equality transitivity deduction. (Contributed by NM, 5-Aug-1993.)
theorem syl6eqr (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wceq C B2 $ >
  $ wi ph (wceq A2 C) $;

--| An equality transitivity deduction. (Contributed by NM, 29-Mar-1998.)
theorem syl6reqr (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wceq C B2 $ >
  $ wi ph (wceq C A2) $;

--| An equality transitivity deduction. (Contributed by NM, 8-May-1994.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem sylan9eq (ph ps: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ps (wceq B2 C) $ >
  $ wi (wa ph ps) (wceq A2 C) $;

--| An equality transitivity deduction. (Contributed by NM, 23-Jun-2007.)
theorem sylan9req (ph ps: wff) (A2 B2 C: class):
  $ wi ph (wceq B2 A2) $ >
  $ wi ps (wceq B2 C) $ >
  $ wi (wa ph ps) (wceq A2 C) $;

--| An equality transitivity deduction. (Contributed by NM, 8-May-1994.)
theorem sylan9eqr (ph ps: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ps (wceq B2 C) $ >
  $ wi (wa ps ph) (wceq A2 C) $;

--| A chained equality inference, useful for converting from definitions. (Contributed by NM, 15-Nov-1994.)
theorem _3eqtr3g (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wi ph (wceq C D) $;

--| A chained equality inference, useful for converting from definitions. (Contributed by Mario Carneiro, 6-Nov-2015.)
theorem _3eqtr3a (ph: wff) (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wceq C D) $;

--| A chained equality inference, useful for converting to definitions. (Contributed by NM, 5-Aug-1993.)
theorem _3eqtr4g (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wceq C A2 $ >
  $ wceq D B2 $ >
  $ wi ph (wceq C D) $;

--| A chained equality inference, useful for converting to definitions. (Contributed by NM, 2-Feb-2007.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem _3eqtr4a (ph: wff) (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wi ph (wceq C A2) $ >
  $ wi ph (wceq D B2) $ >
  $ wi ph (wceq C D) $;

--| A compound transitive inference for class equality. (Contributed by NM, 22-Jan-2004.)
theorem eq2tri (A2 B2 C D F G: class):
  $ wi (wceq A2 C) (wceq D F) $ >
  $ wi (wceq B2 D) (wceq C G) $ >
  $ wb (wa (wceq A2 C) (wceq B2 F)) (wa (wceq B2 D) (wceq A2 G)) $;

--| Equality implies equivalence of membership. (Contributed by NM, 5-Aug-1993.)
theorem eleq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wcel A2 C) (wcel B2 C)) $;

--| Equality implies equivalence of membership. (Contributed by NM, 5-Aug-1993.)
theorem eleq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wcel C A2) (wcel C B2)) $;

--| Equality implies equivalence of membership. (Contributed by NM, 31-May-1999.)
theorem eleq12 (A2 B2 C D: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wb (wcel A2 C) (wcel B2 D)) $;

--| Inference from equality to equivalence of membership. (Contributed by NM, 5-Aug-1993.)
theorem eleq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wb (wcel A2 C) (wcel B2 C) $;

--| Inference from equality to equivalence of membership. (Contributed by NM, 5-Aug-1993.)
theorem eleq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wb (wcel C A2) (wcel C B2) $;

--| Inference from equality to equivalence of membership. (Contributed by NM, 31-May-1994.)
theorem eleq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wb (wcel A2 C) (wcel B2 D) $;

--| Deduction from equality to equivalence of membership. (Contributed by NM, 5-Aug-1993.)
theorem eleq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wcel A2 C) (wcel B2 C)) $;

--| Deduction from equality to equivalence of membership. (Contributed by NM, 27-Dec-1993.)
theorem eleq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wcel C A2) (wcel C B2)) $;

--| Deduction from equality to equivalence of membership. (Contributed by NM, 31-May-1994.)
theorem eleq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wcel A2 C) (wcel B2 D)) $;

--| A transitive-type law relating membership and equality. (Contributed by NM, 9-Apr-1994.)
theorem eleq1a (A2 B2 C: class):
  $ wi (wcel A2 B2) (wi (wceq C A2) (wcel C B2)) $;

--| Substitution of equal classes into membership relation. (Contributed by NM, 5-Aug-1993.)
theorem eqeltri (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wcel B2 C $ >
  $ wcel A2 C $;

--| Substitution of equal classes into membership relation. (Contributed by NM, 5-Aug-1993.)
theorem eqeltrri (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wcel A2 C $ >
  $ wcel B2 C $;

--| Substitution of equal classes into membership relation. (Contributed by NM, 5-Aug-1993.)
theorem eleqtri (A2 B2 C: class):
  $ wcel A2 B2 $ >
  $ wceq B2 C $ >
  $ wcel A2 C $;

--| Substitution of equal classes into membership relation. (Contributed by NM, 5-Aug-1993.)
theorem eleqtrri (A2 B2 C: class):
  $ wcel A2 B2 $ >
  $ wceq C B2 $ >
  $ wcel A2 C $;

--| Substitution of equal classes into membership relation, deduction form. (Contributed by Raph Levien, 10-Dec-2002.)
theorem eqeltrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wcel B2 C) $ >
  $ wi ph (wcel A2 C) $;

--| Deduction that substitutes equal classes into membership. (Contributed by NM, 14-Dec-2004.)
theorem eqeltrrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel B2 C) $;

--| Deduction that substitutes equal classes into membership. (Contributed by NM, 14-Dec-2004.)
theorem eleqtrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wcel A2 C) $;

--| Deduction that substitutes equal classes into membership. (Contributed by NM, 14-Dec-2004.)
theorem eleqtrrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wceq C B2) $ >
  $ wi ph (wcel A2 C) $;

--| Substitution of equal classes into membership relation. (Contributed by Mario Carneiro, 6-Jan-2017.)
theorem _3eltr3i (A2 B2 C D: class):
  $ wcel A2 B2 $ >
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wcel C D $;

--| Substitution of equal classes into membership relation. (Contributed by Mario Carneiro, 6-Jan-2017.)
theorem _3eltr4i (A2 B2 C D: class):
  $ wcel A2 B2 $ >
  $ wceq C A2 $ >
  $ wceq D B2 $ >
  $ wcel C D $;

--| Substitution of equal classes into membership relation. (Contributed by Mario Carneiro, 6-Jan-2017.)
theorem _3eltr3d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wcel C D) $;

--| Substitution of equal classes into membership relation. (Contributed by Mario Carneiro, 6-Jan-2017.)
theorem _3eltr4d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wceq C A2) $ >
  $ wi ph (wceq D B2) $ >
  $ wi ph (wcel C D) $;

--| Substitution of equal classes into membership relation. (Contributed by Mario Carneiro, 6-Jan-2017.)
theorem _3eltr3g (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 B2) $ >
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wi ph (wcel C D) $;

--| Substitution of equal classes into membership relation. (Contributed by Mario Carneiro, 6-Jan-2017.)
theorem _3eltr4g (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 B2) $ >
  $ wceq C A2 $ >
  $ wceq D B2 $ >
  $ wi ph (wcel C D) $;

--| B membership and equality inference. (Contributed by NM, 4-Jan-2006.)
theorem syl5eqel (ph: wff) (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wi ph (wcel B2 C) $ >
  $ wi ph (wcel A2 C) $;

--| B membership and equality inference. (Contributed by NM, 4-Jan-2006.)
theorem syl5eqelr (ph: wff) (A2 B2 C: class):
  $ wceq B2 A2 $ >
  $ wi ph (wcel B2 C) $ >
  $ wi ph (wcel A2 C) $;

--| B membership and equality inference. (Contributed by NM, 4-Jan-2006.)
theorem syl5eleq (ph: wff) (A2 B2 C: class):
  $ wcel A2 B2 $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wcel A2 C) $;

--| B membership and equality inference. (Contributed by NM, 4-Jan-2006.)
theorem syl5eleqr (ph: wff) (A2 B2 C: class):
  $ wcel A2 B2 $ >
  $ wi ph (wceq C B2) $ >
  $ wi ph (wcel A2 C) $;

--| A membership and equality inference. (Contributed by NM, 4-Jan-2006.)
theorem syl6eqel (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wcel B2 C $ >
  $ wi ph (wcel A2 C) $;

--| A membership and equality inference. (Contributed by NM, 4-Jan-2006.)
theorem syl6eqelr (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq B2 A2) $ >
  $ wcel B2 C $ >
  $ wi ph (wcel A2 C) $;

--| A membership and equality inference. (Contributed by NM, 4-Jan-2006.)
theorem syl6eleq (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 B2) $ >
  $ wceq B2 C $ >
  $ wi ph (wcel A2 C) $;

--| A membership and equality inference. (Contributed by NM, 24-Apr-2005.)
theorem syl6eleqr (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 B2) $ >
  $ wceq C B2 $ >
  $ wi ph (wcel A2 C) $;

--| Substitution of equal classes into a membership antecedent. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem eleq2s (ph: wff) (A2 B2 C: class):
  $ wi (wcel A2 B2) ph $ >
  $ wceq C B2 $ >
  $ wi (wcel A2 C) ph $;

--| If a class is not an element of another class, an equal class is also not an element. Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem eqneltrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wn (wcel B2 C)) $ >
  $ wi ph (wn (wcel A2 C)) $;

--| If a class is not an element of another class, an equal class is also not an element. Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem eqneltrrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wn (wcel A2 C)) $ >
  $ wi ph (wn (wcel B2 C)) $;

--| If a class is not an element of another class, it is also not an element of an equal class. Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem neleqtrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wn (wcel C A2)) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wn (wcel C B2)) $;

--| If a class is not an element of another class, it is also not an element of an equal class. Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem neleqtrrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wn (wcel C B2)) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wn (wcel C A2)) $;

--| Establish equality between classes, using bound-variable hypotheses instead of distinct variable conditions. See also ~ cleqf . (Contributed by NM, 5-Aug-1993.)
theorem cleqh {x3 y1: setvar} (A2 B2: class x3):
  $ wi (wcel (cv y1) A2) (wal x3 (wcel (cv y1) A2)) $ >
  $ wi (wcel (cv y1) B2) (wal x3 (wcel (cv y1) B2)) $ >
  $ wb (wceq A2 B2) (wal x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| A way of showing two classes are not equal. (Contributed by NM, 1-Apr-1997.)
theorem nelneq (A2 B2 C: class):
  $ wi (wa (wcel A2 C) (wn (wcel B2 C))) (wn (wceq A2 B2)) $;

--| A way of showing two classes are not equal. (Contributed by NM, 12-Jan-2002.)
theorem nelneq2 (A2 B2 C: class):
  $ wi (wa (wcel A2 B2) (wn (wcel A2 C))) (wn (wceq B2 C)) $;

--| Lemma for ~ eqsb3 . (Contributed by Rodolfo Medina, 28-Apr-2010.) (Proof shortened by Andrew Salmon, 14-Jun-2011.)
theorem eqsb3lem {x3 y1: setvar} (A2: class x3):
  $ wb (wsb y1 x3 (wceq (cv y1) A2)) (wceq (cv x3) A2) $;

--| Substitution applied to an atomic wff (class version of ~ equsb3 ). (Contributed by Rodolfo Medina, 28-Apr-2010.)
theorem eqsb3 {x3 y1: setvar} (A2: class x3):
  $ wb (wsb y1 x3 (wceq (cv y1) A2)) (wceq (cv x3) A2) $;

--| Substitution applied to an atomic wff (class version of ~ elsb3 ). (Contributed by Rodolfo Medina, 28-Apr-2010.) (Proof shortened by Andrew Salmon, 14-Jun-2011.)
theorem clelsb3 {x3 y1: setvar} (A2: class x3):
  $ wb (wsb y1 x3 (wcel (cv y1) A2)) (wcel (cv x3) A2) $;

--| Substitution applied to an atomic wff (class version of ~ elsb4 ). (Contributed by Jim Kingdon, 22-Nov-2018.)
theorem clelsb4 {x3 y1: setvar} (A2: class x3):
  $ wb (wsb y1 x3 (wcel A2 (cv y1))) (wcel A2 (cv x3)) $;

--| A utility lemma to transfer a bound-variable hypothesis builder into a definition. See ~ hbxfrbi for equivalence version. (Contributed by NM, 21-Aug-2007.)
theorem hbxfreq {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wceq A2 B2 $ >
  $ wi (wcel (cv y1) B2) (wal x3 (wcel (cv y1) B2)) $ >
  $ wi (wcel (cv y1) A2) (wal x3 (wcel (cv y1) A2)) $;

--| Change the free variable of a hypothesis builder. (Contributed by NM, 5-Aug-1993.) (Revised by Andrew Salmon, 11-Jul-2011.)
theorem hblem {x3 y1 z: setvar} (A2: class x3 z):
  $ wi (wcel (cv y1) A2) (wal x3 (wcel (cv y1) A2)) $ >
  $ wi (wcel (cv z) A2) (wal x3 (wcel (cv z) A2)) $;

--| Equality of a class variable and a class abstraction (also called a class builder). Theorem 5.1 of [Quine] p. 34. This theorem shows the relationship between expressions with class abstractions and expressions with class variables. Note that ~ abbi and its relatives are among those useful for converting theorems with class variables to equivalent theorems with wff variables, by first substituting a class abstraction for each class variable. Class variables can always be eliminated from a theorem to result in an equivalent theorem with wff variables, and vice-versa. The idea is roughly as follows. To convert a theorem with a wff variable ` ph ` (that has a free variable ` x ` ) to a theorem with a class variable ` A ` , we substitute ` x e. A ` for ` ph ` throughout and simplify, where ` A ` is a new class variable not already in the wff. Conversely, to convert a theorem with a class variable ` A ` to one with ` ph ` , we substitute ` { x | ph } ` for ` A ` throughout and simplify, where ` x ` and ` ph ` are new set and wff variables not already in the wff. For more information on class variables, see Quine pp. 15-21 and/or Takeuti and Zaring pp. 10-13. (Contributed by NM, 5-Aug-1993.)
theorem abeq2 {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wceq A2 (cab x3 ph)) (wal x3 (wb (wcel (cv x3) A2) ph)) $;

--| Equality of a class variable and a class abstraction. (Contributed by NM, 20-Aug-1993.)
theorem abeq1 {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wceq (cab x3 ph) A2) (wal x3 (wb ph (wcel (cv x3) A2))) $;

--| Equality of a class variable and a class abstraction (inference rule). (Contributed by NM, 3-Apr-1996.)
theorem abeq2i {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wceq A2 (cab x3 ph) $ >
  $ wb (wcel (cv x3) A2) ph $;

--| Equality of a class variable and a class abstraction (inference rule). (Contributed by NM, 31-Jul-1994.)
theorem abeq1i {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wceq (cab x3 ph) A2 $ >
  $ wb ph (wcel (cv x3) A2) $;

--| Equality of a class variable and a class abstraction (deduction). (Contributed by NM, 16-Nov-1995.)
theorem abeq2d {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi ph (wceq A2 (cab x3 ps)) $ >
  $ wi ph (wb (wcel (cv x3) A2) ps) $;

--| Equivalent wff's correspond to equal class abstractions. (Contributed by NM, 25-Nov-2013.) (Revised by Mario Carneiro, 11-Aug-2016.)
theorem abbi {x3: setvar} (ph ps: wff x3):
  $ wb (wal x3 (wb ph ps)) (wceq (cab x3 ph) (cab x3 ps)) $;

--| Equality of a class variable and a class abstraction (inference rule). (Contributed by NM, 5-Aug-1993.)
theorem abbi2i {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wcel (cv x3) A2) ph $ >
  $ wceq A2 (cab x3 ph) $;

--| Equivalent wff's yield equal class abstractions (inference rule). (Contributed by NM, 5-Aug-1993.)
theorem abbii {x3: setvar} (ph ps: wff x3):
  $ wb ph ps $ >
  $ wceq (cab x3 ph) (cab x3 ps) $;

--| Equivalent wff's yield equal class abstractions (deduction rule). (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem abbid {x3: setvar} (ph ps ch: wff x3):
  $ wnf x3 ph $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (cab x3 ps) (cab x3 ch)) $;

--| Equivalent wff's yield equal class abstractions (deduction rule). (Contributed by NM, 10-Aug-1993.)
theorem abbidv {x3: setvar} (ph: wff) (ps ch: wff x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (cab x3 ps) (cab x3 ch)) $;

--| Deduction from a wff to a class abstraction. (Contributed by NM, 9-Jul-1994.)
theorem abbi2dv {x3: setvar} (ph: wff) (ps: wff x3) (A2: class):
  $ wi ph (wb (wcel (cv x3) A2) ps) $ >
  $ wi ph (wceq A2 (cab x3 ps)) $;

--| Deduction from a wff to a class abstraction. (Contributed by NM, 9-Jul-1994.)
theorem abbi1dv {x3: setvar} (ph: wff) (ps: wff x3) (A2: class):
  $ wi ph (wb ps (wcel (cv x3) A2)) $ >
  $ wi ph (wceq (cab x3 ps) A2) $;

--| A simplification of class abstraction. Theorem 5.2 of [Quine] p. 35. (Contributed by NM, 26-Dec-1993.)
theorem abid2 {x3: setvar} (A2: class):
  $ wceq (cab x3 (wcel (cv x3) A2)) A2 $;

--| Substitution of variable in class abstraction. (Contributed by Jim Kingdon, 27-Sep-2018.)
theorem sb8ab {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wceq (cab x3 ph) (cab y1 (wsb x3 y1 ph)) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by Andrew Salmon, 11-Jul-2011.)
theorem cbvab {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (cab x3 ph) (cab y1 ps) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by NM, 26-May-1999.)
theorem cbvabv {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (cab x3 ph) (cab y1 ps) $;

--| Membership of a class variable in a class abstraction. (Contributed by NM, 23-Dec-1993.)
theorem clelab {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wcel A2 (cab x3 ph)) (wex x3 (wa (wceq (cv x3) A2) ph)) $;

--| Membership of a class abstraction in another class. (Contributed by NM, 17-Jan-2006.)
theorem clabel {x3 y1: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wcel (cab x3 ph) A2) (wex y1 (wa (wcel (cv y1) A2) (wal x3 (wb (wcel (cv x3) (cv y1)) ph)))) $;

--| The right-hand side of the second equality is a way of representing proper substitution of ` y ` for ` x ` into a class variable. (Contributed by NM, 14-Sep-2003.)
theorem sbab {x3 y1 z: setvar} (A2: class x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 (cab z (wsb x3 y1 (wcel (cv z) A2)))) $;

--| Extend wff definition to include the not-free predicate for classes.
term wnfc {x3: setvar} (A2: class x3): wff;

--| Justification theorem for ~ df-nfc . (Contributed by Mario Carneiro, 13-Oct-2016.)
theorem nfcjust {x3 y1 z: setvar} (A2: class x3):
  $ wb (wal y1 (wnf x3 (wcel (cv y1) A2))) (wal z (wnf x3 (wcel (cv z) A2))) $;

--| Define the not-free predicate for classes. This is read " ` x ` is not free in ` A ` ". Not-free means that the value of ` x ` cannot affect the value of ` A ` , e.g., any occurrence of ` x ` in ` A ` is effectively bound by a quantifier or something that expands to one (such as "there exists at most one"). It is defined in terms of the not-free predicate ~ df-nf for wffs; see that definition for more information. (Contributed by Mario Carneiro, 11-Aug-2016.)
axiom df_nfc {x3 y1: setvar} (A2: class x3):
  $ wb (wnfc x3 A2) (wal y1 (wnf x3 (wcel (cv y1) A2))) $;

--| Deduce that a class ` A ` does not have ` x ` free in it. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfci {x3 y1: setvar} (A2: class x3):
  $ wnf x3 (wcel (cv y1) A2) $ >
  $ wnfc x3 A2 $;

--| Deduce that a class ` A ` does not have ` x ` free in it. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfcii {x3 y1: setvar} (A2: class x3):
  $ wi (wcel (cv y1) A2) (wal x3 (wcel (cv y1) A2)) $ >
  $ wnfc x3 A2 $;

--| Consequence of the not-free predicate. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfcr {x3 y1: setvar} (A2: class x3):
  $ wi (wnfc x3 A2) (wnf x3 (wcel (cv y1) A2)) $;

--| Consequence of the not-free predicate. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfcrii {x3 y1: setvar} (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wi (wcel (cv y1) A2) (wal x3 (wcel (cv y1) A2)) $;

--| Consequence of the not-free predicate. (Note that unlike ~ nfcr , this does not require ` y ` and ` A ` to be disjoint.) (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfcri {x3 y1: setvar} (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnf x3 (wcel (cv y1) A2) $;

--| Deduce that a class ` A ` does not have ` x ` free in it. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfcd {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wnf y1 ph $ >
  $ wi ph (wnf x3 (wcel (cv y1) A2)) $ >
  $ wi ph (wnfc x3 A2) $;

--| Equality theorem for class not-free. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfceqi {x3: setvar} (A2 B2: class x3):
  $ wceq A2 B2 $ >
  $ wb (wnfc x3 A2) (wnfc x3 B2) $;

--| A utility lemma to transfer a bound-variable hypothesis builder into a definition. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfcxfr {x3: setvar} (A2 B2: class x3):
  $ wceq A2 B2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 A2 $;

--| A utility lemma to transfer a bound-variable hypothesis builder into a definition. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfcxfrd {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wceq A2 B2 $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnfc x3 A2) $;

--| An equality theorem for effectively not free. (Contributed by Mario Carneiro, 14-Oct-2016.)
theorem nfceqdf {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wnfc x3 A2) (wnfc x3 B2)) $;

--| If ` x ` is disjoint from ` A ` , then ` x ` is not free in ` A ` . (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfcv {x3: setvar} (A2: class):
  $ wnfc x3 A2 $;

--| If ` x ` is disjoint from ` A ` , then ` x ` is not free in ` A ` . (Contributed by Mario Carneiro, 7-Oct-2016.)
theorem nfcvd {x3: setvar} (ph: wff x3) (A2: class):
  $ wi ph (wnfc x3 A2) $;

--| Bound-variable hypothesis builder for a class abstraction. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfab1 {x3: setvar} (ph: wff x3):
  $ wnfc x3 (cab x3 ph) $;

--| ` x ` is bound in ` F/_ x A ` . (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfnfc1 {x3: setvar} (A2: class x3):
  $ wnf x3 (wnfc x3 A2) $;

--| Bound-variable hypothesis builder for a class abstraction. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfab {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnfc x3 (cab y1 ph) $;

--| Bound-variable hypothesis builder for a class abstraction. (Contributed by Mario Carneiro, 14-Oct-2016.)
theorem nfaba1 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnfc x3 (cab y1 (wal x3 ph)) $;

--| Hypothesis builder for ` F/_ y A ` . (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfnfc {x3 y1: setvar} (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnf x3 (wnfc y1 A2) $;

--| Hypothesis builder for equality. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfeq {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wceq A2 B2) $;

--| Hypothesis builder for elementhood. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfel {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wcel A2 B2) $;

--| Hypothesis builder for equality, special case. (Contributed by Mario Carneiro, 10-Oct-2016.)
theorem nfeq1 {x3: setvar} (A2: class x3) (B2: class):
  $ wnfc x3 A2 $ >
  $ wnf x3 (wceq A2 B2) $;

--| Hypothesis builder for elementhood, special case. (Contributed by Mario Carneiro, 10-Oct-2016.)
theorem nfel1 {x3: setvar} (A2: class x3) (B2: class):
  $ wnfc x3 A2 $ >
  $ wnf x3 (wcel A2 B2) $;

--| Hypothesis builder for equality, special case. (Contributed by Mario Carneiro, 10-Oct-2016.)
theorem nfeq2 {x3: setvar} (A2: class) (B2: class x3):
  $ wnfc x3 B2 $ >
  $ wnf x3 (wceq A2 B2) $;

--| Hypothesis builder for elementhood, special case. (Contributed by Mario Carneiro, 10-Oct-2016.)
theorem nfel2 {x3: setvar} (A2: class) (B2: class x3):
  $ wnfc x3 B2 $ >
  $ wnf x3 (wcel A2 B2) $;

--| Consequence of the not-free predicate. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfcrd {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 (wcel (cv y1) A2)) $;

--| Hypothesis builder for equality. (Contributed by Mario Carneiro, 7-Oct-2016.)
theorem nfeqd {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnf x3 (wceq A2 B2)) $;

--| Hypothesis builder for elementhood. (Contributed by Mario Carneiro, 7-Oct-2016.)
theorem nfeld {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnf x3 (wcel A2 B2)) $;

--| Formula-building lemma for use with the Distinctor Reduction Theorem. (Contributed by Mario Carneiro, 8-Oct-2016.)
theorem drnfc1 {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wceq A2 B2) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wnfc x3 A2) (wnfc y1 B2)) $;

--| Formula-building lemma for use with the Distinctor Reduction Theorem. (Contributed by Mario Carneiro, 8-Oct-2016.)
theorem drnfc2 {x3 y1 z: setvar} (A2 B2: class x3 y1 z):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wceq A2 B2) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wnfc z A2) (wnfc z B2)) $;

--| Bound-variable hypothesis builder for a class abstraction. (Contributed by Mario Carneiro, 8-Oct-2016.)
theorem nfabd {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnfc x3 (cab y1 ps)) $;

--| Deduction form of ~ dvelimc . (Contributed by Mario Carneiro, 8-Oct-2016.)
theorem dvelimdc {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2 B2: class x3 y1 z):
  $ wnf x3 ph $ >
  $ wnf z ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc z B2) $ >
  $ wi ph (wi (wceq (cv z) (cv y1)) (wceq A2 B2)) $ >
  $ wi ph (wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wnfc x3 B2)) $;

--| Version of ~ dvelim for classes. (Contributed by Mario Carneiro, 8-Oct-2016.)
theorem dvelimc {x3 y1 z: setvar} (A2 B2: class x3 y1 z):
  $ wnfc x3 A2 $ >
  $ wnfc z B2 $ >
  $ wi (wceq (cv z) (cv y1)) (wceq A2 B2) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wnfc x3 B2) $;

--| If ` x ` and ` y ` are distinct, then ` x ` is not free in ` y ` . (Contributed by Mario Carneiro, 8-Oct-2016.)
theorem nfcvf {x3 y1: setvar}:
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wnfc x3 (cv y1)) $;

--| If ` x ` and ` y ` are distinct, then ` y ` is not free in ` x ` . (Contributed by Mario Carneiro, 5-Dec-2016.)
theorem nfcvf2 {x3 y1: setvar}:
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wnfc y1 (cv x3)) $;

--| Establish equality between classes, using bound-variable hypotheses instead of distinct variable conditions. See also ~ cleqh . (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem cleqf {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wb (wceq A2 B2) (wal x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| A simplification of class abstraction. Theorem 5.2 of [Quine] p. 35. (Contributed by NM, 5-Sep-2011.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem abid2f {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wceq (cab x3 (wcel (cv x3) A2)) A2 $;

--| Theorem to move a substitution in and out of a class abstraction. (Contributed by NM, 27-Sep-2003.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem sbabel {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class x3 y1 z):
  $ wnfc x3 A2 $ >
  $ wb (wsb x3 y1 (wcel (cab z ph) A2)) (wcel (cab z (wsb x3 y1 ph)) A2) $;

--| Extend wff notation to include inequality.
term wne (A2 B2: class): wff;

--| Extend wff notation to include negated membership.
term wnel (A2 B2: class): wff;

--| Define inequality. (Contributed by NM, 5-Aug-1993.)
axiom df_ne (A2 B2: class):
  $ wb (wne A2 B2) (wn (wceq A2 B2)) $;

--| Define negated membership. (Contributed by NM, 7-Aug-1994.)
axiom df_nel (A2 B2: class):
  $ wb (wnel A2 B2) (wn (wcel A2 B2)) $;

--| Inference associated with ~ df-ne . (Contributed by BJ, 7-Jul-2018.)
theorem neii (A2 B2: class):
  $ wne A2 B2 $ >
  $ wn (wceq A2 B2) $;

--| Inference associated with ~ df-ne . (Contributed by BJ, 7-Jul-2018.)
theorem neir (A2 B2: class):
  $ wn (wceq A2 B2) $ >
  $ wne A2 B2 $;

--| Negation of inequality. (Contributed by Jim Kingdon, 23-Dec-2018.)
theorem nner (A2 B2: class):
  $ wi (wceq A2 B2) (wn (wne A2 B2)) $;

--| Negation of inequality where equality is decidable. (Contributed by Jim Kingdon, 15-May-2018.)
theorem nnedc (A2 B2: class):
  $ wi (wdc (wceq A2 B2)) (wb (wn (wne A2 B2)) (wceq A2 B2)) $;

--| Decidable equality implies decidable negated equality. (Contributed by Jim Kingdon, 3-May-2020.)
theorem dcned (ph: wff) (A2 B2: class):
  $ wi ph (wdc (wceq A2 B2)) $ >
  $ wi ph (wdc (wne A2 B2)) $;

--| If it is not the case that two classes are equal, they are unequal. Converse of ~ neneqd . One-way deduction form of ~ df-ne . (Contributed by David Moews, 28-Feb-2017.) Allow a shortening of ~ necon3bi . (Revised by Wolf Lammen, 22-Nov-2019.)
theorem neqned (ph: wff) (A2 B2: class):
  $ wi ph (wn (wceq A2 B2)) $ >
  $ wi ph (wne A2 B2) $;

--| From non equality to inequality. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem neqne (A2 B2: class):
  $ wi (wn (wceq A2 B2)) (wne A2 B2) $;

--| No class is unequal to itself. (Contributed by Stefan O'Rear, 1-Jan-2015.) (Proof rewritten by Jim Kingdon, 15-May-2018.)
theorem neirr (A2: class):
  $ wn (wne A2 A2) $;

--| Decidable equality expressed in terms of ` =/= ` . Basically the same as ~ df-dc . (Contributed by Jim Kingdon, 14-Mar-2020.)
theorem dcne (A2 B2: class):
  $ wb (wdc (wceq A2 B2)) (wo (wceq A2 B2) (wne A2 B2)) $;

--| Law of noncontradiction with equality and inequality. (Contributed by NM, 3-Feb-2012.)
theorem nonconne (A2 B2: class):
  $ wn (wa (wceq A2 B2) (wne A2 B2)) $;

--| Equality theorem for inequality. (Contributed by NM, 19-Nov-1994.)
theorem neeq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wne A2 C) (wne B2 C)) $;

--| Equality theorem for inequality. (Contributed by NM, 19-Nov-1994.)
theorem neeq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wne C A2) (wne C B2)) $;

--| Inference for inequality. (Contributed by NM, 29-Apr-2005.)
theorem neeq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wb (wne A2 C) (wne B2 C) $;

--| Inference for inequality. (Contributed by NM, 29-Apr-2005.)
theorem neeq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wb (wne C A2) (wne C B2) $;

--| Inference for inequality. (Contributed by NM, 24-Jul-2012.)
theorem neeq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wb (wne A2 C) (wne B2 D) $;

--| Deduction for inequality. (Contributed by NM, 25-Oct-1999.)
theorem neeq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wne A2 C) (wne B2 C)) $;

--| Deduction for inequality. (Contributed by NM, 25-Oct-1999.)
theorem neeq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wne C A2) (wne C B2)) $;

--| Deduction for inequality. (Contributed by NM, 24-Jul-2012.)
theorem neeq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wne A2 C) (wne B2 D)) $;

--| Deduction eliminating inequality definition. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem neneqd (ph: wff) (A2 B2: class):
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wn (wceq A2 B2)) $;

--| From inequality to non equality. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem neneq (A2 B2: class):
  $ wi (wne A2 B2) (wn (wceq A2 B2)) $;

--| Substitution of equal classes into an inequality. (Contributed by NM, 4-Jul-2012.)
theorem eqnetri (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wne B2 C $ >
  $ wne A2 C $;

--| Substitution of equal classes into an inequality. (Contributed by NM, 4-Jul-2012.)
theorem eqnetrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wne A2 C) $;

--| Substitution of equal classes into an inequality. (Contributed by NM, 4-Jul-2012.)
theorem eqnetrri (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wne A2 C $ >
  $ wne B2 C $;

--| Substitution of equal classes into an inequality. (Contributed by NM, 4-Jul-2012.)
theorem eqnetrrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wne A2 C) $ >
  $ wi ph (wne B2 C) $;

--| Substitution of equal classes into an inequality. (Contributed by NM, 4-Jul-2012.)
theorem neeqtri (A2 B2 C: class):
  $ wne A2 B2 $ >
  $ wceq B2 C $ >
  $ wne A2 C $;

--| Substitution of equal classes into an inequality. (Contributed by NM, 4-Jul-2012.)
theorem neeqtrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wne A2 C) $;

--| Substitution of equal classes into an inequality. (Contributed by NM, 4-Jul-2012.)
theorem neeqtrri (A2 B2 C: class):
  $ wne A2 B2 $ >
  $ wceq C B2 $ >
  $ wne A2 C $;

--| Substitution of equal classes into an inequality. (Contributed by NM, 4-Jul-2012.)
theorem neeqtrrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wceq C B2) $ >
  $ wi ph (wne A2 C) $;

--| B chained equality inference for inequality. (Contributed by NM, 6-Jun-2012.)
theorem syl5eqner (ph: wff) (A2 B2 C: class):
  $ wceq B2 A2 $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wne A2 C) $;

--| Substitution of equality into both sides of an inequality. (Contributed by NM, 24-Jul-2012.)
theorem _3netr3d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wne C D) $;

--| Substitution of equality into both sides of an inequality. (Contributed by NM, 24-Jul-2012.)
theorem _3netr4d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wceq C A2) $ >
  $ wi ph (wceq D B2) $ >
  $ wi ph (wne C D) $;

--| Substitution of equality into both sides of an inequality. (Contributed by NM, 24-Jul-2012.)
theorem _3netr3g (ph: wff) (A2 B2 C D: class):
  $ wi ph (wne A2 B2) $ >
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wi ph (wne C D) $;

--| Substitution of equality into both sides of an inequality. (Contributed by NM, 14-Jun-2012.)
theorem _3netr4g (ph: wff) (A2 B2 C D: class):
  $ wi ph (wne A2 B2) $ >
  $ wceq C A2 $ >
  $ wceq D B2 $ >
  $ wi ph (wne C D) $;

--| Deduction from equality to inequality. (Contributed by NM, 9-Nov-2007.)
theorem necon3abii (ph: wff) (A2 B2: class):
  $ wb (wceq A2 B2) ph $ >
  $ wb (wne A2 B2) (wn ph) $;

--| Deduction from equality to inequality. (Contributed by NM, 13-Apr-2007.)
theorem necon3bbii (ph: wff) (A2 B2: class):
  $ wb ph (wceq A2 B2) $ >
  $ wb (wn ph) (wne A2 B2) $;

--| Inference from equality to inequality. (Contributed by NM, 23-Feb-2005.)
theorem necon3bii (A2 B2 C D: class):
  $ wb (wceq A2 B2) (wceq C D) $ >
  $ wb (wne A2 B2) (wne C D) $;

--| Deduction from equality to inequality. (Contributed by NM, 21-Mar-2007.)
theorem necon3abid (ph ps: wff) (A2 B2: class):
  $ wi ph (wb (wceq A2 B2) ps) $ >
  $ wi ph (wb (wne A2 B2) (wn ps)) $;

--| Deduction from equality to inequality. (Contributed by NM, 2-Jun-2007.)
theorem necon3bbid (ph ps: wff) (A2 B2: class):
  $ wi ph (wb ps (wceq A2 B2)) $ >
  $ wi ph (wb (wn ps) (wne A2 B2)) $;

--| Deduction from equality to inequality. (Contributed by NM, 23-Feb-2005.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem necon3bid (ph: wff) (A2 B2 C D: class):
  $ wi ph (wb (wceq A2 B2) (wceq C D)) $ >
  $ wi ph (wb (wne A2 B2) (wne C D)) $;

--| Contrapositive law deduction for inequality. (Contributed by NM, 2-Apr-2007.) (Proof rewritten by Jim Kingdon, 15-May-2018.)
theorem necon3ad (ph ps: wff) (A2 B2: class):
  $ wi ph (wi ps (wceq A2 B2)) $ >
  $ wi ph (wi (wne A2 B2) (wn ps)) $;

--| Contrapositive law deduction for inequality. (Contributed by NM, 2-Apr-2007.) (Proof rewritten by Jim Kingdon, 15-May-2018.)
theorem necon3bd (ph ps: wff) (A2 B2: class):
  $ wi ph (wi (wceq A2 B2) ps) $ >
  $ wi ph (wi (wn ps) (wne A2 B2)) $;

--| Contrapositive law deduction for inequality. (Contributed by NM, 10-Jun-2006.)
theorem necon3d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wi (wceq A2 B2) (wceq C D)) $ >
  $ wi ph (wi (wne C D) (wne A2 B2)) $;

--| Characterization of inequality in terms of reversed equality (see ~ bicom ). (Contributed by BJ, 7-Jul-2018.)
theorem nesym (A2 B2: class):
  $ wb (wne A2 B2) (wn (wceq B2 A2)) $;

--| Inference associated with ~ nesym . (Contributed by BJ, 7-Jul-2018.)
theorem nesymi (A2 B2: class):
  $ wne A2 B2 $ >
  $ wn (wceq B2 A2) $;

--| Inference associated with ~ nesym . (Contributed by BJ, 7-Jul-2018.)
theorem nesymir (A2 B2: class):
  $ wn (wceq A2 B2) $ >
  $ wne B2 A2 $;

--| Contrapositive inference for inequality. (Contributed by NM, 9-Aug-2006.)
theorem necon3i (A2 B2 C D: class):
  $ wi (wceq A2 B2) (wceq C D) $ >
  $ wi (wne C D) (wne A2 B2) $;

--| Contrapositive inference for inequality. (Contributed by NM, 23-May-2007.) (Proof rewritten by Jim Kingdon, 15-May-2018.)
theorem necon3ai (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi (wne A2 B2) (wn ph) $;

--| Contrapositive inference for inequality. (Contributed by NM, 1-Jun-2007.) (Proof rewritten by Jim Kingdon, 15-May-2018.)
theorem necon3bi (ph: wff) (A2 B2: class):
  $ wi (wceq A2 B2) ph $ >
  $ wi (wn ph) (wne A2 B2) $;

--| Contrapositive inference for inequality. (Contributed by Jim Kingdon, 15-May-2018.)
theorem necon1aidc (ph: wff) (A2 B2: class):
  $ wi (wdc ph) (wi (wn ph) (wceq A2 B2)) $ >
  $ wi (wdc ph) (wi (wne A2 B2) ph) $;

--| Contrapositive inference for inequality. (Contributed by Jim Kingdon, 15-May-2018.)
theorem necon1bidc (ph: wff) (A2 B2: class):
  $ wi (wdc (wceq A2 B2)) (wi (wne A2 B2) ph) $ >
  $ wi (wdc (wceq A2 B2)) (wi (wn ph) (wceq A2 B2)) $;

--| Contrapositive inference for inequality. (Contributed by Jim Kingdon, 16-May-2018.)
theorem necon1idc (A2 B2 C D: class):
  $ wi (wne A2 B2) (wceq C D) $ >
  $ wi (wdc (wceq A2 B2)) (wi (wne C D) (wceq A2 B2)) $;

--| Contrapositive inference for inequality. (Contributed by NM, 16-Jan-2007.) (Proof rewritten by Jim Kingdon, 16-May-2018.)
theorem necon2ai (ph: wff) (A2 B2: class):
  $ wi (wceq A2 B2) (wn ph) $ >
  $ wi ph (wne A2 B2) $;

--| Contrapositive inference for inequality. (Contributed by NM, 1-Apr-2007.)
theorem necon2bi (ph: wff) (A2 B2: class):
  $ wi ph (wne A2 B2) $ >
  $ wi (wceq A2 B2) (wn ph) $;

--| Contrapositive inference for inequality. (Contributed by NM, 18-Mar-2007.)
theorem necon2i (A2 B2 C D: class):
  $ wi (wceq A2 B2) (wne C D) $ >
  $ wi (wceq C D) (wne A2 B2) $;

--| Contrapositive inference for inequality. (Contributed by NM, 19-Apr-2007.) (Proof rewritten by Jim Kingdon, 16-May-2018.)
theorem necon2ad (ph ps: wff) (A2 B2: class):
  $ wi ph (wi (wceq A2 B2) (wn ps)) $ >
  $ wi ph (wi ps (wne A2 B2)) $;

--| Contrapositive inference for inequality. (Contributed by NM, 13-Apr-2007.)
theorem necon2bd (ph ps: wff) (A2 B2: class):
  $ wi ph (wi ps (wne A2 B2)) $ >
  $ wi ph (wi (wceq A2 B2) (wn ps)) $;

--| Contrapositive inference for inequality. (Contributed by NM, 28-Dec-2008.)
theorem necon2d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wi (wceq A2 B2) (wne C D)) $ >
  $ wi ph (wi (wceq C D) (wne A2 B2)) $;

--| Contrapositive inference for inequality. (Contributed by Jim Kingdon, 16-May-2018.)
theorem necon1abiidc (ph: wff) (A2 B2: class):
  $ wi (wdc ph) (wb (wn ph) (wceq A2 B2)) $ >
  $ wi (wdc ph) (wb (wne A2 B2) ph) $;

--| Contrapositive inference for inequality. (Contributed by Jim Kingdon, 16-May-2018.)
theorem necon1bbiidc (ph: wff) (A2 B2: class):
  $ wi (wdc (wceq A2 B2)) (wb (wne A2 B2) ph) $ >
  $ wi (wdc (wceq A2 B2)) (wb (wn ph) (wceq A2 B2)) $;

--| Contrapositive deduction for inequality. (Contributed by Jim Kingdon, 16-May-2018.)
theorem necon1abiddc (ph ps: wff) (A2 B2: class):
  $ wi ph (wi (wdc ps) (wb (wn ps) (wceq A2 B2))) $ >
  $ wi ph (wi (wdc ps) (wb (wne A2 B2) ps)) $;

--| Contrapositive inference for inequality. (Contributed by Jim Kingdon, 16-May-2018.)
theorem necon1bbiddc (ph ps: wff) (A2 B2: class):
  $ wi ph (wi (wdc (wceq A2 B2)) (wb (wne A2 B2) ps)) $ >
  $ wi ph (wi (wdc (wceq A2 B2)) (wb (wn ps) (wceq A2 B2))) $;

--| Contrapositive inference for inequality. (Contributed by Jim Kingdon, 16-May-2018.)
theorem necon2abiidc (ph: wff) (A2 B2: class):
  $ wi (wdc ph) (wb (wceq A2 B2) (wn ph)) $ >
  $ wi (wdc ph) (wb ph (wne A2 B2)) $;

--| Contrapositive inference for inequality. (Contributed by Jim Kingdon, 16-May-2018.)
theorem necon2bbii (ph: wff) (A2 B2: class):
  $ wi (wdc (wceq A2 B2)) (wb ph (wne A2 B2)) $ >
  $ wi (wdc (wceq A2 B2)) (wb (wceq A2 B2) (wn ph)) $;

--| Contrapositive deduction for inequality. (Contributed by Jim Kingdon, 16-May-2018.)
theorem necon2abiddc (ph ps: wff) (A2 B2: class):
  $ wi ph (wi (wdc ps) (wb (wceq A2 B2) (wn ps))) $ >
  $ wi ph (wi (wdc ps) (wb ps (wne A2 B2))) $;

--| Contrapositive deduction for inequality. (Contributed by Jim Kingdon, 16-May-2018.)
theorem necon2bbiddc (ph ps: wff) (A2 B2: class):
  $ wi ph (wi (wdc (wceq A2 B2)) (wb ps (wne A2 B2))) $ >
  $ wi ph (wi (wdc (wceq A2 B2)) (wb (wceq A2 B2) (wn ps))) $;

--| Contrapositive inference for inequality. (Contributed by Jim Kingdon, 16-May-2018.)
theorem necon4aidc (ph: wff) (A2 B2: class):
  $ wi (wdc (wceq A2 B2)) (wi (wne A2 B2) (wn ph)) $ >
  $ wi (wdc (wceq A2 B2)) (wi ph (wceq A2 B2)) $;

--| Contrapositive inference for inequality. (Contributed by Jim Kingdon, 16-May-2018.)
theorem necon4idc (A2 B2 C D: class):
  $ wi (wdc (wceq A2 B2)) (wi (wne A2 B2) (wne C D)) $ >
  $ wi (wdc (wceq A2 B2)) (wi (wceq C D) (wceq A2 B2)) $;

--| Contrapositive inference for inequality. (Contributed by Jim Kingdon, 17-May-2018.)
theorem necon4addc (ph ps: wff) (A2 B2: class):
  $ wi ph (wi (wdc (wceq A2 B2)) (wi (wne A2 B2) (wn ps))) $ >
  $ wi ph (wi (wdc (wceq A2 B2)) (wi ps (wceq A2 B2))) $;

--| Contrapositive inference for inequality. (Contributed by Jim Kingdon, 17-May-2018.)
theorem necon4bddc (ph ps: wff) (A2 B2: class):
  $ wi ph (wi (wdc ps) (wi (wn ps) (wne A2 B2))) $ >
  $ wi ph (wi (wdc ps) (wi (wceq A2 B2) ps)) $;

--| Contrapositive inference for inequality. (Contributed by Jim Kingdon, 17-May-2018.)
theorem necon4ddc (ph: wff) (A2 B2 C D: class):
  $ wi ph (wi (wdc (wceq A2 B2)) (wi (wne A2 B2) (wne C D))) $ >
  $ wi ph (wi (wdc (wceq A2 B2)) (wi (wceq C D) (wceq A2 B2))) $;

--| Contrapositive law deduction for inequality. (Contributed by Jim Kingdon, 18-May-2018.)
theorem necon4abiddc (ph ps: wff) (A2 B2: class):
  $ wi ph (wi (wdc (wceq A2 B2)) (wi (wdc ps) (wb (wne A2 B2) (wn ps)))) $ >
  $ wi ph (wi (wdc (wceq A2 B2)) (wi (wdc ps) (wb (wceq A2 B2) ps))) $;

--| Contrapositive law deduction for inequality. (Contributed by Jim Kingdon, 19-May-2018.)
theorem necon4bbiddc (ph ps: wff) (A2 B2: class):
  $ wi ph (wi (wdc ps) (wi (wdc (wceq A2 B2)) (wb (wn ps) (wne A2 B2)))) $ >
  $ wi ph (wi (wdc ps) (wi (wdc (wceq A2 B2)) (wb ps (wceq A2 B2)))) $;

--| Contrapositive law deduction for inequality. (Contributed by Jim Kingdon, 19-May-2018.)
theorem necon4biddc (ph: wff) (A2 B2 C D: class):
  $ wi ph (wi (wdc (wceq A2 B2)) (wi (wdc (wceq C D)) (wb (wne A2 B2) (wne C D)))) $ >
  $ wi ph (wi (wdc (wceq A2 B2)) (wi (wdc (wceq C D)) (wb (wceq A2 B2) (wceq C D)))) $;

--| Contrapositive deduction for inequality. (Contributed by Jim Kingdon, 19-May-2018.)
theorem necon1addc (ph ps: wff) (A2 B2: class):
  $ wi ph (wi (wdc ps) (wi (wn ps) (wceq A2 B2))) $ >
  $ wi ph (wi (wdc ps) (wi (wne A2 B2) ps)) $;

--| Contrapositive deduction for inequality. (Contributed by Jim Kingdon, 19-May-2018.)
theorem necon1bddc (ph ps: wff) (A2 B2: class):
  $ wi ph (wi (wdc (wceq A2 B2)) (wi (wne A2 B2) ps)) $ >
  $ wi ph (wi (wdc (wceq A2 B2)) (wi (wn ps) (wceq A2 B2))) $;

--| Contrapositive law deduction for inequality. (Contributed by Jim Kingdon, 19-May-2018.)
theorem necon1ddc (ph: wff) (A2 B2 C D: class):
  $ wi ph (wi (wdc (wceq A2 B2)) (wi (wne A2 B2) (wceq C D))) $ >
  $ wi ph (wi (wdc (wceq A2 B2)) (wi (wne C D) (wceq A2 B2))) $;

--| If it is not the case that two classes are equal, they are unequal. Converse of ~ neneqd . One-way deduction form of ~ df-ne . (Contributed by David Moews, 28-Feb-2017.)
theorem neneqad (ph: wff) (A2 B2: class):
  $ wi ph (wn (wceq A2 B2)) $ >
  $ wi ph (wne A2 B2) $;

--| Contraposition law for inequality. (Contributed by Jim Kingdon, 19-May-2018.)
theorem nebidc (A2 B2 C D: class):
  $ wi (wdc (wceq A2 B2)) (wi (wdc (wceq C D)) (wb (wb (wceq A2 B2) (wceq C D)) (wb (wne A2 B2) (wne C D)))) $;

--| Theorem *13.18 in [WhiteheadRussell] p. 178. (Contributed by Andrew Salmon, 3-Jun-2011.)
theorem pm13_18 (A2 B2 C: class):
  $ wi (wa (wceq A2 B2) (wne A2 C)) (wne B2 C) $;

--| Theorem *13.181 in [WhiteheadRussell] p. 178. (Contributed by Andrew Salmon, 3-Jun-2011.)
theorem pm13_181 (A2 B2 C: class):
  $ wi (wa (wceq A2 B2) (wne B2 C)) (wne A2 C) $;

--| A contradiction implies anything. Equality/inequality deduction form. (Contributed by David Moews, 28-Feb-2017.)
theorem pm2_21ddne (ph ps: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph ps $;

--| Commutation of inequality. (Contributed by NM, 14-May-1999.)
theorem necom (A2 B2: class):
  $ wb (wne A2 B2) (wne B2 A2) $;

--| Inference from commutative law for inequality. (Contributed by NM, 17-Oct-2012.)
theorem necomi (A2 B2: class):
  $ wne A2 B2 $ >
  $ wne B2 A2 $;

--| Deduction from commutative law for inequality. (Contributed by NM, 12-Feb-2008.)
theorem necomd (ph: wff) (A2 B2: class):
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne B2 A2) $;

--| A De Morgan's law for inequality. (Contributed by NM, 18-May-2007.)
theorem neanior (A2 B2 C D: class):
  $ wb (wa (wne A2 B2) (wne C D)) (wn (wo (wceq A2 B2) (wceq C D))) $;

--| A De Morgan's law for inequality. (Contributed by NM, 30-Sep-2013.) (Proof rewritten by Jim Kingdon, 19-May-2018.)
theorem ne3anior (A2 B2 C D E F: class):
  $ wb (w3a (wne A2 B2) (wne C D) (wne E F)) (wn (w3o (wceq A2 B2) (wceq C D) (wceq E F))) $;

--| An inference from an inequality, related to modus tollens. (Contributed by NM, 13-Apr-2007.)
theorem nemtbir (ph: wff) (A2 B2: class):
  $ wne A2 B2 $ >
  $ wb ph (wceq A2 B2) $ >
  $ wn ph $;

--| Two classes are different if they don't contain the same element. (Contributed by NM, 3-Feb-2012.)
theorem nelne1 (A2 B2 C: class):
  $ wi (wa (wcel A2 B2) (wn (wcel A2 C))) (wne B2 C) $;

--| Two classes are different if they don't belong to the same class. (Contributed by NM, 25-Jun-2012.)
theorem nelne2 (A2 B2 C: class):
  $ wi (wa (wcel A2 C) (wn (wcel B2 C))) (wne A2 B2) $;

--| Bound-variable hypothesis builder for inequality. (Contributed by NM, 10-Nov-2007.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem nfne {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wne A2 B2) $;

--| Bound-variable hypothesis builder for inequality. (Contributed by NM, 10-Nov-2007.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem nfned {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnf x3 (wne A2 B2)) $;

--| Inference associated with ~ df-nel . (Contributed by BJ, 7-Jul-2018.)
theorem neli (A2 B2: class):
  $ wnel A2 B2 $ >
  $ wn (wcel A2 B2) $;

--| Inference associated with ~ df-nel . (Contributed by BJ, 7-Jul-2018.)
theorem nelir (A2 B2: class):
  $ wn (wcel A2 B2) $ >
  $ wnel A2 B2 $;

--| Equality theorem for negated membership. (Contributed by NM, 20-Nov-1994.)
theorem neleq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wnel A2 C) (wnel B2 C)) $;

--| Equality theorem for negated membership. (Contributed by NM, 20-Nov-1994.)
theorem neleq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wnel C A2) (wnel C B2)) $;

--| Equality theorem for negated membership. (Contributed by FL, 10-Aug-2016.)
theorem neleq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wnel A2 C) (wnel B2 D)) $;

--| Bound-variable hypothesis builder for negated membership. (Contributed by David Abernethy, 26-Jun-2011.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem nfnel {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wnel A2 B2) $;

--| Bound-variable hypothesis builder for negated membership. (Contributed by David Abernethy, 26-Jun-2011.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem nfneld {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnf x3 (wnel A2 B2)) $;

--| Extend wff notation to include restricted universal quantification.
term wral {x3: setvar} (ph: wff x3) (A2: class x3): wff;

--| Extend wff notation to include restricted existential quantification.
term wrex {x3: setvar} (ph: wff x3) (A2: class x3): wff;

--| Extend wff notation to include restricted existential uniqueness.
term wreu {x3: setvar} (ph: wff x3) (A2: class x3): wff;

--| Extend wff notation to include restricted "at most one."
term wrmo {x3: setvar} (ph: wff x3) (A2: class x3): wff;

--| Extend class notation to include the restricted class abstraction (class builder).
term crab {x3: setvar} (ph: wff x3) (A2: class x3): class;

--| Define restricted universal quantification. Special case of Definition 4.15(3) of [TakeutiZaring] p. 22. (Contributed by NM, 19-Aug-1993.)
axiom df_ral {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wral x3 ph A2) (wal x3 (wi (wcel (cv x3) A2) ph)) $;

--| Define restricted existential quantification. Special case of Definition 4.15(4) of [TakeutiZaring] p. 22. (Contributed by NM, 30-Aug-1993.)
axiom df_rex {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wrex x3 ph A2) (wex x3 (wa (wcel (cv x3) A2) ph)) $;

--| Define restricted existential uniqueness. (Contributed by NM, 22-Nov-1994.)
axiom df_reu {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wreu x3 ph A2) (weu x3 (wa (wcel (cv x3) A2) ph)) $;

--| Define restricted "at most one". (Contributed by NM, 16-Jun-2017.)
axiom df_rmo {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wrmo x3 ph A2) (wmo x3 (wa (wcel (cv x3) A2) ph)) $;

--| Define a restricted class abstraction (class builder), which is the class of all ` x ` in ` A ` such that ` ph ` is true. Definition of [TakeutiZaring] p. 20. (Contributed by NM, 22-Nov-1994.)
axiom df_rab {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wceq (crab x3 ph A2) (cab x3 (wa (wcel (cv x3) A2) ph)) $;

--| Relationship between restricted universal and existential quantifiers. (Contributed by NM, 21-Jan-1997.)
theorem ralnex {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wral x3 (wn ph) A2) (wn (wrex x3 ph A2)) $;

--| Relationship between restricted universal and existential quantifiers. In classical logic this would be a biconditional. (Contributed by Jim Kingdon, 17-Aug-2018.)
theorem rexnalim {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wrex x3 (wn ph) A2) (wn (wral x3 ph A2)) $;

--| Relationship between restricted universal and existential quantifiers. (Contributed by Jim Kingdon, 17-Aug-2018.)
theorem ralexim {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wral x3 ph A2) (wn (wrex x3 (wn ph) A2)) $;

--| Relationship between restricted universal and existential quantifiers. (Contributed by Jim Kingdon, 17-Aug-2018.)
theorem rexalim {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wrex x3 ph A2) (wn (wral x3 (wn ph) A2)) $;

--| Formula-building rule for restricted universal quantifier (deduction rule). (Contributed by NM, 6-Oct-2003.)
theorem ralbida {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ch A2)) $;

--| Formula-building rule for restricted existential quantifier (deduction rule). (Contributed by NM, 6-Oct-2003.)
theorem rexbida {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Formula-building rule for restricted universal quantifier (deduction rule). (Contributed by NM, 4-Mar-1997.)
theorem ralbidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ch A2)) $;

--| Formula-building rule for restricted existential quantifier (deduction rule). (Contributed by NM, 9-Mar-1997.)
theorem rexbidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Formula-building rule for restricted universal quantifier (deduction rule). (Contributed by NM, 27-Jun-1998.)
theorem ralbid {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ch A2)) $;

--| Formula-building rule for restricted existential quantifier (deduction rule). (Contributed by NM, 27-Jun-1998.)
theorem rexbid {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Formula-building rule for restricted universal quantifier (deduction rule). (Contributed by NM, 20-Nov-1994.)
theorem ralbidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ch A2)) $;

--| Formula-building rule for restricted existential quantifier (deduction rule). (Contributed by NM, 20-Nov-1994.)
theorem rexbidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Formula-building rule for restricted universal quantifier (deduction rule). (Contributed by NM, 6-Apr-1997.)
theorem ralbidv2 {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wb (wi (wcel (cv x3) A2) ps) (wi (wcel (cv x3) B2) ch)) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ch B2)) $;

--| Formula-building rule for restricted existential quantifier (deduction rule). (Contributed by NM, 22-May-1999.)
theorem rexbidv2 {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wb (wa (wcel (cv x3) A2) ps) (wa (wcel (cv x3) B2) ch)) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ch B2)) $;

--| Inference adding restricted universal quantifier to both sides of an equivalence. (Contributed by NM, 23-Nov-1994.) (Revised by Mario Carneiro, 17-Oct-2016.)
theorem ralbii {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb ph ps $ >
  $ wb (wral x3 ph A2) (wral x3 ps A2) $;

--| Inference adding restricted existential quantifier to both sides of an equivalence. (Contributed by NM, 23-Nov-1994.) (Revised by Mario Carneiro, 17-Oct-2016.)
theorem rexbii {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb ph ps $ >
  $ wb (wrex x3 ph A2) (wrex x3 ps A2) $;

--| Inference adding two restricted universal quantifiers to both sides of an equivalence. (Contributed by NM, 1-Aug-2004.)
theorem _2ralbii {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wb ph ps $ >
  $ wb (wral x3 (wral y1 ph B2) A2) (wral x3 (wral y1 ps B2) A2) $;

--| Inference adding two restricted existential quantifiers to both sides of an equivalence. (Contributed by NM, 11-Nov-1995.)
theorem _2rexbii {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wb ph ps $ >
  $ wb (wrex x3 (wrex y1 ph B2) A2) (wrex x3 (wrex y1 ps B2) A2) $;

--| Inference adding different restricted universal quantifiers to each side of an equivalence. (Contributed by NM, 15-Aug-2005.)
theorem ralbii2 {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wb (wi (wcel (cv x3) A2) ph) (wi (wcel (cv x3) B2) ps) $ >
  $ wb (wral x3 ph A2) (wral x3 ps B2) $;

--| Inference adding different restricted existential quantifiers to each side of an equivalence. (Contributed by NM, 4-Feb-2004.)
theorem rexbii2 {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wb (wa (wcel (cv x3) A2) ph) (wa (wcel (cv x3) B2) ps) $ >
  $ wb (wrex x3 ph A2) (wrex x3 ps B2) $;

--| Equality deduction for restricted universal quantifier, changing both formula and quantifier domain. Inference form. (Contributed by David Moews, 1-May-2017.)
theorem raleqbii {x3: setvar} (ps ch: wff x3) (A2 B2: class x3):
  $ wceq A2 B2 $ >
  $ wb ps ch $ >
  $ wb (wral x3 ps A2) (wral x3 ch B2) $;

--| Equality deduction for restricted existential quantifier, changing both formula and quantifier domain. Inference form. (Contributed by David Moews, 1-May-2017.)
theorem rexeqbii {x3: setvar} (ps ch: wff x3) (A2 B2: class x3):
  $ wceq A2 B2 $ >
  $ wb ps ch $ >
  $ wb (wrex x3 ps A2) (wrex x3 ch B2) $;

--| Inference adding restricted universal quantifier to both sides of an equivalence. (Contributed by NM, 26-Nov-2000.)
theorem ralbiia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wb ph ps) $ >
  $ wb (wral x3 ph A2) (wral x3 ps A2) $;

--| Inference adding restricted existential quantifier to both sides of an equivalence. (Contributed by NM, 26-Oct-1999.)
theorem rexbiia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wb ph ps) $ >
  $ wb (wrex x3 ph A2) (wrex x3 ps A2) $;

--| Inference adding two restricted existential quantifiers to both sides of an equivalence. (Contributed by NM, 1-Aug-2004.)
theorem _2rexbiia {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wb ph ps) $ >
  $ wb (wrex x3 (wrex y1 ph B2) A2) (wrex x3 (wrex y1 ps B2) A2) $;

--| Double restricted universal quantification. (Contributed by Mario Carneiro, 14-Oct-2016.)
theorem r2alf {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wb (wral x3 (wral y1 ph B2) A2) (wal x3 (wal y1 (wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph))) $;

--| Double restricted existential quantification. (Contributed by Mario Carneiro, 14-Oct-2016.)
theorem r2exf {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wb (wrex x3 (wrex y1 ph B2) A2) (wex x3 (wex y1 (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph))) $;

--| Double restricted universal quantification. (Contributed by NM, 19-Nov-1995.)
theorem r2al {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wb (wral x3 (wral y1 ph B2) A2) (wal x3 (wal y1 (wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph))) $;

--| Double restricted existential quantification. (Contributed by NM, 11-Nov-1995.)
theorem r2ex {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wb (wrex x3 (wrex y1 ph B2) A2) (wex x3 (wex y1 (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph))) $;

--| Formula-building rule for restricted universal quantifier (deduction rule). (Contributed by NM, 24-Feb-2004.)
theorem _2ralbida {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wb ps ch) $ >
  $ wi ph (wb (wral x3 (wral y1 ps B2) A2) (wral x3 (wral y1 ch B2) A2)) $;

--| Formula-building rule for restricted universal quantifiers (deduction rule). (Contributed by NM, 4-Mar-1997.)
theorem _2ralbidva {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wb ps ch) $ >
  $ wi ph (wb (wral x3 (wral y1 ps B2) A2) (wral x3 (wral y1 ch B2) A2)) $;

--| Formula-building rule for restricted existential quantifiers (deduction rule). (Contributed by NM, 15-Dec-2004.)
theorem _2rexbidva {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 (wrex y1 ps B2) A2) (wrex x3 (wrex y1 ch B2) A2)) $;

--| Formula-building rule for restricted universal quantifiers (deduction rule). (Contributed by NM, 28-Jan-2006.) (Revised by Szymon Jaroszewicz, 16-Mar-2007.)
theorem _2ralbidv {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1) (A2 B2: class x3 y1):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wral x3 (wral y1 ps B2) A2) (wral x3 (wral y1 ch B2) A2)) $;

--| Formula-building rule for restricted existential quantifiers (deduction rule). (Contributed by NM, 28-Jan-2006.)
theorem _2rexbidv {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1) (A2 B2: class x3 y1):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wrex x3 (wrex y1 ps B2) A2) (wrex x3 (wrex y1 ch B2) A2)) $;

--| Formula-building rule for restricted quantifiers (deduction rule). (Contributed by NM, 28-Jan-2006.)
theorem rexralbidv {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1) (A2 B2: class x3 y1):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wrex x3 (wral y1 ps B2) A2) (wrex x3 (wral y1 ch B2) A2)) $;

--| A transformation of restricted quantifiers and logical connectives. (Contributed by NM, 4-Sep-2005.)
theorem ralinexa {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wral x3 (wi ph (wn ps)) A2) (wn (wrex x3 (wa ph ps) A2)) $;

--| Two ways to say " ` A ` belongs to ` B ` ." (Contributed by NM, 22-Nov-1994.)
theorem risset {x3: setvar} (A2 B2: class):
  $ wb (wcel A2 B2) (wrex x3 (wceq (cv x3) A2) B2) $;

--| Bound-variable hypothesis builder for restricted quantification. (Contributed by NM, 1-Sep-1999.) (Revised by David Abernethy, 13-Dec-2009.)
theorem hbral {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wi (wcel (cv y1) A2) (wal x3 (wcel (cv y1) A2)) $ >
  $ wi ph (wal x3 ph) $ >
  $ wi (wral y1 ph A2) (wal x3 (wral y1 ph A2)) $;

--| ` x ` is not free in ` A. x e. A ph ` . (Contributed by NM, 18-Oct-1996.)
theorem hbra1 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wral x3 ph A2) (wal x3 (wral x3 ph A2)) $;

--| ` x ` is not free in ` A. x e. A ph ` . (Contributed by NM, 18-Oct-1996.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem nfra1 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wnf x3 (wral x3 ph A2) $;

--| Not-free for restricted universal quantification where ` x ` and ` y ` are distinct. See ~ nfraldya for a version with ` y ` and ` A ` distinct instead. (Contributed by Jim Kingdon, 29-May-2018.)
theorem nfraldxy {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wral y1 ps A2)) $;

--| Not-free for restricted existential quantification where ` x ` and ` y ` are distinct. See ~ nfrexdya for a version with ` y ` and ` A ` distinct instead. (Contributed by Jim Kingdon, 30-May-2018.)
theorem nfrexdxy {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wrex y1 ps A2)) $;

--| Not-free for restricted universal quantification where ` y ` and ` A ` are distinct. See ~ nfraldxy for a version with ` x ` and ` y ` distinct instead. (Contributed by Jim Kingdon, 30-May-2018.)
theorem nfraldya {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3):
  $ wnf y1 ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wral y1 ps A2)) $;

--| Not-free for restricted existential quantification where ` y ` and ` A ` are distinct. See ~ nfrexdxy for a version with ` x ` and ` y ` distinct instead. (Contributed by Jim Kingdon, 30-May-2018.)
theorem nfrexdya {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3):
  $ wnf y1 ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wrex y1 ps A2)) $;

--| Not-free for restricted universal quantification where ` x ` and ` y ` are distinct. See ~ nfralya for a version with ` y ` and ` A ` distinct instead. (Contributed by Jim Kingdon, 30-May-2018.)
theorem nfralxy {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnf x3 ph $ >
  $ wnf x3 (wral y1 ph A2) $;

--| Not-free for restricted existential quantification where ` x ` and ` y ` are distinct. See ~ nfrexya for a version with ` y ` and ` A ` distinct instead. (Contributed by Jim Kingdon, 30-May-2018.)
theorem nfrexxy {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnf x3 ph $ >
  $ wnf x3 (wrex y1 ph A2) $;

--| Not-free for restricted universal quantification where ` y ` and ` A ` are distinct. See ~ nfralxy for a version with ` x ` and ` y ` distinct instead. (Contributed by Jim Kingdon, 3-Jun-2018.)
theorem nfralya {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 ph $ >
  $ wnf x3 (wral y1 ph A2) $;

--| Not-free for restricted existential quantification where ` y ` and ` A ` are distinct. See ~ nfrexxy for a version with ` x ` and ` y ` distinct instead. (Contributed by Jim Kingdon, 3-Jun-2018.)
theorem nfrexya {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 ph $ >
  $ wnf x3 (wrex y1 ph A2) $;

--| Not-free given two restricted quantifiers. (Contributed by Jim Kingdon, 20-Aug-2018.)
theorem nfra2xy {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wnf y1 (wral x3 (wral y1 ph B2) A2) $;

--| ` x ` is not free in ` E. x e. A ph ` . (Contributed by NM, 19-Mar-1997.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem nfre1 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wnf x3 (wrex x3 ph A2) $;

--| Triple restricted universal quantification. (Contributed by NM, 19-Nov-1995.)
theorem r3al {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class x3) (B2: class x3 y1) (C: class x3 y1 z):
  $ wb (wral x3 (wral y1 (wral z ph C) B2) A2) (wal x3 (wal y1 (wal z (wi (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) (wcel (cv z) C)) ph)))) $;

--| Universal quantification implies restricted quantification. (Contributed by NM, 20-Oct-2006.)
theorem alral {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wal x3 ph) (wral x3 ph A2) $;

--| Restricted existence implies existence. (Contributed by NM, 11-Nov-1995.)
theorem rexex {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wrex x3 ph A2) (wex x3 ph) $;

--| Restricted specialization. (Contributed by NM, 17-Oct-1996.)
theorem rsp {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wral x3 ph A2) (wi (wcel (cv x3) A2) ph) $;

--| Restricted specialization. (Contributed by NM, 12-Oct-1999.)
theorem rspe {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wa (wcel (cv x3) A2) ph) (wrex x3 ph A2) $;

--| Restricted specialization. (Contributed by NM, 11-Feb-1997.)
theorem rsp2 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wi (wral x3 (wral y1 ph B2) A2) (wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph) $;

--| Restricted specialization. (Contributed by NM, 11-Feb-1997.)
theorem rsp2_b {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi (wral x3 (wral x3 ph B2) A2) (wi (wa (wcel (cv x3) A2) (wcel (cv x3) B2)) ph) $;

--| Restricted specialization. (Contributed by FL, 4-Jun-2012.)
theorem rsp2e {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wi (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) ph) (wrex x3 (wrex y1 ph B2) A2) $;

--| Specialization rule for restricted quantification. (Contributed by NM, 19-Nov-1994.)
theorem rspec {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wral x3 ph A2 $ >
  $ wi (wcel (cv x3) A2) ph $;

--| Generalization rule for restricted quantification. (Contributed by NM, 19-Nov-1994.)
theorem rgen {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) ph $ >
  $ wral x3 ph A2 $;

--| Generalization rule for restricted quantification. Note that ` x ` and ` y ` needn't be distinct (and illustrates the use of ~ dvelimor ). (Contributed by NM, 23-Nov-1994.) (Proof rewritten by Jim Kingdon, 1-Jun-2018.)
theorem rgen2a {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) A2)) ph $ >
  $ wral x3 (wral y1 ph A2) A2 $;

--| Generalization rule for restricted quantification. (Contributed by NM, 18-Jun-2014.)
theorem rgenw {x3: setvar} (ph: wff x3) (A2: class x3):
  $ ph $ >
  $ wral x3 ph A2 $;

--| Generalization rule for restricted quantification. Note that ` x ` and ` y ` needn't be distinct. (Contributed by NM, 18-Jun-2014.)
theorem rgen2w {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ ph $ >
  $ wral x3 (wral y1 ph B2) A2 $;

--| Modus ponens combined with restricted generalization. (Contributed by NM, 10-Aug-2004.)
theorem mprg {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wral x3 ph A2) ps $ >
  $ wi (wcel (cv x3) A2) ph $ >
  $ ps $;

--| Modus ponens on biconditional combined with restricted generalization. (Contributed by NM, 21-Mar-2004.)
theorem mprgbir {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb ph (wral x3 ps A2) $ >
  $ wi (wcel (cv x3) A2) ps $ >
  $ ph $;

--| Distribution of restricted quantification over implication. (Contributed by NM, 9-Feb-1997.)
theorem ralim {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wral x3 (wi ph ps) A2) (wi (wral x3 ph A2) (wral x3 ps A2)) $;

--| Inference quantifying both antecedent and consequent. (Contributed by NM, 22-Feb-2004.)
theorem ralimi2 {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wi (wi (wcel (cv x3) A2) ph) (wi (wcel (cv x3) B2) ps) $ >
  $ wi (wral x3 ph A2) (wral x3 ps B2) $;

--| Inference quantifying both antecedent and consequent. (Contributed by NM, 19-Jul-1996.)
theorem ralimia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wi ph ps) $ >
  $ wi (wral x3 ph A2) (wral x3 ps A2) $;

--| Inference quantifying both antecedent and consequent. (Contributed by NM, 4-Aug-2007.)
theorem ralimiaa {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wa (wcel (cv x3) A2) ph) ps $ >
  $ wi (wral x3 ph A2) (wral x3 ps A2) $;

--| Inference quantifying both antecedent and consequent, with strong hypothesis. (Contributed by NM, 4-Mar-1997.)
theorem ralimi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi ph ps $ >
  $ wi (wral x3 ph A2) (wral x3 ps A2) $;

--| Inference quantifying antecedent, nested antecedent, and consequent, with a strong hypothesis. (Contributed by NM, 19-Dec-2006.)
theorem ral2imi {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wi ph (wi ps ch) $ >
  $ wi (wral x3 ph A2) (wi (wral x3 ps A2) (wral x3 ch A2)) $;

--| Deduction quantifying both antecedent and consequent, based on Theorem 19.20 of [Margaris] p. 90. (Contributed by NM, 22-Sep-2003.)
theorem ralimdaa {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wi ps ch) $ >
  $ wi ph (wi (wral x3 ps A2) (wral x3 ch A2)) $;

--| Deduction quantifying both antecedent and consequent, based on Theorem 19.20 of [Margaris] p. 90. (Contributed by NM, 22-May-1999.)
theorem ralimdva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wi ps ch) $ >
  $ wi ph (wi (wral x3 ps A2) (wral x3 ch A2)) $;

--| Deduction quantifying both antecedent and consequent, based on Theorem 19.20 of [Margaris] p. 90. (Contributed by NM, 8-Oct-2003.)
theorem ralimdv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wral x3 ps A2) (wral x3 ch A2)) $;

--| Inference quantifying both antecedent and consequent. (Contributed by NM, 1-Feb-2005.)
theorem ralimdv2 {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wi (wi (wcel (cv x3) A2) ps) (wi (wcel (cv x3) B2) ch)) $ >
  $ wi ph (wi (wral x3 ps A2) (wral x3 ch B2)) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90 (restricted quantifier version). (Contributed by NM, 10-Oct-1999.)
theorem ralrimi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wi (wcel (cv x3) A2) ps) $ >
  $ wi ph (wral x3 ps A2) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 22-Nov-1994.)
theorem ralrimiv {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wi ph (wi (wcel (cv x3) A2) ps) $ >
  $ wi ph (wral x3 ps A2) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 2-Jan-2006.)
theorem ralrimiva {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) ps $ >
  $ wi ph (wral x3 ps A2) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 18-Jun-2014.)
theorem ralrimivw {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wi ph ps $ >
  $ wi ph (wral x3 ps A2) $;

--| Theorem 19.21 of [Margaris] p. 90 with restricted quantifiers (closed theorem version). (Contributed by NM, 1-Mar-2008.)
theorem r19_21t {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wnf x3 ph) (wb (wral x3 (wi ph ps) A2) (wi ph (wral x3 ps A2))) $;

--| Theorem 19.21 of [Margaris] p. 90 with restricted quantifiers. (Contributed by Scott Fenton, 30-Mar-2011.)
theorem r19_21 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wb (wral x3 (wi ph ps) A2) (wi ph (wral x3 ps A2)) $;

--| Theorem 19.21 of [Margaris] p. 90 with restricted quantifiers. (Contributed by NM, 15-Oct-2003.) (Proof shortened by Andrew Salmon, 30-May-2011.)
theorem r19_21v {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wb (wral x3 (wi ph ps) A2) (wi ph (wral x3 ps A2)) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 16-Feb-2004.)
theorem ralrimd {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wnf x3 ps $ >
  $ wi ph (wi ps (wi (wcel (cv x3) A2) ch)) $ >
  $ wi ph (wi ps (wral x3 ch A2)) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 27-May-1998.)
theorem ralrimdv {x3: setvar} (ph ps: wff) (ch: wff x3) (A2: class x3):
  $ wi ph (wi ps (wi (wcel (cv x3) A2) ch)) $ >
  $ wi ph (wi ps (wral x3 ch A2)) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 2-Feb-2008.)
theorem ralrimdva {x3: setvar} (ph ps: wff) (ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wi ps ch) $ >
  $ wi ph (wi ps (wral x3 ch A2)) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version with double quantification.) (Contributed by NM, 24-Jul-2004.)
theorem ralrimivv {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi ph (wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ps) $ >
  $ wi ph (wral x3 (wral y1 ps B2) A2) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version with double quantification.) (Contributed by Jeff Madsen, 19-Jun-2011.)
theorem ralrimivva {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) ps $ >
  $ wi ph (wral x3 (wral y1 ps B2) A2) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version with triple quantification.) (Contributed by Mario Carneiro, 9-Jul-2014.)
theorem ralrimivvva {x3 y1 z: setvar} (ph: wff) (ps: wff x3 y1 z) (A2: class x3) (B2: class x3 y1) (C: class x3 y1 z):
  $ wi (wa ph (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) (wcel (cv z) C))) ps $ >
  $ wi ph (wral x3 (wral y1 (wral z ps C) B2) A2) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version with double quantification.) (Contributed by NM, 1-Jun-2005.)
theorem ralrimdvv {x3 y1: setvar} (ph ps: wff) (ch: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi ph (wi ps (wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ch)) $ >
  $ wi ph (wi ps (wral x3 (wral y1 ch B2) A2)) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version with double quantification.) (Contributed by NM, 2-Feb-2008.)
theorem ralrimdvva {x3 y1: setvar} (ph ps: wff) (ch: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wi ps ch) $ >
  $ wi ph (wi ps (wral x3 (wral y1 ch B2) A2)) $;

--| Generalization rule for restricted quantification. (Contributed by NM, 30-May-1999.)
theorem rgen2 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph $ >
  $ wral x3 (wral y1 ph B2) A2 $;

--| Generalization rule for restricted quantification. (Contributed by NM, 12-Jan-2008.)
theorem rgen3 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class x3) (B2: class x3 y1) (C: class x3 y1 z):
  $ wi (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) (wcel (cv z) C)) ph $ >
  $ wral x3 (wral y1 (wral z ph C) B2) A2 $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 20-Nov-1994.)
theorem r19_21bi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi ph (wral x3 ps A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) ps $;

--| Specialization rule for restricted quantification. (Contributed by NM, 20-Nov-1994.)
theorem rspec2 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wral x3 (wral y1 ph B2) A2 $ >
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph $;

--| Specialization rule for restricted quantification. (Contributed by NM, 20-Nov-1994.)
theorem rspec3 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2 B2 C: class x3 y1 z):
  $ wral x3 (wral y1 (wral z ph C) B2) A2 $ >
  $ wi (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) (wcel (cv z) C)) ph $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 21-Nov-1994.)
theorem r19_21be {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi ph (wral x3 ps A2) $ >
  $ wral x3 (wi ph ps) A2 $;

--| Inference adding restricted existential quantifier to negated wff. (Contributed by NM, 16-Oct-2003.)
theorem nrex {x3: setvar} (ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wn ps) $ >
  $ wn (wrex x3 ps A2) $;

--| Deduction adding restricted existential quantifier to negated wff. (Contributed by NM, 16-Oct-2003.)
theorem nrexdv {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wn ps) $ >
  $ wi ph (wn (wrex x3 ps A2)) $;

--| Theorem 19.22 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 22-Nov-1994.) (Proof shortened by Andrew Salmon, 30-May-2011.)
theorem rexim {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wral x3 (wi ph ps) A2) (wi (wrex x3 ph A2) (wrex x3 ps A2)) $;

--| Inference quantifying both antecedent and consequent. (Contributed by NM, 10-Feb-1997.)
theorem reximia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wi ph ps) $ >
  $ wi (wrex x3 ph A2) (wrex x3 ps A2) $;

--| Inference quantifying both antecedent and consequent, based on Theorem 19.22 of [Margaris] p. 90. (Contributed by NM, 8-Nov-2004.)
theorem reximi2 {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wi (wa (wcel (cv x3) A2) ph) (wa (wcel (cv x3) B2) ps) $ >
  $ wi (wrex x3 ph A2) (wrex x3 ps B2) $;

--| Inference quantifying both antecedent and consequent. (Contributed by NM, 18-Oct-1996.)
theorem reximi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi ph ps $ >
  $ wi (wrex x3 ph A2) (wrex x3 ps A2) $;

--| Deduction from Theorem 19.22 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 31-Aug-1999.)
theorem reximdai {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wi (wcel (cv x3) A2) (wi ps ch)) $ >
  $ wi ph (wi (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Deduction quantifying both antecedent and consequent, based on Theorem 19.22 of [Margaris] p. 90. (Contributed by NM, 17-Sep-2003.)
theorem reximdv2 {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wi (wa (wcel (cv x3) A2) ps) (wa (wcel (cv x3) B2) ch)) $ >
  $ wi ph (wi (wrex x3 ps A2) (wrex x3 ch B2)) $;

--| Deduction quantifying both antecedent and consequent, based on Theorem 19.22 of [Margaris] p. 90. (Contributed by NM, 14-Nov-2002.)
theorem reximdvai {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wi (wcel (cv x3) A2) (wi ps ch)) $ >
  $ wi ph (wi (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Deduction from Theorem 19.22 of [Margaris] p. 90. (Restricted quantifier version with strong hypothesis.) (Contributed by NM, 24-Jun-1998.)
theorem reximdv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Deduction quantifying both antecedent and consequent, based on Theorem 19.22 of [Margaris] p. 90. (Contributed by NM, 22-May-1999.)
theorem reximdva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wi ps ch) $ >
  $ wi ph (wi (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Theorem 19.12 of [Margaris] p. 89 with restricted quantifiers. (Contributed by NM, 15-Oct-2003.) (Proof shortened by Andrew Salmon, 30-May-2011.)
theorem r19_12 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wi (wrex x3 (wral y1 ph B2) A2) (wral y1 (wrex x3 ph A2) B2) $;

--| Closed theorem form of ~ r19.23 . (Contributed by NM, 4-Mar-2013.) (Revised by Mario Carneiro, 8-Oct-2016.)
theorem r19_23t {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wnf x3 ps) (wb (wral x3 (wi ph ps) A2) (wi (wrex x3 ph A2) ps)) $;

--| Theorem 19.23 of [Margaris] p. 90 with restricted quantifiers. (Contributed by NM, 22-Oct-2010.) (Proof shortened by Mario Carneiro, 8-Oct-2016.)
theorem r19_23 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ps $ >
  $ wb (wral x3 (wi ph ps) A2) (wi (wrex x3 ph A2) ps) $;

--| Theorem 19.23 of [Margaris] p. 90 with restricted quantifiers. (Contributed by NM, 31-Aug-1999.)
theorem r19_23v {x3: setvar} (ph: wff x3) (ps: wff) (A2: class x3):
  $ wb (wral x3 (wi ph ps) A2) (wi (wrex x3 ph A2) ps) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 30-Nov-2003.) (Proof shortened by Andrew Salmon, 30-May-2011.)
theorem rexlimi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ps $ >
  $ wi (wcel (cv x3) A2) (wi ph ps) $ >
  $ wi (wrex x3 ph A2) ps $;

--| Inference from Theorem 19.23 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 20-Nov-1994.)
theorem rexlimiv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wi ph ps) $ >
  $ wi (wrex x3 ph A2) ps $;

--| Inference from Theorem 19.23 of [Margaris] p. 90 (restricted quantifier version). (Contributed by NM, 18-Dec-2006.)
theorem rexlimiva {x3: setvar} (ph: wff x3) (ps: wff) (A2: class x3):
  $ wi (wa (wcel (cv x3) A2) ph) ps $ >
  $ wi (wrex x3 ph A2) ps $;

--| Weaker version of ~ rexlimiv . (Contributed by FL, 19-Sep-2011.)
theorem rexlimivw {x3: setvar} (ph: wff x3) (ps: wff) (A2: class x3):
  $ wi ph ps $ >
  $ wi (wrex x3 ph A2) ps $;

--| Deduction from Theorem 19.23 of [Margaris] p. 90 (restricted quantifier version). (Contributed by NM, 27-May-1998.) (Proof shortened by Andrew Salmon, 30-May-2011.)
theorem rexlimd {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wnf x3 ch $ >
  $ wi ph (wi (wcel (cv x3) A2) (wi ps ch)) $ >
  $ wi ph (wi (wrex x3 ps A2) ch) $;

--| Version of ~ rexlimd with deduction version of second hypothesis. (Contributed by NM, 21-Jul-2013.) (Revised by Mario Carneiro, 8-Oct-2016.)
theorem rexlimd2 {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wi (wcel (cv x3) A2) (wi ps ch)) $ >
  $ wi ph (wi (wrex x3 ps A2) ch) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90 (restricted quantifier version). (Contributed by NM, 14-Nov-2002.) (Proof shortened by Eric Schmidt, 22-Dec-2006.)
theorem rexlimdv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class x3):
  $ wi ph (wi (wcel (cv x3) A2) (wi ps ch)) $ >
  $ wi ph (wi (wrex x3 ps A2) ch) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90 (restricted quantifier version). (Contributed by NM, 20-Jan-2007.)
theorem rexlimdva {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wi ps ch) $ >
  $ wi ph (wi (wrex x3 ps A2) ch) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90 (restricted quantifier version). (Contributed by Mario Carneiro, 15-Jun-2016.)
theorem rexlimdvaa {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class x3):
  $ wi (wa ph (wa (wcel (cv x3) A2) ps)) ch $ >
  $ wi ph (wi (wrex x3 ps A2) ch) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90 (restricted quantifier version). Frequently-used variant of ~ rexlimdv . (Contributed by NM, 7-Jun-2015.)
theorem rexlimdv3a {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class x3):
  $ wi (w3a ph (wcel (cv x3) A2) ps) ch $ >
  $ wi ph (wi (wrex x3 ps A2) ch) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90 (restricted quantifier version). (Contributed by NM, 18-Jun-2014.)
theorem rexlimdvw {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class x3):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wrex x3 ps A2) ch) $;

--| Restricted existential elimination rule of natural deduction. (Contributed by Mario Carneiro, 15-Jun-2016.)
theorem rexlimddv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class x3):
  $ wi ph (wrex x3 ps A2) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) ps)) ch $ >
  $ wi ph ch $;

--| Inference from Theorem 19.23 of [Margaris] p. 90 (restricted quantifier version). (Contributed by NM, 17-Feb-2004.)
theorem rexlimivv {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2: class x3) (B2: class x3 y1):
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wi ph ps) $ >
  $ wi (wrex x3 (wrex y1 ph B2) A2) ps $;

--| Inference from Theorem 19.23 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 22-Jul-2004.)
theorem rexlimdvv {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (A2: class x3) (B2: class x3 y1):
  $ wi ph (wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wi ps ch)) $ >
  $ wi ph (wi (wrex x3 (wrex y1 ps B2) A2) ch) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 18-Jun-2014.)
theorem rexlimdvva {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (A2: class x3) (B2: class x3 y1):
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wi ps ch) $ >
  $ wi ph (wi (wrex x3 (wrex y1 ps B2) A2) ch) $;

--| Theorem 19.26 of [Margaris] p. 90 with restricted quantifiers. (Contributed by NM, 28-Jan-1997.) (Proof shortened by Andrew Salmon, 30-May-2011.)
theorem r19_26 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wral x3 (wa ph ps) A2) (wa (wral x3 ph A2) (wral x3 ps A2)) $;

--| Theorem 19.26 of [Margaris] p. 90 with 2 restricted quantifiers. (Contributed by NM, 10-Aug-2004.)
theorem r19_26_2 {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wb (wral x3 (wral y1 (wa ph ps) B2) A2) (wa (wral x3 (wral y1 ph B2) A2) (wral x3 (wral y1 ps B2) A2)) $;

--| Theorem 19.26 of [Margaris] p. 90 with 3 restricted quantifiers. (Contributed by FL, 22-Nov-2010.)
theorem r19_26_3 {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wb (wral x3 (w3a ph ps ch) A2) (w3a (wral x3 ph A2) (wral x3 ps A2) (wral x3 ch A2)) $;

--| Theorem 19.26 of [Margaris] p. 90 with mixed quantifiers. (Contributed by NM, 22-Feb-2004.)
theorem r19_26m {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wb (wal x3 (wa (wi (wcel (cv x3) A2) ph) (wi (wcel (cv x3) B2) ps))) (wa (wral x3 ph A2) (wral x3 ps B2)) $;

--| Distribute a restricted universal quantifier over a biconditional. Theorem 19.15 of [Margaris] p. 90 with restricted quantification. (Contributed by NM, 6-Oct-2003.)
theorem ralbi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wral x3 (wb ph ps) A2) (wb (wral x3 ph A2) (wral x3 ps A2)) $;

--| Distribute a restricted existential quantifier over a biconditional. Theorem 19.18 of [Margaris] p. 90 with restricted quantification. (Contributed by Jim Kingdon, 21-Jan-2019.)
theorem rexbi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wral x3 (wb ph ps) A2) (wb (wrex x3 ph A2) (wrex x3 ps A2)) $;

--| Split a biconditional and distribute quantifier. (Contributed by NM, 3-Jun-2012.)
theorem ralbiim {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wral x3 (wb ph ps) A2) (wa (wral x3 (wi ph ps) A2) (wral x3 (wi ps ph) A2)) $;

--| Restricted version of one direction of Theorem 19.27 of [Margaris] p. 90. (The other direction doesn't hold when ` A ` is empty.) (Contributed by NM, 3-Jun-2004.) (Proof shortened by Andrew Salmon, 30-May-2011.)
theorem r19_27av {x3: setvar} (ph: wff x3) (ps: wff) (A2: class x3):
  $ wi (wa (wral x3 ph A2) ps) (wral x3 (wa ph ps) A2) $;

--| Restricted version of one direction of Theorem 19.28 of [Margaris] p. 90. (The other direction doesn't hold when ` A ` is empty.) (Contributed by NM, 2-Apr-2004.)
theorem r19_28av {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wi (wa ph (wral x3 ps A2)) (wral x3 (wa ph ps) A2) $;

--| Theorem 19.29 of [Margaris] p. 90 with restricted quantifiers. (Contributed by NM, 31-Aug-1999.) (Proof shortened by Andrew Salmon, 30-May-2011.)
theorem r19_29 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wa (wral x3 ph A2) (wrex x3 ps A2)) (wrex x3 (wa ph ps) A2) $;

--| Variation of Theorem 19.29 of [Margaris] p. 90 with restricted quantifiers. (Contributed by NM, 31-Aug-1999.)
theorem r19_29r {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wa (wrex x3 ph A2) (wral x3 ps A2)) (wrex x3 (wa ph ps) A2) $;

--| A commonly used pattern based on ~ r19.29 (Contributed by Thierry Arnoux, 17-Dec-2017.)
theorem r19_29af2 {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wnf x3 ch $ >
  $ wi (wa (wa ph (wcel (cv x3) A2)) ps) ch $ >
  $ wi ph (wrex x3 ps A2) $ >
  $ wi ph ch $;

--| A commonly used pattern based on ~ r19.29 (Contributed by Thierry Arnoux, 29-Nov-2017.)
theorem r19_29af {x3: setvar} (ph ps: wff x3) (ch: wff) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wa (wa ph (wcel (cv x3) A2)) ps) ch $ >
  $ wi ph (wrex x3 ps A2) $ >
  $ wi ph ch $;

--| A commonly used pattern based on ~ r19.29 (Contributed by Thierry Arnoux, 22-Nov-2017.)
theorem r19_29a {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class x3):
  $ wi (wa (wa ph (wcel (cv x3) A2)) ps) ch $ >
  $ wi ph (wrex x3 ps A2) $ >
  $ wi ph ch $;

--| Theorem 19.29 of [Margaris] p. 90 with two restricted quantifiers, deduction version (Contributed by Thierry Arnoux, 30-Jan-2017.)
theorem r19_29d2r {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2 B2: class x3 y1):
  $ wi ph (wral x3 (wral y1 ps B2) A2) $ >
  $ wi ph (wrex x3 (wrex y1 ch B2) A2) $ >
  $ wi ph (wrex x3 (wrex y1 (wa ps ch) B2) A2) $;

--| A commonly used pattern based on ~ r19.29 , version with two restricted quantifiers. (Contributed by Thierry Arnoux, 26-Nov-2017.)
theorem r19_29vva {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (A2: class x3) (B2: class x3 y1):
  $ wi (wa (wa (wa ph (wcel (cv x3) A2)) (wcel (cv y1) B2)) ps) ch $ >
  $ wi ph (wrex x3 (wrex y1 ps B2) A2) $ >
  $ wi ph ch $;

--| One direction of Theorem 19.32 of [Margaris] p. 90 with restricted quantifiers. For decidable propositions this is an equivalence. (Contributed by Jim Kingdon, 19-Aug-2018.)
theorem r19_32r {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wo ph (wral x3 ps A2)) (wral x3 (wo ph ps) A2) $;

--| One direction of Theorem 19.32 of [Margaris] p. 90 with restricted quantifiers. For decidable propositions this is an equivalence, as seen at ~ r19.32vdc . (Contributed by Jim Kingdon, 19-Aug-2018.)
theorem r19_32vr {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wi (wo ph (wral x3 ps A2)) (wral x3 (wo ph ps) A2) $;

--| Theorem 19.32 of [Margaris] p. 90 with restricted quantifiers, where ` ph ` is decidable. (Contributed by Jim Kingdon, 4-Jun-2018.)
theorem r19_32vdc {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wi (wdc ph) (wb (wral x3 (wo ph ps) A2) (wo ph (wral x3 ps A2))) $;

--| Restricted quantifier version of ~ 19.35-1 . (Contributed by Jim Kingdon, 4-Jun-2018.)
theorem r19_35_1 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wrex x3 (wi ph ps) A2) (wi (wral x3 ph A2) (wrex x3 ps A2)) $;

--| One direction of a restricted quantifier version of Theorem 19.36 of [Margaris] p. 90. In classical logic, the converse would hold if ` A ` has at least one element, but in intuitionistic logic, that is not a sufficient condition. (Contributed by NM, 22-Oct-2003.)
theorem r19_36av {x3: setvar} (ph: wff x3) (ps: wff) (A2: class x3):
  $ wi (wrex x3 (wi ph ps) A2) (wi (wral x3 ph A2) ps) $;

--| Restricted version of one direction of Theorem 19.37 of [Margaris] p. 90. In classical logic the converse would hold if ` A ` has at least one element, but that is not sufficient in intuitionistic logic. (Contributed by FL, 13-May-2012.) (Revised by Mario Carneiro, 11-Dec-2016.)
theorem r19_37 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wrex x3 (wi ph ps) A2) (wi ph (wrex x3 ps A2)) $;

--| Restricted version of one direction of Theorem 19.37 of [Margaris] p. 90. (Contributed by NM, 2-Apr-2004.)
theorem r19_37av {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wi (wrex x3 (wi ph ps) A2) (wi ph (wrex x3 ps A2)) $;

--| Restricted quantifier version of Theorem 19.40 of [Margaris] p. 90. (Contributed by NM, 2-Apr-2004.)
theorem r19_40 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wrex x3 (wa ph ps) A2) (wa (wrex x3 ph A2) (wrex x3 ps A2)) $;

--| Restricted quantifier version of Theorem 19.41 of [Margaris] p. 90. (Contributed by NM, 1-Nov-2010.)
theorem r19_41 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ps $ >
  $ wb (wrex x3 (wa ph ps) A2) (wa (wrex x3 ph A2) ps) $;

--| Restricted quantifier version of Theorem 19.41 of [Margaris] p. 90. (Contributed by NM, 17-Dec-2003.)
theorem r19_41v {x3: setvar} (ph: wff x3) (ps: wff) (A2: class x3):
  $ wb (wrex x3 (wa ph ps) A2) (wa (wrex x3 ph A2) ps) $;

--| Restricted version of Theorem 19.42 of [Margaris] p. 90. (Contributed by NM, 27-May-1998.)
theorem r19_42v {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wb (wrex x3 (wa ph ps) A2) (wa ph (wrex x3 ps A2)) $;

--| Restricted version of Theorem 19.43 of [Margaris] p. 90. (Contributed by NM, 27-May-1998.) (Proof rewritten by Jim Kingdon, 5-Jun-2018.)
theorem r19_43 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wrex x3 (wo ph ps) A2) (wo (wrex x3 ph A2) (wrex x3 ps A2)) $;

--| One direction of a restricted quantifier version of Theorem 19.44 of [Margaris] p. 90. The other direction doesn't hold when ` A ` is empty. (Contributed by NM, 2-Apr-2004.)
theorem r19_44av {x3: setvar} (ph: wff x3) (ps: wff) (A2: class x3):
  $ wi (wrex x3 (wo ph ps) A2) (wo (wrex x3 ph A2) ps) $;

--| Restricted version of one direction of Theorem 19.45 of [Margaris] p. 90. (The other direction doesn't hold when ` A ` is empty.) (Contributed by NM, 2-Apr-2004.)
theorem r19_45av {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wi (wrex x3 (wo ph ps) A2) (wo ph (wrex x3 ps A2)) $;

--| Commutation of restricted quantifiers. (Contributed by Mario Carneiro, 14-Oct-2016.)
theorem ralcomf {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc x3 B2 $ >
  $ wb (wral x3 (wral y1 ph B2) A2) (wral y1 (wral x3 ph A2) B2) $;

--| Commutation of restricted quantifiers. (Contributed by Mario Carneiro, 14-Oct-2016.)
theorem rexcomf {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc x3 B2 $ >
  $ wb (wrex x3 (wrex y1 ph B2) A2) (wrex y1 (wrex x3 ph A2) B2) $;

--| Commutation of restricted quantifiers. (Contributed by NM, 13-Oct-1999.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem ralcom {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wb (wral x3 (wral y1 ph B2) A2) (wral y1 (wral x3 ph A2) B2) $;

--| Commutation of restricted quantifiers. (Contributed by NM, 19-Nov-1995.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem rexcom {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wb (wrex x3 (wrex y1 ph B2) A2) (wrex y1 (wrex x3 ph A2) B2) $;

--| Swap 1st and 3rd restricted existential quantifiers. (Contributed by NM, 8-Apr-2015.)
theorem rexcom13 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class x3) (B2: class y1) (C: class z):
  $ wb (wrex x3 (wrex y1 (wrex z ph C) B2) A2) (wrex z (wrex y1 (wrex x3 ph A2) B2) C) $;

--| Rotate existential restricted quantifiers twice. (Contributed by NM, 8-Apr-2015.)
theorem rexrot4 {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (A2 B2: class x3 y1) (C: class z) (D: class w):
  $ wb (wrex x3 (wrex y1 (wrex z (wrex w ph D) C) B2) A2) (wrex z (wrex w (wrex x3 (wrex y1 ph B2) A2) D) C) $;

--| A commutative law for restricted quantifiers that swaps the domain of the restriction. (Contributed by NM, 22-Feb-2004.)
theorem ralcom3 {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wb (wral x3 (wi (wcel (cv x3) B2) ph) A2) (wral x3 (wi (wcel (cv x3) A2) ph) B2) $;

--| Rearrange existential quantifiers. (Contributed by NM, 27-Oct-2010.) (Proof shortened by Andrew Salmon, 30-May-2011.)
theorem reean {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wb (wrex x3 (wrex y1 (wa ph ps) B2) A2) (wa (wrex x3 ph A2) (wrex y1 ps B2)) $;

--| Rearrange existential quantifiers. (Contributed by NM, 9-May-1999.)
theorem reeanv {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class x3) (B2: class y1):
  $ wb (wrex x3 (wrex y1 (wa ph ps) B2) A2) (wa (wrex x3 ph A2) (wrex y1 ps B2)) $;

--| Rearrange three existential quantifiers. (Contributed by Jeff Madsen, 11-Jun-2010.)
theorem _3reeanv {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1) (ch: wff z) (A2: class x3 z) (B2: class y1) (C: class z):
  $ wb (wrex x3 (wrex y1 (wrex z (w3a ph ps ch) C) B2) A2) (w3a (wrex x3 ph A2) (wrex y1 ps B2) (wrex z ch C)) $;

--| ` x ` is not free in ` E! x e. A ph ` . (Contributed by NM, 19-Mar-1997.)
theorem nfreu1 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wnf x3 (wreu x3 ph A2) $;

--| ` x ` is not free in ` E* x e. A ph ` . (Contributed by NM, 16-Jun-2017.)
theorem nfrmo1 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wnf x3 (wrmo x3 ph A2) $;

--| Not-free deduction for restricted uniqueness. This is a version where ` x ` and ` y ` are distinct. (Contributed by Jim Kingdon, 6-Jun-2018.)
theorem nfreudxy {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wreu y1 ps A2)) $;

--| Not-free for restricted uniqueness. This is a version where ` x ` and ` y ` are distinct. (Contributed by Jim Kingdon, 6-Jun-2018.)
theorem nfreuxy {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnf x3 ph $ >
  $ wnf x3 (wreu y1 ph A2) $;

--| An "identity" law of concretion for restricted abstraction. Special case of Definition 2.1 of [Quine] p. 16. (Contributed by NM, 9-Oct-2003.)
theorem rabid {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wcel (cv x3) (crab x3 ph A2)) (wa (wcel (cv x3) A2) ph) $;

--| An "identity" law for restricted class abstraction. (Contributed by NM, 9-Oct-2003.) (Proof shortened by Andrew Salmon, 30-May-2011.)
theorem rabid2 {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wceq A2 (crab x3 ph A2)) (wral x3 ph A2) $;

--| Equivalent wff's correspond to equal restricted class abstractions. Closed theorem form of ~ rabbidva . (Contributed by NM, 25-Nov-2013.)
theorem rabbi {x3: setvar} (ps ch: wff x3) (A2: class x3):
  $ wb (wral x3 (wb ps ch) A2) (wceq (crab x3 ps A2) (crab x3 ch A2)) $;

--| Swap with a membership relation in a restricted class abstraction. (Contributed by NM, 4-Jul-2005.)
theorem rabswap {x3: setvar} (A2 B2: class x3):
  $ wceq (crab x3 (wcel (cv x3) B2) A2) (crab x3 (wcel (cv x3) A2) B2) $;

--| The abstraction variable in a restricted class abstraction isn't free. (Contributed by NM, 19-Mar-1997.)
theorem nfrab1 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wnfc x3 (crab x3 ph A2) $;

--| A variable not free in a wff remains so in a restricted class abstraction. (Contributed by Jim Kingdon, 19-Jul-2018.)
theorem nfrabxy {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 (crab y1 ph A2) $;

--| Formula-building rule for restricted existential quantifier (deduction rule). (Contributed by Mario Carneiro, 19-Nov-2016.)
theorem reubida {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wreu x3 ps A2) (wreu x3 ch A2)) $;

--| Formula-building rule for restricted existential quantifier (deduction rule). (Contributed by NM, 13-Nov-2004.)
theorem reubidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wreu x3 ps A2) (wreu x3 ch A2)) $;

--| Formula-building rule for restricted existential quantifier (deduction rule). (Contributed by NM, 17-Oct-1996.)
theorem reubidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wreu x3 ps A2) (wreu x3 ch A2)) $;

--| Formula-building rule for restricted existential quantifier (inference rule). (Contributed by NM, 14-Nov-2004.)
theorem reubiia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wb ph ps) $ >
  $ wb (wreu x3 ph A2) (wreu x3 ps A2) $;

--| Formula-building rule for restricted existential quantifier (inference rule). (Contributed by NM, 22-Oct-1999.)
theorem reubii {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb ph ps $ >
  $ wb (wreu x3 ph A2) (wreu x3 ps A2) $;

--| Formula-building rule for restricted existential quantifier (deduction rule). (Contributed by NM, 16-Jun-2017.)
theorem rmobida {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wrmo x3 ps A2) (wrmo x3 ch A2)) $;

--| Formula-building rule for restricted existential quantifier (deduction rule). (Contributed by NM, 16-Jun-2017.)
theorem rmobidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wrmo x3 ps A2) (wrmo x3 ch A2)) $;

--| Formula-building rule for restricted existential quantifier (deduction rule). (Contributed by NM, 16-Jun-2017.)
theorem rmobidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wrmo x3 ps A2) (wrmo x3 ch A2)) $;

--| Formula-building rule for restricted existential quantifier (inference rule). (Contributed by NM, 16-Jun-2017.)
theorem rmobiia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wb ph ps) $ >
  $ wb (wrmo x3 ph A2) (wrmo x3 ps A2) $;

--| Formula-building rule for restricted existential quantifier (inference rule). (Contributed by NM, 16-Jun-2017.)
theorem rmobii {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb ph ps $ >
  $ wb (wrmo x3 ph A2) (wrmo x3 ps A2) $;

--| Equality theorem for restricted universal quantifier, with bound-variable hypotheses instead of distinct variable restrictions. (Contributed by NM, 7-Mar-2004.) (Revised by Andrew Salmon, 11-Jul-2011.)
theorem raleqf {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wceq A2 B2) (wb (wral x3 ph A2) (wral x3 ph B2)) $;

--| Equality theorem for restricted existential quantifier, with bound-variable hypotheses instead of distinct variable restrictions. (Contributed by NM, 9-Oct-2003.) (Revised by Andrew Salmon, 11-Jul-2011.)
theorem rexeqf {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wceq A2 B2) (wb (wrex x3 ph A2) (wrex x3 ph B2)) $;

--| Equality theorem for restricted uniqueness quantifier, with bound-variable hypotheses instead of distinct variable restrictions. (Contributed by NM, 5-Apr-2004.) (Revised by Andrew Salmon, 11-Jul-2011.)
theorem reueq1f {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wceq A2 B2) (wb (wreu x3 ph A2) (wreu x3 ph B2)) $;

--| Equality theorem for restricted uniqueness quantifier, with bound-variable hypotheses instead of distinct variable restrictions. (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem rmoeq1f {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wceq A2 B2) (wb (wrmo x3 ph A2) (wrmo x3 ph B2)) $;

--| Equality theorem for restricted universal quantifier. (Contributed by NM, 16-Nov-1995.)
theorem raleq {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wral x3 ph A2) (wral x3 ph B2)) $;

--| Equality theorem for restricted existential quantifier. (Contributed by NM, 29-Oct-1995.)
theorem rexeq {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wrex x3 ph A2) (wrex x3 ph B2)) $;

--| Equality theorem for restricted uniqueness quantifier. (Contributed by NM, 5-Apr-2004.)
theorem reueq1 {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wreu x3 ph A2) (wreu x3 ph B2)) $;

--| Equality theorem for restricted uniqueness quantifier. (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem rmoeq1 {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wrmo x3 ph A2) (wrmo x3 ph B2)) $;

--| Equality inference for restricted universal qualifier. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem raleqi {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wb (wral x3 ph A2) (wral x3 ph B2) $;

--| Equality inference for restricted existential qualifier. (Contributed by Mario Carneiro, 23-Apr-2015.)
theorem rexeqi {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wb (wrex x3 ph A2) (wrex x3 ph B2) $;

--| Equality deduction for restricted universal quantifier. (Contributed by NM, 13-Nov-2005.)
theorem raleqdv {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ps B2)) $;

--| Equality deduction for restricted existential quantifier. (Contributed by NM, 14-Jan-2007.)
theorem rexeqdv {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ps B2)) $;

--| Equality deduction for restricted universal quantifier. (Contributed by NM, 16-Nov-1995.)
theorem raleqbi1dv {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi (wceq A2 B2) (wb ph ps) $ >
  $ wi (wceq A2 B2) (wb (wral x3 ph A2) (wral x3 ps B2)) $;

--| Equality deduction for restricted existential quantifier. (Contributed by NM, 18-Mar-1997.)
theorem rexeqbi1dv {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi (wceq A2 B2) (wb ph ps) $ >
  $ wi (wceq A2 B2) (wb (wrex x3 ph A2) (wrex x3 ps B2)) $;

--| Equality deduction for restricted uniqueness quantifier. (Contributed by NM, 5-Apr-2004.)
theorem reueqd {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi (wceq A2 B2) (wb ph ps) $ >
  $ wi (wceq A2 B2) (wb (wreu x3 ph A2) (wreu x3 ps B2)) $;

--| Equality deduction for restricted uniqueness quantifier. (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem rmoeqd {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi (wceq A2 B2) (wb ph ps) $ >
  $ wi (wceq A2 B2) (wb (wrmo x3 ph A2) (wrmo x3 ps B2)) $;

--| Equality deduction for restricted universal quantifier. (Contributed by NM, 6-Nov-2007.)
theorem raleqbidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ch B2)) $;

--| Equality deduction for restricted universal quantifier. (Contributed by NM, 6-Nov-2007.)
theorem rexeqbidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ch B2)) $;

--| Equality deduction for restricted universal quantifier. (Contributed by Mario Carneiro, 5-Jan-2017.)
theorem raleqbidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ch B2)) $;

--| Equality deduction for restricted universal quantifier. (Contributed by Mario Carneiro, 5-Jan-2017.)
theorem rexeqbidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ch B2)) $;

--| Unrestricted "at most one" implies restricted "at most one". (Contributed by NM, 16-Jun-2017.)
theorem mormo {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wmo x3 ph) (wrmo x3 ph A2) $;

--| Restricted uniqueness in terms of "at most one." (Contributed by NM, 23-May-1999.) (Revised by NM, 16-Jun-2017.)
theorem reu5 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wreu x3 ph A2) (wa (wrex x3 ph A2) (wrmo x3 ph A2)) $;

--| Restricted unique existence implies restricted existence. (Contributed by NM, 19-Aug-1999.)
theorem reurex {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wreu x3 ph A2) (wrex x3 ph A2) $;

--| Restricted existential uniqueness implies restricted "at most one." (Contributed by NM, 16-Jun-2017.)
theorem reurmo {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wreu x3 ph A2) (wrmo x3 ph A2) $;

--| Restricted "at most one" in term of uniqueness. (Contributed by NM, 16-Jun-2017.)
theorem rmo5 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wrmo x3 ph A2) (wi (wrex x3 ph A2) (wreu x3 ph A2)) $;

--| Nonexistence implies restricted "at most one". (Contributed by NM, 17-Jun-2017.)
theorem nrexrmo {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wn (wrex x3 ph A2)) (wrmo x3 ph A2) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by NM, 7-Mar-2004.) (Revised by Mario Carneiro, 9-Oct-2016.)
theorem cbvralf {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wral x3 ph A2) (wral y1 ps A2) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by FL, 27-Apr-2008.) (Revised by Mario Carneiro, 9-Oct-2016.) (Proof rewritten by Jim Kingdon, 10-Jun-2018.)
theorem cbvrexf {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrex x3 ph A2) (wrex y1 ps A2) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by NM, 31-Jul-2003.)
theorem cbvral {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wral x3 ph A2) (wral y1 ps A2) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by NM, 31-Jul-2003.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem cbvrex {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrex x3 ph A2) (wrex y1 ps A2) $;

--| Change the bound variable of a restricted uniqueness quantifier using implicit substitution. (Contributed by Mario Carneiro, 15-Oct-2016.)
theorem cbvreu {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wreu x3 ph A2) (wreu y1 ps A2) $;

--| Change the bound variable of restricted "at most one" using implicit substitution. (Contributed by NM, 16-Jun-2017.)
theorem cbvrmo {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrmo x3 ph A2) (wrmo y1 ps A2) $;

--| Change the bound variable of a restricted universal quantifier using implicit substitution. (Contributed by NM, 28-Jan-1997.)
theorem cbvralv {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wral x3 ph A2) (wral y1 ps A2) $;

--| Change the bound variable of a restricted existential quantifier using implicit substitution. (Contributed by NM, 2-Jun-1998.)
theorem cbvrexv {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrex x3 ph A2) (wrex y1 ps A2) $;

--| Change the bound variable of a restricted uniqueness quantifier using implicit substitution. (Contributed by NM, 5-Apr-2004.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem cbvreuv {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wreu x3 ph A2) (wreu y1 ps A2) $;

--| Change the bound variable of a restricted uniqueness quantifier using implicit substitution. (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem cbvrmov {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrmo x3 ph A2) (wrmo y1 ps A2) $;

--| Rule used to change the bound variable in a restricted universal quantifier with implicit substitution which also changes the quantifier domain. Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem cbvraldva2 {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class x3) (B2: class y1):
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wceq A2 B2) $ >
  $ wi ph (wb (wral x3 ps A2) (wral y1 ch B2)) $;

--| Rule used to change the bound variable in a restricted existential quantifier with implicit substitution which also changes the quantifier domain. Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem cbvrexdva2 {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class x3) (B2: class y1):
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wceq A2 B2) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex y1 ch B2)) $;

--| Rule used to change the bound variable in a restricted universal quantifier with implicit substitution. Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem cbvraldva {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class):
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps A2) (wral y1 ch A2)) $;

--| Rule used to change the bound variable in a restricted existential quantifier with implicit substitution. Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem cbvrexdva {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class):
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex y1 ch A2)) $;

--| Change bound variables of double restricted universal quantification, using implicit substitution. (Contributed by NM, 10-Aug-2004.)
theorem cbvral2v {x3 y1 z w: setvar} (ph: wff x3 y1 w) (ps: wff x3 z w) (ch: wff y1 z) (A2: class y1 w) (B2: class):
  $ wi (wceq (cv x3) (cv z)) (wb ph ch) $ >
  $ wi (wceq (cv y1) (cv w)) (wb ch ps) $ >
  $ wb (wral x3 (wral y1 ph B2) A2) (wral z (wral w ps B2) A2) $;

--| Change bound variables of double restricted universal quantification, using implicit substitution. (Contributed by FL, 2-Jul-2012.)
theorem cbvrex2v {x3 y1 z w: setvar} (ph: wff x3 y1 w) (ps: wff x3 z w) (ch: wff y1 z) (A2: class y1 w) (B2: class):
  $ wi (wceq (cv x3) (cv z)) (wb ph ch) $ >
  $ wi (wceq (cv y1) (cv w)) (wb ch ps) $ >
  $ wb (wrex x3 (wrex y1 ph B2) A2) (wrex z (wrex w ps B2) A2) $;

--| Change bound variables of triple restricted universal quantification, using implicit substitution. (Contributed by NM, 10-May-2005.)
theorem cbvral3v {x3 y1 z w v u: setvar} (ph: wff x3 y1 z v u) (ps: wff x3 y1 w v u) (ch: wff y1 z w u) (th: wff x3 z w v) (A2: class y1 z v u) (B2: class z u) (C: class):
  $ wi (wceq (cv x3) (cv w)) (wb ph ch) $ >
  $ wi (wceq (cv y1) (cv v)) (wb ch th) $ >
  $ wi (wceq (cv z) (cv u)) (wb th ps) $ >
  $ wb (wral x3 (wral y1 (wral z ph C) B2) A2) (wral w (wral v (wral u ps C) B2) A2) $;

--| Change bound variable by using a substitution. (Contributed by NM, 20-Nov-2005.) (Revised by Andrew Salmon, 11-Jul-2011.)
theorem cbvralsv {x3 y1: setvar} (ph: wff x3) (A2: class):
  $ wb (wral x3 ph A2) (wral y1 (wsb x3 y1 ph) A2) $;

--| Change bound variable by using a substitution. (Contributed by NM, 2-Mar-2008.) (Revised by Andrew Salmon, 11-Jul-2011.)
theorem cbvrexsv {x3 y1: setvar} (ph: wff x3) (A2: class):
  $ wb (wrex x3 ph A2) (wrex y1 (wsb x3 y1 ph) A2) $;

--| Implicit to explicit substitution that swaps variables in a quantified expression. (Contributed by NM, 5-Sep-2004.)
theorem sbralie {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wsb y1 x3 (wral x3 ph (cv y1))) (wral y1 ps (cv x3)) $;

--| Equivalent wff's yield equal restricted class abstractions (inference rule). (Contributed by NM, 22-May-1999.)
theorem rabbiia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wb ph ps) $ >
  $ wceq (crab x3 ph A2) (crab x3 ps A2) $;

--| Equivalent wff's yield equal restricted class abstractions (deduction rule). (Contributed by NM, 28-Nov-2003.)
theorem rabbidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wceq (crab x3 ps A2) (crab x3 ch A2)) $;

--| Equivalent wff's yield equal restricted class abstractions (deduction rule). (Contributed by NM, 10-Feb-1995.)
theorem rabbidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (crab x3 ps A2) (crab x3 ch A2)) $;

--| Equality theorem for restricted class abstractions, with bound-variable hypotheses instead of distinct variable restrictions. (Contributed by NM, 7-Mar-2004.)
theorem rabeqf {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wceq A2 B2) (wceq (crab x3 ph A2) (crab x3 ph B2)) $;

--| Equality theorem for restricted class abstractions. (Contributed by NM, 15-Oct-2003.)
theorem rabeq {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (crab x3 ph A2) (crab x3 ph B2)) $;

--| Equality of restricted class abstractions. (Contributed by Jeff Madsen, 1-Dec-2009.)
theorem rabeqbidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (crab x3 ps A2) (crab x3 ch B2)) $;

--| Equality of restricted class abstractions. (Contributed by Mario Carneiro, 26-Jan-2017.)
theorem rabeqbidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wceq (crab x3 ps A2) (crab x3 ch B2)) $;

--| Inference rule from equality of a class variable and a restricted class abstraction. (Contributed by NM, 16-Feb-2004.)
theorem rabeq2i {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wceq A2 (crab x3 ph B2) $ >
  $ wb (wcel (cv x3) A2) (wa (wcel (cv x3) B2) ph) $;

--| Rule to change the bound variable in a restricted class abstraction, using implicit substitution. This version has bound-variable hypotheses in place of distinct variable conditions. (Contributed by Andrew Salmon, 11-Jul-2011.) (Revised by Mario Carneiro, 9-Oct-2016.)
theorem cbvrab {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (crab x3 ph A2) (crab y1 ps A2) $;

--| Rule to change the bound variable in a restricted class abstraction, using implicit substitution. (Contributed by NM, 26-May-1999.)
theorem cbvrabv {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (crab x3 ph A2) (crab y1 ps A2) $;

--| Extend class notation to include the universal class symbol.
term cvv: class;

--| Soundness justification theorem for ~ df-v . (Contributed by Rodolfo Medina, 27-Apr-2010.)
theorem vjust {x3 y1: setvar}:
  $ wceq (cab x3 (wceq (cv x3) (cv x3))) (cab y1 (wceq (cv y1) (cv y1))) $;

--| Define the universal class. Definition 5.20 of [TakeutiZaring] p. 21. Also Definition 2.9 of [Quine] p. 19. (Contributed by NM, 5-Aug-1993.)
axiom df_v {x3: setvar}:
  $ wceq cvv (cab x3 (wceq (cv x3) (cv x3))) $;

--| All setvar variables are sets (see ~ isset ). Theorem 6.8 of [Quine] p. 43. (Contributed by NM, 5-Aug-1993.)
theorem vex {x3: setvar}:
  $ wcel (cv x3) cvv $;

--| Two ways to say " ` A ` is a set": A class ` A ` is a member of the universal class ` _V ` (see ~ df-v ) if and only if the class ` A ` exists (i.e. there exists some set ` x ` equal to class ` A ` ). Theorem 6.9 of [Quine] p. 43. _Notational convention_: We will use the notational device " ` A e. _V ` " to mean " ` A ` is a set" very frequently, for example in ~ uniex . Note the when ` A ` is not a set, it is called a proper class. In some theorems, such as ~ uniexg , in order to shorten certain proofs we use the more general antecedent ` A e. V ` instead of ` A e. _V ` to mean " ` A ` is a set." Note that a constant is implicitly considered distinct from all variables. This is why ` _V ` is not included in the distinct variable list, even though ~ df-clel requires that the expression substituted for ` B ` not contain ` x ` . (Also, the Metamath spec does not allow constants in the distinct variable list.) (Contributed by NM, 26-May-1993.)
theorem isset {x3: setvar} (A2: class):
  $ wb (wcel A2 cvv) (wex x3 (wceq (cv x3) A2)) $;

--| A version of isset that does not require x and A to be distinct. (Contributed by Andrew Salmon, 6-Jun-2011.) (Revised by Mario Carneiro, 10-Oct-2016.)
theorem issetf {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wb (wcel A2 cvv) (wex x3 (wceq (cv x3) A2)) $;

--| A way to say " ` A ` is a set" (inference rule). (Contributed by NM, 5-Aug-1993.)
theorem isseti {x3: setvar} (A2: class):
  $ wcel A2 cvv $ >
  $ wex x3 (wceq (cv x3) A2) $;

--| A way to say " ` A ` is a set" (inference rule). (Contributed by NM, 5-Aug-1993.)
theorem issetri {x3: setvar} (A2: class):
  $ wex x3 (wceq (cv x3) A2) $ >
  $ wcel A2 cvv $;

--| A class equal to a variable is a set. Note the absence of dv condition, contrary to ~ isset and ~ issetri . (Contributed by BJ, 27-Apr-2019.)
theorem eqvisset {x3: setvar} (A2: class x3):
  $ wi (wceq (cv x3) A2) (wcel A2 cvv) $;

--| If a class is a member of another class, it is a set. Theorem 6.12 of [Quine] p. 44. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem elex (A2 B2: class):
  $ wi (wcel A2 B2) (wcel A2 cvv) $;

--| If a class is a member of another class, it is a set. (Contributed by NM, 11-Jun-1994.)
theorem elexi (A2 B2: class):
  $ wcel A2 B2 $ >
  $ wcel A2 cvv $;

--| An element of a class exists. (Contributed by NM, 1-May-1995.)
theorem elisset {x3: setvar} (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wex x3 (wceq (cv x3) A2)) $;

--| If two classes each contain another class, then both contain some set. (Contributed by Alan Sare, 24-Oct-2011.)
theorem elex22 {x3: setvar} (A2 B2 C: class):
  $ wi (wa (wcel A2 B2) (wcel A2 C)) (wex x3 (wa (wcel (cv x3) B2) (wcel (cv x3) C))) $;

--| If a class contains another class, then it contains some set. (Contributed by Alan Sare, 25-Sep-2011.)
theorem elex2 {x3: setvar} (A2 B2: class):
  $ wi (wcel A2 B2) (wex x3 (wcel (cv x3) B2)) $;

--| A universal quantifier restricted to the universe is unrestricted. (Contributed by NM, 26-Mar-2004.)
theorem ralv {x3: setvar} (ph: wff x3):
  $ wb (wral x3 ph cvv) (wal x3 ph) $;

--| An existential quantifier restricted to the universe is unrestricted. (Contributed by NM, 26-Mar-2004.)
theorem rexv {x3: setvar} (ph: wff x3):
  $ wb (wrex x3 ph cvv) (wex x3 ph) $;

--| A uniqueness quantifier restricted to the universe is unrestricted. (Contributed by NM, 1-Nov-2010.)
theorem reuv {x3: setvar} (ph: wff x3):
  $ wb (wreu x3 ph cvv) (weu x3 ph) $;

--| A uniqueness quantifier restricted to the universe is unrestricted. (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem rmov {x3: setvar} (ph: wff x3):
  $ wb (wrmo x3 ph cvv) (wmo x3 ph) $;

--| A class abstraction restricted to the universe is unrestricted. (Contributed by NM, 27-Dec-2004.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem rabab {x3: setvar} (ph: wff x3):
  $ wceq (crab x3 ph cvv) (cab x3 ph) $;

--| Commutation of restricted and unrestricted universal quantifiers. (Contributed by NM, 26-Mar-2004.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem ralcom4 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wb (wral x3 (wal y1 ph) A2) (wal y1 (wral x3 ph A2)) $;

--| Commutation of restricted and unrestricted existential quantifiers. (Contributed by NM, 12-Apr-2004.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem rexcom4 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wb (wrex x3 (wex y1 ph) A2) (wex y1 (wrex x3 ph A2)) $;

--| Specialized existential commutation lemma. (Contributed by Jeff Madsen, 1-Jun-2011.)
theorem rexcom4a {x3 y1: setvar} (ph: wff y1) (ps: wff x3 y1) (A2: class y1):
  $ wb (wex x3 (wrex y1 (wa ph ps) A2)) (wrex y1 (wa ph (wex x3 ps)) A2) $;

--| Specialized existential commutation lemma. (Contributed by Jeff Madsen, 1-Jun-2011.)
theorem rexcom4b {x3 y1: setvar} (ph: wff y1) (A2 B2: class y1):
  $ wcel B2 cvv $ >
  $ wb (wex x3 (wrex y1 (wa ph (wceq (cv x3) B2)) A2)) (wrex y1 ph A2) $;

--| Closed theorem version of ~ ceqsalg . (Contributed by NM, 28-Feb-2013.) (Revised by Mario Carneiro, 10-Oct-2016.)
theorem ceqsalt {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wi (w3a (wnf x3 ps) (wal x3 (wi (wceq (cv x3) A2) (wb ph ps))) (wcel A2 V)) (wb (wal x3 (wi (wceq (cv x3) A2) ph)) ps) $;

--| Restricted quantifier version of ~ ceqsalt . (Contributed by NM, 28-Feb-2013.) (Revised by Mario Carneiro, 10-Oct-2016.)
theorem ceqsralt {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi (w3a (wnf x3 ps) (wal x3 (wi (wceq (cv x3) A2) (wb ph ps))) (wcel A2 B2)) (wb (wral x3 (wi (wceq (cv x3) A2) ph) B2) ps) $;

--| A representation of explicit substitution of a class for a variable, inferred from an implicit substitution hypothesis. (Contributed by NM, 29-Oct-2003.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem ceqsalg {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wal x3 (wi (wceq (cv x3) A2) ph)) ps) $;

--| A representation of explicit substitution of a class for a variable, inferred from an implicit substitution hypothesis. (Contributed by NM, 18-Aug-1993.)
theorem ceqsal {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wnf x3 ps $ >
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wal x3 (wi (wceq (cv x3) A2) ph)) ps $;

--| A representation of explicit substitution of a class for a variable, inferred from an implicit substitution hypothesis. (Contributed by NM, 18-Aug-1993.)
theorem ceqsalv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wal x3 (wi (wceq (cv x3) A2) ph)) ps $;

--| Restricted quantifier version of ~ ceqsalv . (Contributed by NM, 21-Jun-2013.)
theorem ceqsralv {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 B2) (wb (wral x3 (wi (wceq (cv x3) A2) ph) B2) ps) $;

--| Implicit substitution for class with embedded variable. (Contributed by NM, 17-May-1996.)
theorem gencl {x3: setvar} (ph: wff x3) (ps: wff) (ch th: wff x3) (A2 B2: class x3):
  $ wb th (wex x3 (wa ch (wceq A2 B2))) $ >
  $ wi (wceq A2 B2) (wb ph ps) $ >
  $ wi ch ph $ >
  $ wi th ps $;

--| Implicit substitution for class with embedded variable. (Contributed by NM, 17-May-1996.)
theorem _2gencl {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1) (ch: wff x3) (A2 B2: class x3 y1) (C: class x3) (D: class x3 y1) (R: class y1) (S: class x3):
  $ wb (wcel C S) (wrex x3 (wceq A2 C) R) $ >
  $ wb (wcel D S) (wrex y1 (wceq B2 D) R) $ >
  $ wi (wceq A2 C) (wb ph ps) $ >
  $ wi (wceq B2 D) (wb ps ch) $ >
  $ wi (wa (wcel (cv x3) R) (wcel (cv y1) R)) ph $ >
  $ wi (wa (wcel C S) (wcel D S)) ch $;

--| Implicit substitution for class with embedded variable. (Contributed by NM, 17-May-1996.)
theorem _3gencl {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff y1 z) (ch: wff x3 z) (th: wff x3 y1) (A2 B2 C: class x3 y1 z) (D: class x3) (R: class z) (S: class x3) (F: class x3 y1) (G: class x3 y1 z):
  $ wb (wcel D S) (wrex x3 (wceq A2 D) R) $ >
  $ wb (wcel F S) (wrex y1 (wceq B2 F) R) $ >
  $ wb (wcel G S) (wrex z (wceq C G) R) $ >
  $ wi (wceq A2 D) (wb ph ps) $ >
  $ wi (wceq B2 F) (wb ps ch) $ >
  $ wi (wceq C G) (wb ch th) $ >
  $ wi (w3a (wcel (cv x3) R) (wcel (cv y1) R) (wcel (cv z) R)) ph $ >
  $ wi (w3a (wcel D S) (wcel F S) (wcel G S)) th $;

--| Implicit substitution inference for general classes. (Contributed by NM, 26-Aug-2007.)
theorem cgsexg {x3: setvar} (ph: wff x3) (ps: wff) (ch: wff x3) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) ch $ >
  $ wi ch (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wex x3 (wa ch ph)) ps) $;

--| Implicit substitution inference for general classes. (Contributed by NM, 26-Jul-1995.)
theorem cgsex2g {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (ch: wff x3 y1) (A2 B2: class) (V W: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) ch $ >
  $ wi ch (wb ph ps) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wex x3 (wex y1 (wa ch ph))) ps) $;

--| An implicit substitution inference for 4 general classes. (Contributed by NM, 5-Aug-1995.)
theorem cgsex4g {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (ps: wff) (ch: wff x3 y1 z w) (A2 B2 C D: class) (R S: class x3 y1 z w):
  $ wi (wa (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wa (wceq (cv z) C) (wceq (cv w) D))) ch $ >
  $ wi ch (wb ph ps) $ >
  $ wi (wa (wa (wcel A2 R) (wcel B2 S)) (wa (wcel C R) (wcel D S))) (wb (wex x3 (wex y1 (wex z (wex w (wa ch ph))))) ps) $;

--| Elimination of an existential quantifier, using implicit substitution. (Contributed by NM, 2-Mar-1995.) (Revised by Mario Carneiro, 10-Oct-2016.)
theorem ceqsex {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wnf x3 ps $ >
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wex x3 (wa (wceq (cv x3) A2) ph)) ps $;

--| Elimination of an existential quantifier, using implicit substitution. (Contributed by NM, 2-Mar-1995.)
theorem ceqsexv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wex x3 (wa (wceq (cv x3) A2) ph)) ps $;

--| Elimination of two existential quantifiers, using implicit substitution. (Contributed by Scott Fenton, 7-Jun-2006.)
theorem ceqsex2 {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2 B2: class):
  $ wnf x3 ps $ >
  $ wnf y1 ch $ >
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wb (wex x3 (wex y1 (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) ph))) ch $;

--| Elimination of two existential quantifiers, using implicit substitution. (Contributed by Scott Fenton, 7-Jun-2006.)
theorem ceqsex2v {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1) (ch: wff x3) (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wb (wex x3 (wex y1 (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) ph))) ch $;

--| Elimination of three existential quantifiers, using implicit substitution. (Contributed by NM, 16-Aug-2011.)
theorem ceqsex3v {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff y1 z) (ch: wff x3 z) (th: wff x3 y1) (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ wb (wex x3 (wex y1 (wex z (wa (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) ph)))) th $;

--| Elimination of four existential quantifiers, using implicit substitution. (Contributed by NM, 23-Sep-2011.)
theorem ceqsex4v {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (ps: wff y1 z w) (ch: wff x3 z w) (th: wff x3 y1 w) (ta: wff x3 y1 z) (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ wi (wceq (cv w) D) (wb th ta) $ >
  $ wb (wex x3 (wex y1 (wex z (wex w (w3a (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wa (wceq (cv z) C) (wceq (cv w) D)) ph))))) ta $;

--| Elimination of six existential quantifiers, using implicit substitution. (Contributed by NM, 21-Sep-2011.)
theorem ceqsex6v {x3 y1 z w v u: setvar} (ph: wff x3 y1 z w v u) (ps: wff y1 z w v u) (ch: wff x3 z w v u) (th: wff x3 y1 w v u) (ta: wff x3 y1 z v u) (et: wff x3 y1 z w u) (ze: wff x3 y1 z w v) (A2 B2 C D E F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wcel E cvv $ >
  $ wcel F cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ wi (wceq (cv w) D) (wb th ta) $ >
  $ wi (wceq (cv v) E) (wb ta et) $ >
  $ wi (wceq (cv u) F) (wb et ze) $ >
  $ wb (wex x3 (wex y1 (wex z (wex w (wex v (wex u (w3a (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) (w3a (wceq (cv w) D) (wceq (cv v) E) (wceq (cv u) F)) ph))))))) ze $;

--| Elimination of eight existential quantifiers, using implicit substitution. (Contributed by NM, 23-Sep-2011.)
theorem ceqsex8v {x3 y1 z w v u t s1: setvar} (ph: wff x3 y1 z w v u t s1) (ps: wff y1 z w v u t s1) (ch: wff x3 z w v u t s1) (th: wff x3 y1 w v u t s1) (ta: wff x3 y1 z v u t s1) (et: wff x3 y1 z w u t s1) (ze: wff x3 y1 z w v t s1) (si: wff x3 y1 z w v u s1) (rh: wff x3 y1 z w v u t) (A2 B2 C D E F G H: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wcel E cvv $ >
  $ wcel F cvv $ >
  $ wcel G cvv $ >
  $ wcel H cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ wi (wceq (cv w) D) (wb th ta) $ >
  $ wi (wceq (cv v) E) (wb ta et) $ >
  $ wi (wceq (cv u) F) (wb et ze) $ >
  $ wi (wceq (cv t) G) (wb ze si) $ >
  $ wi (wceq (cv s1) H) (wb si rh) $ >
  $ wb (wex x3 (wex y1 (wex z (wex w (wex v (wex u (wex t (wex s1 (w3a (wa (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wa (wceq (cv z) C) (wceq (cv w) D))) (wa (wa (wceq (cv v) E) (wceq (cv u) F)) (wa (wceq (cv t) G) (wceq (cv s1) H))) ph))))))))) rh $;

--| Change of bound variable using implicit substitution. (Contributed by NM, 17-May-1996.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem gencbvex {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (ch: wff x3) (th: wff y1) (A2: class x3):
  $ wcel A2 cvv $ >
  $ wi (wceq A2 (cv y1)) (wb ph ps) $ >
  $ wi (wceq A2 (cv y1)) (wb ch th) $ >
  $ wb th (wex x3 (wa ch (wceq A2 (cv y1)))) $ >
  $ wb (wex x3 (wa ch ph)) (wex y1 (wa th ps)) $;

--| Restatement of ~ gencbvex with weaker hypotheses. (Contributed by Jeff Hankins, 6-Dec-2006.)
theorem gencbvex2 {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (ch: wff x3) (th: wff y1) (A2: class x3):
  $ wcel A2 cvv $ >
  $ wi (wceq A2 (cv y1)) (wb ph ps) $ >
  $ wi (wceq A2 (cv y1)) (wb ch th) $ >
  $ wi th (wex x3 (wa ch (wceq A2 (cv y1)))) $ >
  $ wb (wex x3 (wa ch ph)) (wex y1 (wa th ps)) $;

--| Change of bound variable using implicit substitution. (Contributed by NM, 17-May-1996.) (Proof rewritten by Jim Kingdon, 20-Jun-2018.)
theorem gencbval {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (ch: wff x3) (th: wff y1) (A2: class x3):
  $ wcel A2 cvv $ >
  $ wi (wceq A2 (cv y1)) (wb ph ps) $ >
  $ wi (wceq A2 (cv y1)) (wb ch th) $ >
  $ wb th (wex x3 (wa ch (wceq A2 (cv y1)))) $ >
  $ wb (wal x3 (wi ch ph)) (wal y1 (wi th ps)) $;

--| Introduce an explicit substitution into an implicit substitution hypothesis. See also csbhypf . (Contributed by Raph Levien, 10-Apr-2004.)
theorem sbhypf {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class y1):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) A2) (wb (wsb x3 y1 ph) ps) $;

--| Closed theorem form of ~ vtoclgf . (Contributed by NM, 17-Feb-2013.) (Revised by Mario Carneiro, 12-Oct-2016.)
theorem vtoclgft {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wi (w3a (wa (wnfc x3 A2) (wnf x3 ps)) (wa (wal x3 (wi (wceq (cv x3) A2) (wb ph ps))) (wal x3 ph)) (wcel A2 V)) ps $;

--| Implicit substitution of a class for a setvar variable. (Contributed by Mario Carneiro, 15-Oct-2016.)
theorem vtocldf {x3: setvar} (ph ps ch: wff x3) (A2 V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph ps $ >
  $ wnf x3 ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph ch $;

--| Implicit substitution of a class for a setvar variable. (Contributed by Mario Carneiro, 15-Oct-2016.)
theorem vtocld {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class) (V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph ps $ >
  $ wi ph ch $;

--| Implicit substitution of a class for a setvar variable. This is a generalization of ~ chvar . (Contributed by NM, 30-Aug-1993.)
theorem vtoclf {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wnf x3 ps $ >
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ ph $ >
  $ ps $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 30-Aug-1993.)
theorem vtocl {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ ph $ >
  $ ps $;

--| Implicit substitution of classes for setvar variables. (Contributed by NM, 26-Jul-1995.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem vtocl2 {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ ph $ >
  $ ps $;

--| Implicit substitution of classes for setvar variables. (Contributed by NM, 3-Jun-1995.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem vtocl3 {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff) (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wi (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) (wb ph ps) $ >
  $ ph $ >
  $ ps $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 23-Dec-1993.)
theorem vtoclb {x3: setvar} (ph ps: wff x3) (ch th: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv x3) A2) (wb ps th) $ >
  $ wb ph ps $ >
  $ wb ch th $;

--| Implicit substitution of a class for a setvar variable, with bound-variable hypotheses in place of distinct variable restrictions. (Contributed by NM, 21-Sep-2003.) (Proof shortened by Mario Carneiro, 10-Oct-2016.)
theorem vtoclgf {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ ph $ >
  $ wi (wcel A2 V) ps $;

--| Implicit substitution of a class expression for a setvar variable. (Contributed by NM, 17-Apr-1995.)
theorem vtoclg {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ ph $ >
  $ wi (wcel A2 V) ps $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 29-Apr-1994.)
theorem vtoclbg {x3: setvar} (ph ps: wff x3) (ch th: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv x3) A2) (wb ps th) $ >
  $ wb ph ps $ >
  $ wi (wcel A2 V) (wb ch th) $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 25-Apr-1995.)
theorem vtocl2gf {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2 B2 V W: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnf x3 ps $ >
  $ wnf y1 ch $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ ph $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) ch $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 10-Aug-2013.) (Revised by Mario Carneiro, 10-Oct-2016.)
theorem vtocl3gf {x3 y1 z: setvar} (ph ps ch th: wff x3 y1 z) (A2 B2 C V W X: class x3 y1 z):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc z A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc z B2 $ >
  $ wnfc z C $ >
  $ wnf x3 ps $ >
  $ wnf y1 ch $ >
  $ wnf z th $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ ph $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) th $;

--| Implicit substitution of 2 classes for 2 setvar variables. (Contributed by NM, 25-Apr-1995.)
theorem vtocl2g {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1) (ch: wff x3) (A2: class) (B2: class x3) (V W: class x3 y1):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ ph $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) ch $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 17-Feb-2006.) (Revised by Mario Carneiro, 10-Oct-2016.)
theorem vtoclgaf {x3: setvar} (ph ps: wff x3) (A2: class x3) (B2: class):
  $ wnfc x3 A2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel (cv x3) B2) ph $ >
  $ wi (wcel A2 B2) ps $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 20-Aug-1995.)
theorem vtoclga {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel (cv x3) B2) ph $ >
  $ wi (wcel A2 B2) ps $;

--| Implicit substitution of 2 classes for 2 setvar variables. (Contributed by NM, 10-Aug-2013.)
theorem vtocl2gaf {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2 B2: class x3 y1) (C D: class):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnf x3 ps $ >
  $ wnf y1 ch $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wa (wcel (cv x3) C) (wcel (cv y1) D)) ph $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) ch $;

--| Implicit substitution of 2 classes for 2 setvar variables. (Contributed by NM, 20-Aug-1995.)
theorem vtocl2ga {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1) (ch: wff x3) (A2: class) (B2: class x3) (C D: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wa (wcel (cv x3) C) (wcel (cv y1) D)) ph $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) ch $;

--| Implicit substitution of 3 classes for 3 setvar variables. (Contributed by NM, 10-Aug-2013.) (Revised by Mario Carneiro, 11-Oct-2016.)
theorem vtocl3gaf {x3 y1 z: setvar} (ph ps ch th: wff x3 y1 z) (A2 B2 C: class x3 y1 z) (R S T: class):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc z A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc z B2 $ >
  $ wnfc z C $ >
  $ wnf x3 ps $ >
  $ wnf y1 ch $ >
  $ wnf z th $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ wi (w3a (wcel (cv x3) R) (wcel (cv y1) S) (wcel (cv z) T)) ph $ >
  $ wi (w3a (wcel A2 R) (wcel B2 S) (wcel C T)) th $;

--| Implicit substitution of 3 classes for 3 setvar variables. (Contributed by NM, 20-Aug-1995.)
theorem vtocl3ga {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff y1 z) (ch: wff x3 z) (th: wff x3 y1) (A2: class) (B2: class x3) (C: class x3 y1) (D R S: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ wi (w3a (wcel (cv x3) D) (wcel (cv y1) R) (wcel (cv z) S)) ph $ >
  $ wi (w3a (wcel A2 D) (wcel B2 R) (wcel C S)) th $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 10-Jan-2004.)
theorem vtocleg {x3: setvar} (ph: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) ph $ >
  $ wi (wcel A2 V) ph $;

--| Implicit substitution of a class for a setvar variable. (Closed theorem version of ~ vtoclef .) (Contributed by NM, 7-Nov-2005.) (Revised by Mario Carneiro, 11-Oct-2016.)
theorem vtoclegft {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3):
  $ wi (w3a (wcel A2 B2) (wnf x3 ph) (wal x3 (wi (wceq (cv x3) A2) ph))) ph $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 18-Aug-1993.)
theorem vtoclef {x3: setvar} (ph: wff x3) (A2: class):
  $ wnf x3 ph $ >
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) ph $ >
  $ ph $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 9-Sep-1993.)
theorem vtocle {x3: setvar} (ph: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) ph $ >
  $ ph $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 21-Nov-1994.)
theorem vtoclri {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wral x3 ph B2 $ >
  $ wi (wcel A2 B2) ps $;

--| A closed version of ~ spcimgf . (Contributed by Mario Carneiro, 4-Jan-2017.)
theorem spcimgft {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wnf x3 ps $ >
  $ wnfc x3 A2 $ >
  $ wi (wal x3 (wi (wceq (cv x3) A2) (wi ph ps))) (wi (wcel A2 B2) (wi (wal x3 ph) ps)) $;

--| A closed version of ~ spcgf . (Contributed by Andrew Salmon, 6-Jun-2011.) (Revised by Mario Carneiro, 4-Jan-2017.)
theorem spcgft {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wnf x3 ps $ >
  $ wnfc x3 A2 $ >
  $ wi (wal x3 (wi (wceq (cv x3) A2) (wb ph ps))) (wi (wcel A2 B2) (wi (wal x3 ph) ps)) $;

--| A closed version of ~ spcimegf . (Contributed by Mario Carneiro, 4-Jan-2017.)
theorem spcimegft {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wnf x3 ps $ >
  $ wnfc x3 A2 $ >
  $ wi (wal x3 (wi (wceq (cv x3) A2) (wi ps ph))) (wi (wcel A2 B2) (wi ps (wex x3 ph))) $;

--| A closed version of ~ spcegf . (Contributed by Jim Kingdon, 22-Jun-2018.)
theorem spcegft {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wnf x3 ps $ >
  $ wnfc x3 A2 $ >
  $ wi (wal x3 (wi (wceq (cv x3) A2) (wb ph ps))) (wi (wcel A2 B2) (wi ps (wex x3 ph))) $;

--| Rule of specialization, using implicit substitution. Compare Theorem 7.3 of [Quine] p. 44. (Contributed by Mario Carneiro, 4-Jan-2017.)
theorem spcimgf {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wi ph ps) $ >
  $ wi (wcel A2 V) (wi (wal x3 ph) ps) $;

--| Existential specialization, using implicit substitution. (Contributed by Mario Carneiro, 4-Jan-2017.)
theorem spcimegf {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wi ps ph) $ >
  $ wi (wcel A2 V) (wi ps (wex x3 ph)) $;

--| Rule of specialization, using implicit substitution. Compare Theorem 7.3 of [Quine] p. 44. (Contributed by NM, 2-Feb-1997.) (Revised by Andrew Salmon, 12-Aug-2011.)
theorem spcgf {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wi (wal x3 ph) ps) $;

--| Existential specialization, using implicit substitution. (Contributed by NM, 2-Feb-1997.)
theorem spcegf {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wi ps (wex x3 ph)) $;

--| Restricted specialization, using implicit substitution. (Contributed by Mario Carneiro, 4-Jan-2017.)
theorem spcimdv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class) (B2: class x3):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wi ps ch) $ >
  $ wi ph (wi (wal x3 ps) ch) $;

--| Rule of specialization, using implicit substitution. Analogous to ~ rspcdv . (Contributed by David Moews, 1-May-2017.)
theorem spcdv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class) (B2: class x3):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wi (wal x3 ps) ch) $;

--| Restricted existential specialization, using implicit substitution. (Contributed by Mario Carneiro, 4-Jan-2017.)
theorem spcimedv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class) (B2: class x3):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wi ch ps) $ >
  $ wi ph (wi ch (wex x3 ps)) $;

--| Rule of specialization, using implicit substitution. Compare Theorem 7.3 of [Quine] p. 44. (Contributed by NM, 22-Jun-1994.)
theorem spcgv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wi (wal x3 ph) ps) $;

--| Existential specialization, using implicit substitution. (Contributed by NM, 14-Aug-1994.)
theorem spcegv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wi ps (wex x3 ph)) $;

--| Existential specialization with 2 quantifiers, using implicit substitution. (Contributed by NM, 3-Aug-1995.)
theorem spc2egv {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class) (V W: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wi ps (wex x3 (wex y1 ph))) $;

--| Specialization with 2 quantifiers, using implicit substitution. (Contributed by NM, 27-Apr-2004.)
theorem spc2gv {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class) (V W: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wi (wal x3 (wal y1 ph)) ps) $;

--| Existential specialization with 3 quantifiers, using implicit substitution. (Contributed by NM, 12-May-2008.)
theorem spc3egv {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff) (A2 B2 C: class) (V W X: class x3 y1 z):
  $ wi (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) (wb ph ps) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wi ps (wex x3 (wex y1 (wex z ph)))) $;

--| Specialization with 3 quantifiers, using implicit substitution. (Contributed by NM, 12-May-2008.)
theorem spc3gv {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff) (A2 B2 C: class) (V W X: class x3 y1 z):
  $ wi (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) (wb ph ps) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wi (wal x3 (wal y1 (wal z ph))) ps) $;

--| Rule of specialization, using implicit substitution. (Contributed by NM, 22-Jun-1994.)
theorem spcv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wal x3 ph) ps $;

--| Existential specialization, using implicit substitution. (Contributed by NM, 31-Dec-1993.) (Proof shortened by Eric Schmidt, 22-Dec-2006.)
theorem spcev {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi ps (wex x3 ph) $;

--| Existential specialization, using implicit substitution. (Contributed by NM, 3-Aug-1995.)
theorem spc2ev {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wi ps (wex x3 (wex y1 ph)) $;

--| A closed version of ~ rspc . (Contributed by Andrew Salmon, 6-Jun-2011.)
theorem rspct {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wnf x3 ps $ >
  $ wi (wal x3 (wi (wceq (cv x3) A2) (wb ph ps))) (wi (wcel A2 B2) (wi (wral x3 ph B2) ps)) $;

--| Restricted specialization, using implicit substitution. (Contributed by NM, 19-Apr-2005.) (Revised by Mario Carneiro, 11-Oct-2016.)
theorem rspc {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 B2) (wi (wral x3 ph B2) ps) $;

--| Restricted existential specialization, using implicit substitution. (Contributed by NM, 26-May-1998.) (Revised by Mario Carneiro, 11-Oct-2016.)
theorem rspce {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wa (wcel A2 B2) ps) (wrex x3 ph B2) $;

--| Restricted specialization, using implicit substitution. (Contributed by NM, 26-May-1998.)
theorem rspcv {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 B2) (wi (wral x3 ph B2) ps) $;

--| Restricted specialization, using implicit substitution. (Contributed by NM, 2-Feb-2006.)
theorem rspccv {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wral x3 ph B2) (wi (wcel A2 B2) ps) $;

--| Restricted specialization, using implicit substitution. (Contributed by NM, 13-Sep-2005.)
theorem rspcva {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wa (wcel A2 B2) (wral x3 ph B2)) ps $;

--| Restricted specialization, using implicit substitution. (Contributed by NM, 26-Jul-2006.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem rspccva {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wa (wral x3 ph B2) (wcel A2 B2)) ps $;

--| Restricted existential specialization, using implicit substitution. (Contributed by NM, 26-May-1998.)
theorem rspcev {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wa (wcel A2 B2) ps) (wrex x3 ph B2) $;

--| Restricted specialization, using implicit substitution. (Contributed by Mario Carneiro, 4-Jan-2017.)
theorem rspcimdv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2 B2: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wi ps ch) $ >
  $ wi ph (wi (wral x3 ps B2) ch) $;

--| Restricted existential specialization, using implicit substitution. (Contributed by Mario Carneiro, 4-Jan-2017.)
theorem rspcimedv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2 B2: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wi ch ps) $ >
  $ wi ph (wi ch (wrex x3 ps B2)) $;

--| Restricted specialization, using implicit substitution. (Contributed by NM, 17-Feb-2007.) (Revised by Mario Carneiro, 4-Jan-2017.)
theorem rspcdv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2 B2: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wi (wral x3 ps B2) ch) $;

--| Restricted existential specialization, using implicit substitution. (Contributed by FL, 17-Apr-2007.) (Revised by Mario Carneiro, 4-Jan-2017.)
theorem rspcedv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2 B2: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wi ch (wrex x3 ps B2)) $;

--| 2-variable restricted specialization, using implicit substitution. (Contributed by NM, 9-Nov-2012.)
theorem rspc2 {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2: class) (B2: class x3) (C: class y1) (D: class):
  $ wnf x3 ch $ >
  $ wnf y1 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv y1) B2) (wb ch ps) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wi (wral x3 (wral y1 ph D) C) ps) $;

--| 2-variable restricted specialization, using implicit substitution. (Contributed by NM, 13-Sep-1999.)
theorem rspc2v {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch: wff y1) (A2: class) (B2: class x3) (C: class y1) (D: class):
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv y1) B2) (wb ch ps) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wi (wral x3 (wral y1 ph D) C) ps) $;

--| 2-variable restricted specialization, using implicit substitution. (Contributed by NM, 18-Jun-2014.)
theorem rspc2va {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch: wff y1) (A2: class) (B2: class x3) (C: class y1) (D: class):
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv y1) B2) (wb ch ps) $ >
  $ wi (wa (wa (wcel A2 C) (wcel B2 D)) (wral x3 (wral y1 ph D) C)) ps $;

--| 2-variable restricted existential specialization, using implicit substitution. (Contributed by NM, 16-Oct-1999.)
theorem rspc2ev {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch: wff y1) (A2: class) (B2: class x3) (C: class y1) (D: class):
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv y1) B2) (wb ch ps) $ >
  $ wi (w3a (wcel A2 C) (wcel B2 D) ps) (wrex x3 (wrex y1 ph D) C) $;

--| 3-variable restricted specialization, using implicit substitution. (Contributed by NM, 10-May-2005.)
theorem rspc3v {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff x3 y1) (ch: wff y1 z) (th: wff x3 z) (A2: class) (B2: class x3) (C: class x3 y1) (R: class y1 z) (S: class z) (T: class):
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv y1) B2) (wb ch th) $ >
  $ wi (wceq (cv z) C) (wb th ps) $ >
  $ wi (w3a (wcel A2 R) (wcel B2 S) (wcel C T)) (wi (wral x3 (wral y1 (wral z ph T) S) R) ps) $;

--| 3-variable restricted existentional specialization, using implicit substitution. (Contributed by NM, 25-Jul-2012.)
theorem rspc3ev {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff x3 y1) (ch: wff y1 z) (th: wff x3 z) (A2: class) (B2: class x3) (C: class x3 y1) (R: class y1 z) (S: class z) (T: class):
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv y1) B2) (wb ch th) $ >
  $ wi (wceq (cv z) C) (wb th ps) $ >
  $ wi (wa (w3a (wcel A2 R) (wcel B2 S) (wcel C T)) ps) (wrex x3 (wrex y1 (wrex z ph T) S) R) $;

--| A variable introduction law for class equality. (Contributed by NM, 14-Apr-1995.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem eqvinc {x3: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wceq A2 B2) (wex x3 (wa (wceq (cv x3) A2) (wceq (cv x3) B2))) $;

--| A variable introduction law for class equality, deduction version. (Contributed by Thierry Arnoux, 2-Mar-2017.)
theorem eqvincg {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wceq A2 B2) (wex x3 (wa (wceq (cv x3) A2) (wceq (cv x3) B2)))) $;

--| A variable introduction law for class equality, using bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 14-Sep-2003.)
theorem eqvincf {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wcel A2 cvv $ >
  $ wb (wceq A2 B2) (wex x3 (wa (wceq (cv x3) A2) (wceq (cv x3) B2))) $;

--| Two ways to express substitution of ` A ` for ` x ` in ` ph ` . (Contributed by NM, 2-Mar-1995.)
theorem alexeq {x3: setvar} (ph: wff x3) (A2: class):
  $ wcel A2 cvv $ >
  $ wb (wal x3 (wi (wceq (cv x3) A2) ph)) (wex x3 (wa (wceq (cv x3) A2) ph)) $;

--| Equality implies equivalence with substitution. (Contributed by NM, 2-Mar-1995.)
theorem ceqex {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wceq (cv x3) A2) (wb ph (wex x3 (wa (wceq (cv x3) A2) ph))) $;

--| A representation of explicit substitution of a class for a variable, inferred from an implicit substitution hypothesis. (Contributed by NM, 11-Oct-2004.)
theorem ceqsexg {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wex x3 (wa (wceq (cv x3) A2) ph)) ps) $;

--| Elimination of an existential quantifier, using implicit substitution. (Contributed by NM, 29-Dec-1996.)
theorem ceqsexgv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wex x3 (wa (wceq (cv x3) A2) ph)) ps) $;

--| Elimination of a restricted existential quantifier, using implicit substitution. (Contributed by NM, 30-Apr-2004.)
theorem ceqsrexv {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 B2) (wb (wrex x3 (wa (wceq (cv x3) A2) ph) B2) ps) $;

--| Elimination of a restricted existential quantifier, using implicit substitution. (Contributed by Mario Carneiro, 14-Mar-2014.)
theorem ceqsrexbv {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wrex x3 (wa (wceq (cv x3) A2) ph) B2) (wa (wcel A2 B2) ps) $;

--| Elimination of a restricted existential quantifier, using implicit substitution. (Contributed by NM, 29-Oct-2005.)
theorem ceqsrex2v {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1) (ch: wff x3) (A2 B2: class) (C: class y1) (D: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wb (wrex x3 (wrex y1 (wa (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) ph) D) C) ch) $;

--| An alternate definition of class membership when the class is a set. (Contributed by NM, 18-Aug-1993.)
theorem clel2 {x3: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 B2) (wal x3 (wi (wceq (cv x3) A2) (wcel (cv x3) B2))) $;

--| An alternate definition of class membership when the class is a set. (Contributed by NM, 13-Aug-2005.)
theorem clel3g {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel B2 V) (wb (wcel A2 B2) (wex x3 (wa (wceq (cv x3) B2) (wcel A2 (cv x3))))) $;

--| An alternate definition of class membership when the class is a set. (Contributed by NM, 18-Aug-1993.)
theorem clel3 {x3: setvar} (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wb (wcel A2 B2) (wex x3 (wa (wceq (cv x3) B2) (wcel A2 (cv x3)))) $;

--| An alternate definition of class membership when the class is a set. (Contributed by NM, 18-Aug-1993.)
theorem clel4 {x3: setvar} (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wb (wcel A2 B2) (wal x3 (wi (wceq (cv x3) B2) (wcel A2 (cv x3)))) $;

--| Compare theorem *13.183 in [WhiteheadRussell] p. 178. Only ` A ` is required to be a set. (Contributed by Andrew Salmon, 3-Jun-2011.)
theorem pm13_183 {z: setvar} (A2 B2: class) (V: class z):
  $ wi (wcel A2 V) (wb (wceq A2 B2) (wal z (wb (wceq (cv z) A2) (wceq (cv z) B2)))) $;

--| Restricted quantifier version of Theorem 19.3 of [Margaris] p. 89. (Contributed by NM, 25-Oct-2012.)
theorem rr19_3v {x3 y1: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wral x3 (wral y1 ph A2) A2) (wral x3 ph A2) $;

--| Restricted quantifier version of Theorem 19.28 of [Margaris] p. 90. (Contributed by NM, 29-Oct-2012.)
theorem rr19_28v {x3 y1: setvar} (ph: wff x3) (ps: wff x3 y1) (A2: class x3):
  $ wb (wral x3 (wral y1 (wa ph ps) A2) A2) (wral x3 (wa ph (wral y1 ps A2)) A2) $;

--| Membership in a class abstraction, using implicit substitution. (Closed theorem version of ~ elabg .) (Contributed by NM, 7-Nov-2005.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem elabgt {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2: class x3):
  $ wi (wa (wcel A2 B2) (wal x3 (wi (wceq (cv x3) A2) (wb ph ps)))) (wb (wcel A2 (cab x3 ph)) ps) $;

--| Membership in a class abstraction, using implicit substitution. Compare Theorem 6.13 of [Quine] p. 44. This version has bound-variable hypotheses in place of distinct variable restrictions. (Contributed by NM, 21-Sep-2003.) (Revised by Mario Carneiro, 12-Oct-2016.)
theorem elabgf {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 B2) (wb (wcel A2 (cab x3 ph)) ps) $;

--| Membership in a class abstraction, using implicit substitution. (Contributed by NM, 1-Aug-1994.) (Revised by Mario Carneiro, 12-Oct-2016.)
theorem elabf {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wnf x3 ps $ >
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wcel A2 (cab x3 ph)) ps $;

--| Membership in a class abstraction, using implicit substitution. Compare Theorem 6.13 of [Quine] p. 44. (Contributed by NM, 1-Aug-1994.)
theorem elab {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wcel A2 (cab x3 ph)) ps $;

--| Membership in a class abstraction, using implicit substitution. Compare Theorem 6.13 of [Quine] p. 44. (Contributed by NM, 14-Apr-1995.)
theorem elabg {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wcel A2 (cab x3 ph)) ps) $;

--| Membership in a class abstraction, using implicit substitution. (Contributed by NM, 13-Sep-1995.)
theorem elab2g {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2 V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wceq B2 (cab x3 ph) $ >
  $ wi (wcel A2 V) (wb (wcel A2 B2) ps) $;

--| Membership in a class abstraction, using implicit substitution. (Contributed by NM, 13-Sep-1995.)
theorem elab2 {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2: class x3):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wceq B2 (cab x3 ph) $ >
  $ wb (wcel A2 B2) ps $;

--| Membership in a class abstraction, using implicit substitution. (Contributed by NM, 17-Oct-2012.)
theorem elab4g {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wceq B2 (cab x3 ph) $ >
  $ wb (wcel A2 B2) (wa (wcel A2 cvv) ps) $;

--| Membership in a class abstraction, with a weaker antecedent than ~ elabgf . (Contributed by NM, 6-Sep-2011.)
theorem elab3gf {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wi ps (wcel A2 B2)) (wb (wcel A2 (cab x3 ph)) ps) $;

--| Membership in a class abstraction, with a weaker antecedent than ~ elabg . (Contributed by NM, 29-Aug-2006.)
theorem elab3g {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wi ps (wcel A2 B2)) (wb (wcel A2 (cab x3 ph)) ps) $;

--| Membership in a class abstraction using implicit substitution. (Contributed by NM, 10-Nov-2000.)
theorem elab3 {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wi ps (wcel A2 cvv) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wcel A2 (cab x3 ph)) ps $;

--| Implication for the membership in a restricted class abstraction. (Contributed by Alexander van der Vekens, 31-Dec-2017.)
theorem elrabi {x3: setvar} (ph: wff x3) (A2 V: class):
  $ wi (wcel A2 (crab x3 ph V)) (wcel A2 V) $;

--| Membership in a restricted class abstraction, using implicit substitution. This version has bound-variable hypotheses in place of distinct variable restrictions. (Contributed by NM, 21-Sep-2003.)
theorem elrabf {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wcel A2 (crab x3 ph B2)) (wa (wcel A2 B2) ps) $;

--| Membership in a restricted class abstraction, using implicit substitution. (Closed theorem version of ~ elrab3 .) (Contributed by Thierry Arnoux, 31-Aug-2017.)
theorem elrab3t {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wa (wal x3 (wi (wceq (cv x3) A2) (wb ph ps))) (wcel A2 B2)) (wb (wcel A2 (crab x3 ph B2)) ps) $;

--| Membership in a restricted class abstraction, using implicit substitution. (Contributed by NM, 21-May-1999.)
theorem elrab {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wcel A2 (crab x3 ph B2)) (wa (wcel A2 B2) ps) $;

--| Membership in a restricted class abstraction, using implicit substitution. (Contributed by NM, 5-Oct-2006.)
theorem elrab3 {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 B2) (wb (wcel A2 (crab x3 ph B2)) ps) $;

--| Membership in a class abstraction, using implicit substitution. (Contributed by NM, 2-Nov-2006.)
theorem elrab2 {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class) (C: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wceq C (crab x3 ph B2) $ >
  $ wb (wcel A2 C) (wa (wcel A2 B2) ps) $;

--| Universal quantification over a class abstraction. (Contributed by Jeff Madsen, 10-Jun-2010.)
theorem ralab {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch: wff x3 y1):
  $ wi (wceq (cv y1) (cv x3)) (wb ph ps) $ >
  $ wb (wral x3 ch (cab y1 ph)) (wal x3 (wi ps ch)) $;

--| Universal quantification over a restricted class abstraction. (Contributed by Jeff Madsen, 10-Jun-2010.)
theorem ralrab {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch: wff x3 y1) (A2: class x3):
  $ wi (wceq (cv y1) (cv x3)) (wb ph ps) $ >
  $ wb (wral x3 ch (crab y1 ph A2)) (wral x3 (wi ps ch) A2) $;

--| Existential quantification over a class abstraction. (Contributed by Mario Carneiro, 23-Jan-2014.) (Revised by Mario Carneiro, 3-Sep-2015.)
theorem rexab {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch: wff x3 y1):
  $ wi (wceq (cv y1) (cv x3)) (wb ph ps) $ >
  $ wb (wrex x3 ch (cab y1 ph)) (wex x3 (wa ps ch)) $;

--| Existential quantification over a class abstraction. (Contributed by Jeff Madsen, 17-Jun-2011.) (Revised by Mario Carneiro, 3-Sep-2015.)
theorem rexrab {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch: wff x3 y1) (A2: class x3):
  $ wi (wceq (cv y1) (cv x3)) (wb ph ps) $ >
  $ wb (wrex x3 ch (crab y1 ph A2)) (wrex x3 (wa ps ch) A2) $;

--| Universal quantification over a class abstraction. (Contributed by Mario Carneiro, 3-Sep-2015.)
theorem ralab2 {x3 y1: setvar} (ph: wff y1) (ps: wff x3) (ch: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ps ch) $ >
  $ wb (wral x3 ps (cab y1 ph)) (wal y1 (wi ph ch)) $;

--| Universal quantification over a restricted class abstraction. (Contributed by Mario Carneiro, 3-Sep-2015.)
theorem ralrab2 {x3 y1: setvar} (ph: wff y1) (ps: wff x3) (ch: wff y1) (A2: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ps ch) $ >
  $ wb (wral x3 ps (crab y1 ph A2)) (wral y1 (wi ph ch) A2) $;

--| Existential quantification over a class abstraction. (Contributed by Mario Carneiro, 3-Sep-2015.)
theorem rexab2 {x3 y1: setvar} (ph: wff y1) (ps: wff x3) (ch: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ps ch) $ >
  $ wb (wrex x3 ps (cab y1 ph)) (wex y1 (wa ph ch)) $;

--| Existential quantification over a class abstraction. (Contributed by Mario Carneiro, 3-Sep-2015.)
theorem rexrab2 {x3 y1: setvar} (ph: wff y1) (ps: wff x3) (ch: wff y1) (A2: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ps ch) $ >
  $ wb (wrex x3 ps (crab y1 ph A2)) (wrex y1 (wa ph ch) A2) $;

--| Identity used to create closed-form versions of bound-variable hypothesis builders for class expressions. (Contributed by NM, 10-Nov-2005.) (Proof shortened by Mario Carneiro, 12-Oct-2016.)
theorem abidnf {x3 z: setvar} (A2: class x3):
  $ wi (wnfc x3 A2) (wceq (cab z (wal x3 (wcel (cv z) A2))) A2) $;

--| A deduction theorem for converting the inference ` |- F/_ x A ` => ` |- ph ` into a closed theorem. Use ~ nfa1 and ~ nfab to eliminate the hypothesis of the substitution instance ` ps ` of the inference. For converting the inference form into a deduction form, ~ abidnf is useful. (Contributed by NM, 8-Dec-2006.)
theorem dedhb {x3 z: setvar} (ph ps: wff x3 z) (A2: class x3):
  $ wi (wceq A2 (cab z (wal x3 (wcel (cv z) A2)))) (wb ph ps) $ >
  $ ps $ >
  $ wi (wnfc x3 A2) ph $;

--| A condition which implies existential uniqueness. (Contributed by Jeff Hankins, 8-Sep-2009.)
theorem eqeu {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (w3a (wcel A2 B2) ps (wal x3 (wi ph (wceq (cv x3) A2)))) (weu x3 ph) $;

--| Equality has existential uniqueness. (Contributed by NM, 25-Nov-1994.)
theorem eueq {x3: setvar} (A2: class):
  $ wb (wcel A2 cvv) (weu x3 (wceq (cv x3) A2)) $;

--| Equality has existential uniqueness. (Contributed by NM, 5-Apr-1995.)
theorem eueq1 {x3: setvar} (A2: class):
  $ wcel A2 cvv $ >
  $ weu x3 (wceq (cv x3) A2) $;

--| Equality has existential uniqueness (split into 2 cases). (Contributed by NM, 5-Apr-1995.)
theorem eueq2dc {x3: setvar} (ph: wff) (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wdc ph) (weu x3 (wo (wa ph (wceq (cv x3) A2)) (wa (wn ph) (wceq (cv x3) B2)))) $;

--| Equality has existential uniqueness (split into 3 cases). (Contributed by NM, 5-Apr-1995.) (Proof shortened by Mario Carneiro, 28-Sep-2015.)
theorem eueq3dc {x3: setvar} (ph ps: wff) (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wn (wa ph ps) $ >
  $ wi (wdc ph) (wi (wdc ps) (weu x3 (w3o (wa ph (wceq (cv x3) A2)) (wa (wn (wo ph ps)) (wceq (cv x3) B2)) (wa ps (wceq (cv x3) C))))) $;

--| There is at most one set equal to a class. (Contributed by NM, 8-Mar-1995.)
theorem moeq {x3: setvar} (A2: class):
  $ wmo x3 (wceq (cv x3) A2) $;

--| "At most one" property of equality (split into 3 cases). (Contributed by Jim Kingdon, 7-Jul-2018.)
theorem moeq3dc {x3: setvar} (ph ps: wff) (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wn (wa ph ps) $ >
  $ wi (wdc ph) (wi (wdc ps) (wmo x3 (w3o (wa ph (wceq (cv x3) A2)) (wa (wn (wo ph ps)) (wceq (cv x3) B2)) (wa ps (wceq (cv x3) C))))) $;

--| "At most one" remains true after substitution. (Contributed by Jim Kingdon, 18-Jan-2019.)
theorem mosubt {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wi (wal y1 (wmo x3 ph)) (wmo x3 (wex y1 (wa (wceq (cv y1) A2) ph))) $;

--| "At most one" remains true after substitution. (Contributed by NM, 9-Mar-1995.)
theorem mosub {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wmo x3 ph $ >
  $ wmo x3 (wex y1 (wa (wceq (cv y1) A2) ph)) $;

--| Theorem for inferring "at most one." (Contributed by NM, 17-Oct-1996.)
theorem mo2icl {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wal x3 (wi ph (wceq (cv x3) A2))) (wmo x3 ph) $;

--| Consequence of "at most one." (Contributed by NM, 2-Jan-2015.)
theorem mob2 {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (w3a (wcel A2 B2) (wmo x3 ph) ph) (wb (wceq (cv x3) A2) ps) $;

--| Consequence of "at most one." (Contributed by NM, 29-Jun-2008.)
theorem moi2 {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wa (wa (wcel A2 B2) (wmo x3 ph)) (wa ph ps)) (wceq (cv x3) A2) $;

--| Equality implied by "at most one." (Contributed by NM, 18-Feb-2006.)
theorem mob {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2: class) (C D: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (w3a (wa (wcel A2 C) (wcel B2 D)) (wmo x3 ph) ps) (wb (wceq A2 B2) ch) $;

--| Equality implied by "at most one." (Contributed by NM, 18-Feb-2006.)
theorem moi {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2: class) (C D: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (w3a (wa (wcel A2 C) (wcel B2 D)) (wmo x3 ph) (wa ps ch)) (wceq A2 B2) $;

--| Derive membership from uniqueness. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem morex {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (wa (wrex x3 ph A2) (wmo x3 ph)) (wi ps (wcel B2 A2)) $;

--| Transfer existential uniqueness from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by NM, 14-Nov-2004.)
theorem euxfr2dc {x3 y1: setvar} (ph: wff y1) (A2: class y1):
  $ wcel A2 cvv $ >
  $ wmo y1 (wceq (cv x3) A2) $ >
  $ wi (wdc (wex y1 (wex x3 (wa (wceq (cv x3) A2) ph)))) (wb (weu x3 (wex y1 (wa (wceq (cv x3) A2) ph))) (weu y1 ph)) $;

--| Transfer existential uniqueness from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by NM, 14-Nov-2004.)
theorem euxfrdc {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class y1):
  $ wcel A2 cvv $ >
  $ weu y1 (wceq (cv x3) A2) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wdc (wex y1 (wex x3 (wa (wceq (cv x3) A2) ps)))) (wb (weu x3 ph) (weu y1 ps)) $;

--| Existential uniqueness via an indirect equality. (Contributed by NM, 11-Oct-2010.)
theorem euind {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1) (A2: class x3) (B2: class y1):
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wi (wa (wal x3 (wal y1 (wi (wa ph ps) (wceq A2 B2)))) (wex x3 ph)) (weu z (wal x3 (wi ph (wceq (cv z) A2)))) $;

--| A way to express restricted uniqueness. (Contributed by NM, 22-Nov-1994.)
theorem reu2 {x3 y1: setvar} (ph: wff x3) (A2: class):
  $ wb (wreu x3 ph A2) (wa (wrex x3 ph A2) (wral x3 (wral y1 (wi (wa ph (wsb x3 y1 ph)) (wceq (cv x3) (cv y1))) A2) A2)) $;

--| A way to express restricted uniqueness. (Contributed by NM, 20-Oct-2006.)
theorem reu6 {x3 y1: setvar} (ph: wff x3) (A2: class):
  $ wb (wreu x3 ph A2) (wrex y1 (wral x3 (wb ph (wceq (cv x3) (cv y1))) A2) A2) $;

--| A way to express restricted uniqueness. (Contributed by NM, 24-Oct-2006.)
theorem reu3 {x3 y1: setvar} (ph: wff x3) (A2: class):
  $ wb (wreu x3 ph A2) (wa (wrex x3 ph A2) (wrex y1 (wral x3 (wi ph (wceq (cv x3) (cv y1))) A2) A2)) $;

--| A condition which implies existential uniqueness. (Contributed by Mario Carneiro, 2-Oct-2015.)
theorem reu6i {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wa (wcel B2 A2) (wral x3 (wb ph (wceq (cv x3) B2)) A2)) (wreu x3 ph A2) $;

--| A condition which implies existential uniqueness. (Contributed by Mario Carneiro, 2-Oct-2015.)
theorem eqreu {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (w3a (wcel B2 A2) ps (wral x3 (wi ph (wceq (cv x3) B2)) A2)) (wreu x3 ph A2) $;

--| Restricted "at most one" using implicit substitution. (Contributed by NM, 24-Oct-2006.) (Revised by NM, 16-Jun-2017.)
theorem rmo4 {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrmo x3 ph A2) (wral x3 (wral y1 (wi (wa ph ps) (wceq (cv x3) (cv y1))) A2) A2) $;

--| Restricted uniqueness using implicit substitution. (Contributed by NM, 23-Nov-1994.)
theorem reu4 {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wreu x3 ph A2) (wa (wrex x3 ph A2) (wral x3 (wral y1 (wi (wa ph ps) (wceq (cv x3) (cv y1))) A2) A2)) $;

--| Restricted uniqueness using implicit substitution. (Contributed by NM, 24-Oct-2006.)
theorem reu7 {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wreu x3 ph A2) (wa (wrex x3 ph A2) (wrex x3 (wral y1 (wi ps (wceq (cv x3) (cv y1))) A2) A2)) $;

--| Restricted uniqueness using implicit substitution. (Contributed by NM, 24-Oct-2006.)
theorem reu8 {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wreu x3 ph A2) (wrex x3 (wa ph (wral y1 (wi ps (wceq (cv x3) (cv y1))) A2)) A2) $;

--| Equality has existential uniqueness. (Contributed by Mario Carneiro, 1-Sep-2015.)
theorem reueq {x3: setvar} (A2 B2: class):
  $ wb (wcel B2 A2) (wreu x3 (wceq (cv x3) B2) A2) $;

--| Restricted "at most one" still holds when a conjunct is added. (Contributed by NM, 16-Jun-2017.)
theorem rmoan {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wrmo x3 ph A2) (wrmo x3 (wa ps ph) A2) $;

--| Restricted "at most one" is preserved through implication (note wff reversal). (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem rmoim {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wral x3 (wi ph ps) A2) (wi (wrmo x3 ps A2) (wrmo x3 ph A2)) $;

--| Restricted "at most one" is preserved through implication (note wff reversal). (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem rmoimia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wi ph ps) $ >
  $ wi (wrmo x3 ps A2) (wrmo x3 ph A2) $;

--| Restricted "at most one" is preserved through implication (note wff reversal). (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem rmoimi2 {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wal x3 (wi (wa (wcel (cv x3) A2) ph) (wa (wcel (cv x3) B2) ps)) $ >
  $ wi (wrmo x3 ps B2) (wrmo x3 ph A2) $;

--| A condition allowing swap of uniqueness and existential quantifiers. (Contributed by Thierry Arnoux, 7-Apr-2017.) (Revised by NM, 16-Jun-2017.)
theorem _2reuswapdc {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (B2: class y1):
  $ wi (wdc (wex x3 (wex y1 (wa (wcel (cv x3) A2) (wa (wcel (cv y1) B2) ph))))) (wi (wral x3 (wrmo y1 ph B2) A2) (wi (wreu x3 (wrex y1 ph B2) A2) (wreu y1 (wrex x3 ph A2) B2))) $;

--| Existential uniqueness via an indirect equality. (Contributed by NM, 16-Oct-2010.)
theorem reuind {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1) (A2: class x3) (B2: class y1) (C: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wi (wa (wal x3 (wal y1 (wi (wa (wa (wcel A2 C) ph) (wa (wcel B2 C) ps)) (wceq A2 B2)))) (wex x3 (wa (wcel A2 C) ph))) (wreu z (wal x3 (wi (wa (wcel A2 C) ph) (wceq (cv z) A2))) C) $;

--| Double restricted quantification with "at most one," analogous to ~ 2moex . (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem _2rmorex {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wi (wrmo x3 (wrex y1 ph B2) A2) (wral y1 (wrmo x3 ph A2) B2) $;

--| Deduce negative membership from an implication. (Contributed by Thierry Arnoux, 27-Nov-2017.)
theorem nelrdva {x3: setvar} (ph: wff) (A2 B2: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wne (cv x3) B2) $ >
  $ wi ph (wn (wcel B2 A2)) $;

--| Extend wff notation to include conditional equality. This is a technical device used in the proof that ` F/ ` is the not-free predicate, and that definitions are conservative as a result.
term wcdeq {x3 y1: setvar} (ph: wff x3 y1): wff;

--| Define conditional equality. All the notation to the left of the ` <-> ` is fake; the parentheses and arrows are all part of the notation, which could equally well be written ` CondEq x y ph ` . On the right side is the actual implication arrow. The reason for this definition is to "flatten" the structure on the right side (whose tree structure is something like (wi (wceq (cv vx) (cv vy)) wph) ) into just (wcdeq vx vy wph). (Contributed by Mario Carneiro, 11-Aug-2016.)
axiom df_cdeq {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wcdeq x3 y1 ph) (wi (wceq (cv x3) (cv y1)) ph) $;

--| Deduce conditional equality. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqi {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) ph $ >
  $ wcdeq x3 y1 ph $;

--| Property of conditional equality. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqri {x3 y1: setvar} (ph: wff x3 y1):
  $ wcdeq x3 y1 ph $ >
  $ wi (wceq (cv x3) (cv y1)) ph $;

--| Deduce conditional equality from a theorem. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqth {x3 y1: setvar} (ph: wff x3 y1):
  $ ph $ >
  $ wcdeq x3 y1 ph $;

--| Distribute conditional equality over negation. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqnot {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wcdeq x3 y1 (wb ph ps) $ >
  $ wcdeq x3 y1 (wb (wn ph) (wn ps)) $;

--| Distribute conditional equality over quantification. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqal {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wcdeq x3 y1 (wb ph ps) $ >
  $ wcdeq x3 y1 (wb (wal z ph) (wal z ps)) $;

--| Distribute conditional equality over abstraction. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqab {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wcdeq x3 y1 (wb ph ps) $ >
  $ wcdeq x3 y1 (wceq (cab z ph) (cab z ps)) $;

--| Distribute conditional equality over quantification. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqal1 {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wcdeq x3 y1 (wb ph ps) $ >
  $ wcdeq x3 y1 (wb (wal x3 ph) (wal y1 ps)) $;

--| Distribute conditional equality over abstraction. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqab1 {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wcdeq x3 y1 (wb ph ps) $ >
  $ wcdeq x3 y1 (wceq (cab x3 ph) (cab y1 ps)) $;

--| Distribute conditional equality over implication. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqim {x3 y1: setvar} (ph ps ch th: wff x3 y1):
  $ wcdeq x3 y1 (wb ph ps) $ >
  $ wcdeq x3 y1 (wb ch th) $ >
  $ wcdeq x3 y1 (wb (wi ph ch) (wi ps th)) $;

--| Conditional equality for set-to-class promotion. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqcv {x3 y1: setvar}:
  $ wcdeq x3 y1 (wceq (cv x3) (cv y1)) $;

--| Distribute conditional equality over equality. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqeq {x3 y1: setvar} (A2 B2 C D: class x3 y1):
  $ wcdeq x3 y1 (wceq A2 B2) $ >
  $ wcdeq x3 y1 (wceq C D) $ >
  $ wcdeq x3 y1 (wb (wceq A2 C) (wceq B2 D)) $;

--| Distribute conditional equality over elementhood. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqel {x3 y1: setvar} (A2 B2 C D: class x3 y1):
  $ wcdeq x3 y1 (wceq A2 B2) $ >
  $ wcdeq x3 y1 (wceq C D) $ >
  $ wcdeq x3 y1 (wb (wcel A2 C) (wcel B2 D)) $;

--| If we have a conditional equality proof, where ` ph ` is ` ph ( x ) ` and ` ps ` is ` ph ( y ) ` , and ` ph ( x ) ` in fact does not have ` x ` free in it according to ` F/ ` , then ` ph ( x ) <-> ph ( y ) ` unconditionally. This proves that ` F/ x ph ` is actually a not-free predicate. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfcdeq {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wnf x3 ph $ >
  $ wcdeq x3 y1 (wb ph ps) $ >
  $ wb ph ps $;

--| Variation of ~ nfcdeq for classes. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem nfccdeq {x3 y1: setvar} (A2: class x3) (B2: class y1):
  $ wnfc x3 A2 $ >
  $ wcdeq x3 y1 (wceq A2 B2) $ >
  $ wceq A2 B2 $;

--| Russell's Paradox. Proposition 4.14 of [TakeutiZaring] p. 14. In the late 1800s, Frege's Axiom of (unrestricted) Comprehension, expressed in our notation as ` A e. _V ` , asserted that any collection of sets ` A ` is a set i.e. belongs to the universe ` _V ` of all sets. In particular, by substituting ` { x | x e/ x } ` (the "Russell class") for ` A ` , it asserted ` { x | x e/ x } e. _V ` , meaning that the "collection of all sets which are not members of themselves" is a set. However, here we prove ` { x | x e/ x } e/ _V ` . This contradiction was discovered by Russell in 1901 (published in 1903), invalidating the Comprehension Axiom and leading to the collapse of Frege's system. In 1908, Zermelo rectified this fatal flaw by replacing Comprehension with a weaker Subset (or Separation) Axiom asserting that ` A ` is a set only when it is smaller than some other set ` B ` . The intuitionistic set theory IZF includes such a separation axiom, Axiom 6 of [Crosilla] p. "Axioms of CZF and IZF", which we include as ~ ax-sep . (Contributed by NM, 7-Aug-1994.)
theorem ru {x3: setvar}:
  $ wnel (cab x3 (wnel (cv x3) (cv x3))) cvv $;

--| Extend wff notation to include the proper substitution of a class for a set. Read this notation as "the proper substitution of class ` A ` for setvar variable ` x ` in wff ` ph ` ."
term wsbc {x3: setvar} (ph: wff x3) (A2: class x3): wff;

--| Define the proper substitution of a class for a set. When ` A ` is a proper class, our definition evaluates to false. This is somewhat arbitrary: we could have, instead, chosen the conclusion of ~ sbc6 for our definition, which always evaluates to true for proper classes. Our definition also does not produce the same results as discussed in the proof of Theorem 6.6 of [Quine] p. 42 (although Theorem 6.6 itself does hold, as shown by ~ dfsbcq below). Unfortunately, Quine's definition requires a recursive syntactical breakdown of ` ph ` , and it does not seem possible to express it with a single closed formula. If we did not want to commit to any specific proper class behavior, we could use this definition _only_ to prove theorem ~ dfsbcq , which holds for both our definition and Quine's, and from which we can derive a weaker version of ~ df-sbc in the form of ~ sbc8g . However, the behavior of Quine's definition at proper classes is similarly arbitrary, and for practical reasons (to avoid having to prove sethood of ` A ` in every use of this definition) we allow direct reference to ~ df-sbc and assert that ` [. A / x ]. ph ` is always false when ` A ` is a proper class. The related definition df-csb defines proper substitution into a class variable (as opposed to a wff variable). (Contributed by NM, 14-Apr-1995.) (Revised by NM, 25-Dec-2016.)
axiom df_sbc {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wsbc x3 ph A2) (wcel A2 (cab x3 ph)) $;

--| This theorem, which is similar to Theorem 6.7 of [Quine] p. 42 and holds under both our definition and Quine's, provides us with a weak definition of the proper substitution of a class for a set. Since our ~ df-sbc does not result in the same behavior as Quine's for proper classes, if we wished to avoid conflict with Quine's definition we could start with this theorem and ~ dfsbcq2 instead of ~ df-sbc . ( ~ dfsbcq2 is needed because unlike Quine we do not overload the ~ df-sb syntax.) As a consequence of these theorems, we can derive ~ sbc8g , which is a weaker version of ~ df-sbc that leaves substitution undefined when ` A ` is a proper class. However, it is often a nuisance to have to prove the sethood hypothesis of ~ sbc8g , so we will allow direct use of ~ df-sbc . Proper substiution with a proper class is rarely needed, and when it is, we can simply use the expansion of Quine's definition. (Contributed by NM, 14-Apr-1995.)
theorem dfsbcq {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi (wceq A2 B2) (wb (wsbc x3 ph A2) (wsbc x3 ph B2)) $;

--| This theorem, which is similar to Theorem 6.7 of [Quine] p. 42 and holds under both our definition and Quine's, relates logic substitution ~ df-sb and substitution for class variables ~ df-sbc . Unlike Quine, we use a different syntax for each in order to avoid overloading it. See remarks in ~ dfsbcq . (Contributed by NM, 31-Dec-2016.)
theorem dfsbcq2 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wi (wceq (cv y1) A2) (wb (wsb x3 y1 ph) (wsbc x3 ph A2)) $;

--| This theorem, which is similar to Theorem 6.7 of [Quine] p. 42 and holds under both our definition and Quine's, relates logic substitution ~ df-sb and substitution for class variables ~ df-sbc . Unlike Quine, we use a different syntax for each in order to avoid overloading it. See remarks in ~ dfsbcq . (Contributed by NM, 31-Dec-2016.)
theorem dfsbcq2_b {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wceq (cv x3) A2) (wb (wsb x3 x3 ph) (wsbc x3 ph A2)) $;

--| Show that ~ df-sb and ~ df-sbc are equivalent when the class term ` A ` in ~ df-sbc is a setvar variable. This theorem lets us reuse theorems based on ~ df-sb for proofs involving ~ df-sbc . (Contributed by NM, 31-Dec-2016.) (Proof modification is discouraged.)
theorem sbsbc {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wsb x3 y1 ph) (wsbc x3 ph (cv y1)) $;

--| Show that ~ df-sb and ~ df-sbc are equivalent when the class term ` A ` in ~ df-sbc is a setvar variable. This theorem lets us reuse theorems based on ~ df-sb for proofs involving ~ df-sbc . (Contributed by NM, 31-Dec-2016.) (Proof modification is discouraged.)
theorem sbsbc_b {x3: setvar} (ph: wff x3):
  $ wb (wsb x3 x3 ph) (wsbc x3 ph (cv x3)) $;

--| Equality theorem for class substitution. (Contributed by Mario Carneiro, 9-Feb-2017.) (Revised by NM, 30-Jun-2018.)
theorem sbceq1d {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wsbc x3 ps A2) (wsbc x3 ps B2)) $;

--| Equality theorem for class substitution. (Contributed by Mario Carneiro, 9-Feb-2017.) (Revised by NM, 30-Jun-2018.)
theorem sbceq1dd {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wsbc x3 ps A2) $ >
  $ wi ph (wsbc x3 ps B2) $;

--| This is the closest we can get to ~ df-sbc if we start from ~ dfsbcq (see its comments) and ~ dfsbcq2 . (Contributed by NM, 18-Nov-2008.) (Proof shortened by Andrew Salmon, 29-Jun-2011.) (Proof modification is discouraged.)
theorem sbc8g {x3: setvar} (ph: wff x3) (A2 V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) (wcel A2 (cab x3 ph))) $;

--| By our definition of proper substitution, it can only be true if the substituted expression is a set. (Contributed by Mario Carneiro, 13-Oct-2016.)
theorem sbcex {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wsbc x3 ph A2) (wcel A2 cvv) $;

--| Equality theorem for class substitution. Class version of ~ sbequ12 . (Contributed by NM, 26-Sep-2003.)
theorem sbceq1a {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wceq (cv x3) A2) (wb ph (wsbc x3 ph A2)) $;

--| Equality theorem for class substitution. Class version of ~ sbequ12r . (Contributed by NM, 4-Jan-2017.)
theorem sbceq2a {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wceq A2 (cv x3)) (wb (wsbc x3 ph A2) ph) $;

--| Specialization: if a formula is true for all sets, it is true for any class which is a set. Similar to Theorem 6.11 of [Quine] p. 44. See also ~ stdpc4 and ~ rspsbc . (Contributed by NM, 16-Jan-2004.)
theorem spsbc {x3: setvar} (ph: wff x3) (A2 V: class x3):
  $ wi (wcel A2 V) (wi (wal x3 ph) (wsbc x3 ph A2)) $;

--| Specialization: if a formula is true for all sets, it is true for any class which is a set. Similar to Theorem 6.11 of [Quine] p. 44. See also ~ stdpc4 and ~ rspsbc . (Contributed by Mario Carneiro, 9-Feb-2017.)
theorem spsbcd {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wal x3 ps) $ >
  $ wi ph (wsbc x3 ps A2) $;

--| A substitution into a theorem remains true (when ` A ` is a set). (Contributed by NM, 5-Nov-2005.)
theorem sbcth {x3: setvar} (ph: wff x3) (A2 V: class x3):
  $ ph $ >
  $ wi (wcel A2 V) (wsbc x3 ph A2) $;

--| Deduction version of ~ sbcth . (Contributed by NM, 30-Nov-2005.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem sbcthdv {x3: setvar} (ph: wff) (ps: wff x3) (A2 V: class x3):
  $ wi ph ps $ >
  $ wi (wa ph (wcel A2 V)) (wsbc x3 ps A2) $;

--| An identity theorem for substitution. See ~ sbid . (Contributed by Mario Carneiro, 18-Feb-2017.)
theorem sbcid {x3: setvar} (ph: wff x3):
  $ wb (wsbc x3 ph (cv x3)) ph $;

--| Deduction version of ~ nfsbc1 . (Contributed by NM, 23-May-2006.) (Revised by Mario Carneiro, 12-Oct-2016.)
theorem nfsbc1d {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 (wsbc x3 ps A2)) $;

--| Bound-variable hypothesis builder for class substitution. (Contributed by Mario Carneiro, 12-Oct-2016.)
theorem nfsbc1 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 (wsbc x3 ph A2) $;

--| Bound-variable hypothesis builder for class substitution. (Contributed by Mario Carneiro, 12-Oct-2016.)
theorem nfsbc1v {x3: setvar} (ph: wff x3) (A2: class):
  $ wnf x3 (wsbc x3 ph A2) $;

--| Deduction version of ~ nfsbc . (Contributed by NM, 23-Nov-2005.) (Revised by Mario Carneiro, 12-Oct-2016.)
theorem nfsbcd {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wsbc y1 ps A2)) $;

--| Bound-variable hypothesis builder for class substitution. (Contributed by NM, 7-Sep-2014.) (Revised by Mario Carneiro, 12-Oct-2016.)
theorem nfsbc {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnf x3 ph $ >
  $ wnf x3 (wsbc y1 ph A2) $;

--| A composition law for class substitution. (Contributed by NM, 26-Sep-2003.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem sbcco {x3 y1: setvar} (ph: wff x3) (A2: class x3 y1):
  $ wb (wsbc y1 (wsbc x3 ph (cv y1)) A2) (wsbc x3 ph A2) $;

--| A composition law for class substitution. Importantly, ` x ` may occur free in the class expression substituted for ` A ` . (Contributed by NM, 5-Sep-2004.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem sbcco2 {x3 y1: setvar} (ph: wff x3) (A2: class x3) (B2: class x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wb (wsbc y1 (wsbc x3 ph B2) (cv x3)) (wsbc x3 ph A2) $;

--| An equivalence for class substitution. (Contributed by NM, 23-Aug-1993.) (Revised by Mario Carneiro, 12-Oct-2016.)
theorem sbc5 {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wsbc x3 ph A2) (wex x3 (wa (wceq (cv x3) A2) ph)) $;

--| An equivalence for class substitution. (Contributed by NM, 11-Oct-2004.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem sbc6g {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) (wal x3 (wi (wceq (cv x3) A2) ph))) $;

--| An equivalence for class substitution. (Contributed by NM, 23-Aug-1993.) (Proof shortened by Eric Schmidt, 17-Jan-2007.)
theorem sbc6 {x3: setvar} (ph: wff x3) (A2: class):
  $ wcel A2 cvv $ >
  $ wb (wsbc x3 ph A2) (wal x3 (wi (wceq (cv x3) A2) ph)) $;

--| An equivalence for class substitution in the spirit of ~ df-clab . Note that ` x ` and ` A ` don't have to be distinct. (Contributed by NM, 18-Nov-2008.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem sbc7 {x3 y1: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wsbc x3 ph A2) (wex y1 (wa (wceq (cv y1) A2) (wsbc x3 ph (cv y1)))) $;

--| Change bound variables in a wff substitution. (Contributed by Jeff Hankins, 19-Sep-2009.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem cbvsbc {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wsbc x3 ph A2) (wsbc y1 ps A2) $;

--| Change the bound variable of a class substitution using implicit substitution. (Contributed by NM, 30-Sep-2008.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem cbvsbcv {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wsbc x3 ph A2) (wsbc y1 ps A2) $;

--| Conversion of implicit substitution to explicit class substitution, using a bound-variable hypothesis instead of distinct variables. (Closed theorem version of ~ sbciegf .) (Contributed by NM, 10-Nov-2005.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem sbciegft {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wi (w3a (wcel A2 V) (wnf x3 ps) (wal x3 (wi (wceq (cv x3) A2) (wb ph ps)))) (wb (wsbc x3 ph A2) ps) $;

--| Conversion of implicit substitution to explicit class substitution. (Contributed by NM, 14-Dec-2005.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem sbciegf {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) ps) $;

--| Conversion of implicit substitution to explicit class substitution. (Contributed by NM, 10-Nov-2005.)
theorem sbcieg {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) ps) $;

--| Conversion of implicit substitution to explicit class substitution. This version of ~ sbcie avoids a disjointness condition on ` x ` and ` A ` by substituting twice. (Contributed by Mario Carneiro, 15-Oct-2016.)
theorem sbcie2g {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (ch: wff x3) (A2: class x3) (V: class x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv y1) A2) (wb ps ch) $ >
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) ch) $;

--| Conversion of implicit substitution to explicit class substitution. (Contributed by NM, 4-Sep-2004.)
theorem sbcie {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wsbc x3 ph A2) ps $;

--| Conversion of implicit substitution to explicit class substitution, deduction form. (Contributed by NM, 29-Dec-2014.)
theorem sbciedf {x3: setvar} (ph ps ch: wff x3) (A2: class) (V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wnf x3 ph $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wb (wsbc x3 ps A2) ch) $;

--| Conversion of implicit substitution to explicit class substitution, deduction form. (Contributed by NM, 13-Dec-2014.)
theorem sbcied {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class) (V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wsbc x3 ps A2) ch) $;

--| Conversion of implicit substitution to explicit class substitution, deduction form. (Contributed by NM, 13-Dec-2014.)
theorem sbcied2 {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class) (B2 V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) B2)) (wb ps ch) $ >
  $ wi ph (wb (wsbc x3 ps A2) ch) $;

--| Membership in a restricted class abstraction, expressed with explicit class substitution. (The variation ~ elrabf has implicit substitution). The hypothesis specifies that ` x ` must not be a free variable in ` B ` . (Contributed by NM, 30-Sep-2003.) (Proof shortened by Mario Carneiro, 13-Oct-2016.)
theorem elrabsf {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnfc x3 B2 $ >
  $ wb (wcel A2 (crab x3 ph B2)) (wa (wcel A2 B2) (wsbc x3 ph A2)) $;

--| Substitution applied to an atomic wff. Set theory version of ~ eqsb3 . (Contributed by Andrew Salmon, 29-Jun-2011.)
theorem eqsbc3 {x3: setvar} (A2: class x3) (B2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wceq (cv x3) B2) A2) (wceq A2 B2)) $;

--| Move negation in and out of class substitution. (Contributed by NM, 16-Jan-2004.)
theorem sbcng {x3: setvar} (ph: wff x3) (A2 V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wn ph) A2) (wn (wsbc x3 ph A2))) $;

--| Distribution of class substitution over implication. (Contributed by NM, 16-Jan-2004.)
theorem sbcimg {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wi ph ps) A2) (wi (wsbc x3 ph A2) (wsbc x3 ps A2))) $;

--| Distribution of class substitution over conjunction. (Contributed by NM, 31-Dec-2016.)
theorem sbcan {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wsbc x3 (wa ph ps) A2) (wa (wsbc x3 ph A2) (wsbc x3 ps A2)) $;

--| Distribution of class substitution over conjunction. (Contributed by NM, 21-May-2004.)
theorem sbcang {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wa ph ps) A2) (wa (wsbc x3 ph A2) (wsbc x3 ps A2))) $;

--| Distribution of class substitution over disjunction. (Contributed by NM, 31-Dec-2016.)
theorem sbcor {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wsbc x3 (wo ph ps) A2) (wo (wsbc x3 ph A2) (wsbc x3 ps A2)) $;

--| Distribution of class substitution over disjunction. (Contributed by NM, 21-May-2004.)
theorem sbcorg {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wo ph ps) A2) (wo (wsbc x3 ph A2) (wsbc x3 ps A2))) $;

--| Distribution of class substitution over biconditional. (Contributed by Raph Levien, 10-Apr-2004.)
theorem sbcbig {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wb ph ps) A2) (wb (wsbc x3 ph A2) (wsbc x3 ps A2))) $;

--| Move universal quantifier in and out of class substitution. (Contributed by NM, 31-Dec-2016.)
theorem sbcal {x3 y1: setvar} (ph: wff x3 y1) (A2: class y1):
  $ wb (wsbc y1 (wal x3 ph) A2) (wal x3 (wsbc y1 ph A2)) $;

--| Move universal quantifier in and out of class substitution. (Contributed by NM, 16-Jan-2004.)
theorem sbcalg {x3 y1: setvar} (ph: wff x3 y1) (A2: class y1) (V: class x3 y1):
  $ wi (wcel A2 V) (wb (wsbc y1 (wal x3 ph) A2) (wal x3 (wsbc y1 ph A2))) $;

--| Move existential quantifier in and out of class substitution. (Contributed by NM, 21-May-2004.)
theorem sbcex2 {x3 y1: setvar} (ph: wff x3 y1) (A2: class y1):
  $ wb (wsbc y1 (wex x3 ph) A2) (wex x3 (wsbc y1 ph A2)) $;

--| Move existential quantifier in and out of class substitution. (Contributed by NM, 21-May-2004.)
theorem sbcexg {x3 y1: setvar} (ph: wff x3 y1) (A2: class y1) (V: class x3 y1):
  $ wi (wcel A2 V) (wb (wsbc y1 (wex x3 ph) A2) (wex x3 (wsbc y1 ph A2))) $;

--| A variation of extensionality for classes. (Contributed by Andrew Salmon, 28-Jun-2011.)
theorem sbceqal {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel A2 V) (wi (wal x3 (wi (wceq (cv x3) A2) (wceq (cv x3) B2))) (wceq A2 B2)) $;

--| Theorem *14.121 in [WhiteheadRussell] p. 185. (Contributed by Andrew Salmon, 28-Jun-2011.) (Proof shortened by Wolf Lammen, 9-May-2013.)
theorem sbeqalb {x3: setvar} (ph: wff x3) (A2 B2: class) (V: class x3):
  $ wi (wcel A2 V) (wi (wa (wal x3 (wb ph (wceq (cv x3) A2))) (wal x3 (wb ph (wceq (cv x3) B2)))) (wceq A2 B2)) $;

--| Formula-building deduction rule for class substitution. (Contributed by NM, 29-Dec-2014.)
theorem sbcbid {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wsbc x3 ps A2) (wsbc x3 ch A2)) $;

--| Formula-building deduction rule for class substitution. (Contributed by NM, 29-Dec-2014.)
theorem sbcbidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wsbc x3 ps A2) (wsbc x3 ch A2)) $;

--| Formula-building inference rule for class substitution. (Contributed by NM, 11-Nov-2005.)
theorem sbcbii {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb ph ps $ >
  $ wb (wsbc x3 ph A2) (wsbc x3 ps A2) $;

--| ~ eqsbc3 with setvar variable on right side of equals sign. (Contributed by Alan Sare, 24-Oct-2011.)
theorem eqsbc3r {x3: setvar} (A2: class) (B2: class x3) (C: class):
  $ wi (wcel A2 B2) (wb (wsbc x3 (wceq C (cv x3)) A2) (wceq C A2)) $;

--| Distribution of class substitution over triple conjunction. (Contributed by NM, 14-Dec-2006.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem sbc3ang {x3: setvar} (ph ps ch: wff x3) (A2 V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (w3a ph ps ch) A2) (w3a (wsbc x3 ph A2) (wsbc x3 ps A2) (wsbc x3 ch A2))) $;

--| Class substitution into a membership relation. (Contributed by NM, 17-Nov-2006.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem sbcel1gv {x3: setvar} (A2: class x3) (B2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wcel (cv x3) B2) A2) (wcel A2 B2)) $;

--| Class substitution into a membership relation. (Contributed by NM, 17-Nov-2006.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem sbcel2gv {x3: setvar} (A2: class) (B2 V: class x3):
  $ wi (wcel B2 V) (wb (wsbc x3 (wcel A2 (cv x3)) B2) (wcel A2 B2)) $;

--| Substitution analog of Theorem 19.20 of [Margaris] p. 90. (Contributed by NM, 11-Nov-2005.)
theorem sbcimdv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 V: class x3):
  $ wi ph (wi ps ch) $ >
  $ wi (wa ph (wcel A2 V)) (wi (wsbc x3 ps A2) (wsbc x3 ch A2)) $;

--| Substitution for a variable not free in a wff does not affect it. (Contributed by Mario Carneiro, 14-Oct-2016.)
theorem sbctt {x3: setvar} (ph: wff x3) (A2 V: class x3):
  $ wi (wa (wcel A2 V) (wnf x3 ph)) (wb (wsbc x3 ph A2) ph) $;

--| Substitution for a variable not free in a wff does not affect it. (Contributed by NM, 11-Oct-2004.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem sbcgf {x3: setvar} (ph: wff x3) (A2 V: class x3):
  $ wnf x3 ph $ >
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) ph) $;

--| Substitution for a variable not free in antecedent affects only the consequent. (Contributed by NM, 11-Oct-2004.)
theorem sbc19_21g {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wnf x3 ph $ >
  $ wi (wcel A2 V) (wb (wsbc x3 (wi ph ps) A2) (wi ph (wsbc x3 ps A2))) $;

--| Substitution for a variable not occurring in a wff does not affect it. Distinct variable form of ~ sbcgf . (Contributed by Alan Sare, 10-Nov-2012.)
theorem sbcg {x3: setvar} (ph: wff) (A2 V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) ph) $;

--| Conversion of implicit substitution to explicit class substitution. (Contributed by Mario Carneiro, 19-Dec-2013.)
theorem sbc2iegf {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class) (B2: class x3) (V: class y1) (W: class x3):
  $ wnf x3 ps $ >
  $ wnf y1 ps $ >
  $ wnf x3 (wcel B2 W) $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wsbc x3 (wsbc y1 ph B2) A2) ps) $;

--| Conversion of implicit substitution to explicit class substitution. (Contributed by NM, 16-Dec-2008.) (Revised by Mario Carneiro, 19-Dec-2013.)
theorem sbc2ie {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2: class) (B2: class x3):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wb (wsbc x3 (wsbc y1 ph B2) A2) ps $;

--| Conversion of implicit substitution to explicit class substitution. (Contributed by NM, 16-Dec-2008.) (Proof shortened by Mario Carneiro, 18-Oct-2016.)
theorem sbc2iedv {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (A2: class) (B2: class x3):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi ph (wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ps ch)) $ >
  $ wi ph (wb (wsbc x3 (wsbc y1 ps B2) A2) ch) $;

--| Conversion of implicit substitution to explicit class substitution. (Contributed by Mario Carneiro, 19-Jun-2014.) (Revised by Mario Carneiro, 29-Dec-2014.)
theorem sbc3ie {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff) (A2: class) (B2: class x3) (C: class x3 y1):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wi (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) (wb ph ps) $ >
  $ wb (wsbc x3 (wsbc y1 (wsbc z ph C) B2) A2) ps $;

--| Lemma for ~ sbccom . (Contributed by NM, 14-Nov-2005.) (Revised by Mario Carneiro, 18-Oct-2016.)
theorem sbccomlem {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class):
  $ wb (wsbc x3 (wsbc y1 ph B2) A2) (wsbc y1 (wsbc x3 ph A2) B2) $;

--| Commutative law for double class substitution. (Contributed by NM, 15-Nov-2005.) (Proof shortened by Mario Carneiro, 18-Oct-2016.)
theorem sbccom {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wb (wsbc x3 (wsbc y1 ph B2) A2) (wsbc y1 (wsbc x3 ph A2) B2) $;

--| Interchange class substitution and restricted quantifier. (Contributed by NM, 1-Mar-2008.) (Revised by David Abernethy, 22-Feb-2010.)
theorem sbcralt {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1) (B2: class y1) (V: class x3 y1):
  $ wi (wa (wcel A2 V) (wnfc y1 A2)) (wb (wsbc x3 (wral y1 ph B2) A2) (wral y1 (wsbc x3 ph A2) B2)) $;

--| Interchange class substitution and restricted existential quantifier. (Contributed by NM, 1-Mar-2008.) (Proof shortened by Mario Carneiro, 13-Oct-2016.)
theorem sbcrext {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1) (B2: class y1):
  $ wi (wnfc y1 A2) (wb (wsbc x3 (wrex y1 ph B2) A2) (wrex y1 (wsbc x3 ph A2) B2)) $;

--| Interchange class substitution and restricted quantifier. (Contributed by NM, 15-Nov-2005.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem sbcralg {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1) (V: class x3 y1):
  $ wi (wcel A2 V) (wb (wsbc x3 (wral y1 ph B2) A2) (wral y1 (wsbc x3 ph A2) B2)) $;

--| Interchange class substitution and restricted existential quantifier. (Contributed by NM, 15-Nov-2005.) (Revised by NM, 18-Aug-2018.)
theorem sbcrex {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wb (wsbc x3 (wrex y1 ph B2) A2) (wrex y1 (wsbc x3 ph A2) B2) $;

--| Interchange class substitution and restricted uniqueness quantifier. (Contributed by NM, 24-Feb-2013.)
theorem sbcreug {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1) (V: class x3 y1):
  $ wi (wcel A2 V) (wb (wsbc x3 (wreu y1 ph B2) A2) (wreu y1 (wsbc x3 ph A2) B2)) $;

--| Interchange class substitution and class abstraction. (Contributed by NM, 5-Nov-2005.)
theorem sbcabel {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2 V: class x3 y1):
  $ wnfc x3 B2 $ >
  $ wi (wcel A2 V) (wb (wsbc x3 (wcel (cab y1 ph) B2) A2) (wcel (cab y1 (wsbc x3 ph A2)) B2)) $;

--| Restricted quantifier version of Axiom 4 of [Mendelson] p. 69. This provides an axiom for a predicate calculus for a restricted domain. This theorem generalizes the unrestricted ~ stdpc4 and ~ spsbc . See also ~ rspsbca and rspcsbela . (Contributed by NM, 17-Nov-2006.) (Proof shortened by Mario Carneiro, 13-Oct-2016.)
theorem rspsbc {x3: setvar} (ph: wff x3) (A2: class x3) (B2: class):
  $ wi (wcel A2 B2) (wi (wral x3 ph B2) (wsbc x3 ph A2)) $;

--| Restricted quantifier version of Axiom 4 of [Mendelson] p. 69. (Contributed by NM, 14-Dec-2005.)
theorem rspsbca {x3: setvar} (ph: wff x3) (A2: class x3) (B2: class):
  $ wi (wa (wcel A2 B2) (wral x3 ph B2)) (wsbc x3 ph A2) $;

--| Existence form of ~ rspsbca . (Contributed by NM, 29-Feb-2008.) (Proof shortened by Mario Carneiro, 13-Oct-2016.)
theorem rspesbca {x3: setvar} (ph: wff x3) (A2: class x3) (B2: class):
  $ wi (wa (wcel A2 B2) (wsbc x3 ph A2)) (wrex x3 ph B2) $;

--| Existence form of ~ spsbc . (Contributed by Mario Carneiro, 18-Nov-2016.)
theorem spesbc {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wsbc x3 ph A2) (wex x3 ph) $;

--| form of ~ spsbc . (Contributed by Mario Carneiro, 9-Feb-2017.)
theorem spesbcd {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi ph (wsbc x3 ps A2) $ >
  $ wi ph (wex x3 ps) $;

--| A substitution into a theorem. (Contributed by NM, 1-Mar-2008.) (Proof shortened by Mario Carneiro, 13-Oct-2016.)
theorem sbcth2 {x3: setvar} (ph: wff x3) (A2: class x3) (B2: class):
  $ wi (wcel (cv x3) B2) ph $ >
  $ wi (wcel A2 B2) (wsbc x3 ph A2) $;

--| Restricted quantifier version of Axiom 5 of [Mendelson] p. 69. This is an axiom of a predicate calculus for a restricted domain. Compare the unrestricted ~ stdpc5 . (Contributed by NM, 16-Jan-2004.)
theorem ra5 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wral x3 (wi ph ps) A2) (wi ph (wral x3 ps A2)) $;

--| Condition implying restricted "at most one." (Contributed by Jim Kingdon, 14-Jul-2018.)
theorem rmo2ilem {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wi (wex y1 (wral x3 (wi ph (wceq (cv x3) (cv y1))) A2)) (wrmo x3 ph A2) $;

--| Condition implying restricted "at most one." (Contributed by NM, 17-Jun-2017.)
theorem rmo2i {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wi (wrex y1 (wral x3 (wi ph (wceq (cv x3) (cv y1))) A2) A2) (wrmo x3 ph A2) $;

--| Restricted "at most one" using explicit substitution. (Contributed by NM, 4-Nov-2012.) (Revised by NM, 16-Jun-2017.)
theorem rmo3 {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wb (wrmo x3 ph A2) (wral x3 (wral y1 (wi (wa ph (wsb x3 y1 ph)) (wceq (cv x3) (cv y1))) A2) A2) $;

--| Consequence of "at most one", using implicit substitution. (Contributed by NM, 2-Jan-2015.) (Revised by NM, 16-Jun-2017.)
theorem rmob {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2 C: class):
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (wceq (cv x3) C) (wb ph ch) $ >
  $ wi (wa (wrmo x3 ph A2) (wa (wcel B2 A2) ps)) (wb (wceq B2 C) (wa (wcel C A2) ch)) $;

--| Consequence of "at most one", using implicit substitution. (Contributed by NM, 4-Nov-2012.) (Revised by NM, 16-Jun-2017.)
theorem rmoi {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2 C: class):
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (wceq (cv x3) C) (wb ph ch) $ >
  $ wi (w3a (wrmo x3 ph A2) (wa (wcel B2 A2) ps) (wa (wcel C A2) ch)) (wceq B2 C) $;

--| Extend class notation to include the proper substitution of a class for a set into another class.
term csb {x3: setvar} (A2 B2: class x3): class;

--| Define the proper substitution of a class for a set into another class. The underlined brackets distinguish it from the substitution into a wff, ~ wsbc , to prevent ambiguity. Theorem ~ sbcel1g shows an example of how ambiguity could arise if we didn't use distinguished brackets. Theorem ~ sbccsbg recreates substitution into a wff from this definition. (Contributed by NM, 10-Nov-2005.)
axiom df_csb {x3 y1: setvar} (A2 B2: class x3):
  $ wceq (csb x3 A2 B2) (cab y1 (wsbc x3 (wcel (cv y1) B2) A2)) $;

--| Alternate expression for the proper substitution into a class, without referencing substitution into a wff. Note that ` x ` can be free in ` B ` but cannot occur in ` A ` . (Contributed by NM, 2-Dec-2013.)
theorem csb2 {x3 y1: setvar} (A2: class) (B2: class x3):
  $ wceq (csb x3 A2 B2) (cab y1 (wex x3 (wa (wceq (cv x3) A2) (wcel (cv y1) B2)))) $;

--| Analog of ~ dfsbcq for proper substitution into a class. (Contributed by NM, 10-Nov-2005.)
theorem csbeq1 {x3: setvar} (A2 B2 C: class x3):
  $ wi (wceq A2 B2) (wceq (csb x3 A2 C) (csb x3 B2 C)) $;

--| Change bound variables in a class substitution. Interestingly, this does not require any bound variable conditions on ` A ` . (Contributed by Jeff Hankins, 13-Sep-2009.) (Revised by Mario Carneiro, 11-Dec-2016.)
theorem cbvcsb {x3 y1: setvar} (A2 C D: class x3 y1):
  $ wnfc y1 C $ >
  $ wnfc x3 D $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq C D) $ >
  $ wceq (csb x3 A2 C) (csb y1 A2 D) $;

--| Change the bound variable of a proper substitution into a class using implicit substitution. (Contributed by NM, 30-Sep-2008.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem cbvcsbv {x3 y1: setvar} (A2: class x3 y1) (B2: class x3) (C: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (csb x3 A2 B2) (csb y1 A2 C) $;

--| Equality deduction for proper substitution into a class. (Contributed by NM, 3-Dec-2005.)
theorem csbeq1d {x3: setvar} (ph: wff x3) (A2 B2 C: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (csb x3 A2 C) (csb x3 B2 C)) $;

--| Analog of ~ sbid for proper substitution into a class. (Contributed by NM, 10-Nov-2005.)
theorem csbid {x3: setvar} (A2: class x3):
  $ wceq (csb x3 (cv x3) A2) A2 $;

--| Equality theorem for proper substitution into a class. (Contributed by NM, 10-Nov-2005.)
theorem csbeq1a {x3: setvar} (A2 B2: class x3):
  $ wi (wceq (cv x3) A2) (wceq B2 (csb x3 A2 B2)) $;

--| Composition law for chained substitutions into a class. (Contributed by NM, 10-Nov-2005.)
theorem csbco {x3 y1: setvar} (A2: class x3 y1) (B2: class x3):
  $ wceq (csb y1 A2 (csb x3 (cv y1) B2)) (csb x3 A2 B2) $;

--| Substitution doesn't affect a constant ` B ` (in which ` x ` is not free). (Contributed by Mario Carneiro, 14-Oct-2016.)
theorem csbtt {x3: setvar} (A2 B2 V: class x3):
  $ wi (wa (wcel A2 V) (wnfc x3 B2)) (wceq (csb x3 A2 B2) B2) $;

--| Substitution doesn't affect a constant ` B ` (in which ` x ` is not free). (Contributed by NM, 10-Nov-2005.)
theorem csbconstgf {x3: setvar} (A2 B2 V: class x3):
  $ wnfc x3 B2 $ >
  $ wi (wcel A2 V) (wceq (csb x3 A2 B2) B2) $;

--| Substitution doesn't affect a constant ` B ` (in which ` x ` is not free). ~ csbconstgf with distinct variable requirement. (Contributed by Alan Sare, 22-Jul-2012.)
theorem csbconstg {x3: setvar} (A2: class x3) (B2: class) (V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 B2) B2) $;

--| Distribute proper substitution through a membership relation. (Contributed by NM, 10-Nov-2005.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem sbcel12g {x3: setvar} (A2 B2 C V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wcel B2 C) A2) (wcel (csb x3 A2 B2) (csb x3 A2 C))) $;

--| Distribute proper substitution through an equality relation. (Contributed by NM, 10-Nov-2005.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem sbceqg {x3: setvar} (A2 B2 C V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wceq B2 C) A2) (wceq (csb x3 A2 B2) (csb x3 A2 C))) $;

--| Distribute proper substitution through negated membership. (Contributed by Andrew Salmon, 18-Jun-2011.)
theorem sbcnel12g {x3: setvar} (A2 B2 C V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wnel B2 C) A2) (wnel (csb x3 A2 B2) (csb x3 A2 C))) $;

--| Distribute proper substitution through an inequality. (Contributed by Andrew Salmon, 18-Jun-2011.)
theorem sbcne12g {x3: setvar} (A2 B2 C V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wne B2 C) A2) (wne (csb x3 A2 B2) (csb x3 A2 C))) $;

--| Move proper substitution in and out of a membership relation. Note that the scope of ` [. A / x ]. ` is the wff ` B e. C ` , whereas the scope of ` [_ A / x ]_ ` is the class ` B ` . (Contributed by NM, 10-Nov-2005.)
theorem sbcel1g {x3: setvar} (A2 B2: class x3) (C: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wcel B2 C) A2) (wcel (csb x3 A2 B2) C)) $;

--| Move proper substitution to first argument of an equality. (Contributed by NM, 30-Nov-2005.)
theorem sbceq1g {x3: setvar} (A2 B2: class x3) (C: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wceq B2 C) A2) (wceq (csb x3 A2 B2) C)) $;

--| Move proper substitution in and out of a membership relation. (Contributed by NM, 14-Nov-2005.)
theorem sbcel2g {x3: setvar} (A2: class x3) (B2: class) (C V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wcel B2 C) A2) (wcel B2 (csb x3 A2 C))) $;

--| Move proper substitution to second argument of an equality. (Contributed by NM, 30-Nov-2005.)
theorem sbceq2g {x3: setvar} (A2: class x3) (B2: class) (C V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wceq B2 C) A2) (wceq B2 (csb x3 A2 C))) $;

--| Commutative law for double substitution into a class. (Contributed by NM, 14-Nov-2005.)
theorem csbcomg {x3 y1: setvar} (A2: class x3) (B2: class y1) (C V W: class x3 y1):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (csb x3 A2 (csb y1 B2 C)) (csb y1 B2 (csb x3 A2 C))) $;

--| Formula-building deduction rule for class substitution. (Contributed by NM, 22-Nov-2005.) (Revised by Mario Carneiro, 1-Sep-2015.)
theorem csbeq2d {x3: setvar} (ph: wff x3) (A2 B2 C: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq (csb x3 A2 B2) (csb x3 A2 C)) $;

--| Formula-building deduction rule for class substitution. (Contributed by NM, 10-Nov-2005.) (Revised by Mario Carneiro, 1-Sep-2015.)
theorem csbeq2dv {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq (csb x3 A2 B2) (csb x3 A2 C)) $;

--| Formula-building inference rule for class substitution. (Contributed by NM, 10-Nov-2005.) (Revised by Mario Carneiro, 1-Sep-2015.)
theorem csbeq2i {x3: setvar} (A2 B2 C: class x3):
  $ wceq B2 C $ >
  $ wceq (csb x3 A2 B2) (csb x3 A2 C) $;

--| The proper substitution of a class for setvar variable results in the class (if the class exists). (Contributed by NM, 10-Nov-2005.)
theorem csbvarg {x3: setvar} (A2 V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (cv x3)) A2) $;

--| Substitution into a wff expressed in terms of substitution into a class. (Contributed by NM, 15-Aug-2007.)
theorem sbccsbg {x3 y1: setvar} (ph: wff x3 y1) (A2 V: class x3 y1):
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) (wcel (cv y1) (csb x3 A2 (cab y1 ph)))) $;

--| Substitution into a wff expressed in using substitution into a class. (Contributed by NM, 27-Nov-2005.)
theorem sbccsb2g {x3: setvar} (ph: wff x3) (A2 V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) (wcel A2 (csb x3 A2 (cab x3 ph)))) $;

--| Bound-variable hypothesis builder for substitution into a class. (Contributed by Mario Carneiro, 12-Oct-2016.)
theorem nfcsb1d {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 (csb x3 A2 B2)) $;

--| Bound-variable hypothesis builder for substitution into a class. (Contributed by Mario Carneiro, 12-Oct-2016.)
theorem nfcsb1 {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (csb x3 A2 B2) $;

--| Bound-variable hypothesis builder for substitution into a class. (Contributed by NM, 17-Aug-2006.) (Revised by Mario Carneiro, 12-Oct-2016.)
theorem nfcsb1v {x3: setvar} (A2: class) (B2: class x3):
  $ wnfc x3 (csb x3 A2 B2) $;

--| Deduction version of ~ nfcsb . (Contributed by NM, 21-Nov-2005.) (Revised by Mario Carneiro, 12-Oct-2016.)
theorem nfcsbd {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnfc x3 (csb y1 A2 B2)) $;

--| Bound-variable hypothesis builder for substitution into a class. (Contributed by Mario Carneiro, 12-Oct-2016.)
theorem nfcsb {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (csb y1 A2 B2) $;

--| Introduce an explicit substitution into an implicit substitution hypothesis. See ~ sbhypf for class substitution version. (Contributed by NM, 19-Dec-2008.)
theorem csbhypf {x3 y1: setvar} (A2 B2 C: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi (wceq (cv y1) A2) (wceq (csb x3 (cv y1) B2) C) $;

--| Conversion of implicit substitution to explicit substitution into a class. (Closed theorem version of ~ csbiegf .) (Contributed by NM, 11-Nov-2005.)
theorem csbiebt {x3: setvar} (A2: class) (B2 C V: class x3):
  $ wi (wa (wcel A2 V) (wnfc x3 C)) (wb (wal x3 (wi (wceq (cv x3) A2) (wceq B2 C))) (wceq (csb x3 A2 B2) C)) $;

--| Conversion of implicit substitution to explicit substitution into a class. (Contributed by Mario Carneiro, 13-Oct-2016.)
theorem csbiedf {x3: setvar} (ph: wff x3) (A2: class) (B2 C V: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wnfc x3 C) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wceq (csb x3 A2 B2) C) $;

--| Bidirectional conversion between an implicit class substitution hypothesis ` x = A -> B = C ` and its explicit substitution equivalent. (Contributed by NM, 2-Mar-2008.)
theorem csbieb {x3: setvar} (A2: class) (B2 C: class x3):
  $ wcel A2 cvv $ >
  $ wnfc x3 C $ >
  $ wb (wal x3 (wi (wceq (cv x3) A2) (wceq B2 C))) (wceq (csb x3 A2 B2) C) $;

--| Bidirectional conversion between an implicit class substitution hypothesis ` x = A -> B = C ` and its explicit substitution equivalent. (Contributed by NM, 24-Mar-2013.) (Revised by Mario Carneiro, 11-Dec-2016.)
theorem csbiebg {x3: setvar} (A2: class) (B2 C V: class x3):
  $ wnfc x3 C $ >
  $ wi (wcel A2 V) (wb (wal x3 (wi (wceq (cv x3) A2) (wceq B2 C))) (wceq (csb x3 A2 B2) C)) $;

--| Conversion of implicit substitution to explicit substitution into a class. (Contributed by NM, 11-Nov-2005.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem csbiegf {x3: setvar} (A2: class) (B2 C: class x3) (V: class):
  $ wi (wcel A2 V) (wnfc x3 C) $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi (wcel A2 V) (wceq (csb x3 A2 B2) C) $;

--| Conversion of implicit substitution to explicit substitution into a class. (Contributed by NM, 26-Nov-2005.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem csbief {x3: setvar} (A2: class) (B2 C: class x3):
  $ wcel A2 cvv $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq (csb x3 A2 B2) C $;

--| Conversion of implicit substitution to explicit substitution into a class. (Contributed by Mario Carneiro, 2-Dec-2014.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem csbied {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class) (V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wceq (csb x3 A2 B2) C) $;

--| Conversion of implicit substitution to explicit class substitution, deduction form. (Contributed by Mario Carneiro, 2-Jan-2017.)
theorem csbied2 {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (D: class) (V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) B2)) (wceq C D) $ >
  $ wi ph (wceq (csb x3 A2 C) D) $;

--| Conversion of implicit substitution to explicit substitution into a class (closed form of ~ csbie2 ). (Contributed by NM, 3-Sep-2007.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem csbie2t {x3 y1: setvar} (A2 B2: class) (C: class x3 y1) (D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wal x3 (wal y1 (wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wceq C D)))) (wceq (csb x3 A2 (csb y1 B2 C)) D) $;

--| Conversion of implicit substitution to explicit substitution into a class. (Contributed by NM, 27-Aug-2007.)
theorem csbie2 {x3 y1: setvar} (A2 B2: class) (C: class x3 y1) (D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wceq C D) $ >
  $ wceq (csb x3 A2 (csb y1 B2 C)) D $;

--| Conversion of implicit substitution to explicit class substitution. This version of ~ sbcie avoids a disjointness condition on ` x ` and ` A ` by substituting twice. (Contributed by Mario Carneiro, 11-Nov-2016.)
theorem csbie2g {x3 y1: setvar} (A2 B2: class x3) (C: class y1) (D: class x3) (V: class x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wi (wceq (cv y1) A2) (wceq C D) $ >
  $ wi (wcel A2 V) (wceq (csb x3 A2 B2) D) $;

--| Nest the composition of two substitutions. (Contributed by Mario Carneiro, 11-Nov-2016.)
theorem sbcnestgf {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 V: class x3 y1):
  $ wi (wa (wcel A2 V) (wal y1 (wnf x3 ph))) (wb (wsbc x3 (wsbc y1 ph B2) A2) (wsbc y1 ph (csb x3 A2 B2))) $;

--| Nest the composition of two substitutions. (Contributed by NM, 23-Nov-2005.) (Proof shortened by Mario Carneiro, 10-Nov-2016.)
theorem csbnestgf {x3 y1: setvar} (A2 B2 C V: class x3 y1):
  $ wi (wa (wcel A2 V) (wal y1 (wnfc x3 C))) (wceq (csb x3 A2 (csb y1 B2 C)) (csb y1 (csb x3 A2 B2) C)) $;

--| Nest the composition of two substitutions. (Contributed by NM, 27-Nov-2005.) (Proof shortened by Mario Carneiro, 11-Nov-2016.)
theorem sbcnestg {x3 y1: setvar} (ph: wff y1) (A2 B2 V: class x3 y1):
  $ wi (wcel A2 V) (wb (wsbc x3 (wsbc y1 ph B2) A2) (wsbc y1 ph (csb x3 A2 B2))) $;

--| Nest the composition of two substitutions. (Contributed by NM, 23-Nov-2005.) (Proof shortened by Mario Carneiro, 10-Nov-2016.)
theorem csbnestg {x3 y1: setvar} (A2 B2: class x3 y1) (C: class y1) (V: class x3 y1):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (csb y1 B2 C)) (csb y1 (csb x3 A2 B2) C)) $;

--| Nest the composition of two substitutions. (Contributed by NM, 23-May-2006.) (Proof shortened by Mario Carneiro, 11-Nov-2016.)
theorem csbnest1g {x3: setvar} (A2 B2 C V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (csb x3 B2 C)) (csb x3 (csb x3 A2 B2) C)) $;

--| Idempotent law for class substitutions. (Contributed by NM, 1-Mar-2008.)
theorem csbidmg {x3: setvar} (A2: class) (B2 V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (csb x3 A2 B2)) (csb x3 A2 B2)) $;

--| Composition of two substitutions. (Contributed by NM, 27-Nov-2005.) (Revised by Mario Carneiro, 11-Nov-2016.)
theorem sbcco3g {x3 y1: setvar} (ph: wff y1) (A2: class y1) (B2: class x3 y1) (C: class y1) (V: class x3 y1):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi (wcel A2 V) (wb (wsbc x3 (wsbc y1 ph B2) A2) (wsbc y1 ph C)) $;

--| Composition of two class substitutions. (Contributed by NM, 27-Nov-2005.) (Revised by Mario Carneiro, 11-Nov-2016.)
theorem csbco3g {x3 y1: setvar} (A2: class y1) (B2: class x3 y1) (C D: class y1) (V: class x3 y1):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi (wcel A2 V) (wceq (csb x3 A2 (csb y1 B2 D)) (csb y1 C D)) $;

--| Special case related to ~ rspsbc . (Contributed by NM, 10-Dec-2005.) (Proof shortened by Eric Schmidt, 17-Jan-2007.)
theorem rspcsbela {x3: setvar} (A2: class x3) (B2: class) (C: class x3) (D: class):
  $ wi (wa (wcel A2 B2) (wral x3 (wcel C D) B2)) (wcel (csb x3 A2 C) D) $;

--| Two ways of expressing " ` x ` is (effectively) not free in ` A ` ." (Contributed by Mario Carneiro, 14-Oct-2016.)
theorem sbnfc2 {x3 y1 z: setvar} (A2: class x3):
  $ wb (wnfc x3 A2) (wal y1 (wal z (wceq (csb x3 (cv y1) A2) (csb x3 (cv z) A2)))) $;

--| Move substitution into a class abstraction. (Contributed by NM, 13-Dec-2005.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem csbabg {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (V: class x3 y1):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (cab y1 ph)) (cab y1 (wsbc x3 ph A2))) $;

--| A more general version of ~ cbvralf that doesn't require ` A ` and ` B ` to be distinct from ` x ` or ` y ` . Changes bound variables using implicit substitution. (Contributed by Andrew Salmon, 13-Jul-2011.)
theorem cbvralcsf {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wral x3 ph A2) (wral y1 ps B2) $;

--| A more general version of ~ cbvrexf that has no distinct variable restrictions. Changes bound variables using implicit substitution. (Contributed by Andrew Salmon, 13-Jul-2011.) (Proof shortened by Mario Carneiro, 7-Dec-2014.)
theorem cbvrexcsf {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrex x3 ph A2) (wrex y1 ps B2) $;

--| A more general version of ~ cbvreuv that has no distinct variable rextrictions. Changes bound variables using implicit substitution. (Contributed by Andrew Salmon, 13-Jul-2011.)
theorem cbvreucsf {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wreu x3 ph A2) (wreu y1 ps B2) $;

--| A more general version of ~ cbvrab with no distinct variable restrictions. (Contributed by Andrew Salmon, 13-Jul-2011.)
theorem cbvrabcsf {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (crab x3 ph A2) (crab y1 ps B2) $;

--| Rule used to change the bound variable in a restricted universal quantifier with implicit substitution which also changes the quantifier domain. (Contributed by David Moews, 1-May-2017.)
theorem cbvralv2 {x3 y1: setvar} (ps: wff x3) (ch: wff y1) (A2: class x3) (B2: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ps ch) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wb (wral x3 ps A2) (wral y1 ch B2) $;

--| Rule used to change the bound variable in a restricted existential quantifier with implicit substitution which also changes the quantifier domain. (Contributed by David Moews, 1-May-2017.)
theorem cbvrexv2 {x3 y1: setvar} (ps: wff x3) (ch: wff y1) (A2: class x3) (B2: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ps ch) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wb (wrex x3 ps A2) (wrex y1 ch B2) $;

--| Extend class notation to include class difference (read: " ` A ` minus ` B ` ").
term cdif (A2 B2: class): class;

--| Extend class notation to include union of two classes (read: " ` A ` union ` B ` ").
term cun (A2 B2: class): class;

--| Extend class notation to include the intersection of two classes (read: " ` A ` intersect ` B ` ").
term cin (A2 B2: class): class;

--| Extend wff notation to include the subclass relation. This is read " ` A ` is a subclass of ` B ` " or " ` B ` includes ` A ` ." When ` A ` exists as a set, it is also read " ` A ` is a subset of ` B ` ."
term wss (A2 B2: class): wff;

--| Extend wff notation with proper subclass relation.
term wpss (A2 B2: class): wff;

--| Soundness justification theorem for ~ df-dif . (Contributed by Rodolfo Medina, 27-Apr-2010.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem difjust {x3 y1: setvar} (A2 B2: class):
  $ wceq (cab x3 (wa (wcel (cv x3) A2) (wn (wcel (cv x3) B2)))) (cab y1 (wa (wcel (cv y1) A2) (wn (wcel (cv y1) B2)))) $;

--| Define class difference, also called relative complement. Definition 5.12 of [TakeutiZaring] p. 20. Contrast this operation with union ` ( A u. B ) ` ( ~ df-un ) and intersection ` ( A i^i B ) ` ( ~ df-in ). Several notations are used in the literature; we chose the ` \ ` convention used in Definition 5.3 of [Eisenberg] p. 67 instead of the more common minus sign to reserve the latter for later use in, e.g., arithmetic. We will use the terminology " ` A ` excludes ` B ` " to mean ` A \ B ` . We will use " ` B ` is removed from ` A ` " to mean ` A \ { B } ` i.e. the removal of an element or equivalently the exclusion of a singleton. (Contributed by NM, 29-Apr-1994.)
axiom df_dif {x3: setvar} (A2 B2: class):
  $ wceq (cdif A2 B2) (cab x3 (wa (wcel (cv x3) A2) (wn (wcel (cv x3) B2)))) $;

--| Soundness justification theorem for ~ df-un . (Contributed by Rodolfo Medina, 28-Apr-2010.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem unjust {x3 y1: setvar} (A2 B2: class):
  $ wceq (cab x3 (wo (wcel (cv x3) A2) (wcel (cv x3) B2))) (cab y1 (wo (wcel (cv y1) A2) (wcel (cv y1) B2))) $;

--| Define the union of two classes. Definition 5.6 of [TakeutiZaring] p. 16. Contrast this operation with difference ` ( A \ B ) ` ( ~ df-dif ) and intersection ` ( A i^i B ) ` ( ~ df-in ). (Contributed by NM, 23-Aug-1993.)
axiom df_un {x3: setvar} (A2 B2: class):
  $ wceq (cun A2 B2) (cab x3 (wo (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| Soundness justification theorem for ~ df-in . (Contributed by Rodolfo Medina, 28-Apr-2010.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem injust {x3 y1: setvar} (A2 B2: class):
  $ wceq (cab x3 (wa (wcel (cv x3) A2) (wcel (cv x3) B2))) (cab y1 (wa (wcel (cv y1) A2) (wcel (cv y1) B2))) $;

--| Define the intersection of two classes. Definition 5.6 of [TakeutiZaring] p. 16. Contrast this operation with union ` ( A u. B ) ` ( ~ df-un ) and difference ` ( A \ B ) ` ( ~ df-dif ). (Contributed by NM, 29-Apr-1994.)
axiom df_in {x3: setvar} (A2 B2: class):
  $ wceq (cin A2 B2) (cab x3 (wa (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| Alternate definition for the intersection of two classes. (Contributed by NM, 6-Jul-2005.)
theorem dfin5 {x3: setvar} (A2 B2: class):
  $ wceq (cin A2 B2) (crab x3 (wcel (cv x3) B2) A2) $;

--| Alternate definition of class difference. (Contributed by NM, 25-Mar-2004.)
theorem dfdif2 {x3: setvar} (A2 B2: class):
  $ wceq (cdif A2 B2) (crab x3 (wn (wcel (cv x3) B2)) A2) $;

--| Expansion of membership in a class difference. (Contributed by NM, 29-Apr-1994.)
theorem eldif (A2 B2 C: class):
  $ wb (wcel A2 (cdif B2 C)) (wa (wcel A2 B2) (wn (wcel A2 C))) $;

--| If a class is in one class and not another, it is also in their difference. One-way deduction form of ~ eldif . (Contributed by David Moews, 1-May-2017.)
theorem eldifd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wn (wcel A2 C)) $ >
  $ wi ph (wcel A2 (cdif B2 C)) $;

--| If a class is in the difference of two classes, it is also in the minuend. One-way deduction form of ~ eldif . (Contributed by David Moews, 1-May-2017.)
theorem eldifad (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 (cdif B2 C)) $ >
  $ wi ph (wcel A2 B2) $;

--| If a class is in the difference of two classes, it is not in the subtrahend. One-way deduction form of ~ eldif . (Contributed by David Moews, 1-May-2017.)
theorem eldifbd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 (cdif B2 C)) $ >
  $ wi ph (wn (wcel A2 C)) $;

--| Define the subclass relationship. Exercise 9 of [TakeutiZaring] p. 18. Note that ` A C_ A ` (proved in ~ ssid ). Contrast this relationship with the relationship ` A C. B ` (as will be defined in ~ df-pss ). For a more traditional definition, but requiring a dummy variable, see ~ dfss2 (or ~ dfss3 which is similar). (Contributed by NM, 27-Apr-1994.)
axiom df_ss (A2 B2: class):
  $ wb (wss A2 B2) (wceq (cin A2 B2) A2) $;

--| Variant of subclass definition ~ df-ss . (Contributed by NM, 3-Sep-2004.)
theorem dfss (A2 B2: class):
  $ wb (wss A2 B2) (wceq A2 (cin A2 B2)) $;

--| Define proper subclass relationship between two classes. Definition 5.9 of [TakeutiZaring] p. 17. Note that ` -. A C. A ` (proved in ~ pssirr ). Contrast this relationship with the relationship ` A C_ B ` (as defined in ~ df-ss ). Other possible definitions are given by ~ dfpss2 and ~ dfpss3 . (Contributed by NM, 7-Feb-1996.)
axiom df_pss (A2 B2: class):
  $ wb (wpss A2 B2) (wa (wss A2 B2) (wne A2 B2)) $;

--| Alternate definition of the subclass relationship between two classes. Definition 5.9 of [TakeutiZaring] p. 17. (Contributed by NM, 8-Jan-2002.)
theorem dfss2 {x3: setvar} (A2 B2: class):
  $ wb (wss A2 B2) (wal x3 (wi (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| Alternate definition of subclass relationship. (Contributed by NM, 14-Oct-1999.)
theorem dfss3 {x3: setvar} (A2 B2: class):
  $ wb (wss A2 B2) (wral x3 (wcel (cv x3) B2) A2) $;

--| Equivalence for subclass relation, using bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 3-Jul-1994.) (Revised by Andrew Salmon, 27-Aug-2011.)
theorem dfss2f {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wb (wss A2 B2) (wal x3 (wi (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| Equivalence for subclass relation, using bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 20-Mar-2004.)
theorem dfss3f {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wb (wss A2 B2) (wral x3 (wcel (cv x3) B2) A2) $;

--| If ` x ` is not free in ` A ` and ` B ` , it is not free in ` A C_ B ` . (Contributed by NM, 27-Dec-1996.)
theorem nfss {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wss A2 B2) $;

--| Membership relationships follow from a subclass relationship. (Contributed by NM, 5-Aug-1993.)
theorem ssel (A2 B2 C: class):
  $ wi (wss A2 B2) (wi (wcel C A2) (wcel C B2)) $;

--| Membership relationships follow from a subclass relationship. (Contributed by NM, 7-Jun-2004.)
theorem ssel2 (A2 B2 C: class):
  $ wi (wa (wss A2 B2) (wcel C A2)) (wcel C B2) $;

--| Membership inference from subclass relationship. (Contributed by NM, 5-Aug-1993.)
theorem sseli (A2 B2 C: class):
  $ wss A2 B2 $ >
  $ wi (wcel C A2) (wcel C B2) $;

--| Membership inference from subclass relationship. (Contributed by NM, 31-May-1999.)
theorem sselii (A2 B2 C: class):
  $ wss A2 B2 $ >
  $ wcel C A2 $ >
  $ wcel C B2 $;

--| Membership inference from subclass relationship. (Contributed by NM, 25-Jun-2014.)
theorem sseldi (ph: wff) (A2 B2 C: class):
  $ wss A2 B2 $ >
  $ wi ph (wcel C A2) $ >
  $ wi ph (wcel C B2) $;

--| Membership deduction from subclass relationship. (Contributed by NM, 15-Nov-1995.)
theorem sseld (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wi (wcel C A2) (wcel C B2)) $;

--| Membership deduction from subclass relationship. (Contributed by NM, 26-Jun-2014.)
theorem sselda (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi (wa ph (wcel C A2)) (wcel C B2) $;

--| Membership inference from subclass relationship. (Contributed by NM, 14-Dec-2004.)
theorem sseldd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wcel C A2) $ >
  $ wi ph (wcel C B2) $;

--| If a class is not in another class, it is also not in a subclass of that class. Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem ssneld (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wi (wn (wcel C B2)) (wn (wcel C A2))) $;

--| If an element is not in a class, it is also not in a subclass of that class. Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem ssneldd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wn (wcel C B2)) $ >
  $ wi ph (wn (wcel C A2)) $;

--| Inference rule based on subclass definition. (Contributed by NM, 5-Aug-1993.)
theorem ssriv {x3: setvar} (A2 B2: class):
  $ wi (wcel (cv x3) A2) (wcel (cv x3) B2) $ >
  $ wss A2 B2 $;

--| Deduction rule based on subclass definition. (Contributed by Thierry Arnoux, 8-Mar-2017.)
theorem ssrd {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi ph (wi (wcel (cv x3) A2) (wcel (cv x3) B2)) $ >
  $ wi ph (wss A2 B2) $;

--| Deduction rule based on subclass definition. (Contributed by NM, 15-Nov-1995.)
theorem ssrdv {x3: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wi (wcel (cv x3) A2) (wcel (cv x3) B2)) $ >
  $ wi ph (wss A2 B2) $;

--| Transitivity of subclasses. Exercise 5 of [TakeutiZaring] p. 17. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 14-Jun-2011.)
theorem sstr2 (A2 B2 C: class):
  $ wi (wss A2 B2) (wi (wss B2 C) (wss A2 C)) $;

--| Transitivity of subclasses. Theorem 6 of [Suppes] p. 23. (Contributed by NM, 5-Sep-2003.)
theorem sstr (A2 B2 C: class):
  $ wi (wa (wss A2 B2) (wss B2 C)) (wss A2 C) $;

--| Subclass transitivity inference. (Contributed by NM, 5-May-2000.)
theorem sstri (A2 B2 C: class):
  $ wss A2 B2 $ >
  $ wss B2 C $ >
  $ wss A2 C $;

--| Subclass transitivity deduction. (Contributed by NM, 2-Jun-2004.)
theorem sstrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss B2 C) $ >
  $ wi ph (wss A2 C) $;

--| Subclass transitivity deduction. (Contributed by NM, 6-Feb-2014.)
theorem syl5ss (ph: wff) (A2 B2 C: class):
  $ wss A2 B2 $ >
  $ wi ph (wss B2 C) $ >
  $ wi ph (wss A2 C) $;

--| Subclass transitivity deduction. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem syl6ss (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wss B2 C $ >
  $ wi ph (wss A2 C) $;

--| A subclass transitivity deduction. (Contributed by NM, 27-Sep-2004.) (Proof shortened by Andrew Salmon, 14-Jun-2011.)
theorem sylan9ss (ph ps: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ps (wss B2 C) $ >
  $ wi (wa ph ps) (wss A2 C) $;

--| A subclass transitivity deduction. (Contributed by NM, 27-Sep-2004.)
theorem sylan9ssr (ph ps: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ps (wss B2 C) $ >
  $ wi (wa ps ph) (wss A2 C) $;

--| The subclass relationship is antisymmetric. Compare Theorem 4 of [Suppes] p. 22. (Contributed by NM, 5-Aug-1993.)
theorem eqss (A2 B2: class):
  $ wb (wceq A2 B2) (wa (wss A2 B2) (wss B2 A2)) $;

--| Infer equality from two subclass relationships. Compare Theorem 4 of [Suppes] p. 22. (Contributed by NM, 9-Sep-1993.)
theorem eqssi (A2 B2: class):
  $ wss A2 B2 $ >
  $ wss B2 A2 $ >
  $ wceq A2 B2 $;

--| Equality deduction from two subclass relationships. Compare Theorem 4 of [Suppes] p. 22. (Contributed by NM, 27-Jun-2004.)
theorem eqssd (ph: wff) (A2 B2: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wceq A2 B2) $;

--| Deduce equality of classes from equivalence of membership. (Contributed by Thierry Arnoux, 21-Mar-2017.)
theorem eqrd {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi ph (wb (wcel (cv x3) A2) (wcel (cv x3) B2)) $ >
  $ wi ph (wceq A2 B2) $;

--| Any class is a subclass of itself. Exercise 10 of [TakeutiZaring] p. 18. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 14-Jun-2011.)
theorem ssid (A2: class):
  $ wss A2 A2 $;

--| Any class is a subclass of the universal class. (Contributed by NM, 31-Oct-1995.)
theorem ssv (A2: class):
  $ wss A2 cvv $;

--| Equality theorem for subclasses. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 21-Jun-2011.)
theorem sseq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wss A2 C) (wss B2 C)) $;

--| Equality theorem for the subclass relationship. (Contributed by NM, 25-Jun-1998.)
theorem sseq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wss C A2) (wss C B2)) $;

--| Equality theorem for the subclass relationship. (Contributed by NM, 31-May-1999.)
theorem sseq12 (A2 B2 C D: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wb (wss A2 C) (wss B2 D)) $;

--| An equality inference for the subclass relationship. (Contributed by NM, 18-Aug-1993.)
theorem sseq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wb (wss A2 C) (wss B2 C) $;

--| An equality inference for the subclass relationship. (Contributed by NM, 30-Aug-1993.)
theorem sseq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wb (wss C A2) (wss C B2) $;

--| An equality inference for the subclass relationship. (Contributed by NM, 31-May-1999.) (Proof shortened by Eric Schmidt, 26-Jan-2007.)
theorem sseq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wb (wss A2 C) (wss B2 D) $;

--| An equality deduction for the subclass relationship. (Contributed by NM, 14-Aug-1994.)
theorem sseq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wss A2 C) (wss B2 C)) $;

--| An equality deduction for the subclass relationship. (Contributed by NM, 14-Aug-1994.)
theorem sseq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wss C A2) (wss C B2)) $;

--| An equality deduction for the subclass relationship. (Contributed by NM, 31-May-1999.)
theorem sseq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wss A2 C) (wss B2 D)) $;

--| Substitution of equality into a subclass relationship. (Contributed by NM, 16-Jul-1995.)
theorem eqsstri (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wss B2 C $ >
  $ wss A2 C $;

--| Substitution of equality into a subclass relationship. (Contributed by NM, 19-Oct-1999.)
theorem eqsstr3i (A2 B2 C: class):
  $ wceq B2 A2 $ >
  $ wss B2 C $ >
  $ wss A2 C $;

--| Substitution of equality into a subclass relationship. (Contributed by NM, 28-Jul-1995.)
theorem sseqtri (A2 B2 C: class):
  $ wss A2 B2 $ >
  $ wceq B2 C $ >
  $ wss A2 C $;

--| Substitution of equality into a subclass relationship. (Contributed by NM, 4-Apr-1995.)
theorem sseqtr4i (A2 B2 C: class):
  $ wss A2 B2 $ >
  $ wceq C B2 $ >
  $ wss A2 C $;

--| Substitution of equality into a subclass relationship. (Contributed by NM, 25-Apr-2004.)
theorem eqsstrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wss B2 C) $ >
  $ wi ph (wss A2 C) $;

--| Substitution of equality into a subclass relationship. (Contributed by NM, 25-Apr-2004.)
theorem eqsstr3d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq B2 A2) $ >
  $ wi ph (wss B2 C) $ >
  $ wi ph (wss A2 C) $;

--| Substitution of equality into a subclass relationship. (Contributed by NM, 25-Apr-2004.)
theorem sseqtrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wss A2 C) $;

--| Substitution of equality into a subclass relationship. (Contributed by NM, 25-Apr-2004.)
theorem sseqtr4d (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq C B2) $ >
  $ wi ph (wss A2 C) $;

--| Substitution of equality in both sides of a subclass relationship. (Contributed by NM, 13-Jan-1996.) (Proof shortened by Eric Schmidt, 26-Jan-2007.)
theorem _3sstr3i (A2 B2 C D: class):
  $ wss A2 B2 $ >
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wss C D $;

--| Substitution of equality in both sides of a subclass relationship. (Contributed by NM, 13-Jan-1996.) (Proof shortened by Eric Schmidt, 26-Jan-2007.)
theorem _3sstr4i (A2 B2 C D: class):
  $ wss A2 B2 $ >
  $ wceq C A2 $ >
  $ wceq D B2 $ >
  $ wss C D $;

--| Substitution of equality into both sides of a subclass relationship. (Contributed by NM, 1-Oct-2000.)
theorem _3sstr3g (ph: wff) (A2 B2 C D: class):
  $ wi ph (wss A2 B2) $ >
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wi ph (wss C D) $;

--| Substitution of equality into both sides of a subclass relationship. (Contributed by NM, 16-Aug-1994.) (Proof shortened by Eric Schmidt, 26-Jan-2007.)
theorem _3sstr4g (ph: wff) (A2 B2 C D: class):
  $ wi ph (wss A2 B2) $ >
  $ wceq C A2 $ >
  $ wceq D B2 $ >
  $ wi ph (wss C D) $;

--| Substitution of equality into both sides of a subclass relationship. (Contributed by NM, 1-Oct-2000.)
theorem _3sstr3d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wss C D) $;

--| Substitution of equality into both sides of a subclass relationship. (Contributed by NM, 30-Nov-1995.) (Proof shortened by Eric Schmidt, 26-Jan-2007.)
theorem _3sstr4d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq C A2) $ >
  $ wi ph (wceq D B2) $ >
  $ wi ph (wss C D) $;

--| B chained subclass and equality deduction. (Contributed by NM, 25-Apr-2004.)
theorem syl5eqss (ph: wff) (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wi ph (wss B2 C) $ >
  $ wi ph (wss A2 C) $;

--| B chained subclass and equality deduction. (Contributed by NM, 25-Apr-2004.)
theorem syl5eqssr (ph: wff) (A2 B2 C: class):
  $ wceq B2 A2 $ >
  $ wi ph (wss B2 C) $ >
  $ wi ph (wss A2 C) $;

--| A chained subclass and equality deduction. (Contributed by NM, 25-Apr-2004.)
theorem syl6sseq (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wceq B2 C $ >
  $ wi ph (wss A2 C) $;

--| A chained subclass and equality deduction. (Contributed by NM, 25-Apr-2004.)
theorem syl6sseqr (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wceq C B2 $ >
  $ wi ph (wss A2 C) $;

--| Subclass transitivity deduction. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem syl5sseq (ph: wff) (A2 B2 C: class):
  $ wss B2 A2 $ >
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wss B2 C) $;

--| Subclass transitivity deduction. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem syl5sseqr (ph: wff) (A2 B2 C: class):
  $ wss B2 A2 $ >
  $ wi ph (wceq C A2) $ >
  $ wi ph (wss B2 C) $;

--| A chained subclass and equality deduction. (Contributed by Mario Carneiro, 2-Jan-2017.)
theorem syl6eqss (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wss B2 C $ >
  $ wi ph (wss A2 C) $;

--| A chained subclass and equality deduction. (Contributed by Mario Carneiro, 2-Jan-2017.)
theorem syl6eqssr (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq B2 A2) $ >
  $ wss B2 C $ >
  $ wi ph (wss A2 C) $;

--| Equality implies the subclass relation. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 21-Jun-2011.)
theorem eqimss (A2 B2: class):
  $ wi (wceq A2 B2) (wss A2 B2) $;

--| Equality implies the subclass relation. (Contributed by NM, 23-Nov-2003.)
theorem eqimss2 (A2 B2: class):
  $ wi (wceq B2 A2) (wss A2 B2) $;

--| Infer subclass relationship from equality. (Contributed by NM, 6-Jan-2007.)
theorem eqimssi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wss A2 B2 $;

--| Infer subclass relationship from equality. (Contributed by NM, 7-Jan-2007.)
theorem eqimss2i (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wss B2 A2 $;

--| Two classes are different if they don't include the same class. (Contributed by NM, 23-Apr-2015.)
theorem nssne1 (A2 B2 C: class):
  $ wi (wa (wss A2 B2) (wn (wss A2 C))) (wne B2 C) $;

--| Two classes are different if they are not subclasses of the same class. (Contributed by NM, 23-Apr-2015.)
theorem nssne2 (A2 B2 C: class):
  $ wi (wa (wss A2 C) (wn (wss B2 C))) (wne A2 B2) $;

--| Negation of subclass relationship. One direction of Exercise 13 of [TakeutiZaring] p. 18. (Contributed by Jim Kingdon, 15-Jul-2018.)
theorem nssr {x3: setvar} (A2 B2: class):
  $ wi (wex x3 (wa (wcel (cv x3) A2) (wn (wcel (cv x3) B2)))) (wn (wss A2 B2)) $;

--| Quantification restricted to a subclass. (Contributed by NM, 11-Mar-2006.)
theorem ssralv {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wss A2 B2) (wi (wral x3 ph B2) (wral x3 ph A2)) $;

--| Existential quantification restricted to a subclass. (Contributed by NM, 11-Jan-2007.)
theorem ssrexv {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wss A2 B2) (wi (wrex x3 ph A2) (wrex x3 ph B2)) $;

--| Restricted universal quantification on a subset in terms of superset. (Contributed by Stefan O'Rear, 3-Apr-2015.)
theorem ralss {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wss A2 B2) (wb (wral x3 ph A2) (wral x3 (wi (wcel (cv x3) A2) ph) B2)) $;

--| Restricted existential quantification on a subset in terms of superset. (Contributed by Stefan O'Rear, 3-Apr-2015.)
theorem rexss {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wss A2 B2) (wb (wrex x3 ph A2) (wrex x3 (wa (wcel (cv x3) A2) ph) B2)) $;

--| Class abstractions in a subclass relationship. (Contributed by NM, 3-Jul-1994.)
theorem ss2ab {x3: setvar} (ph ps: wff x3):
  $ wb (wss (cab x3 ph) (cab x3 ps)) (wal x3 (wi ph ps)) $;

--| Class abstraction in a subclass relationship. (Contributed by NM, 16-Aug-2006.)
theorem abss {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wss (cab x3 ph) A2) (wal x3 (wi ph (wcel (cv x3) A2))) $;

--| Subclass of a class abstraction. (Contributed by NM, 16-Aug-2006.)
theorem ssab {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wss A2 (cab x3 ph)) (wal x3 (wi (wcel (cv x3) A2) ph)) $;

--| The relation for a subclass of a class abstraction is equivalent to restricted quantification. (Contributed by NM, 6-Sep-2006.)
theorem ssabral {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wss A2 (cab x3 ph)) (wral x3 ph A2) $;

--| Inference of abstraction subclass from implication. (Contributed by NM, 31-Mar-1995.)
theorem ss2abi {x3: setvar} (ph ps: wff x3):
  $ wi ph ps $ >
  $ wss (cab x3 ph) (cab x3 ps) $;

--| Deduction of abstraction subclass from implication. (Contributed by NM, 29-Jul-2011.)
theorem ss2abdv {x3: setvar} (ph: wff) (ps ch: wff x3):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wss (cab x3 ps) (cab x3 ch)) $;

--| Deduction of abstraction subclass from implication. (Contributed by NM, 20-Jan-2006.)
theorem abssdv {x3: setvar} (ph: wff) (ps: wff x3) (A2: class):
  $ wi ph (wi ps (wcel (cv x3) A2)) $ >
  $ wi ph (wss (cab x3 ps) A2) $;

--| Inference of abstraction subclass from implication. (Contributed by NM, 20-Jan-2006.)
theorem abssi {x3: setvar} (ph: wff x3) (A2: class):
  $ wi ph (wcel (cv x3) A2) $ >
  $ wss (cab x3 ph) A2 $;

--| Restricted abstraction classes in a subclass relationship. (Contributed by NM, 30-May-1999.)
theorem ss2rab {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wss (crab x3 ph A2) (crab x3 ps A2)) (wral x3 (wi ph ps) A2) $;

--| Restricted class abstraction in a subclass relationship. (Contributed by NM, 16-Aug-2006.)
theorem rabss {x3: setvar} (ph: wff x3) (A2: class x3) (B2: class):
  $ wb (wss (crab x3 ph A2) B2) (wral x3 (wi ph (wcel (cv x3) B2)) A2) $;

--| Subclass of a restricted class abstraction. (Contributed by NM, 16-Aug-2006.)
theorem ssrab {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wb (wss B2 (crab x3 ph A2)) (wa (wss B2 A2) (wral x3 ph B2)) $;

--| Subclass of a restricted class abstraction (deduction rule). (Contributed by NM, 31-Aug-2006.)
theorem ssrabdv {x3: setvar} (ph: wff) (ps: wff x3) (A2 B2: class):
  $ wi ph (wss B2 A2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) ps $ >
  $ wi ph (wss B2 (crab x3 ps A2)) $;

--| Subclass of a restricted class abstraction (deduction rule). (Contributed by NM, 2-Feb-2015.)
theorem rabssdv {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3) (B2: class):
  $ wi (w3a ph (wcel (cv x3) A2) ps) (wcel (cv x3) B2) $ >
  $ wi ph (wss (crab x3 ps A2) B2) $;

--| Deduction of restricted abstraction subclass from implication. (Contributed by NM, 30-May-2006.)
theorem ss2rabdv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wi ps ch) $ >
  $ wi ph (wss (crab x3 ps A2) (crab x3 ch A2)) $;

--| Inference of restricted abstraction subclass from implication. (Contributed by NM, 14-Oct-1999.)
theorem ss2rabi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wi ph ps) $ >
  $ wss (crab x3 ph A2) (crab x3 ps A2) $;

--| Subclass law for restricted abstraction. (Contributed by NM, 18-Dec-2004.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem rabss2 {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wss A2 B2) (wss (crab x3 ph A2) (crab x3 ph B2)) $;

--| Subclass relation for the restriction of a class abstraction. (Contributed by NM, 31-Mar-1995.)
theorem ssab2 {x3: setvar} (ph: wff x3) (A2: class):
  $ wss (cab x3 (wa (wcel (cv x3) A2) ph)) A2 $;

--| Subclass relation for a restricted class. (Contributed by NM, 19-Mar-1997.)
theorem ssrab2 {x3: setvar} (ph: wff x3) (A2: class):
  $ wss (crab x3 ph A2) A2 $;

--| If the restricting class of a restricted class abstraction is a subset of this restricted class abstraction, it is equal to this restricted class abstraction. (Contributed by Alexander van der Vekens, 31-Dec-2017.)
theorem ssrabeq {x3: setvar} (ph: wff x3) (V: class):
  $ wb (wss V (crab x3 ph V)) (wceq V (crab x3 ph V)) $;

--| A restricted class is a subclass of the corresponding unrestricted class. (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem rabssab {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wss (crab x3 ph A2) (cab x3 ph) $;

--| A subset relationship useful for converting union to indexed union using dfiun2 or dfiun2g and intersection to indexed intersection using dfiin2 . (Contributed by NM, 5-Oct-2006.) (Proof shortened by Mario Carneiro, 26-Sep-2015.)
theorem uniiunlem {x3 y1: setvar} (A2 B2: class x3) (C: class y1) (D: class x3 y1):
  $ wi (wral x3 (wcel B2 D) A2) (wb (wral x3 (wcel B2 C) A2) (wss (cab y1 (wrex x3 (wceq (cv y1) B2) A2)) C)) $;

--| Alternate definition of proper subclass. (Contributed by NM, 7-Feb-1996.)
theorem dfpss2 (A2 B2: class):
  $ wb (wpss A2 B2) (wa (wss A2 B2) (wn (wceq A2 B2))) $;

--| Alternate definition of proper subclass. (Contributed by NM, 7-Feb-1996.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem dfpss3 (A2 B2: class):
  $ wb (wpss A2 B2) (wa (wss A2 B2) (wn (wss B2 A2))) $;

--| Equality theorem for proper subclass. (Contributed by NM, 7-Feb-1996.)
theorem psseq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wpss A2 C) (wpss B2 C)) $;

--| Equality theorem for proper subclass. (Contributed by NM, 7-Feb-1996.)
theorem psseq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wpss C A2) (wpss C B2)) $;

--| An equality inference for the proper subclass relationship. (Contributed by NM, 9-Jun-2004.)
theorem psseq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wb (wpss A2 C) (wpss B2 C) $;

--| An equality inference for the proper subclass relationship. (Contributed by NM, 9-Jun-2004.)
theorem psseq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wb (wpss C A2) (wpss C B2) $;

--| An equality inference for the proper subclass relationship. (Contributed by NM, 9-Jun-2004.)
theorem psseq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wb (wpss A2 C) (wpss B2 D) $;

--| An equality deduction for the proper subclass relationship. (Contributed by NM, 9-Jun-2004.)
theorem psseq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wpss A2 C) (wpss B2 C)) $;

--| An equality deduction for the proper subclass relationship. (Contributed by NM, 9-Jun-2004.)
theorem psseq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wpss C A2) (wpss C B2)) $;

--| An equality deduction for the proper subclass relationship. (Contributed by NM, 9-Jun-2004.)
theorem psseq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wpss A2 C) (wpss B2 D)) $;

--| A proper subclass is a subclass. Theorem 10 of [Suppes] p. 23. (Contributed by NM, 7-Feb-1996.)
theorem pssss (A2 B2: class):
  $ wi (wpss A2 B2) (wss A2 B2) $;

--| Two classes in a proper subclass relationship are not equal. (Contributed by NM, 16-Feb-2015.)
theorem pssne (A2 B2: class):
  $ wi (wpss A2 B2) (wne A2 B2) $;

--| Deduce subclass from proper subclass. (Contributed by NM, 29-Feb-1996.)
theorem pssssd (ph: wff) (A2 B2: class):
  $ wi ph (wpss A2 B2) $ >
  $ wi ph (wss A2 B2) $;

--| Proper subclasses are unequal. Deduction form of ~ pssne . (Contributed by David Moews, 1-May-2017.)
theorem pssned (ph: wff) (A2 B2: class):
  $ wi ph (wpss A2 B2) $ >
  $ wi ph (wne A2 B2) $;

--| Subclass in terms of proper subclass. (Contributed by Jim Kingdon, 16-Jul-2018.)
theorem sspssr (A2 B2: class):
  $ wi (wo (wpss A2 B2) (wceq A2 B2)) (wss A2 B2) $;

--| Proper subclass is irreflexive. Theorem 7 of [Suppes] p. 23. (Contributed by NM, 7-Feb-1996.)
theorem pssirr (A2: class):
  $ wn (wpss A2 A2) $;

--| Proper subclass has no 2-cycle loops. Compare Theorem 8 of [Suppes] p. 23. (Contributed by NM, 7-Feb-1996.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem pssn2lp (A2 B2: class):
  $ wn (wa (wpss A2 B2) (wpss B2 A2)) $;

--| Two ways of stating trichotomy with respect to inclusion. (Contributed by Jim Kingdon, 16-Jul-2018.)
theorem sspsstrir (A2 B2: class):
  $ wi (w3o (wpss A2 B2) (wceq A2 B2) (wpss B2 A2)) (wo (wss A2 B2) (wss B2 A2)) $;

--| Partial trichotomy law for subclasses. (Contributed by NM, 16-May-1996.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem ssnpss (A2 B2: class):
  $ wi (wss A2 B2) (wn (wpss B2 A2)) $;

--| Like ~ pssn2lp but for subset and proper subset. (Contributed by Jim Kingdon, 17-Jul-2018.)
theorem sspssn (A2 B2: class):
  $ wn (wa (wss A2 B2) (wpss B2 A2)) $;

--| Transitive law for proper subclass. Theorem 9 of [Suppes] p. 23. (Contributed by NM, 7-Feb-1996.)
theorem psstr (A2 B2 C: class):
  $ wi (wa (wpss A2 B2) (wpss B2 C)) (wpss A2 C) $;

--| Transitive law for subclass and proper subclass. (Contributed by NM, 3-Apr-1996.)
theorem sspsstr (A2 B2 C: class):
  $ wi (wa (wss A2 B2) (wpss B2 C)) (wpss A2 C) $;

--| Transitive law for subclass and proper subclass. (Contributed by NM, 3-Apr-1996.)
theorem psssstr (A2 B2 C: class):
  $ wi (wa (wpss A2 B2) (wss B2 C)) (wpss A2 C) $;

--| Proper subclass inclusion is transitive. Deduction form of ~ psstr . (Contributed by David Moews, 1-May-2017.)
theorem psstrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wpss A2 B2) $ >
  $ wi ph (wpss B2 C) $ >
  $ wi ph (wpss A2 C) $;

--| Transitivity involving subclass and proper subclass inclusion. Deduction form of ~ sspsstr . (Contributed by David Moews, 1-May-2017.)
theorem sspsstrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wpss B2 C) $ >
  $ wi ph (wpss A2 C) $;

--| Transitivity involving subclass and proper subclass inclusion. Deduction form of ~ psssstr . (Contributed by David Moews, 1-May-2017.)
theorem psssstrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wpss A2 B2) $ >
  $ wi ph (wss B2 C) $ >
  $ wi ph (wpss A2 C) $;

--| Equality theorem for class difference. (Contributed by NM, 10-Feb-1997.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem difeq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cdif A2 C) (cdif B2 C)) $;

--| Equality theorem for class difference. (Contributed by NM, 10-Feb-1997.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem difeq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cdif C A2) (cdif C B2)) $;

--| Equality theorem for class difference. (Contributed by FL, 31-Aug-2009.)
theorem difeq12 (A2 B2 C D: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wceq (cdif A2 C) (cdif B2 D)) $;

--| Inference adding difference to the right in a class equality. (Contributed by NM, 15-Nov-2002.)
theorem difeq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cdif A2 C) (cdif B2 C) $;

--| Inference adding difference to the left in a class equality. (Contributed by NM, 15-Nov-2002.)
theorem difeq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cdif C A2) (cdif C B2) $;

--| Equality inference for class difference. (Contributed by NM, 29-Aug-2004.)
theorem difeq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (cdif A2 C) (cdif B2 D) $;

--| Deduction adding difference to the right in a class equality. (Contributed by NM, 15-Nov-2002.)
theorem difeq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cdif A2 C) (cdif B2 C)) $;

--| Deduction adding difference to the left in a class equality. (Contributed by NM, 15-Nov-2002.)
theorem difeq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cdif C A2) (cdif C B2)) $;

--| Equality deduction for class difference. (Contributed by FL, 29-May-2014.)
theorem difeq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cdif A2 C) (cdif B2 D)) $;

--| Inference from membership to difference. (Contributed by NM, 17-May-1998.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem difeqri {x3: setvar} (A2 B2 C: class):
  $ wb (wa (wcel (cv x3) A2) (wn (wcel (cv x3) B2))) (wcel (cv x3) C) $ >
  $ wceq (cdif A2 B2) C $;

--| Bound-variable hypothesis builder for class difference. (Contributed by NM, 3-Dec-2003.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem nfdif {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cdif A2 B2) $;

--| Implication of membership in a class difference. (Contributed by NM, 29-Apr-1994.)
theorem eldifi (A2 B2 C: class):
  $ wi (wcel A2 (cdif B2 C)) (wcel A2 B2) $;

--| Implication of membership in a class difference. (Contributed by NM, 3-May-1994.)
theorem eldifn (A2 B2 C: class):
  $ wi (wcel A2 (cdif B2 C)) (wn (wcel A2 C)) $;

--| A set does not belong to a class excluding it. (Contributed by NM, 27-Jun-1994.)
theorem elndif (A2 B2 C: class):
  $ wi (wcel A2 B2) (wn (wcel A2 (cdif C B2))) $;

--| Double class difference. Exercise 11 of [TakeutiZaring] p. 22. (Contributed by NM, 17-May-1998.)
theorem difdif (A2 B2: class):
  $ wceq (cdif A2 (cdif B2 A2)) A2 $;

--| Subclass relationship for class difference. Exercise 14 of [TakeutiZaring] p. 22. (Contributed by NM, 29-Apr-1994.)
theorem difss (A2 B2: class):
  $ wss (cdif A2 B2) A2 $;

--| A difference of two classes is contained in the minuend. Deduction form of ~ difss . (Contributed by David Moews, 1-May-2017.)
theorem difssd (ph: wff) (A2 B2: class):
  $ wi ph (wss (cdif A2 B2) A2) $;

--| If a class is contained in a difference, it is contained in the minuend. (Contributed by David Moews, 1-May-2017.)
theorem difss2 (A2 B2 C: class):
  $ wi (wss A2 (cdif B2 C)) (wss A2 B2) $;

--| If a class is contained in a difference, it is contained in the minuend. Deduction form of ~ difss2 . (Contributed by David Moews, 1-May-2017.)
theorem difss2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 (cdif B2 C)) $ >
  $ wi ph (wss A2 B2) $;

--| Preservation of a subclass relationship by class difference. (Contributed by NM, 15-Feb-2007.)
theorem ssdifss (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cdif A2 C) B2) $;

--| Double complement under universal class. The hypothesis is one way of expressing the idea that membership in ` A ` is decidable. Exercise 4.10(s) of [Mendelson] p. 231, but with an additional hypothesis. For a version without a hypothesis, but which only states that ` A ` is a subset of ` _V \ ( _V \ A ) ` , see ~ ddifss . (Contributed by Jim Kingdon, 21-Jul-2018.)
theorem ddifnel {x3: setvar} (A2: class):
  $ wi (wn (wcel (cv x3) (cdif cvv A2))) (wcel (cv x3) A2) $ >
  $ wceq (cdif cvv (cdif cvv A2)) A2 $;

--| Contraposition law for subsets. (Contributed by NM, 22-Mar-1998.)
theorem ssconb (A2 B2 C: class):
  $ wi (wa (wss A2 C) (wss B2 C)) (wb (wss A2 (cdif C B2)) (wss B2 (cdif C A2))) $;

--| Contraposition law for subsets. Exercise 15 of [TakeutiZaring] p. 22. (Contributed by NM, 22-Mar-1998.)
theorem sscon (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cdif C B2) (cdif C A2)) $;

--| Difference law for subsets. (Contributed by NM, 28-May-1998.)
theorem ssdif (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cdif A2 C) (cdif B2 C)) $;

--| If ` A ` is contained in ` B ` , then ` ( A \ C ) ` is contained in ` ( B \ C ) ` . Deduction form of ~ ssdif . (Contributed by David Moews, 1-May-2017.)
theorem ssdifd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss (cdif A2 C) (cdif B2 C)) $;

--| If ` A ` is contained in ` B ` , then ` ( C \ B ) ` is contained in ` ( C \ A ) ` . Deduction form of ~ sscon . (Contributed by David Moews, 1-May-2017.)
theorem sscond (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss (cdif C B2) (cdif C A2)) $;

--| If ` A ` is contained in ` B ` , then ` ( A \ C ) ` is also contained in ` B ` . Deduction form of ~ ssdifss . (Contributed by David Moews, 1-May-2017.)
theorem ssdifssd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss (cdif A2 C) B2) $;

--| If ` A ` is contained in ` B ` and ` C ` is contained in ` D ` , then ` ( A \ D ) ` is contained in ` ( B \ C ) ` . Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem ssdif2d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss C D) $ >
  $ wi ph (wss (cdif A2 D) (cdif B2 C)) $;

--| Restricted universal quantification on a class difference in terms of an implication. (Contributed by Alexander van der Vekens, 3-Jan-2018.)
theorem raldifb {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wb (wral x3 (wi (wnel (cv x3) B2) ph) A2) (wral x3 ph (cdif A2 B2)) $;

--| Expansion of membership in class union. Theorem 12 of [Suppes] p. 25. (Contributed by NM, 7-Aug-1994.)
theorem elun (A2 B2 C: class):
  $ wb (wcel A2 (cun B2 C)) (wo (wcel A2 B2) (wcel A2 C)) $;

--| Inference from membership to union. (Contributed by NM, 5-Aug-1993.)
theorem uneqri {x3: setvar} (A2 B2 C: class):
  $ wb (wo (wcel (cv x3) A2) (wcel (cv x3) B2)) (wcel (cv x3) C) $ >
  $ wceq (cun A2 B2) C $;

--| Idempotent law for union of classes. Theorem 23 of [Suppes] p. 27. (Contributed by NM, 5-Aug-1993.)
theorem unidm (A2: class):
  $ wceq (cun A2 A2) A2 $;

--| Commutative law for union of classes. Exercise 6 of [TakeutiZaring] p. 17. (Contributed by NM, 25-Jun-1998.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem uncom (A2 B2: class):
  $ wceq (cun A2 B2) (cun B2 A2) $;

--| If a class equals the union of two other classes, then it equals the union of those two classes commuted. (Contributed by Alan Sare, 18-Feb-2012.)
theorem equncom (A2 B2 C: class):
  $ wb (wceq A2 (cun B2 C)) (wceq A2 (cun C B2)) $;

--| Inference form of ~ equncom . (Contributed by Alan Sare, 18-Feb-2012.)
theorem equncomi (A2 B2 C: class):
  $ wceq A2 (cun B2 C) $ >
  $ wceq A2 (cun C B2) $;

--| Equality theorem for union of two classes. (Contributed by NM, 5-Aug-1993.)
theorem uneq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cun A2 C) (cun B2 C)) $;

--| Equality theorem for the union of two classes. (Contributed by NM, 5-Aug-1993.)
theorem uneq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cun C A2) (cun C B2)) $;

--| Equality theorem for union of two classes. (Contributed by NM, 29-Mar-1998.)
theorem uneq12 (A2 B2 C D: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wceq (cun A2 C) (cun B2 D)) $;

--| Inference adding union to the right in a class equality. (Contributed by NM, 30-Aug-1993.)
theorem uneq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cun A2 C) (cun B2 C) $;

--| Inference adding union to the left in a class equality. (Contributed by NM, 30-Aug-1993.)
theorem uneq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cun C A2) (cun C B2) $;

--| Equality inference for union of two classes. (Contributed by NM, 12-Aug-2004.) (Proof shortened by Eric Schmidt, 26-Jan-2007.)
theorem uneq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (cun A2 C) (cun B2 D) $;

--| Deduction adding union to the right in a class equality. (Contributed by NM, 29-Mar-1998.)
theorem uneq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cun A2 C) (cun B2 C)) $;

--| Deduction adding union to the left in a class equality. (Contributed by NM, 29-Mar-1998.)
theorem uneq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cun C A2) (cun C B2)) $;

--| Equality deduction for union of two classes. (Contributed by NM, 29-Sep-2004.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem uneq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cun A2 C) (cun B2 D)) $;

--| Bound-variable hypothesis builder for the union of classes. (Contributed by NM, 15-Sep-2003.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem nfun {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cun A2 B2) $;

--| Associative law for union of classes. Exercise 8 of [TakeutiZaring] p. 17. (Contributed by NM, 3-May-1994.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem unass (A2 B2 C: class):
  $ wceq (cun (cun A2 B2) C) (cun A2 (cun B2 C)) $;

--| A rearrangement of union. (Contributed by NM, 12-Aug-2004.)
theorem un12 (A2 B2 C: class):
  $ wceq (cun A2 (cun B2 C)) (cun B2 (cun A2 C)) $;

--| A rearrangement of union. (Contributed by NM, 12-Aug-2004.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem un23 (A2 B2 C: class):
  $ wceq (cun (cun A2 B2) C) (cun (cun A2 C) B2) $;

--| A rearrangement of the union of 4 classes. (Contributed by NM, 12-Aug-2004.)
theorem un4 (A2 B2 C D: class):
  $ wceq (cun (cun A2 B2) (cun C D)) (cun (cun A2 C) (cun B2 D)) $;

--| Union distributes over itself. (Contributed by NM, 17-Aug-2004.)
theorem unundi (A2 B2 C: class):
  $ wceq (cun A2 (cun B2 C)) (cun (cun A2 B2) (cun A2 C)) $;

--| Union distributes over itself. (Contributed by NM, 17-Aug-2004.)
theorem unundir (A2 B2 C: class):
  $ wceq (cun (cun A2 B2) C) (cun (cun A2 C) (cun B2 C)) $;

--| Subclass relationship for union of classes. Theorem 25 of [Suppes] p. 27. (Contributed by NM, 5-Aug-1993.)
theorem ssun1 (A2 B2: class):
  $ wss A2 (cun A2 B2) $;

--| Subclass relationship for union of classes. (Contributed by NM, 30-Aug-1993.)
theorem ssun2 (A2 B2: class):
  $ wss A2 (cun B2 A2) $;

--| Subclass law for union of classes. (Contributed by NM, 5-Aug-1993.)
theorem ssun3 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss A2 (cun B2 C)) $;

--| Subclass law for union of classes. (Contributed by NM, 14-Aug-1994.)
theorem ssun4 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss A2 (cun C B2)) $;

--| Membership law for union of classes. (Contributed by NM, 5-Aug-1993.)
theorem elun1 (A2 B2 C: class):
  $ wi (wcel A2 B2) (wcel A2 (cun B2 C)) $;

--| Membership law for union of classes. (Contributed by NM, 30-Aug-1993.)
theorem elun2 (A2 B2 C: class):
  $ wi (wcel A2 B2) (wcel A2 (cun C B2)) $;

--| Subclass law for union of classes. (Contributed by NM, 14-Oct-1999.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem unss1 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cun A2 C) (cun B2 C)) $;

--| A relationship between subclass and union. Theorem 26 of [Suppes] p. 27. (Contributed by NM, 30-Aug-1993.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem ssequn1 (A2 B2: class):
  $ wb (wss A2 B2) (wceq (cun A2 B2) B2) $;

--| Subclass law for union of classes. Exercise 7 of [TakeutiZaring] p. 18. (Contributed by NM, 14-Oct-1999.)
theorem unss2 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cun C A2) (cun C B2)) $;

--| Subclass law for union of classes. (Contributed by NM, 2-Jun-2004.)
theorem unss12 (A2 B2 C D: class):
  $ wi (wa (wss A2 B2) (wss C D)) (wss (cun A2 C) (cun B2 D)) $;

--| A relationship between subclass and union. (Contributed by NM, 13-Jun-1994.)
theorem ssequn2 (A2 B2: class):
  $ wb (wss A2 B2) (wceq (cun B2 A2) B2) $;

--| The union of two subclasses is a subclass. Theorem 27 of [Suppes] p. 27 and its converse. (Contributed by NM, 11-Jun-2004.)
theorem unss (A2 B2 C: class):
  $ wb (wa (wss A2 C) (wss B2 C)) (wss (cun A2 B2) C) $;

--| An inference showing the union of two subclasses is a subclass. (Contributed by Raph Levien, 10-Dec-2002.)
theorem unssi (A2 B2 C: class):
  $ wss A2 C $ >
  $ wss B2 C $ >
  $ wss (cun A2 B2) C $;

--| A deduction showing the union of two subclasses is a subclass. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem unssd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 C) $ >
  $ wi ph (wss B2 C) $ >
  $ wi ph (wss (cun A2 B2) C) $;

--| If ` ( A u. B ) ` is contained in ` C ` , so is ` A ` . One-way deduction form of ~ unss . Partial converse of ~ unssd . (Contributed by David Moews, 1-May-2017.)
theorem unssad (ph: wff) (A2 B2 C: class):
  $ wi ph (wss (cun A2 B2) C) $ >
  $ wi ph (wss A2 C) $;

--| If ` ( A u. B ) ` is contained in ` C ` , so is ` B ` . One-way deduction form of ~ unss . Partial converse of ~ unssd . (Contributed by David Moews, 1-May-2017.)
theorem unssbd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss (cun A2 B2) C) $ >
  $ wi ph (wss B2 C) $;

--| A condition that implies inclusion in the union of two classes. (Contributed by NM, 23-Nov-2003.)
theorem ssun (A2 B2 C: class):
  $ wi (wo (wss A2 B2) (wss A2 C)) (wss A2 (cun B2 C)) $;

--| Restricted existential quantification over union. (Contributed by Jeff Madsen, 5-Jan-2011.)
theorem rexun {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wb (wrex x3 ph (cun A2 B2)) (wo (wrex x3 ph A2) (wrex x3 ph B2)) $;

--| Restricted quantification over a union. (Contributed by Scott Fenton, 12-Apr-2011.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem ralunb {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wb (wral x3 ph (cun A2 B2)) (wa (wral x3 ph A2) (wral x3 ph B2)) $;

--| Restricted quantification over union. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem ralun {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi (wa (wral x3 ph A2) (wral x3 ph B2)) (wral x3 ph (cun A2 B2)) $;

--| Expansion of membership in an intersection of two classes. Theorem 12 of [Suppes] p. 25. (Contributed by NM, 29-Apr-1994.)
theorem elin (A2 B2 C: class):
  $ wb (wcel A2 (cin B2 C)) (wa (wcel A2 B2) (wcel A2 C)) $;

--| Membership in a class defined as an intersection. (Contributed by Stefan O'Rear, 29-Mar-2015.)
theorem elin2 (A2 B2 C X: class):
  $ wceq X (cin B2 C) $ >
  $ wb (wcel A2 X) (wa (wcel A2 B2) (wcel A2 C)) $;

--| Membership in a class defined as a ternary intersection. (Contributed by Stefan O'Rear, 29-Mar-2015.)
theorem elin3 (A2 B2 C D X: class):
  $ wceq X (cin (cin B2 C) D) $ >
  $ wb (wcel A2 X) (w3a (wcel A2 B2) (wcel A2 C) (wcel A2 D)) $;

--| Commutative law for intersection of classes. Exercise 7 of [TakeutiZaring] p. 17. (Contributed by NM, 5-Aug-1993.)
theorem incom (A2 B2: class):
  $ wceq (cin A2 B2) (cin B2 A2) $;

--| Inference from membership to intersection. (Contributed by NM, 5-Aug-1993.)
theorem ineqri {x3: setvar} (A2 B2 C: class):
  $ wb (wa (wcel (cv x3) A2) (wcel (cv x3) B2)) (wcel (cv x3) C) $ >
  $ wceq (cin A2 B2) C $;

--| Equality theorem for intersection of two classes. (Contributed by NM, 14-Dec-1993.)
theorem ineq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cin A2 C) (cin B2 C)) $;

--| Equality theorem for intersection of two classes. (Contributed by NM, 26-Dec-1993.)
theorem ineq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cin C A2) (cin C B2)) $;

--| Equality theorem for intersection of two classes. (Contributed by NM, 8-May-1994.)
theorem ineq12 (A2 B2 C D: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wceq (cin A2 C) (cin B2 D)) $;

--| Equality inference for intersection of two classes. (Contributed by NM, 26-Dec-1993.)
theorem ineq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cin A2 C) (cin B2 C) $;

--| Equality inference for intersection of two classes. (Contributed by NM, 26-Dec-1993.)
theorem ineq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cin C A2) (cin C B2) $;

--| Equality inference for intersection of two classes. (Contributed by NM, 24-Jun-2004.) (Proof shortened by Eric Schmidt, 26-Jan-2007.)
theorem ineq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (cin A2 C) (cin B2 D) $;

--| Equality deduction for intersection of two classes. (Contributed by NM, 10-Apr-1994.)
theorem ineq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cin A2 C) (cin B2 C)) $;

--| Equality deduction for intersection of two classes. (Contributed by NM, 10-Apr-1994.)
theorem ineq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cin C A2) (cin C B2)) $;

--| Equality deduction for intersection of two classes. (Contributed by NM, 24-Jun-2004.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem ineq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cin A2 C) (cin B2 D)) $;

--| Equality deduction for intersection of two classes. (Contributed by NM, 7-Feb-2007.)
theorem ineqan12d (ph ps: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ps (wceq C D) $ >
  $ wi (wa ph ps) (wceq (cin A2 C) (cin B2 D)) $;

--| A frequently-used variant of subclass definition ~ df-ss . (Contributed by NM, 10-Jan-2015.)
theorem dfss1 (A2 B2: class):
  $ wb (wss A2 B2) (wceq (cin B2 A2) A2) $;

--| Another definition of subclasshood. Similar to ~ df-ss , ~ dfss , and ~ dfss1 . (Contributed by David Moews, 1-May-2017.)
theorem dfss5 (A2 B2: class):
  $ wb (wss A2 B2) (wceq A2 (cin B2 A2)) $;

--| Bound-variable hypothesis builder for the intersection of classes. (Contributed by NM, 15-Sep-2003.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem nfin {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cin A2 B2) $;

--| Distribute proper substitution through an intersection relation. (Contributed by Alan Sare, 22-Jul-2012.)
theorem csbing {x3: setvar} (A2 B2 C D: class x3):
  $ wi (wcel A2 B2) (wceq (csb x3 A2 (cin C D)) (cin (csb x3 A2 C) (csb x3 A2 D))) $;

--| Deduction from a wff to a restricted class abstraction. (Contributed by NM, 14-Jan-2014.)
theorem rabbi2dva {x3: setvar} (ph: wff) (ps: wff x3) (A2 B2: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wb (wcel (cv x3) B2) ps) $ >
  $ wi ph (wceq (cin A2 B2) (crab x3 ps A2)) $;

--| Idempotent law for intersection of classes. Theorem 15 of [Suppes] p. 26. (Contributed by NM, 5-Aug-1993.)
theorem inidm (A2: class):
  $ wceq (cin A2 A2) A2 $;

--| Associative law for intersection of classes. Exercise 9 of [TakeutiZaring] p. 17. (Contributed by NM, 3-May-1994.)
theorem inass (A2 B2 C: class):
  $ wceq (cin (cin A2 B2) C) (cin A2 (cin B2 C)) $;

--| A rearrangement of intersection. (Contributed by NM, 21-Apr-2001.)
theorem in12 (A2 B2 C: class):
  $ wceq (cin A2 (cin B2 C)) (cin B2 (cin A2 C)) $;

--| A rearrangement of intersection. (Contributed by NM, 21-Apr-2001.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem in32 (A2 B2 C: class):
  $ wceq (cin (cin A2 B2) C) (cin (cin A2 C) B2) $;

--| A rearrangement of intersection. (Contributed by NM, 27-Aug-2012.)
theorem in13 (A2 B2 C: class):
  $ wceq (cin A2 (cin B2 C)) (cin C (cin B2 A2)) $;

--| A rearrangement of intersection. (Contributed by NM, 27-Aug-2012.)
theorem in31 (A2 B2 C: class):
  $ wceq (cin (cin A2 B2) C) (cin (cin C B2) A2) $;

--| Rotate the intersection of 3 classes. (Contributed by NM, 27-Aug-2012.)
theorem inrot (A2 B2 C: class):
  $ wceq (cin (cin A2 B2) C) (cin (cin C A2) B2) $;

--| Rearrangement of intersection of 4 classes. (Contributed by NM, 21-Apr-2001.)
theorem in4 (A2 B2 C D: class):
  $ wceq (cin (cin A2 B2) (cin C D)) (cin (cin A2 C) (cin B2 D)) $;

--| Intersection distributes over itself. (Contributed by NM, 6-May-1994.)
theorem inindi (A2 B2 C: class):
  $ wceq (cin A2 (cin B2 C)) (cin (cin A2 B2) (cin A2 C)) $;

--| Intersection distributes over itself. (Contributed by NM, 17-Aug-2004.)
theorem inindir (A2 B2 C: class):
  $ wceq (cin (cin A2 B2) C) (cin (cin A2 C) (cin B2 C)) $;

--| A relationship between subclass and intersection. Similar to Exercise 9 of [TakeutiZaring] p. 18. (Contributed by NM, 17-May-1994.)
theorem sseqin2 (A2 B2: class):
  $ wb (wss A2 B2) (wceq (cin B2 A2) A2) $;

--| The intersection of two classes is a subset of one of them. Part of Exercise 12 of [TakeutiZaring] p. 18. (Contributed by NM, 27-Apr-1994.)
theorem inss1 (A2 B2: class):
  $ wss (cin A2 B2) A2 $;

--| The intersection of two classes is a subset of one of them. Part of Exercise 12 of [TakeutiZaring] p. 18. (Contributed by NM, 27-Apr-1994.)
theorem inss2 (A2 B2: class):
  $ wss (cin A2 B2) B2 $;

--| Subclass of intersection. Theorem 2.8(vii) of [Monk1] p. 26. (Contributed by NM, 15-Jun-2004.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem ssin (A2 B2 C: class):
  $ wb (wa (wss A2 B2) (wss A2 C)) (wss A2 (cin B2 C)) $;

--| An inference showing that a subclass of two classes is a subclass of their intersection. (Contributed by NM, 24-Nov-2003.)
theorem ssini (A2 B2 C: class):
  $ wss A2 B2 $ >
  $ wss A2 C $ >
  $ wss A2 (cin B2 C) $;

--| A deduction showing that a subclass of two classes is a subclass of their intersection. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem ssind (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss A2 C) $ >
  $ wi ph (wss A2 (cin B2 C)) $;

--| Add right intersection to subclass relation. (Contributed by NM, 16-Aug-1994.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem ssrin (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cin A2 C) (cin B2 C)) $;

--| Add left intersection to subclass relation. (Contributed by NM, 19-Oct-1999.)
theorem sslin (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cin C A2) (cin C B2)) $;

--| Intersection of subclasses. (Contributed by NM, 5-May-2000.)
theorem ss2in (A2 B2 C D: class):
  $ wi (wa (wss A2 B2) (wss C D)) (wss (cin A2 C) (cin B2 D)) $;

--| Intersection preserves subclass relationship. (Contributed by NM, 14-Sep-1999.)
theorem ssinss1 (A2 B2 C: class):
  $ wi (wss A2 C) (wss (cin A2 B2) C) $;

--| Inclusion of an intersection of two classes. (Contributed by NM, 30-Oct-2014.)
theorem inss (A2 B2 C: class):
  $ wi (wo (wss A2 C) (wss B2 C)) (wss (cin A2 B2) C) $;

--| Absorption law for union. (Contributed by NM, 16-Apr-2006.)
theorem unabs (A2 B2: class):
  $ wceq (cun A2 (cin A2 B2)) A2 $;

--| Absorption law for intersection. (Contributed by NM, 16-Apr-2006.)
theorem inabs (A2 B2: class):
  $ wceq (cin A2 (cun A2 B2)) A2 $;

--| Negation of subclass expressed in terms of intersection and proper subclass. (Contributed by NM, 30-Jun-2004.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem nssinpss (A2 B2: class):
  $ wb (wn (wss A2 B2)) (wpss (cin A2 B2) A2) $;

--| Negation of subclass expressed in terms of proper subclass and union. (Contributed by NM, 15-Sep-2004.)
theorem nsspssun (A2 B2: class):
  $ wb (wn (wss A2 B2)) (wpss B2 (cun A2 B2)) $;

--| Double complement and subset. Similar to ~ ddifss but inside a class ` B ` instead of the universal class ` _V ` . In classical logic the subset operation on the right hand side could be an equality (that is, ` A C_ B <-> ( B \ ( B \ A ) ) = A ` ). (Contributed by Jim Kingdon, 24-Jul-2018.)
theorem ssddif (A2 B2: class):
  $ wb (wss A2 B2) (wss A2 (cdif B2 (cdif B2 A2))) $;

--| Union of two classes and class difference. In classical logic this would be an equality. (Contributed by Jim Kingdon, 24-Jul-2018.)
theorem unssdif (A2 B2: class):
  $ wss (cun A2 B2) (cdif cvv (cdif (cdif cvv A2) B2)) $;

--| Intersection of two classes and class difference. In classical logic this would be an equality. (Contributed by Jim Kingdon, 24-Jul-2018.)
theorem inssdif (A2 B2: class):
  $ wss (cin A2 B2) (cdif A2 (cdif cvv B2)) $;

--| Difference with intersection. Theorem 33 of [Suppes] p. 29. (Contributed by NM, 31-Mar-1998.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem difin (A2 B2: class):
  $ wceq (cdif A2 (cin A2 B2)) (cdif A2 B2) $;

--| Double complement under universal class. In classical logic (or given an additional hypothesis, as in ~ ddifnel ), this is equality rather than subset. (Contributed by Jim Kingdon, 24-Jul-2018.)
theorem ddifss (A2: class):
  $ wss A2 (cdif cvv (cdif cvv A2)) $;

--| Union as a subset of class complement and intersection (De Morgan's law). One direction of the definition of union in [Mendelson] p. 231. This would be an equality, rather than subset, in classical logic. (Contributed by Jim Kingdon, 25-Jul-2018.)
theorem unssin (A2 B2: class):
  $ wss (cun A2 B2) (cdif cvv (cin (cdif cvv A2) (cdif cvv B2))) $;

--| Intersection in terms of class difference and union (De Morgan's law). Similar to Exercise 4.10(n) of [Mendelson] p. 231. This would be an equality, rather than subset, in classical logic. (Contributed by Jim Kingdon, 25-Jul-2018.)
theorem inssun (A2 B2: class):
  $ wss (cin A2 B2) (cdif cvv (cun (cdif cvv A2) (cdif cvv B2))) $;

--| Intersection of two classes and class difference. In classical logic, such as Exercise 4.10(q) of [Mendelson] p. 231, this is an equality rather than subset. (Contributed by Jim Kingdon, 26-Jul-2018.)
theorem inssddif (A2 B2: class):
  $ wss (cin A2 B2) (cdif A2 (cdif A2 B2)) $;

--| Intersection with universal complement. Remark in [Stoll] p. 20. (Contributed by NM, 17-Aug-2004.)
theorem invdif (A2 B2: class):
  $ wceq (cin A2 (cdif cvv B2)) (cdif A2 B2) $;

--| Intersection with class difference. Theorem 34 of [Suppes] p. 29. (Contributed by NM, 17-Aug-2004.)
theorem indif (A2 B2: class):
  $ wceq (cin A2 (cdif A2 B2)) (cdif A2 B2) $;

--| Bring an intersection in and out of a class difference. (Contributed by Jeff Hankins, 15-Jul-2009.)
theorem indif2 (A2 B2 C: class):
  $ wceq (cin A2 (cdif B2 C)) (cdif (cin A2 B2) C) $;

--| Bring an intersection in and out of a class difference. (Contributed by Mario Carneiro, 15-May-2015.)
theorem indif1 (A2 B2 C: class):
  $ wceq (cin (cdif A2 C) B2) (cdif (cin A2 B2) C) $;

--| Commutation law for intersection and difference. (Contributed by Scott Fenton, 18-Feb-2013.)
theorem indifcom (A2 B2 C: class):
  $ wceq (cin A2 (cdif B2 C)) (cin B2 (cdif A2 C)) $;

--| Distributive law for intersection over union. Exercise 10 of [TakeutiZaring] p. 17. (Contributed by NM, 30-Sep-2002.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem indi (A2 B2 C: class):
  $ wceq (cin A2 (cun B2 C)) (cun (cin A2 B2) (cin A2 C)) $;

--| Distributive law for union over intersection. Exercise 11 of [TakeutiZaring] p. 17. (Contributed by NM, 30-Sep-2002.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem undi (A2 B2 C: class):
  $ wceq (cun A2 (cin B2 C)) (cin (cun A2 B2) (cun A2 C)) $;

--| Distributive law for intersection over union. Theorem 28 of [Suppes] p. 27. (Contributed by NM, 30-Sep-2002.)
theorem indir (A2 B2 C: class):
  $ wceq (cin (cun A2 B2) C) (cun (cin A2 C) (cin B2 C)) $;

--| Distributive law for union over intersection. Theorem 29 of [Suppes] p. 27. (Contributed by NM, 30-Sep-2002.)
theorem undir (A2 B2 C: class):
  $ wceq (cun (cin A2 B2) C) (cin (cun A2 C) (cun B2 C)) $;

--| Equality of union and intersection implies equality of their arguments. (Contributed by NM, 16-Apr-2006.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem uneqin (A2 B2: class):
  $ wb (wceq (cun A2 B2) (cin A2 B2)) (wceq A2 B2) $;

--| Distributive law for class difference. Theorem 39 of [Suppes] p. 29. (Contributed by NM, 17-Aug-2004.)
theorem difundi (A2 B2 C: class):
  $ wceq (cdif A2 (cun B2 C)) (cin (cdif A2 B2) (cdif A2 C)) $;

--| Distributive law for class difference. (Contributed by NM, 17-Aug-2004.)
theorem difundir (A2 B2 C: class):
  $ wceq (cdif (cun A2 B2) C) (cun (cdif A2 C) (cdif B2 C)) $;

--| Distributive law for class difference. In classical logic, for example, theorem 40 of [Suppes] p. 29, this is an equality instead of subset. (Contributed by Jim Kingdon, 26-Jul-2018.)
theorem difindiss (A2 B2 C: class):
  $ wss (cun (cdif A2 B2) (cdif A2 C)) (cdif A2 (cin B2 C)) $;

--| Distributive law for class difference. (Contributed by NM, 17-Aug-2004.)
theorem difindir (A2 B2 C: class):
  $ wceq (cdif (cin A2 B2) C) (cin (cdif A2 C) (cdif B2 C)) $;

--| Distribute intersection over difference. (Contributed by Scott Fenton, 14-Apr-2011.)
theorem indifdir (A2 B2 C: class):
  $ wceq (cin (cdif A2 B2) C) (cdif (cin A2 C) (cin B2 C)) $;

--| Set difference with a set difference. In classical logic this would be equality rather than subset. (Contributed by Jim Kingdon, 27-Jul-2018.)
theorem difdif2ss (A2 B2 C: class):
  $ wss (cun (cdif A2 B2) (cin A2 C)) (cdif A2 (cdif B2 C)) $;

--| De Morgan's law for union. Theorem 5.2(13) of [Stoll] p. 19. (Contributed by NM, 18-Aug-2004.)
theorem undm (A2 B2: class):
  $ wceq (cdif cvv (cun A2 B2)) (cin (cdif cvv A2) (cdif cvv B2)) $;

--| De Morgan's law for intersection. In classical logic, this would be equality rather than subset, as in Theorem 5.2(13') of [Stoll] p. 19. (Contributed by Jim Kingdon, 27-Jul-2018.)
theorem indmss (A2 B2: class):
  $ wss (cun (cdif cvv A2) (cdif cvv B2)) (cdif cvv (cin A2 B2)) $;

--| A relationship involving double difference and union. (Contributed by NM, 29-Aug-2004.)
theorem difun1 (A2 B2 C: class):
  $ wceq (cdif A2 (cun B2 C)) (cdif (cdif A2 B2) C) $;

--| A subset relationship involving class union and class difference. In classical logic, this would be equality rather than subset, as in the first equality of Exercise 13 of [TakeutiZaring] p. 22. (Contributed by Jim Kingdon, 28-Jul-2018.)
theorem undif3ss (A2 B2 C: class):
  $ wss (cun A2 (cdif B2 C)) (cdif (cun A2 B2) (cdif C A2)) $;

--| Represent a set difference as an intersection with a larger difference. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem difin2 (A2 B2 C: class):
  $ wi (wss A2 C) (wceq (cdif A2 B2) (cin (cdif C B2) A2)) $;

--| Swap second and third argument of double difference. (Contributed by NM, 18-Aug-2004.)
theorem dif32 (A2 B2 C: class):
  $ wceq (cdif (cdif A2 B2) C) (cdif (cdif A2 C) B2) $;

--| Absorption-like law for class difference: you can remove a class only once. (Contributed by FL, 2-Aug-2009.)
theorem difabs (A2 B2: class):
  $ wceq (cdif (cdif A2 B2) B2) (cdif A2 B2) $;

--| Two ways to express symmetric difference. This theorem shows the equivalence of the definition of symmetric difference in [Stoll] p. 13 and the restated definition in Example 4.1 of [Stoll] p. 262. (Contributed by NM, 17-Aug-2004.)
theorem symdif1 (A2 B2: class):
  $ wceq (cun (cdif A2 B2) (cdif B2 A2)) (cdif (cun A2 B2) (cin A2 B2)) $;

--| Expressing symmetric difference with exclusive-or or two differences. (Contributed by Jim Kingdon, 28-Jul-2018.)
theorem symdifxor {x3: setvar} (A2 B2: class):
  $ wceq (cun (cdif A2 B2) (cdif B2 A2)) (cab x3 (wxo (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| Union of two class abstractions. (Contributed by NM, 29-Sep-2002.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem unab {x3: setvar} (ph ps: wff x3):
  $ wceq (cun (cab x3 ph) (cab x3 ps)) (cab x3 (wo ph ps)) $;

--| Intersection of two class abstractions. (Contributed by NM, 29-Sep-2002.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem inab {x3: setvar} (ph ps: wff x3):
  $ wceq (cin (cab x3 ph) (cab x3 ps)) (cab x3 (wa ph ps)) $;

--| Difference of two class abstractions. (Contributed by NM, 23-Oct-2004.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem difab {x3: setvar} (ph ps: wff x3):
  $ wceq (cdif (cab x3 ph) (cab x3 ps)) (cab x3 (wa ph (wn ps))) $;

--| A class builder defined by a negation. (Contributed by FL, 18-Sep-2010.)
theorem notab {x3: setvar} (ph: wff x3):
  $ wceq (cab x3 (wn ph)) (cdif cvv (cab x3 ph)) $;

--| Union of two restricted class abstractions. (Contributed by NM, 25-Mar-2004.)
theorem unrab {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wceq (cun (crab x3 ph A2) (crab x3 ps A2)) (crab x3 (wo ph ps) A2) $;

--| Intersection of two restricted class abstractions. (Contributed by NM, 1-Sep-2006.)
theorem inrab {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wceq (cin (crab x3 ph A2) (crab x3 ps A2)) (crab x3 (wa ph ps) A2) $;

--| Intersection with a restricted class abstraction. (Contributed by NM, 19-Nov-2007.)
theorem inrab2 {x3: setvar} (ph: wff x3) (A2: class x3) (B2: class):
  $ wceq (cin (crab x3 ph A2) B2) (crab x3 ph (cin A2 B2)) $;

--| Difference of two restricted class abstractions. (Contributed by NM, 23-Oct-2004.)
theorem difrab {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wceq (cdif (crab x3 ph A2) (crab x3 ps A2)) (crab x3 (wa ph (wn ps)) A2) $;

--| Alternate definition of restricted class abstraction. (Contributed by NM, 20-Sep-2003.)
theorem dfrab2 {x3: setvar} (ph: wff x3) (A2: class):
  $ wceq (crab x3 ph A2) (cin (cab x3 ph) A2) $;

--| Alternate definition of restricted class abstraction. (Contributed by Mario Carneiro, 8-Sep-2013.)
theorem dfrab3 {x3: setvar} (ph: wff x3) (A2: class):
  $ wceq (crab x3 ph A2) (cin A2 (cab x3 ph)) $;

--| Complementation of restricted class abstractions. (Contributed by Mario Carneiro, 3-Sep-2015.)
theorem notrab {x3: setvar} (ph: wff x3) (A2: class):
  $ wceq (cdif A2 (crab x3 ph A2)) (crab x3 (wn ph) A2) $;

--| Restricted class abstraction with a common superset. (Contributed by Stefan O'Rear, 12-Sep-2015.) (Proof shortened by Mario Carneiro, 8-Nov-2015.)
theorem dfrab3ss {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wss A2 B2) (wceq (crab x3 ph A2) (cin A2 (crab x3 ph B2))) $;

--| Abstraction restricted to a union. (Contributed by Stefan O'Rear, 5-Feb-2015.)
theorem rabun2 {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wceq (crab x3 ph (cun A2 B2)) (cun (crab x3 ph A2) (crab x3 ph B2)) $;

--| Transfer uniqueness to a smaller subclass. (Contributed by NM, 20-Oct-2005.)
theorem reuss2 {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi (wa (wa (wss A2 B2) (wral x3 (wi ph ps) A2)) (wa (wrex x3 ph A2) (wreu x3 ps B2))) (wreu x3 ph A2) $;

--| Transfer uniqueness to a smaller subclass. (Contributed by NM, 21-Aug-1999.)
theorem reuss {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (w3a (wss A2 B2) (wrex x3 ph A2) (wreu x3 ph B2)) (wreu x3 ph A2) $;

--| Transfer uniqueness to a smaller class. (Contributed by NM, 21-Oct-2005.)
theorem reuun1 {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi (wa (wrex x3 ph A2) (wreu x3 (wo ph ps) (cun A2 B2))) (wreu x3 ph A2) $;

--| Transfer uniqueness to a smaller or larger class. (Contributed by NM, 21-Oct-2005.)
theorem reuun2 {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wn (wrex x3 ph B2)) (wb (wreu x3 ph (cun A2 B2)) (wreu x3 ph A2)) $;

--| Restricted uniqueness "picks" a member of a subclass. (Contributed by NM, 21-Aug-1999.)
theorem reupick {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wa (wa (wss A2 B2) (wa (wrex x3 ph A2) (wreu x3 ph B2))) ph) (wb (wcel (cv x3) A2) (wcel (cv x3) B2)) $;

--| Restricted uniqueness "picks" a member of a subclass. (Contributed by Mario Carneiro, 19-Nov-2016.)
theorem reupick3 {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wi (w3a (wreu x3 ph A2) (wrex x3 (wa ph ps) A2) (wcel (cv x3) A2)) (wi ph ps) $;

--| Restricted uniqueness "picks" a member of a subclass. (Contributed by Mario Carneiro, 15-Dec-2013.) (Proof shortened by Mario Carneiro, 19-Nov-2016.)
theorem reupick2 {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wi (wa (w3a (wral x3 (wi ps ph) A2) (wrex x3 ps A2) (wreu x3 ph A2)) (wcel (cv x3) A2)) (wb ph ps) $;

--| Extend class notation to include the empty set.
term c0: class;

--| Define the empty set. Special case of Exercise 4.10(o) of [Mendelson] p. 231. For a more traditional definition, but requiring a dummy variable, see ~ dfnul2 . (Contributed by NM, 5-Aug-1993.)
axiom df_nul:
  $ wceq c0 (cdif cvv cvv) $;

--| Alternate definition of the empty set. Definition 5.14 of [TakeutiZaring] p. 20. (Contributed by NM, 26-Dec-1996.)
theorem dfnul2 {x3: setvar}:
  $ wceq c0 (cab x3 (wn (wceq (cv x3) (cv x3)))) $;

--| Alternate definition of the empty set. (Contributed by NM, 25-Mar-2004.)
theorem dfnul3 {x3: setvar} (A2: class x3):
  $ wceq c0 (crab x3 (wn (wcel (cv x3) A2)) A2) $;

--| The empty set has no elements. Theorem 6.14 of [Quine] p. 44. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Mario Carneiro, 1-Sep-2015.)
theorem noel (A2: class):
  $ wn (wcel A2 c0) $;

--| If a set has elements, it is not empty. A set with elements is also inhabited, see ~ elex2 . (Contributed by NM, 31-Dec-1993.)
theorem n0i (A2 B2: class):
  $ wi (wcel B2 A2) (wn (wceq A2 c0)) $;

--| If a set has elements, it is not empty. A set with elements is also inhabited, see ~ elex2 . (Contributed by NM, 31-Dec-1993.)
theorem ne0i (A2 B2: class):
  $ wi (wcel B2 A2) (wne A2 c0) $;

--| The universal class is not equal to the empty set. (Contributed by NM, 11-Sep-2008.)
theorem vn0:
  $ wne cvv c0 $;

--| The universal class is inhabited. (Contributed by Jim Kingdon, 17-Dec-2018.)
theorem vn0m {x3: setvar}:
  $ wex x3 (wcel (cv x3) cvv) $;

--| An inhabited class is nonempty. Following the Definition of [Bauer], p. 483, we call a class ` A ` nonempty if ` A =/= (/) ` and inhabited if it has at least one element. In classical logic these two concepts are equivalent, for example see Proposition 5.17(1) of [TakeutiZaring] p. 20. This version of ~ n0r requires only that ` x ` not be free in, rather than not occur in, ` A ` . (Contributed by Jim Kingdon, 31-Jul-2018.)
theorem n0rf {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wi (wex x3 (wcel (cv x3) A2)) (wne A2 c0) $;

--| An inhabited class is nonempty. See ~ n0rf for more discussion. (Contributed by Jim Kingdon, 31-Jul-2018.)
theorem n0r {x3: setvar} (A2: class):
  $ wi (wex x3 (wcel (cv x3) A2)) (wne A2 c0) $;

--| An inhabited class is nonempty. See ~ n0rf for more discussion. (Contributed by Jim Kingdon, 31-Jul-2018.)
theorem neq0r {x3: setvar} (A2: class):
  $ wi (wex x3 (wcel (cv x3) A2)) (wn (wceq A2 c0)) $;

--| Restricted existence deduced from inhabited class. (Contributed by Jim Kingdon, 31-Jul-2018.)
theorem reximdva0m {x3: setvar} (ph: wff) (ps: wff x3) (A2: class):
  $ wi (wa ph (wcel (cv x3) A2)) ps $ >
  $ wi (wa ph (wex x3 (wcel (cv x3) A2))) (wrex x3 ps A2) $;

--| A case of equivalence of "at most one" and "only one". If a class is inhabited, that class having at most one element is equivalent to it having only one element. (Contributed by Jim Kingdon, 31-Jul-2018.)
theorem n0mmoeu {x3: setvar} (A2: class):
  $ wi (wex x3 (wcel (cv x3) A2)) (wb (wmo x3 (wcel (cv x3) A2)) (weu x3 (wcel (cv x3) A2))) $;

--| Vacuous existential quantification is false. (Contributed by NM, 15-Oct-2003.)
theorem rex0 {x3: setvar} (ph: wff x3):
  $ wn (wrex x3 ph c0) $;

--| The empty set has no elements. Theorem 2 of [Suppes] p. 22. (Contributed by NM, 29-Aug-1993.)
theorem eq0 {x3: setvar} (A2: class):
  $ wb (wceq A2 c0) (wal x3 (wn (wcel (cv x3) A2))) $;

--| The universe contains every set. (Contributed by NM, 11-Sep-2006.)
theorem eqv {x3: setvar} (A2: class):
  $ wb (wceq A2 cvv) (wal x3 (wcel (cv x3) A2)) $;

--| Membership of the empty set in another class. (Contributed by NM, 29-Jun-2004.)
theorem _0el {x3 y1: setvar} (A2: class y1):
  $ wb (wcel c0 A2) (wrex x3 (wal y1 (wn (wcel (cv y1) (cv x3)))) A2) $;

--| The class builder of a decidable proposition not containing the abstraction variable is either the universal class or the empty set. (Contributed by Jim Kingdon, 1-Aug-2018.)
theorem abvor0dc {x3: setvar} (ph: wff):
  $ wi (wdc ph) (wo (wceq (cab x3 ph) cvv) (wceq (cab x3 ph) c0)) $;

--| Nonempty class abstraction. (Contributed by Jim Kingdon, 1-Aug-2018.)
theorem abn0r {x3: setvar} (ph: wff x3):
  $ wi (wex x3 ph) (wne (cab x3 ph) c0) $;

--| Non-empty restricted class abstraction. (Contributed by Jim Kingdon, 1-Aug-2018.)
theorem rabn0r {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wrex x3 ph A2) (wne (crab x3 ph A2) c0) $;

--| Inhabited restricted class abstraction. (Contributed by Jim Kingdon, 18-Sep-2018.)
theorem rabn0m {x3 y1: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wex y1 (wcel (cv y1) (crab x3 ph A2))) (wrex x3 ph A2) $;

--| Any restricted class abstraction restricted to the empty set is empty. (Contributed by NM, 15-Oct-2003.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem rab0 {x3: setvar} (ph: wff x3):
  $ wceq (crab x3 ph c0) c0 $;

--| Condition for a restricted class abstraction to be empty. (Contributed by Jeff Madsen, 7-Jun-2010.)
theorem rabeq0 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wceq (crab x3 ph A2) c0) (wral x3 (wn ph) A2) $;

--| Condition for a class abstraction to be empty. (Contributed by Jim Kingdon, 12-Aug-2018.)
theorem abeq0 {x3: setvar} (ph: wff x3):
  $ wb (wceq (cab x3 ph) c0) (wal x3 (wn ph)) $;

--| Law of excluded middle given decidability, in terms of restricted class abstractions. (Contributed by Jim Kingdon, 2-Aug-2018.)
theorem rabxmdc {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wal x3 (wdc ph)) (wceq A2 (cun (crab x3 ph A2) (crab x3 (wn ph) A2))) $;

--| Law of noncontradiction, in terms of restricted class abstractions. (Contributed by Jeff Madsen, 20-Jun-2011.)
theorem rabnc {x3: setvar} (ph: wff x3) (A2: class):
  $ wceq (cin (crab x3 ph A2) (crab x3 (wn ph) A2)) c0 $;

--| The union of a class with the empty set is itself. Theorem 24 of [Suppes] p. 27. (Contributed by NM, 5-Aug-1993.)
theorem un0 (A2: class):
  $ wceq (cun A2 c0) A2 $;

--| The intersection of a class with the empty set is the empty set. Theorem 16 of [Suppes] p. 26. (Contributed by NM, 5-Aug-1993.)
theorem in0 (A2: class):
  $ wceq (cin A2 c0) c0 $;

--| The intersection of a class with the universal class is itself. Exercise 4.10(k) of [Mendelson] p. 231. (Contributed by NM, 17-May-1998.)
theorem inv1 (A2: class):
  $ wceq (cin A2 cvv) A2 $;

--| The union of a class with the universal class is the universal class. Exercise 4.10(l) of [Mendelson] p. 231. (Contributed by NM, 17-May-1998.)
theorem unv (A2: class):
  $ wceq (cun A2 cvv) cvv $;

--| The null set is a subset of any class. Part of Exercise 1 of [TakeutiZaring] p. 22. (Contributed by NM, 5-Aug-1993.)
theorem _0ss (A2: class):
  $ wss c0 A2 $;

--| Any subset of the empty set is empty. Theorem 5 of [Suppes] p. 23 and its converse. (Contributed by NM, 17-Sep-2003.)
theorem ss0b (A2: class):
  $ wb (wss A2 c0) (wceq A2 c0) $;

--| Any subset of the empty set is empty. Theorem 5 of [Suppes] p. 23. (Contributed by NM, 13-Aug-1994.)
theorem ss0 (A2: class):
  $ wi (wss A2 c0) (wceq A2 c0) $;

--| A subclass of an empty class is empty. (Contributed by NM, 7-Mar-2007.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem sseq0 (A2 B2: class):
  $ wi (wa (wss A2 B2) (wceq B2 c0)) (wceq A2 c0) $;

--| A class with a nonempty subclass is nonempty. (Contributed by NM, 17-Feb-2007.)
theorem ssn0 (A2 B2: class):
  $ wi (wa (wss A2 B2) (wne A2 c0)) (wne B2 c0) $;

--| A class builder with a false argument is empty. (Contributed by NM, 20-Jan-2012.)
theorem abf {x3: setvar} (ph: wff x3):
  $ wn ph $ >
  $ wceq (cab x3 ph) c0 $;

--| Deduction rule for equality to the empty set. (Contributed by NM, 11-Jul-2014.)
theorem eq0rdv {x3: setvar} (ph: wff) (A2: class):
  $ wi ph (wn (wcel (cv x3) A2)) $ >
  $ wi ph (wceq A2 c0) $;

--| The proper substitution of a proper class for a set into a class results in the empty set. (Contributed by NM, 17-Aug-2018.)
theorem csbprc {x3: setvar} (A2 B2: class x3):
  $ wi (wn (wcel A2 cvv)) (wceq (csb x3 A2 B2) c0) $;

--| Two classes are empty iff their union is empty. (Contributed by NM, 11-Aug-2004.)
theorem un00 (A2 B2: class):
  $ wb (wa (wceq A2 c0) (wceq B2 c0)) (wceq (cun A2 B2) c0) $;

--| Only the universal class has the universal class as a subclass. (Contributed by NM, 17-Sep-2003.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem vss (A2: class):
  $ wb (wss cvv A2) (wceq A2 cvv) $;

--| The null set is a proper subset of any non-empty set. (Contributed by NM, 27-Feb-1996.)
theorem _0pss (A2: class):
  $ wb (wpss c0 A2) (wne A2 c0) $;

--| No set is a proper subset of the empty set. (Contributed by NM, 17-Jun-1998.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem npss0 (A2: class):
  $ wn (wpss A2 c0) $;

--| Any non-universal class is a proper subclass of the universal class. (Contributed by NM, 17-May-1998.)
theorem pssv (A2: class):
  $ wb (wpss A2 cvv) (wn (wceq A2 cvv)) $;

--| Two ways of saying that two classes are disjoint (have no members in common). (Contributed by NM, 17-Feb-2004.)
theorem disj {x3: setvar} (A2 B2: class):
  $ wb (wceq (cin A2 B2) c0) (wral x3 (wn (wcel (cv x3) B2)) A2) $;

--| Two ways of saying that two classes are disjoint. (Contributed by Jeff Madsen, 19-Jun-2011.)
theorem disjr {x3: setvar} (A2 B2: class):
  $ wb (wceq (cin A2 B2) c0) (wral x3 (wn (wcel (cv x3) A2)) B2) $;

--| Two ways of saying that two classes are disjoint (have no members in common). (Contributed by NM, 19-Aug-1993.)
theorem disj1 {x3: setvar} (A2 B2: class):
  $ wb (wceq (cin A2 B2) c0) (wal x3 (wi (wcel (cv x3) A2) (wn (wcel (cv x3) B2)))) $;

--| Two ways of saying that two classes are disjoint, using the complement of ` B ` relative to a universe ` C ` . (Contributed by NM, 15-Feb-2007.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem reldisj (A2 B2 C: class):
  $ wi (wss A2 C) (wb (wceq (cin A2 B2) c0) (wss A2 (cdif C B2))) $;

--| Two ways of saying that two classes are disjoint. (Contributed by NM, 19-May-1998.)
theorem disj3 (A2 B2: class):
  $ wb (wceq (cin A2 B2) c0) (wceq A2 (cdif A2 B2)) $;

--| Members of disjoint sets are not equal. (Contributed by NM, 28-Mar-2007.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem disjne (A2 B2 C D: class):
  $ wi (w3a (wceq (cin A2 B2) c0) (wcel C A2) (wcel D B2)) (wne C D) $;

--| A set can't belong to both members of disjoint classes. (Contributed by NM, 28-Feb-2015.)
theorem disjel (A2 B2 C: class):
  $ wi (wa (wceq (cin A2 B2) c0) (wcel C A2)) (wn (wcel C B2)) $;

--| Two ways of saying that two classes are disjoint. (Contributed by NM, 17-May-1998.)
theorem disj2 (A2 B2: class):
  $ wb (wceq (cin A2 B2) c0) (wss A2 (cdif cvv B2)) $;

--| A consequence of two classes being disjoint. In classical logic this would be a biconditional. (Contributed by Jim Kingdon, 2-Aug-2018.)
theorem disj4im (A2 B2: class):
  $ wi (wceq (cin A2 B2) c0) (wn (wpss (cdif A2 B2) A2)) $;

--| Intersection with a subclass of a disjoint class. (Contributed by FL, 24-Jan-2007.)
theorem ssdisj (A2 B2 C: class):
  $ wi (wa (wss A2 B2) (wceq (cin B2 C) c0)) (wceq (cin A2 C) c0) $;

--| A class is a proper subset of its union with a disjoint nonempty class. (Contributed by NM, 15-Sep-2004.)
theorem disjpss (A2 B2: class):
  $ wi (wa (wceq (cin A2 B2) c0) (wne B2 c0)) (wpss A2 (cun A2 B2)) $;

--| The union of disjoint classes is disjoint. (Contributed by NM, 26-Sep-2004.)
theorem undisj1 (A2 B2 C: class):
  $ wb (wa (wceq (cin A2 C) c0) (wceq (cin B2 C) c0)) (wceq (cin (cun A2 B2) C) c0) $;

--| The union of disjoint classes is disjoint. (Contributed by NM, 13-Sep-2004.)
theorem undisj2 (A2 B2 C: class):
  $ wb (wa (wceq (cin A2 B2) c0) (wceq (cin A2 C) c0)) (wceq (cin A2 (cun B2 C)) c0) $;

--| Subclass implies empty intersection with difference from the universal class. (Contributed by NM, 17-Sep-2003.)
theorem ssindif0im (A2 B2: class):
  $ wi (wss A2 B2) (wceq (cin A2 (cdif cvv B2)) c0) $;

--| The intersection of classes with a common member is nonempty. (Contributed by NM, 7-Apr-1994.)
theorem inelcm (A2 B2 C: class):
  $ wi (wa (wcel A2 B2) (wcel A2 C)) (wne (cin B2 C) c0) $;

--| A minimum element of a class has no elements in common with the class. (Contributed by NM, 22-Jun-1994.)
theorem minel (A2 B2 C: class):
  $ wi (wa (wcel A2 B2) (wceq (cin C B2) c0)) (wn (wcel A2 C)) $;

--| Distribute union over difference. (Contributed by NM, 17-May-1998.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem undif4 (A2 B2 C: class):
  $ wi (wceq (cin A2 C) c0) (wceq (cun A2 (cdif B2 C)) (cdif (cun A2 B2) C)) $;

--| Subset relation for disjoint classes. (Contributed by NM, 25-Oct-2005.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem disjssun (A2 B2 C: class):
  $ wi (wceq (cin A2 B2) c0) (wb (wss A2 (cun B2 C)) (wss A2 C)) $;

--| Subclass implies empty difference. One direction of Exercise 7 of [TakeutiZaring] p. 22. In classical logic this would be an equivalence. (Contributed by Jim Kingdon, 2-Aug-2018.)
theorem ssdif0im (A2 B2: class):
  $ wi (wss A2 B2) (wceq (cdif A2 B2) c0) $;

--| Universal class equality in terms of empty difference. (Contributed by Jim Kingdon, 3-Aug-2018.)
theorem vdif0im (A2: class):
  $ wi (wceq A2 cvv) (wceq (cdif cvv A2) c0) $;

--| If the difference between the restricting class of a restricted class abstraction and the restricted class abstraction is empty, the restricting class is equal to this restricted class abstraction. (Contributed by Jim Kingdon, 3-Aug-2018.)
theorem difrab0eqim {x3: setvar} (ph: wff x3) (V: class):
  $ wi (wceq V (crab x3 ph V)) (wceq (cdif V (crab x3 ph V)) c0) $;

--| A subclass missing a member is a proper subclass. (Contributed by NM, 12-Jan-2002.)
theorem ssnelpss (A2 B2 C: class):
  $ wi (wss A2 B2) (wi (wa (wcel C B2) (wn (wcel C A2))) (wpss A2 B2)) $;

--| Subclass inclusion with one element of the superclass missing is proper subclass inclusion. Deduction form of ~ ssnelpss . (Contributed by David Moews, 1-May-2017.)
theorem ssnelpssd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wcel C B2) $ >
  $ wi ph (wn (wcel C A2)) $ >
  $ wi ph (wpss A2 B2) $;

--| Intersection, subclass, and difference relationship. In classical logic the converse would also hold. (Contributed by Jim Kingdon, 3-Aug-2018.)
theorem inssdif0im (A2 B2 C: class):
  $ wi (wss (cin A2 B2) C) (wceq (cin A2 (cdif B2 C)) c0) $;

--| The difference between a class and itself is the empty set. Proposition 5.15 of [TakeutiZaring] p. 20. Also Theorem 32 of [Suppes] p. 28. (Contributed by NM, 22-Apr-2004.)
theorem difid (A2: class):
  $ wceq (cdif A2 A2) c0 $;

--| The difference between a class and itself is the empty set. Proposition 5.15 of [TakeutiZaring] p. 20. Also Theorem 32 of [Suppes] p. 28. Alternate proof of ~ difid . (Contributed by David Abernethy, 17-Jun-2012.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem difidALT (A2: class):
  $ wceq (cdif A2 A2) c0 $;

--| The difference between a class and the empty set. Part of Exercise 4.4 of [Stoll] p. 16. (Contributed by NM, 17-Aug-2004.)
theorem dif0 (A2: class):
  $ wceq (cdif A2 c0) A2 $;

--| The difference between the empty set and a class. Part of Exercise 4.4 of [Stoll] p. 16. (Contributed by NM, 17-Aug-2004.)
theorem _0dif (A2: class):
  $ wceq (cdif c0 A2) c0 $;

--| A class and its relative complement are disjoint. Theorem 38 of [Suppes] p. 29. (Contributed by NM, 24-Mar-1998.)
theorem disjdif (A2 B2: class):
  $ wceq (cin A2 (cdif B2 A2)) c0 $;

--| The difference of a class from its intersection is empty. Theorem 37 of [Suppes] p. 29. (Contributed by NM, 17-Aug-2004.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem difin0 (A2 B2: class):
  $ wceq (cdif (cin A2 B2) B2) c0 $;

--| Absorption of difference by union. In classical logic, as Theorem 35 of [Suppes] p. 29, this would be equality rather than subset. (Contributed by Jim Kingdon, 4-Aug-2018.)
theorem undif1ss (A2 B2: class):
  $ wss (cun (cdif A2 B2) B2) (cun A2 B2) $;

--| Absorption of difference by union. In classical logic, as in Part of proof of Corollary 6K of [Enderton] p. 144, this would be equality rather than subset. (Contributed by Jim Kingdon, 4-Aug-2018.)
theorem undif2ss (A2 B2: class):
  $ wss (cun A2 (cdif B2 A2)) (cun A2 B2) $;

--| Absorption of difference by union. (Contributed by NM, 18-Aug-2013.)
theorem undifabs (A2 B2: class):
  $ wceq (cun A2 (cdif A2 B2)) A2 $;

--| The intersection and class difference of a class with another class are contained in the original class. In classical logic we'd be able to make a stronger statement: that everything in the original class is in the intersection or the difference (that is, this theorem would be equality rather than subset). (Contributed by Jim Kingdon, 4-Aug-2018.)
theorem inundifss (A2 B2: class):
  $ wss (cun (cin A2 B2) (cdif A2 B2)) A2 $;

--| Absorption of union by difference. Theorem 36 of [Suppes] p. 29. (Contributed by NM, 19-May-1998.)
theorem difun2 (A2 B2: class):
  $ wceq (cdif (cun A2 B2) B2) (cdif A2 B2) $;

--| Union of complementary parts into whole. (Contributed by Jim Kingdon, 4-Aug-2018.)
theorem undifss (A2 B2: class):
  $ wb (wss A2 B2) (wss (cun A2 (cdif B2 A2)) B2) $;

--| A subset of a difference does not intersect the subtrahend. (Contributed by Jeff Hankins, 1-Sep-2013.) (Proof shortened by Mario Carneiro, 24-Aug-2015.)
theorem ssdifin0 (A2 B2 C: class):
  $ wi (wss A2 (cdif B2 C)) (wceq (cin A2 C) c0) $;

--| A class is a subclass of itself subtracted from another iff it is the empty set. (Contributed by Steve Rodriguez, 20-Nov-2015.)
theorem ssdifeq0 (A2 B2: class):
  $ wb (wss A2 (cdif B2 A2)) (wceq A2 c0) $;

--| A consequence of inclusion in the union of two classes. In classical logic this would be a biconditional. (Contributed by Jim Kingdon, 4-Aug-2018.)
theorem ssundifim (A2 B2 C: class):
  $ wi (wss A2 (cun B2 C)) (wss (cdif A2 B2) C) $;

--| Distributive law for class difference. In classical logic, as in Exercise 4.8 of [Stoll] p. 16, this would be equality rather than subset. (Contributed by Jim Kingdon, 4-Aug-2018.)
theorem difdifdirss (A2 B2 C: class):
  $ wss (cdif (cdif A2 B2) C) (cdif (cdif A2 C) (cdif B2 C)) $;

--| Two ways that ` A ` and ` B ` can "partition" ` C ` (when ` A ` and ` B ` don't overlap and ` A ` is a part of ` C ` ). In classical logic, the second implication would be a biconditional. (Contributed by Jim Kingdon, 4-Aug-2018.)
theorem uneqdifeqim (A2 B2 C: class):
  $ wi (wa (wss A2 C) (wceq (cin A2 B2) c0)) (wi (wceq (cun A2 B2) C) (wceq (cdif C A2) B2)) $;

--| Theorem 19.2 of [Margaris] p. 89 with restricted quantifiers (compare ~ 19.2 ). The restricted version is valid only when the domain of quantification is inhabited. (Contributed by Jim Kingdon, 5-Aug-2018.)
theorem r19_2m {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wa (wex x3 (wcel (cv x3) A2)) (wral x3 ph A2)) (wrex x3 ph A2) $;

--| Restricted quantification of wff not containing quantified variable. (Contributed by Jim Kingdon, 19-Dec-2018.)
theorem r19_3rm {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wnf x3 ph $ >
  $ wi (wex y1 (wcel (cv y1) A2)) (wb ph (wral x3 ph A2)) $;

--| Restricted quantification of wff not containing quantified variable. (Contributed by Jim Kingdon, 19-Dec-2018.)
theorem r19_3rm_b {x3: setvar} (ph: wff x3) (A2: class):
  $ wnf x3 ph $ >
  $ wi (wex x3 (wcel (cv x3) A2)) (wb ph (wral x3 ph A2)) $;

--| Restricted quantifier version of Theorem 19.28 of [Margaris] p. 90. It is valid only when the domain of quantification is inhabited. (Contributed by Jim Kingdon, 5-Aug-2018.)
theorem r19_28m {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wnf x3 ph $ >
  $ wi (wex x3 (wcel (cv x3) A2)) (wb (wral x3 (wa ph ps) A2) (wa ph (wral x3 ps A2))) $;

--| Restricted quantification of wff not containing quantified variable. (Contributed by Jim Kingdon, 6-Aug-2018.)
theorem r19_3rmv {x3 y1: setvar} (ph: wff y1) (A2: class):
  $ wi (wex y1 (wcel (cv y1) A2)) (wb ph (wral x3 ph A2)) $;

--| Restricted quantification of wff not containing quantified variable. (Contributed by Jim Kingdon, 5-Aug-2018.)
theorem r19_9rmv {x3 y1: setvar} (ph: wff y1) (A2: class):
  $ wi (wex y1 (wcel (cv y1) A2)) (wb ph (wrex x3 ph A2)) $;

--| Restricted quantification of wff not containing quantified variable. (Contributed by Jim Kingdon, 5-Aug-2018.)
theorem r19_9rmv_b {x3: setvar} (ph: wff) (A2: class):
  $ wi (wex x3 (wcel (cv x3) A2)) (wb ph (wrex x3 ph A2)) $;

--| Restricted quantifier version of Theorem 19.28 of [Margaris] p. 90. It is valid only when the domain of quantification is inhabited. (Contributed by Jim Kingdon, 6-Aug-2018.)
theorem r19_28mv {x3: setvar} (ph: wff) (ps: wff x3) (A2: class):
  $ wi (wex x3 (wcel (cv x3) A2)) (wb (wral x3 (wa ph ps) A2) (wa ph (wral x3 ps A2))) $;

--| Restricted version of Theorem 19.45 of [Margaris] p. 90. (Contributed by NM, 27-May-1998.)
theorem r19_45mv {x3: setvar} (ph: wff) (ps: wff x3) (A2: class):
  $ wi (wex x3 (wcel (cv x3) A2)) (wb (wrex x3 (wo ph ps) A2) (wo ph (wrex x3 ps A2))) $;

--| Restricted quantifier version of Theorem 19.27 of [Margaris] p. 90. It is valid only when the domain of quantification is inhabited. (Contributed by Jim Kingdon, 5-Aug-2018.)
theorem r19_27m {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wnf x3 ps $ >
  $ wi (wex x3 (wcel (cv x3) A2)) (wb (wral x3 (wa ph ps) A2) (wa (wral x3 ph A2) ps)) $;

--| Restricted quantifier version of Theorem 19.27 of [Margaris] p. 90. It is valid only when the domain of quantification is inhabited. (Contributed by Jim Kingdon, 5-Aug-2018.)
theorem r19_27mv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wi (wex x3 (wcel (cv x3) A2)) (wb (wral x3 (wa ph ps) A2) (wa (wral x3 ph A2) ps)) $;

--| Vacuous quantification is always true. (Contributed by NM, 11-Mar-1997.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem rzal {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wceq A2 c0) (wral x3 ph A2) $;

--| Restricted existential quantification implies its restriction is nonempty (it is also inhabited as shown in ~ rexm ). (Contributed by Szymon Jaroszewicz, 3-Apr-2007.)
theorem rexn0 {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wrex x3 ph A2) (wne A2 c0) $;

--| Restricted existential quantification implies its restriction is inhabited. (Contributed by Jim Kingdon, 16-Oct-2018.)
theorem rexm {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wrex x3 ph A2) (wex x3 (wcel (cv x3) A2)) $;

--| Idempotent law for restricted quantifier. (Contributed by NM, 28-Mar-1997.)
theorem ralidm {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wral x3 (wral x3 ph A2) A2) (wral x3 ph A2) $;

--| Vacuous universal quantification is always true. (Contributed by NM, 20-Oct-2005.)
theorem ral0 {x3: setvar} (ph: wff x3):
  $ wral x3 ph c0 $;

--| Generalization rule that eliminates an inhabited class requirement. (Contributed by Jim Kingdon, 5-Aug-2018.)
theorem rgenm {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wa (wex x3 (wcel (cv x3) A2)) (wcel (cv x3) A2)) ph $ >
  $ wral x3 ph A2 $;

--| The quantification of a falsehood is vacuous when true. (Contributed by NM, 26-Nov-2005.)
theorem ralf0 {x3: setvar} (ph: wff x3) (A2: class):
  $ wn ph $ >
  $ wb (wral x3 ph A2) (wceq A2 c0) $;

--| Inhabited classes and restricted quantification. (Contributed by Jim Kingdon, 6-Aug-2018.)
theorem ralm {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wi (wex x3 (wcel (cv x3) A2)) (wral x3 ph A2)) (wral x3 ph A2) $;

--| Special case of ~ raaan where ` A ` is inhabited. (Contributed by Jim Kingdon, 6-Aug-2018.)
theorem raaanlem {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wex x3 (wcel (cv x3) A2)) (wb (wral x3 (wral y1 (wa ph ps) A2) A2) (wa (wral x3 ph A2) (wral y1 ps A2))) $;

--| Rearrange restricted quantifiers. (Contributed by NM, 26-Oct-2010.)
theorem raaan {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wb (wral x3 (wral y1 (wa ph ps) A2) A2) (wa (wral x3 ph A2) (wral y1 ps A2)) $;

--| Rearrange restricted quantifiers. (Contributed by NM, 11-Mar-1997.)
theorem raaanv {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wb (wral x3 (wral y1 (wa ph ps) A2) A2) (wa (wral x3 ph A2) (wral y1 ps A2)) $;

--| Set substitution into the first argument of a subset relation. (Contributed by Rodolfo Medina, 7-Jul-2010.) (Proof shortened by Mario Carneiro, 14-Nov-2016.)
theorem sbss {x3 y1: setvar} (A2: class y1):
  $ wb (wsb x3 y1 (wss (cv x3) A2)) (wss (cv y1) A2) $;

--| Distribute proper substitution through a subclass relation. (Contributed by Alan Sare, 22-Jul-2012.) (Proof shortened by Alexander van der Vekens, 23-Jul-2017.)
theorem sbcssg {x3: setvar} (A2 B2 C V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wss B2 C) A2) (wss (csb x3 A2 B2) (csb x3 A2 C))) $;

--| Extend class notation to include the conditional operator. See ~ df-if for a description. (In older databases this was denoted "ded".)
term cif (ph: wff) (A2 B2: class): class;

--| Define the conditional operator. Read ` if ( ph , A , B ) ` as "if ` ph ` then ` A ` else ` B ` ." See ~ iftrue and ~ iffalse for its values. In mathematical literature, this operator is rarely defined formally but is implicit in informal definitions such as "let f(x)=0 if x=0 and 1/x otherwise." In the absence of excluded middle, this will tend to be useful where ` ph ` is decidable (in the sense of ~df-dc ). (Contributed by NM, 15-May-1999.)
axiom df_if {x3: setvar} (ph: wff) (A2 B2: class):
  $ wceq (cif ph A2 B2) (cab x3 (wo (wa (wcel (cv x3) A2) ph) (wa (wcel (cv x3) B2) (wn ph)))) $;

--| An alternate definition of the conditional operator ~ df-if as a simple class abstraction. (Contributed by Mario Carneiro, 8-Sep-2013.)
theorem dfif6 {x3: setvar} (ph: wff) (A2 B2: class):
  $ wceq (cif ph A2 B2) (cun (crab x3 ph A2) (crab x3 (wn ph) B2)) $;

--| Equality theorem for conditional operator. (Contributed by NM, 1-Sep-2004.) (Revised by Mario Carneiro, 8-Sep-2013.)
theorem ifeq1 (ph: wff) (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cif ph A2 C) (cif ph B2 C)) $;

--| Equality theorem for conditional operator. (Contributed by NM, 1-Sep-2004.) (Revised by Mario Carneiro, 8-Sep-2013.)
theorem ifeq2 (ph: wff) (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cif ph C A2) (cif ph C B2)) $;

--| Value of the conditional operator when its first argument is true. (Contributed by NM, 15-May-1999.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem iftrue (ph: wff) (A2 B2: class):
  $ wi ph (wceq (cif ph A2 B2) A2) $;

--| Inference associated with ~ iftrue . (Contributed by BJ, 7-Oct-2018.)
theorem iftruei (ph: wff) (A2 B2: class):
  $ ph $ >
  $ wceq (cif ph A2 B2) A2 $;

--| Value of the conditional operator when its first argument is true. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem iftrued (ph ch: wff) (A2 B2: class):
  $ wi ph ch $ >
  $ wi ph (wceq (cif ch A2 B2) A2) $;

--| Value of the conditional operator when its first argument is false. (Contributed by NM, 14-Aug-1999.)
theorem iffalse (ph: wff) (A2 B2: class):
  $ wi (wn ph) (wceq (cif ph A2 B2) B2) $;

--| Inference associated with ~ iffalse . (Contributed by BJ, 7-Oct-2018.)
theorem iffalsei (ph: wff) (A2 B2: class):
  $ wn ph $ >
  $ wceq (cif ph A2 B2) B2 $;

--| Value of the conditional operator when its first argument is false. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem iffalsed (ph ch: wff) (A2 B2: class):
  $ wi ph (wn ch) $ >
  $ wi ph (wceq (cif ch A2 B2) B2) $;

--| When values are unequal, but an "if" condition checks if they are equal, then the "false" branch results. This is a simple utility to provide a slight shortening and simplification of proofs vs. applying ~ iffalse directly in this case. (Contributed by David A. Wheeler, 15-May-2015.)
theorem ifnefalse (A2 B2 C D: class):
  $ wi (wne A2 B2) (wceq (cif (wceq A2 B2) C D) D) $;

--| Alternate definition of the conditional operator ~ df-if . Note that ` ph ` is independent of ` x ` i.e. a constant true or false. (Contributed by NM, 25-Aug-2013.) (Revised by Mario Carneiro, 8-Sep-2013.)
theorem dfif3 {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wceq C (cab x3 ph) $ >
  $ wceq (cif ph A2 B2) (cun (cin A2 C) (cin B2 (cdif cvv C))) $;

--| Equality theorem for conditional operators. (Contributed by NM, 1-Sep-2004.)
theorem ifeq12 (ph: wff) (A2 B2 C D: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wceq (cif ph A2 C) (cif ph B2 D)) $;

--| Equality deduction for conditional operator. (Contributed by NM, 16-Feb-2005.)
theorem ifeq1d (ph ps: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cif ps A2 C) (cif ps B2 C)) $;

--| Equality deduction for conditional operator. (Contributed by NM, 16-Feb-2005.)
theorem ifeq2d (ph ps: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cif ps C A2) (cif ps C B2)) $;

--| Equality deduction for conditional operator. (Contributed by NM, 24-Mar-2015.)
theorem ifeq12d (ph ps: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cif ps A2 C) (cif ps B2 D)) $;

--| Equivalence theorem for conditional operators. (Contributed by Raph Levien, 15-Jan-2004.)
theorem ifbi (ph ps: wff) (A2 B2: class):
  $ wi (wb ph ps) (wceq (cif ph A2 B2) (cif ps A2 B2)) $;

--| Equivalence deduction for conditional operators. (Contributed by NM, 18-Apr-2005.)
theorem ifbid (ph ps ch: wff) (A2 B2: class):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (cif ps A2 B2) (cif ch A2 B2)) $;

--| Equivalence/equality deduction for conditional operators. (Contributed by JJ, 25-Sep-2018.)
theorem ifbieq1d (ph ps ch: wff) (A2 B2 C: class):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cif ps A2 C) (cif ch B2 C)) $;

--| Equivalence/equality inference for conditional operators. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem ifbieq2i (ph ps: wff) (A2 B2 C: class):
  $ wb ph ps $ >
  $ wceq A2 B2 $ >
  $ wceq (cif ph C A2) (cif ps C B2) $;

--| Equivalence/equality deduction for conditional operators. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem ifbieq2d (ph ps ch: wff) (A2 B2 C: class):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cif ps C A2) (cif ch C B2)) $;

--| Equivalence deduction for conditional operators. (Contributed by NM, 18-Mar-2013.)
theorem ifbieq12i (ph ps: wff) (A2 B2 C D: class):
  $ wb ph ps $ >
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wceq (cif ph A2 B2) (cif ps C D) $;

--| Equivalence deduction for conditional operators. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem ifbieq12d (ph ps ch: wff) (A2 B2 C D: class):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wceq (cif ps A2 B2) (cif ch C D)) $;

--| Deduction version of ~ nfif . (Contributed by NM, 15-Feb-2013.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem nfifd {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnfc x3 (cif ps A2 B2)) $;

--| Bound-variable hypothesis builder for a conditional operator. (Contributed by NM, 16-Feb-2005.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem nfif {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cif ph A2 B2) $;

--| A wff ` th ` containing a conditional operator is true when both of its cases are true. (Contributed by Jim Kingdon, 8-Aug-2021.)
theorem ifbothdc (ph ps ch th: wff) (A2 B2: class):
  $ wi (wceq A2 (cif ph A2 B2)) (wb ps th) $ >
  $ wi (wceq B2 (cif ph A2 B2)) (wb ch th) $ >
  $ wi (w3a ps ch (wdc ph)) th $;

--| Membership (closure) of a conditional operator, deduction form. (Contributed by Jim Kingdon, 8-Aug-2021.)
theorem ifcldcd (ph ps: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel B2 C) $ >
  $ wi ph (wdc ps) $ >
  $ wi ph (wcel (cif ps A2 B2) C) $;

--| Extend class notation to include power class. (The tilde in the Metamath token is meant to suggest the calligraphic font of the P.)
term cpw (A2: class): class;

--| Soundness justification theorem for ~ df-pw . (Contributed by Rodolfo Medina, 28-Apr-2010.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem pwjust {x3 y1: setvar} (A2: class):
  $ wceq (cab x3 (wss (cv x3) A2)) (cab y1 (wss (cv y1) A2)) $;

--| Define power class. Definition 5.10 of [TakeutiZaring] p. 17, but we also let it apply to proper classes, i.e. those that are not members of ` _V ` . When applied to a set, this produces its power set. A power set of S is the set of all subsets of S, including the empty set and S itself. For example, if ` A ` is { 3 , 5 , 7 }, then ` ~P A ` is { (/) , { 3 } , { 5 } , { 7 } , { 3 , 5 } , { 3 , 7 } , { 5 , 7 } , { 3 , 5 , 7 } }. We will later introduce the Axiom of Power Sets. Still later we will prove that the size of the power set of a finite set is 2 raised to the power of the size of the set. (Contributed by NM, 5-Aug-1993.)
axiom df_pw {x3: setvar} (A2: class):
  $ wceq (cpw A2) (cab x3 (wss (cv x3) A2)) $;

--| Equality theorem for power class. (Contributed by NM, 5-Aug-1993.)
theorem pweq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (cpw A2) (cpw B2)) $;

--| Equality inference for power class. (Contributed by NM, 27-Nov-2013.)
theorem pweqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq (cpw A2) (cpw B2) $;

--| Equality deduction for power class. (Contributed by NM, 27-Nov-2013.)
theorem pweqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cpw A2) (cpw B2)) $;

--| Membership in a power class. Theorem 86 of [Suppes] p. 47. (Contributed by NM, 31-Dec-1993.)
theorem elpw (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cpw B2)) (wss A2 B2) $;

--| Setvar variable membership in a power class (common case). See ~ elpw . (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem selpw {x3: setvar} (A2: class):
  $ wb (wcel (cv x3) (cpw A2)) (wss (cv x3) A2) $;

--| Membership in a power class. Theorem 86 of [Suppes] p. 47. (Contributed by NM, 6-Aug-2000.)
theorem elpwg (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (cpw B2)) (wss A2 B2)) $;

--| Subset relation implied by membership in a power class. (Contributed by NM, 17-Feb-2007.)
theorem elpwi (A2 B2: class):
  $ wi (wcel A2 (cpw B2)) (wss A2 B2) $;

--| An element of a power class is a subclass. Deduction form of ~ elpwi . (Contributed by David Moews, 1-May-2017.)
theorem elpwid (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (cpw B2)) $ >
  $ wi ph (wss A2 B2) $;

--| If ` A ` belongs to a part of ` C ` then ` A ` belongs to ` C ` . (Contributed by FL, 3-Aug-2009.)
theorem elelpwi (A2 B2 C: class):
  $ wi (wa (wcel A2 B2) (wcel B2 (cpw C))) (wcel A2 C) $;

--| Bound-variable hypothesis builder for power class. (Contributed by NM, 28-Oct-2003.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem nfpw {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (cpw A2) $;

--| Membership of the original in a power set. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem pwidg (A2 V: class):
  $ wi (wcel A2 V) (wcel A2 (cpw A2)) $;

--| A set is a member of its power class. Theorem 87 of [Suppes] p. 47. (Contributed by NM, 5-Aug-1993.)
theorem pwid (A2: class):
  $ wcel A2 cvv $ >
  $ wcel A2 (cpw A2) $;

--| Subclass relationship for power class. (Contributed by NM, 21-Jun-2009.)
theorem pwss {x3: setvar} (A2 B2: class):
  $ wb (wss (cpw A2) B2) (wal x3 (wi (wss (cv x3) A2) (wcel (cv x3) B2))) $;

--| Extend class notation to include singleton.
term csn (A2: class): class;

--| Extend class notation to include unordered pair.
term cpr (A2 B2: class): class;

--| Extend class notation to include unordered triplet.
term ctp (A2 B2 C: class): class;

--| Extend class notation to include ordered pair.
term cop (A2 B2: class): class;

--| Extend class notation to include ordered triple.
term cotp (A2 B2 C: class): class;

--| Soundness justification theorem for ~ df-sn . (Contributed by Rodolfo Medina, 28-Apr-2010.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem snjust {x3 y1: setvar} (A2: class):
  $ wceq (cab x3 (wceq (cv x3) A2)) (cab y1 (wceq (cv y1) A2)) $;

--| Define the singleton of a class. Definition 7.1 of [Quine] p. 48. For convenience, it is well-defined for proper classes, i.e., those that are not elements of ` _V ` , although it is not very meaningful in this case. For an alternate definition see ~ dfsn2 . (Contributed by NM, 5-Aug-1993.)
axiom df_sn {x3: setvar} (A2: class):
  $ wceq (csn A2) (cab x3 (wceq (cv x3) A2)) $;

--| Define unordered pair of classes. Definition 7.1 of [Quine] p. 48. They are unordered, so ` { A , B } = { B , A } ` as proven by ~ prcom . For a more traditional definition, but requiring a dummy variable, see ~ dfpr2 . (Contributed by NM, 5-Aug-1993.)
axiom df_pr (A2 B2: class):
  $ wceq (cpr A2 B2) (cun (csn A2) (csn B2)) $;

--| Define unordered triple of classes. Definition of [Enderton] p. 19. (Contributed by NM, 9-Apr-1994.)
axiom df_tp (A2 B2 C: class):
  $ wceq (ctp A2 B2 C) (cun (cpr A2 B2) (csn C)) $;

--| Definition of an ordered pair, equivalent to Kuratowski's definition ` { { A } , { A , B } } ` when the arguments are sets. Since the behavior of Kuratowski definition is not very useful for proper classes, we define it to be empty in this case (see ~ opprc1 and ~ opprc2 ). For Kuratowski's actual definition when the arguments are sets, see ~ dfop . Definition 9.1 of [Quine] p. 58 defines an ordered pair unconditionally as ` <. A , B >. = { { A } , { A , B } } ` , which has different behavior from our ~ df-op when the arguments are proper classes. Ordinarily this difference is not important, since neither definition is meaningful in that case. Our ~ df-op was chosen because it often makes proofs shorter by eliminating unnecessary sethood hypotheses. There are other ways to define ordered pairs. The basic requirement is that two ordered pairs are equal iff their respective members are equal. In 1914 Norbert Wiener gave the first successful definition ` <. A , B >. ` _2 ` = { { { A } , (/) } , { { B } } } ` . This was simplified by Kazimierz Kuratowski in 1921 to our present definition. An even simpler definition is ` <. A , B >. ` _3 ` = { A , { A , B } } ` , but it requires the Axiom of Regularity for its justification and is not commonly used. Finally, an ordered pair of real numbers can be represented by a complex number. (Contributed by NM, 28-May-1995.) (Revised by Mario Carneiro, 26-Apr-2015.)
axiom df_op {x3: setvar} (A2 B2: class):
  $ wceq (cop A2 B2) (cab x3 (w3a (wcel A2 cvv) (wcel B2 cvv) (wcel (cv x3) (cpr (csn A2) (cpr A2 B2))))) $;

--| Define ordered triple of classes. Definition of ordered triple in [Stoll] p. 25. (Contributed by NM, 3-Apr-2015.)
axiom df_ot (A2 B2 C: class):
  $ wceq (cotp A2 B2 C) (cop (cop A2 B2) C) $;

--| Equality theorem for singletons. Part of Exercise 4 of [TakeutiZaring] p. 15. (Contributed by NM, 5-Aug-1993.)
theorem sneq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (csn A2) (csn B2)) $;

--| Equality inference for singletons. (Contributed by NM, 22-Jan-2004.)
theorem sneqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq (csn A2) (csn B2) $;

--| Equality deduction for singletons. (Contributed by NM, 22-Jan-2004.)
theorem sneqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (csn A2) (csn B2)) $;

--| Alternate definition of singleton. Definition 5.1 of [TakeutiZaring] p. 15. (Contributed by NM, 24-Apr-1994.)
theorem dfsn2 (A2: class):
  $ wceq (csn A2) (cpr A2 A2) $;

--| There is exactly one element in a singleton. Exercise 2 of [TakeutiZaring] p. 15 (generalized). (Contributed by NM, 13-Sep-1995.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem elsng (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (csn B2)) (wceq A2 B2)) $;

--| There is exactly one element in a singleton. Exercise 2 of [TakeutiZaring] p. 15. (Contributed by NM, 13-Sep-1995.)
theorem elsn (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (csn B2)) (wceq A2 B2) $;

--| There is only one element in a singleton. Exercise 2 of [TakeutiZaring] p. 15. (Contributed by NM, 21-Jun-1993.)
theorem velsn {x3: setvar} (A2: class x3):
  $ wb (wcel (cv x3) (csn A2)) (wceq (cv x3) A2) $;

--| There is only one element in a singleton. (Contributed by NM, 5-Jun-1994.)
theorem elsni (A2 B2: class):
  $ wi (wcel A2 (csn B2)) (wceq A2 B2) $;

--| Alternate definition of unordered pair. Definition 5.1 of [TakeutiZaring] p. 15. (Contributed by NM, 24-Apr-1994.)
theorem dfpr2 {x3: setvar} (A2 B2: class):
  $ wceq (cpr A2 B2) (cab x3 (wo (wceq (cv x3) A2) (wceq (cv x3) B2))) $;

--| A member of an unordered pair of classes is one or the other of them. Exercise 1 of [TakeutiZaring] p. 15, generalized. (Contributed by NM, 13-Sep-1995.)
theorem elprg (A2 B2 C V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (cpr B2 C)) (wo (wceq A2 B2) (wceq A2 C))) $;

--| A member of an unordered pair of classes is one or the other of them. Exercise 1 of [TakeutiZaring] p. 15. (Contributed by NM, 13-Sep-1995.)
theorem elpr (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cpr B2 C)) (wo (wceq A2 B2) (wceq A2 C)) $;

--| A member of an unordered pair of classes is one or the other of them. Exercise 1 of [TakeutiZaring] p. 15. (Contributed by NM, 14-Oct-2005.)
theorem elpr2 (A2 B2 C: class):
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wb (wcel A2 (cpr B2 C)) (wo (wceq A2 B2) (wceq A2 C)) $;

--| If a class is an element of a pair, then it is one of the two paired elements. (Contributed by Scott Fenton, 1-Apr-2011.)
theorem elpri (A2 B2 C: class):
  $ wi (wcel A2 (cpr B2 C)) (wo (wceq A2 B2) (wceq A2 C)) $;

--| If an element doesn't match the items in an unordered pair, it is not in the unordered pair. (Contributed by David A. Wheeler, 10-May-2015.)
theorem nelpri (A2 B2 C: class):
  $ wne A2 B2 $ >
  $ wne A2 C $ >
  $ wn (wcel A2 (cpr B2 C)) $;

--| A set is a member of its singleton. Part of Theorem 7.6 of [Quine] p. 49. (Contributed by NM, 28-Oct-2003.)
theorem snidg (A2 V: class):
  $ wi (wcel A2 V) (wcel A2 (csn A2)) $;

--| A class is a set iff it is a member of its singleton. (Contributed by NM, 5-Apr-2004.)
theorem snidb (A2: class):
  $ wb (wcel A2 cvv) (wcel A2 (csn A2)) $;

--| A set is a member of its singleton. Part of Theorem 7.6 of [Quine] p. 49. (Contributed by NM, 31-Dec-1993.)
theorem snid (A2: class):
  $ wcel A2 cvv $ >
  $ wcel A2 (csn A2) $;

--| A setvar variable is a member of its singleton (common case). (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem vsnid {x3: setvar}:
  $ wcel (cv x3) (csn (cv x3)) $;

--| There is only one element in a singleton. Exercise 2 of [TakeutiZaring] p. 15. This variation requires only that ` B ` , rather than ` A ` , be a set. (Contributed by NM, 28-Oct-2003.)
theorem elsn2g (A2 B2 V: class):
  $ wi (wcel B2 V) (wb (wcel A2 (csn B2)) (wceq A2 B2)) $;

--| There is only one element in a singleton. Exercise 2 of [TakeutiZaring] p. 15. This variation requires only that ` B ` , rather than ` A ` , be a set. (Contributed by NM, 12-Jun-1994.)
theorem elsn2 (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wb (wcel A2 (csn B2)) (wceq A2 B2) $;

--| A singleton has at most one element. This works whether ` A ` is a proper class or not, and in that sense can be seen as encompassing both ~ snmg and ~ snprc . (Contributed by Jim Kingdon, 30-Aug-2018.)
theorem mosn {x3: setvar} (A2: class):
  $ wmo x3 (wcel (cv x3) (csn A2)) $;

--| Substitution expressed in terms of quantification over a singleton. (Contributed by NM, 14-Dec-2005.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem ralsnsg {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wral x3 ph (csn A2)) (wsbc x3 ph A2)) $;

--| Substitution expressed in terms of quantification over a singleton. (Contributed by Mario Carneiro, 23-Apr-2015.)
theorem ralsns {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wral x3 ph (csn A2)) (wsbc x3 ph A2)) $;

--| Restricted existential quantification over a singleton. (Contributed by Mario Carneiro, 23-Apr-2015.) (Revised by NM, 22-Aug-2018.)
theorem rexsns {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wrex x3 ph (csn A2)) (wsbc x3 ph A2) $;

--| Restricted existential quantification over a singleton. (Contributed by Mario Carneiro, 23-Apr-2015.) Obsolete as of 22-Aug-2018. Use ~ rexsns instead. (New usage is discouraged.) (Proof modification is discouraged.)
theorem rexsnsOLD {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wrex x3 ph (csn A2)) (wsbc x3 ph A2)) $;

--| Substitution expressed in terms of quantification over a singleton. (Contributed by NM, 14-Dec-2005.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem ralsng {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wral x3 ph (csn A2)) ps) $;

--| Restricted existential quantification over a singleton. (Contributed by NM, 29-Jan-2012.)
theorem rexsng {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wrex x3 ph (csn A2)) ps) $;

--| There is a set being the element of a singleton if and only if there is an element of the singleton. (Contributed by Alexander van der Vekens, 1-Jan-2018.)
theorem exsnrex {x3: setvar} (M: class x3):
  $ wb (wex x3 (wceq M (csn (cv x3)))) (wrex x3 (wceq M (csn (cv x3))) M) $;

--| Convert a quantification over a singleton to a substitution. (Contributed by NM, 27-Apr-2009.)
theorem ralsn {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wral x3 ph (csn A2)) ps $;

--| Restricted existential quantification over a singleton. (Contributed by Jeff Madsen, 5-Jan-2011.)
theorem rexsn {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wrex x3 ph (csn A2)) ps $;

--| Members of an unordered triple of classes. (Contributed by FL, 2-Feb-2014.) (Proof shortened by Mario Carneiro, 11-Feb-2015.)
theorem eltpg (A2 B2 C D V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (ctp B2 C D)) (w3o (wceq A2 B2) (wceq A2 C) (wceq A2 D))) $;

--| A member of an unordered triple of classes is one of them. (Contributed by Mario Carneiro, 11-Feb-2015.)
theorem eltpi (A2 B2 C D: class):
  $ wi (wcel A2 (ctp B2 C D)) (w3o (wceq A2 B2) (wceq A2 C) (wceq A2 D)) $;

--| A member of an unordered triple of classes is one of them. Special case of Exercise 1 of [TakeutiZaring] p. 17. (Contributed by NM, 8-Apr-1994.) (Revised by Mario Carneiro, 11-Feb-2015.)
theorem eltp (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (ctp B2 C D)) (w3o (wceq A2 B2) (wceq A2 C) (wceq A2 D)) $;

--| Alternate definition of unordered triple of classes. Special case of Definition 5.3 of [TakeutiZaring] p. 16. (Contributed by NM, 8-Apr-1994.)
theorem dftp2 {x3: setvar} (A2 B2 C: class):
  $ wceq (ctp A2 B2 C) (cab x3 (w3o (wceq (cv x3) A2) (wceq (cv x3) B2) (wceq (cv x3) C))) $;

--| Bound-variable hypothesis builder for unordered pairs. (Contributed by NM, 14-Nov-1995.)
theorem nfpr {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cpr A2 B2) $;

--| Convert a quantification over a pair to a conjunction. (Contributed by NM, 17-Sep-2011.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem ralprg {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2: class) (V W: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wral x3 ph (cpr A2 B2)) (wa ps ch)) $;

--| Convert a quantification over a pair to a disjunction. (Contributed by NM, 17-Sep-2011.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem rexprg {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2: class) (V W: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wrex x3 ph (cpr A2 B2)) (wo ps ch)) $;

--| Convert a quantification over a triple to a conjunction. (Contributed by NM, 17-Sep-2011.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem raltpg {x3: setvar} (ph: wff x3) (ps ch th: wff) (A2 B2 C: class) (V W X: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wceq (cv x3) C) (wb ph th) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wb (wral x3 ph (ctp A2 B2 C)) (w3a ps ch th)) $;

--| Convert a quantification over a triple to a disjunction. (Contributed by Mario Carneiro, 23-Apr-2015.)
theorem rextpg {x3: setvar} (ph: wff x3) (ps ch th: wff) (A2 B2 C: class) (V W X: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wceq (cv x3) C) (wb ph th) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wb (wrex x3 ph (ctp A2 B2 C)) (w3o ps ch th)) $;

--| Convert a quantification over a pair to a conjunction. (Contributed by NM, 3-Jun-2007.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem ralpr {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wb (wral x3 ph (cpr A2 B2)) (wa ps ch) $;

--| Convert an existential quantification over a pair to a disjunction. (Contributed by NM, 3-Jun-2007.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem rexpr {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wb (wrex x3 ph (cpr A2 B2)) (wo ps ch) $;

--| Convert a quantification over a triple to a conjunction. (Contributed by NM, 13-Sep-2011.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem raltp {x3: setvar} (ph: wff x3) (ps ch th: wff) (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wceq (cv x3) C) (wb ph th) $ >
  $ wb (wral x3 ph (ctp A2 B2 C)) (w3a ps ch th) $;

--| Convert a quantification over a triple to a disjunction. (Contributed by Mario Carneiro, 23-Apr-2015.)
theorem rextp {x3: setvar} (ph: wff x3) (ps ch th: wff) (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wceq (cv x3) C) (wb ph th) $ >
  $ wb (wrex x3 ph (ctp A2 B2 C)) (w3o ps ch th) $;

--| Substitution expressed in terms of quantification over a singleton. (Contributed by NM, 14-Dec-2005.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem sbcsng {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) (wral x3 ph (csn A2))) $;

--| Bound-variable hypothesis builder for singletons. (Contributed by NM, 14-Nov-1995.)
theorem nfsn {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (csn A2) $;

--| Distribute proper substitution through the singleton of a class. (Contributed by Alan Sare, 10-Nov-2012.)
theorem csbsng {x3: setvar} (A2 B2 V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (csn B2)) (csn (csb x3 A2 B2))) $;

--| Intersection with the singleton of a non-member is disjoint. (Contributed by NM, 22-May-1998.) (Proof shortened by Andrew Salmon, 29-Jun-2011.) (Proof shortened by Wolf Lammen, 30-Sep-2014.)
theorem disjsn (A2 B2: class):
  $ wb (wceq (cin A2 (csn B2)) c0) (wn (wcel B2 A2)) $;

--| Intersection of distinct singletons is disjoint. (Contributed by NM, 25-May-1998.)
theorem disjsn2 (A2 B2: class):
  $ wi (wne A2 B2) (wceq (cin (csn A2) (csn B2)) c0) $;

--| The intersection of distinct unordered pairs is disjoint. (Contributed by Alexander van der Vekens, 11-Nov-2017.)
theorem disjpr2 (A2 B2 C D: class):
  $ wi (wa (wa (wne A2 C) (wne B2 C)) (wa (wne A2 D) (wne B2 D))) (wceq (cin (cpr A2 B2) (cpr C D)) c0) $;

--| The singleton of a proper class (one that doesn't exist) is the empty set. Theorem 7.2 of [Quine] p. 48. (Contributed by NM, 5-Aug-1993.)
theorem snprc (A2: class):
  $ wb (wn (wcel A2 cvv)) (wceq (csn A2) c0) $;

--| Special case of ~ r19.12 where its converse holds. (Contributed by NM, 19-May-2008.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem r19_12sn {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (B2: class y1):
  $ wcel A2 cvv $ >
  $ wb (wrex x3 (wral y1 ph B2) (csn A2)) (wral y1 (wrex x3 ph (csn A2)) B2) $;

--| Condition where a restricted class abstraction is a singleton. (Contributed by NM, 28-May-2006.)
theorem rabsn {x3: setvar} (A2 B2: class):
  $ wi (wcel B2 A2) (wceq (crab x3 (wceq (cv x3) B2) A2) (csn B2)) $;

--| A class abstraction over a decidable proposition restricted to a singleton is either the empty set or the singleton itself. (Contributed by Jim Kingdon, 8-Aug-2018.)
theorem rabrsndc {x3: setvar} (ph: wff x3) (A2: class) (M: class x3):
  $ wcel A2 cvv $ >
  $ wdc ph $ >
  $ wi (wceq M (crab x3 ph (csn A2))) (wo (wceq M c0) (wceq M (csn A2))) $;

--| Another way to express existential uniqueness of a wff: its class abstraction is a singleton. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem euabsn2 {x3 y1: setvar} (ph: wff x3):
  $ wb (weu x3 ph) (wex y1 (wceq (cab x3 ph) (csn (cv y1)))) $;

--| Another way to express existential uniqueness of a wff: its class abstraction is a singleton. (Contributed by NM, 22-Feb-2004.)
theorem euabsn {x3: setvar} (ph: wff x3):
  $ wb (weu x3 ph) (wex x3 (wceq (cab x3 ph) (csn (cv x3)))) $;

--| A way to express restricted existential uniqueness of a wff: its restricted class abstraction is a singleton. (Contributed by NM, 30-May-2006.) (Proof shortened by Mario Carneiro, 14-Nov-2016.)
theorem reusn {x3 y1: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wreu x3 ph A2) (wex y1 (wceq (crab x3 ph A2) (csn (cv y1)))) $;

--| Restricted existential uniqueness determined by a singleton. (Contributed by NM, 29-May-2006.)
theorem absneu {x3: setvar} (ph: wff x3) (A2 V: class x3):
  $ wi (wa (wcel A2 V) (wceq (cab x3 ph) (csn A2))) (weu x3 ph) $;

--| Restricted existential uniqueness determined by a singleton. (Contributed by NM, 29-May-2006.) (Revised by Mario Carneiro, 23-Dec-2016.)
theorem rabsneu {x3: setvar} (ph: wff x3) (A2 B2 V: class x3):
  $ wi (wa (wcel A2 V) (wceq (crab x3 ph B2) (csn A2))) (wreu x3 ph B2) $;

--| Two ways to express " ` A ` is a singleton." (Contributed by NM, 30-Oct-2010.)
theorem eusn {x3: setvar} (A2: class):
  $ wb (weu x3 (wcel (cv x3) A2)) (wex x3 (wceq A2 (csn (cv x3)))) $;

--| Truth implied by equality of a restricted class abstraction and a singleton. (Contributed by NM, 29-May-2006.) (Proof shortened by Mario Carneiro, 23-Dec-2016.)
theorem rabsnt {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (wceq (crab x3 ph A2) (csn B2)) ps $;

--| Commutative law for unordered pairs. (Contributed by NM, 5-Aug-1993.)
theorem prcom (A2 B2: class):
  $ wceq (cpr A2 B2) (cpr B2 A2) $;

--| Equality theorem for unordered pairs. (Contributed by NM, 29-Mar-1998.)
theorem preq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cpr A2 C) (cpr B2 C)) $;

--| Equality theorem for unordered pairs. (Contributed by NM, 5-Aug-1993.)
theorem preq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cpr C A2) (cpr C B2)) $;

--| Equality theorem for unordered pairs. (Contributed by NM, 19-Oct-2012.)
theorem preq12 (A2 B2 C D: class):
  $ wi (wa (wceq A2 C) (wceq B2 D)) (wceq (cpr A2 B2) (cpr C D)) $;

--| Equality inference for unordered pairs. (Contributed by NM, 19-Oct-2012.)
theorem preq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cpr A2 C) (cpr B2 C) $;

--| Equality inference for unordered pairs. (Contributed by NM, 19-Oct-2012.)
theorem preq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cpr C A2) (cpr C B2) $;

--| Equality inference for unordered pairs. (Contributed by NM, 19-Oct-2012.)
theorem preq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (cpr A2 C) (cpr B2 D) $;

--| Equality deduction for unordered pairs. (Contributed by NM, 19-Oct-2012.)
theorem preq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cpr A2 C) (cpr B2 C)) $;

--| Equality deduction for unordered pairs. (Contributed by NM, 19-Oct-2012.)
theorem preq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cpr C A2) (cpr C B2)) $;

--| Equality deduction for unordered pairs. (Contributed by NM, 19-Oct-2012.)
theorem preq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cpr A2 C) (cpr B2 D)) $;

--| Equality theorem for unordered triples. (Contributed by NM, 13-Sep-2011.)
theorem tpeq1 (A2 B2 C D: class):
  $ wi (wceq A2 B2) (wceq (ctp A2 C D) (ctp B2 C D)) $;

--| Equality theorem for unordered triples. (Contributed by NM, 13-Sep-2011.)
theorem tpeq2 (A2 B2 C D: class):
  $ wi (wceq A2 B2) (wceq (ctp C A2 D) (ctp C B2 D)) $;

--| Equality theorem for unordered triples. (Contributed by NM, 13-Sep-2011.)
theorem tpeq3 (A2 B2 C D: class):
  $ wi (wceq A2 B2) (wceq (ctp C D A2) (ctp C D B2)) $;

--| Equality theorem for unordered triples. (Contributed by NM, 22-Jun-2014.)
theorem tpeq1d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (ctp A2 C D) (ctp B2 C D)) $;

--| Equality theorem for unordered triples. (Contributed by NM, 22-Jun-2014.)
theorem tpeq2d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (ctp C A2 D) (ctp C B2 D)) $;

--| Equality theorem for unordered triples. (Contributed by NM, 22-Jun-2014.)
theorem tpeq3d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (ctp C D A2) (ctp C D B2)) $;

--| Equality theorem for unordered triples. (Contributed by NM, 22-Jun-2014.)
theorem tpeq123d (ph: wff) (A2 B2 C D E F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq E F) $ >
  $ wi ph (wceq (ctp A2 C E) (ctp B2 D F)) $;

--| Rotation of the elements of an unordered triple. (Contributed by Alan Sare, 24-Oct-2011.)
theorem tprot (A2 B2 C: class):
  $ wceq (ctp A2 B2 C) (ctp B2 C A2) $;

--| Swap 1st and 2nd members of an undordered triple. (Contributed by NM, 22-May-2015.)
theorem tpcoma (A2 B2 C: class):
  $ wceq (ctp A2 B2 C) (ctp B2 A2 C) $;

--| Swap 2nd and 3rd members of an undordered triple. (Contributed by NM, 22-May-2015.)
theorem tpcomb (A2 B2 C: class):
  $ wceq (ctp A2 B2 C) (ctp A2 C B2) $;

--| Split off the first element of an unordered triple. (Contributed by Mario Carneiro, 5-Jan-2016.)
theorem tpass (A2 B2 C: class):
  $ wceq (ctp A2 B2 C) (cun (csn A2) (cpr B2 C)) $;

--| Two ways to write an unordered quadruple. (Contributed by Mario Carneiro, 5-Jan-2016.)
theorem qdass (A2 B2 C D: class):
  $ wceq (cun (cpr A2 B2) (cpr C D)) (cun (ctp A2 B2 C) (csn D)) $;

--| Two ways to write an unordered quadruple. (Contributed by Mario Carneiro, 5-Jan-2016.)
theorem qdassr (A2 B2 C D: class):
  $ wceq (cun (cpr A2 B2) (cpr C D)) (cun (csn A2) (ctp B2 C D)) $;

--| Unordered triple ` { A , A , B } ` is just an overlong way to write ` { A , B } ` . (Contributed by David A. Wheeler, 10-May-2015.)
theorem tpidm12 (A2 B2: class):
  $ wceq (ctp A2 A2 B2) (cpr A2 B2) $;

--| Unordered triple ` { A , B , A } ` is just an overlong way to write ` { A , B } ` . (Contributed by David A. Wheeler, 10-May-2015.)
theorem tpidm13 (A2 B2: class):
  $ wceq (ctp A2 B2 A2) (cpr A2 B2) $;

--| Unordered triple ` { A , B , B } ` is just an overlong way to write ` { A , B } ` . (Contributed by David A. Wheeler, 10-May-2015.)
theorem tpidm23 (A2 B2: class):
  $ wceq (ctp A2 B2 B2) (cpr A2 B2) $;

--| Unordered triple ` { A , A , A } ` is just an overlong way to write ` { A } ` . (Contributed by David A. Wheeler, 10-May-2015.)
theorem tpidm (A2: class):
  $ wceq (ctp A2 A2 A2) (csn A2) $;

--| An unordered triple is an unordered pair if one of its elements is identical with another element. (Contributed by Alexander van der Vekens, 6-Oct-2017.)
theorem tppreq3 (A2 B2 C: class):
  $ wi (wceq B2 C) (wceq (ctp A2 B2 C) (cpr A2 B2)) $;

--| An unordered pair contains its first member. Part of Theorem 7.6 of [Quine] p. 49. (Contributed by Stefan Allan, 8-Nov-2008.)
theorem prid1g (A2 B2 V: class):
  $ wi (wcel A2 V) (wcel A2 (cpr A2 B2)) $;

--| An unordered pair contains its second member. Part of Theorem 7.6 of [Quine] p. 49. (Contributed by Stefan Allan, 8-Nov-2008.)
theorem prid2g (A2 B2 V: class):
  $ wi (wcel B2 V) (wcel B2 (cpr A2 B2)) $;

--| An unordered pair contains its first member. Part of Theorem 7.6 of [Quine] p. 49. (Contributed by NM, 5-Aug-1993.)
theorem prid1 (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel A2 (cpr A2 B2) $;

--| An unordered pair contains its second member. Part of Theorem 7.6 of [Quine] p. 49. (Contributed by NM, 5-Aug-1993.)
theorem prid2 (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wcel B2 (cpr A2 B2) $;

--| A proper class vanishes in an unordered pair. (Contributed by NM, 5-Aug-1993.)
theorem prprc1 (A2 B2: class):
  $ wi (wn (wcel A2 cvv)) (wceq (cpr A2 B2) (csn B2)) $;

--| A proper class vanishes in an unordered pair. (Contributed by NM, 22-Mar-2006.)
theorem prprc2 (A2 B2: class):
  $ wi (wn (wcel B2 cvv)) (wceq (cpr A2 B2) (csn A2)) $;

--| An unordered pair containing two proper classes is the empty set. (Contributed by NM, 22-Mar-2006.)
theorem prprc (A2 B2: class):
  $ wi (wa (wn (wcel A2 cvv)) (wn (wcel B2 cvv))) (wceq (cpr A2 B2) c0) $;

--| One of the three elements of an unordered triple. (Contributed by NM, 7-Apr-1994.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem tpid1 (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel A2 (ctp A2 B2 C) $;

--| One of the three elements of an unordered triple. (Contributed by NM, 7-Apr-1994.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem tpid2 (A2 B2 C: class):
  $ wcel B2 cvv $ >
  $ wcel B2 (ctp A2 B2 C) $;

--| Closed theorem form of ~ tpid3 . (Contributed by Alan Sare, 24-Oct-2011.)
theorem tpid3g (A2 B2 C D: class):
  $ wi (wcel A2 B2) (wcel A2 (ctp C D A2)) $;

--| One of the three elements of an unordered triple. (Contributed by NM, 7-Apr-1994.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem tpid3 (A2 B2 C: class):
  $ wcel C cvv $ >
  $ wcel C (ctp A2 B2 C) $;

--| The singleton of a set is not empty. (Contributed by NM, 14-Dec-2008.)
theorem snnzg (A2 V: class):
  $ wi (wcel A2 V) (wne (csn A2) c0) $;

--| The singleton of a set is inhabited. (Contributed by Jim Kingdon, 11-Aug-2018.)
theorem snmg {x3: setvar} (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wex x3 (wcel (cv x3) (csn A2))) $;

--| The singleton of a set is not empty. (Contributed by NM, 10-Apr-1994.)
theorem snnz (A2: class):
  $ wcel A2 cvv $ >
  $ wne (csn A2) c0 $;

--| The singleton of a set is inhabited. (Contributed by Jim Kingdon, 11-Aug-2018.)
theorem snm {x3: setvar} (A2: class):
  $ wcel A2 cvv $ >
  $ wex x3 (wcel (cv x3) (csn A2)) $;

--| A pair containing a set is inhabited. (Contributed by Jim Kingdon, 21-Sep-2018.)
theorem prmg {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel A2 V) (wex x3 (wcel (cv x3) (cpr A2 B2))) $;

--| A pair containing a set is not empty. (Contributed by NM, 9-Apr-1994.)
theorem prnz (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wne (cpr A2 B2) c0 $;

--| A pair containing a set is inhabited. (Contributed by Jim Kingdon, 21-Sep-2018.)
theorem prm {x3: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wex x3 (wcel (cv x3) (cpr A2 B2)) $;

--| A pair containing a set is not empty. (Contributed by FL, 19-Sep-2011.)
theorem prnzg (A2 B2 V: class):
  $ wi (wcel A2 V) (wne (cpr A2 B2) c0) $;

--| A triplet containing a set is not empty. (Contributed by NM, 10-Apr-1994.)
theorem tpnz (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wne (ctp A2 B2 C) c0 $;

--| The singleton of an element of a class is a subset of the class. Theorem 7.4 of [Quine] p. 49. (Contributed by NM, 5-Aug-1993.)
theorem snss (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 B2) (wss (csn A2) B2) $;

--| Membership in a set with an element removed. (Contributed by NM, 10-Oct-2007.)
theorem eldifsn (A2 B2 C: class):
  $ wb (wcel A2 (cdif B2 (csn C))) (wa (wcel A2 B2) (wne A2 C)) $;

--| Membership in a set with an element removed. (Contributed by NM, 10-Mar-2015.)
theorem eldifsni (A2 B2 C: class):
  $ wi (wcel A2 (cdif B2 (csn C))) (wne A2 C) $;

--| ` A ` is not in ` ( B \ { A } ) ` . (Contributed by David Moews, 1-May-2017.)
theorem neldifsn (A2 B2: class):
  $ wn (wcel A2 (cdif B2 (csn A2))) $;

--| ` A ` is not in ` ( B \ { A } ) ` . Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem neldifsnd (ph: wff) (A2 B2: class):
  $ wi ph (wn (wcel A2 (cdif B2 (csn A2)))) $;

--| Restricted existential quantification over a set with an element removed. (Contributed by NM, 4-Feb-2015.)
theorem rexdifsn {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wb (wrex x3 ph (cdif A2 (csn B2))) (wrex x3 (wa (wne (cv x3) B2) ph) A2) $;

--| The singleton of an element of a class is a subset of the class. Theorem 7.4 of [Quine] p. 49. (Contributed by NM, 22-Jul-2001.)
theorem snssg (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 B2) (wss (csn A2) B2)) $;

--| An element not in a set can be removed without affecting the set. (Contributed by NM, 16-Mar-2006.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem difsn (A2 B2: class):
  $ wi (wn (wcel A2 B2)) (wceq (cdif B2 (csn A2)) B2) $;

--| Removal of a singleton from an unordered pair. (Contributed by NM, 16-Mar-2006.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem difprsnss (A2 B2: class):
  $ wss (cdif (cpr A2 B2) (csn A2)) (csn B2) $;

--| Removal of a singleton from an unordered pair. (Contributed by Thierry Arnoux, 4-Feb-2017.)
theorem difprsn1 (A2 B2: class):
  $ wi (wne A2 B2) (wceq (cdif (cpr A2 B2) (csn A2)) (csn B2)) $;

--| Removal of a singleton from an unordered pair. (Contributed by Alexander van der Vekens, 5-Oct-2017.)
theorem difprsn2 (A2 B2: class):
  $ wi (wne A2 B2) (wceq (cdif (cpr A2 B2) (csn B2)) (csn A2)) $;

--| Removal of a singleton from an unordered triple. (Contributed by Alexander van der Vekens, 5-Oct-2017.)
theorem diftpsn3 (A2 B2 C: class):
  $ wi (wa (wne A2 C) (wne B2 C)) (wceq (cdif (ctp A2 B2 C) (csn C)) (cpr A2 B2)) $;

--| ` ( B \ { A } ) ` equals ` B ` if and only if ` A ` is not a member of ` B ` . Generalization of ~ difsn . (Contributed by David Moews, 1-May-2017.)
theorem difsnb (A2 B2: class):
  $ wb (wn (wcel A2 B2)) (wceq (cdif B2 (csn A2)) B2) $;

--| ` ( B \ { A } ) ` is a proper subclass of ` B ` if ` A ` is a member of ` B ` . In classical logic, the converse holds as well. (Contributed by Jim Kingdon, 9-Aug-2018.)
theorem difsnpssim (A2 B2: class):
  $ wi (wcel A2 B2) (wpss (cdif B2 (csn A2)) B2) $;

--| The singleton of an element of a class is a subset of the class. (Contributed by NM, 6-Jun-1994.)
theorem snssi (A2 B2: class):
  $ wi (wcel A2 B2) (wss (csn A2) B2) $;

--| The singleton of an element of a class is a subset of the class (deduction rule). (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem snssd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wss (csn A2) B2) $;

--| If we remove a single element from a class then put it back in, we end up with a subset of the original class. If equality is decidable, we can replace subset with equality as seen in ~ nndifsnid . (Contributed by Jim Kingdon, 10-Aug-2018.)
theorem difsnss (A2 B2: class):
  $ wi (wcel B2 A2) (wss (cun (cdif A2 (csn B2)) (csn B2)) A2) $;

--| Compute the power set of the empty set. Theorem 89 of [Suppes] p. 47. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem pw0:
  $ wceq (cpw c0) (csn c0) $;

--| A singleton is a subset of an unordered pair containing its member. (Contributed by NM, 27-Aug-2004.)
theorem snsspr1 (A2 B2: class):
  $ wss (csn A2) (cpr A2 B2) $;

--| A singleton is a subset of an unordered pair containing its member. (Contributed by NM, 2-May-2009.)
theorem snsspr2 (A2 B2: class):
  $ wss (csn B2) (cpr A2 B2) $;

--| A singleton is a subset of an unordered triple containing its member. (Contributed by NM, 9-Oct-2013.)
theorem snsstp1 (A2 B2 C: class):
  $ wss (csn A2) (ctp A2 B2 C) $;

--| A singleton is a subset of an unordered triple containing its member. (Contributed by NM, 9-Oct-2013.)
theorem snsstp2 (A2 B2 C: class):
  $ wss (csn B2) (ctp A2 B2 C) $;

--| A singleton is a subset of an unordered triple containing its member. (Contributed by NM, 9-Oct-2013.)
theorem snsstp3 (A2 B2 C: class):
  $ wss (csn C) (ctp A2 B2 C) $;

--| A pair is a subset of an unordered triple containing its members. (Contributed by Jim Kingdon, 11-Aug-2018.)
theorem prsstp12 (A2 B2 C: class):
  $ wss (cpr A2 B2) (ctp A2 B2 C) $;

--| A pair is a subset of an unordered triple containing its members. (Contributed by Jim Kingdon, 11-Aug-2018.)
theorem prsstp13 (A2 B2 C: class):
  $ wss (cpr A2 C) (ctp A2 B2 C) $;

--| A pair is a subset of an unordered triple containing its members. (Contributed by Jim Kingdon, 11-Aug-2018.)
theorem prsstp23 (A2 B2 C: class):
  $ wss (cpr B2 C) (ctp A2 B2 C) $;

--| A pair of elements of a class is a subset of the class. Theorem 7.5 of [Quine] p. 49. (Contributed by NM, 30-May-1994.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem prss (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wa (wcel A2 C) (wcel B2 C)) (wss (cpr A2 B2) C) $;

--| A pair of elements of a class is a subset of the class. Theorem 7.5 of [Quine] p. 49. (Contributed by NM, 22-Mar-2006.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem prssg (A2 B2 C V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wa (wcel A2 C) (wcel B2 C)) (wss (cpr A2 B2) C)) $;

--| A pair of elements of a class is a subset of the class. (Contributed by NM, 16-Jan-2015.)
theorem prssi (A2 B2 C: class):
  $ wi (wa (wcel A2 C) (wcel B2 C)) (wss (cpr A2 B2) C) $;

--| An unordered pair belongs to the power class of a class iff each member belongs to the class. (Contributed by Thierry Arnoux, 3-Oct-2016.) (Revised by NM, 18-Jan-2018.)
theorem prsspwg (A2 B2 C V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wss (cpr A2 B2) (cpw C)) (wa (wss A2 C) (wss B2 C))) $;

--| Empty set and the singleton itself are subsets of a singleton. (Contributed by Jim Kingdon, 10-Aug-2018.)
theorem sssnr (A2 B2: class):
  $ wi (wo (wceq A2 c0) (wceq A2 (csn B2))) (wss A2 (csn B2)) $;

--| The inhabited subset of a singleton. (Contributed by Jim Kingdon, 10-Aug-2018.)
theorem sssnm {x3: setvar} (A2 B2: class):
  $ wi (wex x3 (wcel (cv x3) A2)) (wb (wss A2 (csn B2)) (wceq A2 (csn B2))) $;

--| Two ways to express that an inhabited set equals a singleton. (Contributed by Jim Kingdon, 11-Aug-2018.)
theorem eqsnm {x3: setvar} (A2 B2: class):
  $ wi (wex x3 (wcel (cv x3) A2)) (wb (wceq A2 (csn B2)) (wral x3 (wceq (cv x3) B2) A2)) $;

--| The subsets of a pair. (Contributed by Jim Kingdon, 11-Aug-2018.)
theorem ssprr (A2 B2 C: class):
  $ wi (wo (wo (wceq A2 c0) (wceq A2 (csn B2))) (wo (wceq A2 (csn C)) (wceq A2 (cpr B2 C)))) (wss A2 (cpr B2 C)) $;

--| The subsets of a triple. (Contributed by Jim Kingdon, 11-Aug-2018.)
theorem sstpr (A2 B2 C D: class):
  $ wi (wo (wo (wo (wceq A2 c0) (wceq A2 (csn B2))) (wo (wceq A2 (csn C)) (wceq A2 (cpr B2 C)))) (wo (wo (wceq A2 (csn D)) (wceq A2 (cpr B2 D))) (wo (wceq A2 (cpr C D)) (wceq A2 (ctp B2 C D))))) (wss A2 (ctp B2 C D)) $;

--| A triplet of elements of a class is a subset of the class. (Contributed by NM, 9-Apr-1994.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem tpss (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wb (w3a (wcel A2 D) (wcel B2 D) (wcel C D)) (wss (ctp A2 B2 C) D) $;

--| A triple of elements of a class is a subset of the class. (Contributed by Alexander van der Vekens, 1-Feb-2018.)
theorem tpssi (A2 B2 C D: class):
  $ wi (w3a (wcel A2 D) (wcel B2 D) (wcel C D)) (wss (ctp A2 B2 C) D) $;

--| If the singletons of two sets are equal, the two sets are equal. Part of Exercise 4 of [TakeutiZaring] p. 15. (Contributed by NM, 27-Aug-1993.)
theorem sneqr (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (csn A2) (csn B2)) (wceq A2 B2) $;

--| If a singleton is a subset of another, their members are equal. (Contributed by NM, 28-May-2006.)
theorem snsssn (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wi (wss (csn A2) (csn B2)) (wceq A2 B2) $;

--| Closed form of ~ sneqr . (Contributed by Scott Fenton, 1-Apr-2011.)
theorem sneqrg (A2 B2 V: class):
  $ wi (wcel A2 V) (wi (wceq (csn A2) (csn B2)) (wceq A2 B2)) $;

--| Two singletons of sets are equal iff their elements are equal. (Contributed by Scott Fenton, 16-Apr-2012.)
theorem sneqbg (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wceq (csn A2) (csn B2)) (wceq A2 B2)) $;

--| The singleton of a class is a subset of its power class. (Contributed by NM, 5-Aug-1993.)
theorem snsspw (A2: class):
  $ wss (csn A2) (cpw A2) $;

--| An unordered pair belongs to the power class of a class iff each member belongs to the class. (Contributed by NM, 10-Dec-2003.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem prsspw (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wss (cpr A2 B2) (cpw C)) (wa (wss A2 C) (wss B2 C)) $;

--| Reverse equality lemma for unordered pairs. If two unordered pairs have the same second element, the first elements are equal. Closed form of ~ preqr1 . (Contributed by Jim Kingdon, 21-Sep-2018.)
theorem preqr1g (A2 B2 C: class):
  $ wi (wa (wcel A2 cvv) (wcel B2 cvv)) (wi (wceq (cpr A2 C) (cpr B2 C)) (wceq A2 B2)) $;

--| Reverse equality lemma for unordered pairs. If two unordered pairs have the same second element, the second elements are equal. Closed form of ~ preqr2 . (Contributed by Jim Kingdon, 21-Sep-2018.)
theorem preqr2g (A2 B2 C: class):
  $ wi (wa (wcel A2 cvv) (wcel B2 cvv)) (wi (wceq (cpr C A2) (cpr C B2)) (wceq A2 B2)) $;

--| Reverse equality lemma for unordered pairs. If two unordered pairs have the same second element, the first elements are equal. (Contributed by NM, 18-Oct-1995.)
theorem preqr1 (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cpr A2 C) (cpr B2 C)) (wceq A2 B2) $;

--| Reverse equality lemma for unordered pairs. If two unordered pairs have the same first element, the second elements are equal. (Contributed by NM, 5-Aug-1993.)
theorem preqr2 (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cpr C A2) (cpr C B2)) (wceq A2 B2) $;

--| Equality relationship for two unordered pairs. (Contributed by NM, 17-Oct-1996.)
theorem preq12b (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wb (wceq (cpr A2 B2) (cpr C D)) (wo (wa (wceq A2 C) (wceq B2 D)) (wa (wceq A2 D) (wceq B2 C))) $;

--| Equality of two unordered pairs. (Contributed by NM, 17-Oct-1996.)
theorem prel12 (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wi (wn (wceq A2 B2)) (wb (wceq (cpr A2 B2) (cpr C D)) (wa (wcel A2 (cpr C D)) (wcel B2 (cpr C D)))) $;

--| A way to represent ordered pairs using unordered pairs with distinct members. (Contributed by NM, 27-Mar-2007.)
theorem opthpr (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wi (wne A2 D) (wb (wceq (cpr A2 B2) (cpr C D)) (wa (wceq A2 C) (wceq B2 D))) $;

--| Closed form of ~ preq12b . (Contributed by Scott Fenton, 28-Mar-2014.)
theorem preq12bg (A2 B2 C D V W X Y: class):
  $ wi (wa (wa (wcel A2 V) (wcel B2 W)) (wa (wcel C X) (wcel D Y))) (wb (wceq (cpr A2 B2) (cpr C D)) (wo (wa (wceq A2 C) (wceq B2 D)) (wa (wceq A2 D) (wceq B2 C)))) $;

--| Two pairs are not equal if at least one element of the first pair is not contained in the second pair. (Contributed by Alexander van der Vekens, 13-Aug-2017.)
theorem prneimg (A2 B2 C D U V X Y: class):
  $ wi (wa (wa (wcel A2 U) (wcel B2 V)) (wa (wcel C X) (wcel D Y))) (wi (wo (wa (wne A2 C) (wne A2 D)) (wa (wne B2 C) (wne B2 D))) (wne (cpr A2 B2) (cpr C D))) $;

--| Equivalence for a pair equal to a singleton. (Contributed by NM, 3-Jun-2008.)
theorem preqsn (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wb (wceq (cpr A2 B2) (csn C)) (wa (wceq A2 B2) (wceq B2 C)) $;

--| Value of the ordered pair when the arguments are sets. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem dfopg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (cop A2 B2) (cpr (csn A2) (cpr A2 B2))) $;

--| Value of an ordered pair when the arguments are sets, with the conclusion corresponding to Kuratowski's original definition. (Contributed by NM, 25-Jun-1998.)
theorem dfop (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cop A2 B2) (cpr (csn A2) (cpr A2 B2)) $;

--| Equality theorem for ordered pairs. (Contributed by NM, 25-Jun-1998.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opeq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cop A2 C) (cop B2 C)) $;

--| Equality theorem for ordered pairs. (Contributed by NM, 25-Jun-1998.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opeq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cop C A2) (cop C B2)) $;

--| Equality theorem for ordered pairs. (Contributed by NM, 28-May-1995.)
theorem opeq12 (A2 B2 C D: class):
  $ wi (wa (wceq A2 C) (wceq B2 D)) (wceq (cop A2 B2) (cop C D)) $;

--| Equality inference for ordered pairs. (Contributed by NM, 16-Dec-2006.)
theorem opeq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cop A2 C) (cop B2 C) $;

--| Equality inference for ordered pairs. (Contributed by NM, 16-Dec-2006.)
theorem opeq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cop C A2) (cop C B2) $;

--| Equality inference for ordered pairs. (Contributed by NM, 16-Dec-2006.) (Proof shortened by Eric Schmidt, 4-Apr-2007.)
theorem opeq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (cop A2 C) (cop B2 D) $;

--| Equality deduction for ordered pairs. (Contributed by NM, 16-Dec-2006.)
theorem opeq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cop A2 C) (cop B2 C)) $;

--| Equality deduction for ordered pairs. (Contributed by NM, 16-Dec-2006.)
theorem opeq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cop C A2) (cop C B2)) $;

--| Equality deduction for ordered pairs. (Contributed by NM, 16-Dec-2006.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem opeq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cop A2 C) (cop B2 D)) $;

--| Equality theorem for ordered triples. (Contributed by NM, 3-Apr-2015.)
theorem oteq1 (A2 B2 C D: class):
  $ wi (wceq A2 B2) (wceq (cotp A2 C D) (cotp B2 C D)) $;

--| Equality theorem for ordered triples. (Contributed by NM, 3-Apr-2015.)
theorem oteq2 (A2 B2 C D: class):
  $ wi (wceq A2 B2) (wceq (cotp C A2 D) (cotp C B2 D)) $;

--| Equality theorem for ordered triples. (Contributed by NM, 3-Apr-2015.)
theorem oteq3 (A2 B2 C D: class):
  $ wi (wceq A2 B2) (wceq (cotp C D A2) (cotp C D B2)) $;

--| Equality deduction for ordered triples. (Contributed by Mario Carneiro, 11-Jan-2017.)
theorem oteq1d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cotp A2 C D) (cotp B2 C D)) $;

--| Equality deduction for ordered triples. (Contributed by Mario Carneiro, 11-Jan-2017.)
theorem oteq2d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cotp C A2 D) (cotp C B2 D)) $;

--| Equality deduction for ordered triples. (Contributed by Mario Carneiro, 11-Jan-2017.)
theorem oteq3d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cotp C D A2) (cotp C D B2)) $;

--| Equality deduction for ordered triples. (Contributed by Mario Carneiro, 11-Jan-2017.)
theorem oteq123d (ph: wff) (A2 B2 C D E F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq E F) $ >
  $ wi ph (wceq (cotp A2 C E) (cotp B2 D F)) $;

--| Bound-variable hypothesis builder for ordered pairs. (Contributed by NM, 14-Nov-1995.)
theorem nfop {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cop A2 B2) $;

--| Deduction version of bound-variable hypothesis builder ~ nfop . This shows how the deduction version of a not-free theorem such as ~ nfop can be created from the corresponding not-free inference theorem. (Contributed by NM, 4-Feb-2008.)
theorem nfopd {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnfc x3 (cop A2 B2)) $;

--| The ordered pair ` <. A , A >. ` in Kuratowski's representation. (Contributed by FL, 28-Dec-2011.)
theorem opid (A2: class):
  $ wcel A2 cvv $ >
  $ wceq (cop A2 A2) (csn (csn A2)) $;

--| Restricted quantification over the union of a set and a singleton, using implicit substitution. (Contributed by Paul Chapman, 17-Nov-2012.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem ralunsn {x3: setvar} (ph: wff x3) (ps: wff) (A2: class x3) (B2: class) (C: class x3):
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (wcel B2 C) (wb (wral x3 ph (cun A2 (csn B2))) (wa (wral x3 ph A2) ps)) $;

--| Double restricted quantification over the union of a set and a singleton, using implicit substitution. (Contributed by Paul Chapman, 17-Nov-2012.)
theorem _2ralunsn {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch th: wff y1) (A2: class y1) (B2: class) (C: class y1):
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wceq (cv y1) B2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ps th) $ >
  $ wi (wcel B2 C) (wb (wral x3 (wral y1 ph (cun A2 (csn B2))) (cun A2 (csn B2))) (wa (wa (wral x3 (wral y1 ph A2) A2) (wral x3 ps A2)) (wa (wral y1 ch A2) th))) $;

--| Expansion of an ordered pair when either member is a proper class. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem opprc (A2 B2: class):
  $ wi (wn (wa (wcel A2 cvv) (wcel B2 cvv))) (wceq (cop A2 B2) c0) $;

--| Expansion of an ordered pair when the first member is a proper class. See also ~ opprc . (Contributed by NM, 10-Apr-2004.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opprc1 (A2 B2: class):
  $ wi (wn (wcel A2 cvv)) (wceq (cop A2 B2) c0) $;

--| Expansion of an ordered pair when the second member is a proper class. See also ~ opprc . (Contributed by NM, 15-Nov-1994.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opprc2 (A2 B2: class):
  $ wi (wn (wcel B2 cvv)) (wceq (cop A2 B2) c0) $;

--| If an ordered pair has an element, then its arguments are sets. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem oprcl (A2 B2 C: class):
  $ wi (wcel C (cop A2 B2)) (wa (wcel A2 cvv) (wcel B2 cvv)) $;

--| The power set of a singleton. (Contributed by Jim Kingdon, 12-Aug-2018.)
theorem pwsnss (A2: class):
  $ wss (cpr c0 (csn A2)) (cpw (csn A2)) $;

--| Compute the power set of the power set of the empty set. (See ~ pw0 for the power set of the empty set.) Theorem 90 of [Suppes] p. 48 (but with subset in place of equality). (Contributed by Jim Kingdon, 12-Aug-2018.)
theorem pwpw0ss:
  $ wss (cpr c0 (csn c0)) (cpw (csn c0)) $;

--| The power set of an unordered pair. (Contributed by Jim Kingdon, 13-Aug-2018.)
theorem pwprss (A2 B2: class):
  $ wss (cun (cpr c0 (csn A2)) (cpr (csn B2) (cpr A2 B2))) (cpw (cpr A2 B2)) $;

--| The power set of an unordered triple. (Contributed by Jim Kingdon, 13-Aug-2018.)
theorem pwtpss (A2 B2 C: class):
  $ wss (cun (cun (cpr c0 (csn A2)) (cpr (csn B2) (cpr A2 B2))) (cun (cpr (csn C) (cpr A2 C)) (cpr (cpr B2 C) (ctp A2 B2 C)))) (cpw (ctp A2 B2 C)) $;

--| Compute the power set of the power set of the power set of the empty set. (See also ~ pw0 and ~ pwpw0ss .) (Contributed by Jim Kingdon, 13-Aug-2018.)
theorem pwpwpw0ss:
  $ wss (cun (cpr c0 (csn c0)) (cpr (csn (csn c0)) (cpr c0 (csn c0)))) (cpw (cpr c0 (csn c0))) $;

--| The power class of the universe is the universe. Exercise 4.12(d) of [Mendelson] p. 235. (Contributed by NM, 14-Sep-2003.)
theorem pwv:
  $ wceq (cpw cvv) cvv $;

--| Extend class notation to include the union of a class (read: 'union ` A ` ')
term cuni (A2: class): class;

--| Define the union of a class i.e. the collection of all members of the members of the class. Definition 5.5 of [TakeutiZaring] p. 16. For example, { { 1 , 3 } , { 1 , 8 } } = { 1 , 3 , 8 } . This is similar to the union of two classes ~ df-un . (Contributed by NM, 23-Aug-1993.)
axiom df_uni {x3 y1: setvar} (A2: class):
  $ wceq (cuni A2) (cab x3 (wex y1 (wa (wcel (cv x3) (cv y1)) (wcel (cv y1) A2)))) $;

--| Alternate definition of class union. (Contributed by NM, 28-Jun-1998.)
theorem dfuni2 {x3 y1: setvar} (A2: class):
  $ wceq (cuni A2) (cab x3 (wrex y1 (wcel (cv x3) (cv y1)) A2)) $;

--| Membership in class union. (Contributed by NM, 22-May-1994.)
theorem eluni {x3: setvar} (A2 B2: class):
  $ wb (wcel A2 (cuni B2)) (wex x3 (wa (wcel A2 (cv x3)) (wcel (cv x3) B2))) $;

--| Membership in class union. Restricted quantifier version. (Contributed by NM, 31-Aug-1999.)
theorem eluni2 {x3: setvar} (A2 B2: class):
  $ wb (wcel A2 (cuni B2)) (wrex x3 (wcel A2 (cv x3)) B2) $;

--| Membership in class union. (Contributed by NM, 24-Mar-1995.)
theorem elunii (A2 B2 C: class):
  $ wi (wa (wcel A2 B2) (wcel B2 C)) (wcel A2 (cuni C)) $;

--| Bound-variable hypothesis builder for union. (Contributed by NM, 30-Dec-1996.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem nfuni {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (cuni A2) $;

--| Deduction version of ~ nfuni . (Contributed by NM, 18-Feb-2013.)
theorem nfunid {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 (cuni A2)) $;

--| Distribute proper substitution through the union of a class. (Contributed by Alan Sare, 10-Nov-2012.)
theorem csbunig {x3: setvar} (A2 B2 V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (cuni B2)) (cuni (csb x3 A2 B2))) $;

--| Equality theorem for class union. Exercise 15 of [TakeutiZaring] p. 18. (Contributed by NM, 10-Aug-1993.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem unieq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (cuni A2) (cuni B2)) $;

--| Inference of equality of two class unions. (Contributed by NM, 30-Aug-1993.)
theorem unieqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq (cuni A2) (cuni B2) $;

--| Deduction of equality of two class unions. (Contributed by NM, 21-Apr-1995.)
theorem unieqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cuni A2) (cuni B2)) $;

--| Membership in union of a class abstraction. (Contributed by NM, 11-Aug-1994.) (Revised by Mario Carneiro, 14-Nov-2016.)
theorem eluniab {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wcel A2 (cuni (cab x3 ph))) (wex x3 (wa (wcel A2 (cv x3)) ph)) $;

--| Membership in union of a class abstraction. (Contributed by NM, 4-Oct-2006.)
theorem elunirab {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3):
  $ wb (wcel A2 (cuni (crab x3 ph B2))) (wrex x3 (wa (wcel A2 (cv x3)) ph) B2) $;

--| The union of a pair is the union of its members. Proposition 5.7 of [TakeutiZaring] p. 16. (Contributed by NM, 23-Aug-1993.)
theorem unipr (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cuni (cpr A2 B2)) (cun A2 B2) $;

--| The union of a pair is the union of its members. Proposition 5.7 of [TakeutiZaring] p. 16. (Contributed by NM, 25-Aug-2006.)
theorem uniprg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (cuni (cpr A2 B2)) (cun A2 B2)) $;

--| A set equals the union of its singleton. Theorem 8.2 of [Quine] p. 53. (Contributed by NM, 30-Aug-1993.)
theorem unisn (A2: class):
  $ wcel A2 cvv $ >
  $ wceq (cuni (csn A2)) A2 $;

--| A set equals the union of its singleton. Theorem 8.2 of [Quine] p. 53. (Contributed by NM, 13-Aug-2002.)
theorem unisng (A2 V: class):
  $ wi (wcel A2 V) (wceq (cuni (csn A2)) A2) $;

--| An alternative statement of the effective freeness of a class ` A ` , when it is a set. (Contributed by Mario Carneiro, 14-Oct-2016.)
theorem dfnfc2 {x3 y1: setvar} (A2: class x3) (V: class x3 y1):
  $ wi (wal x3 (wcel A2 V)) (wb (wnfc x3 A2) (wal y1 (wnf x3 (wceq (cv y1) A2)))) $;

--| The class union of the union of two classes. Theorem 8.3 of [Quine] p. 53. (Contributed by NM, 20-Aug-1993.)
theorem uniun (A2 B2: class):
  $ wceq (cuni (cun A2 B2)) (cun (cuni A2) (cuni B2)) $;

--| The class union of the intersection of two classes. Exercise 4.12(n) of [Mendelson] p. 235. (Contributed by NM, 4-Dec-2003.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem uniin (A2 B2: class):
  $ wss (cuni (cin A2 B2)) (cin (cuni A2) (cuni B2)) $;

--| Subclass relationship for class union. Theorem 61 of [Suppes] p. 39. (Contributed by NM, 22-Mar-1998.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem uniss (A2 B2: class):
  $ wi (wss A2 B2) (wss (cuni A2) (cuni B2)) $;

--| Subclass relationship for class union. (Contributed by NM, 24-May-1994.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem ssuni (A2 B2 C: class):
  $ wi (wa (wss A2 B2) (wcel B2 C)) (wss A2 (cuni C)) $;

--| Subclass relationship for subclass union. Inference form of ~ uniss . (Contributed by David Moews, 1-May-2017.)
theorem unissi (A2 B2: class):
  $ wss A2 B2 $ >
  $ wss (cuni A2) (cuni B2) $;

--| Subclass relationship for subclass union. Deduction form of ~ uniss . (Contributed by David Moews, 1-May-2017.)
theorem unissd (ph: wff) (A2 B2: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss (cuni A2) (cuni B2)) $;

--| The union of a set is empty iff the set is included in the singleton of the empty set. (Contributed by NM, 12-Sep-2004.)
theorem uni0b (A2: class):
  $ wb (wceq (cuni A2) c0) (wss A2 (csn c0)) $;

--| The union of a set is empty iff all of its members are empty. (Contributed by NM, 16-Aug-2006.)
theorem uni0c {x3: setvar} (A2: class):
  $ wb (wceq (cuni A2) c0) (wral x3 (wceq (cv x3) c0) A2) $;

--| The union of the empty set is the empty set. Theorem 8.7 of [Quine] p. 54. (Reproved without relying on ax-nul by Eric Schmidt.) (Contributed by NM, 16-Sep-1993.) (Revised by Eric Schmidt, 4-Apr-2007.)
theorem uni0:
  $ wceq (cuni c0) c0 $;

--| An element of a class is a subclass of its union. Theorem 8.6 of [Quine] p. 54. Also the basis for Proposition 7.20 of [TakeutiZaring] p. 40. (Contributed by NM, 6-Jun-1994.)
theorem elssuni (A2 B2: class):
  $ wi (wcel A2 B2) (wss A2 (cuni B2)) $;

--| Condition turning a subclass relationship for union into an equality. (Contributed by NM, 18-Jul-2006.)
theorem unissel (A2 B2: class):
  $ wi (wa (wss (cuni A2) B2) (wcel B2 A2)) (wceq (cuni A2) B2) $;

--| Relationship involving membership, subset, and union. Exercise 5 of [Enderton] p. 26 and its converse. (Contributed by NM, 20-Sep-2003.)
theorem unissb {x3: setvar} (A2 B2: class):
  $ wb (wss (cuni A2) B2) (wral x3 (wss (cv x3) B2) A2) $;

--| A subclass condition on the members of two classes that implies a subclass relation on their unions. Proposition 8.6 of [TakeutiZaring] p. 59. (Contributed by NM, 22-Mar-2004.)
theorem uniss2 {x3 y1: setvar} (A2: class y1) (B2: class):
  $ wi (wral x3 (wrex y1 (wss (cv x3) (cv y1)) B2) A2) (wss (cuni A2) (cuni B2)) $;

--| If the difference ` A \ B ` contains the largest members of ` A ` , then the union of the difference is the union of ` A ` . (Contributed by NM, 22-Mar-2004.)
theorem unidif {x3 y1: setvar} (A2 B2: class):
  $ wi (wral x3 (wrex y1 (wss (cv x3) (cv y1)) (cdif A2 B2)) A2) (wceq (cuni (cdif A2 B2)) (cuni A2)) $;

--| Relationship implying union. (Contributed by NM, 10-Nov-1999.)
theorem ssunieq {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 B2) (wral x3 (wss (cv x3) A2) B2)) (wceq A2 (cuni B2)) $;

--| Any member of a class is the largest of those members that it includes. (Contributed by NM, 13-Aug-2002.)
theorem unimax {x3: setvar} (A2 B2: class):
  $ wi (wcel A2 B2) (wceq (cuni (crab x3 (wss (cv x3) A2) B2)) A2) $;

--| Extend class notation to include the intersection of a class (read: 'intersect ` A ` ').
term cint (A2: class): class;

--| Define the intersection of a class. Definition 7.35 of [TakeutiZaring] p. 44. For example, ` |^| ` { { 1 , 3 } , { 1 , 8 } } = { 1 } . Compare this with the intersection of two classes, ~ df-in . (Contributed by NM, 18-Aug-1993.)
axiom df_int {x3 y1: setvar} (A2: class):
  $ wceq (cint A2) (cab x3 (wal y1 (wi (wcel (cv y1) A2) (wcel (cv x3) (cv y1))))) $;

--| Alternate definition of class intersection. (Contributed by NM, 28-Jun-1998.)
theorem dfint2 {x3 y1: setvar} (A2: class):
  $ wceq (cint A2) (cab x3 (wral y1 (wcel (cv x3) (cv y1)) A2)) $;

--| Equality law for intersection. (Contributed by NM, 13-Sep-1999.)
theorem inteq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (cint A2) (cint B2)) $;

--| Equality inference for class intersection. (Contributed by NM, 2-Sep-2003.)
theorem inteqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq (cint A2) (cint B2) $;

--| Equality deduction for class intersection. (Contributed by NM, 2-Sep-2003.)
theorem inteqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cint A2) (cint B2)) $;

--| Membership in class intersection. (Contributed by NM, 21-May-1994.)
theorem elint {x3: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cint B2)) (wal x3 (wi (wcel (cv x3) B2) (wcel A2 (cv x3)))) $;

--| Membership in class intersection. (Contributed by NM, 14-Oct-1999.)
theorem elint2 {x3: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cint B2)) (wral x3 (wcel A2 (cv x3)) B2) $;

--| Membership in class intersection, with the sethood requirement expressed as an antecedent. (Contributed by NM, 20-Nov-2003.)
theorem elintg {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wcel A2 (cint B2)) (wral x3 (wcel A2 (cv x3)) B2)) $;

--| Membership in class intersection. (Contributed by NM, 14-Oct-1999.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem elinti (A2 B2 C: class):
  $ wi (wcel A2 (cint B2)) (wi (wcel C B2) (wcel A2 C)) $;

--| Bound-variable hypothesis builder for intersection. (Contributed by NM, 2-Feb-1997.) (Proof shortened by Andrew Salmon, 12-Aug-2011.)
theorem nfint {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (cint A2) $;

--| Membership in the intersection of a class abstraction. (Contributed by NM, 30-Aug-1993.)
theorem elintab {x3: setvar} (ph: wff x3) (A2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cint (cab x3 ph))) (wal x3 (wi ph (wcel A2 (cv x3)))) $;

--| Membership in the intersection of a class abstraction. (Contributed by NM, 17-Oct-1999.)
theorem elintrab {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cint (crab x3 ph B2))) (wral x3 (wi ph (wcel A2 (cv x3))) B2) $;

--| Membership in the intersection of a class abstraction. (Contributed by NM, 17-Feb-2007.)
theorem elintrabg {x3: setvar} (ph: wff x3) (A2: class) (B2 V: class x3):
  $ wi (wcel A2 V) (wb (wcel A2 (cint (crab x3 ph B2))) (wral x3 (wi ph (wcel A2 (cv x3))) B2)) $;

--| The intersection of the empty set is the universal class. Exercise 2 of [TakeutiZaring] p. 44. (Contributed by NM, 18-Aug-1993.)
theorem int0:
  $ wceq (cint c0) cvv $;

--| An element of a class includes the intersection of the class. Exercise 4 of [TakeutiZaring] p. 44 (with correction), generalized to classes. (Contributed by NM, 18-Nov-1995.)
theorem intss1 (A2 B2: class):
  $ wi (wcel A2 B2) (wss (cint B2) A2) $;

--| Subclass of a class intersection. Theorem 5.11(viii) of [Monk1] p. 52 and its converse. (Contributed by NM, 14-Oct-1999.)
theorem ssint {x3: setvar} (A2 B2: class):
  $ wb (wss A2 (cint B2)) (wral x3 (wss A2 (cv x3)) B2) $;

--| Subclass of the intersection of a class abstraction. (Contributed by NM, 31-Jul-2006.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem ssintab {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wss A2 (cint (cab x3 ph))) (wal x3 (wi ph (wss A2 (cv x3)))) $;

--| Subclass of the least upper bound. (Contributed by NM, 8-Aug-2000.)
theorem ssintub {x3: setvar} (A2 B2: class):
  $ wss A2 (cint (crab x3 (wss A2 (cv x3)) B2)) $;

--| Subclass of the minimum value of class of supersets. (Contributed by NM, 10-Aug-2006.)
theorem ssmin {x3: setvar} (ph: wff x3) (A2: class):
  $ wss A2 (cint (cab x3 (wa (wss A2 (cv x3)) ph))) $;

--| Any member of a class is the smallest of those members that include it. (Contributed by NM, 13-Aug-2002.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem intmin {x3: setvar} (A2 B2: class):
  $ wi (wcel A2 B2) (wceq (cint (crab x3 (wss A2 (cv x3)) B2)) A2) $;

--| Intersection of subclasses. (Contributed by NM, 14-Oct-1999.)
theorem intss (A2 B2: class):
  $ wi (wss A2 B2) (wss (cint B2) (cint A2)) $;

--| The intersection of an inhabited set is a subclass of its union. (Contributed by NM, 29-Jul-2006.)
theorem intssunim {x3: setvar} (A2: class):
  $ wi (wex x3 (wcel (cv x3) A2)) (wss (cint A2) (cuni A2)) $;

--| Subclass of the intersection of a restricted class builder. (Contributed by NM, 30-Jan-2015.)
theorem ssintrab {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3):
  $ wb (wss A2 (cint (crab x3 ph B2))) (wral x3 (wi ph (wss A2 (cv x3))) B2) $;

--| Subclass relationship for intersection and union. (Contributed by Jim Kingdon, 14-Aug-2018.)
theorem intssuni2m {x3: setvar} (A2: class) (B2: class x3):
  $ wi (wa (wss A2 B2) (wex x3 (wcel (cv x3) A2))) (wss (cint A2) (cuni B2)) $;

--| Under subset ordering, the intersection of a restricted class abstraction is less than or equal to any of its members. (Contributed by NM, 7-Sep-2013.)
theorem intminss {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wa (wcel A2 B2) ps) (wss (cint (crab x3 ph B2)) A2) $;

--| Any set is the smallest of all sets that include it. (Contributed by NM, 20-Sep-2003.)
theorem intmin2 {x3: setvar} (A2: class):
  $ wcel A2 cvv $ >
  $ wceq (cint (cab x3 (wss A2 (cv x3)))) A2 $;

--| Under subset ordering, the intersection of a class abstraction is less than or equal to any of its members. (Contributed by NM, 3-Jul-2005.)
theorem intmin3 {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ ps $ >
  $ wi (wcel A2 V) (wss (cint (cab x3 ph)) A2) $;

--| Elimination of a conjunct in a class intersection. (Contributed by NM, 31-Jul-2006.)
theorem intmin4 {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wss A2 (cint (cab x3 ph))) (wceq (cint (cab x3 (wa (wss A2 (cv x3)) ph))) (cint (cab x3 ph))) $;

--| The intersection of a special case of a class abstraction. ` y ` may be free in ` ph ` and ` A ` , which can be thought of a ` ph ( y ) ` and ` A ( y ) ` . (Contributed by NM, 28-Jul-2006.) (Proof shortened by Mario Carneiro, 14-Nov-2016.)
theorem intab {x3 y1: setvar} (ph: wff y1) (A2: class y1):
  $ wcel A2 cvv $ >
  $ wcel (cab x3 (wex y1 (wa ph (wceq (cv x3) A2)))) cvv $ >
  $ wceq (cint (cab x3 (wal y1 (wi ph (wcel A2 (cv x3)))))) (cab x3 (wex y1 (wa ph (wceq (cv x3) A2)))) $;

--| The intersection of a class containing the empty set is empty. (Contributed by NM, 24-Apr-2004.)
theorem int0el (A2: class):
  $ wi (wcel c0 A2) (wceq (cint A2) c0) $;

--| The class intersection of the union of two classes. Theorem 78 of [Suppes] p. 42. (Contributed by NM, 22-Sep-2002.)
theorem intun (A2 B2: class):
  $ wceq (cint (cun A2 B2)) (cin (cint A2) (cint B2)) $;

--| The intersection of a pair is the intersection of its members. Theorem 71 of [Suppes] p. 42. (Contributed by NM, 14-Oct-1999.)
theorem intpr (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cint (cpr A2 B2)) (cin A2 B2) $;

--| The intersection of a pair is the intersection of its members. Closed form of ~ intpr . Theorem 71 of [Suppes] p. 42. (Contributed by FL, 27-Apr-2008.)
theorem intprg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (cint (cpr A2 B2)) (cin A2 B2)) $;

--| Intersection of a singleton. (Contributed by Stefan O'Rear, 22-Feb-2015.)
theorem intsng (A2 V: class):
  $ wi (wcel A2 V) (wceq (cint (csn A2)) A2) $;

--| The intersection of a singleton is its member. Theorem 70 of [Suppes] p. 41. (Contributed by NM, 29-Sep-2002.)
theorem intsn (A2: class):
  $ wcel A2 cvv $ >
  $ wceq (cint (csn A2)) A2 $;

--| The union and intersection of a singleton are equal. See also ~ eusn . (Contributed by Jim Kingdon, 14-Aug-2018.)
theorem uniintsnr {x3: setvar} (A2: class):
  $ wi (wex x3 (wceq A2 (csn (cv x3)))) (wceq (cuni A2) (cint A2)) $;

--| The union and the intersection of a class abstraction are equal if there is a unique satisfying value of ` ph ( x ) ` . (Contributed by Jim Kingdon, 14-Aug-2018.)
theorem uniintabim {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wceq (cuni (cab x3 ph)) (cint (cab x3 ph))) $;

--| Theorem joining a singleton to an intersection. (Contributed by NM, 29-Sep-2002.)
theorem intunsn (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wceq (cint (cun A2 (csn B2))) (cin (cint A2) B2) $;

--| Relative intersection of an empty set. (Contributed by Stefan O'Rear, 3-Apr-2015.)
theorem rint0 (A2 X: class):
  $ wi (wceq X c0) (wceq (cin A2 (cint X)) A2) $;

--| Membership in a restricted intersection. (Contributed by Stefan O'Rear, 3-Apr-2015.)
theorem elrint {y1: setvar} (A2: class y1) (B2 X: class):
  $ wb (wcel X (cin A2 (cint B2))) (wa (wcel X A2) (wral y1 (wcel X (cv y1)) B2)) $;

--| Membership in a restricted intersection. (Contributed by Stefan O'Rear, 3-Apr-2015.)
theorem elrint2 {y1: setvar} (A2: class y1) (B2 X: class):
  $ wi (wcel X A2) (wb (wcel X (cin A2 (cint B2))) (wral y1 (wcel X (cv y1)) B2)) $;

--| Extend class notation to include indexed union. Note: Historically (prior to 21-Oct-2005), set.mm used the notation ` U. x e. A B ` , with the same union symbol as ~ cuni . While that syntax was unambiguous, it did not allow for LALR parsing of the syntax constructions in set.mm. The new syntax uses as distinguished symbol ` U_ ` instead of ` U. ` and does allow LALR parsing. Thanks to Peter Backes for suggesting this change.
term ciun {x3: setvar} (A2 B2: class x3): class;

--| Extend class notation to include indexed intersection. Note: Historically (prior to 21-Oct-2005), set.mm used the notation ` |^| x e. A B ` , with the same intersection symbol as ~ cint . Although that syntax was unambiguous, it did not allow for LALR parsing of the syntax constructions in set.mm. The new syntax uses a distinguished symbol ` |^|_ ` instead of ` |^| ` and does allow LALR parsing. Thanks to Peter Backes for suggesting this change.
term ciin {x3: setvar} (A2 B2: class x3): class;

--| Define indexed union. Definition indexed union in [Stoll] p. 45. In most applications, ` A ` is independent of ` x ` (although this is not required by the definition), and ` B ` depends on ` x ` i.e. can be read informally as ` B ( x ) ` . We call ` x ` the index, ` A ` the index set, and ` B ` the indexed set. In most books, ` x e. A ` is written as a subscript or underneath a union symbol ` U. ` . We use a special union symbol ` U_ ` to make it easier to distinguish from plain class union. In many theorems, you will see that ` x ` and ` A ` are in the same distinct variable group (meaning ` A ` cannot depend on ` x ` ) and that ` B ` and ` x ` do not share a distinct variable group (meaning that can be thought of as ` B ( x ) ` i.e. can be substituted with a class expression containing ` x ` ). An alternate definition tying indexed union to ordinary union is ~ dfiun2 . Theorem ~ uniiun provides a definition of ordinary union in terms of indexed union. (Contributed by NM, 27-Jun-1998.)
axiom df_iun {x3 y1: setvar} (A2 B2: class x3):
  $ wceq (ciun x3 A2 B2) (cab y1 (wrex x3 (wcel (cv y1) B2) A2)) $;

--| Define indexed intersection. Definition of [Stoll] p. 45. See the remarks for its sibling operation of indexed union ~ df-iun . An alternate definition tying indexed intersection to ordinary intersection is ~ dfiin2 . Theorem ~ intiin provides a definition of ordinary intersection in terms of indexed intersection. (Contributed by NM, 27-Jun-1998.)
axiom df_iin {x3 y1: setvar} (A2 B2: class x3):
  $ wceq (ciin x3 A2 B2) (cab y1 (wral x3 (wcel (cv y1) B2) A2)) $;

--| Membership in indexed union. (Contributed by NM, 3-Sep-2003.)
theorem eliun {x3: setvar} (A2: class) (B2 C: class x3):
  $ wb (wcel A2 (ciun x3 B2 C)) (wrex x3 (wcel A2 C) B2) $;

--| Membership in indexed intersection. (Contributed by NM, 3-Sep-2003.)
theorem eliin {x3: setvar} (A2: class) (B2 C V: class x3):
  $ wi (wcel A2 V) (wb (wcel A2 (ciin x3 B2 C)) (wral x3 (wcel A2 C) B2)) $;

--| Commutation of indexed unions. (Contributed by NM, 18-Dec-2008.)
theorem iuncom {x3 y1: setvar} (A2: class x3) (B2: class y1) (C: class x3 y1):
  $ wceq (ciun x3 A2 (ciun y1 B2 C)) (ciun y1 B2 (ciun x3 A2 C)) $;

--| Commutation of union with indexed union. (Contributed by Mario Carneiro, 18-Jan-2014.)
theorem iuncom4 {x3: setvar} (A2 B2: class x3):
  $ wceq (ciun x3 A2 (cuni B2)) (cuni (ciun x3 A2 B2)) $;

--| Indexed union of a constant class, i.e. where ` B ` does not depend on ` x ` . (Contributed by Jim Kingdon, 15-Aug-2018.)
theorem iunconstm {x3: setvar} (A2 B2: class):
  $ wi (wex x3 (wcel (cv x3) A2)) (wceq (ciun x3 A2 B2) B2) $;

--| Indexed intersection of a constant class, i.e. where ` B ` does not depend on ` x ` . (Contributed by Jim Kingdon, 19-Dec-2018.)
theorem iinconstm {x3 y1: setvar} (A2: class) (B2: class y1):
  $ wi (wex y1 (wcel (cv y1) A2)) (wceq (ciin x3 A2 B2) B2) $;

--| Law combining indexed union with indexed intersection. Eq. 14 in [KuratowskiMostowski] p. 109. This theorem also appears as the last example at ~ http://en.wikipedia.org/wiki/Union%5F%28set%5Ftheory%29 . (Contributed by NM, 17-Aug-2004.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem iuniin {x3 y1: setvar} (A2: class x3) (B2: class y1) (C: class x3 y1):
  $ wss (ciun x3 A2 (ciin y1 B2 C)) (ciin y1 B2 (ciun x3 A2 C)) $;

--| Subclass theorem for indexed union. (Contributed by NM, 10-Dec-2004.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem iunss1 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wss A2 B2) (wss (ciun x3 A2 C) (ciun x3 B2 C)) $;

--| Subclass theorem for indexed union. (Contributed by NM, 24-Jan-2012.)
theorem iinss1 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wss A2 B2) (wss (ciin x3 B2 C) (ciin x3 A2 C)) $;

--| Equality theorem for indexed union. (Contributed by NM, 27-Jun-1998.)
theorem iuneq1 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wceq A2 B2) (wceq (ciun x3 A2 C) (ciun x3 B2 C)) $;

--| Equality theorem for restricted existential quantifier. (Contributed by NM, 27-Jun-1998.)
theorem iineq1 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wceq A2 B2) (wceq (ciin x3 A2 C) (ciin x3 B2 C)) $;

--| Subclass theorem for indexed union. (Contributed by NM, 26-Nov-2003.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem ss2iun {x3: setvar} (A2 B2 C: class x3):
  $ wi (wral x3 (wss B2 C) A2) (wss (ciun x3 A2 B2) (ciun x3 A2 C)) $;

--| Equality theorem for indexed union. (Contributed by NM, 22-Oct-2003.)
theorem iuneq2 {x3: setvar} (A2 B2 C: class x3):
  $ wi (wral x3 (wceq B2 C) A2) (wceq (ciun x3 A2 B2) (ciun x3 A2 C)) $;

--| Equality theorem for indexed intersection. (Contributed by NM, 22-Oct-2003.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem iineq2 {x3: setvar} (A2 B2 C: class x3):
  $ wi (wral x3 (wceq B2 C) A2) (wceq (ciin x3 A2 B2) (ciin x3 A2 C)) $;

--| Equality inference for indexed union. (Contributed by NM, 22-Oct-2003.)
theorem iuneq2i {x3: setvar} (A2 B2 C: class x3):
  $ wi (wcel (cv x3) A2) (wceq B2 C) $ >
  $ wceq (ciun x3 A2 B2) (ciun x3 A2 C) $;

--| Equality inference for indexed intersection. (Contributed by NM, 22-Oct-2003.)
theorem iineq2i {x3: setvar} (A2 B2 C: class x3):
  $ wi (wcel (cv x3) A2) (wceq B2 C) $ >
  $ wceq (ciin x3 A2 B2) (ciin x3 A2 C) $;

--| Equality deduction for indexed intersection. (Contributed by NM, 7-Dec-2011.)
theorem iineq2d {x3: setvar} (ph: wff x3) (A2 B2 C: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wceq (ciin x3 A2 B2) (ciin x3 A2 C)) $;

--| Equality deduction for indexed union. (Contributed by NM, 3-Aug-2004.)
theorem iuneq2dv {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wceq (ciun x3 A2 B2) (ciun x3 A2 C)) $;

--| Equality deduction for indexed intersection. (Contributed by NM, 3-Aug-2004.)
theorem iineq2dv {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wceq (ciin x3 A2 B2) (ciin x3 A2 C)) $;

--| Equality theorem for indexed union, deduction version. (Contributed by Drahflow, 22-Oct-2015.)
theorem iuneq1d {x3: setvar} (ph: wff x3) (A2 B2: class) (C: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (ciun x3 A2 C) (ciun x3 B2 C)) $;

--| Equality deduction for indexed union, deduction version. (Contributed by Drahflow, 22-Oct-2015.)
theorem iuneq12d {x3: setvar} (ph: wff) (A2 B2: class) (C D: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (ciun x3 A2 C) (ciun x3 B2 D)) $;

--| Equality deduction for indexed union. (Contributed by Drahflow, 22-Oct-2015.)
theorem iuneq2d {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3):
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq (ciun x3 A2 B2) (ciun x3 A2 C)) $;

--| Bound-variable hypothesis builder for indexed union. (Contributed by Mario Carneiro, 25-Jan-2014.)
theorem nfiunxy {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc y1 (ciun x3 A2 B2) $;

--| Bound-variable hypothesis builder for indexed intersection. (Contributed by Mario Carneiro, 25-Jan-2014.)
theorem nfiinxy {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc y1 (ciin x3 A2 B2) $;

--| Bound-variable hypothesis builder for indexed union. (Contributed by Mario Carneiro, 25-Jan-2014.)
theorem nfiunya {x3 y1: setvar} (A2: class y1) (B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc y1 (ciun x3 A2 B2) $;

--| Bound-variable hypothesis builder for indexed intersection. (Contributed by Mario Carneiro, 25-Jan-2014.)
theorem nfiinya {x3 y1: setvar} (A2: class y1) (B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc y1 (ciin x3 A2 B2) $;

--| Bound-variable hypothesis builder for indexed union. (Contributed by NM, 12-Oct-2003.)
theorem nfiu1 {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 (ciun x3 A2 B2) $;

--| Bound-variable hypothesis builder for indexed intersection. (Contributed by NM, 15-Oct-2003.)
theorem nfii1 {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 (ciin x3 A2 B2) $;

--| Alternate definition of indexed union when ` B ` is a set. Definition 15(a) of [Suppes] p. 44. (Contributed by NM, 23-Mar-2006.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem dfiun2g {x3 y1: setvar} (A2 B2: class x3) (C: class x3 y1):
  $ wi (wral x3 (wcel B2 C) A2) (wceq (ciun x3 A2 B2) (cuni (cab y1 (wrex x3 (wceq (cv y1) B2) A2)))) $;

--| Alternate definition of indexed intersection when ` B ` is a set. (Contributed by Jeff Hankins, 27-Aug-2009.)
theorem dfiin2g {x3 y1: setvar} (A2 B2: class x3) (C: class x3 y1):
  $ wi (wral x3 (wcel B2 C) A2) (wceq (ciin x3 A2 B2) (cint (cab y1 (wrex x3 (wceq (cv y1) B2) A2)))) $;

--| Alternate definition of indexed union when ` B ` is a set. Definition 15(a) of [Suppes] p. 44. (Contributed by NM, 27-Jun-1998.) (Revised by David Abernethy, 19-Jun-2012.)
theorem dfiun2 {x3 y1: setvar} (A2 B2: class x3):
  $ wcel B2 cvv $ >
  $ wceq (ciun x3 A2 B2) (cuni (cab y1 (wrex x3 (wceq (cv y1) B2) A2))) $;

--| Alternate definition of indexed intersection when ` B ` is a set. Definition 15(b) of [Suppes] p. 44. (Contributed by NM, 28-Jun-1998.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem dfiin2 {x3 y1: setvar} (A2 B2: class x3):
  $ wcel B2 cvv $ >
  $ wceq (ciin x3 A2 B2) (cint (cab y1 (wrex x3 (wceq (cv y1) B2) A2))) $;

--| Define double indexed union. (Contributed by FL, 6-Nov-2013.)
theorem dfiunv2 {x3 y1 z: setvar} (A2 B2 C: class x3 y1):
  $ wceq (ciun x3 A2 (ciun y1 B2 C)) (cab z (wrex x3 (wrex y1 (wcel (cv z) C) B2) A2)) $;

--| Rule used to change the bound variables in an indexed union, with the substitution specified implicitly by the hypothesis. (Contributed by NM, 26-Mar-2006.) (Revised by Andrew Salmon, 25-Jul-2011.)
theorem cbviun {x3 y1: setvar} (A2: class) (B2 C: class x3 y1):
  $ wnfc y1 B2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (ciun x3 A2 B2) (ciun y1 A2 C) $;

--| Change bound variables in an indexed intersection. (Contributed by Jeff Hankins, 26-Aug-2009.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem cbviin {x3 y1: setvar} (A2: class) (B2 C: class x3 y1):
  $ wnfc y1 B2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (ciin x3 A2 B2) (ciin y1 A2 C) $;

--| Rule used to change the bound variables in an indexed union, with the substitution specified implicitly by the hypothesis. (Contributed by NM, 15-Sep-2003.)
theorem cbviunv {x3 y1: setvar} (A2: class) (B2: class x3) (C: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (ciun x3 A2 B2) (ciun y1 A2 C) $;

--| Change bound variables in an indexed intersection. (Contributed by Jeff Hankins, 26-Aug-2009.)
theorem cbviinv {x3 y1: setvar} (A2: class) (B2: class x3) (C: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (ciin x3 A2 B2) (ciin y1 A2 C) $;

--| Subset theorem for an indexed union. (Contributed by NM, 13-Sep-2003.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem iunss {x3: setvar} (A2 B2: class x3) (C: class):
  $ wb (wss (ciun x3 A2 B2) C) (wral x3 (wss B2 C) A2) $;

--| Subset implication for an indexed union. (Contributed by NM, 3-Sep-2003.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem ssiun {x3: setvar} (A2 B2: class x3) (C: class):
  $ wi (wrex x3 (wss C B2) A2) (wss C (ciun x3 A2 B2)) $;

--| Identity law for subset of an indexed union. (Contributed by NM, 12-Oct-2003.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem ssiun2 {x3: setvar} (A2 B2: class x3):
  $ wi (wcel (cv x3) A2) (wss B2 (ciun x3 A2 B2)) $;

--| Subset relationship for an indexed union. (Contributed by NM, 26-Oct-2003.)
theorem ssiun2s {x3: setvar} (A2: class) (B2: class x3) (C D: class):
  $ wi (wceq (cv x3) C) (wceq B2 D) $ >
  $ wi (wcel C A2) (wss D (ciun x3 A2 B2)) $;

--| A subclass condition on the members of two indexed classes ` C ( x ) ` and ` D ( y ) ` that implies a subclass relation on their indexed unions. Generalization of Proposition 8.6 of [TakeutiZaring] p. 59. Compare ~ uniss2 . (Contributed by NM, 9-Dec-2004.)
theorem iunss2 {x3 y1: setvar} (A2: class x3 y1) (B2: class y1) (C: class x3) (D: class y1):
  $ wi (wral x3 (wrex y1 (wss C D) B2) A2) (wss (ciun x3 A2 C) (ciun y1 B2 D)) $;

--| The indexed union of a class abstraction. (Contributed by NM, 27-Dec-2004.)
theorem iunab {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wceq (ciun x3 A2 (cab y1 ph)) (cab y1 (wrex x3 ph A2)) $;

--| The indexed union of a restricted class abstraction. (Contributed by NM, 3-Jan-2004.) (Proof shortened by Mario Carneiro, 14-Nov-2016.)
theorem iunrab {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wceq (ciun x3 A2 (crab y1 ph B2)) (crab y1 (wrex x3 ph A2) B2) $;

--| Indexed union with a class difference as its index. (Contributed by NM, 10-Dec-2004.)
theorem iunxdif2 {x3 y1: setvar} (A2 B2: class) (C: class x3) (D: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq C D) $ >
  $ wi (wral x3 (wrex y1 (wss C D) (cdif A2 B2)) A2) (wceq (ciun y1 (cdif A2 B2) D) (ciun x3 A2 C)) $;

--| Subset theorem for an indexed intersection. (Contributed by FL, 15-Oct-2012.) (Proof shortened by Mario Carneiro, 14-Oct-2016.)
theorem ssiinf {x3: setvar} (A2 B2 C: class x3):
  $ wnfc x3 C $ >
  $ wb (wss C (ciin x3 A2 B2)) (wral x3 (wss C B2) A2) $;

--| Subset theorem for an indexed intersection. (Contributed by NM, 15-Oct-2003.)
theorem ssiin {x3: setvar} (A2 B2: class x3) (C: class):
  $ wb (wss C (ciin x3 A2 B2)) (wral x3 (wss C B2) A2) $;

--| Subset implication for an indexed intersection. (Contributed by NM, 15-Oct-2003.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem iinss {x3: setvar} (A2 B2: class x3) (C: class):
  $ wi (wrex x3 (wss B2 C) A2) (wss (ciin x3 A2 B2) C) $;

--| An indexed intersection is included in any of its members. (Contributed by FL, 15-Oct-2012.)
theorem iinss2 {x3: setvar} (A2 B2: class x3):
  $ wi (wcel (cv x3) A2) (wss (ciin x3 A2 B2) B2) $;

--| Class union in terms of indexed union. Definition in [Stoll] p. 43. (Contributed by NM, 28-Jun-1998.)
theorem uniiun {x3: setvar} (A2: class):
  $ wceq (cuni A2) (ciun x3 A2 (cv x3)) $;

--| Class intersection in terms of indexed intersection. Definition in [Stoll] p. 44. (Contributed by NM, 28-Jun-1998.)
theorem intiin {x3: setvar} (A2: class):
  $ wceq (cint A2) (ciin x3 A2 (cv x3)) $;

--| An indexed union of singletons recovers the index set. (Contributed by NM, 6-Sep-2005.)
theorem iunid {x3: setvar} (A2: class):
  $ wceq (ciun x3 A2 (csn (cv x3))) A2 $;

--| An indexed union of the empty set is empty. (Contributed by NM, 26-Mar-2003.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem iun0 {x3: setvar} (A2: class x3):
  $ wceq (ciun x3 A2 c0) c0 $;

--| An empty indexed union is empty. (Contributed by NM, 4-Dec-2004.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem _0iun {x3: setvar} (A2: class x3):
  $ wceq (ciun x3 c0 A2) c0 $;

--| An empty indexed intersection is the universal class. (Contributed by NM, 20-Oct-2005.)
theorem _0iin {x3: setvar} (A2: class x3):
  $ wceq (ciin x3 c0 A2) cvv $;

--| Indexed intersection with a universal index class. (Contributed by NM, 11-Sep-2008.)
theorem viin {x3 y1: setvar} (A2: class x3):
  $ wceq (ciin x3 cvv A2) (cab y1 (wal x3 (wcel (cv y1) A2))) $;

--| There is an inhabited class in an indexed collection ` B ( x ) ` iff the indexed union of them is inhabited. (Contributed by Jim Kingdon, 16-Aug-2018.)
theorem iunn0m {x3 y1: setvar} (A2: class) (B2: class x3):
  $ wb (wrex x3 (wex y1 (wcel (cv y1) B2)) A2) (wex y1 (wcel (cv y1) (ciun x3 A2 B2))) $;

--| Indexed intersection of a class builder. (Contributed by NM, 6-Dec-2011.)
theorem iinab {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wceq (ciin x3 A2 (cab y1 ph)) (cab y1 (wral x3 ph A2)) $;

--| Indexed intersection of a restricted class builder. (Contributed by Jim Kingdon, 16-Aug-2018.)
theorem iinrabm {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (B2: class y1):
  $ wi (wex x3 (wcel (cv x3) A2)) (wceq (ciin x3 A2 (crab y1 ph B2)) (crab y1 (wral x3 ph A2) B2)) $;

--| Indexed union of intersection. Generalization of half of theorem "Distributive laws" in [Enderton] p. 30. Use ~ uniiun to recover Enderton's theorem. (Contributed by NM, 26-Mar-2004.)
theorem iunin2 {x3: setvar} (A2: class x3) (B2: class) (C: class x3):
  $ wceq (ciun x3 A2 (cin B2 C)) (cin B2 (ciun x3 A2 C)) $;

--| Indexed union of intersection. Generalization of half of theorem "Distributive laws" in [Enderton] p. 30. Use ~ uniiun to recover Enderton's theorem. (Contributed by Mario Carneiro, 30-Aug-2015.)
theorem iunin1 {x3: setvar} (A2: class x3) (B2: class) (C: class x3):
  $ wceq (ciun x3 A2 (cin C B2)) (cin (ciun x3 A2 C) B2) $;

--| Indexed union of class difference. Compare to theorem "De Morgan's laws" in [Enderton] p. 31. (Contributed by Jim Kingdon, 17-Aug-2018.)
theorem iundif2ss {x3: setvar} (A2: class x3) (B2: class) (C: class x3):
  $ wss (ciun x3 A2 (cdif B2 C)) (cdif B2 (ciin x3 A2 C)) $;

--| Rearrange indexed unions over intersection. (Contributed by NM, 18-Dec-2008.)
theorem _2iunin {x3 y1: setvar} (A2: class x3 y1) (B2: class y1) (C: class x3) (D: class y1):
  $ wceq (ciun x3 A2 (ciun y1 B2 (cin C D))) (cin (ciun x3 A2 C) (ciun y1 B2 D)) $;

--| Indexed intersection of class difference. Compare to Theorem "De Morgan's laws" in [Enderton] p. 31. (Contributed by Jim Kingdon, 17-Aug-2018.)
theorem iindif2m {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wex x3 (wcel (cv x3) A2)) (wceq (ciin x3 A2 (cdif B2 C)) (cdif B2 (ciun x3 A2 C))) $;

--| Indexed intersection of intersection. Compare to Theorem "Distributive laws" in [Enderton] p. 30. (Contributed by Jim Kingdon, 17-Aug-2018.)
theorem iinin2m {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wex x3 (wcel (cv x3) A2)) (wceq (ciin x3 A2 (cin B2 C)) (cin B2 (ciin x3 A2 C))) $;

--| Indexed intersection of intersection. Compare to Theorem "Distributive laws" in [Enderton] p. 30. (Contributed by Jim Kingdon, 17-Aug-2018.)
theorem iinin1m {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wex x3 (wcel (cv x3) A2)) (wceq (ciin x3 A2 (cin C B2)) (cin (ciin x3 A2 C) B2)) $;

--| Elementhood in a relative intersection. (Contributed by Mario Carneiro, 30-Dec-2016.)
theorem elriin {x3: setvar} (A2 B2: class) (S: class x3) (X: class):
  $ wb (wcel B2 (cin A2 (ciin x3 X S))) (wa (wcel B2 A2) (wral x3 (wcel B2 S) X)) $;

--| Relative intersection of an empty family. (Contributed by Stefan O'Rear, 3-Apr-2015.)
theorem riin0 {x3: setvar} (A2: class) (S: class x3) (X: class):
  $ wi (wceq X c0) (wceq (cin A2 (ciin x3 X S)) A2) $;

--| Relative intersection of an inhabited family. (Contributed by Jim Kingdon, 19-Aug-2018.)
theorem riinm {x3: setvar} (A2: class) (S: class x3) (X: class):
  $ wi (wa (wral x3 (wss S A2) X) (wex x3 (wcel (cv x3) X))) (wceq (cin A2 (ciin x3 X S)) (ciin x3 X S)) $;

--| A singleton index picks out an instance of an indexed intersection's argument. (Contributed by NM, 15-Jan-2012.) (Proof shortened by Mario Carneiro, 17-Nov-2016.)
theorem iinxsng {x3: setvar} (A2: class) (B2: class x3) (C: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi (wcel A2 V) (wceq (ciin x3 (csn A2) B2) C) $;

--| Indexed intersection with an unordered pair index. (Contributed by NM, 25-Jan-2012.)
theorem iinxprg {x3: setvar} (A2 B2: class) (C: class x3) (D E: class) (V W: class x3):
  $ wi (wceq (cv x3) A2) (wceq C D) $ >
  $ wi (wceq (cv x3) B2) (wceq C E) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (ciin x3 (cpr A2 B2) C) (cin D E)) $;

--| A singleton index picks out an instance of an indexed union's argument. (Contributed by Mario Carneiro, 25-Jun-2016.)
theorem iunxsng {x3: setvar} (A2: class) (B2: class x3) (C: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi (wcel A2 V) (wceq (ciun x3 (csn A2) B2) C) $;

--| A singleton index picks out an instance of an indexed union's argument. (Contributed by NM, 26-Mar-2004.) (Proof shortened by Mario Carneiro, 25-Jun-2016.)
theorem iunxsn {x3: setvar} (A2: class) (B2: class x3) (C: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq (ciun x3 (csn A2) B2) C $;

--| Separate a union in an indexed union. (Contributed by NM, 27-Dec-2004.) (Proof shortened by Mario Carneiro, 17-Nov-2016.)
theorem iunun {x3: setvar} (A2 B2 C: class x3):
  $ wceq (ciun x3 A2 (cun B2 C)) (cun (ciun x3 A2 B2) (ciun x3 A2 C)) $;

--| Separate a union in the index of an indexed union. (Contributed by NM, 26-Mar-2004.) (Proof shortened by Mario Carneiro, 17-Nov-2016.)
theorem iunxun {x3: setvar} (A2 B2 C: class x3):
  $ wceq (ciun x3 (cun A2 B2) C) (cun (ciun x3 A2 C) (ciun x3 B2 C)) $;

--| Separate an indexed union in the index of an indexed union. (Contributed by Mario Carneiro, 5-Dec-2016.)
theorem iunxiun {x3 y1: setvar} (A2: class y1) (B2: class x3 y1) (C: class x3):
  $ wceq (ciun x3 (ciun y1 A2 B2) C) (ciun y1 A2 (ciun x3 B2 C)) $;

--| A relationship involving union and indexed intersection. Exercise 23 of [Enderton] p. 33 but with equality changed to subset. (Contributed by Jim Kingdon, 19-Aug-2018.)
theorem iinuniss {x3: setvar} (A2 B2: class):
  $ wss (cun A2 (cint B2)) (ciin x3 B2 (cun A2 (cv x3))) $;

--| A relationship involving union and indexed union. Exercise 25 of [Enderton] p. 33 but with biconditional changed to implication. (Contributed by Jim Kingdon, 19-Aug-2018.)
theorem iununir {x3: setvar} (A2 B2: class):
  $ wi (wceq (cun A2 (cuni B2)) (ciun x3 B2 (cun A2 (cv x3)))) (wi (wceq B2 c0) (wceq A2 c0)) $;

--| Subclass relationship for power class and union. (Contributed by NM, 18-Jul-2006.)
theorem sspwuni (A2 B2: class):
  $ wb (wss A2 (cpw B2)) (wss (cuni A2) B2) $;

--| Two ways to express a collection of subclasses. (Contributed by NM, 19-Jul-2006.)
theorem pwssb {x3: setvar} (A2 B2: class):
  $ wb (wss A2 (cpw B2)) (wral x3 (wss (cv x3) B2) A2) $;

--| Relationship for power class and union. (Contributed by NM, 18-Jul-2006.)
theorem elpwuni (A2 B2: class):
  $ wi (wcel B2 A2) (wb (wss A2 (cpw B2)) (wceq (cuni A2) B2)) $;

--| The power class of an intersection in terms of indexed intersection. Exercise 24(a) of [Enderton] p. 33. (Contributed by NM, 29-Nov-2003.)
theorem iinpw {x3: setvar} (A2: class):
  $ wceq (cpw (cint A2)) (ciin x3 A2 (cpw (cv x3))) $;

--| Inclusion of an indexed union of a power class in the power class of the union of its index. Part of Exercise 24(b) of [Enderton] p. 33. (Contributed by NM, 25-Nov-2003.)
theorem iunpwss {x3: setvar} (A2: class):
  $ wss (ciun x3 A2 (cpw (cv x3))) (cpw (cuni A2)) $;

--| Relative intersection of an inhabited class. (Contributed by Jim Kingdon, 19-Aug-2018.)
theorem rintm {x3: setvar} (A2: class x3) (X: class):
  $ wi (wa (wss X (cpw A2)) (wex x3 (wcel (cv x3) X))) (wceq (cin A2 (cint X)) (cint X)) $;

--| Extend wff notation to include the statement that a family of classes ` B ( x ) ` , for ` x e. A ` , is a disjoint family.
term wdisj {x3: setvar} (A2 B2: class x3): wff;

--| A collection of classes ` B ( x ) ` is disjoint when for each element ` y ` , it is in ` B ( x ) ` for at most one ` x ` . (Contributed by Mario Carneiro, 14-Nov-2016.) (Revised by NM, 16-Jun-2017.)
axiom df_disj {x3 y1: setvar} (A2 B2: class x3):
  $ wb (wdisj x3 A2 B2) (wal y1 (wrmo x3 (wcel (cv y1) B2) A2)) $;

--| Alternate definition for disjoint classes. (Contributed by NM, 17-Jun-2017.)
theorem dfdisj2 {x3 y1: setvar} (A2 B2: class x3):
  $ wb (wdisj x3 A2 B2) (wal y1 (wmo x3 (wa (wcel (cv x3) A2) (wcel (cv y1) B2)))) $;

--| If each element of a collection is contained in a disjoint collection, the original collection is also disjoint. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjss2 {x3: setvar} (A2 B2 C: class x3):
  $ wi (wral x3 (wss B2 C) A2) (wi (wdisj x3 A2 C) (wdisj x3 A2 B2)) $;

--| Equality theorem for disjoint collection. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjeq2 {x3: setvar} (A2 B2 C: class x3):
  $ wi (wral x3 (wceq B2 C) A2) (wb (wdisj x3 A2 B2) (wdisj x3 A2 C)) $;

--| Equality deduction for disjoint collection. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjeq2dv {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wb (wdisj x3 A2 B2) (wdisj x3 A2 C)) $;

--| A subset of a disjoint collection is disjoint. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjss1 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wss A2 B2) (wi (wdisj x3 B2 C) (wdisj x3 A2 C)) $;

--| Equality theorem for disjoint collection. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjeq1 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wceq A2 B2) (wb (wdisj x3 A2 C) (wdisj x3 B2 C)) $;

--| Equality theorem for disjoint collection. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjeq1d {x3: setvar} (ph: wff x3) (A2 B2: class) (C: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wdisj x3 A2 C) (wdisj x3 B2 C)) $;

--| Equality theorem for disjoint collection. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjeq12d {x3: setvar} (ph: wff) (A2 B2: class) (C D: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wdisj x3 A2 C) (wdisj x3 B2 D)) $;

--| Change bound variables in a disjoint collection. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem cbvdisj {x3 y1: setvar} (A2: class) (B2 C: class x3 y1):
  $ wnfc y1 B2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wb (wdisj x3 A2 B2) (wdisj y1 A2 C) $;

--| Change bound variables in a disjoint collection. (Contributed by Mario Carneiro, 11-Dec-2016.)
theorem cbvdisjv {x3 y1: setvar} (A2: class) (B2: class x3) (C: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wb (wdisj x3 A2 B2) (wdisj y1 A2 C) $;

--| Bound-variable hypothesis builder for disjoint collection. (Contributed by Jim Kingdon, 19-Aug-2018.)
theorem nfdisjv {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnf y1 (wdisj x3 A2 B2) $;

--| Bound-variable hypothesis builder for disjoint collection. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem nfdisj1 {x3: setvar} (A2 B2: class x3):
  $ wnf x3 (wdisj x3 A2 B2) $;

--| If there is a function ` C ( y ) ` such that ` C ( y ) = x ` for all ` y e. B ( x ) ` , then the sets ` B ( x ) ` for distinct ` x e. A ` are disjoint. (Contributed by Mario Carneiro, 10-Dec-2016.)
theorem invdisj {x3 y1: setvar} (A2 B2: class x3) (C: class y1):
  $ wi (wral x3 (wral y1 (wceq C (cv x3)) B2) A2) (wdisj x3 A2 B2) $;

--| Any collection of singletons is disjoint. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem sndisj {x3: setvar} (A2: class x3):
  $ wdisj x3 A2 (csn (cv x3)) $;

--| Any collection of empty sets is disjoint. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem _0disj {x3: setvar} (A2: class x3):
  $ wdisj x3 A2 c0 $;

--| A singleton collection is disjoint. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjxsn {x3: setvar} (A2: class) (B2: class x3):
  $ wdisj x3 (csn A2) B2 $;

--| An empty collection is disjoint. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjx0 {x3: setvar} (B2: class x3):
  $ wdisj x3 c0 B2 $;

--| Extend wff notation to include the general binary relation predicate. Note that the syntax is simply three class symbols in a row. Since binary relations are the only possible wff expressions consisting of three class expressions in a row, the syntax is unambiguous.
term wbr (A2 B2 R: class): wff;

--| Define a general binary relation. Note that the syntax is simply three class symbols in a row. Definition 6.18 of [TakeutiZaring] p. 29 generalized to arbitrary classes. This definition of relations is well-defined, although not very meaningful, when classes ` A ` and/or ` B ` are proper classes (i.e. are not sets). On the other hand, we often find uses for this definition when ` R ` is a proper class (see for example ~ iprc ). (Contributed by NM, 31-Dec-1993.)
axiom df_br (A2 B2 R: class):
  $ wb (wbr A2 B2 R) (wcel (cop A2 B2) R) $;

--| Equality theorem for binary relations. (Contributed by NM, 4-Jun-1995.)
theorem breq (A2 B2 R S: class):
  $ wi (wceq R S) (wb (wbr A2 B2 R) (wbr A2 B2 S)) $;

--| Equality theorem for a binary relation. (Contributed by NM, 31-Dec-1993.)
theorem breq1 (A2 B2 C R: class):
  $ wi (wceq A2 B2) (wb (wbr A2 C R) (wbr B2 C R)) $;

--| Equality theorem for a binary relation. (Contributed by NM, 31-Dec-1993.)
theorem breq2 (A2 B2 C R: class):
  $ wi (wceq A2 B2) (wb (wbr C A2 R) (wbr C B2 R)) $;

--| Equality theorem for a binary relation. (Contributed by NM, 8-Feb-1996.)
theorem breq12 (A2 B2 C D R: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wb (wbr A2 C R) (wbr B2 D R)) $;

--| Equality inference for binary relations. (Contributed by NM, 19-Feb-2005.)
theorem breqi (A2 B2 R S: class):
  $ wceq R S $ >
  $ wb (wbr A2 B2 R) (wbr A2 B2 S) $;

--| Equality inference for a binary relation. (Contributed by NM, 8-Feb-1996.)
theorem breq1i (A2 B2 C R: class):
  $ wceq A2 B2 $ >
  $ wb (wbr A2 C R) (wbr B2 C R) $;

--| Equality inference for a binary relation. (Contributed by NM, 8-Feb-1996.)
theorem breq2i (A2 B2 C R: class):
  $ wceq A2 B2 $ >
  $ wb (wbr C A2 R) (wbr C B2 R) $;

--| Equality inference for a binary relation. (Contributed by NM, 8-Feb-1996.) (Proof shortened by Eric Schmidt, 4-Apr-2007.)
theorem breq12i (A2 B2 C D R: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wb (wbr A2 C R) (wbr B2 D R) $;

--| Equality deduction for a binary relation. (Contributed by NM, 8-Feb-1996.)
theorem breq1d (ph: wff) (A2 B2 C R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wbr A2 C R) (wbr B2 C R)) $;

--| Equality deduction for a binary relation. (Contributed by NM, 29-Oct-2011.)
theorem breqd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wbr C D A2) (wbr C D B2)) $;

--| Equality deduction for a binary relation. (Contributed by NM, 8-Feb-1996.)
theorem breq2d (ph: wff) (A2 B2 C R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wbr C A2 R) (wbr C B2 R)) $;

--| Equality deduction for a binary relation. (Contributed by NM, 8-Feb-1996.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem breq12d (ph: wff) (A2 B2 C D R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wbr A2 C R) (wbr B2 D R)) $;

--| Equality deduction for a binary relation. (Contributed by NM, 29-Oct-2011.)
theorem breq123d (ph: wff) (A2 B2 C D R S: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq R S) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wbr A2 C R) (wbr B2 D S)) $;

--| Equality deduction for a binary relation. (Contributed by NM, 8-Feb-1996.)
theorem breqan12d (ph ps: wff) (A2 B2 C D R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ps (wceq C D) $ >
  $ wi (wa ph ps) (wb (wbr A2 C R) (wbr B2 D R)) $;

--| Equality deduction for a binary relation. (Contributed by NM, 8-Feb-1996.)
theorem breqan12rd (ph ps: wff) (A2 B2 C D R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ps (wceq C D) $ >
  $ wi (wa ps ph) (wb (wbr A2 C R) (wbr B2 D R)) $;

--| Two classes are different if they don't have the same relationship to a third class. (Contributed by NM, 3-Jun-2012.)
theorem nbrne1 (A2 B2 C R: class):
  $ wi (wa (wbr A2 B2 R) (wn (wbr A2 C R))) (wne B2 C) $;

--| Two classes are different if they don't have the same relationship to a third class. (Contributed by NM, 3-Jun-2012.)
theorem nbrne2 (A2 B2 C R: class):
  $ wi (wa (wbr A2 C R) (wn (wbr B2 C R))) (wne A2 B2) $;

--| Substitution of equal classes into a binary relation. (Contributed by NM, 5-Aug-1993.)
theorem eqbrtri (A2 B2 C R: class):
  $ wceq A2 B2 $ >
  $ wbr B2 C R $ >
  $ wbr A2 C R $;

--| Substitution of equal classes into a binary relation. (Contributed by NM, 8-Oct-1999.)
theorem eqbrtrd (ph: wff) (A2 B2 C R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wbr B2 C R) $ >
  $ wi ph (wbr A2 C R) $;

--| Substitution of equal classes into a binary relation. (Contributed by NM, 5-Aug-1993.)
theorem eqbrtrri (A2 B2 C R: class):
  $ wceq A2 B2 $ >
  $ wbr A2 C R $ >
  $ wbr B2 C R $;

--| Substitution of equal classes into a binary relation. (Contributed by NM, 24-Oct-1999.)
theorem eqbrtrrd (ph: wff) (A2 B2 C R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wbr A2 C R) $ >
  $ wi ph (wbr B2 C R) $;

--| Substitution of equal classes into a binary relation. (Contributed by NM, 5-Aug-1993.)
theorem breqtri (A2 B2 C R: class):
  $ wbr A2 B2 R $ >
  $ wceq B2 C $ >
  $ wbr A2 C R $;

--| Substitution of equal classes into a binary relation. (Contributed by NM, 24-Oct-1999.)
theorem breqtrd (ph: wff) (A2 B2 C R: class):
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wbr A2 C R) $;

--| Substitution of equal classes into a binary relation. (Contributed by NM, 5-Aug-1993.)
theorem breqtrri (A2 B2 C R: class):
  $ wbr A2 B2 R $ >
  $ wceq C B2 $ >
  $ wbr A2 C R $;

--| Substitution of equal classes into a binary relation. (Contributed by NM, 24-Oct-1999.)
theorem breqtrrd (ph: wff) (A2 B2 C R: class):
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wceq C B2) $ >
  $ wi ph (wbr A2 C R) $;

--| Substitution of equality into both sides of a binary relation. (Contributed by NM, 11-Aug-1999.)
theorem _3brtr3i (A2 B2 C D R: class):
  $ wbr A2 B2 R $ >
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wbr C D R $;

--| Substitution of equality into both sides of a binary relation. (Contributed by NM, 11-Aug-1999.)
theorem _3brtr4i (A2 B2 C D R: class):
  $ wbr A2 B2 R $ >
  $ wceq C A2 $ >
  $ wceq D B2 $ >
  $ wbr C D R $;

--| Substitution of equality into both sides of a binary relation. (Contributed by NM, 18-Oct-1999.)
theorem _3brtr3d (ph: wff) (A2 B2 C D R: class):
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wbr C D R) $;

--| Substitution of equality into both sides of a binary relation. (Contributed by NM, 21-Feb-2005.)
theorem _3brtr4d (ph: wff) (A2 B2 C D R: class):
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wceq C A2) $ >
  $ wi ph (wceq D B2) $ >
  $ wi ph (wbr C D R) $;

--| Substitution of equality into both sides of a binary relation. (Contributed by NM, 16-Jan-1997.)
theorem _3brtr3g (ph: wff) (A2 B2 C D R: class):
  $ wi ph (wbr A2 B2 R) $ >
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wi ph (wbr C D R) $;

--| Substitution of equality into both sides of a binary relation. (Contributed by NM, 16-Jan-1997.)
theorem _3brtr4g (ph: wff) (A2 B2 C D R: class):
  $ wi ph (wbr A2 B2 R) $ >
  $ wceq C A2 $ >
  $ wceq D B2 $ >
  $ wi ph (wbr C D R) $;

--| B chained equality inference for a binary relation. (Contributed by NM, 11-Oct-1999.)
theorem syl5eqbr (ph: wff) (A2 B2 C R: class):
  $ wceq A2 B2 $ >
  $ wi ph (wbr B2 C R) $ >
  $ wi ph (wbr A2 C R) $;

--| B chained equality inference for a binary relation. (Contributed by NM, 17-Sep-2004.)
theorem syl5eqbrr (ph: wff) (A2 B2 C R: class):
  $ wceq B2 A2 $ >
  $ wi ph (wbr B2 C R) $ >
  $ wi ph (wbr A2 C R) $;

--| B chained equality inference for a binary relation. (Contributed by NM, 11-Oct-1999.)
theorem syl5breq (ph: wff) (A2 B2 C R: class):
  $ wbr A2 B2 R $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wbr A2 C R) $;

--| B chained equality inference for a binary relation. (Contributed by NM, 24-Apr-2005.)
theorem syl5breqr (ph: wff) (A2 B2 C R: class):
  $ wbr A2 B2 R $ >
  $ wi ph (wceq C B2) $ >
  $ wi ph (wbr A2 C R) $;

--| A chained equality inference for a binary relation. (Contributed by NM, 12-Oct-1999.)
theorem syl6eqbr (ph: wff) (A2 B2 C R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wbr B2 C R $ >
  $ wi ph (wbr A2 C R) $;

--| A chained equality inference for a binary relation. (Contributed by NM, 4-Jan-2006.)
theorem syl6eqbrr (ph: wff) (A2 B2 C R: class):
  $ wi ph (wceq B2 A2) $ >
  $ wbr B2 C R $ >
  $ wi ph (wbr A2 C R) $;

--| A chained equality inference for a binary relation. (Contributed by NM, 11-Oct-1999.)
theorem syl6breq (ph: wff) (A2 B2 C R: class):
  $ wi ph (wbr A2 B2 R) $ >
  $ wceq B2 C $ >
  $ wi ph (wbr A2 C R) $;

--| A chained equality inference for a binary relation. (Contributed by NM, 24-Apr-2005.)
theorem syl6breqr (ph: wff) (A2 B2 C R: class):
  $ wi ph (wbr A2 B2 R) $ >
  $ wceq C B2 $ >
  $ wi ph (wbr A2 C R) $;

--| Deduction from a subclass relationship of binary relations. (Contributed by NM, 30-Apr-2004.)
theorem ssbrd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wi (wbr C D A2) (wbr C D B2)) $;

--| Inference from a subclass relationship of binary relations. (Contributed by NM, 28-Mar-2007.) (Revised by Mario Carneiro, 8-Feb-2015.)
theorem ssbri (A2 B2 C D: class):
  $ wss A2 B2 $ >
  $ wi (wbr C D A2) (wbr C D B2) $;

--| Deduction version of bound-variable hypothesis builder ~ nfbr . (Contributed by NM, 13-Dec-2005.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem nfbrd {x3: setvar} (ph: wff x3) (A2 B2 R: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 R) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnf x3 (wbr A2 B2 R)) $;

--| Bound-variable hypothesis builder for binary relation. (Contributed by NM, 1-Sep-1999.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem nfbr {x3: setvar} (A2 B2 R: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 R $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wbr A2 B2 R) $;

--| Relationship between a binary relation and a class abstraction. (Contributed by Andrew Salmon, 8-Jul-2011.)
theorem brab1 {x3 z: setvar} (A2 R: class x3):
  $ wb (wbr (cv x3) A2 R) (wcel (cv x3) (cab z (wbr (cv z) A2 R))) $;

--| The union of two binary relations. (Contributed by NM, 21-Dec-2008.)
theorem brun (A2 B2 R S: class):
  $ wb (wbr A2 B2 (cun R S)) (wo (wbr A2 B2 R) (wbr A2 B2 S)) $;

--| The intersection of two relations. (Contributed by FL, 7-Oct-2008.)
theorem brin (A2 B2 R S: class):
  $ wb (wbr A2 B2 (cin R S)) (wa (wbr A2 B2 R) (wbr A2 B2 S)) $;

--| The difference of two binary relations. (Contributed by Scott Fenton, 11-Apr-2011.)
theorem brdif (A2 B2 R S: class):
  $ wb (wbr A2 B2 (cdif R S)) (wa (wbr A2 B2 R) (wn (wbr A2 B2 S))) $;

--| Move substitution in and out of a binary relation. (Contributed by NM, 13-Dec-2005.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem sbcbrg {x3: setvar} (A2 B2 C D R: class x3):
  $ wi (wcel A2 D) (wb (wsbc x3 (wbr B2 C R) A2) (wbr (csb x3 A2 B2) (csb x3 A2 C) (csb x3 A2 R))) $;

--| Move substitution in and out of a binary relation. (Contributed by NM, 13-Dec-2005.)
theorem sbcbr12g {x3: setvar} (A2 B2 C D: class x3) (R: class):
  $ wi (wcel A2 D) (wb (wsbc x3 (wbr B2 C R) A2) (wbr (csb x3 A2 B2) (csb x3 A2 C) R)) $;

--| Move substitution in and out of a binary relation. (Contributed by NM, 13-Dec-2005.)
theorem sbcbr1g {x3: setvar} (A2 B2: class x3) (C: class) (D: class x3) (R: class):
  $ wi (wcel A2 D) (wb (wsbc x3 (wbr B2 C R) A2) (wbr (csb x3 A2 B2) C R)) $;

--| Move substitution in and out of a binary relation. (Contributed by NM, 13-Dec-2005.)
theorem sbcbr2g {x3: setvar} (A2: class x3) (B2: class) (C D: class x3) (R: class):
  $ wi (wcel A2 D) (wb (wsbc x3 (wbr B2 C R) A2) (wbr B2 (csb x3 A2 C) R)) $;

--| Extend class notation to include ordered-pair class abstraction (class builder).
term copab {x3 y1: setvar} (ph: wff x3 y1): class;

--| Extend the definition of a class to include maps-to notation for defining a function via a rule.
term cmpt {x3: setvar} (A2 B2: class x3): class;

--| Define the class abstraction of a collection of ordered pairs. Definition 3.3 of [Monk1] p. 34. Usually ` x ` and ` y ` are distinct, although the definition doesn't strictly require it. The brace notation is called "class abstraction" by Quine; it is also (more commonly) called a "class builder" in the literature. (Contributed by NM, 4-Jul-1994.)
axiom df_opab {x3 y1 z: setvar} (ph: wff x3 y1):
  $ wceq (copab x3 y1 ph) (cab z (wex x3 (wex y1 (wa (wceq (cv z) (cop (cv x3) (cv y1))) ph)))) $;

--| Define maps-to notation for defining a function via a rule. Read as "the function defined by the map from ` x ` (in ` A ` ) to ` B ( x ) ` ." The class expression ` B ` is the value of the function at ` x ` and normally contains the variable ` x ` . Similar to the definition of mapping in [ChoquetDD] p. 2. (Contributed by NM, 17-Feb-2008.)
axiom df_mpt {x3 y1: setvar} (A2 B2: class x3):
  $ wceq (cmpt x3 A2 B2) (copab x3 y1 (wa (wcel (cv x3) A2) (wceq (cv y1) B2))) $;

--| The collection of ordered pairs in a class is a subclass of it. (Contributed by NM, 27-Dec-1996.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem opabss {x3 y1: setvar} (R: class):
  $ wss (copab x3 y1 (wbr (cv x3) (cv y1) R)) R $;

--| Equivalent wff's yield equal ordered-pair class abstractions (deduction rule). (Contributed by NM, 21-Feb-2004.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem opabbid {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (copab x3 y1 ps) (copab x3 y1 ch)) $;

--| Equivalent wff's yield equal ordered-pair class abstractions (deduction rule). (Contributed by NM, 15-May-1995.)
theorem opabbidv {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (copab x3 y1 ps) (copab x3 y1 ch)) $;

--| Equivalent wff's yield equal class abstractions. (Contributed by NM, 15-May-1995.)
theorem opabbii {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb ph ps $ >
  $ wceq (copab x3 y1 ph) (copab x3 y1 ps) $;

--| Bound-variable hypothesis builder for class abstraction. (Contributed by NM, 1-Sep-1999.) (Unnecessary distinct variable restrictions were removed by Andrew Salmon, 11-Jul-2011.)
theorem nfopab {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wnf z ph $ >
  $ wnfc z (copab x3 y1 ph) $;

--| The first abstraction variable in an ordered-pair class abstraction (class builder) is effectively not free. (Contributed by NM, 16-May-1995.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem nfopab1 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnfc x3 (copab x3 y1 ph) $;

--| The second abstraction variable in an ordered-pair class abstraction (class builder) is effectively not free. (Contributed by NM, 16-May-1995.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem nfopab2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnfc y1 (copab x3 y1 ph) $;

--| Rule used to change bound variables in an ordered-pair class abstraction, using implicit substitution. (Contributed by NM, 14-Sep-2003.)
theorem cbvopab {x3 y1 z w: setvar} (ph ps: wff x3 y1 z w):
  $ wnf z ph $ >
  $ wnf w ph $ >
  $ wnf x3 ps $ >
  $ wnf y1 ps $ >
  $ wi (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) (wb ph ps) $ >
  $ wceq (copab x3 y1 ph) (copab z w ps) $;

--| Rule used to change bound variables in an ordered-pair class abstraction, using implicit substitution. (Contributed by NM, 15-Oct-1996.)
theorem cbvopabv {x3 y1 z w: setvar} (ph: wff x3 y1) (ps: wff z w):
  $ wi (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) (wb ph ps) $ >
  $ wceq (copab x3 y1 ph) (copab z w ps) $;

--| Change first bound variable in an ordered-pair class abstraction, using explicit substitution. (Contributed by NM, 6-Oct-2004.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem cbvopab1 {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wnf z ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv z)) (wb ph ps) $ >
  $ wceq (copab x3 y1 ph) (copab z y1 ps) $;

--| Change second bound variable in an ordered-pair class abstraction, using explicit substitution. (Contributed by NM, 22-Aug-2013.)
theorem cbvopab2 {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wnf z ph $ >
  $ wnf y1 ps $ >
  $ wi (wceq (cv y1) (cv z)) (wb ph ps) $ >
  $ wceq (copab x3 y1 ph) (copab x3 z ps) $;

--| Change first bound variable in an ordered-pair class abstraction, using explicit substitution. (Contributed by NM, 31-Jul-2003.)
theorem cbvopab1s {x3 y1 z: setvar} (ph: wff x3 y1):
  $ wceq (copab x3 y1 ph) (copab z y1 (wsb x3 z ph)) $;

--| Rule used to change the first bound variable in an ordered pair abstraction, using implicit substitution. (Contributed by NM, 31-Jul-2003.) (Proof shortened by Eric Schmidt, 4-Apr-2007.)
theorem cbvopab1v {x3 y1 z: setvar} (ph: wff x3 y1) (ps: wff y1 z):
  $ wi (wceq (cv x3) (cv z)) (wb ph ps) $ >
  $ wceq (copab x3 y1 ph) (copab z y1 ps) $;

--| Rule used to change the second bound variable in an ordered pair abstraction, using implicit substitution. (Contributed by NM, 2-Sep-1999.)
theorem cbvopab2v {x3 y1 z: setvar} (ph: wff x3 y1) (ps: wff x3 z):
  $ wi (wceq (cv y1) (cv z)) (wb ph ps) $ >
  $ wceq (copab x3 y1 ph) (copab x3 z ps) $;

--| Move substitution into a class abstraction. (Contributed by NM, 6-Aug-2007.) (Proof shortened by Mario Carneiro, 17-Nov-2016.)
theorem csbopabg {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class x3) (V: class x3 y1 z):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (copab y1 z ph)) (copab y1 z (wsbc x3 ph A2))) $;

--| Union of two ordered pair class abstractions. (Contributed by NM, 30-Sep-2002.)
theorem unopab {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wceq (cun (copab x3 y1 ph) (copab x3 y1 ps)) (copab x3 y1 (wo ph ps)) $;

--| An equality theorem for the maps to notation. (Contributed by Mario Carneiro, 16-Dec-2013.)
theorem mpteq12f {x3: setvar} (A2 B2 C D: class x3):
  $ wi (wa (wal x3 (wceq A2 C)) (wral x3 (wceq B2 D) A2)) (wceq (cmpt x3 A2 B2) (cmpt x3 C D)) $;

--| An equality inference for the maps to notation. (Contributed by Mario Carneiro, 26-Jan-2017.)
theorem mpteq12dva {x3: setvar} (ph: wff) (A2 B2 C D: class x3):
  $ wi ph (wceq A2 C) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 D) $ >
  $ wi ph (wceq (cmpt x3 A2 B2) (cmpt x3 C D)) $;

--| An equality inference for the maps to notation. (Contributed by NM, 24-Aug-2011.) (Revised by Mario Carneiro, 16-Dec-2013.)
theorem mpteq12dv {x3: setvar} (ph: wff) (A2 B2 C D: class x3):
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wceq (cmpt x3 A2 B2) (cmpt x3 C D)) $;

--| An equality theorem for the maps to notation. (Contributed by NM, 16-Dec-2013.)
theorem mpteq12 {x3: setvar} (A2: class) (B2: class x3) (C: class) (D: class x3):
  $ wi (wa (wceq A2 C) (wral x3 (wceq B2 D) A2)) (wceq (cmpt x3 A2 B2) (cmpt x3 C D)) $;

--| An equality theorem for the maps to notation. (Contributed by Mario Carneiro, 16-Dec-2013.)
theorem mpteq1 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wceq A2 B2) (wceq (cmpt x3 A2 C) (cmpt x3 B2 C)) $;

--| An equality theorem for the maps to notation. (Contributed by Mario Carneiro, 11-Jun-2016.)
theorem mpteq1d {x3: setvar} (ph: wff x3) (A2 B2: class) (C: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cmpt x3 A2 C) (cmpt x3 B2 C)) $;

--| An equality inference for the maps to notation. (Contributed by Mario Carneiro, 16-Dec-2013.)
theorem mpteq2ia {x3: setvar} (A2 B2 C: class x3):
  $ wi (wcel (cv x3) A2) (wceq B2 C) $ >
  $ wceq (cmpt x3 A2 B2) (cmpt x3 A2 C) $;

--| An equality inference for the maps to notation. (Contributed by Mario Carneiro, 16-Dec-2013.)
theorem mpteq2i {x3: setvar} (A2 B2 C: class x3):
  $ wceq B2 C $ >
  $ wceq (cmpt x3 A2 B2) (cmpt x3 A2 C) $;

--| An equality inference for the maps to notation. (Contributed by Scott Fenton, 27-Oct-2010.) (Revised by Mario Carneiro, 16-Dec-2013.)
theorem mpteq12i {x3: setvar} (A2 B2 C D: class x3):
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wceq (cmpt x3 A2 B2) (cmpt x3 C D) $;

--| Slightly more general equality inference for the maps to notation. (Contributed by FL, 14-Sep-2013.) (Revised by Mario Carneiro, 16-Dec-2013.)
theorem mpteq2da {x3: setvar} (ph: wff x3) (A2 B2 C: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wceq (cmpt x3 A2 B2) (cmpt x3 A2 C)) $;

--| Slightly more general equality inference for the maps to notation. (Contributed by Scott Fenton, 25-Apr-2012.)
theorem mpteq2dva {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wceq (cmpt x3 A2 B2) (cmpt x3 A2 C)) $;

--| An equality inference for the maps to notation. (Contributed by Mario Carneiro, 23-Aug-2014.)
theorem mpteq2dv {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq (cmpt x3 A2 B2) (cmpt x3 A2 C)) $;

--| Bound-variable hypothesis builder for the maps-to notation. (Contributed by NM, 20-Feb-2013.)
theorem nfmpt {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cmpt y1 A2 B2) $;

--| Bound-variable hypothesis builder for the maps-to notation. (Contributed by FL, 17-Feb-2008.)
theorem nfmpt1 {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 (cmpt x3 A2 B2) $;

--| Rule to change the bound variable in a maps-to function, using implicit substitution. This version has bound-variable hypotheses in place of distinct variable conditions. (Contributed by NM, 11-Sep-2011.)
theorem cbvmpt {x3 y1: setvar} (A2: class) (B2 C: class x3 y1):
  $ wnfc y1 B2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (cmpt x3 A2 B2) (cmpt y1 A2 C) $;

--| Rule to change the bound variable in a maps-to function, using implicit substitution. (Contributed by Mario Carneiro, 19-Feb-2013.)
theorem cbvmptv {x3 y1: setvar} (A2: class) (B2: class x3) (C: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (cmpt x3 A2 B2) (cmpt y1 A2 C) $;

--| Function with universal domain in maps-to notation. (Contributed by NM, 16-Aug-2013.)
theorem mptv {x3 y1: setvar} (B2: class x3):
  $ wceq (cmpt x3 cvv B2) (copab x3 y1 (wceq (cv y1) B2)) $;

--| Extend wff notation to include transitive classes. Notation from [TakeutiZaring] p. 35.
term wtr (A2: class): wff;

--| Define the transitive class predicate. Definition of [Enderton] p. 71 extended to arbitrary classes. For alternate definitions, see ~ dftr2 (which is suggestive of the word "transitive"), ~ dftr3 , ~ dftr4 , and ~ dftr5 . The term "complete" is used instead of "transitive" in Definition 3 of [Suppes] p. 130. (Contributed by NM, 29-Aug-1993.)
axiom df_tr (A2: class):
  $ wb (wtr A2) (wss (cuni A2) A2) $;

--| An alternate way of defining a transitive class. Exercise 7 of [TakeutiZaring] p. 40. (Contributed by NM, 24-Apr-1994.)
theorem dftr2 {x3 y1: setvar} (A2: class):
  $ wb (wtr A2) (wal x3 (wal y1 (wi (wa (wcel (cv x3) (cv y1)) (wcel (cv y1) A2)) (wcel (cv x3) A2)))) $;

--| An alternate way of defining a transitive class. (Contributed by NM, 20-Mar-2004.)
theorem dftr5 {x3 y1: setvar} (A2: class):
  $ wb (wtr A2) (wral x3 (wral y1 (wcel (cv y1) A2) (cv x3)) A2) $;

--| An alternate way of defining a transitive class. Definition 7.1 of [TakeutiZaring] p. 35. (Contributed by NM, 29-Aug-1993.)
theorem dftr3 {x3: setvar} (A2: class):
  $ wb (wtr A2) (wral x3 (wss (cv x3) A2) A2) $;

--| An alternate way of defining a transitive class. Definition of [Enderton] p. 71. (Contributed by NM, 29-Aug-1993.)
theorem dftr4 (A2: class):
  $ wb (wtr A2) (wss A2 (cpw A2)) $;

--| Equality theorem for the transitive class predicate. (Contributed by NM, 17-Sep-1993.)
theorem treq (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wtr A2) (wtr B2)) $;

--| In a transitive class, the membership relation is transitive. (Contributed by NM, 19-Apr-1994.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem trel (A2 B2 C: class):
  $ wi (wtr A2) (wi (wa (wcel B2 C) (wcel C A2)) (wcel B2 A2)) $;

--| In a transitive class, the membership relation is transitive. (Contributed by NM, 19-Apr-1994.)
theorem trel3 (A2 B2 C D: class):
  $ wi (wtr A2) (wi (w3a (wcel B2 C) (wcel C D) (wcel D A2)) (wcel B2 A2)) $;

--| An element of a transitive class is a subset of the class. (Contributed by NM, 7-Aug-1994.)
theorem trss (A2 B2: class):
  $ wi (wtr A2) (wi (wcel B2 A2) (wss B2 A2)) $;

--| The intersection of transitive classes is transitive. (Contributed by NM, 9-May-1994.)
theorem trin (A2 B2: class):
  $ wi (wa (wtr A2) (wtr B2)) (wtr (cin A2 B2)) $;

--| The empty set is transitive. (Contributed by NM, 16-Sep-1993.)
theorem tr0:
  $ wtr c0 $;

--| The universe is transitive. (Contributed by NM, 14-Sep-2003.)
theorem trv:
  $ wtr cvv $;

--| The indexed union of a class of transitive sets is transitive. (Contributed by Mario Carneiro, 16-Nov-2014.)
theorem triun {x3: setvar} (A2: class) (B2: class x3):
  $ wi (wral x3 (wtr B2) A2) (wtr (ciun x3 A2 B2)) $;

--| The union of a class of transitive sets is transitive. Exercise 5(a) of [Enderton] p. 73. (Contributed by Scott Fenton, 21-Feb-2011.) (Proof shortened by Mario Carneiro, 26-Apr-2014.)
theorem truni {x3: setvar} (A2: class):
  $ wi (wral x3 (wtr (cv x3)) A2) (wtr (cuni A2)) $;

--| The intersection of a class of transitive sets is transitive. Exercise 5(b) of [Enderton] p. 73. (Contributed by Scott Fenton, 25-Feb-2011.)
theorem trint {x3: setvar} (A2: class):
  $ wi (wral x3 (wtr (cv x3)) A2) (wtr (cint A2)) $;

--| If ` A ` is transitive and inhabited, then ` |^| A ` is a subset of ` A ` . (Contributed by Jim Kingdon, 22-Aug-2018.)
theorem trintssm {x3: setvar} (A2: class):
  $ wi (wa (wex x3 (wcel (cv x3) A2)) (wtr A2)) (wss (cint A2) A2) $;

--| Any inhabited transitive class includes its intersection. Similar to Exercise 2 in [TakeutiZaring] p. 44. (Contributed by Jim Kingdon, 22-Aug-2018.)
theorem trint0m {x3: setvar} (A2: class):
  $ wi (wa (wtr A2) (wex x3 (wcel (cv x3) A2))) (wss (cint A2) A2) $;

--| Axiom of Collection. Axiom 7 of [Crosilla], p. "Axioms of CZF and IZF" (with unnecessary quantifier removed). It is similar to ~ bnd but uses a freeness hypothesis in place of one of the distinct variable constraints. (Contributed by Jim Kingdon, 23-Aug-2018.)
axiom ax_coll {x3 y1 b: setvar} (ph: wff x3 y1 b) (a: setvar):
  $ wnf b ph $ >
  $ wi (wral x3 (wex y1 ph) (cv a)) (wex b (wral x3 (wrex y1 ph (cv b)) (cv a))) $;

--| Axiom of Replacement. Axiom 7' of [Crosilla], p. "Axioms of CZF and IZF" (with unnecessary quantifier removed). In our context this is not an axiom, but a theorem proved from ~ ax-coll . It is identical to ~ zfrep6 except for the choice of a freeness hypothesis rather than a distinct variable constraint between ` b ` and ` ph ` . (Contributed by Jim Kingdon, 23-Aug-2018.)
theorem repizf {x3 y1 b: setvar} (ph: wff x3 y1 b) (a: setvar):
  $ wnf b ph $ >
  $ wi (wral x3 (weu y1 ph) (cv a)) (wex b (wral x3 (wrex y1 ph (cv b)) (cv a))) $;

--| A version of the Axiom of Replacement. Normally ` ph ` would have free variables ` x ` and ` y ` . Axiom 6 of [Kunen] p. 12. The Separation Scheme ~ ax-sep cannot be derived from this version and must be stated as a separate axiom in an axiom system (such as Kunen's) that uses this version. (Contributed by NM, 10-Oct-2003.)
theorem zfrep6 {x3 y1 w: setvar} (ph: wff x3 y1) (z: setvar):
  $ wi (wral x3 (weu y1 ph) (cv z)) (wex w (wral x3 (wrex y1 ph (cv w)) (cv z))) $;

--| The Axiom of Separation of IZF set theory. Axiom 6 of [Crosilla], p. "Axioms of CZF and IZF" (with unnecessary quantifier removed, and with a ` F/ y ph ` condition replaced by a distinct variable constraint between ` y ` and ` ph ` ). The Separation Scheme is a weak form of Frege's Axiom of Comprehension, conditioning it (with ` x e. z ` ) so that it asserts the existence of a collection only if it is smaller than some other collection ` z ` that already exists. This prevents Russell's paradox ~ ru . In some texts, this scheme is called "Aussonderung" or the Subset Axiom. (Contributed by NM, 11-Sep-2006.)
axiom ax_sep {x3 y1: setvar} (ph: wff x3) (z: setvar):
  $ wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) (wa (wcel (cv x3) (cv z)) ph))) $;

--| A less restrictive version of the Separation Scheme ~ ax-sep , where variables ` x ` and ` z ` can both appear free in the wff ` ph ` , which can therefore be thought of as ` ph ( x , z ) ` . This version was derived from the more restrictive ~ ax-sep with no additional set theory axioms. (Contributed by NM, 10-Dec-2006.) (Proof shortened by Mario Carneiro, 17-Nov-2016.)
theorem axsep2 {x3 y1 z: setvar} (ph: wff x3 z):
  $ wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) (wa (wcel (cv x3) (cv z)) ph))) $;

--| Separation Scheme (Aussonderung) using a class variable. To derive this from ~ ax-sep , we invoke the Axiom of Extensionality (indirectly via ~ vtocl ), which is needed for the justification of class variable notation. (Contributed by NM, 5-Aug-1993.)
theorem zfauscl {x3 y1: setvar} (ph: wff x3) (A2: class):
  $ wcel A2 cvv $ >
  $ wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) (wa (wcel (cv x3) A2) ph))) $;

--| Convert implication to equivalence using the Separation Scheme (Aussonderung) ~ ax-sep . Similar to Theorem 1.3ii of [BellMachover] p. 463. (Contributed by NM, 5-Aug-1993.)
theorem bm1_3ii {x3 y1: setvar} (ph: wff y1):
  $ wex x3 (wal y1 (wi ph (wcel (cv y1) (cv x3)))) $ >
  $ wex x3 (wal y1 (wb (wcel (cv y1) (cv x3)) ph)) $;

--| Derive a weakened version of ~ ax-i9 , where ` x ` and ` y ` must be distinct, from Separation ~ ax-sep and Extensionality ~ ax-ext . The theorem ` -. A. x -. x = y ` also holds ( ~ ax9vsep ), but in intuitionistic logic ` E. x x = y ` is stronger. (Contributed by Jim Kingdon, 25-Aug-2018.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem a9evsep {x3: setvar} (y1: setvar):
  $ wex x3 (wceq (cv x3) (cv y1)) $;

--| Derive a weakened version of ~ ax-9 , where ` x ` and ` y ` must be distinct, from Separation ~ ax-sep and Extensionality ~ ax-ext . In intuitionistic logic ~ a9evsep is stronger and also holds. (Contributed by NM, 12-Nov-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax9vsep {x3: setvar} (y1: setvar):
  $ wn (wal x3 (wn (wceq (cv x3) (cv y1)))) $;

--| Show the uniqueness of the empty set (using the Axiom of Extensionality via ~ bm1.1 to strengthen the hypothesis in the form of ~ axnul ). (Contributed by NM, 22-Dec-2007.)
theorem zfnuleu {x3 y1: setvar}:
  $ wex x3 (wal y1 (wn (wcel (cv y1) (cv x3)))) $ >
  $ weu x3 (wal y1 (wn (wcel (cv y1) (cv x3)))) $;

--| The Null Set Axiom of ZF set theory: there exists a set with no elements. Axiom of Empty Set of [Enderton] p. 18. In some textbooks, this is presented as a separate axiom; here we show it can be derived from Separation ~ ax-sep . This version of the Null Set Axiom tells us that at least one empty set exists, but does not tell us that it is unique - we need the Axiom of Extensionality to do that (see ~ zfnuleu ). This theorem should not be referenced by any proof. Instead, use ~ ax-nul below so that the uses of the Null Set Axiom can be more easily identified. (Contributed by Jeff Hoffman, 3-Feb-2008.) (Revised by NM, 4-Feb-2008.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem axnul {x3 y1: setvar}:
  $ wex x3 (wal y1 (wn (wcel (cv y1) (cv x3)))) $;

--| The Null Set Axiom of IZF set theory. It was derived as ~ axnul above and is therefore redundant, but we state it as a separate axiom here so that its uses can be identified more easily. Axiom 4 of [Crosilla] p. "Axioms of CZF and IZF". (Contributed by NM, 7-Aug-2003.)
axiom ax_nul {x3 y1: setvar}:
  $ wex x3 (wal y1 (wn (wcel (cv y1) (cv x3)))) $;

--| The Null Set Axiom of ZF set theory: the empty set exists. Corollary 5.16 of [TakeutiZaring] p. 20. For the unabbreviated version, see ~ ax-nul . (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem _0ex:
  $ wcel c0 cvv $;

--| The existence of proper substitution into a class. (Contributed by NM, 10-Nov-2005.)
theorem csbexga {x3: setvar} (A2 B2 V W: class x3):
  $ wi (wa (wcel A2 V) (wal x3 (wcel B2 W))) (wcel (csb x3 A2 B2) cvv) $;

--| The existence of proper substitution into a class. (Contributed by NM, 7-Aug-2007.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem csbexa {x3: setvar} (A2 B2: class x3):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel (csb x3 A2 B2) cvv $;

--| No set contains all sets. Theorem 41 of [Suppes] p. 30. (Contributed by NM, 23-Aug-1993.)
theorem nalset {x3 y1: setvar}:
  $ wn (wex x3 (wal y1 (wcel (cv y1) (cv x3)))) $;

--| The universal class is not a member of itself (and thus is not a set). Proposition 5.21 of [TakeutiZaring] p. 21; our proof, however, does not depend on the Axiom of Regularity. (Contributed by NM, 23-Aug-1993.)
theorem vprc:
  $ wn (wcel cvv cvv) $;

--| The universal class doesn't belong to any class. (Contributed by FL, 31-Dec-2006.)
theorem nvel (A2: class):
  $ wn (wcel cvv A2) $;

--| The universal class does not exist. (Contributed by NM, 4-Jul-2005.)
theorem vnex {x3: setvar}:
  $ wn (wex x3 (wceq (cv x3) cvv)) $;

--| Separation Scheme (Aussonderung) using class notation. Compare Exercise 4 of [TakeutiZaring] p. 22. (Contributed by NM, 5-Aug-1993.)
theorem inex1 (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel (cin A2 B2) cvv $;

--| Separation Scheme (Aussonderung) using class notation. (Contributed by NM, 27-Apr-1994.)
theorem inex2 (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel (cin B2 A2) cvv $;

--| Closed-form, generalized Separation Scheme. (Contributed by NM, 7-Apr-1995.)
theorem inex1g (A2 B2 V: class):
  $ wi (wcel A2 V) (wcel (cin A2 B2) cvv) $;

--| The subset of a set is also a set. Exercise 3 of [TakeutiZaring] p. 22. This is one way to express the Axiom of Separation ~ ax-sep (a.k.a. Subset Axiom). (Contributed by NM, 27-Apr-1994.)
theorem ssex (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wi (wss A2 B2) (wcel A2 cvv) $;

--| The subset of a set is also a set. (Contributed by NM, 9-Sep-1993.)
theorem ssexi (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wss A2 B2 $ >
  $ wcel A2 cvv $;

--| The subset of a set is also a set. Exercise 3 of [TakeutiZaring] p. 22 (generalized). (Contributed by NM, 14-Aug-1994.)
theorem ssexg (A2 B2 C: class):
  $ wi (wa (wss A2 B2) (wcel B2 C)) (wcel A2 cvv) $;

--| A subclass of a set is a set. Deduction form of ~ ssexg . (Contributed by David Moews, 1-May-2017.)
theorem ssexd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel B2 C) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wcel A2 cvv) $;

--| Existence of a difference. (Contributed by NM, 26-May-1998.)
theorem difexg (A2 B2 V: class):
  $ wi (wcel A2 V) (wcel (cdif A2 B2) cvv) $;

--| Separation Scheme (Aussonderung) in terms of a class abstraction. (Contributed by NM, 8-Jun-1994.)
theorem zfausab {x3: setvar} (ph: wff x3) (A2: class):
  $ wcel A2 cvv $ >
  $ wcel (cab x3 (wa (wcel (cv x3) A2) ph)) cvv $;

--| Separation Scheme in terms of a restricted class abstraction. (Contributed by NM, 23-Oct-1999.)
theorem rabexg {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wcel (crab x3 ph A2) cvv) $;

--| Separation Scheme in terms of a restricted class abstraction. (Contributed by NM, 19-Jul-1996.)
theorem rabex {x3: setvar} (ph: wff x3) (A2: class):
  $ wcel A2 cvv $ >
  $ wcel (crab x3 ph A2) cvv $;

--| Membership in a class abstraction involving a subset. Unlike ~ elabg , ` A ` does not have to be a set. (Contributed by NM, 29-Aug-2006.)
theorem elssabg {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel B2 V) (wb (wcel A2 (cab x3 (wa (wss (cv x3) B2) ph))) (wa (wss A2 B2) ps)) $;

--| The intersection of an inhabited class exists. (Contributed by Jim Kingdon, 27-Aug-2018.)
theorem inteximm {x3: setvar} (A2: class):
  $ wi (wex x3 (wcel (cv x3) A2)) (wcel (cint A2) cvv) $;

--| If the intersection of a class exists, the class is non-empty. (Contributed by Jim Kingdon, 27-Aug-2018.)
theorem intexr (A2: class):
  $ wi (wcel (cint A2) cvv) (wne A2 c0) $;

--| If a class intersection is the universe, it is not a set. In classical logic this would be an equivalence. (Contributed by Jim Kingdon, 27-Aug-2018.)
theorem intnexr (A2: class):
  $ wi (wceq (cint A2) cvv) (wn (wcel (cint A2) cvv)) $;

--| The intersection of an inhabited class abstraction exists. (Contributed by Jim Kingdon, 27-Aug-2018.)
theorem intexabim {x3: setvar} (ph: wff x3):
  $ wi (wex x3 ph) (wcel (cint (cab x3 ph)) cvv) $;

--| The intersection of an inhabited restricted class abstraction exists. (Contributed by Jim Kingdon, 27-Aug-2018.)
theorem intexrabim {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wrex x3 ph A2) (wcel (cint (crab x3 ph A2)) cvv) $;

--| The existence of an indexed union. ` x ` is normally a free-variable parameter in ` B ` , which should be read ` B ( x ) ` . (Contributed by Jim Kingdon, 28-Aug-2018.)
theorem iinexgm {x3: setvar} (A2: class) (B2 C: class x3):
  $ wi (wa (wex x3 (wcel (cv x3) A2)) (wral x3 (wcel B2 C) A2)) (wcel (ciin x3 A2 B2) cvv) $;

--| The intersection of a union ` U. A ` with a class ` B ` is equal to the union of the intersections of each element of ` A ` with ` B ` . (Contributed by FL, 24-Mar-2007.)
theorem inuni {x3 y1: setvar} (A2 B2: class):
  $ wceq (cin (cuni A2) B2) (cuni (cab x3 (wrex y1 (wceq (cv x3) (cin (cv y1) B2)) A2))) $;

--| Membership in a power class. Theorem 86 of [Suppes] p. 47. (Contributed by NM, 7-Aug-2000.)
theorem elpw2g (A2 B2 V: class):
  $ wi (wcel B2 V) (wb (wcel A2 (cpw B2)) (wss A2 B2)) $;

--| Membership in a power class. Theorem 86 of [Suppes] p. 47. (Contributed by NM, 11-Oct-2007.)
theorem elpw2 (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wb (wcel A2 (cpw B2)) (wss A2 B2) $;

--| The power set of a set is never a subset. (Contributed by Stefan O'Rear, 22-Feb-2015.)
theorem pwnss (A2 V: class):
  $ wi (wcel A2 V) (wn (wss (cpw A2) A2)) $;

--| No set equals its power set. The sethood antecedent is necessary; compare ~ pwv . (Contributed by NM, 17-Nov-2008.) (Proof shortened by Mario Carneiro, 23-Dec-2016.)
theorem pwne (A2 V: class):
  $ wi (wcel A2 V) (wne (cpw A2) A2) $;

--| Lemma for ~ repizf2 . If we have a function-like proposition which provides at most one value of ` y ` for each ` x ` in a set ` w ` , we can change "at most one" to "exactly one" by restricting the values of ` x ` to those values for which the proposition provides a value of ` y ` . (Contributed by Jim Kingdon, 7-Sep-2018.)
theorem repizf2lem {x3 y1: setvar} (ph: wff x3 y1) (w: setvar):
  $ wb (wral x3 (wmo y1 ph) (cv w)) (wral x3 (weu y1 ph) (crab x3 (wex y1 ph) (cv w))) $;

--| Replacement. This version of replacement is stronger than ~ repizf in the sense that ` ph ` does not need to map all values of ` x ` in ` w ` to a value of ` y ` . The resulting set contains those elements for which there is a value of ` y ` and in that sense, this theorem combines ~ repizf with ~ ax-sep . Another variation would be ` A. x e. w E* y ph -> { y | E. x ( x e. w /\ ph ) } e. _V ` but we don't have a proof of that yet. (Contributed by Jim Kingdon, 7-Sep-2018.)
theorem repizf2 {x3 y1 z w: setvar} (ph: wff x3 y1 z w):
  $ wnf z ph $ >
  $ wi (wral x3 (wmo y1 ph) (cv w)) (wex z (wral x3 (wrex y1 ph (cv z)) (crab x3 (wex y1 ph) (cv w)))) $;

--| Equality theorem for classes and sets . (Contributed by NM, 13-Dec-2005.) (Proof shortened by Raph Levien, 30-Jun-2006.)
theorem class2seteq {x3: setvar} (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wceq (crab x3 (wcel A2 cvv) A2) A2) $;

--| Every power class contains the empty set. (Contributed by NM, 25-Oct-2007.)
theorem _0elpw (A2: class):
  $ wcel c0 (cpw A2) $;

--| The empty set and its power set are not equal. (Contributed by NM, 23-Dec-1993.)
theorem _0nep0:
  $ wne c0 (csn c0) $;

--| Something cannot be equal to both the null set and the power set of the null set. (Contributed by NM, 30-Sep-2003.)
theorem _0inp0 (A2: class):
  $ wi (wceq A2 c0) (wn (wceq A2 (csn c0))) $;

--| The removal of the empty set from a class does not affect its union. (Contributed by NM, 22-Mar-2004.)
theorem unidif0 (A2: class):
  $ wceq (cuni (cdif A2 (csn c0))) (cuni A2) $;

--| An indexed intersection of the empty set, with an inhabited index set, is empty. (Contributed by Jim Kingdon, 29-Aug-2018.)
theorem iin0imm {x3 y1: setvar} (A2: class):
  $ wi (wex y1 (wcel (cv y1) A2)) (wceq (ciin x3 A2 c0) c0) $;

--| If an indexed intersection of the empty set is empty, the index set is non-empty. (Contributed by Jim Kingdon, 29-Aug-2018.)
theorem iin0r {x3: setvar} (A2: class):
  $ wi (wceq (ciin x3 A2 c0) c0) (wne A2 c0) $;

--| The intersection of the universal class is empty. (Contributed by NM, 11-Sep-2008.)
theorem intv:
  $ wceq (cint cvv) c0 $;

--| Two equivalent ways to express the Power Set Axiom. Note that ~ ax-pow is not used by the proof. (Contributed by NM, 22-Jun-2009.)
theorem axpweq {x3 y1 z: setvar} (A2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel (cpw A2) cvv) (wex x3 (wal y1 (wi (wal z (wi (wcel (cv z) (cv y1)) (wcel (cv z) A2))) (wcel (cv y1) (cv x3))))) $;

--| A very strong generalization of the Axiom of Replacement (compare ~ zfrep6 ). Its strength lies in the rather profound fact that ` ph ( x , y ) ` does not have to be a "function-like" wff, as it does in the standard Axiom of Replacement. This theorem is sometimes called the Boundedness Axiom. In the context of IZF, it is just a slight variation of ~ ax-coll . (Contributed by NM, 17-Oct-2004.)
theorem bnd {x3 y1 w: setvar} (ph: wff x3 y1) (z: setvar):
  $ wi (wral x3 (wex y1 ph) (cv z)) (wex w (wral x3 (wrex y1 ph (cv w)) (cv z))) $;

--| A variant of the Boundedness Axiom ~ bnd that picks a subset ` z ` out of a possibly proper class ` B ` in which a property is true. (Contributed by NM, 4-Feb-2004.)
theorem bnd2 {x3 y1 z: setvar} (ph: wff x3 y1) (A2: class y1) (B2: class):
  $ wcel A2 cvv $ >
  $ wi (wral x3 (wrex y1 ph B2) A2) (wex z (wa (wss (cv z) B2) (wral x3 (wrex y1 ph (cv z)) A2))) $;

--| Axiom of Power Sets. An axiom of Intuitionistic Zermelo-Fraenkel set theory. It states that a set ` y ` exists that includes the power set of a given set ` x ` i.e. contains every subset of ` x ` . This is Axiom 8 of [Crosilla] p. "Axioms of CZF and IZF" except (a) unnecessary quantifiers are removed, and (b) Crosilla has a biconditional rather than an implication (but the two are equivalent by ~ bm1.3ii ). The variant ~ axpow2 uses explicit subset notation. A version using class notation is ~ pwex . (Contributed by NM, 5-Aug-1993.)
axiom ax_pow {y1 z w: setvar} (x3: setvar):
  $ wex y1 (wal z (wi (wal w (wi (wcel (cv w) (cv z)) (wcel (cv w) (cv x3)))) (wcel (cv z) (cv y1)))) $;

--| Axiom of Power Sets expressed with the fewest number of different variables. (Contributed by NM, 14-Aug-2003.)
theorem zfpow {x3 y1: setvar} (z: setvar):
  $ wex x3 (wal y1 (wi (wal x3 (wi (wcel (cv x3) (cv y1)) (wcel (cv x3) (cv z)))) (wcel (cv y1) (cv x3)))) $;

--| A variant of the Axiom of Power Sets ~ ax-pow using subset notation. Problem in {BellMachover] p. 466. (Contributed by NM, 4-Jun-2006.)
theorem axpow2 {y1 z: setvar} (x3: setvar):
  $ wex y1 (wal z (wi (wss (cv z) (cv x3)) (wcel (cv z) (cv y1)))) $;

--| A variant of the Axiom of Power Sets ~ ax-pow . For any set ` x ` , there exists a set ` y ` whose members are exactly the subsets of ` x ` i.e. the power set of ` x ` . Axiom Pow of [BellMachover] p. 466. (Contributed by NM, 4-Jun-2006.)
theorem axpow3 {y1 z: setvar} (x3: setvar):
  $ wex y1 (wal z (wb (wss (cv z) (cv x3)) (wcel (cv z) (cv y1)))) $;

--| Every set is an element of some other set. (Contributed by NM, 4-Jan-2002.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem el {x3 y1: setvar}:
  $ wex y1 (wcel (cv x3) (cv y1)) $;

--| Power set axiom expressed in class notation. Axiom 4 of [TakeutiZaring] p. 17. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem pwex (A2: class):
  $ wcel A2 cvv $ >
  $ wcel (cpw A2) cvv $;

--| Power set axiom expressed in class notation, with the sethood requirement as an antecedent. Axiom 4 of [TakeutiZaring] p. 17. (Contributed by NM, 30-Oct-2003.)
theorem pwexg (A2 V: class):
  $ wi (wcel A2 V) (wcel (cpw A2) cvv) $;

--| Existence of a class of subsets. (Contributed by NM, 15-Jul-2006.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem abssexg {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wcel (cab x3 (wa (wss (cv x3) A2) ph)) cvv) $;

--| A singleton whose element exists is a set. The ` A e. _V ` case of Theorem 7.12 of [Quine] p. 51, proved using only Extensionality, Power Set, and Separation. Replacement is not needed. This is a special case of ~ snexg and new proofs should use ~ snexg instead. (Contributed by Jim Kingdon, 26-Jan-2019.) (New usage is discouraged.) (Proof modification is discouraged.) TODO: replace its uses by uses of ~snexg and then remove it.
theorem snexgOLD (A2: class):
  $ wi (wcel A2 cvv) (wcel (csn A2) cvv) $;

--| A singleton whose element exists is a set. The ` A e. _V ` case of Theorem 7.12 of [Quine] p. 51, proved using only Extensionality, Power Set, and Separation. Replacement is not needed. (Contributed by Jim Kingdon, 1-Sep-2018.)
theorem snexg (A2 V: class):
  $ wi (wcel A2 V) (wcel (csn A2) cvv) $;

--| A singleton whose element exists is a set. (Contributed by NM, 7-Aug-1994.) (Revised by Mario Carneiro, 24-May-2019.)
theorem snex (A2: class):
  $ wcel A2 cvv $ >
  $ wcel (csn A2) cvv $;

--| A singleton whose element is a proper class is a set. The ` -. A e. _V ` case of Theorem 7.12 of [Quine] p. 51, proved using only Extensionality, Power Set, and Separation. Replacement is not needed. (Contributed by Jim Kingdon, 1-Sep-2018.)
theorem snexprc (A2: class):
  $ wi (wn (wcel A2 cvv)) (wcel (csn A2) cvv) $;

--| The power set of the empty set (the ordinal 1) is a set. (Contributed by NM, 23-Dec-1993.)
theorem p0ex:
  $ wcel (csn c0) cvv $;

--| ` { (/) , { (/) } } ` (the ordinal 2) is a set. (Contributed by NM, 5-Aug-1993.)
theorem pp0ex:
  $ wcel (cpr c0 (csn c0)) cvv $;

--| The ordinal number 3 is a set, proved without the Axiom of Union. (Contributed by NM, 2-May-2009.)
theorem ord3ex:
  $ wcel (ctp c0 (csn c0) (cpr c0 (csn c0))) cvv $;

--| At least two sets exist (or in terms of first-order logic, the universe of discourse has two or more objects). This theorem asserts the existence of two sets which do not equal each other; compare with ~ dtruex in which we are given a set ` y ` and go from there to a set ` x ` which is not equal to it. (Contributed by Jim Kingdon, 2-Sep-2018.)
theorem dtruarb {x3 y1: setvar}:
  $ wex x3 (wex y1 (wn (wceq (cv x3) (cv y1)))) $;

--| A class is a subclass of the power class of its union. Exercise 6(b) of [Enderton] p. 38. (Contributed by NM, 14-Oct-1996.)
theorem pwuni (A2: class):
  $ wss A2 (cpw (cuni A2)) $;

--| The Axiom of Pairing of IZF set theory. Axiom 2 of [Crosilla] p. "Axioms of CZF and IZF", except (a) unnecessary quantifiers are removed, and (b) Crosilla has a biconditional rather than an implication (but the two are equivalent by ~ bm1.3ii ). (Contributed by NM, 14-Nov-2006.)
axiom ax_pr {z w: setvar} (x3 y1: setvar):
  $ wex z (wal w (wi (wo (wceq (cv w) (cv x3)) (wceq (cv w) (cv y1))) (wcel (cv w) (cv z)))) $;

--| Derive the abbreviated version of the Axiom of Pairing from ~ ax-pr . (Contributed by NM, 14-Nov-2006.)
theorem zfpair2 (x3 y1: setvar):
  $ wcel (cpr (cv x3) (cv y1)) cvv $;

--| The Axiom of Pairing using class variables. Theorem 7.13 of [Quine] p. 51, but restricted to classes which exist. For proper classes, see ~ prprc , ~ prprc1 , and ~ prprc2 . This is a special case of ~ prexg and new proofs should use ~ prexg instead. (Contributed by Jim Kingdon, 25-Jul-2019.) (New usage is discouraged.) (Proof modification is discouraged.) TODO: replace its uses by uses of ~ prexg and then remove it.
theorem prexgOLD (A2 B2: class):
  $ wi (wa (wcel A2 cvv) (wcel B2 cvv)) (wcel (cpr A2 B2) cvv) $;

--| The Axiom of Pairing using class variables. Theorem 7.13 of [Quine] p. 51, but restricted to classes which exist. For proper classes, see ~ prprc , ~ prprc1 , and ~ prprc2 . (Contributed by Jim Kingdon, 16-Sep-2018.)
theorem prexg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wcel (cpr A2 B2) cvv) $;

--| A singleton of a set belongs to the power class of a class containing the set. (Contributed by Alan Sare, 25-Aug-2011.)
theorem snelpwi (A2 B2: class):
  $ wi (wcel A2 B2) (wcel (csn A2) (cpw B2)) $;

--| A singleton of a set belongs to the power class of a class containing the set. (Contributed by NM, 1-Apr-1998.)
theorem snelpw (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 B2) (wcel (csn A2) (cpw B2)) $;

--| A pair of two sets belongs to the power class of a class containing those two sets. (Contributed by Thierry Arnoux, 10-Mar-2017.)
theorem prelpwi (A2 B2 C: class):
  $ wi (wa (wcel A2 C) (wcel B2 C)) (wcel (cpr A2 B2) (cpw C)) $;

--| A theorem similar to extensionality, requiring the existence of a singleton. Exercise 8 of [TakeutiZaring] p. 16. (Contributed by NM, 10-Aug-1993.)
theorem rext {x3 y1 z: setvar}:
  $ wi (wal z (wi (wcel (cv x3) (cv z)) (wcel (cv y1) (cv z)))) (wceq (cv x3) (cv y1)) $;

--| Classes are subclasses if and only if their power classes are subclasses. Exercise 18 of [TakeutiZaring] p. 18. (Contributed by NM, 13-Oct-1996.)
theorem sspwb (A2 B2: class):
  $ wb (wss A2 B2) (wss (cpw A2) (cpw B2)) $;

--| A class equals the union of its power class. Exercise 6(a) of [Enderton] p. 38. (Contributed by NM, 14-Oct-1996.) (Proof shortened by Alan Sare, 28-Dec-2008.)
theorem unipw (A2: class):
  $ wceq (cuni (cpw A2)) A2 $;

--| Membership of a power class. Exercise 10 of [Enderton] p. 26. (Contributed by NM, 13-Jan-2007.)
theorem pwel (A2 B2: class):
  $ wi (wcel A2 B2) (wcel (cpw A2) (cpw (cpw (cuni B2)))) $;

--| A class is transitive iff its power class is transitive. (Contributed by Alan Sare, 25-Aug-2011.) (Revised by Mario Carneiro, 15-Jun-2014.)
theorem pwtr (A2: class):
  $ wb (wtr A2) (wtr (cpw A2)) $;

--| An extensionality-like principle defining subclass in terms of subsets. (Contributed by NM, 30-Jun-2004.)
theorem ssextss {x3: setvar} (A2 B2: class):
  $ wb (wss A2 B2) (wal x3 (wi (wss (cv x3) A2) (wss (cv x3) B2))) $;

--| An extensionality-like principle that uses the subset instead of the membership relation: two classes are equal iff they have the same subsets. (Contributed by NM, 30-Jun-2004.)
theorem ssext {x3: setvar} (A2 B2: class):
  $ wb (wceq A2 B2) (wal x3 (wb (wss (cv x3) A2) (wss (cv x3) B2))) $;

--| Negation of subclass relationship. Compare ~ nssr . (Contributed by Jim Kingdon, 17-Sep-2018.)
theorem nssssr {x3: setvar} (A2 B2: class):
  $ wi (wex x3 (wa (wss (cv x3) A2) (wn (wss (cv x3) B2)))) (wn (wss A2 B2)) $;

--| Classes are equal if and only if their power classes are equal. Exercise 19 of [TakeutiZaring] p. 18. (Contributed by NM, 13-Oct-1996.)
theorem pweqb (A2 B2: class):
  $ wb (wceq A2 B2) (wceq (cpw A2) (cpw B2)) $;

--| The intersection of all sets to which a set belongs is the singleton of that set. (Contributed by NM, 5-Jun-2009.)
theorem intid {x3: setvar} (A2: class):
  $ wcel A2 cvv $ >
  $ wceq (cint (cab x3 (wcel A2 (cv x3)))) (csn A2) $;

--| The abstraction of a wff with existential uniqueness exists. (Contributed by NM, 25-Nov-1994.)
theorem euabex {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wcel (cab x3 ph) cvv) $;

--| An inhabited class (even if proper) has an inhabited subset. (Contributed by Jim Kingdon, 17-Sep-2018.)
theorem mss {x3 y1 z: setvar} (A2: class z):
  $ wi (wex y1 (wcel (cv y1) A2)) (wex x3 (wa (wss (cv x3) A2) (wex z (wcel (cv z) (cv x3))))) $;

--| Restricted existence in a class (even if proper) implies restricted existence in a subset. (Contributed by NM, 23-Aug-2003.)
theorem exss {x3 y1: setvar} (ph: wff x3) (A2: class):
  $ wi (wrex x3 ph A2) (wex y1 (wa (wss (cv y1) A2) (wrex x3 ph (cv y1)))) $;

--| An ordered pair of sets is a set. (Contributed by Jim Kingdon, 11-Jan-2019.)
theorem opexg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wcel (cop A2 B2) cvv) $;

--| An ordered pair of sets is a set. This is a special case of ~ opexg and new proofs should use ~ opexg instead. (Contributed by Jim Kingdon, 19-Sep-2018.) (New usage is discouraged.) (Proof modification is discouraged.) TODO: replace its uses by uses of ~ opexg and then remove it.
theorem opexgOLD (A2 B2: class):
  $ wi (wa (wcel A2 cvv) (wcel B2 cvv)) (wcel (cop A2 B2) cvv) $;

--| An ordered pair of sets is a set. (Contributed by Jim Kingdon, 24-Sep-2018.) (Revised by Mario Carneiro, 24-May-2019.)
theorem opex (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel (cop A2 B2) cvv $;

--| An ordered triple of sets is a set. (Contributed by Jim Kingdon, 19-Sep-2018.)
theorem otexg (A2 B2 C U V W: class):
  $ wi (w3a (wcel A2 U) (wcel B2 V) (wcel C W)) (wcel (cotp A2 B2 C) cvv) $;

--| An ordered pair has two elements. Exercise 3 of [TakeutiZaring] p. 15. (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem elop (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wb (wcel A2 (cop B2 C)) (wo (wceq A2 (csn B2)) (wceq A2 (cpr B2 C))) $;

--| One of the two elements in an ordered pair. (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opi1 (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel (csn A2) (cop A2 B2) $;

--| One of the two elements of an ordered pair. (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opi2 (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel (cpr A2 B2) (cop A2 B2) $;

--| An ordered pair is inhabited iff the arguments are sets. (Contributed by Jim Kingdon, 21-Sep-2018.)
theorem opm {x3: setvar} (A2 B2: class):
  $ wb (wex x3 (wcel (cv x3) (cop A2 B2))) (wa (wcel A2 cvv) (wcel B2 cvv)) $;

--| An ordered pair is nonempty if the arguments are sets (it is also inhabited; see ~ opm ). (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem opnzi (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wne (cop A2 B2) c0 $;

--| Equality of the first members of equal ordered pairs. (Contributed by NM, 28-May-2008.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opth1 (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cop A2 B2) (cop C D)) (wceq A2 C) $;

--| The ordered pair theorem. If two ordered pairs are equal, their first elements are equal and their second elements are equal. Exercise 6 of [TakeutiZaring] p. 16. Note that ` C ` and ` D ` are not required to be sets due our specific ordered pair definition. (Contributed by NM, 28-May-1995.)
theorem opth (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wceq (cop A2 B2) (cop C D)) (wa (wceq A2 C) (wceq B2 D)) $;

--| Ordered pair theorem. ` C ` and ` D ` are not required to be sets under our specific ordered pair definition. (Contributed by NM, 14-Oct-2005.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opthg (A2 B2 C D V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wceq (cop A2 B2) (cop C D)) (wa (wceq A2 C) (wceq B2 D))) $;

--| Ordered pair theorem. (Contributed by NM, 14-Oct-2005.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opthg2 (A2 B2 C D V W: class):
  $ wi (wa (wcel C V) (wcel D W)) (wb (wceq (cop A2 B2) (cop C D)) (wa (wceq A2 C) (wceq B2 D))) $;

--| Ordered pair theorem. (Contributed by NM, 21-Sep-2014.)
theorem opth2 (A2 B2 C D: class):
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wb (wceq (cop A2 B2) (cop C D)) (wa (wceq A2 C) (wceq B2 D)) $;

--| Ordered triple theorem, with triple express with ordered pairs. (Contributed by NM, 1-May-1995.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem otth2 (A2 B2 C D R S: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel R cvv $ >
  $ wb (wceq (cop (cop A2 B2) R) (cop (cop C D) S)) (w3a (wceq A2 C) (wceq B2 D) (wceq R S)) $;

--| Ordered triple theorem. (Contributed by NM, 25-Sep-2014.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem otth (A2 B2 C D R S: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel R cvv $ >
  $ wb (wceq (cotp A2 B2 R) (cotp C D S)) (w3a (wceq A2 C) (wceq B2 D) (wceq R S)) $;

--| A variable introduction law for ordered pairs. Analog of Lemma 15 of [Monk2] p. 109. (Contributed by NM, 28-May-1995.)
theorem eqvinop {x3 y1: setvar} (A2 B2 C: class):
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wb (wceq A2 (cop B2 C)) (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) (wceq (cop (cv x3) (cv y1)) (cop B2 C))))) $;

--| Substitution of class ` A ` for ordered pair ` <. x , y >. ` . (Contributed by NM, 27-Dec-1996.) (Revised by Andrew Salmon, 11-Jul-2011.)
theorem copsexg {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wi (wceq A2 (cop (cv x3) (cv y1))) (wb ph (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) ph)))) $;

--| Closed theorem form of ~ copsex2g . (Contributed by NM, 17-Feb-2013.)
theorem copsex2t {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class) (V W: class x3 y1):
  $ wi (wa (wal x3 (wal y1 (wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps)))) (wa (wcel A2 V) (wcel B2 W))) (wb (wex x3 (wex y1 (wa (wceq (cop A2 B2) (cop (cv x3) (cv y1))) ph))) ps) $;

--| Implicit substitution inference for ordered pairs. (Contributed by NM, 28-May-1995.)
theorem copsex2g {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class) (V W: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wex x3 (wex y1 (wa (wceq (cop A2 B2) (cop (cv x3) (cv y1))) ph))) ps) $;

--| An implicit substitution inference for 2 ordered pairs. (Contributed by NM, 5-Aug-1995.)
theorem copsex4g {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (ps: wff) (A2 B2 C D R S: class):
  $ wi (wa (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wa (wceq (cv z) C) (wceq (cv w) D))) (wb ph ps) $ >
  $ wi (wa (wa (wcel A2 R) (wcel B2 S)) (wa (wcel C R) (wcel D S))) (wb (wex x3 (wex y1 (wex z (wex w (wa (wa (wceq (cop A2 B2) (cop (cv x3) (cv y1))) (wceq (cop C D) (cop (cv z) (cv w)))) ph))))) ps) $;

--| A property of ordered pairs. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem _0nelop (A2 B2: class):
  $ wn (wcel c0 (cop A2 B2)) $;

--| Equivalence of existence implied by equality of ordered pairs. (Contributed by NM, 28-May-2008.)
theorem opeqex (A2 B2 C D: class):
  $ wi (wceq (cop A2 B2) (cop C D)) (wb (wa (wcel A2 cvv) (wcel B2 cvv)) (wa (wcel C cvv) (wcel D cvv))) $;

--| An ordered pair commutes iff its members are equal. (Contributed by NM, 28-May-2009.)
theorem opcom (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wceq (cop A2 B2) (cop B2 A2)) (wceq A2 B2) $;

--| "At most one" property of an ordered pair. (Contributed by NM, 11-Apr-2004.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem moop2 {x3: setvar} (A2: class) (B2: class x3):
  $ wcel B2 cvv $ >
  $ wmo x3 (wceq A2 (cop B2 (cv x3))) $;

--| Equivalence for an ordered pair equal to a singleton. (Contributed by NM, 3-Jun-2008.)
theorem opeqsn (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wb (wceq (cop A2 B2) (csn C)) (wa (wceq A2 B2) (wceq C (csn A2))) $;

--| Equivalence for an ordered pair equal to an unordered pair. (Contributed by NM, 3-Jun-2008.)
theorem opeqpr (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wb (wceq (cop A2 B2) (cpr C D)) (wo (wa (wceq C (csn A2)) (wceq D (cpr A2 B2))) (wa (wceq C (cpr A2 B2)) (wceq D (csn A2)))) $;

--| Prove existential uniqueness for an ordered triple. (Contributed by Mario Carneiro, 20-May-2015.)
theorem euotd {x3 a b c: setvar} (ph: wff) (ps: wff x3 a b c) (A2 B2 C: class):
  $ wi ph (wcel A2 cvv) $ >
  $ wi ph (wcel B2 cvv) $ >
  $ wi ph (wcel C cvv) $ >
  $ wi ph (wb ps (w3a (wceq (cv a) A2) (wceq (cv b) B2) (wceq (cv c) C))) $ >
  $ wi ph (weu x3 (wex a (wex b (wex c (wa (wceq (cv x3) (cotp (cv a) (cv b) (cv c))) ps))))) $;

--| The union of an ordered pair. Theorem 65 of [Suppes] p. 39. (Contributed by NM, 17-Aug-2004.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem uniop (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cuni (cop A2 B2)) (cpr A2 B2) $;

--| Ordered pair membership is inherited by class union. (Contributed by NM, 13-May-2008.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem uniopel (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wcel (cop A2 B2) C) (wcel (cuni (cop A2 B2)) (cuni C)) $;

--| The law of concretion. Special case of Theorem 9.5 of [Quine] p. 61. (Contributed by NM, 14-Apr-1995.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem opabid {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wcel (cop (cv x3) (cv y1)) (copab x3 y1 ph)) ph $;

--| Membership in a class abstraction of pairs. (Contributed by NM, 24-Mar-1998.)
theorem elopab {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wb (wcel A2 (copab x3 y1 ph)) (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) ph))) $;

--| The law of concretion in terms of substitutions. Less general than ~ opelopabsb , but having a much shorter proof. (Contributed by NM, 30-Sep-2002.) (Proof shortened by Andrew Salmon, 25-Jul-2011.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem opelopabsbALT {x3 y1 z w: setvar} (ph: wff x3 y1 z w):
  $ wb (wcel (cop (cv z) (cv w)) (copab x3 y1 ph)) (wsb y1 w (wsb x3 z ph)) $;

--| The law of concretion in terms of substitutions. (Contributed by NM, 30-Sep-2002.) (Revised by Mario Carneiro, 18-Nov-2016.)
theorem opelopabsb {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1) (B2: class y1):
  $ wb (wcel (cop A2 B2) (copab x3 y1 ph)) (wsbc x3 (wsbc y1 ph B2) A2) $;

--| The law of concretion in terms of substitutions. (Contributed by NM, 17-Mar-2008.)
theorem brabsb {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1) (B2: class y1) (R: class x3 y1):
  $ wceq R (copab x3 y1 ph) $ >
  $ wb (wbr A2 B2 R) (wsbc x3 (wsbc y1 ph B2) A2) $;

--| Closed theorem form of ~ opelopab . (Contributed by NM, 19-Feb-2013.)
theorem opelopabt {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2: class) (V W: class x3 y1):
  $ wi (w3a (wal x3 (wal y1 (wi (wceq (cv x3) A2) (wb ph ps)))) (wal x3 (wal y1 (wi (wceq (cv y1) B2) (wb ps ch)))) (wa (wcel A2 V) (wcel B2 W))) (wb (wcel (cop A2 B2) (copab x3 y1 ph)) ch) $;

--| The law of concretion. Theorem 9.5 of [Quine] p. 61. (Contributed by Mario Carneiro, 19-Dec-2013.)
theorem opelopabga {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class) (V W: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wcel (cop A2 B2) (copab x3 y1 ph)) ps) $;

--| The law of concretion for a binary relation. (Contributed by Mario Carneiro, 19-Dec-2013.)
theorem brabga {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class) (R V W: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wceq R (copab x3 y1 ph) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 R) ps) $;

--| Ordered pair membership in an ordered pair class abstraction. (Contributed by Mario Carneiro, 19-Dec-2013.)
theorem opelopab2a {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2 C D: class):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wb (wcel (cop A2 B2) (copab x3 y1 (wa (wa (wcel (cv x3) C) (wcel (cv y1) D)) ph))) ps) $;

--| The law of concretion. Theorem 9.5 of [Quine] p. 61. (Contributed by Mario Carneiro, 19-Dec-2013.)
theorem opelopaba {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wb (wcel (cop A2 B2) (copab x3 y1 ph)) ps $;

--| The law of concretion for a binary relation. (Contributed by NM, 19-Dec-2013.)
theorem braba {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class) (R: class x3 y1):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wceq R (copab x3 y1 ph) $ >
  $ wb (wbr A2 B2 R) ps $;

--| The law of concretion. Theorem 9.5 of [Quine] p. 61. (Contributed by NM, 28-May-1995.) (Revised by Mario Carneiro, 19-Dec-2013.)
theorem opelopabg {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2: class) (V W: class x3 y1):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wcel (cop A2 B2) (copab x3 y1 ph)) ch) $;

--| The law of concretion for a binary relation. (Contributed by NM, 16-Aug-1999.) (Revised by Mario Carneiro, 19-Dec-2013.)
theorem brabg {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2: class) (C D R: class x3 y1):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wceq R (copab x3 y1 ph) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wb (wbr A2 B2 R) ch) $;

--| Ordered pair membership in an ordered pair class abstraction. (Contributed by NM, 14-Oct-2007.) (Revised by Mario Carneiro, 19-Dec-2013.)
theorem opelopab2 {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2 C D: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wb (wcel (cop A2 B2) (copab x3 y1 (wa (wa (wcel (cv x3) C) (wcel (cv y1) D)) ph))) ch) $;

--| The law of concretion. Theorem 9.5 of [Quine] p. 61. (Contributed by NM, 16-May-1995.)
theorem opelopab {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wb (wcel (cop A2 B2) (copab x3 y1 ph)) ch $;

--| The law of concretion for a binary relation. (Contributed by NM, 16-Aug-1999.)
theorem brab {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2: class) (R: class x3 y1):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wceq R (copab x3 y1 ph) $ >
  $ wb (wbr A2 B2 R) ch $;

--| The law of concretion. Theorem 9.5 of [Quine] p. 61. This version of ~ opelopab uses bound-variable hypotheses in place of distinct variable conditions." (Contributed by Mario Carneiro, 19-Dec-2013.) (Proof shortened by Mario Carneiro, 18-Nov-2016.)
theorem opelopabaf {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class):
  $ wnf x3 ps $ >
  $ wnf y1 ps $ >
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wb (wcel (cop A2 B2) (copab x3 y1 ph)) ps $;

--| The law of concretion. Theorem 9.5 of [Quine] p. 61. This version of ~ opelopab uses bound-variable hypotheses in place of distinct variable conditions." (Contributed by NM, 19-Dec-2008.)
theorem opelopabf {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2 B2: class):
  $ wnf x3 ps $ >
  $ wnf y1 ch $ >
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wb (wcel (cop A2 B2) (copab x3 y1 ph)) ch $;

--| Equivalence of ordered pair abstraction subclass and implication. (Contributed by NM, 27-Dec-1996.) (Revised by Mario Carneiro, 19-May-2013.)
theorem ssopab2 {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wal y1 (wi ph ps))) (wss (copab x3 y1 ph) (copab x3 y1 ps)) $;

--| Equivalence of ordered pair abstraction subclass and implication. (Contributed by NM, 27-Dec-1996.) (Proof shortened by Mario Carneiro, 18-Nov-2016.)
theorem ssopab2b {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb (wss (copab x3 y1 ph) (copab x3 y1 ps)) (wal x3 (wal y1 (wi ph ps))) $;

--| Inference of ordered pair abstraction subclass from implication. (Contributed by NM, 5-Apr-1995.)
theorem ssopab2i {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph ps $ >
  $ wss (copab x3 y1 ph) (copab x3 y1 ps) $;

--| Inference of ordered pair abstraction subclass from implication. (Contributed by NM, 19-Jan-2014.) (Revised by Mario Carneiro, 24-Jun-2014.)
theorem ssopab2dv {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wss (copab x3 y1 ps) (copab x3 y1 ch)) $;

--| Equivalence of ordered pair abstraction equality and biconditional. (Contributed by Mario Carneiro, 4-Jan-2017.)
theorem eqopab2b {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb (wceq (copab x3 y1 ph) (copab x3 y1 ps)) (wal x3 (wal y1 (wb ph ps))) $;

--| Inhabited ordered pair class abstraction. (Contributed by Jim Kingdon, 29-Sep-2018.)
theorem opabm {x3 y1 z: setvar} (ph: wff x3 y1):
  $ wb (wex z (wcel (cv z) (copab x3 y1 ph))) (wex x3 (wex y1 ph)) $;

--| Move indexed union inside an ordered-pair abstraction. (Contributed by Stefan O'Rear, 20-Feb-2015.)
theorem iunopab {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class z):
  $ wceq (ciun z A2 (copab x3 y1 ph)) (copab x3 y1 (wrex z ph A2)) $;

--| The power class of the intersection of two classes is the intersection of their power classes. Exercise 4.12(j) of [Mendelson] p. 235. (Contributed by NM, 23-Nov-2003.)
theorem pwin (A2 B2: class):
  $ wceq (cpw (cin A2 B2)) (cin (cpw A2) (cpw B2)) $;

--| The power class of the union of two classes includes the union of their power classes. Exercise 4.12(k) of [Mendelson] p. 235. (Contributed by NM, 23-Nov-2003.)
theorem pwunss (A2 B2: class):
  $ wss (cun (cpw A2) (cpw B2)) (cpw (cun A2 B2)) $;

--| The power class of the union of two classes is a subset of the union of their power classes, if one class is a subclass of the other. One direction of Exercise 4.12(l) of [Mendelson] p. 235. (Contributed by Jim Kingdon, 30-Sep-2018.)
theorem pwssunim (A2 B2: class):
  $ wi (wo (wss A2 B2) (wss B2 A2)) (wss (cpw (cun A2 B2)) (cun (cpw A2) (cpw B2))) $;

--| Break up the power class of a union into a union of smaller classes. (Contributed by Jim Kingdon, 30-Sep-2018.)
theorem pwundifss (A2 B2: class):
  $ wss (cun (cdif (cpw (cun A2 B2)) (cpw A2)) (cpw A2)) (cpw (cun A2 B2)) $;

--| The power class of the union of two classes equals the union of their power classes, iff one class is a subclass of the other. Part of Exercise 7(b) of [Enderton] p. 28. (Contributed by Jim Kingdon, 30-Sep-2018.)
theorem pwunim (A2 B2: class):
  $ wi (wo (wss A2 B2) (wss B2 A2)) (wceq (cpw (cun A2 B2)) (cun (cpw A2) (cpw B2))) $;

--| Extend class notation to include the epsilon relation.
term cep: class;

--| Extend the definition of a class to include identity relation.
term cid: class;

--| Define the epsilon relation. Similar to Definition 6.22 of [TakeutiZaring] p. 30. The epsilon relation and set membership are the same, that is, ` ( A _E B <-> A e. B ) ` when ` B ` is a set by ~ epelg . Thus, 5 ` _E ` { 1 , 5 }. (Contributed by NM, 13-Aug-1995.)
axiom df_eprel {x3 y1: setvar}:
  $ wceq cep (copab x3 y1 (wcel (cv x3) (cv y1))) $;

--| The epsilon relation and membership are the same. General version of ~ epel . (Contributed by Scott Fenton, 27-Mar-2011.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem epelg (A2 B2 V: class):
  $ wi (wcel B2 V) (wb (wbr A2 B2 cep) (wcel A2 B2)) $;

--| The epsilon relationship and the membership relation are the same. (Contributed by Scott Fenton, 11-Apr-2012.)
theorem epelc (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wb (wbr A2 B2 cep) (wcel A2 B2) $;

--| The epsilon relation and the membership relation are the same. (Contributed by NM, 13-Aug-1995.)
theorem epel {y1: setvar} (x3: setvar):
  $ wb (wbr (cv x3) (cv y1) cep) (wcel (cv x3) (cv y1)) $;

--| Define the identity relation. Definition 9.15 of [Quine] p. 64. For example, 5 ` _I ` 5 and ` -. ` 4 ` _I ` 5. (Contributed by NM, 13-Aug-1995.)
axiom df_id {x3 y1: setvar}:
  $ wceq cid (copab x3 y1 (wceq (cv x3) (cv y1))) $;

--| Extend wff notation to include the strict partial ordering predicate. Read: ' ` R ` is a partial order on ` A ` .'
term wpo (A2 R: class): wff;

--| Extend wff notation to include the strict linear ordering predicate. Read: ' ` R ` orders ` A ` .'
term wor (A2 R: class): wff;

--| Define the strict partial order predicate. Definition of [Enderton] p. 168. The expression ` R Po A ` means ` R ` is a partial order on ` A ` . (Contributed by NM, 16-Mar-1997.)
axiom df_po {x3 y1 z: setvar} (A2 R: class):
  $ wb (wpo A2 R) (wral x3 (wral y1 (wral z (wa (wn (wbr (cv x3) (cv x3) R)) (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R)) (wbr (cv x3) (cv z) R))) A2) A2) A2) $;

--| Define the strict linear order predicate. The expression ` R Or A ` is true if relationship ` R ` orders ` A ` . The property ` x R y -> ( x R z \/ z R y ) ` is called weak linearity by Proposition 11.2.3 of [HoTT], p. (varies). If we assumed excluded middle, it would be equivalent to trichotomy, ` x R y \/ x = y \/ y R x ` . (Contributed by NM, 21-Jan-1996.) (Revised by Jim Kingdon, 4-Oct-2018.)
axiom df_iso {x3 y1 z: setvar} (A2 R: class):
  $ wb (wor A2 R) (wa (wpo A2 R) (wral x3 (wral y1 (wral z (wi (wbr (cv x3) (cv y1) R) (wo (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) R))) A2) A2) A2)) $;

--| Subset theorem for the partial ordering predicate. (Contributed by NM, 27-Mar-1997.) (Proof shortened by Mario Carneiro, 18-Nov-2016.)
theorem poss (A2 B2 R: class):
  $ wi (wss A2 B2) (wi (wpo B2 R) (wpo A2 R)) $;

--| Equality theorem for partial ordering predicate. (Contributed by NM, 27-Mar-1997.)
theorem poeq1 (A2 R S: class):
  $ wi (wceq R S) (wb (wpo A2 R) (wpo A2 S)) $;

--| Equality theorem for partial ordering predicate. (Contributed by NM, 27-Mar-1997.)
theorem poeq2 (A2 B2 R: class):
  $ wi (wceq A2 B2) (wb (wpo A2 R) (wpo B2 R)) $;

--| Bound-variable hypothesis builder for partial orders. (Contributed by Stefan O'Rear, 20-Jan-2015.)
theorem nfpo {x3: setvar} (A2 R: class x3):
  $ wnfc x3 R $ >
  $ wnfc x3 A2 $ >
  $ wnf x3 (wpo A2 R) $;

--| Bound-variable hypothesis builder for total orders. (Contributed by Stefan O'Rear, 20-Jan-2015.)
theorem nfso {x3: setvar} (A2 R: class x3):
  $ wnfc x3 R $ >
  $ wnfc x3 A2 $ >
  $ wnf x3 (wor A2 R) $;

--| Properties of partial order relation in class notation. (Contributed by NM, 27-Mar-1997.)
theorem pocl (A2 B2 C D R: class):
  $ wi (wpo A2 R) (wi (w3a (wcel B2 A2) (wcel C A2) (wcel D A2)) (wa (wn (wbr B2 B2 R)) (wi (wa (wbr B2 C R) (wbr C D R)) (wbr B2 D R)))) $;

--| Sufficient conditions for a partial order. (Contributed by NM, 9-Jul-2014.)
theorem ispod {x3 y1 z: setvar} (ph: wff) (A2 R: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wn (wbr (cv x3) (cv x3) R)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) A2) (wcel (cv y1) A2) (wcel (cv z) A2))) (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R)) (wbr (cv x3) (cv z) R)) $ >
  $ wi ph (wpo A2 R) $;

--| Perform the substitutions into the strict weak ordering law. (Contributed by Mario Carneiro, 31-Dec-2014.)
theorem swopolem {x3 y1 z: setvar} (ph: wff) (A2 R X: class) (Y: class x3) (Z: class x3 y1):
  $ wi (wa ph (w3a (wcel (cv x3) A2) (wcel (cv y1) A2) (wcel (cv z) A2))) (wi (wbr (cv x3) (cv y1) R) (wo (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) R))) $ >
  $ wi (wa ph (w3a (wcel X A2) (wcel Y A2) (wcel Z A2))) (wi (wbr X Y R) (wo (wbr X Z R) (wbr Z Y R))) $;

--| A strict weak order is a partial order. (Contributed by Mario Carneiro, 9-Jul-2014.)
theorem swopo {x3 y1 z: setvar} (ph: wff) (A2 R: class):
  $ wi (wa ph (wa (wcel (cv y1) A2) (wcel (cv z) A2))) (wi (wbr (cv y1) (cv z) R) (wn (wbr (cv z) (cv y1) R))) $ >
  $ wi (wa ph (w3a (wcel (cv x3) A2) (wcel (cv y1) A2) (wcel (cv z) A2))) (wi (wbr (cv x3) (cv y1) R) (wo (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) R))) $ >
  $ wi ph (wpo A2 R) $;

--| A partial order relation is irreflexive. (Contributed by NM, 27-Mar-1997.)
theorem poirr (A2 B2 R: class):
  $ wi (wa (wpo A2 R) (wcel B2 A2)) (wn (wbr B2 B2 R)) $;

--| A partial order relation is a transitive relation. (Contributed by NM, 27-Mar-1997.)
theorem potr (A2 B2 C D R: class):
  $ wi (wa (wpo A2 R) (w3a (wcel B2 A2) (wcel C A2) (wcel D A2))) (wi (wa (wbr B2 C R) (wbr C D R)) (wbr B2 D R)) $;

--| A partial order relation has no 2-cycle loops. (Contributed by NM, 27-Mar-1997.)
theorem po2nr (A2 B2 C R: class):
  $ wi (wa (wpo A2 R) (wa (wcel B2 A2) (wcel C A2))) (wn (wa (wbr B2 C R) (wbr C B2 R))) $;

--| A partial order relation has no 3-cycle loops. (Contributed by NM, 27-Mar-1997.)
theorem po3nr (A2 B2 C D R: class):
  $ wi (wa (wpo A2 R) (w3a (wcel B2 A2) (wcel C A2) (wcel D A2))) (wn (w3a (wbr B2 C R) (wbr C D R) (wbr D B2 R))) $;

--| Any relation is a partial ordering of the empty set. (Contributed by NM, 28-Mar-1997.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem po0 (R: class):
  $ wpo c0 R $;

--| A function preserves a partial order relation. (Contributed by Jeff Madsen, 18-Jun-2011.)
theorem pofun {x3 y1: setvar} (A2 B2: class y1) (R: class) (S: class x3 y1) (X: class x3) (Y: class y1):
  $ wceq S (copab x3 y1 (wbr X Y R)) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq X Y) $ >
  $ wi (wa (wpo B2 R) (wral x3 (wcel X B2) A2)) (wpo A2 S) $;

--| A strict linear order is a strict partial order. (Contributed by NM, 28-Mar-1997.)
theorem sopo (A2 R: class):
  $ wi (wor A2 R) (wpo A2 R) $;

--| Subset theorem for the strict ordering predicate. (Contributed by NM, 16-Mar-1997.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem soss (A2 B2 R: class):
  $ wi (wss A2 B2) (wi (wor B2 R) (wor A2 R)) $;

--| Equality theorem for the strict ordering predicate. (Contributed by NM, 16-Mar-1997.)
theorem soeq1 (A2 R S: class):
  $ wi (wceq R S) (wb (wor A2 R) (wor A2 S)) $;

--| Equality theorem for the strict ordering predicate. (Contributed by NM, 16-Mar-1997.)
theorem soeq2 (A2 B2 R: class):
  $ wi (wceq A2 B2) (wb (wor A2 R) (wor B2 R)) $;

--| A strict order relation is irreflexive. (Contributed by NM, 24-Nov-1995.)
theorem sonr (A2 B2 R: class):
  $ wi (wa (wor A2 R) (wcel B2 A2)) (wn (wbr B2 B2 R)) $;

--| A strict order relation is a transitive relation. (Contributed by NM, 21-Jan-1996.)
theorem sotr (A2 B2 C D R: class):
  $ wi (wa (wor A2 R) (w3a (wcel B2 A2) (wcel C A2) (wcel D A2))) (wi (wa (wbr B2 C R) (wbr C D R)) (wbr B2 D R)) $;

--| An irreflexive, transitive, trichotomous relation is a linear ordering (in the sense of ~ df-iso ). (Contributed by NM, 21-Jan-1996.) (Revised by Mario Carneiro, 9-Jul-2014.)
theorem issod {x3 y1: setvar} (ph: wff) (A2 R: class):
  $ wi ph (wpo A2 R) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) A2))) (w3o (wbr (cv x3) (cv y1) R) (wceq (cv x3) (cv y1)) (wbr (cv y1) (cv x3) R)) $ >
  $ wi ph (wor A2 R) $;

--| A strict order relation satisfies weak linearity. (Contributed by Jim Kingdon, 6-Oct-2018.)
theorem sowlin (A2 B2 C D R: class):
  $ wi (wa (wor A2 R) (w3a (wcel B2 A2) (wcel C A2) (wcel D A2))) (wi (wbr B2 C R) (wo (wbr B2 D R) (wbr D C R))) $;

--| A strict order relation has no 2-cycle loops. (Contributed by NM, 21-Jan-1996.)
theorem so2nr (A2 B2 C R: class):
  $ wi (wa (wor A2 R) (wa (wcel B2 A2) (wcel C A2))) (wn (wa (wbr B2 C R) (wbr C B2 R))) $;

--| A strict order relation has no 3-cycle loops. (Contributed by NM, 21-Jan-1996.)
theorem so3nr (A2 B2 C D R: class):
  $ wi (wa (wor A2 R) (w3a (wcel B2 A2) (wcel C A2) (wcel D A2))) (wn (w3a (wbr B2 C R) (wbr C D R) (wbr D B2 R))) $;

--| One direction of ~ sotritric holds for all weakly linear orders. (Contributed by Jim Kingdon, 28-Sep-2019.)
theorem sotricim (A2 B2 C R: class):
  $ wi (wa (wor A2 R) (wa (wcel B2 A2) (wcel C A2))) (wi (wbr B2 C R) (wn (wo (wceq B2 C) (wbr C B2 R)))) $;

--| A trichotomy relationship, given a trichotomous order. (Contributed by Jim Kingdon, 28-Sep-2019.)
theorem sotritric (A2 B2 C R: class):
  $ wor A2 R $ >
  $ wi (wa (wcel B2 A2) (wcel C A2)) (w3o (wbr B2 C R) (wceq B2 C) (wbr C B2 R)) $ >
  $ wi (wa (wcel B2 A2) (wcel C A2)) (wb (wbr B2 C R) (wn (wo (wceq B2 C) (wbr C B2 R)))) $;

--| A trichotomy relationship, given a trichotomous order. (Contributed by Jim Kingdon, 13-Dec-2019.)
theorem sotritrieq (A2 B2 C R: class):
  $ wor A2 R $ >
  $ wi (wa (wcel B2 A2) (wcel C A2)) (w3o (wbr B2 C R) (wceq B2 C) (wbr C B2 R)) $ >
  $ wi (wa (wcel B2 A2) (wcel C A2)) (wb (wceq B2 C) (wn (wo (wbr B2 C R) (wbr C B2 R)))) $;

--| Any relation is a strict ordering of the empty set. (Contributed by NM, 16-Mar-1997.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem so0 (R: class):
  $ wor c0 R $;

--| Extend wff notation to include the well-founded predicate.
term wfrfor (A2 R S: class): wff;

--| Extend wff notation to include the well-founded predicate. Read: ' ` R ` is a well-founded relation on ` A ` .'
term wfr (A2 R: class): wff;

--| Extend wff notation to include the set-like predicate. Read: ' ` R ` is set-like on ` A ` .'
term wse (A2 R: class): wff;

--| Extend wff notation to include the well-ordering predicate. Read: ' ` R ` well-orders ` A ` .'
term wwe (A2 R: class): wff;

--| Define the well-founded relation predicate where ` A ` might be a proper class. By passing in ` S ` we allow it potentially to be a proper class rather than a set. (Contributed by Jim Kingdon and Mario Carneiro, 22-Sep-2021.)
axiom df_frfor {x3 y1: setvar} (A2 R S: class):
  $ wb (wfrfor A2 R S) (wi (wral x3 (wi (wral y1 (wi (wbr (cv y1) (cv x3) R) (wcel (cv y1) S)) A2) (wcel (cv x3) S)) A2) (wss A2 S)) $;

--| Define the well-founded relation predicate. In the presence of excluded middle, there are a variety of equivalent ways to define this. In our case, this definition, in terms of an inductive principle, works better than one along the lines of "there is an element which is minimal when A is ordered by R". Because ` s ` is constrained to be a set (not a proper class) here, sometimes it may be necessary to use ` FrFor ` directly rather than via ` Fr ` . (Contributed by Jim Kingdon and Mario Carneiro, 21-Sep-2021.)
axiom df_frind {s1: setvar} (A2 R: class):
  $ wb (wfr A2 R) (wal s1 (wfrfor A2 R (cv s1))) $;

--| Define the set-like predicate. (Contributed by Mario Carneiro, 19-Nov-2014.)
axiom df_se {x3 y1: setvar} (A2 R: class):
  $ wb (wse A2 R) (wral x3 (wcel (crab y1 (wbr (cv y1) (cv x3) R) A2) cvv) A2) $;

--| Define the well-ordering predicate. It is unusual to define "well-ordering" in the absence of excluded middle, but we mean an ordering which is like the ordering which we have for ordinals (for example, it does not entail trichotomy because ordinals don't have that as seen at ~ ordtriexmid ). Given excluded middle, well-ordering is usually defined to require trichotomy (and the defintion of ` Fr ` is typically also different). (Contributed by Mario Carneiro and Jim Kingdon, 23-Sep-2021.)
axiom df_wetr {x3 y1 z: setvar} (A2 R: class):
  $ wb (wwe A2 R) (wa (wfr A2 R) (wral x3 (wral y1 (wral z (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R)) (wbr (cv x3) (cv z) R)) A2) A2) A2)) $;

--| The ` R ` -preimage of an element of the base set in a set-like relation is a set. (Contributed by Mario Carneiro, 19-Nov-2014.)
theorem seex {x3: setvar} (A2 B2 R: class):
  $ wi (wa (wse A2 R) (wcel B2 A2)) (wcel (crab x3 (wbr (cv x3) B2 R) A2) cvv) $;

--| Any relation on a set is set-like on it. (Contributed by Mario Carneiro, 22-Jun-2015.)
theorem exse (A2 R V: class):
  $ wi (wcel A2 V) (wse A2 R) $;

--| Subset theorem for the set-like predicate. (Contributed by Mario Carneiro, 24-Jun-2015.)
theorem sess1 (A2 R S: class):
  $ wi (wss R S) (wi (wse A2 S) (wse A2 R)) $;

--| Subset theorem for the set-like predicate. (Contributed by Mario Carneiro, 24-Jun-2015.)
theorem sess2 (A2 B2 R: class):
  $ wi (wss A2 B2) (wi (wse B2 R) (wse A2 R)) $;

--| Equality theorem for the set-like predicate. (Contributed by Mario Carneiro, 24-Jun-2015.)
theorem seeq1 (A2 R S: class):
  $ wi (wceq R S) (wb (wse A2 R) (wse A2 S)) $;

--| Equality theorem for the set-like predicate. (Contributed by Mario Carneiro, 24-Jun-2015.)
theorem seeq2 (A2 B2 R: class):
  $ wi (wceq A2 B2) (wb (wse A2 R) (wse B2 R)) $;

--| Bound-variable hypothesis builder for set-like relations. (Contributed by Mario Carneiro, 24-Jun-2015.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem nfse {x3: setvar} (A2 R: class x3):
  $ wnfc x3 R $ >
  $ wnfc x3 A2 $ >
  $ wnf x3 (wse A2 R) $;

--| The epsilon relation is set-like on any class. (This is the origin of the term "set-like": a set-like relation "acts like" the epsilon relation of sets and their elements.) (Contributed by Mario Carneiro, 22-Jun-2015.)
theorem epse (A2: class):
  $ wse A2 cep $;

--| Equality theorem for the well-founded predicate. (Contributed by Jim Kingdon, 22-Sep-2021.)
theorem frforeq1 (A2 R S T: class):
  $ wi (wceq R S) (wb (wfrfor A2 R T) (wfrfor A2 S T)) $;

--| Equality theorem for the well-founded predicate. (Contributed by NM, 9-Mar-1997.)
theorem freq1 (A2 R S: class):
  $ wi (wceq R S) (wb (wfr A2 R) (wfr A2 S)) $;

--| Equality theorem for the well-founded predicate. (Contributed by Jim Kingdon, 22-Sep-2021.)
theorem frforeq2 (A2 B2 R T: class):
  $ wi (wceq A2 B2) (wb (wfrfor A2 R T) (wfrfor B2 R T)) $;

--| Equality theorem for the well-founded predicate. (Contributed by NM, 3-Apr-1994.)
theorem freq2 (A2 B2 R: class):
  $ wi (wceq A2 B2) (wb (wfr A2 R) (wfr B2 R)) $;

--| Equality theorem for the well-founded predicate. (Contributed by Jim Kingdon, 22-Sep-2021.)
theorem frforeq3 (A2 R S T: class):
  $ wi (wceq S T) (wb (wfrfor A2 R S) (wfrfor A2 R T)) $;

--| Bound-variable hypothesis builder for well-founded relations. (Contributed by Stefan O'Rear, 20-Jan-2015.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem nffrfor {x3: setvar} (A2 R S: class x3):
  $ wnfc x3 R $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 S $ >
  $ wnf x3 (wfrfor A2 R S) $;

--| Bound-variable hypothesis builder for well-founded relations. (Contributed by Stefan O'Rear, 20-Jan-2015.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem nffr {x3: setvar} (A2 R: class x3):
  $ wnfc x3 R $ >
  $ wnfc x3 A2 $ >
  $ wnf x3 (wfr A2 R) $;

--| A well-founded relation is irreflexive. This is the case where ` A ` exists. (Contributed by Jim Kingdon, 21-Sep-2021.)
theorem frirrg (A2 B2 R V: class):
  $ wi (w3a (wfr A2 R) (wcel A2 V) (wcel B2 A2)) (wn (wbr B2 B2 R)) $;

--| Any relation is well-founded on the empty set. (Contributed by NM, 17-Sep-1993.)
theorem fr0 (R: class):
  $ wfr c0 R $;

--| Induction over a well-founded set. (Contributed by Jim Kingdon, 28-Sep-2021.)
theorem frind {x3 y1: setvar} (ph: wff x3) (ps ch: wff y1) (A2 R: class) (V: class x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wa ch (wcel (cv x3) A2)) (wi (wral y1 (wi (wbr (cv y1) (cv x3) R) ps) A2) ph) $ >
  $ wi ch (wfr A2 R) $ >
  $ wi ch (wcel A2 V) $ >
  $ wi (wa ch (wcel (cv x3) A2)) ph $;

--| Irreflexivity of the epsilon relation: a class founded by epsilon is not a member of itself. (Contributed by NM, 18-Apr-1994.) (Revised by Mario Carneiro, 22-Jun-2015.)
theorem efrirr (A2: class):
  $ wi (wfr A2 cep) (wn (wcel A2 A2)) $;

--| Similar to Theorem 7.2 of [TakeutiZaring] p. 35, of except that the Axiom of Regularity is not required due to antecedent ` _E Fr A ` . (Contributed by NM, 4-May-1994.)
theorem tz7_2 (A2 B2: class):
  $ wi (w3a (wtr A2) (wfr A2 cep) (wcel B2 A2)) (wa (wss B2 A2) (wne B2 A2)) $;

--| Bound-variable hypothesis builder for well-orderings. (Contributed by Stefan O'Rear, 20-Jan-2015.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem nfwe {x3: setvar} (A2 R: class x3):
  $ wnfc x3 R $ >
  $ wnfc x3 A2 $ >
  $ wnf x3 (wwe A2 R) $;

--| Equality theorem for the well-ordering predicate. (Contributed by NM, 9-Mar-1997.)
theorem weeq1 (A2 R S: class):
  $ wi (wceq R S) (wb (wwe A2 R) (wwe A2 S)) $;

--| Equality theorem for the well-ordering predicate. (Contributed by NM, 3-Apr-1994.)
theorem weeq2 (A2 B2 R: class):
  $ wi (wceq A2 B2) (wb (wwe A2 R) (wwe B2 R)) $;

--| A well-ordering is well-founded. (Contributed by NM, 22-Apr-1994.)
theorem wefr (A2 R: class):
  $ wi (wwe A2 R) (wfr A2 R) $;

--| A well-ordering is a partial ordering. (Contributed by Jim Kingdon, 23-Sep-2021.)
theorem wepo (A2 R V: class):
  $ wi (wa (wwe A2 R) (wcel A2 V)) (wpo A2 R) $;

--| An epsilon well-ordering is a transitive relation. (Contributed by NM, 22-Apr-1994.)
theorem wetrep {x3 y1 z: setvar} (A2: class):
  $ wi (wa (wwe A2 cep) (w3a (wcel (cv x3) A2) (wcel (cv y1) A2) (wcel (cv z) A2))) (wi (wa (wcel (cv x3) (cv y1)) (wcel (cv y1) (cv z))) (wcel (cv x3) (cv z))) $;

--| Any relation is a well-ordering of the empty set. (Contributed by NM, 16-Mar-1997.)
theorem we0 (R: class):
  $ wwe c0 R $;

--| Extend the definition of a wff to include the ordinal predicate.
term word (A2: class): wff;

--| Extend the definition of a class to include the class of all ordinal numbers. (The 0 in the name prevents creating a file called con.html, which causes problems in Windows.)
term con0: class;

--| Extend the definition of a wff to include the limit ordinal predicate.
term wlim (A2: class): wff;

--| Extend class notation to include the successor function.
term csuc (A2: class): class;

--| Define the ordinal predicate, which is true for a class that is transitive and whose elements are transitive. Definition of ordinal in [Crosilla], p. "Set-theoretic principles incompatible with intuitionistic logic". (Contributed by Jim Kingdon, 10-Oct-2018.) Use its alias ~ dford3 instead for naming consistency with set.mm. (New usage is discouraged.)
axiom df_iord {x3: setvar} (A2: class):
  $ wb (word A2) (wa (wtr A2) (wral x3 (wtr (cv x3)) A2)) $;

--| Alias for ~ df-iord . Use it instead of ~ df-iord for naming consistency with set.mm. (Contributed by Jim Kingdon, 10-Oct-2018.)
theorem dford3 {x3: setvar} (A2: class):
  $ wb (word A2) (wa (wtr A2) (wral x3 (wtr (cv x3)) A2)) $;

--| Define the class of all ordinal numbers. Definition 7.11 of [TakeutiZaring] p. 38. (Contributed by NM, 5-Jun-1994.)
axiom df_on {x3: setvar}:
  $ wceq con0 (cab x3 (word (cv x3))) $;

--| Define the limit ordinal predicate, which is true for an ordinal that has the empty set as an element and is not a successor (i.e. that is the union of itself). Our definition combines the definition of Lim of [BellMachover] p. 471 and Exercise 1 of [TakeutiZaring] p. 42, and then changes ` A =/= (/) ` to ` (/) e. A ` (which would be equivalent given the law of the excluded middle, but which is not for us). (Contributed by Jim Kingdon, 11-Nov-2018.) Use its alias ~ dflim2 instead for naming consistency with set.mm. (New usage is discouraged.)
axiom df_ilim (A2: class):
  $ wb (wlim A2) (w3a (word A2) (wcel c0 A2) (wceq A2 (cuni A2))) $;

--| Alias for ~ df-ilim . Use it instead of ~ df-ilim for naming consistency with set.mm. (Contributed by NM, 4-Nov-2004.)
theorem dflim2 (A2: class):
  $ wb (wlim A2) (w3a (word A2) (wcel c0 A2) (wceq A2 (cuni A2))) $;

--| Define the successor of a class. When applied to an ordinal number, the successor means the same thing as "plus 1". Definition 7.22 of [TakeutiZaring] p. 41, who use "+ 1" to denote this function. Our definition is a generalization to classes. Although it is not conventional to use it with proper classes, it has no effect on a proper class ( ~ sucprc ). Some authors denote the successor operation with a prime (apostrophe-like) symbol, such as Definition 6 of [Suppes] p. 134 and the definition of successor in [Mendelson] p. 246 (who uses the symbol "Suc" as a predicate to mean "is a successor ordinal"). The definition of successor of [Enderton] p. 68 denotes the operation with a plus-sign superscript. (Contributed by NM, 30-Aug-1993.)
axiom df_suc (A2: class):
  $ wceq (csuc A2) (cun A2 (csn A2)) $;

--| Equality theorem for the ordinal predicate. (Contributed by NM, 17-Sep-1993.)
theorem ordeq (A2 B2: class):
  $ wi (wceq A2 B2) (wb (word A2) (word B2)) $;

--| An ordinal number is an ordinal set. (Contributed by NM, 5-Jun-1994.)
theorem elong (A2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 con0) (word A2)) $;

--| An ordinal number is an ordinal set. (Contributed by NM, 5-Jun-1994.)
theorem elon (A2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 con0) (word A2) $;

--| An ordinal number has the ordinal property. (Contributed by NM, 5-Jun-1994.)
theorem eloni (A2: class):
  $ wi (wcel A2 con0) (word A2) $;

--| An ordinal number is an ordinal set. (Contributed by NM, 8-Feb-2004.)
theorem elon2 (A2: class):
  $ wb (wcel A2 con0) (wa (word A2) (wcel A2 cvv)) $;

--| Equality theorem for the limit predicate. (Contributed by NM, 22-Apr-1994.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem limeq (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wlim A2) (wlim B2)) $;

--| An ordinal class is transitive. (Contributed by NM, 3-Apr-1994.)
theorem ordtr (A2: class):
  $ wi (word A2) (wtr A2) $;

--| An element of an ordinal class is a subset of it. (Contributed by NM, 30-May-1994.)
theorem ordelss (A2 B2: class):
  $ wi (wa (word A2) (wcel B2 A2)) (wss B2 A2) $;

--| A transitive subclass of an ordinal class is ordinal. (Contributed by NM, 29-May-1994.)
theorem trssord (A2 B2: class):
  $ wi (w3a (wtr A2) (wss A2 B2) (word B2)) (word A2) $;

--| An element of an ordinal class is ordinal. Proposition 7.6 of [TakeutiZaring] p. 36. (Contributed by NM, 23-Apr-1994.)
theorem ordelord (A2 B2: class):
  $ wi (wa (word A2) (wcel B2 A2)) (word B2) $;

--| The class of all ordinal numbers is transitive. (Contributed by NM, 4-May-2009.)
theorem tron:
  $ wtr con0 $;

--| An element of an ordinal class is an ordinal number. (Contributed by NM, 26-Oct-2003.)
theorem ordelon (A2 B2: class):
  $ wi (wa (word A2) (wcel B2 A2)) (wcel B2 con0) $;

--| An element of an ordinal number is an ordinal number. Theorem 2.2(iii) of [BellMachover] p. 469. (Contributed by NM, 26-Oct-2003.)
theorem onelon (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 A2)) (wcel B2 con0) $;

--| The intersection of two ordinal classes is ordinal. Proposition 7.9 of [TakeutiZaring] p. 37. (Contributed by NM, 9-May-1994.)
theorem ordin (A2 B2: class):
  $ wi (wa (word A2) (word B2)) (word (cin A2 B2)) $;

--| The intersection of two ordinal numbers is an ordinal number. (Contributed by NM, 7-Apr-1995.)
theorem onin (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wcel (cin A2 B2) con0) $;

--| An element of an ordinal number is a subset of the number. (Contributed by NM, 5-Jun-1994.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem onelss (A2 B2: class):
  $ wi (wcel A2 con0) (wi (wcel B2 A2) (wss B2 A2)) $;

--| Transitive law for ordinal classes. (Contributed by NM, 12-Dec-2004.)
theorem ordtr1 (A2 B2 C: class):
  $ wi (word C) (wi (wa (wcel A2 B2) (wcel B2 C)) (wcel A2 C)) $;

--| Transitive law for ordinal numbers. Theorem 7M(b) of [Enderton] p. 192. (Contributed by NM, 11-Aug-1994.)
theorem ontr1 (A2 B2 C: class):
  $ wi (wcel C con0) (wi (wa (wcel A2 B2) (wcel B2 C)) (wcel A2 C)) $;

--| If a property is true for an ordinal number, then the minimum ordinal number for which it is true is smaller or equal. Theorem Schema 61 of [Suppes] p. 228. (Contributed by NM, 3-Oct-2003.)
theorem onintss {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 con0) (wi ps (wss (cint (crab x3 ph con0)) A2)) $;

--| The empty set is an ordinal class. (Contributed by NM, 11-May-1994.)
theorem ord0:
  $ word c0 $;

--| The empty set is an ordinal number. Corollary 7N(b) of [Enderton] p. 193. (Contributed by NM, 17-Sep-1993.)
theorem _0elon:
  $ wcel c0 con0 $;

--| The intersection of the class of ordinal numbers is the empty set. (Contributed by NM, 20-Oct-2003.)
theorem inton:
  $ wceq (cint con0) c0 $;

--| The empty set is not a limit ordinal. (Contributed by NM, 24-Mar-1995.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem nlim0:
  $ wn (wlim c0) $;

--| A limit ordinal is ordinal. (Contributed by NM, 4-May-1995.)
theorem limord (A2: class):
  $ wi (wlim A2) (word A2) $;

--| A limit ordinal is its own supremum (union). (Contributed by NM, 4-May-1995.)
theorem limuni (A2: class):
  $ wi (wlim A2) (wceq A2 (cuni A2)) $;

--| The union of a limit ordinal is a limit ordinal. (Contributed by NM, 19-Sep-2006.)
theorem limuni2 (A2: class):
  $ wi (wlim A2) (wlim (cuni A2)) $;

--| A limit ordinal contains the empty set. (Contributed by NM, 15-May-1994.)
theorem _0ellim (A2: class):
  $ wi (wlim A2) (wcel c0 A2) $;

--| A limit ordinal class that is also a set is an ordinal number. (Contributed by NM, 26-Apr-2004.)
theorem limelon (A2 B2: class):
  $ wi (wa (wcel A2 B2) (wlim A2)) (wcel A2 con0) $;

--| The class of all ordinal numbers is not empty. (Contributed by NM, 17-Sep-1995.)
theorem onn0:
  $ wne con0 c0 $;

--| The class of all ordinal numbers is inhabited. (Contributed by Jim Kingdon, 6-Mar-2019.)
theorem onm {x3: setvar}:
  $ wex x3 (wcel (cv x3) con0) $;

--| Equality of successors. (Contributed by NM, 30-Aug-1993.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem suceq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (csuc A2) (csuc B2)) $;

--| Membership in a successor. This one-way implication does not require that either ` A ` or ` B ` be sets. (Contributed by NM, 6-Jun-1994.)
theorem elsuci (A2 B2: class):
  $ wi (wcel A2 (csuc B2)) (wo (wcel A2 B2) (wceq A2 B2)) $;

--| Membership in a successor. Exercise 5 of [TakeutiZaring] p. 17. (Contributed by NM, 15-Sep-1995.)
theorem elsucg (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (csuc B2)) (wo (wcel A2 B2) (wceq A2 B2))) $;

--| Variant of membership in a successor, requiring that ` B ` rather than ` A ` be a set. (Contributed by NM, 28-Oct-2003.)
theorem elsuc2g (A2 B2 V: class):
  $ wi (wcel B2 V) (wb (wcel A2 (csuc B2)) (wo (wcel A2 B2) (wceq A2 B2))) $;

--| Membership in a successor. Exercise 5 of [TakeutiZaring] p. 17. (Contributed by NM, 15-Sep-2003.)
theorem elsuc (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (csuc B2)) (wo (wcel A2 B2) (wceq A2 B2)) $;

--| Membership in a successor. (Contributed by NM, 15-Sep-2003.)
theorem elsuc2 (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel B2 (csuc A2)) (wo (wcel B2 A2) (wceq B2 A2)) $;

--| Bound-variable hypothesis builder for successor. (Contributed by NM, 15-Sep-2003.)
theorem nfsuc {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (csuc A2) $;

--| Membership in a successor. (Contributed by NM, 20-Jun-1998.)
theorem elelsuc (A2 B2: class):
  $ wi (wcel A2 B2) (wcel A2 (csuc B2)) $;

--| Membership of a successor in another class. (Contributed by NM, 29-Jun-2004.)
theorem sucel {x3 y1: setvar} (A2: class) (B2: class y1):
  $ wb (wcel (csuc A2) B2) (wrex x3 (wal y1 (wb (wcel (cv y1) (cv x3)) (wo (wcel (cv y1) A2) (wceq (cv y1) A2)))) B2) $;

--| The successor of the empty set. (Contributed by NM, 1-Feb-2005.)
theorem suc0:
  $ wceq (csuc c0) (csn c0) $;

--| A proper class is its own successor. (Contributed by NM, 3-Apr-1995.)
theorem sucprc (A2: class):
  $ wi (wn (wcel A2 cvv)) (wceq (csuc A2) A2) $;

--| A transitive class is equal to the union of its successor. Combines Theorem 4E of [Enderton] p. 72 and Exercise 6 of [Enderton] p. 73. (Contributed by NM, 30-Aug-1993.)
theorem unisuc (A2: class):
  $ wcel A2 cvv $ >
  $ wb (wtr A2) (wceq (cuni (csuc A2)) A2) $;

--| A transitive class is equal to the union of its successor. Combines Theorem 4E of [Enderton] p. 72 and Exercise 6 of [Enderton] p. 73. (Contributed by Jim Kingdon, 18-Aug-2019.)
theorem unisucg (A2 V: class):
  $ wi (wcel A2 V) (wb (wtr A2) (wceq (cuni (csuc A2)) A2)) $;

--| A class is included in its own successor. Part of Proposition 7.23 of [TakeutiZaring] p. 41 (generalized to arbitrary classes). (Contributed by NM, 31-May-1994.)
theorem sssucid (A2: class):
  $ wss A2 (csuc A2) $;

--| Part of Proposition 7.23 of [TakeutiZaring] p. 41 (generalized). (Contributed by NM, 25-Mar-1995.) (Proof shortened by Scott Fenton, 20-Feb-2012.)
theorem sucidg (A2 V: class):
  $ wi (wcel A2 V) (wcel A2 (csuc A2)) $;

--| A set belongs to its successor. (Contributed by NM, 22-Jun-1994.) (Proof shortened by Alan Sare, 18-Feb-2012.) (Proof shortened by Scott Fenton, 20-Feb-2012.)
theorem sucid (A2: class):
  $ wcel A2 cvv $ >
  $ wcel A2 (csuc A2) $;

--| No successor is empty. (Contributed by Jim Kingdon, 14-Oct-2018.)
theorem nsuceq0g (A2 V: class):
  $ wi (wcel A2 V) (wne (csuc A2) c0) $;

--| A set belongs to the successor of an equal set. (Contributed by NM, 18-Aug-1994.)
theorem eqelsuc (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq A2 B2) (wcel A2 (csuc B2)) $;

--| Inductive definition for the indexed union at a successor. (Contributed by Mario Carneiro, 4-Feb-2013.) (Proof shortened by Mario Carneiro, 18-Nov-2016.)
theorem iunsuc {x3: setvar} (A2: class) (B2: class x3) (C: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq (ciun x3 (csuc A2) B2) (cun (ciun x3 A2 B2) C) $;

--| The successor of a transitive class is transitive. (Contributed by Alan Sare, 11-Apr-2009.)
theorem suctr (A2: class):
  $ wi (wtr A2) (wtr (csuc A2)) $;

--| A set whose successor belongs to a transitive class also belongs. (Contributed by NM, 5-Sep-2003.) (Proof shortened by Andrew Salmon, 12-Aug-2011.)
theorem trsuc (A2 B2: class):
  $ wi (wa (wtr A2) (wcel (csuc B2) A2)) (wcel B2 A2) $;

--| A member of the successor of a transitive class is a subclass of it. (Contributed by NM, 4-Oct-2003.)
theorem trsucss (A2 B2: class):
  $ wi (wtr A2) (wi (wcel B2 (csuc A2)) (wss B2 A2)) $;

--| A set whose successor is a subset of another class is a member of that class. (Contributed by NM, 16-Sep-1995.)
theorem sucssel (A2 B2 V: class):
  $ wi (wcel A2 V) (wi (wss (csuc A2) B2) (wcel A2 B2)) $;

--| An ordinal class includes its union. (Contributed by NM, 13-Sep-2003.)
theorem orduniss (A2: class):
  $ wi (word A2) (wss (cuni A2) A2) $;

--| An ordinal number is an ordinal class. (Contributed by NM, 11-Jun-1994.)
theorem onordi (A2: class):
  $ wcel A2 con0 $ >
  $ word A2 $;

--| An ordinal number is a transitive class. (Contributed by NM, 11-Jun-1994.)
theorem ontrci (A2: class):
  $ wcel A2 con0 $ >
  $ wtr A2 $;

--| A member of an ordinal number is an ordinal number. Theorem 7M(a) of [Enderton] p. 192. (Contributed by NM, 11-Jun-1994.)
theorem oneli (A2 B2: class):
  $ wcel A2 con0 $ >
  $ wi (wcel B2 A2) (wcel B2 con0) $;

--| A member of an ordinal number is a subset of it. (Contributed by NM, 11-Aug-1994.)
theorem onelssi (A2 B2: class):
  $ wcel A2 con0 $ >
  $ wi (wcel B2 A2) (wss B2 A2) $;

--| An element of an ordinal number equals the intersection with it. (Contributed by NM, 11-Jun-1994.)
theorem onelini (A2 B2: class):
  $ wcel A2 con0 $ >
  $ wi (wcel B2 A2) (wceq B2 (cin B2 A2)) $;

--| An ordinal number equals its union with any element. (Contributed by NM, 13-Jun-1994.)
theorem oneluni (A2 B2: class):
  $ wcel A2 con0 $ >
  $ wi (wcel B2 A2) (wceq (cun A2 B2) A2) $;

--| An ordinal number is equal to the union of its successor. (Contributed by NM, 12-Jun-1994.)
theorem onunisuci (A2: class):
  $ wcel A2 con0 $ >
  $ wceq (cuni (csuc A2)) A2 $;

--| Axiom of Union. An axiom of Intuitionistic Zermelo-Fraenkel set theory. It states that a set ` y ` exists that includes the union of a given set ` x ` i.e. the collection of all members of the members of ` x ` . The variant ~ axun2 states that the union itself exists. A version with the standard abbreviation for union is ~ uniex2 . A version using class notation is ~ uniex . This is Axiom 3 of [Crosilla] p. "Axioms of CZF and IZF", except (a) unnecessary quantifiers are removed, (b) Crosilla has a biconditional rather than an implication (but the two are equivalent by ~ bm1.3ii ), and (c) the order of the conjuncts is swapped (which is equivalent by ~ ancom ). The union of a class ~ df-uni should not be confused with the union of two classes ~ df-un . Their relationship is shown in ~ unipr . (Contributed by NM, 23-Dec-1993.)
axiom ax_un {y1 z w: setvar} (x3: setvar):
  $ wex y1 (wal z (wi (wex w (wa (wcel (cv z) (cv w)) (wcel (cv w) (cv x3)))) (wcel (cv z) (cv y1)))) $;

--| Axiom of Union expressed with the fewest number of different variables. (Contributed by NM, 14-Aug-2003.)
theorem zfun {x3 y1: setvar} (z: setvar):
  $ wex x3 (wal y1 (wi (wex x3 (wa (wcel (cv y1) (cv x3)) (wcel (cv x3) (cv z)))) (wcel (cv y1) (cv x3)))) $;

--| A variant of the Axiom of Union ~ ax-un . For any set ` x ` , there exists a set ` y ` whose members are exactly the members of the members of ` x ` i.e. the union of ` x ` . Axiom Union of [BellMachover] p. 466. (Contributed by NM, 4-Jun-2006.)
theorem axun2 {y1 z w: setvar} (x3: setvar):
  $ wex y1 (wal z (wb (wcel (cv z) (cv y1)) (wex w (wa (wcel (cv z) (cv w)) (wcel (cv w) (cv x3)))))) $;

--| The Axiom of Union using the standard abbreviation for union. Given any set ` x ` , its union ` y ` exists. (Contributed by NM, 4-Jun-2006.)
theorem uniex2 {y1: setvar} (x3: setvar):
  $ wex y1 (wceq (cv y1) (cuni (cv x3))) $;

--| The Axiom of Union in class notation. This says that if ` A ` is a set i.e. ` A e. _V ` (see ~ isset ), then the union of ` A ` is also a set. Same as Axiom 3 of [TakeutiZaring] p. 16. (Contributed by NM, 11-Aug-1993.)
theorem uniex (A2: class):
  $ wcel A2 cvv $ >
  $ wcel (cuni A2) cvv $;

--| The ZF Axiom of Union in class notation, in the form of a theorem instead of an inference. We use the antecedent ` A e. V ` instead of ` A e. _V ` to make the theorem more general and thus shorten some proofs; obviously the universal class constant ` _V ` is one possible substitution for class variable ` V ` . (Contributed by NM, 25-Nov-1994.)
theorem uniexg (A2 V: class):
  $ wi (wcel A2 V) (wcel (cuni A2) cvv) $;

--| The union of two sets is a set. Corollary 5.8 of [TakeutiZaring] p. 16. (Contributed by NM, 1-Jul-1994.)
theorem unex (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel (cun A2 B2) cvv $;

--| Existence of union is equivalent to existence of its components. (Contributed by NM, 11-Jun-1998.)
theorem unexb (A2 B2: class):
  $ wb (wa (wcel A2 cvv) (wcel B2 cvv)) (wcel (cun A2 B2) cvv) $;

--| A union of two sets is a set. Corollary 5.8 of [TakeutiZaring] p. 16. (Contributed by NM, 18-Sep-2006.)
theorem unexg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wcel (cun A2 B2) cvv) $;

--| An unordered triple of classes exists. (Contributed by NM, 10-Apr-1994.)
theorem tpexg (A2 B2 C U V W: class):
  $ wi (w3a (wcel A2 U) (wcel B2 V) (wcel C W)) (wcel (ctp A2 B2 C) cvv) $;

--| Union of a singleton in the form of a restricted class abstraction. (Contributed by NM, 3-Jul-2008.)
theorem unisn3 {x3: setvar} (A2 B2: class):
  $ wi (wcel A2 B2) (wceq (cuni (crab x3 (wceq (cv x3) A2) B2)) A2) $;

--| The class of all singletons is a proper class. (Contributed by NM, 10-Oct-2008.) (Proof shortened by Eric Schmidt, 7-Dec-2008.)
theorem snnex {x3 y1: setvar}:
  $ wnel (cab x3 (wex y1 (wceq (cv x3) (csn (cv y1))))) cvv $;

--| Each member of an ordered pair belongs to the union of the union of a class to which the ordered pair belongs. Lemma 3D of [Enderton] p. 41. (Contributed by NM, 31-Mar-1995.) (Revised by Mario Carneiro, 27-Feb-2016.)
theorem opeluu (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wcel (cop A2 B2) C) (wa (wcel A2 (cuni (cuni C))) (wcel B2 (cuni (cuni C)))) $;

--| Expression for double union that moves union into a class builder. (Contributed by FL, 28-May-2007.)
theorem uniuni {x3 y1: setvar} (A2: class):
  $ wceq (cuni (cuni A2)) (cuni (cab x3 (wex y1 (wa (wceq (cv x3) (cuni (cv y1))) (wcel (cv y1) A2))))) $;

--| Two ways to express single-valuedness of a class expression ` A ( x ) ` . (Contributed by NM, 14-Oct-2010.)
theorem eusv1 {x3 y1: setvar} (A2: class x3):
  $ wb (weu y1 (wal x3 (wceq (cv y1) A2))) (wex y1 (wal x3 (wceq (cv y1) A2))) $;

--| Even if ` x ` is free in ` A ` , it is effectively bound when ` A ( x ) ` is single-valued. (Contributed by NM, 14-Oct-2010.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem eusvnf {x3 y1: setvar} (A2: class x3):
  $ wi (weu y1 (wal x3 (wceq (cv y1) A2))) (wnfc x3 A2) $;

--| Two ways to say that ` A ( x ) ` is a set expression that does not depend on ` x ` . (Contributed by Mario Carneiro, 18-Nov-2016.)
theorem eusvnfb {x3 y1: setvar} (A2: class x3):
  $ wb (weu y1 (wal x3 (wceq (cv y1) A2))) (wa (wnfc x3 A2) (wcel A2 cvv)) $;

--| Two ways to express single-valuedness of a class expression ` A ( x ) ` . (Contributed by NM, 14-Oct-2010.) (Revised by Mario Carneiro, 18-Nov-2016.)
theorem eusv2i {x3 y1: setvar} (A2: class x3):
  $ wi (weu y1 (wal x3 (wceq (cv y1) A2))) (weu y1 (wex x3 (wceq (cv y1) A2))) $;

--| Two ways to express single-valuedness of a class expression ` A ( x ) ` . (Contributed by Mario Carneiro, 18-Nov-2016.)
theorem eusv2nf {x3 y1: setvar} (A2: class x3):
  $ wcel A2 cvv $ >
  $ wb (weu y1 (wex x3 (wceq (cv y1) A2))) (wnfc x3 A2) $;

--| Two ways to express single-valuedness of a class expression ` A ( x ) ` . (Contributed by NM, 15-Oct-2010.) (Proof shortened by Mario Carneiro, 18-Nov-2016.)
theorem eusv2 {x3 y1: setvar} (A2: class x3):
  $ wcel A2 cvv $ >
  $ wb (weu y1 (wex x3 (wceq (cv y1) A2))) (weu y1 (wal x3 (wceq (cv y1) A2))) $;

--| Two ways to express single-valuedness of a class expression ` C ( y ) ` . (Contributed by NM, 16-Dec-2012.) (Proof shortened by Mario Carneiro, 18-Nov-2016.)
theorem reusv1 {x3 y1: setvar} (ph: wff y1) (A2 B2 C: class y1):
  $ wi (wrex y1 ph B2) (wb (wreu x3 (wral y1 (wi ph (wceq (cv x3) C)) B2) A2) (wrex x3 (wral y1 (wi ph (wceq (cv x3) C)) B2) A2)) $;

--| Two ways of expressing existential uniqueness via an indirect equality. (Contributed by NM, 23-Dec-2012.)
theorem reusv3i {x3 y1 z: setvar} (ph: wff y1) (ps: wff z) (A2: class x3 y1 z) (B2: class) (C: class y1) (D: class z):
  $ wi (wceq (cv y1) (cv z)) (wb ph ps) $ >
  $ wi (wceq (cv y1) (cv z)) (wceq C D) $ >
  $ wi (wrex x3 (wral y1 (wi ph (wceq (cv x3) C)) B2) A2) (wral y1 (wral z (wi (wa ph ps) (wceq C D)) B2) B2) $;

--| Two ways to express single-valuedness of a class expression ` C ( y ) ` . See ~ reusv1 for the connection to uniqueness. (Contributed by NM, 27-Dec-2012.)
theorem reusv3 {x3 y1 z: setvar} (ph: wff y1) (ps: wff z) (A2 B2: class) (C: class y1) (D: class z):
  $ wi (wceq (cv y1) (cv z)) (wb ph ps) $ >
  $ wi (wceq (cv y1) (cv z)) (wceq C D) $ >
  $ wi (wrex y1 (wa ph (wcel C A2)) B2) (wb (wral y1 (wral z (wi (wa ph ps) (wceq C D)) B2) B2) (wrex x3 (wral y1 (wi ph (wceq (cv x3) C)) B2) A2)) $;

--| Transfer universal quantification from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by NM, 18-Feb-2007.)
theorem alxfr {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class y1) (B2: class x3 y1):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wa (wal y1 (wcel A2 B2)) (wal x3 (wex y1 (wceq (cv x3) A2)))) (wb (wal x3 ph) (wal y1 ps)) $;

--| Transfer universal quantification from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by NM, 15-Aug-2014.) (Proof shortened by Mario Carneiro, 19-Nov-2016.)
theorem ralxfrd {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class y1) (B2: class) (C: class y1):
  $ wi (wa ph (wcel (cv y1) C)) (wcel A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wrex y1 (wceq (cv x3) A2) C) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps B2) (wral y1 ch C)) $;

--| Transfer universal quantification from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by FL, 10-Apr-2007.) (Revised by Mario Carneiro, 15-Aug-2014.)
theorem rexxfrd {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class y1) (B2: class) (C: class y1):
  $ wi (wa ph (wcel (cv y1) C)) (wcel A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wrex y1 (wceq (cv x3) A2) C) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps B2) (wrex y1 ch C)) $;

--| Transfer universal quantification from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by Mario Carneiro, 20-Aug-2014.)
theorem ralxfr2d {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class y1) (B2: class) (C: class y1) (V: class x3 y1):
  $ wi (wa ph (wcel (cv y1) C)) (wcel A2 V) $ >
  $ wi ph (wb (wcel (cv x3) B2) (wrex y1 (wceq (cv x3) A2) C)) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps B2) (wral y1 ch C)) $;

--| Transfer universal quantification from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by Mario Carneiro, 20-Aug-2014.) (Proof shortened by Mario Carneiro, 19-Nov-2016.)
theorem rexxfr2d {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class y1) (B2: class) (C: class y1) (V: class x3 y1):
  $ wi (wa ph (wcel (cv y1) C)) (wcel A2 V) $ >
  $ wi ph (wb (wcel (cv x3) B2) (wrex y1 (wceq (cv x3) A2) C)) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps B2) (wrex y1 ch C)) $;

--| Transfer universal quantification from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by NM, 10-Jun-2005.) (Revised by Mario Carneiro, 15-Aug-2014.)
theorem ralxfr {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class y1) (B2: class) (C: class y1):
  $ wi (wcel (cv y1) C) (wcel A2 B2) $ >
  $ wi (wcel (cv x3) B2) (wrex y1 (wceq (cv x3) A2) C) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wral x3 ph B2) (wral y1 ps C) $;

--| Transfer universal quantification from a variable ` x ` to another variable ` y ` contained in expression ` A ` . This proof does not use ~ ralxfrd . (Contributed by NM, 10-Jun-2005.) (Revised by Mario Carneiro, 15-Aug-2014.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ralxfrALT {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class y1) (B2: class) (C: class y1):
  $ wi (wcel (cv y1) C) (wcel A2 B2) $ >
  $ wi (wcel (cv x3) B2) (wrex y1 (wceq (cv x3) A2) C) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wral x3 ph B2) (wral y1 ps C) $;

--| Transfer existence from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by NM, 10-Jun-2005.) (Revised by Mario Carneiro, 15-Aug-2014.)
theorem rexxfr {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class y1) (B2: class) (C: class y1):
  $ wi (wcel (cv y1) C) (wcel A2 B2) $ >
  $ wi (wcel (cv x3) B2) (wrex y1 (wceq (cv x3) A2) C) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wrex x3 ph B2) (wrex y1 ps C) $;

--| Class builder membership after substituting an expression ` A ` (containing ` y ` ) for ` x ` in the class expression ` ch ` . (Contributed by NM, 16-Jan-2012.)
theorem rabxfrd {x3 y1: setvar} (ph ps: wff x3) (ch: wff y1) (A2: class y1) (B2 C: class x3 y1) (D: class):
  $ wnfc y1 B2 $ >
  $ wnfc y1 C $ >
  $ wi (wa ph (wcel (cv y1) D)) (wcel A2 D) $ >
  $ wi (wceq (cv x3) A2) (wb ps ch) $ >
  $ wi (wceq (cv y1) B2) (wceq A2 C) $ >
  $ wi (wa ph (wcel B2 D)) (wb (wcel C (crab x3 ps D)) (wcel B2 (crab y1 ch D))) $;

--| Class builder membership after substituting an expression ` A ` (containing ` y ` ) for ` x ` in the class expression ` ph ` . (Contributed by NM, 10-Jun-2005.)
theorem rabxfr {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class y1) (B2 C: class x3 y1) (D: class):
  $ wnfc y1 B2 $ >
  $ wnfc y1 C $ >
  $ wi (wcel (cv y1) D) (wcel A2 D) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wceq A2 C) $ >
  $ wi (wcel B2 D) (wb (wcel C (crab x3 ph D)) (wcel B2 (crab y1 ps D))) $;

--| A theorem useful for eliminating restricted existential uniqueness hypotheses. (Contributed by NM, 16-Jan-2012.)
theorem reuhypd {x3 y1: setvar} (ph: wff x3) (A2: class x3 y1) (B2 C: class x3):
  $ wi (wa ph (wcel (cv x3) C)) (wcel B2 C) $ >
  $ wi (w3a ph (wcel (cv x3) C) (wcel (cv y1) C)) (wb (wceq (cv x3) A2) (wceq (cv y1) B2)) $ >
  $ wi (wa ph (wcel (cv x3) C)) (wreu y1 (wceq (cv x3) A2) C) $;

--| A theorem useful for eliminating restricted existential uniqueness hypotheses. (Contributed by NM, 15-Nov-2004.)
theorem reuhyp {x3 y1: setvar} (A2: class x3 y1) (B2 C: class x3):
  $ wi (wcel (cv x3) C) (wcel B2 C) $ >
  $ wi (wa (wcel (cv x3) C) (wcel (cv y1) C)) (wb (wceq (cv x3) A2) (wceq (cv y1) B2)) $ >
  $ wi (wcel (cv x3) C) (wreu y1 (wceq (cv x3) A2) C) $;

--| The Axiom of Union and its converse. A class is a set iff its union is a set. (Contributed by NM, 11-Nov-2003.)
theorem uniexb (A2: class):
  $ wb (wcel A2 cvv) (wcel (cuni A2) cvv) $;

--| The Axiom of Power Sets and its converse. A class is a set iff its power class is a set. (Contributed by NM, 11-Nov-2003.)
theorem pwexb (A2: class):
  $ wb (wcel A2 cvv) (wcel (cpw A2) cvv) $;

--| The union of the universe is the universe. Exercise 4.12(c) of [Mendelson] p. 235. (Contributed by NM, 14-Sep-2003.)
theorem univ:
  $ wceq (cuni cvv) cvv $;

--| Membership in a power class difference. (Contributed by NM, 25-Mar-2007.)
theorem eldifpw (A2 B2 C: class):
  $ wcel C cvv $ >
  $ wi (wa (wcel A2 (cpw B2)) (wn (wss C B2))) (wcel (cun A2 C) (cdif (cpw (cun B2 C)) (cpw B2))) $;

--| Extract the first member of an ordered pair. Theorem 73 of [Suppes] p. 42. (Contributed by NM, 25-Nov-2003.)
theorem op1stb (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cint (cint (cop A2 B2))) A2 $;

--| Extract the first member of an ordered pair. Theorem 73 of [Suppes] p. 42. (Contributed by Jim Kingdon, 17-Dec-2018.)
theorem op1stbg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (cint (cint (cop A2 B2))) A2) $;

--| An indexed union of a power class in terms of the power class of the union of its index. Part of Exercise 24(b) of [Enderton] p. 33. (Contributed by NM, 29-Nov-2003.)
theorem iunpw {x3: setvar} (A2: class):
  $ wcel A2 cvv $ >
  $ wb (wrex x3 (wceq (cv x3) (cuni A2)) A2) (wceq (cpw (cuni A2)) (ciun x3 A2 (cpw (cv x3)))) $;

--| The class of all ordinal numbers is ordinal. Proposition 7.12 of [TakeutiZaring] p. 38, but without using the Axiom of Regularity. (Contributed by NM, 17-May-1994.)
theorem ordon:
  $ word con0 $;

--| The union of a class of ordinal numbers is ordinal. Proposition 7.19 of [TakeutiZaring] p. 40. (Contributed by NM, 30-May-1994.) (Proof shortened by Andrew Salmon, 12-Aug-2011.)
theorem ssorduni (A2: class):
  $ wi (wss A2 con0) (word (cuni A2)) $;

--| The union of a set of ordinal numbers is an ordinal number. Theorem 9 of [Suppes] p. 132. (Contributed by NM, 1-Nov-2003.)
theorem ssonuni (A2 V: class):
  $ wi (wcel A2 V) (wi (wss A2 con0) (wcel (cuni A2) con0)) $;

--| The union of a set of ordinal numbers is an ordinal number. Corollary 7N(d) of [Enderton] p. 193. (Contributed by NM, 20-Sep-2003.)
theorem ssonunii (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wss A2 con0) (wcel (cuni A2) con0) $;

--| The union of two ordinal numbers is an ordinal number. (Contributed by Jim Kingdon, 25-Jul-2019.)
theorem onun2 (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wcel (cun A2 B2) con0) $;

--| The union of two ordinal numbers is an ordinal number. (Contributed by NM, 13-Jun-1994.) (Constructive proof by Jim Kingdon, 25-Jul-2019.)
theorem onun2i (A2 B2: class):
  $ wcel A2 con0 $ >
  $ wcel B2 con0 $ >
  $ wcel (cun A2 B2) con0 $;

--| Any ordinal class is a subclass of the class of ordinal numbers. Corollary 7.15 of [TakeutiZaring] p. 38. (Contributed by NM, 18-May-1994.)
theorem ordsson (A2: class):
  $ wi (word A2) (wss A2 con0) $;

--| An ordinal number is a subset of the class of ordinal numbers. (Contributed by NM, 5-Jun-1994.)
theorem onss (A2: class):
  $ wi (wcel A2 con0) (wss A2 con0) $;

--| The union of an ordinal number is an ordinal number. (Contributed by NM, 29-Sep-2006.)
theorem onuni (A2: class):
  $ wi (wcel A2 con0) (wcel (cuni A2) con0) $;

--| The union of an ordinal class is ordinal. (Contributed by NM, 12-Sep-2003.)
theorem orduni (A2: class):
  $ wi (word A2) (word (cuni A2)) $;

--| Problem 2.5(ii) of [BellMachover] p. 471. (Contributed by NM, 20-Sep-2003.)
theorem bm2_5ii {x3 y1: setvar} (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wss A2 con0) (wceq (cuni A2) (cint (crab x3 (wral y1 (wss (cv y1) (cv x3)) A2) con0))) $;

--| A successor exists iff its class argument exists. (Contributed by NM, 22-Jun-1998.)
theorem sucexb (A2: class):
  $ wb (wcel A2 cvv) (wcel (csuc A2) cvv) $;

--| The successor of a set is a set (generalization). (Contributed by NM, 5-Jun-1994.)
theorem sucexg (A2 V: class):
  $ wi (wcel A2 V) (wcel (csuc A2) cvv) $;

--| The successor of a set is a set. (Contributed by NM, 30-Aug-1993.)
theorem sucex (A2: class):
  $ wcel A2 cvv $ >
  $ wcel (csuc A2) cvv $;

--| The successor of an ordinal class is ordinal. (Contributed by Jim Kingdon, 8-Nov-2018.)
theorem ordsucim (A2: class):
  $ wi (word A2) (word (csuc A2)) $;

--| The successor of an ordinal number is an ordinal number. Proposition 7.24 of [TakeutiZaring] p. 41. (Contributed by NM, 6-Jun-1994.)
theorem suceloni (A2: class):
  $ wi (wcel A2 con0) (wcel (csuc A2) con0) $;

--| The successor of an ordinal class is ordinal. (Contributed by Jim Kingdon, 20-Nov-2018.)
theorem ordsucg (A2: class):
  $ wi (wcel A2 cvv) (wb (word A2) (word (csuc A2))) $;

--| The successor of an ordinal number is an ordinal number. (Contributed by NM, 9-Sep-2003.)
theorem sucelon (A2: class):
  $ wb (wcel A2 con0) (wcel (csuc A2) con0) $;

--| The successor of an element of an ordinal class is a subset of it. (Contributed by NM, 21-Jun-1998.)
theorem ordsucss (A2 B2: class):
  $ wi (word B2) (wi (wcel A2 B2) (wss (csuc A2) B2)) $;

--| A set belongs to an ordinal iff its successor is a subset of the ordinal. Exercise 8 of [TakeutiZaring] p. 42 and its converse. (Contributed by NM, 29-Nov-2003.)
theorem ordelsuc (A2 B2 C: class):
  $ wi (wa (wcel A2 C) (word B2)) (wb (wcel A2 B2) (wss (csuc A2) B2)) $;

--| A set belongs to an ordinal number iff its successor is a subset of the ordinal number. Exercise 8 of [TakeutiZaring] p. 42 and its converse. (Contributed by NM, 16-Sep-1995.)
theorem onsucssi (A2 B2: class):
  $ wcel A2 con0 $ >
  $ wcel B2 con0 $ >
  $ wb (wcel A2 B2) (wss (csuc A2) B2) $;

--| The successor of an ordinal number is the smallest larger ordinal number. (Contributed by NM, 28-Nov-2003.)
theorem onsucmin {x3: setvar} (A2: class):
  $ wi (wcel A2 con0) (wceq (csuc A2) (cint (crab x3 (wcel A2 (cv x3)) con0))) $;

--| Membership is inherited by predecessors. The converse, for all ordinals, implies excluded middle, as shown at ~ onsucelsucexmid . However, the converse does hold where ` B ` is a natural number, as seen at ~ nnsucelsuc . (Contributed by Jim Kingdon, 17-Jul-2019.)
theorem onsucelsucr (A2 B2: class):
  $ wi (wcel B2 con0) (wi (wcel (csuc A2) (csuc B2)) (wcel A2 B2)) $;

--| The subclass relationship between two ordinals is inherited by their predecessors. The converse implies excluded middle, as shown at ~ onsucsssucexmid . (Contributed by Mario Carneiro and Jim Kingdon, 29-Jul-2019.)
theorem onsucsssucr (A2 B2: class):
  $ wi (wa (wcel A2 con0) (word B2)) (wi (wss (csuc A2) (csuc B2)) (wss A2 B2)) $;

--| Successor and union. The converse (where ` B ` is an ordinal) implies excluded middle, as seen at ~ ordsucunielexmid . (Contributed by Jim Kingdon, 2-Aug-2019.)
theorem sucunielr (A2 B2: class):
  $ wi (wcel (csuc A2) B2) (wcel A2 (cuni B2)) $;

--| The class of all ordinal numbers is its own union. Exercise 11 of [TakeutiZaring] p. 40. (Contributed by NM, 12-Nov-2003.)
theorem unon:
  $ wceq (cuni con0) con0 $;

--| The union of the ordinal subsets of an ordinal number is that number. (Contributed by Jim Kingdon, 2-Aug-2019.)
theorem onuniss2 {x3: setvar} (A2: class):
  $ wi (wcel A2 con0) (wceq (cuni (crab x3 (wss (cv x3) A2) con0)) A2) $;

--| The class of ordinal numbers is a limit ordinal. (Contributed by NM, 24-Mar-1995.)
theorem limon:
  $ wlim con0 $;

--| An ordinal which contains the successor of each of its members is equal to its union. (Contributed by Jim Kingdon, 14-Nov-2018.)
theorem ordunisuc2r {x3: setvar} (A2: class):
  $ wi (word A2) (wi (wral x3 (wcel (csuc (cv x3)) A2) A2) (wceq A2 (cuni A2))) $;

--| An ordinal number is a subset of ` On ` . (Contributed by NM, 11-Aug-1994.)
theorem onssi (A2: class):
  $ wcel A2 con0 $ >
  $ wss A2 con0 $;

--| The successor of an ordinal number is an ordinal number. Corollary 7N(c) of [Enderton] p. 193. (Contributed by NM, 12-Jun-1994.)
theorem onsuci (A2: class):
  $ wcel A2 con0 $ >
  $ wcel (csuc A2) con0 $;

--| The intersection of an inhabited collection of ordinal numbers is an ordinal number. Compare Exercise 6 of [TakeutiZaring] p. 44. (Contributed by Mario Carneiro and Jim Kingdon, 30-Aug-2021.)
theorem onintonm {x3: setvar} (A2: class):
  $ wi (wa (wss A2 con0) (wex x3 (wcel (cv x3) A2))) (wcel (cint A2) con0) $;

--| An existence condition which implies an intersection is an ordinal number. (Contributed by Jim Kingdon, 30-Aug-2021.)
theorem onintrab2im {x3: setvar} (ph: wff x3):
  $ wi (wrex x3 ph con0) (wcel (cint (crab x3 ph con0)) con0) $;

--| Lemma for decidability and ordinals. The set ` { x e. { (/) } | ph } ` is a way of connecting statements about ordinals (such as trichotomy in ~ ordtriexmid or weak linearity in ~ ordsoexmid ) with a proposition ` ph ` . Our lemma states that it is an ordinal number. (Contributed by Jim Kingdon, 28-Jan-2019.)
theorem ordtriexmidlem {x3: setvar} (ph: wff x3):
  $ wcel (crab x3 ph (csn c0)) con0 $;

--| Lemma for decidability and ordinals. The set ` { x e. { (/) } | ph } ` is a way of connecting statements about ordinals (such as trichotomy in ~ ordtriexmid or weak linearity in ~ ordsoexmid ) with a proposition ` ph ` . Our lemma helps connect that set to excluded middle. (Contributed by Jim Kingdon, 28-Jan-2019.)
theorem ordtriexmidlem2 {x3: setvar} (ph: wff):
  $ wi (wceq (crab x3 ph (csn c0)) c0) (wn ph) $;

--| Ordinal trichotomy implies the law of the excluded middle (that is, decidability of an arbitrary proposition). This theorem is stated in "Constructive ordinals", [Crosilla], p. "Set-theoretic principles incompatible with intuitionistic logic". (Contributed by Mario Carneiro and Jim Kingdon, 14-Nov-2018.)
theorem ordtriexmid {x3 y1: setvar} (ph: wff y1):
  $ wral x3 (wral y1 (w3o (wcel (cv x3) (cv y1)) (wceq (cv x3) (cv y1)) (wcel (cv y1) (cv x3))) con0) con0 $ >
  $ wo ph (wn ph) $;

--| Ordinal trichotomy implies excluded middle. (Contributed by Jim Kingdon, 31-Jul-2019.)
theorem ordtri2orexmid {x3 y1: setvar} (ph: wff):
  $ wral x3 (wral y1 (wo (wcel (cv x3) (cv y1)) (wss (cv y1) (cv x3))) con0) con0 $ >
  $ wo ph (wn ph) $;

--| Version of ~ 2on with the definition of ` 2o ` expanded and expressed in terms of ` Ord ` . (Contributed by Jim Kingdon, 29-Aug-2021.)
theorem _2ordpr:
  $ word (cpr c0 (csn c0)) $;

--| An ordinal transitivity law which implies excluded middle. (Contributed by Jim Kingdon, 17-Sep-2021.)
theorem ontr2exmid {x3 y1 z: setvar} (ph: wff):
  $ wral x3 (wal y1 (wral z (wi (wa (wss (cv x3) (cv y1)) (wcel (cv y1) (cv z))) (wcel (cv x3) (cv z))) con0)) con0 $ >
  $ wo ph (wn ph) $;

--| A set which is ` 2o ` if ` ph ` or ` (/) ` if ` -. ph ` is an ordinal. (Contributed by Jim Kingdon, 29-Aug-2021.)
theorem ordtri2or2exmidlem {x3: setvar} (ph: wff):
  $ wcel (crab x3 ph (cpr c0 (csn c0))) con0 $;

--| The converse of ~ onsucsssucr implies excluded middle. (Contributed by Mario Carneiro and Jim Kingdon, 29-Jul-2019.)
theorem onsucsssucexmid {x3 y1: setvar} (ph: wff y1):
  $ wral x3 (wral y1 (wi (wss (cv x3) (cv y1)) (wss (csuc (cv x3)) (csuc (cv y1)))) con0) con0 $ >
  $ wo ph (wn ph) $;

--| Lemma for ~ onsucelsucexmid . (Contributed by Jim Kingdon, 2-Aug-2019.)
theorem onsucelsucexmidlem1 {x3: setvar} (ph: wff):
  $ wcel c0 (crab x3 (wo (wceq (cv x3) c0) ph) (cpr c0 (csn c0))) $;

--| Lemma for ~ onsucelsucexmid . The set ` { x e. { (/) , { (/) } } | ( x = (/) \/ ph ) } ` appears as ` A ` in the proof of Theorem 1.3 in [Bauer] p. 483 (see ~ acexmidlema ), and similar sets also appear in other proofs that various propositions imply excluded middle, for example in ~ ordtriexmidlem . (Contributed by Jim Kingdon, 2-Aug-2019.)
theorem onsucelsucexmidlem {x3: setvar} (ph: wff):
  $ wcel (crab x3 (wo (wceq (cv x3) c0) ph) (cpr c0 (csn c0))) con0 $;

--| The converse of ~ onsucelsucr implies excluded middle. On the other hand, if ` y ` is constrained to be a natural number, instead of an arbitrary ordinal, then the converse of ~ onsucelsucr does hold, as seen at ~ nnsucelsuc . (Contributed by Jim Kingdon, 2-Aug-2019.)
theorem onsucelsucexmid {x3 y1: setvar} (ph: wff):
  $ wral x3 (wral y1 (wi (wcel (cv x3) (cv y1)) (wcel (csuc (cv x3)) (csuc (cv y1)))) con0) con0 $ >
  $ wo ph (wn ph) $;

--| The converse of ~ sucunielr (where ` B ` is an ordinal) implies excluded middle. (Contributed by Jim Kingdon, 2-Aug-2019.)
theorem ordsucunielexmid {x3 y1: setvar} (ph: wff):
  $ wral x3 (wral y1 (wi (wcel (cv x3) (cuni (cv y1))) (wcel (csuc (cv x3)) (cv y1))) con0) con0 $ >
  $ wo ph (wn ph) $;

--| Lemma for ~ regexmid . ` A ` is inhabited. (Contributed by Jim Kingdon, 3-Sep-2019.)
theorem regexmidlemm {x3 y1: setvar} (ph: wff) (A2: class x3):
  $ wceq A2 (crab x3 (wo (wceq (cv x3) (csn c0)) (wa (wceq (cv x3) c0) ph)) (cpr c0 (csn c0))) $ >
  $ wex y1 (wcel (cv y1) A2) $;

--| Lemma for ~ regexmid . If ` A ` has a minimal element, excluded middle follows. (Contributed by Jim Kingdon, 3-Sep-2019.)
theorem regexmidlem1 {x3 y1 z: setvar} (ph: wff z) (A2: class x3):
  $ wceq A2 (crab x3 (wo (wceq (cv x3) (csn c0)) (wa (wceq (cv x3) c0) ph)) (cpr c0 (csn c0))) $ >
  $ wi (wex y1 (wa (wcel (cv y1) A2) (wal z (wi (wcel (cv z) (cv y1)) (wn (wcel (cv z) A2)))))) (wo ph (wn ph)) $;

--| Lemma for ~ reg2exmid . If ` A ` has a minimal element (expressed by ` C_ ` ), excluded middle follows. (Contributed by Jim Kingdon, 2-Oct-2021.)
theorem reg2exmidlema {x3 v u: setvar} (ph: wff v) (A2: class x3 u):
  $ wceq A2 (crab x3 (wo (wceq (cv x3) (csn c0)) (wa (wceq (cv x3) c0) ph)) (cpr c0 (csn c0))) $ >
  $ wi (wrex u (wral v (wss (cv u) (cv v)) A2) A2) (wo ph (wn ph)) $;

--| The axiom of foundation implies excluded middle. By foundation (or regularity), we mean the principle that every inhabited set has an element which is minimal (when arranged by ` e. ` ). The statement of foundation here is taken from Metamath Proof Explorer's ax-reg, and is identical (modulo one unnecessary quantifier) to the statement of foundation in Theorem "Foundation implies instances of EM" of [Crosilla], p. "Set-theoretic principles incompatible with intuitionistic logic". For this reason, IZF does not adopt foundation as an axiom and instead replaces it with ~ ax-setind . (Contributed by Jim Kingdon, 3-Sep-2019.)
theorem regexmid {x3 y1 z: setvar} (ph: wff):
  $ wi (wex y1 (wcel (cv y1) (cv x3))) (wex y1 (wa (wcel (cv y1) (cv x3)) (wal z (wi (wcel (cv z) (cv y1)) (wn (wcel (cv z) (cv x3))))))) $ >
  $ wo ph (wn ph) $;

--| If any inhabited set has a minimal element (when expressed by ` C_ ` ), excluded middle follows. (Contributed by Jim Kingdon, 2-Oct-2021.)
theorem reg2exmid {x3 y1 z w: setvar} (ph: wff):
  $ wal z (wi (wex w (wcel (cv w) (cv z))) (wrex x3 (wral y1 (wss (cv x3) (cv y1)) (cv z)) (cv z))) $ >
  $ wo ph (wn ph) $;

--| Axiom of ` e. `-Induction (also known as set induction). An axiom of Intuitionistic Zermelo-Fraenkel set theory. Axiom 9 of [Crosilla] p. "Axioms of CZF and IZF". This replaces the Axiom of Foundation (also called Regularity) from Zermelo-Fraenkel set theory. For more on axioms which might be adopted which are incompatible with this axiom (that is, Non-wellfounded Set Theory but in the absence of excluded middle), see Chapter 20 of [AczelRathjen], p. 183. (Contributed by Jim Kingdon, 19-Oct-2018.)
axiom ax_setind {y1 a: setvar} (ph: wff a):
  $ wi (wal a (wi (wral y1 (wsb a y1 ph) (cv a)) ph)) (wal a ph) $;

--| ` e. `-Induction in terms of membership in a class. (Contributed by Mario Carneiro and Jim Kingdon, 22-Oct-2018.)
theorem setindel {x3 y1: setvar} (S: class):
  $ wi (wal x3 (wi (wal y1 (wi (wcel (cv y1) (cv x3)) (wcel (cv y1) S))) (wcel (cv x3) S))) (wceq S cvv) $;

--| Set (epsilon) induction. Theorem 5.22 of [TakeutiZaring] p. 21. (Contributed by NM, 17-Sep-2003.)
theorem setind {x3: setvar} (A2: class):
  $ wi (wal x3 (wi (wss (cv x3) A2) (wcel (cv x3) A2))) (wceq A2 cvv) $;

--| Set (epsilon) induction, stated compactly. Given as a homework problem in 1992 by George Boolos (1940-1996). (Contributed by NM, 17-Sep-2003.)
theorem setind2 (A2: class):
  $ wi (wss (cpw A2) A2) (wceq A2 cvv) $;

--| No class is a member of itself. Exercise 6 of [TakeutiZaring] p. 22. (Contributed by NM, 7-Aug-1994.) (Proof rewritten by Mario Carneiro and Jim Kingdon, 26-Nov-2018.)
theorem elirr (A2: class):
  $ wn (wcel A2 A2) $;

--| Epsilon irreflexivity of ordinals: no ordinal class is a member of itself. Theorem 2.2(i) of [BellMachover] p. 469, generalized to classes. (Contributed by NM, 2-Jan-1994.)
theorem ordirr (A2: class):
  $ wi (word A2) (wn (wcel A2 A2)) $;

--| A member of an ordinal class is not equal to it. (Contributed by NM, 25-May-1998.)
theorem nordeq (A2 B2: class):
  $ wi (wa (word A2) (wcel B2 A2)) (wne A2 B2) $;

--| An ordinal class cannot be an element of one of its members. Variant of first part of Theorem 2.2(vii) of [BellMachover] p. 469. (Contributed by NM, 3-Apr-1994.)
theorem ordn2lp (A2 B2: class):
  $ wi (word A2) (wn (wa (wcel A2 B2) (wcel B2 A2))) $;

--| An ordinal class and its singleton are disjoint. (Contributed by NM, 19-May-1998.)
theorem orddisj (A2: class):
  $ wi (word A2) (wceq (cin A2 (csn A2)) c0) $;

--| Ordinal derived from its successor. (Contributed by NM, 20-May-1998.)
theorem orddif (A2: class):
  $ wi (word A2) (wceq A2 (cdif (csuc A2) (csn A2))) $;

--| The membership relation is irreflexive: no set is a member of itself. Theorem 105 of [Suppes] p. 54. (Contributed by NM, 19-Aug-1993.)
theorem elirrv (x3: setvar):
  $ wn (wcel (cv x3) (cv x3)) $;

--| A class is equal to its successor iff it is a proper class (assuming the Axiom of Set Induction). (Contributed by NM, 9-Jul-2004.)
theorem sucprcreg (A2: class):
  $ wb (wn (wcel A2 cvv)) (wceq (csuc A2) A2) $;

--| The Russell class is equal to the universe ` _V ` . Exercise 5 of [TakeutiZaring] p. 22. (Contributed by Alan Sare, 4-Oct-2008.)
theorem ruv {x3: setvar}:
  $ wceq (cab x3 (wnel (cv x3) (cv x3))) cvv $;

--| Alternate proof of Russell's Paradox ~ ru , simplified using (indirectly) the Axiom of Set Induction ~ ax-setind . (Contributed by Alan Sare, 4-Oct-2008.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ruALT {x3: setvar}:
  $ wnel (cab x3 (wnel (cv x3) (cv x3))) cvv $;

--| No set contains all ordinal numbers. Proposition 7.13 of [TakeutiZaring] p. 38. This is also known as the Burali-Forti paradox (remark in [Enderton] p. 194). In 1897, Cesare Burali-Forti noticed that since the "set" of all ordinal numbers is an ordinal class ( ~ ordon ), it must be both an element of the set of all ordinal numbers yet greater than every such element. ZF set theory resolves this paradox by not allowing the class of all ordinal numbers to be a set (so instead it is a proper class). Here we prove the denial of its existence. (Contributed by NM, 18-May-1994.)
theorem onprc:
  $ wn (wcel con0 cvv) $;

--| The class of all ordinal numbers is its own successor. (Contributed by NM, 12-Sep-2003.)
theorem sucon:
  $ wceq (csuc con0) con0 $;

--| No class has 2-cycle membership loops. Theorem 7X(b) of [Enderton] p. 206. (Contributed by NM, 16-Oct-1996.) (Proof rewritten by Mario Carneiro and Jim Kingdon, 27-Nov-2018.)
theorem en2lp (A2 B2: class):
  $ wn (wa (wcel A2 B2) (wcel B2 A2)) $;

--| Equality of two unordered pairs when one member of each pair contains the other member. (Contributed by NM, 16-Oct-1996.)
theorem preleq (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wi (wa (wa (wcel A2 B2) (wcel C D)) (wceq (cpr A2 B2) (cpr C D))) (wa (wceq A2 C) (wceq B2 D)) $;

--| Theorem for alternate representation of ordered pairs, requiring the Axiom of Set Induction ~ ax-setind (via the ~ preleq step). See ~ df-op for a description of other ordered pair representations. Exercise 34 of [Enderton] p. 207. (Contributed by NM, 16-Oct-1996.)
theorem opthreg (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wb (wceq (cpr A2 (cpr A2 B2)) (cpr C (cpr C D))) (wa (wceq A2 C) (wceq B2 D)) $;

--| The successor operation behaves like a one-to-one function (assuming the Axiom of Set Induction). Similar to Exercise 35 of [Enderton] p. 208 and its converse. (Contributed by NM, 25-Oct-2003.)
theorem suc11g (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wceq (csuc A2) (csuc B2)) (wceq A2 B2)) $;

--| The successor operation behaves like a one-to-one function. Compare Exercise 16 of [Enderton] p. 194. (Contributed by NM, 3-Sep-2003.)
theorem suc11 (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wb (wceq (csuc A2) (csuc B2)) (wceq A2 B2)) $;

--| At least two sets exist (or in terms of first-order logic, the universe of discourse has two or more objects). Although ~ dtruarb can also be summarized as "at least two sets exist", the difference is that ~ dtruarb shows the existence of two sets which are not equal to each other, but this theorem says that given a specific ` y ` , we can construct a set ` x ` which does not equal it. (Contributed by Jim Kingdon, 29-Dec-2018.)
theorem dtruex {x3 y1: setvar}:
  $ wex x3 (wn (wceq (cv x3) (cv y1))) $;

--| At least two sets exist (or in terms of first-order logic, the universe of discourse has two or more objects). If we assumed the law of the excluded middle this would be equivalent to ~ dtruex . (Contributed by Jim Kingdon, 29-Dec-2018.)
theorem dtru {x3 y1: setvar}:
  $ wn (wal x3 (wceq (cv x3) (cv y1))) $;

--| Existential uniqueness implies there is a value for which the wff argument is false. (Contributed by Jim Kingdon, 29-Dec-2018.)
theorem eunex {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wex x3 (wn ph)) $;

--| Weak linearity of ordinals implies the law of the excluded middle (that is, decidability of an arbitrary proposition). (Contributed by Mario Carneiro and Jim Kingdon, 29-Jan-2019.)
theorem ordsoexmid (ph: wff):
  $ wor con0 cep $ >
  $ wo ph (wn ph) $;

--| The successor of an ordinal class is ordinal. (Contributed by NM, 3-Apr-1995.) (Constructive proof by Mario Carneiro and Jim Kingdon, 20-Jul-2019.)
theorem ordsuc (A2: class):
  $ wb (word A2) (word (csuc A2)) $;

--| A successor ordinal is the successor of its union. (Contributed by NM, 10-Dec-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem onsucuni2 (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wceq A2 (csuc B2))) (wceq (csuc (cuni A2)) A2) $;

--| If the successor of any ordinal class contains the empty set, excluded middle follows. (Contributed by Jim Kingdon, 3-Sep-2021.)
theorem _0elsucexmid {x3: setvar} (ph: wff):
  $ wral x3 (wcel c0 (csuc (cv x3))) con0 $ >
  $ wo ph (wn ph) $;

--| A successor is not a limit ordinal. (Contributed by NM, 25-Mar-1995.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem nlimsucg (A2 V: class):
  $ wi (wcel A2 V) (wn (wlim (csuc A2))) $;

--| The collection of ordinals in the power class of an ordinal is a superset of its successor. We can think of ` ( ~P A i^i On ) ` as another possible definition of successor, which would be equivalent to ~ df-suc given excluded middle. It is an ordinal, and has some successor-like properties. For example, if ` A e. On ` then both ` U. suc A = A ` ( ~ onunisuci ) and ` U. { x e. On | x C_ A } = A ` ( ~ onuniss2 ). Constructively ` ( ~P A i^i On ) ` and ` suc A ` cannot be shown to be equivalent (as proved at ~ ordpwsucexmid ). (Contributed by Jim Kingdon, 21-Jul-2019.)
theorem ordpwsucss (A2: class):
  $ wi (word A2) (wss (csuc A2) (cin (cpw A2) con0)) $;

--| No member of a set of ordinal numbers belongs to its minimum. (Contributed by NM, 2-Feb-1997.) (Constructive proof by Mario Carneiro and Jim Kingdon, 21-Jul-2019.)
theorem onnmin (A2 B2: class):
  $ wi (wa (wss A2 con0) (wcel B2 A2)) (wn (wcel B2 (cint A2))) $;

--| Relationship between subset and elementhood. In the context of ordinals this can be seen as an ordering law. (Contributed by Jim Kingdon, 22-Jul-2019.)
theorem ssnel (A2 B2: class):
  $ wi (wss A2 B2) (wn (wcel B2 A2)) $;

--| The subset in ~ ordpwsucss cannot be equality. That is, strengthening it to equality implies excluded middle. (Contributed by Jim Kingdon, 30-Jul-2019.)
theorem ordpwsucexmid {x3: setvar} (ph: wff):
  $ wral x3 (wceq (csuc (cv x3)) (cin (cpw (cv x3)) con0)) con0 $ >
  $ wo ph (wn ph) $;

--| An ordinal number is a proper subset of its successor. (Contributed by Stefan O'Rear, 18-Nov-2014.)
theorem onpsssuc (A2: class):
  $ wi (wcel A2 con0) (wpss A2 (csuc A2)) $;

--| Ordinal trichotomy implies excluded middle. (Contributed by Jim Kingdon, 29-Aug-2021.)
theorem ordtri2or2exmid {x3 y1: setvar} (ph: wff):
  $ wral x3 (wral y1 (wo (wss (cv x3) (cv y1)) (wss (cv y1) (cv x3))) con0) con0 $ >
  $ wo ph (wn ph) $;

--| If the intersection (infimum) of an inhabited class of ordinal numbers belongs to the class, excluded middle follows. The hypothesis would be provable given excluded middle. (Contributed by Mario Carneiro and Jim Kingdon, 29-Aug-2021.)
theorem onintexmid {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wa (wss (cv y1) con0) (wex x3 (wcel (cv x3) (cv y1)))) (wcel (cint (cv y1)) (cv y1)) $ >
  $ wo ph (wn ph) $;

--| The epsilon relation is well-founded on any class. (Contributed by NM, 26-Nov-1995.)
theorem zfregfr (A2: class):
  $ wfr A2 cep $;

--| Epsilon is well-founded on an ordinal class. (Contributed by NM, 22-Apr-1994.)
theorem ordfr (A2: class):
  $ wi (word A2) (wfr A2 cep) $;

--| Epsilon well-orders every ordinal. Proposition 7.4 of [TakeutiZaring] p. 36. (Contributed by NM, 3-Apr-1994.)
theorem ordwe (A2: class):
  $ wi (word A2) (wwe A2 cep) $;

--| A trichotomous well-order is extensional. (Contributed by Jim Kingdon, 26-Sep-2021.)
theorem wetriext {z a b: setvar} (ph: wff z a b) (A2 B2: class) (C: class a) (R: class) (V: class z a b):
  $ wi ph (wwe A2 R) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wral a (wral b (w3o (wbr (cv a) (cv b) R) (wceq (cv a) (cv b)) (wbr (cv b) (cv a) R)) A2) A2) $ >
  $ wi ph (wcel B2 A2) $ >
  $ wi ph (wcel C A2) $ >
  $ wi ph (wral z (wb (wbr (cv z) B2 R) (wbr (cv z) C R)) A2) $ >
  $ wi ph (wceq B2 C) $;

--| A subset of a set well-ordered by set membership is well-ordered by set membership. (Contributed by Jim Kingdon, 30-Sep-2021.)
theorem wessep (A2 B2: class):
  $ wi (wa (wwe A2 cep) (wss B2 A2)) (wwe B2 cep) $;

--| Lemma for ~ reg3exmid . Our counterexample ` A ` satisfies ` We ` . (Contributed by Jim Kingdon, 3-Oct-2021.)
theorem reg3exmidlemwe {x3: setvar} (ph: wff) (A2: class x3):
  $ wceq A2 (crab x3 (wo (wceq (cv x3) (csn c0)) (wa (wceq (cv x3) c0) ph)) (cpr c0 (csn c0))) $ >
  $ wwe A2 cep $;

--| If any inhabited set satisfying ~ df-wetr for ` _E ` has a minimal element, excluded middle follows. (Contributed by Jim Kingdon, 3-Oct-2021.)
theorem reg3exmid {x3 y1 z w: setvar} (ph: wff):
  $ wi (wa (wwe (cv z) cep) (wex w (wcel (cv w) (cv z)))) (wrex x3 (wral y1 (wss (cv x3) (cv y1)) (cv z)) (cv z)) $ >
  $ wo ph (wn ph) $;

--| The Principle of Transfinite Induction. Theorem 7.17 of [TakeutiZaring] p. 39. This principle states that if ` A ` is a class of ordinal numbers with the property that every ordinal number included in ` A ` also belongs to ` A ` , then every ordinal number is in ` A ` . (Contributed by NM, 18-Feb-2004.)
theorem tfi {x3: setvar} (A2: class):
  $ wi (wa (wss A2 con0) (wral x3 (wi (wss (cv x3) A2) (wcel (cv x3) A2)) con0)) (wceq A2 con0) $;

--| Transfinite Induction Schema. If all ordinal numbers less than a given number ` x ` have a property (induction hypothesis), then all ordinal numbers have the property (conclusion). Exercise 25 of [Enderton] p. 200. (Contributed by NM, 1-Aug-1994.) (Revised by Mario Carneiro, 20-Nov-2016.)
theorem tfis {x3 y1: setvar} (ph: wff x3):
  $ wi (wcel (cv x3) con0) (wi (wral y1 (wsb x3 y1 ph) (cv x3)) ph) $ >
  $ wi (wcel (cv x3) con0) ph $;

--| Transfinite Induction Schema, using implicit substitution. (Contributed by NM, 18-Aug-1994.)
theorem tfis2f {x3 y1: setvar} (ph: wff x3) (ps: wff x3 y1):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wcel (cv x3) con0) (wi (wral y1 ps (cv x3)) ph) $ >
  $ wi (wcel (cv x3) con0) ph $;

--| Transfinite Induction Schema, using implicit substitution. (Contributed by NM, 18-Aug-1994.)
theorem tfis2 {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wcel (cv x3) con0) (wi (wral y1 ps (cv x3)) ph) $ >
  $ wi (wcel (cv x3) con0) ph $;

--| Transfinite Induction Schema, using implicit substitution. (Contributed by NM, 4-Nov-2003.)
theorem tfis3 {x3 y1: setvar} (ph: wff x3) (ps ch: wff y1) (A2: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wcel (cv x3) con0) (wi (wral y1 ps (cv x3)) ph) $ >
  $ wi (wcel A2 con0) ch $;

--| A transfinite induction scheme in "implicit" form where the induction is done on an object derived from the object of interest. (Contributed by Stefan O'Rear, 24-Aug-2015.)
theorem tfisi {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch th: wff y1) (A2: class y1) (R: class x3) (S: class y1) (T: class) (V: class x3 y1):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel T con0) $ >
  $ wi (w3a ph (wa (wcel R con0) (wss R T)) (wal y1 (wi (wcel S R) ch))) ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ps ch) $ >
  $ wi (wceq (cv x3) A2) (wb ps th) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq R S) $ >
  $ wi (wceq (cv x3) A2) (wceq R T) $ >
  $ wi ph th $;

--| Axiom of Infinity. Axiom 5 of [Crosilla] p. "Axioms of CZF and IZF". (Contributed by Jim Kingdon, 16-Nov-2018.)
axiom ax_iinf {x3 y1: setvar}:
  $ wex x3 (wa (wcel c0 (cv x3)) (wal y1 (wi (wcel (cv y1) (cv x3)) (wcel (csuc (cv y1)) (cv x3))))) $;

--| A standard version of the Axiom of Infinity, using definitions to abbreviate. Axiom Inf of [BellMachover] p. 472. (Contributed by NM, 30-Aug-1993.)
theorem zfinf2 {x3 y1: setvar}:
  $ wex x3 (wa (wcel c0 (cv x3)) (wral y1 (wcel (csuc (cv y1)) (cv x3)) (cv x3))) $;

--| Extend class notation to include the class of natural numbers.
term com: class;

--| Define the class of natural numbers as the smallest inductive set, which is valid provided we assume the Axiom of Infinity. Definition 6.3 of [Eisenberg] p. 82. _Note_: the natural numbers ` _om ` are a subset of the ordinal numbers ~ df-on . Later, when we define complex numbers, we will be able to also define a subset of the complex numbers with analogous properties and operations, but they will be different sets. (Contributed by NM, 6-Aug-1994.) Use its alias ~ dfom3 instead for naming consistency with set.mm. (New usage is discouraged.)
axiom df_iom {x3 y1: setvar}:
  $ wceq com (cint (cab x3 (wa (wcel c0 (cv x3)) (wral y1 (wcel (csuc (cv y1)) (cv x3)) (cv x3))))) $;

--| Alias for ~ df-iom . Use it instead of ~ df-iom for naming consistency with set.mm. (Contributed by NM, 6-Aug-1994.)
theorem dfom3 {x3 y1: setvar}:
  $ wceq com (cint (cab x3 (wa (wcel c0 (cv x3)) (wral y1 (wcel (csuc (cv y1)) (cv x3)) (cv x3))))) $;

--| The existence of omega (the class of natural numbers). Axiom 7 of [TakeutiZaring] p. 43. (Contributed by NM, 6-Aug-1994.)
theorem omex:
  $ wcel com cvv $;

--| Zero is a natural number. One of Peano's five postulates for arithmetic. Proposition 7.30(1) of [TakeutiZaring] p. 42. (Contributed by NM, 15-May-1994.)
theorem peano1:
  $ wcel c0 com $;

--| The successor of any natural number is a natural number. One of Peano's five postulates for arithmetic. Proposition 7.30(2) of [TakeutiZaring] p. 42. (Contributed by NM, 3-Sep-2003.)
theorem peano2 (A2: class):
  $ wi (wcel A2 com) (wcel (csuc A2) com) $;

--| The successor of any natural number is not zero. One of Peano's five postulates for arithmetic. Proposition 7.30(3) of [TakeutiZaring] p. 42. (Contributed by NM, 3-Sep-2003.)
theorem peano3 (A2: class):
  $ wi (wcel A2 com) (wne (csuc A2) c0) $;

--| Two natural numbers are equal iff their successors are equal, i.e. the successor function is one-to-one. One of Peano's five postulates for arithmetic. Proposition 7.30(4) of [TakeutiZaring] p. 43. (Contributed by NM, 3-Sep-2003.)
theorem peano4 (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wb (wceq (csuc A2) (csuc B2)) (wceq A2 B2)) $;

--| The induction postulate: any class containing zero and closed under the successor operation contains all natural numbers. One of Peano's five postulates for arithmetic. Proposition 7.30(5) of [TakeutiZaring] p. 43. The more traditional statement of mathematical induction as a theorem schema, with a basis and an induction step, is derived from this theorem as theorem ~ findes . (Contributed by NM, 18-Feb-2004.)
theorem peano5 {x3: setvar} (A2: class):
  $ wi (wa (wcel c0 A2) (wral x3 (wi (wcel (cv x3) A2) (wcel (csuc (cv x3)) A2)) com)) (wss com A2) $;

--| The Principle of Finite Induction (mathematical induction). Corollary 7.31 of [TakeutiZaring] p. 43. The simpler hypothesis shown here was suggested in an email from "Colin" on 1-Oct-2001. The hypothesis states that ` A ` is a set of natural numbers, zero belongs to ` A ` , and given any member of ` A ` the member's successor also belongs to ` A ` . The conclusion is that every natural number is in ` A ` . (Contributed by NM, 22-Feb-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem find {x3: setvar} (A2: class):
  $ w3a (wss A2 com) (wcel c0 A2) (wral x3 (wcel (csuc (cv x3)) A2) A2) $ >
  $ wceq A2 com $;

--| Principle of Finite Induction (inference schema), using implicit substitutions. The first four hypotheses establish the substitutions we need. The last two are the basis and the induction step. Theorem Schema 22 of [Suppes] p. 136. This is Metamath 100 proof #74. (Contributed by NM, 14-Apr-1995.)
theorem finds {x3 y1: setvar} (ph: wff x3) (ps ch th ta: wff y1) (A2: class y1):
  $ wi (wceq (cv x3) c0) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (csuc (cv y1))) (wb ph th) $ >
  $ wi (wceq (cv x3) A2) (wb ph ta) $ >
  $ ps $ >
  $ wi (wcel (cv y1) com) (wi ch th) $ >
  $ wi (wcel A2 com) ta $;

--| Principle of Finite Induction (inference schema), using implicit substitutions. The first three hypotheses establish the substitutions we need. The last two are the basis and the induction step. Theorem Schema 22 of [Suppes] p. 136. (Contributed by NM, 29-Nov-2002.)
theorem finds2 {x3 y1: setvar} (ph: wff x3) (ps ch th: wff y1) (ta: wff):
  $ wi (wceq (cv x3) c0) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (csuc (cv y1))) (wb ph th) $ >
  $ wi ta ps $ >
  $ wi (wcel (cv y1) com) (wi ta (wi ch th)) $ >
  $ wi (wcel (cv x3) com) (wi ta ph) $;

--| Principle of Finite Induction (inference schema), using implicit substitutions. The first three hypotheses establish the substitutions we need. The last two are the basis and the induction step. Theorem Schema 22 of [Suppes] p. 136. (Contributed by NM, 22-Mar-2006.)
theorem finds1 {x3 y1: setvar} (ph: wff x3) (ps ch th: wff y1):
  $ wi (wceq (cv x3) c0) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (csuc (cv y1))) (wb ph th) $ >
  $ ps $ >
  $ wi (wcel (cv y1) com) (wi ch th) $ >
  $ wi (wcel (cv x3) com) ph $;

--| Finite induction with explicit substitution. The first hypothesis is the basis and the second is the induction step. Theorem Schema 22 of [Suppes] p. 136. This is an alternative for Metamath 100 proof #74. (Contributed by Raph Levien, 9-Jul-2003.)
theorem findes {x3: setvar} (ph: wff x3):
  $ wsbc x3 ph c0 $ >
  $ wi (wcel (cv x3) com) (wi ph (wsbc x3 ph (csuc (cv x3)))) $ >
  $ wi (wcel (cv x3) com) ph $;

--| A natural number is either 0 or a successor. Similar theorems for arbitrary sets or real numbers will not be provable (without the law of the excluded middle), but equality of natural numbers is decidable. (Contributed by NM, 27-May-1998.)
theorem nn0suc {x3: setvar} (A2: class):
  $ wi (wcel A2 com) (wo (wceq A2 c0) (wrex x3 (wceq A2 (csuc (cv x3))) com)) $;

--| A member of a natural number is a natural number. (Contributed by NM, 21-Jun-1998.)
theorem elnn (A2 B2: class):
  $ wi (wa (wcel A2 B2) (wcel B2 com)) (wcel A2 com) $;

--| Omega is ordinal. Theorem 7.32 of [TakeutiZaring] p. 43. (Contributed by NM, 18-Oct-1995.)
theorem ordom:
  $ word com $;

--| Omega is an ordinal number. (Contributed by Mario Carneiro, 30-Jan-2013.)
theorem omelon2:
  $ wi (wcel com cvv) (wcel com con0) $;

--| Omega is an ordinal number. (Contributed by NM, 10-May-1998.) (Revised by Mario Carneiro, 30-Jan-2013.)
theorem omelon:
  $ wcel com con0 $;

--| A natural number is an ordinal number. (Contributed by NM, 27-Jun-1994.)
theorem nnon (A2: class):
  $ wi (wcel A2 com) (wcel A2 con0) $;

--| A natural number is an ordinal number. (Contributed by NM, 27-Jun-1994.)
theorem nnoni (A2: class):
  $ wcel A2 com $ >
  $ wcel A2 con0 $;

--| A natural number is ordinal. (Contributed by NM, 17-Oct-1995.)
theorem nnord (A2: class):
  $ wi (wcel A2 com) (word A2) $;

--| Omega is a subset of ` On ` . (Contributed by NM, 13-Jun-1994.)
theorem omsson:
  $ wss com con0 $;

--| Omega is a limit ordinal. Theorem 2.8 of [BellMachover] p. 473. (Contributed by NM, 26-Mar-1995.) (Proof rewritten by Jim Kingdon, 5-Jan-2019.)
theorem limom:
  $ wlim com $;

--| A class belongs to omega iff its successor does. (Contributed by NM, 3-Dec-1995.)
theorem peano2b (A2: class):
  $ wb (wcel A2 com) (wcel (csuc A2) com) $;

--| A nonzero natural number is a successor. (Contributed by NM, 18-Feb-2004.)
theorem nnsuc {x3: setvar} (A2: class):
  $ wi (wa (wcel A2 com) (wne A2 c0)) (wrex x3 (wceq A2 (csuc (cv x3))) com) $;

--| A natural number is either zero or nonzero. Decidable equality for natural numbers is a special case of the law of the excluded middle which holds in most constructive set theories including ours. (Contributed by Jim Kingdon, 5-Jan-2019.)
theorem nndceq0 (A2: class):
  $ wi (wcel A2 com) (wdc (wceq A2 c0)) $;

--| A natural number is either the empty set or has the empty set as an element. (Contributed by Jim Kingdon, 23-Aug-2019.)
theorem _0elnn (A2: class):
  $ wi (wcel A2 com) (wo (wceq A2 c0) (wcel c0 A2)) $;

--| A natural number is nonempty iff it contains the empty set. Although in constructive mathematics it is generally more natural to work with inhabited sets and ignore the whole concept of nonempty sets, in the specific case of natural numbers this theorem may be helpful in converting proofs which were written assuming excluded middle. (Contributed by Jim Kingdon, 28-Aug-2019.)
theorem nn0eln0 (A2: class):
  $ wi (wcel A2 com) (wb (wcel c0 A2) (wne A2 c0)) $;

--| If inhabited sets of natural numbers always have minimal elements, excluded middle follows. The argument is essentially the same as ~ regexmid and the larger lesson is that although natural numbers may behave "non-constructively" even in a constructive set theory (for example see ~ nndceq or ~ nntri3or ), sets of natural numbers are a different animal. (Contributed by Jim Kingdon, 6-Sep-2019.)
theorem nnregexmid {x3 y1 z: setvar} (ph: wff):
  $ wi (wa (wss (cv x3) com) (wex y1 (wcel (cv y1) (cv x3)))) (wex y1 (wa (wcel (cv y1) (cv x3)) (wal z (wi (wcel (cv z) (cv y1)) (wn (wcel (cv z) (cv x3))))))) $ >
  $ wo ph (wn ph) $;

--| Extend the definition of a class to include the cross product.
term cxp (A2 B2: class): class;

--| Extend the definition of a class to include the converse of a class.
term ccnv (A2: class): class;

--| Extend the definition of a class to include the domain of a class.
term cdm (A2: class): class;

--| Extend the definition of a class to include the range of a class.
term crn (A2: class): class;

--| Extend the definition of a class to include the restriction of a class. (Read: The restriction of ` A ` to ` B ` .)
term cres (A2 B2: class): class;

--| Extend the definition of a class to include the image of a class. (Read: The image of ` B ` under ` A ` .)
term cima (A2 B2: class): class;

--| Extend the definition of a class to include the composition of two classes. (Read: The composition of ` A ` and ` B ` .)
term ccom (A2 B2: class): class;

--| Extend the definition of a wff to include the relation predicate. (Read: ` A ` is a relation.)
term wrel (A2: class): wff;

--| Define the cross product of two classes. Definition 9.11 of [Quine] p. 64. For example, ( { 1 , 5 } ` X. ` { 2 , 7 } ) = ( { ` <. ` 1 , 2 ` >. ` , ` <. ` 1 , 7 ` >. ` } ` u. ` { ` <. ` 5 , 2 ` >. ` , ` <. ` 5 , 7 ` >. ` } ) . Another example is that the set of rational numbers are defined in using the cross-product ( Z ` X. ` N ) ; the left- and right-hand sides of the cross-product represent the top (integer) and bottom (natural) numbers of a fraction. (Contributed by NM, 4-Jul-1994.)
axiom df_xp {x3 y1: setvar} (A2 B2: class):
  $ wceq (cxp A2 B2) (copab x3 y1 (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) $;

--| Define the relation predicate. Definition 6.4(1) of [TakeutiZaring] p. 23. For alternate definitions, see ~ dfrel2 and ~ dfrel3 . (Contributed by NM, 1-Aug-1994.)
axiom df_rel (A2: class):
  $ wb (wrel A2) (wss A2 (cxp cvv cvv)) $;

--| Define the converse of a class. Definition 9.12 of [Quine] p. 64. The converse of a binary relation swaps its arguments, i.e., if ` A e. _V ` and ` B e. _V ` then ` ( A ``' R B <-> B R A ) ` , as proven in ~ brcnv (see ~ df-br and ~ df-rel for more on relations). For example, ` ``' ` { ` <. ` 2 , 6 ` >. ` , ` <. ` 3 , 9 ` >. ` } = { ` <. ` 6 , 2 ` >. ` , ` <. ` 9 , 3 ` >. ` } . We use Quine's breve accent (smile) notation. Like Quine, we use it as a prefix, which eliminates the need for parentheses. Many authors use the postfix superscript "to the minus one." "Converse" is Quine's terminology; some authors call it "inverse," especially when the argument is a function. (Contributed by NM, 4-Jul-1994.)
axiom df_cnv {x3 y1: setvar} (A2: class):
  $ wceq (ccnv A2) (copab x3 y1 (wbr (cv y1) (cv x3) A2)) $;

--| Define the composition of two classes. Definition 6.6(3) of [TakeutiZaring] p. 24. Note that Definition 7 of [Suppes] p. 63 reverses ` A ` and ` B ` , uses a slash instead of ` o. ` , and calls the operation "relative product." (Contributed by NM, 4-Jul-1994.)
axiom df_co {x3 y1 z: setvar} (A2 B2: class):
  $ wceq (ccom A2 B2) (copab x3 y1 (wex z (wa (wbr (cv x3) (cv z) B2) (wbr (cv z) (cv y1) A2)))) $;

--| Define the domain of a class. Definition 3 of [Suppes] p. 59. For example, F = { ` <. ` 2 , 6 ` >. ` , ` <. ` 3 , 9 ` >. ` } ` -> ` dom F = { 2 , 3 } . Contrast with range (defined in ~ df-rn ). For alternate definitions see ~ dfdm2 , ~ dfdm3 , and ~ dfdm4 . The notation " ` dom ` " is used by Enderton; other authors sometimes use script D. (Contributed by NM, 1-Aug-1994.)
axiom df_dm {x3 y1: setvar} (A2: class):
  $ wceq (cdm A2) (cab x3 (wex y1 (wbr (cv x3) (cv y1) A2))) $;

--| Define the range of a class. For example, F = { ` <. ` 2 , 6 ` >. ` , ` <. ` 3 , 9 ` >. ` } -> ran F = { 6 , 9 } . Contrast with domain (defined in ~ df-dm ). For alternate definitions, see ~ dfrn2 , ~ dfrn3 , and ~ dfrn4 . The notation " ` ran ` " is used by Enderton; other authors sometimes use script R or script W. (Contributed by NM, 1-Aug-1994.)
axiom df_rn (A2: class):
  $ wceq (crn A2) (cdm (ccnv A2)) $;

--| Define the restriction of a class. Definition 6.6(1) of [TakeutiZaring] p. 24. For example ( F = { ` <. ` 2 , 6 ` >. ` , ` <. ` 3 , 9 ` >. ` } ` /\ ` B = { 1 , 2 } ) -> ( F ` |`` ` B ) = { ` <. ` 2 , 6 ` >. ` } . (Contributed by NM, 2-Aug-1994.)
axiom df_res (A2 B2: class):
  $ wceq (cres A2 B2) (cin A2 (cxp B2 cvv)) $;

--| Define the image of a class (as restricted by another class). Definition 6.6(2) of [TakeutiZaring] p. 24. For example, ( F = { ` <. ` 2 , 6 ` >. ` , ` <. ` 3 , 9 ` >. ` } /\ B = { 1 , 2 } ) -> ( F ` " ` B ) = { 6 } . Contrast with restriction ( ~ df-res ) and range ( ~ df-rn ). For an alternate definition, see ~ dfima2 . (Contributed by NM, 2-Aug-1994.)
axiom df_ima (A2 B2: class):
  $ wceq (cima A2 B2) (crn (cres A2 B2)) $;

--| Equality theorem for cross product. (Contributed by NM, 4-Jul-1994.)
theorem xpeq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cxp A2 C) (cxp B2 C)) $;

--| Equality theorem for cross product. (Contributed by NM, 5-Jul-1994.)
theorem xpeq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cxp C A2) (cxp C B2)) $;

--| Membership in a cross product. Uses fewer axioms than ~ elxp . (Contributed by NM, 4-Jul-1994.)
theorem elxpi {x3 y1: setvar} (A2 B2 C: class):
  $ wi (wcel A2 (cxp B2 C)) (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) (wa (wcel (cv x3) B2) (wcel (cv y1) C))))) $;

--| Membership in a cross product. (Contributed by NM, 4-Jul-1994.)
theorem elxp {x3 y1: setvar} (A2 B2 C: class):
  $ wb (wcel A2 (cxp B2 C)) (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) (wa (wcel (cv x3) B2) (wcel (cv y1) C))))) $;

--| Membership in a cross product. (Contributed by NM, 23-Feb-2004.)
theorem elxp2 {x3 y1: setvar} (A2 B2 C: class):
  $ wb (wcel A2 (cxp B2 C)) (wrex x3 (wrex y1 (wceq A2 (cop (cv x3) (cv y1))) C) B2) $;

--| Equality theorem for cross product. (Contributed by FL, 31-Aug-2009.)
theorem xpeq12 (A2 B2 C D: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wceq (cxp A2 C) (cxp B2 D)) $;

--| Equality inference for cross product. (Contributed by NM, 21-Dec-2008.)
theorem xpeq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cxp A2 C) (cxp B2 C) $;

--| Equality inference for cross product. (Contributed by NM, 21-Dec-2008.)
theorem xpeq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cxp C A2) (cxp C B2) $;

--| Equality inference for cross product. (Contributed by FL, 31-Aug-2009.)
theorem xpeq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (cxp A2 C) (cxp B2 D) $;

--| Equality deduction for cross product. (Contributed by Jeff Madsen, 17-Jun-2010.)
theorem xpeq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cxp A2 C) (cxp B2 C)) $;

--| Equality deduction for cross product. (Contributed by Jeff Madsen, 17-Jun-2010.)
theorem xpeq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cxp C A2) (cxp C B2)) $;

--| Equality deduction for cross product. (Contributed by NM, 8-Dec-2013.)
theorem xpeq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cxp A2 C) (cxp B2 D)) $;

--| Bound-variable hypothesis builder for cross product. (Contributed by NM, 15-Sep-2003.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfxp {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cxp A2 B2) $;

--| The empty set is not a member of a cross product. (Contributed by NM, 2-May-1996.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem _0nelxp (A2 B2: class):
  $ wn (wcel c0 (cxp A2 B2)) $;

--| A member of a cross product (ordered pair) doesn't contain the empty set. (Contributed by NM, 15-Dec-2008.)
theorem _0nelelxp (A2 B2 C: class):
  $ wi (wcel C (cxp A2 B2)) (wn (wcel c0 C)) $;

--| Ordered pair membership in a cross product. (Contributed by NM, 15-Nov-1994.) (Proof shortened by Andrew Salmon, 12-Aug-2011.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opelxp (A2 B2 C D: class):
  $ wb (wcel (cop A2 B2) (cxp C D)) (wa (wcel A2 C) (wcel B2 D)) $;

--| Binary relation on a cross product. (Contributed by NM, 22-Apr-2004.)
theorem brxp (A2 B2 C D: class):
  $ wb (wbr A2 B2 (cxp C D)) (wa (wcel A2 C) (wcel B2 D)) $;

--| Ordered pair membership in a cross product (implication). (Contributed by NM, 28-May-1995.)
theorem opelxpi (A2 B2 C D: class):
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wcel (cop A2 B2) (cxp C D)) $;

--| The first member of an ordered pair of classes in a cross product belongs to first cross product argument. (Contributed by NM, 28-May-2008.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opelxp1 (A2 B2 C D: class):
  $ wi (wcel (cop A2 B2) (cxp C D)) (wcel A2 C) $;

--| The second member of an ordered pair of classes in a cross product belongs to second cross product argument. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem opelxp2 (A2 B2 C D: class):
  $ wi (wcel (cop A2 B2) (cxp C D)) (wcel B2 D) $;

--| The first member of an ordered triple of classes in a cross product belongs to first cross product argument. (Contributed by NM, 28-May-2008.)
theorem otelxp1 (A2 B2 C R S T: class):
  $ wi (wcel (cop (cop A2 B2) C) (cxp (cxp R S) T)) (wcel A2 R) $;

--| Membership in a class builder restricted to a cross product. (Contributed by NM, 20-Feb-2014.)
theorem rabxp {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1 z) (A2 B2: class):
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wb ph ps) $ >
  $ wceq (crab x3 ph (cxp A2 B2)) (copab y1 z (w3a (wcel (cv y1) A2) (wcel (cv z) B2) ps)) $;

--| A true binary relation on a relation implies the arguments are sets. (This is a property of our ordered pair definition.) (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem brrelex12 (A2 B2 R: class):
  $ wi (wa (wrel R) (wbr A2 B2 R)) (wa (wcel A2 cvv) (wcel B2 cvv)) $;

--| A true binary relation on a relation implies the first argument is a set. (This is a property of our ordered pair definition.) (Contributed by NM, 18-May-2004.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem brrelex (A2 B2 R: class):
  $ wi (wa (wrel R) (wbr A2 B2 R)) (wcel A2 cvv) $;

--| A true binary relation on a relation implies the second argument is a set. (This is a property of our ordered pair definition.) (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem brrelex2 (A2 B2 R: class):
  $ wi (wa (wrel R) (wbr A2 B2 R)) (wcel B2 cvv) $;

--| The first argument of a binary relation exists. (An artifact of our ordered pair definition.) (Contributed by NM, 4-Jun-1998.)
theorem brrelexi (A2 B2 R: class):
  $ wrel R $ >
  $ wi (wbr A2 B2 R) (wcel A2 cvv) $;

--| The second argument of a binary relation exists. (An artifact of our ordered pair definition.) (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem brrelex2i (A2 B2 R: class):
  $ wrel R $ >
  $ wi (wbr A2 B2 R) (wcel B2 cvv) $;

--| No proper class is related to anything via any relation. (Contributed by Roy F. Longton, 30-Jul-2005.)
theorem nprrel (A2 B2 R: class):
  $ wrel R $ >
  $ wn (wcel A2 cvv) $ >
  $ wn (wbr A2 B2 R) $;

--| Representation of a constant function using the mapping operation. (Note that ` x ` cannot appear free in ` B ` .) (Contributed by NM, 12-Oct-1999.) (Revised by Mario Carneiro, 16-Nov-2013.)
theorem fconstmpt {x3: setvar} (A2 B2: class):
  $ wceq (cxp A2 (csn B2)) (cmpt x3 A2 B2) $;

--| Variable to class conversion of transitive relation. (Contributed by NM, 9-Jun-1998.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem vtoclr {x3 y1 z: setvar} (A2: class z) (B2: class x3 z) (C R: class):
  $ wrel R $ >
  $ wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R)) (wbr (cv x3) (cv z) R) $ >
  $ wi (wa (wbr A2 B2 R) (wbr B2 C R)) (wbr A2 C R) $;

--| Ordered pair membership in the universal class of ordered pairs. (Contributed by Mario Carneiro, 3-May-2015.)
theorem opelvvg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wcel (cop A2 B2) (cxp cvv cvv)) $;

--| Ordered pair membership in the universal class of ordered pairs. (Contributed by NM, 22-Aug-2013.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opelvv (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel (cop A2 B2) (cxp cvv cvv) $;

--| Justification theorem for an ordered pair definition that works for any classes, including proper classes. This is a possible definition implied by the footnote in [Jech] p. 78, which says, "The sophisticated reader will not object to our use of a pair of classes." (Contributed by NM, 28-Sep-2003.)
theorem opthprc (A2 B2 C D: class):
  $ wb (wceq (cun (cxp A2 (csn c0)) (cxp B2 (csn (csn c0)))) (cun (cxp C (csn c0)) (cxp D (csn (csn c0))))) (wa (wceq A2 C) (wceq B2 D)) $;

--| Two things in a binary relation belong to the relation's domain. (Contributed by NM, 17-May-1996.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem brel (A2 B2 C D R: class):
  $ wss R (cxp C D) $ >
  $ wi (wbr A2 B2 R) (wa (wcel A2 C) (wcel B2 D)) $;

--| Ordered pair membership in an ordered pair class abstraction. (Contributed by Mario Carneiro, 9-Nov-2015.)
theorem brab2a {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2 C D: class) (R: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wceq R (copab x3 y1 (wa (wa (wcel (cv x3) C) (wcel (cv y1) D)) ph)) $ >
  $ wb (wbr A2 B2 R) (wa (wa (wcel A2 C) (wcel B2 D)) ps) $;

--| Membership in a cross product. (Contributed by NM, 5-Mar-1995.)
theorem elxp3 {x3 y1: setvar} (A2 B2 C: class):
  $ wb (wcel A2 (cxp B2 C)) (wex x3 (wex y1 (wa (wceq (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) (cxp B2 C))))) $;

--| Membership in a union of cross products. (Contributed by Mario Carneiro, 29-Dec-2014.) (Revised by Mario Carneiro, 1-Jan-2017.)
theorem opeliunxp {x3: setvar} (A2 B2 C: class x3):
  $ wb (wcel (cop (cv x3) C) (ciun x3 A2 (cxp (csn (cv x3)) B2))) (wa (wcel (cv x3) A2) (wcel C B2)) $;

--| Distributive law for cross product over union. Theorem 103 of [Suppes] p. 52. (Contributed by NM, 12-Aug-2004.)
theorem xpundi (A2 B2 C: class):
  $ wceq (cxp A2 (cun B2 C)) (cun (cxp A2 B2) (cxp A2 C)) $;

--| Distributive law for cross product over union. Similar to Theorem 103 of [Suppes] p. 52. (Contributed by NM, 30-Sep-2002.)
theorem xpundir (A2 B2 C: class):
  $ wceq (cxp (cun A2 B2) C) (cun (cxp A2 C) (cxp B2 C)) $;

--| Distributive law for cross product over indexed union. (Contributed by Mario Carneiro, 27-Apr-2014.)
theorem xpiundi {x3: setvar} (A2 B2: class x3) (C: class):
  $ wceq (cxp C (ciun x3 A2 B2)) (ciun x3 A2 (cxp C B2)) $;

--| Distributive law for cross product over indexed union. (Contributed by Mario Carneiro, 27-Apr-2014.)
theorem xpiundir {x3: setvar} (A2 B2: class x3) (C: class):
  $ wceq (cxp (ciun x3 A2 B2) C) (ciun x3 A2 (cxp B2 C)) $;

--| Membership in a union of cross products when the second factor is constant. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem iunxpconst {x3: setvar} (A2 B2: class):
  $ wceq (ciun x3 A2 (cxp (csn (cv x3)) B2)) (cxp A2 B2) $;

--| The cross product of two unions. (Contributed by NM, 12-Aug-2004.)
theorem xpun (A2 B2 C D: class):
  $ wceq (cxp (cun A2 B2) (cun C D)) (cun (cun (cxp A2 C) (cxp A2 D)) (cun (cxp B2 C) (cxp B2 D))) $;

--| Membership in universal class of ordered pairs. (Contributed by NM, 4-Jul-1994.)
theorem elvv {x3 y1: setvar} (A2: class):
  $ wb (wcel A2 (cxp cvv cvv)) (wex x3 (wex y1 (wceq A2 (cop (cv x3) (cv y1))))) $;

--| Membership in universal class of ordered triples. (Contributed by NM, 17-Dec-2008.)
theorem elvvv {x3 y1 z: setvar} (A2: class):
  $ wb (wcel A2 (cxp (cxp cvv cvv) cvv)) (wex x3 (wex y1 (wex z (wceq A2 (cop (cop (cv x3) (cv y1)) (cv z)))))) $;

--| An ordered pair contains its union. (Contributed by NM, 16-Sep-2006.)
theorem elvvuni (A2: class):
  $ wi (wcel A2 (cxp cvv cvv)) (wcel (cuni A2) A2) $;

--| "At most one" remains true inside ordered pair quantification. (Contributed by NM, 28-Aug-2007.)
theorem mosubopt {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class):
  $ wi (wal y1 (wal z (wmo x3 ph))) (wmo x3 (wex y1 (wex z (wa (wceq A2 (cop (cv y1) (cv z))) ph)))) $;

--| "At most one" remains true inside ordered pair quantification. (Contributed by NM, 28-May-1995.)
theorem mosubop {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class):
  $ wmo x3 ph $ >
  $ wmo x3 (wex y1 (wex z (wa (wceq A2 (cop (cv y1) (cv z))) ph))) $;

--| Intersection of binary relation with cross product. (Contributed by NM, 3-Mar-2007.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem brinxp2 (A2 B2 C D R: class):
  $ wb (wbr A2 B2 (cin R (cxp C D))) (w3a (wcel A2 C) (wcel B2 D) (wbr A2 B2 R)) $;

--| Intersection of binary relation with cross product. (Contributed by NM, 9-Mar-1997.)
theorem brinxp (A2 B2 C D R: class):
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wb (wbr A2 B2 R) (wbr A2 B2 (cin R (cxp C D)))) $;

--| Intersection of partial order with cross product of its field. (Contributed by Mario Carneiro, 10-Jul-2014.)
theorem poinxp (A2 R: class):
  $ wb (wpo A2 R) (wpo A2 (cin R (cxp A2 A2))) $;

--| Intersection of linear order with cross product of its field. (Contributed by Mario Carneiro, 10-Jul-2014.)
theorem soinxp (A2 R: class):
  $ wb (wor A2 R) (wor A2 (cin R (cxp A2 A2))) $;

--| Intersection of set-like relation with cross product of its field. (Contributed by Mario Carneiro, 22-Jun-2015.)
theorem seinxp (A2 R: class):
  $ wb (wse A2 R) (wse A2 (cin R (cxp A2 A2))) $;

--| Partial ordering of a singleton. (Contributed by Jim Kingdon, 5-Dec-2018.)
theorem posng (A2 R: class):
  $ wi (wa (wrel R) (wcel A2 cvv)) (wb (wpo (csn A2) R) (wn (wbr A2 A2 R))) $;

--| Strict linear ordering on a singleton. (Contributed by Jim Kingdon, 5-Dec-2018.)
theorem sosng (A2 R: class):
  $ wi (wa (wrel R) (wcel A2 cvv)) (wb (wor (csn A2) R) (wn (wbr A2 A2 R))) $;

--| An abstraction relation is a subset of a related cross product. (Contributed by NM, 16-Jul-1995.)
theorem opabssxp {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class):
  $ wss (copab x3 y1 (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph)) (cxp A2 B2) $;

--| The law of concretion for a binary relation. See ~ brab2a for alternate proof. TODO: should one of them be deleted? (Contributed by Mario Carneiro, 28-Apr-2015.) (Proof modification is discouraged.)
theorem brab2ga {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2 C D: class) (R: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wceq R (copab x3 y1 (wa (wa (wcel (cv x3) C) (wcel (cv y1) D)) ph)) $ >
  $ wb (wbr A2 B2 R) (wa (wa (wcel A2 C) (wcel B2 D)) ps) $;

--| Implicit substitution of class for ordered pair. (Contributed by NM, 5-Mar-1995.)
theorem optocl {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2 C: class) (D: class x3 y1):
  $ wceq D (cxp B2 C) $ >
  $ wi (wceq (cop (cv x3) (cv y1)) A2) (wb ph ps) $ >
  $ wi (wa (wcel (cv x3) B2) (wcel (cv y1) C)) ph $ >
  $ wi (wcel A2 D) ps $;

--| Implicit substitution of classes for ordered pairs. (Contributed by NM, 12-Mar-1995.)
theorem _2optocl {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (ps: wff z w) (ch: wff x3 y1) (A2: class) (B2: class x3 y1) (C D: class) (R: class x3 y1):
  $ wceq R (cxp C D) $ >
  $ wi (wceq (cop (cv x3) (cv y1)) A2) (wb ph ps) $ >
  $ wi (wceq (cop (cv z) (cv w)) B2) (wb ps ch) $ >
  $ wi (wa (wa (wcel (cv x3) C) (wcel (cv y1) D)) (wa (wcel (cv z) C) (wcel (cv w) D))) ph $ >
  $ wi (wa (wcel A2 R) (wcel B2 R)) ch $;

--| Implicit substitution of classes for ordered pairs. (Contributed by NM, 12-Mar-1995.)
theorem _3optocl {x3 y1 z w v u: setvar} (ph: wff x3 y1 z w v u) (ps: wff z w v u) (ch: wff x3 y1 v u) (th: wff x3 y1 z w) (A2: class) (B2: class x3 y1) (C: class x3 y1 z w) (D: class) (R: class x3 y1) (F: class):
  $ wceq R (cxp D F) $ >
  $ wi (wceq (cop (cv x3) (cv y1)) A2) (wb ph ps) $ >
  $ wi (wceq (cop (cv z) (cv w)) B2) (wb ps ch) $ >
  $ wi (wceq (cop (cv v) (cv u)) C) (wb ch th) $ >
  $ wi (w3a (wa (wcel (cv x3) D) (wcel (cv y1) F)) (wa (wcel (cv z) D) (wcel (cv w) F)) (wa (wcel (cv v) D) (wcel (cv u) F))) ph $ >
  $ wi (w3a (wcel A2 R) (wcel B2 R) (wcel C R)) th $;

--| Ordered pair membership in a relation. Special case. (Contributed by NM, 5-Aug-1995.)
theorem opbrop {x3 y1 z w v u: setvar} (ph: wff z w v u) (ps: wff x3 y1) (A2 B2 C D: class) (R: class x3 y1 z w v u) (S: class):
  $ wi (wa (wa (wceq (cv z) A2) (wceq (cv w) B2)) (wa (wceq (cv v) C) (wceq (cv u) D))) (wb ph ps) $ >
  $ wceq R (copab x3 y1 (wa (wa (wcel (cv x3) (cxp S S)) (wcel (cv y1) (cxp S S))) (wex z (wex w (wex v (wex u (wa (wa (wceq (cv x3) (cop (cv z) (cv w))) (wceq (cv y1) (cop (cv v) (cv u)))) ph))))))) $ >
  $ wi (wa (wa (wcel A2 S) (wcel B2 S)) (wa (wcel C S) (wcel D S))) (wb (wbr (cop A2 B2) (cop C D) R) ps) $;

--| The cross product with the empty set is empty. Part of Theorem 3.13(ii) of [Monk1] p. 37. (Contributed by NM, 4-Jul-1994.)
theorem _0xp (A2: class):
  $ wceq (cxp c0 A2) c0 $;

--| Distribute proper substitution through the cross product of two classes. (Contributed by Alan Sare, 10-Nov-2012.)
theorem csbxpg {x3: setvar} (A2 B2 C D: class x3):
  $ wi (wcel A2 D) (wceq (csb x3 A2 (cxp B2 C)) (cxp (csb x3 A2 B2) (csb x3 A2 C))) $;

--| Equality theorem for the relation predicate. (Contributed by NM, 1-Aug-1994.)
theorem releq (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wrel A2) (wrel B2)) $;

--| Equality inference for the relation predicate. (Contributed by NM, 8-Dec-2006.)
theorem releqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wb (wrel A2) (wrel B2) $;

--| Equality deduction for the relation predicate. (Contributed by NM, 8-Mar-2014.)
theorem releqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wrel A2) (wrel B2)) $;

--| Bound-variable hypothesis builder for a relation. (Contributed by NM, 31-Jan-2004.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfrel {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 (wrel A2) $;

--| Distribute proper substitution through a relation predicate. (Contributed by Alexander van der Vekens, 23-Jul-2017.)
theorem sbcrel {x3: setvar} (A2 R V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wrel R) A2) (wrel (csb x3 A2 R))) $;

--| Subclass theorem for relation predicate. Theorem 2 of [Suppes] p. 58. (Contributed by NM, 15-Aug-1994.)
theorem relss (A2 B2: class):
  $ wi (wss A2 B2) (wi (wrel B2) (wrel A2)) $;

--| A subclass relationship depends only on a relation's ordered pairs. Theorem 3.2(i) of [Monk1] p. 33. (Contributed by NM, 2-Aug-1994.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem ssrel {x3 y1: setvar} (A2 B2: class):
  $ wi (wrel A2) (wb (wss A2 B2) (wal x3 (wal y1 (wi (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2))))) $;

--| Extensionality principle for relations. Theorem 3.2(ii) of [Monk1] p. 33. (Contributed by NM, 2-Aug-1994.)
theorem eqrel {x3 y1: setvar} (A2 B2: class):
  $ wi (wa (wrel A2) (wrel B2)) (wb (wceq A2 B2) (wal x3 (wal y1 (wb (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2))))) $;

--| A subclass relationship depends only on a relation's ordered pairs. This version of ~ ssrel is restricted to the relation's domain. (Contributed by Thierry Arnoux, 25-Jan-2018.)
theorem ssrel2 {x3 y1: setvar} (A2 B2 R S: class):
  $ wi (wss R (cxp A2 B2)) (wb (wss R S) (wral x3 (wral y1 (wi (wcel (cop (cv x3) (cv y1)) R) (wcel (cop (cv x3) (cv y1)) S)) B2) A2)) $;

--| Inference from subclass principle for relations. (Contributed by NM, 31-Mar-1998.)
theorem relssi {x3 y1: setvar} (A2 B2: class):
  $ wrel A2 $ >
  $ wi (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2) $ >
  $ wss A2 B2 $;

--| Deduction from subclass principle for relations. (Contributed by NM, 11-Sep-2004.)
theorem relssdv {x3 y1: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wrel A2) $ >
  $ wi ph (wi (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2)) $ >
  $ wi ph (wss A2 B2) $;

--| Inference from extensionality principle for relations. (Contributed by FL, 15-Oct-2012.)
theorem eqrelriv {x3 y1: setvar} (A2 B2: class):
  $ wb (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2) $ >
  $ wi (wa (wrel A2) (wrel B2)) (wceq A2 B2) $;

--| Inference from extensionality principle for relations. (Contributed by NM, 17-Mar-1995.)
theorem eqrelriiv {x3 y1: setvar} (A2 B2: class):
  $ wrel A2 $ >
  $ wrel B2 $ >
  $ wb (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2) $ >
  $ wceq A2 B2 $;

--| Inference from extensionality principle for relations. (Contributed by NM, 12-Dec-2006.)
theorem eqbrriv {x3 y1: setvar} (A2 B2: class):
  $ wrel A2 $ >
  $ wrel B2 $ >
  $ wb (wbr (cv x3) (cv y1) A2) (wbr (cv x3) (cv y1) B2) $ >
  $ wceq A2 B2 $;

--| Deduce equality of relations from equivalence of membership. (Contributed by Rodolfo Medina, 10-Oct-2010.)
theorem eqrelrdv {x3 y1: setvar} (ph: wff) (A2 B2: class):
  $ wrel A2 $ >
  $ wrel B2 $ >
  $ wi ph (wb (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2)) $ >
  $ wi ph (wceq A2 B2) $;

--| Deduction from extensionality principle for relations. (Contributed by Mario Carneiro, 3-Jan-2017.)
theorem eqbrrdv {x3 y1: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wrel A2) $ >
  $ wi ph (wrel B2) $ >
  $ wi ph (wb (wbr (cv x3) (cv y1) A2) (wbr (cv x3) (cv y1) B2)) $ >
  $ wi ph (wceq A2 B2) $;

--| Deduction from extensionality principle for relations. (Contributed by Rodolfo Medina, 10-Oct-2010.)
theorem eqbrrdiv {x3 y1: setvar} (ph: wff) (A2 B2: class):
  $ wrel A2 $ >
  $ wrel B2 $ >
  $ wi ph (wb (wbr (cv x3) (cv y1) A2) (wbr (cv x3) (cv y1) B2)) $ >
  $ wi ph (wceq A2 B2) $;

--| A version of ~ eqrelrdv . (Contributed by Rodolfo Medina, 10-Oct-2010.)
theorem eqrelrdv2 {x3 y1: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wb (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2)) $ >
  $ wi (wa (wa (wrel A2) (wrel B2)) ph) (wceq A2 B2) $;

--| A subclass relationship determined by ordered triples. Use ~ relrelss to express the antecedent in terms of the relation predicate. (Contributed by NM, 17-Dec-2008.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem ssrelrel {x3 y1 z: setvar} (A2 B2: class):
  $ wi (wss A2 (cxp (cxp cvv cvv) cvv)) (wb (wss A2 B2) (wal x3 (wal y1 (wal z (wi (wcel (cop (cop (cv x3) (cv y1)) (cv z)) A2) (wcel (cop (cop (cv x3) (cv y1)) (cv z)) B2)))))) $;

--| Extensionality principle for ordered triples, analogous to ~ eqrel . Use ~ relrelss to express the antecedent in terms of the relation predicate. (Contributed by NM, 17-Dec-2008.)
theorem eqrelrel {x3 y1 z: setvar} (A2 B2: class):
  $ wi (wss (cun A2 B2) (cxp (cxp cvv cvv) cvv)) (wb (wceq A2 B2) (wal x3 (wal y1 (wal z (wb (wcel (cop (cop (cv x3) (cv y1)) (cv z)) A2) (wcel (cop (cop (cv x3) (cv y1)) (cv z)) B2)))))) $;

--| A member of a relation is an ordered pair. (Contributed by NM, 17-Sep-2006.)
theorem elrel {x3 y1: setvar} (A2: class) (R: class x3 y1):
  $ wi (wa (wrel R) (wcel A2 R)) (wex x3 (wex y1 (wceq A2 (cop (cv x3) (cv y1))))) $;

--| A singleton is a relation iff it is an ordered pair. (Contributed by NM, 24-Sep-2013.)
theorem relsn (A2: class):
  $ wcel A2 cvv $ >
  $ wb (wrel (csn A2)) (wcel A2 (cxp cvv cvv)) $;

--| A singleton of an ordered pair is a relation. (Contributed by NM, 17-May-1998.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem relsnop (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wrel (csn (cop A2 B2)) $;

--| Subset theorem for cross product. Generalization of Theorem 101 of [Suppes] p. 52. (Contributed by NM, 26-Aug-1995.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem xpss12 (A2 B2 C D: class):
  $ wi (wa (wss A2 B2) (wss C D)) (wss (cxp A2 C) (cxp B2 D)) $;

--| A cross product is included in the ordered pair universe. Exercise 3 of [TakeutiZaring] p. 25. (Contributed by NM, 2-Aug-1994.)
theorem xpss (A2 B2: class):
  $ wss (cxp A2 B2) (cxp cvv cvv) $;

--| A cross product is a relation. Theorem 3.13(i) of [Monk1] p. 37. (Contributed by NM, 2-Aug-1994.)
theorem relxp (A2 B2: class):
  $ wrel (cxp A2 B2) $;

--| Subset relation for cross product. (Contributed by Jeff Hankins, 30-Aug-2009.)
theorem xpss1 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cxp A2 C) (cxp B2 C)) $;

--| Subset relation for cross product. (Contributed by Jeff Hankins, 30-Aug-2009.)
theorem xpss2 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cxp C A2) (cxp C B2)) $;

--| A cross product is included in the power of the power of the union of its arguments. (Contributed by NM, 13-Sep-2006.)
theorem xpsspw (A2 B2: class):
  $ wss (cxp A2 B2) (cpw (cpw (cun A2 B2))) $;

--| The double class union of a cross product is included in the union of its arguments. (Contributed by NM, 16-Sep-2006.)
theorem unixpss (A2 B2: class):
  $ wss (cuni (cuni (cxp A2 B2))) (cun A2 B2) $;

--| The cross product of two sets is a set. Proposition 6.2 of [TakeutiZaring] p. 23. (Contributed by NM, 14-Aug-1994.)
theorem xpexg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wcel (cxp A2 B2) cvv) $;

--| The cross product of two sets is a set. Proposition 6.2 of [TakeutiZaring] p. 23. (Contributed by NM, 14-Aug-1994.)
theorem xpex (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel (cxp A2 B2) cvv $;

--| The union of two relations is a relation. Compare Exercise 5 of [TakeutiZaring] p. 25. (Contributed by NM, 12-Aug-1994.)
theorem relun (A2 B2: class):
  $ wb (wrel (cun A2 B2)) (wa (wrel A2) (wrel B2)) $;

--| The intersection with a relation is a relation. (Contributed by NM, 16-Aug-1994.)
theorem relin1 (A2 B2: class):
  $ wi (wrel A2) (wrel (cin A2 B2)) $;

--| The intersection with a relation is a relation. (Contributed by NM, 17-Jan-2006.)
theorem relin2 (A2 B2: class):
  $ wi (wrel B2) (wrel (cin A2 B2)) $;

--| A difference cutting down a relation is a relation. (Contributed by NM, 31-Mar-1998.)
theorem reldif (A2 B2: class):
  $ wi (wrel A2) (wrel (cdif A2 B2)) $;

--| An indexed union is a relation iff each member of its indexed family is a relation. (Contributed by NM, 19-Dec-2008.)
theorem reliun {x3: setvar} (A2 B2: class x3):
  $ wb (wrel (ciun x3 A2 B2)) (wral x3 (wrel B2) A2) $;

--| An indexed intersection is a relation if at least one of the member of the indexed family is a relation. (Contributed by NM, 8-Mar-2014.)
theorem reliin {x3: setvar} (A2 B2: class x3):
  $ wi (wrex x3 (wrel B2) A2) (wrel (ciin x3 A2 B2)) $;

--| The union of a class is a relation iff any member is a relation. Exercise 6 of [TakeutiZaring] p. 25 and its converse. (Contributed by NM, 13-Aug-2004.)
theorem reluni {x3: setvar} (A2: class):
  $ wb (wrel (cuni A2)) (wral x3 (wrel (cv x3)) A2) $;

--| The intersection of a class is a relation if at least one member is a relation. (Contributed by NM, 8-Mar-2014.)
theorem relint {x3: setvar} (A2: class):
  $ wi (wrex x3 (wrel (cv x3)) A2) (wrel (cint A2)) $;

--| The empty set is a relation. (Contributed by NM, 26-Apr-1998.)
theorem rel0:
  $ wrel c0 $;

--| A class of ordered pairs is a relation. (Contributed by Mario Carneiro, 21-Dec-2013.)
theorem relopabi {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wceq A2 (copab x3 y1 ph) $ >
  $ wrel A2 $;

--| A class of ordered pairs is a relation. (Contributed by NM, 8-Mar-1995.) (Unnecessary distinct variable restrictions were removed by Alan Sare, 9-Jul-2013.) (Proof shortened by Mario Carneiro, 21-Dec-2013.)
theorem relopab {x3 y1: setvar} (ph: wff x3 y1):
  $ wrel (copab x3 y1 ph) $;

--| The identity relation is a relation. Part of Exercise 4.12(p) of [Mendelson] p. 235. (Contributed by NM, 26-Apr-1998.) (Revised by Mario Carneiro, 21-Dec-2013.)
theorem reli:
  $ wrel cid $;

--| The membership relation is a relation. (Contributed by NM, 26-Apr-1998.) (Revised by Mario Carneiro, 21-Dec-2013.)
theorem rele:
  $ wrel cep $;

--| A relation expressed as an ordered pair abstraction. (Contributed by NM, 11-Dec-2006.)
theorem opabid2 {x3 y1: setvar} (A2: class):
  $ wi (wrel A2) (wceq (copab x3 y1 (wcel (cop (cv x3) (cv y1)) A2)) A2) $;

--| Intersection of two ordered pair class abstractions. (Contributed by NM, 30-Sep-2002.)
theorem inopab {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wceq (cin (copab x3 y1 ph) (copab x3 y1 ps)) (copab x3 y1 (wa ph ps)) $;

--| The difference of two ordered-pair abstractions. (Contributed by Stefan O'Rear, 17-Jan-2015.)
theorem difopab {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wceq (cdif (copab x3 y1 ph) (copab x3 y1 ps)) (copab x3 y1 (wa ph (wn ps))) $;

--| The intersection of two cross products. Exercise 9 of [TakeutiZaring] p. 25. (Contributed by NM, 3-Aug-1994.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem inxp (A2 B2 C D: class):
  $ wceq (cin (cxp A2 B2) (cxp C D)) (cxp (cin A2 C) (cin B2 D)) $;

--| Distributive law for cross product over intersection. Theorem 102 of [Suppes] p. 52. (Contributed by NM, 26-Sep-2004.)
theorem xpindi (A2 B2 C: class):
  $ wceq (cxp A2 (cin B2 C)) (cin (cxp A2 B2) (cxp A2 C)) $;

--| Distributive law for cross product over intersection. Similar to Theorem 102 of [Suppes] p. 52. (Contributed by NM, 26-Sep-2004.)
theorem xpindir (A2 B2 C: class):
  $ wceq (cxp (cin A2 B2) C) (cin (cxp A2 C) (cxp B2 C)) $;

--| Distributive law for cross product over indexed intersection. (Contributed by Jim Kingdon, 7-Dec-2018.)
theorem xpiindim {x3 y1: setvar} (A2: class) (B2: class x3 y1) (C: class):
  $ wi (wex y1 (wcel (cv y1) A2)) (wceq (cxp C (ciin x3 A2 B2)) (ciin x3 A2 (cxp C B2))) $;

--| Distributive law for cross product over relativized indexed intersection. (Contributed by Jim Kingdon, 7-Dec-2018.)
theorem xpriindim {x3 y1: setvar} (A2: class) (B2: class x3 y1) (C: class) (D: class x3 y1):
  $ wi (wex y1 (wcel (cv y1) A2)) (wceq (cxp C (cin D (ciin x3 A2 B2))) (cin (cxp C D) (ciin x3 A2 (cxp C B2)))) $;

--| Membership in a union of cross products. Analogue of ~ elxp for nonconstant ` B ( x ) ` . (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem eliunxp {x3 y1: setvar} (A2 B2: class x3) (C: class):
  $ wb (wcel C (ciun x3 A2 (cxp (csn (cv x3)) B2))) (wex x3 (wex y1 (wa (wceq C (cop (cv x3) (cv y1))) (wa (wcel (cv x3) A2) (wcel (cv y1) B2))))) $;

--| Membership in a union of cross products. (Contributed by Mario Carneiro, 14-Feb-2015.)
theorem opeliunxp2 {x3: setvar} (A2: class) (B2: class x3) (C D E: class):
  $ wi (wceq (cv x3) C) (wceq B2 E) $ >
  $ wb (wcel (cop C D) (ciun x3 A2 (cxp (csn (cv x3)) B2))) (wa (wcel C A2) (wcel D E)) $;

--| Write a double restricted quantification as one universal quantifier. In this version of ~ ralxp , ` B ( y ) ` is not assumed to be constant. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem raliunxp {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1 z) (A2: class) (B2: class y1):
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wb ph ps) $ >
  $ wb (wral x3 ph (ciun y1 A2 (cxp (csn (cv y1)) B2))) (wral y1 (wral z ps B2) A2) $;

--| Write a double restricted quantification as one universal quantifier. In this version of ~ rexxp , ` B ( y ) ` is not assumed to be constant. (Contributed by Mario Carneiro, 14-Feb-2015.)
theorem rexiunxp {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1 z) (A2: class) (B2: class y1):
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wb ph ps) $ >
  $ wb (wrex x3 ph (ciun y1 A2 (cxp (csn (cv y1)) B2))) (wrex y1 (wrex z ps B2) A2) $;

--| Universal quantification restricted to a cross product is equivalent to a double restricted quantification. The hypothesis specifies an implicit substitution. (Contributed by NM, 7-Feb-2004.) (Revised by Mario Carneiro, 29-Dec-2014.)
theorem ralxp {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1 z) (A2 B2: class):
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wb ph ps) $ >
  $ wb (wral x3 ph (cxp A2 B2)) (wral y1 (wral z ps B2) A2) $;

--| Existential quantification restricted to a cross product is equivalent to a double restricted quantification. (Contributed by NM, 11-Nov-1995.) (Revised by Mario Carneiro, 14-Feb-2015.)
theorem rexxp {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1 z) (A2 B2: class):
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wb ph ps) $ >
  $ wb (wrex x3 ph (cxp A2 B2)) (wrex y1 (wrex z ps B2) A2) $;

--| Disjoint union is a subset of a cross product. (Contributed by Stefan O'Rear, 21-Nov-2014.)
theorem djussxp {x3: setvar} (A2: class) (B2: class x3):
  $ wss (ciun x3 A2 (cxp (csn (cv x3)) B2)) (cxp A2 cvv) $;

--| Version of ~ ralxp with bound-variable hypotheses. (Contributed by NM, 18-Aug-2006.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem ralxpf {x3 y1 z: setvar} (ph ps: wff x3 y1 z) (A2: class z) (B2: class):
  $ wnf y1 ph $ >
  $ wnf z ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wb ph ps) $ >
  $ wb (wral x3 ph (cxp A2 B2)) (wral y1 (wral z ps B2) A2) $;

--| Version of ~ rexxp with bound-variable hypotheses. (Contributed by NM, 19-Dec-2008.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem rexxpf {x3 y1 z: setvar} (ph ps: wff x3 y1 z) (A2: class z) (B2: class):
  $ wnf y1 ph $ >
  $ wnf z ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wb ph ps) $ >
  $ wb (wrex x3 ph (cxp A2 B2)) (wrex y1 (wrex z ps B2) A2) $;

--| Indexed union on a cross product is equals a double indexed union. The hypothesis specifies an implicit substitution. (Contributed by NM, 19-Dec-2008.)
theorem iunxpf {x3 y1 z: setvar} (A2: class z) (B2: class) (C D: class x3 y1 z):
  $ wnfc y1 C $ >
  $ wnfc z C $ >
  $ wnfc x3 D $ >
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wceq C D) $ >
  $ wceq (ciun x3 (cxp A2 B2) C) (ciun y1 A2 (ciun z B2 D)) $;

--| Deduce equality of a relation and an ordered-pair class builder. Compare ~ abbi2dv . (Contributed by NM, 24-Feb-2014.)
theorem opabbi2dv {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (A2: class):
  $ wrel A2 $ >
  $ wi ph (wb (wcel (cop (cv x3) (cv y1)) A2) ps) $ >
  $ wi ph (wceq A2 (copab x3 y1 ps)) $;

--| A necessary and sufficient condition for a Kuratowski ordered pair to be a relation. (Contributed by NM, 3-Jun-2008.) (Avoid depending on this detail.)
theorem relop {x3 y1: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wrel (cop A2 B2)) (wex x3 (wex y1 (wa (wceq A2 (csn (cv x3))) (wceq B2 (cpr (cv x3) (cv y1)))))) $;

--| For sets, the identity relation is the same as equality. (Contributed by NM, 30-Apr-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem ideqg (A2 B2 V: class):
  $ wi (wcel B2 V) (wb (wbr A2 B2 cid) (wceq A2 B2)) $;

--| For sets, the identity relation is the same as equality. (Contributed by NM, 13-Aug-1995.)
theorem ideq (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wb (wbr A2 B2 cid) (wceq A2 B2) $;

--| A set is identical to itself. (Contributed by NM, 28-May-2008.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem ididg (A2 V: class):
  $ wi (wcel A2 V) (wbr A2 A2 cid) $;

--| Two ways of expressing set existence. (Contributed by NM, 16-Feb-2008.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem issetid (A2: class):
  $ wb (wcel A2 cvv) (wbr A2 A2 cid) $;

--| Subclass theorem for composition. (Contributed by FL, 30-Dec-2010.)
theorem coss1 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (ccom A2 C) (ccom B2 C)) $;

--| Subclass theorem for composition. (Contributed by NM, 5-Apr-2013.)
theorem coss2 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (ccom C A2) (ccom C B2)) $;

--| Equality theorem for composition of two classes. (Contributed by NM, 3-Jan-1997.)
theorem coeq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (ccom A2 C) (ccom B2 C)) $;

--| Equality theorem for composition of two classes. (Contributed by NM, 3-Jan-1997.)
theorem coeq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (ccom C A2) (ccom C B2)) $;

--| Equality inference for composition of two classes. (Contributed by NM, 16-Nov-2000.)
theorem coeq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (ccom A2 C) (ccom B2 C) $;

--| Equality inference for composition of two classes. (Contributed by NM, 16-Nov-2000.)
theorem coeq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (ccom C A2) (ccom C B2) $;

--| Equality deduction for composition of two classes. (Contributed by NM, 16-Nov-2000.)
theorem coeq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (ccom A2 C) (ccom B2 C)) $;

--| Equality deduction for composition of two classes. (Contributed by NM, 16-Nov-2000.)
theorem coeq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (ccom C A2) (ccom C B2)) $;

--| Equality inference for composition of two classes. (Contributed by FL, 7-Jun-2012.)
theorem coeq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (ccom A2 C) (ccom B2 D) $;

--| Equality deduction for composition of two classes. (Contributed by FL, 7-Jun-2012.)
theorem coeq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (ccom A2 C) (ccom B2 D)) $;

--| Bound-variable hypothesis builder for function value. (Contributed by NM, 1-Sep-1999.)
theorem nfco {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (ccom A2 B2) $;

--| Ordered pair membership in a composition. (Contributed by NM, 24-Feb-2015.)
theorem brcog {x3: setvar} (A2 B2 C D: class) (V W: class x3):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (ccom C D)) (wex x3 (wa (wbr A2 (cv x3) D) (wbr (cv x3) B2 C)))) $;

--| Ordered pair membership in a composition. (Contributed by NM, 27-Jan-1997.) (Revised by Mario Carneiro, 24-Feb-2015.)
theorem opelco2g {x3: setvar} (A2 B2 C D: class) (V W: class x3):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wcel (cop A2 B2) (ccom C D)) (wex x3 (wa (wcel (cop A2 (cv x3)) D) (wcel (cop (cv x3) B2) C)))) $;

--| Ordered pair membership in a composition. (Contributed by Thierry Arnoux, 14-Jan-2018.)
theorem brcogw (A2 B2 C D V W X Z: class):
  $ wi (wa (w3a (wcel A2 V) (wcel B2 W) (wcel X Z)) (wa (wbr A2 X D) (wbr X B2 C))) (wbr A2 B2 (ccom C D)) $;

--| Deduction from extensionality principle for relations, given an equivalence only on the relation's domain and range. (Contributed by Thierry Arnoux, 28-Nov-2017.)
theorem eqbrrdva {x3 y1: setvar} (ph: wff) (A2 B2: class) (C D: class x3 y1):
  $ wi ph (wss A2 (cxp C D)) $ >
  $ wi ph (wss B2 (cxp C D)) $ >
  $ wi (w3a ph (wcel (cv x3) C) (wcel (cv y1) D)) (wb (wbr (cv x3) (cv y1) A2) (wbr (cv x3) (cv y1) B2)) $ >
  $ wi ph (wceq A2 B2) $;

--| Binary relation on a composition. (Contributed by NM, 21-Sep-2004.) (Revised by Mario Carneiro, 24-Feb-2015.)
theorem brco {x3: setvar} (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wbr A2 B2 (ccom C D)) (wex x3 (wa (wbr A2 (cv x3) D) (wbr (cv x3) B2 C))) $;

--| Ordered pair membership in a composition. (Contributed by NM, 27-Dec-1996.) (Revised by Mario Carneiro, 24-Feb-2015.)
theorem opelco {x3: setvar} (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wcel (cop A2 B2) (ccom C D)) (wex x3 (wa (wbr A2 (cv x3) D) (wbr (cv x3) B2 C))) $;

--| Subset theorem for converse. (Contributed by NM, 22-Mar-1998.)
theorem cnvss (A2 B2: class):
  $ wi (wss A2 B2) (wss (ccnv A2) (ccnv B2)) $;

--| Equality theorem for converse. (Contributed by NM, 13-Aug-1995.)
theorem cnveq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (ccnv A2) (ccnv B2)) $;

--| Equality inference for converse. (Contributed by NM, 23-Dec-2008.)
theorem cnveqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq (ccnv A2) (ccnv B2) $;

--| Equality deduction for converse. (Contributed by NM, 6-Dec-2013.)
theorem cnveqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (ccnv A2) (ccnv B2)) $;

--| Membership in a converse. Equation 5 of [Suppes] p. 62. (Contributed by NM, 24-Mar-1998.)
theorem elcnv {x3 y1: setvar} (A2 R: class):
  $ wb (wcel A2 (ccnv R)) (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) (wbr (cv y1) (cv x3) R)))) $;

--| Membership in a converse. Equation 5 of [Suppes] p. 62. (Contributed by NM, 11-Aug-2004.)
theorem elcnv2 {x3 y1: setvar} (A2 R: class):
  $ wb (wcel A2 (ccnv R)) (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) (wcel (cop (cv y1) (cv x3)) R)))) $;

--| Bound-variable hypothesis builder for converse. (Contributed by NM, 31-Jan-2004.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfcnv {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (ccnv A2) $;

--| Ordered-pair membership in converse. (Contributed by NM, 13-May-1999.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem opelcnvg (A2 B2 C D R: class):
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wb (wcel (cop A2 B2) (ccnv R)) (wcel (cop B2 A2) R)) $;

--| The converse of a binary relation swaps arguments. Theorem 11 of [Suppes] p. 61. (Contributed by NM, 10-Oct-2005.)
theorem brcnvg (A2 B2 C D R: class):
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wb (wbr A2 B2 (ccnv R)) (wbr B2 A2 R)) $;

--| Ordered-pair membership in converse. (Contributed by NM, 13-Aug-1995.)
theorem opelcnv (A2 B2 R: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wcel (cop A2 B2) (ccnv R)) (wcel (cop B2 A2) R) $;

--| The converse of a binary relation swaps arguments. Theorem 11 of [Suppes] p. 61. (Contributed by NM, 13-Aug-1995.)
theorem brcnv (A2 B2 R: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wbr A2 B2 (ccnv R)) (wbr B2 A2 R) $;

--| Move class substitution in and out of the converse of a function. (Contributed by Thierry Arnoux, 8-Feb-2017.)
theorem csbcnvg {x3: setvar} (A2 F V: class x3):
  $ wi (wcel A2 V) (wceq (ccnv (csb x3 A2 F)) (csb x3 A2 (ccnv F))) $;

--| Distributive law of converse over class composition. Theorem 26 of [Suppes] p. 64. (Contributed by NM, 19-Mar-1998.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem cnvco (A2 B2: class):
  $ wceq (ccnv (ccom A2 B2)) (ccom (ccnv B2) (ccnv A2)) $;

--| The converse of a class union is the (indexed) union of the converses of its members. (Contributed by NM, 11-Aug-2004.)
theorem cnvuni {x3: setvar} (A2: class):
  $ wceq (ccnv (cuni A2)) (ciun x3 A2 (ccnv (cv x3))) $;

--| Alternate definition of domain. Definition 6.5(1) of [TakeutiZaring] p. 24. (Contributed by NM, 28-Dec-1996.)
theorem dfdm3 {x3 y1: setvar} (A2: class):
  $ wceq (cdm A2) (cab x3 (wex y1 (wcel (cop (cv x3) (cv y1)) A2))) $;

--| Alternate definition of range. Definition 4 of [Suppes] p. 60. (Contributed by NM, 27-Dec-1996.)
theorem dfrn2 {x3 y1: setvar} (A2: class):
  $ wceq (crn A2) (cab y1 (wex x3 (wbr (cv x3) (cv y1) A2))) $;

--| Alternate definition of range. Definition 6.5(2) of [TakeutiZaring] p. 24. (Contributed by NM, 28-Dec-1996.)
theorem dfrn3 {x3 y1: setvar} (A2: class):
  $ wceq (crn A2) (cab y1 (wex x3 (wcel (cop (cv x3) (cv y1)) A2))) $;

--| Membership in a range. (Contributed by Scott Fenton, 2-Feb-2011.)
theorem elrn2g {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wcel A2 (crn B2)) (wex x3 (wcel (cop (cv x3) A2) B2))) $;

--| Membership in a range. (Contributed by Scott Fenton, 2-Feb-2011.)
theorem elrng {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wcel A2 (crn B2)) (wex x3 (wbr (cv x3) A2 B2))) $;

--| Alternate definition of domain. (Contributed by NM, 28-Dec-1996.)
theorem dfdm4 (A2: class):
  $ wceq (cdm A2) (crn (ccnv A2)) $;

--| Definition of domain, using bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 8-Mar-1995.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem dfdmf {x3 y1: setvar} (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wceq (cdm A2) (cab x3 (wex y1 (wbr (cv x3) (cv y1) A2))) $;

--| Distribute proper substitution through the domain of a class. (Contributed by Jim Kingdon, 8-Dec-2018.)
theorem csbdmg {x3: setvar} (A2 B2 V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (cdm B2)) (cdm (csb x3 A2 B2))) $;

--| Domain membership. Theorem 4 of [Suppes] p. 59. (Contributed by Mario Carneiro, 9-Jul-2014.)
theorem eldmg {y1: setvar} (A2 B2: class) (V: class y1):
  $ wi (wcel A2 V) (wb (wcel A2 (cdm B2)) (wex y1 (wbr A2 (cv y1) B2))) $;

--| Domain membership. Theorem 4 of [Suppes] p. 59. (Contributed by NM, 27-Jan-1997.) (Revised by Mario Carneiro, 9-Jul-2014.)
theorem eldm2g {y1: setvar} (A2 B2: class) (V: class y1):
  $ wi (wcel A2 V) (wb (wcel A2 (cdm B2)) (wex y1 (wcel (cop A2 (cv y1)) B2))) $;

--| Membership in a domain. Theorem 4 of [Suppes] p. 59. (Contributed by NM, 2-Apr-2004.)
theorem eldm {y1: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cdm B2)) (wex y1 (wbr A2 (cv y1) B2)) $;

--| Membership in a domain. Theorem 4 of [Suppes] p. 59. (Contributed by NM, 1-Aug-1994.)
theorem eldm2 {y1: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cdm B2)) (wex y1 (wcel (cop A2 (cv y1)) B2)) $;

--| Subset theorem for domain. (Contributed by NM, 11-Aug-1994.)
theorem dmss (A2 B2: class):
  $ wi (wss A2 B2) (wss (cdm A2) (cdm B2)) $;

--| Equality theorem for domain. (Contributed by NM, 11-Aug-1994.)
theorem dmeq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (cdm A2) (cdm B2)) $;

--| Equality inference for domain. (Contributed by NM, 4-Mar-2004.)
theorem dmeqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq (cdm A2) (cdm B2) $;

--| Equality deduction for domain. (Contributed by NM, 4-Mar-2004.)
theorem dmeqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cdm A2) (cdm B2)) $;

--| Membership of first of an ordered pair in a domain. (Contributed by NM, 30-Jul-1995.)
theorem opeldm (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wcel (cop A2 B2) C) (wcel A2 (cdm C)) $;

--| Membership of first of a binary relation in a domain. (Contributed by NM, 30-Jul-1995.)
theorem breldm (A2 B2 R: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wbr A2 B2 R) (wcel A2 (cdm R)) $;

--| Membership of first of an ordered pair in a domain. (Contributed by Jim Kingdon, 9-Jul-2019.)
theorem opeldmg (A2 B2 C V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wi (wcel (cop A2 B2) C) (wcel A2 (cdm C))) $;

--| Membership of first of a binary relation in a domain. (Contributed by NM, 21-Mar-2007.)
theorem breldmg (A2 B2 C D R: class):
  $ wi (w3a (wcel A2 C) (wcel B2 D) (wbr A2 B2 R)) (wcel A2 (cdm R)) $;

--| The domain of a union is the union of domains. Exercise 56(a) of [Enderton] p. 65. (Contributed by NM, 12-Aug-1994.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem dmun (A2 B2: class):
  $ wceq (cdm (cun A2 B2)) (cun (cdm A2) (cdm B2)) $;

--| The domain of an intersection belong to the intersection of domains. Theorem 6 of [Suppes] p. 60. (Contributed by NM, 15-Sep-2004.)
theorem dmin (A2 B2: class):
  $ wss (cdm (cin A2 B2)) (cin (cdm A2) (cdm B2)) $;

--| The domain of an indexed union. (Contributed by Mario Carneiro, 26-Apr-2016.)
theorem dmiun {x3: setvar} (A2 B2: class x3):
  $ wceq (cdm (ciun x3 A2 B2)) (ciun x3 A2 (cdm B2)) $;

--| The domain of a union. Part of Exercise 8 of [Enderton] p. 41. (Contributed by NM, 3-Feb-2004.)
theorem dmuni {x3: setvar} (A2: class):
  $ wceq (cdm (cuni A2)) (ciun x3 A2 (cdm (cv x3))) $;

--| The domain of a class of ordered pairs. (Contributed by NM, 16-May-1995.) (Revised by Mario Carneiro, 4-Dec-2016.)
theorem dmopab {x3 y1: setvar} (ph: wff x3 y1):
  $ wceq (cdm (copab x3 y1 ph)) (cab x3 (wex y1 ph)) $;

--| Upper bound for the domain of a restricted class of ordered pairs. (Contributed by NM, 31-Jan-2004.)
theorem dmopabss {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wss (cdm (copab x3 y1 (wa (wcel (cv x3) A2) ph))) A2 $;

--| The domain of a restricted class of ordered pairs. (Contributed by NM, 31-Jan-2004.)
theorem dmopab3 {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wb (wral x3 (wex y1 ph) A2) (wceq (cdm (copab x3 y1 (wa (wcel (cv x3) A2) ph))) A2) $;

--| The domain of the empty set is empty. Part of Theorem 3.8(v) of [Monk1] p. 36. (Contributed by NM, 4-Jul-1994.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem dm0:
  $ wceq (cdm c0) c0 $;

--| The domain of the identity relation is the universe. (Contributed by NM, 30-Apr-1998.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem dmi:
  $ wceq (cdm cid) cvv $;

--| The domain of the universe is the universe. (Contributed by NM, 8-Aug-2003.)
theorem dmv:
  $ wceq (cdm cvv) cvv $;

--| An empty domain implies an empty range. (Contributed by NM, 21-May-1998.)
theorem dm0rn0 (A2: class):
  $ wb (wceq (cdm A2) c0) (wceq (crn A2) c0) $;

--| A relation is empty iff its domain is empty. (Contributed by NM, 15-Sep-2004.)
theorem reldm0 (A2: class):
  $ wi (wrel A2) (wb (wceq A2 c0) (wceq (cdm A2) c0)) $;

--| A domain is inhabited if and only if the range is inhabited. (Contributed by Jim Kingdon, 15-Dec-2018.)
theorem dmmrnm {x3 y1: setvar} (A2: class):
  $ wb (wex x3 (wcel (cv x3) (cdm A2))) (wex y1 (wcel (cv y1) (crn A2))) $;

--| A domain is inhabited if and only if the range is inhabited. (Contributed by Jim Kingdon, 15-Dec-2018.)
theorem dmmrnm_b {x3: setvar} (A2: class):
  $ wb (wex x3 (wcel (cv x3) (cdm A2))) (wex x3 (wcel (cv x3) (crn A2))) $;

--| The domain of a cross product. Part of Theorem 3.13(x) of [Monk1] p. 37. (Contributed by NM, 28-Jul-1995.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem dmxpm {x3: setvar} (A2: class x3) (B2: class):
  $ wi (wex x3 (wcel (cv x3) B2)) (wceq (cdm (cxp A2 B2)) A2) $;

--| The domain of the intersection of two square cross products. Unlike ~ dmin , equality holds. (Contributed by NM, 29-Jan-2008.)
theorem dmxpinm {x3: setvar} (A2 B2: class):
  $ wi (wex x3 (wcel (cv x3) (cin A2 B2))) (wceq (cdm (cin (cxp A2 A2) (cxp B2 B2))) (cin A2 B2)) $;

--| The cross product of a class with itself is one-to-one. (Contributed by Jim Kingdon, 8-Dec-2018.)
theorem xpid11m {x3: setvar} (A2 B2: class):
  $ wi (wa (wex x3 (wcel (cv x3) A2)) (wex x3 (wcel (cv x3) B2))) (wb (wceq (cxp A2 A2) (cxp B2 B2)) (wceq A2 B2)) $;

--| The domain of the double converse of a class (which doesn't have to be a relation as in ~ dfrel2 ). (Contributed by NM, 8-Apr-2007.)
theorem dmcnvcnv (A2: class):
  $ wceq (cdm (ccnv (ccnv A2))) (cdm A2) $;

--| The range of the double converse of a class. (Contributed by NM, 8-Apr-2007.)
theorem rncnvcnv (A2: class):
  $ wceq (crn (ccnv (ccnv A2))) (crn A2) $;

--| The first member of an ordered pair in a relation belongs to the domain of the relation. (Contributed by NM, 28-Jul-2004.)
theorem elreldm (A2 B2: class):
  $ wi (wa (wrel A2) (wcel B2 A2)) (wcel (cint (cint B2)) (cdm A2)) $;

--| Equality theorem for range. (Contributed by NM, 29-Dec-1996.)
theorem rneq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (crn A2) (crn B2)) $;

--| Equality inference for range. (Contributed by NM, 4-Mar-2004.)
theorem rneqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq (crn A2) (crn B2) $;

--| Equality deduction for range. (Contributed by NM, 4-Mar-2004.)
theorem rneqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (crn A2) (crn B2)) $;

--| Subset theorem for range. (Contributed by NM, 22-Mar-1998.)
theorem rnss (A2 B2: class):
  $ wi (wss A2 B2) (wss (crn A2) (crn B2)) $;

--| The second argument of a binary relation belongs to its range. (Contributed by NM, 29-Jun-2008.)
theorem brelrng (A2 B2 C F G: class):
  $ wi (w3a (wcel A2 F) (wcel B2 G) (wbr A2 B2 C)) (wcel B2 (crn C)) $;

--| Membership of second member of an ordered pair in a range. (Contributed by Jim Kingdon, 26-Jan-2019.)
theorem opelrng (A2 B2 C F G: class):
  $ wi (w3a (wcel A2 F) (wcel B2 G) (wcel (cop A2 B2) C)) (wcel B2 (crn C)) $;

--| The second argument of a binary relation belongs to its range. (Contributed by NM, 13-Aug-2004.)
theorem brelrn (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wbr A2 B2 C) (wcel B2 (crn C)) $;

--| Membership of second member of an ordered pair in a range. (Contributed by NM, 23-Feb-1997.)
theorem opelrn (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wcel (cop A2 B2) C) (wcel B2 (crn C)) $;

--| The first argument of a binary relation belongs to its domain. (Contributed by NM, 2-Jul-2008.)
theorem releldm (A2 B2 R: class):
  $ wi (wa (wrel R) (wbr A2 B2 R)) (wcel A2 (cdm R)) $;

--| The second argument of a binary relation belongs to its range. (Contributed by NM, 2-Jul-2008.)
theorem relelrn (A2 B2 R: class):
  $ wi (wa (wrel R) (wbr A2 B2 R)) (wcel B2 (crn R)) $;

--| Membership in a domain. (Contributed by Mario Carneiro, 5-Nov-2015.)
theorem releldmb {x3: setvar} (A2 R: class):
  $ wi (wrel R) (wb (wcel A2 (cdm R)) (wex x3 (wbr A2 (cv x3) R))) $;

--| Membership in a range. (Contributed by Mario Carneiro, 5-Nov-2015.)
theorem relelrnb {x3: setvar} (A2 R: class):
  $ wi (wrel R) (wb (wcel A2 (crn R)) (wex x3 (wbr (cv x3) A2 R))) $;

--| The first argument of a binary relation belongs to its domain. (Contributed by NM, 28-Apr-2015.)
theorem releldmi (A2 B2 R: class):
  $ wrel R $ >
  $ wi (wbr A2 B2 R) (wcel A2 (cdm R)) $;

--| The second argument of a binary relation belongs to its range. (Contributed by NM, 28-Apr-2015.)
theorem relelrni (A2 B2 R: class):
  $ wrel R $ >
  $ wi (wbr A2 B2 R) (wcel B2 (crn R)) $;

--| Definition of range, using bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 14-Aug-1995.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem dfrnf {x3 y1: setvar} (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wceq (crn A2) (cab y1 (wex x3 (wbr (cv x3) (cv y1) A2))) $;

--| Membership in a range. (Contributed by NM, 10-Jul-1994.)
theorem elrn2 {x3: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (crn B2)) (wex x3 (wcel (cop (cv x3) A2) B2)) $;

--| Membership in a range. (Contributed by NM, 2-Apr-2004.)
theorem elrn {x3: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (crn B2)) (wex x3 (wbr (cv x3) A2 B2)) $;

--| Bound-variable hypothesis builder for domain. (Contributed by NM, 30-Jan-2004.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfdm {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (cdm A2) $;

--| Bound-variable hypothesis builder for range. (Contributed by NM, 1-Sep-1999.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfrn {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (crn A2) $;

--| Domain of an intersection. (Contributed by FL, 15-Oct-2012.)
theorem dmiin {x3: setvar} (A2 B2: class x3):
  $ wss (cdm (ciin x3 A2 B2)) (ciin x3 A2 (cdm B2)) $;

--| The range of a class of ordered pairs. (Contributed by NM, 14-Aug-1995.) (Revised by Mario Carneiro, 4-Dec-2016.)
theorem rnopab {x3 y1: setvar} (ph: wff x3 y1):
  $ wceq (crn (copab x3 y1 ph)) (cab y1 (wex x3 ph)) $;

--| The range of a function in maps-to notation. (Contributed by Scott Fenton, 21-Mar-2011.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem rnmpt {x3 y1: setvar} (A2 B2: class x3) (F: class x3 y1):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wceq (crn F) (cab y1 (wrex x3 (wceq (cv y1) B2) A2)) $;

--| The range of a function in maps-to notation. (Contributed by Mario Carneiro, 20-Feb-2015.)
theorem elrnmpt {x3: setvar} (A2 B2: class x3) (C: class) (F V: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wcel C V) (wb (wcel C (crn F)) (wrex x3 (wceq C B2) A2)) $;

--| Elementhood in an image set. (Contributed by Mario Carneiro, 12-Sep-2015.)
theorem elrnmpt1s {x3: setvar} (A2: class) (B2: class x3) (C D: class) (F V: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wceq (cv x3) D) (wceq B2 C) $ >
  $ wi (wa (wcel D A2) (wcel C V)) (wcel C (crn F)) $;

--| Elementhood in an image set. (Contributed by Mario Carneiro, 31-Aug-2015.)
theorem elrnmpt1 {x3: setvar} (A2 B2 F V: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wa (wcel (cv x3) A2) (wcel B2 V)) (wcel B2 (crn F)) $;

--| Membership in the range of a function. (Contributed by NM, 27-Aug-2007.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem elrnmptg {x3: setvar} (A2 B2: class x3) (C: class) (F V: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wral x3 (wcel B2 V) A2) (wb (wcel C (crn F)) (wrex x3 (wceq C B2) A2)) $;

--| Membership in the range of a function. (Contributed by NM, 30-Aug-2004.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem elrnmpti {x3: setvar} (A2 B2: class x3) (C: class) (F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wcel B2 cvv $ >
  $ wb (wcel C (crn F)) (wrex x3 (wceq C B2) A2) $;

--| The range of the empty set is empty. Part of Theorem 3.8(v) of [Monk1] p. 36. (Contributed by NM, 4-Jul-1994.)
theorem rn0:
  $ wceq (crn c0) c0 $;

--| Alternate definition of indexed union when ` B ` is a set. (Contributed by Mario Carneiro, 31-Aug-2015.)
theorem dfiun3g {x3: setvar} (A2 B2 C: class x3):
  $ wi (wral x3 (wcel B2 C) A2) (wceq (ciun x3 A2 B2) (cuni (crn (cmpt x3 A2 B2)))) $;

--| Alternate definition of indexed intersection when ` B ` is a set. (Contributed by Mario Carneiro, 31-Aug-2015.)
theorem dfiin3g {x3: setvar} (A2 B2 C: class x3):
  $ wi (wral x3 (wcel B2 C) A2) (wceq (ciin x3 A2 B2) (cint (crn (cmpt x3 A2 B2)))) $;

--| Alternate definition of indexed union when ` B ` is a set. (Contributed by Mario Carneiro, 31-Aug-2015.)
theorem dfiun3 {x3: setvar} (A2 B2: class x3):
  $ wcel B2 cvv $ >
  $ wceq (ciun x3 A2 B2) (cuni (crn (cmpt x3 A2 B2))) $;

--| Alternate definition of indexed intersection when ` B ` is a set. (Contributed by Mario Carneiro, 31-Aug-2015.)
theorem dfiin3 {x3: setvar} (A2 B2: class x3):
  $ wcel B2 cvv $ >
  $ wceq (ciin x3 A2 B2) (cint (crn (cmpt x3 A2 B2))) $;

--| Express a relative indexed intersection as an intersection. (Contributed by Stefan O'Rear, 22-Feb-2015.)
theorem riinint {k: setvar} (S I: class k) (V X: class):
  $ wi (wa (wcel X V) (wral k (wss S X) I)) (wceq (cin X (ciin k I S)) (cint (cun (csn X) (crn (cmpt k I S))))) $;

--| A relation is empty iff its range is empty. (Contributed by NM, 15-Sep-2004.)
theorem relrn0 (A2: class):
  $ wi (wrel A2) (wb (wceq A2 c0) (wceq (crn A2) c0)) $;

--| The domain and range of a class are included in its double union. (Contributed by NM, 13-May-2008.)
theorem dmrnssfld (A2: class):
  $ wss (cun (cdm A2) (crn A2)) (cuni (cuni A2)) $;

--| The domain of a set is a set. Corollary 6.8(2) of [TakeutiZaring] p. 26. (Contributed by NM, 7-Apr-1995.)
theorem dmexg (A2 V: class):
  $ wi (wcel A2 V) (wcel (cdm A2) cvv) $;

--| The range of a set is a set. Corollary 6.8(3) of [TakeutiZaring] p. 26. Similar to Lemma 3D of [Enderton] p. 41. (Contributed by NM, 31-Mar-1995.)
theorem rnexg (A2 V: class):
  $ wi (wcel A2 V) (wcel (crn A2) cvv) $;

--| The domain of a set is a set. Corollary 6.8(2) of [TakeutiZaring] p. 26. (Contributed by NM, 7-Jul-2008.)
theorem dmex (A2: class):
  $ wcel A2 cvv $ >
  $ wcel (cdm A2) cvv $;

--| The range of a set is a set. Corollary 6.8(3) of [TakeutiZaring] p. 26. Similar to Lemma 3D of [Enderton] p. 41. (Contributed by NM, 7-Jul-2008.)
theorem rnex (A2: class):
  $ wcel A2 cvv $ >
  $ wcel (crn A2) cvv $;

--| The identity function is a proper class. This means, for example, that we cannot use it as a member of the class of continuous functions unless it is restricted to a set. (Contributed by NM, 1-Jan-2007.)
theorem iprc:
  $ wn (wcel cid cvv) $;

--| Domain of a composition. Theorem 21 of [Suppes] p. 63. (Contributed by NM, 19-Mar-1998.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem dmcoss (A2 B2: class):
  $ wss (cdm (ccom A2 B2)) (cdm B2) $;

--| Range of a composition. (Contributed by NM, 19-Mar-1998.)
theorem rncoss (A2 B2: class):
  $ wss (crn (ccom A2 B2)) (crn A2) $;

--| Domain of a composition. (Contributed by NM, 28-May-1998.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem dmcosseq (A2 B2: class):
  $ wi (wss (crn B2) (cdm A2)) (wceq (cdm (ccom A2 B2)) (cdm B2)) $;

--| Domain of a composition. (Contributed by NM, 19-Mar-1998.)
theorem dmcoeq (A2 B2: class):
  $ wi (wceq (cdm A2) (crn B2)) (wceq (cdm (ccom A2 B2)) (cdm B2)) $;

--| Range of a composition. (Contributed by NM, 19-Mar-1998.)
theorem rncoeq (A2 B2: class):
  $ wi (wceq (cdm A2) (crn B2)) (wceq (crn (ccom A2 B2)) (crn A2)) $;

--| Equality theorem for restrictions. (Contributed by NM, 7-Aug-1994.)
theorem reseq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cres A2 C) (cres B2 C)) $;

--| Equality theorem for restrictions. (Contributed by NM, 8-Aug-1994.)
theorem reseq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cres C A2) (cres C B2)) $;

--| Equality inference for restrictions. (Contributed by NM, 21-Oct-2014.)
theorem reseq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cres A2 C) (cres B2 C) $;

--| Equality inference for restrictions. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem reseq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cres C A2) (cres C B2) $;

--| Equality inference for restrictions. (Contributed by NM, 21-Oct-2014.)
theorem reseq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (cres A2 C) (cres B2 D) $;

--| Equality deduction for restrictions. (Contributed by NM, 21-Oct-2014.)
theorem reseq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cres A2 C) (cres B2 C)) $;

--| Equality deduction for restrictions. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem reseq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cres C A2) (cres C B2)) $;

--| Equality deduction for restrictions. (Contributed by NM, 21-Oct-2014.)
theorem reseq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cres A2 C) (cres B2 D)) $;

--| Bound-variable hypothesis builder for restriction. (Contributed by NM, 15-Sep-2003.) (Revised by David Abernethy, 19-Jun-2012.)
theorem nfres {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cres A2 B2) $;

--| Distribute proper substitution through the restriction of a class. (Contributed by Alan Sare, 10-Nov-2012.)
theorem csbresg {x3: setvar} (A2 B2 C V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (cres B2 C)) (cres (csb x3 A2 B2) (csb x3 A2 C))) $;

--| A restriction to the empty set is empty. (Contributed by NM, 12-Nov-1994.)
theorem res0 (A2: class):
  $ wceq (cres A2 c0) c0 $;

--| Ordered pair membership in a restriction. Exercise 13 of [TakeutiZaring] p. 25. (Contributed by NM, 13-Nov-1995.)
theorem opelres (A2 B2 C D: class):
  $ wcel B2 cvv $ >
  $ wb (wcel (cop A2 B2) (cres C D)) (wa (wcel (cop A2 B2) C) (wcel A2 D)) $;

--| Binary relation on a restriction. (Contributed by NM, 12-Dec-2006.)
theorem brres (A2 B2 C D: class):
  $ wcel B2 cvv $ >
  $ wb (wbr A2 B2 (cres C D)) (wa (wbr A2 B2 C) (wcel A2 D)) $;

--| Ordered pair membership in a restriction. Exercise 13 of [TakeutiZaring] p. 25. (Contributed by NM, 14-Oct-2005.)
theorem opelresg (A2 B2 C D V: class):
  $ wi (wcel B2 V) (wb (wcel (cop A2 B2) (cres C D)) (wa (wcel (cop A2 B2) C) (wcel A2 D))) $;

--| Binary relation on a restriction. (Contributed by Mario Carneiro, 4-Nov-2015.)
theorem brresg (A2 B2 C D V: class):
  $ wi (wcel B2 V) (wb (wbr A2 B2 (cres C D)) (wa (wbr A2 B2 C) (wcel A2 D))) $;

--| Ordered pair membership in a restriction when the first member belongs to the restricting class. (Contributed by NM, 30-Apr-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem opres (A2 B2 C D: class):
  $ wcel B2 cvv $ >
  $ wi (wcel A2 D) (wb (wcel (cop A2 B2) (cres C D)) (wcel (cop A2 B2) C)) $;

--| A restricted identity relation is equivalent to equality in its domain. (Contributed by NM, 30-Apr-2004.)
theorem resieq (A2 B2 C: class):
  $ wi (wa (wcel B2 A2) (wcel C A2)) (wb (wbr B2 C (cres cid A2)) (wceq B2 C)) $;

--| ` <. A , A >. ` belongs to a restriction of the identity class iff ` A ` belongs to the restricting class. (Contributed by FL, 27-Oct-2008.) (Revised by NM, 30-Mar-2016.)
theorem opelresi (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wcel (cop A2 A2) (cres cid B2)) (wcel A2 B2)) $;

--| The restriction of a restriction. (Contributed by NM, 27-Mar-2008.)
theorem resres (A2 B2 C: class):
  $ wceq (cres (cres A2 B2) C) (cres A2 (cin B2 C)) $;

--| Distributive law for restriction over union. Theorem 31 of [Suppes] p. 65. (Contributed by NM, 30-Sep-2002.)
theorem resundi (A2 B2 C: class):
  $ wceq (cres A2 (cun B2 C)) (cun (cres A2 B2) (cres A2 C)) $;

--| Distributive law for restriction over union. (Contributed by NM, 23-Sep-2004.)
theorem resundir (A2 B2 C: class):
  $ wceq (cres (cun A2 B2) C) (cun (cres A2 C) (cres B2 C)) $;

--| Class restriction distributes over intersection. (Contributed by FL, 6-Oct-2008.)
theorem resindi (A2 B2 C: class):
  $ wceq (cres A2 (cin B2 C)) (cin (cres A2 B2) (cres A2 C)) $;

--| Class restriction distributes over intersection. (Contributed by NM, 18-Dec-2008.)
theorem resindir (A2 B2 C: class):
  $ wceq (cres (cin A2 B2) C) (cin (cres A2 C) (cres B2 C)) $;

--| Move intersection into class restriction. (Contributed by NM, 18-Dec-2008.)
theorem inres (A2 B2 C: class):
  $ wceq (cin A2 (cres B2 C)) (cres (cin A2 B2) C) $;

--| Distribution of restriction over indexed union. (Contributed by Mario Carneiro, 29-May-2015.)
theorem resiun1 {x3: setvar} (A2 B2: class x3) (C: class):
  $ wceq (cres (ciun x3 A2 B2) C) (ciun x3 A2 (cres B2 C)) $;

--| Distribution of restriction over indexed union. (Contributed by Mario Carneiro, 29-May-2015.)
theorem resiun2 {x3: setvar} (A2 B2: class x3) (C: class):
  $ wceq (cres C (ciun x3 A2 B2)) (ciun x3 A2 (cres C B2)) $;

--| The domain of a restriction. Exercise 14 of [TakeutiZaring] p. 25. (Contributed by NM, 1-Aug-1994.)
theorem dmres (A2 B2: class):
  $ wceq (cdm (cres A2 B2)) (cin B2 (cdm A2)) $;

--| A domain restricted to a subclass equals the subclass. (Contributed by NM, 2-Mar-1997.)
theorem ssdmres (A2 B2: class):
  $ wb (wss A2 (cdm B2)) (wceq (cdm (cres B2 A2)) A2) $;

--| The domain of a restriction to a set exists. (Contributed by NM, 7-Apr-1995.)
theorem dmresexg (A2 B2 V: class):
  $ wi (wcel B2 V) (wcel (cdm (cres A2 B2)) cvv) $;

--| A class includes its restriction. Exercise 15 of [TakeutiZaring] p. 25. (Contributed by NM, 2-Aug-1994.)
theorem resss (A2 B2: class):
  $ wss (cres A2 B2) A2 $;

--| Commutative law for restriction. (Contributed by NM, 27-Mar-1998.)
theorem rescom (A2 B2 C: class):
  $ wceq (cres (cres A2 B2) C) (cres (cres A2 C) B2) $;

--| Subclass theorem for restriction. (Contributed by NM, 16-Aug-1994.)
theorem ssres (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cres A2 C) (cres B2 C)) $;

--| Subclass theorem for restriction. (Contributed by NM, 22-Mar-1998.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem ssres2 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cres C A2) (cres C B2)) $;

--| A restriction is a relation. Exercise 12 of [TakeutiZaring] p. 25. (Contributed by NM, 2-Aug-1994.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem relres (A2 B2: class):
  $ wrel (cres A2 B2) $;

--| Absorption law for restriction. Exercise 17 of [TakeutiZaring] p. 25. (Contributed by NM, 9-Aug-1994.)
theorem resabs1 (A2 B2 C: class):
  $ wi (wss B2 C) (wceq (cres (cres A2 C) B2) (cres A2 B2)) $;

--| Absorption law for restriction. (Contributed by NM, 27-Mar-1998.)
theorem resabs2 (A2 B2 C: class):
  $ wi (wss B2 C) (wceq (cres (cres A2 B2) C) (cres A2 B2)) $;

--| Idempotent law for restriction. (Contributed by NM, 27-Mar-1998.)
theorem residm (A2 B2: class):
  $ wceq (cres (cres A2 B2) B2) (cres A2 B2) $;

--| A restriction to an image. (Contributed by NM, 29-Sep-2004.)
theorem resima (A2 B2: class):
  $ wceq (cima (cres A2 B2) B2) (cima A2 B2) $;

--| Image under a restricted class. (Contributed by FL, 31-Aug-2009.)
theorem resima2 (A2 B2 C: class):
  $ wi (wss B2 C) (wceq (cima (cres A2 C) B2) (cima A2 B2)) $;

--| Restriction of a constant function (or other cross product). (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem xpssres (A2 B2 C: class):
  $ wi (wss C A2) (wceq (cres (cxp A2 B2) C) (cxp C B2)) $;

--| Membership in a restriction. (Contributed by Scott Fenton, 17-Mar-2011.)
theorem elres {x3 y1: setvar} (A2 B2 C: class):
  $ wb (wcel A2 (cres B2 C)) (wrex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) (wcel (cop (cv x3) (cv y1)) B2))) C) $;

--| Memebership in restriction to a singleton. (Contributed by Scott Fenton, 17-Mar-2011.)
theorem elsnres {y1: setvar} (A2 B2 C: class):
  $ wcel C cvv $ >
  $ wb (wcel A2 (cres B2 (csn C))) (wex y1 (wa (wceq A2 (cop C (cv y1))) (wcel (cop C (cv y1)) B2))) $;

--| Simplification law for restriction. (Contributed by NM, 16-Aug-1994.)
theorem relssres (A2 B2: class):
  $ wi (wa (wrel A2) (wss (cdm A2) B2)) (wceq (cres A2 B2) A2) $;

--| A relation restricted to its domain equals itself. (Contributed by NM, 12-Dec-2006.)
theorem resdm (A2: class):
  $ wi (wrel A2) (wceq (cres A2 (cdm A2)) A2) $;

--| The restriction of a set is a set. (Contributed by NM, 28-Mar-1998.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem resexg (A2 B2 V: class):
  $ wi (wcel A2 V) (wcel (cres A2 B2) cvv) $;

--| The restriction of a set is a set. (Contributed by Jeff Madsen, 19-Jun-2011.)
theorem resex (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel (cres A2 B2) cvv $;

--| Restriction of a class abstraction of ordered pairs. (Contributed by NM, 5-Nov-2002.)
theorem resopab {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wceq (cres (copab x3 y1 ph) A2) (copab x3 y1 (wa (wcel (cv x3) A2) ph)) $;

--| The existence of a restricted identity function, proved without using the Axiom of Replacement. (Contributed by NM, 13-Jan-2007.)
theorem resiexg (A2 V: class):
  $ wi (wcel A2 V) (wcel (cres cid A2) cvv) $;

--| A subclass of the identity function is the identity function restricted to its domain. (Contributed by NM, 13-Dec-2003.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem iss (A2: class):
  $ wb (wss A2 cid) (wceq A2 (cres cid (cdm A2))) $;

--| Restriction of a class abstraction of ordered pairs. (Contributed by NM, 24-Aug-2007.)
theorem resopab2 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class):
  $ wi (wss A2 B2) (wceq (cres (copab x3 y1 (wa (wcel (cv x3) B2) ph)) A2) (copab x3 y1 (wa (wcel (cv x3) A2) ph))) $;

--| Restriction of the mapping operation. (Contributed by Mario Carneiro, 15-Jul-2013.)
theorem resmpt {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wss B2 A2) (wceq (cres (cmpt x3 A2 C) B2) (cmpt x3 B2 C)) $;

--| Unconditional restriction of the mapping operation. (Contributed by Stefan O'Rear, 24-Jan-2015.) (Proof shortened by Mario Carneiro, 22-Mar-2015.)
theorem resmpt3 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wceq (cres (cmpt x3 A2 C) B2) (cmpt x3 (cin A2 B2) C) $;

--| Alternate definition of the restriction operation. (Contributed by Mario Carneiro, 5-Nov-2013.)
theorem dfres2 {x3 y1: setvar} (A2 R: class):
  $ wceq (cres R A2) (copab x3 y1 (wa (wcel (cv x3) A2) (wbr (cv x3) (cv y1) R))) $;

--| The restricted identity expressed with the class builder. (Contributed by FL, 25-Apr-2012.)
theorem opabresid {x3 y1: setvar} (A2: class):
  $ wceq (copab x3 y1 (wa (wcel (cv x3) A2) (wceq (cv y1) (cv x3)))) (cres cid A2) $;

--| The restricted identity expressed with the "maps to" notation. (Contributed by FL, 25-Apr-2012.)
theorem mptresid {x3: setvar} (A2: class):
  $ wceq (cmpt x3 A2 (cv x3)) (cres cid A2) $;

--| The domain of a restricted identity function. (Contributed by NM, 27-Aug-2004.)
theorem dmresi (A2: class):
  $ wceq (cdm (cres cid A2)) A2 $;

--| Any relation restricted to the universe is itself. (Contributed by NM, 16-Mar-2004.)
theorem resid (A2: class):
  $ wi (wrel A2) (wceq (cres A2 cvv) A2) $;

--| Equality theorem for image. (Contributed by NM, 14-Aug-1994.)
theorem imaeq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cima A2 C) (cima B2 C)) $;

--| Equality theorem for image. (Contributed by NM, 14-Aug-1994.)
theorem imaeq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cima C A2) (cima C B2)) $;

--| Equality theorem for image. (Contributed by NM, 21-Dec-2008.)
theorem imaeq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cima A2 C) (cima B2 C) $;

--| Equality theorem for image. (Contributed by NM, 21-Dec-2008.)
theorem imaeq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cima C A2) (cima C B2) $;

--| Equality theorem for image. (Contributed by FL, 15-Dec-2006.)
theorem imaeq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cima A2 C) (cima B2 C)) $;

--| Equality theorem for image. (Contributed by FL, 15-Dec-2006.)
theorem imaeq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cima C A2) (cima C B2)) $;

--| Equality theorem for image. (Contributed by Mario Carneiro, 4-Dec-2016.)
theorem imaeq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cima A2 C) (cima B2 D)) $;

--| Alternate definition of image. Compare definition (d) of [Enderton] p. 44. (Contributed by NM, 19-Apr-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem dfima2 {x3 y1: setvar} (A2 B2: class):
  $ wceq (cima A2 B2) (cab y1 (wrex x3 (wbr (cv x3) (cv y1) A2) B2)) $;

--| Alternate definition of image. Compare definition (d) of [Enderton] p. 44. (Contributed by NM, 14-Aug-1994.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem dfima3 {x3 y1: setvar} (A2 B2: class):
  $ wceq (cima A2 B2) (cab y1 (wex x3 (wa (wcel (cv x3) B2) (wcel (cop (cv x3) (cv y1)) A2)))) $;

--| Membership in an image. Theorem 34 of [Suppes] p. 65. (Contributed by NM, 20-Jan-2007.)
theorem elimag {x3: setvar} (A2 B2 C: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wcel A2 (cima B2 C)) (wrex x3 (wbr (cv x3) A2 B2) C)) $;

--| Membership in an image. Theorem 34 of [Suppes] p. 65. (Contributed by NM, 19-Apr-2004.)
theorem elima {x3: setvar} (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cima B2 C)) (wrex x3 (wbr (cv x3) A2 B2) C) $;

--| Membership in an image. Theorem 34 of [Suppes] p. 65. (Contributed by NM, 11-Aug-2004.)
theorem elima2 {x3: setvar} (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cima B2 C)) (wex x3 (wa (wcel (cv x3) C) (wbr (cv x3) A2 B2))) $;

--| Membership in an image. Theorem 34 of [Suppes] p. 65. (Contributed by NM, 14-Aug-1994.)
theorem elima3 {x3: setvar} (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cima B2 C)) (wex x3 (wa (wcel (cv x3) C) (wcel (cop (cv x3) A2) B2))) $;

--| Bound-variable hypothesis builder for image. (Contributed by NM, 30-Dec-1996.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem nfima {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cima A2 B2) $;

--| Deduction version of bound-variable hypothesis builder ~ nfima . (Contributed by FL, 15-Dec-2006.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfimad {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnfc x3 (cima A2 B2)) $;

--| The image of the domain of a class is the range of the class. (Contributed by NM, 14-Aug-1994.)
theorem imadmrn (A2: class):
  $ wceq (cima A2 (cdm A2)) (crn A2) $;

--| The image of a class is a subset of its range. Theorem 3.16(xi) of [Monk1] p. 39. (Contributed by NM, 31-Mar-1995.)
theorem imassrn (A2 B2: class):
  $ wss (cima A2 B2) (crn A2) $;

--| The image of a set is a set. Theorem 3.17 of [Monk1] p. 39. (Contributed by NM, 24-Jul-1995.)
theorem imaexg (A2 B2 V: class):
  $ wi (wcel A2 V) (wcel (cima A2 B2) cvv) $;

--| Image under the identity relation. Theorem 3.16(viii) of [Monk1] p. 38. (Contributed by NM, 30-Apr-1998.)
theorem imai (A2: class):
  $ wceq (cima cid A2) A2 $;

--| The range of the restricted identity function. (Contributed by NM, 27-Aug-2004.)
theorem rnresi (A2: class):
  $ wceq (crn (cres cid A2)) A2 $;

--| The image of a restriction of the identity function. (Contributed by FL, 31-Dec-2006.)
theorem resiima (A2 B2: class):
  $ wi (wss B2 A2) (wceq (cima (cres cid A2) B2) B2) $;

--| Image of the empty set. Theorem 3.16(ii) of [Monk1] p. 38. (Contributed by NM, 20-May-1998.)
theorem ima0 (A2: class):
  $ wceq (cima A2 c0) c0 $;

--| Image under the empty relation. (Contributed by FL, 11-Jan-2007.)
theorem _0ima (A2: class):
  $ wceq (cima c0 A2) c0 $;

--| Move class substitution in and out of the image of a function. (Contributed by FL, 15-Dec-2006.) (Proof shortened by Mario Carneiro, 4-Dec-2016.)
theorem csbima12g {x3: setvar} (A2 B2 C F: class x3):
  $ wi (wcel A2 C) (wceq (csb x3 A2 (cima F B2)) (cima (csb x3 A2 F) (csb x3 A2 B2))) $;

--| A class whose image under another is empty is disjoint with the other's domain. (Contributed by FL, 24-Jan-2007.)
theorem imadisj (A2 B2: class):
  $ wb (wceq (cima A2 B2) c0) (wceq (cin (cdm A2) B2) c0) $;

--| A preimage under any class is included in the domain of the class. (Contributed by FL, 29-Jan-2007.)
theorem cnvimass (A2 B2: class):
  $ wss (cima (ccnv A2) B2) (cdm A2) $;

--| The preimage of the range of a class is the domain of the class. (Contributed by Jeff Hankins, 15-Jul-2009.)
theorem cnvimarndm (A2: class):
  $ wceq (cima (ccnv A2) (crn A2)) (cdm A2) $;

--| The image of a singleton. (Contributed by NM, 8-May-2005.)
theorem imasng {y1: setvar} (A2: class) (B2: class y1) (R: class):
  $ wi (wcel A2 B2) (wceq (cima R (csn A2)) (cab y1 (wbr A2 (cv y1) R))) $;

--| Elementhood in the image of a singleton. (Contributed by Jim Kingdon, 10-Dec-2018.)
theorem elreimasng (A2 B2 R V: class):
  $ wi (wa (wrel R) (wcel A2 V)) (wb (wcel B2 (cima R (csn A2))) (wbr A2 B2 R)) $;

--| Membership in an image of a singleton. (Contributed by NM, 15-Mar-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem elimasn (A2 B2 C: class):
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wb (wcel C (cima A2 (csn B2))) (wcel (cop B2 C) A2) $;

--| Membership in an image of a singleton. (Contributed by Raph Levien, 21-Oct-2006.)
theorem elimasng (A2 B2 C V W: class):
  $ wi (wa (wcel B2 V) (wcel C W)) (wb (wcel C (cima A2 (csn B2))) (wcel (cop B2 C) A2)) $;

--| Two ways to express the class of unique-valued arguments of ` F ` , which is the same as the domain of ` F ` whenever ` F ` is a function. The left-hand side of the equality is from Definition 10.2 of [Quine] p. 65. Quine uses the notation "arg ` F ` " for this class (for which we have no separate notation). (Contributed by NM, 8-May-2005.)
theorem args {x3 y1: setvar} (F: class x3):
  $ wceq (cab x3 (wex y1 (wceq (cima F (csn (cv x3))) (csn (cv y1))))) (cab x3 (weu y1 (wbr (cv x3) (cv y1) F))) $;

--| Membership in an initial segment. The idiom ` ( ``' A " { B } ) ` , meaning ` { x | x A B } ` , is used to specify an initial segment in (for example) Definition 6.21 of [TakeutiZaring] p. 30. (Contributed by NM, 28-Apr-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem eliniseg (A2 B2 C V: class):
  $ wcel C cvv $ >
  $ wi (wcel B2 V) (wb (wcel C (cima (ccnv A2) (csn B2))) (wbr C B2 A2)) $;

--| Any set is equal to its preimage under the converse epsilon relation. (Contributed by Mario Carneiro, 9-Mar-2013.)
theorem epini (A2: class):
  $ wcel A2 cvv $ >
  $ wceq (cima (ccnv cep) (csn A2)) A2 $;

--| An idiom that signifies an initial segment of an ordering, used, for example, in Definition 6.21 of [TakeutiZaring] p. 30. (Contributed by NM, 28-Apr-2004.)
theorem iniseg {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel B2 V) (wceq (cima (ccnv A2) (csn B2)) (cab x3 (wbr (cv x3) B2 A2))) $;

--| Alternate definition of set-like relation. (Contributed by Mario Carneiro, 23-Jun-2015.)
theorem dfse2 {x3: setvar} (A2 R: class):
  $ wb (wse A2 R) (wral x3 (wcel (cin A2 (cima (ccnv R) (csn (cv x3)))) cvv) A2) $;

--| Any set relation is set-like. (Contributed by Mario Carneiro, 22-Jun-2015.)
theorem exse2 (A2 R V: class):
  $ wi (wcel R V) (wse A2 R) $;

--| Subset theorem for image. (Contributed by NM, 16-Mar-2004.)
theorem imass1 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cima A2 C) (cima B2 C)) $;

--| Subset theorem for image. Exercise 22(a) of [Enderton] p. 53. (Contributed by NM, 22-Mar-1998.)
theorem imass2 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cima C A2) (cima C B2)) $;

--| The image of a singleton outside the domain is empty. (Contributed by NM, 22-May-1998.)
theorem ndmima (A2 B2: class):
  $ wi (wn (wcel A2 (cdm B2))) (wceq (cima B2 (csn A2)) c0) $;

--| A converse is a relation. Theorem 12 of [Suppes] p. 62. (Contributed by NM, 29-Oct-1996.)
theorem relcnv (A2: class):
  $ wrel (ccnv A2) $;

--| When ` R ` is a relation, the sethood assumptions on ~ brcnv can be omitted. (Contributed by Mario Carneiro, 28-Apr-2015.)
theorem relbrcnvg (A2 B2 R: class):
  $ wi (wrel R) (wb (wbr A2 B2 (ccnv R)) (wbr B2 A2 R)) $;

--| When ` R ` is a relation, the sethood assumptions on ~ brcnv can be omitted. (Contributed by Mario Carneiro, 28-Apr-2015.)
theorem relbrcnv (A2 B2 R: class):
  $ wrel R $ >
  $ wb (wbr A2 B2 (ccnv R)) (wbr B2 A2 R) $;

--| Two ways of saying a relation is transitive. Definition of transitivity in [Schechter] p. 51. (Contributed by NM, 27-Dec-1996.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem cotr {x3 y1 z: setvar} (R: class):
  $ wb (wss (ccom R R) R) (wal x3 (wal y1 (wal z (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R)) (wbr (cv x3) (cv z) R))))) $;

--| Two ways to state a relation is reflexive. Adapted from Tarski. (Contributed by FL, 15-Jan-2012.) (Revised by NM, 30-Mar-2016.)
theorem issref {x3: setvar} (A2 R: class):
  $ wb (wss (cres cid A2) R) (wral x3 (wbr (cv x3) (cv x3) R) A2) $;

--| Two ways of saying a relation is symmetric. Similar to definition of symmetry in [Schechter] p. 51. (Contributed by NM, 28-Dec-1996.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem cnvsym {x3 y1: setvar} (R: class):
  $ wb (wss (ccnv R) R) (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)))) $;

--| Two ways of saying a relation is antisymmetric. Definition of antisymmetry in [Schechter] p. 51. (Contributed by NM, 9-Sep-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem intasym {x3 y1: setvar} (R: class):
  $ wb (wss (cin R (ccnv R)) cid) (wal x3 (wal y1 (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)) (wceq (cv x3) (cv y1))))) $;

--| Two ways of saying a relation is antisymmetric and reflexive. ` U. U. R ` is the field of a relation by ~ relfld . (Contributed by NM, 6-May-2008.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem asymref {x3 y1: setvar} (R: class):
  $ wb (wceq (cin R (ccnv R)) (cres cid (cuni (cuni R)))) (wral x3 (wal y1 (wb (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)) (wceq (cv x3) (cv y1)))) (cuni (cuni R))) $;

--| Two ways of saying a relation is irreflexive. Definition of irreflexivity in [Schechter] p. 51. (Contributed by NM, 9-Sep-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem intirr {x3: setvar} (R: class):
  $ wb (wceq (cin R cid) c0) (wal x3 (wn (wbr (cv x3) (cv x3) R))) $;

--| Two ways of saying that two elements have an upper bound. (Contributed by Mario Carneiro, 3-Nov-2015.)
theorem brcodir {z: setvar} (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (ccom (ccnv R) R)) (wex z (wa (wbr A2 (cv z) R) (wbr B2 (cv z) R)))) $;

--| Two ways of saying a relation is directed. (Contributed by Mario Carneiro, 22-Nov-2013.)
theorem codir {x3 y1 z: setvar} (A2 B2 R: class):
  $ wb (wss (cxp A2 B2) (ccom (ccnv R) R)) (wral x3 (wral y1 (wex z (wa (wbr (cv x3) (cv z) R) (wbr (cv y1) (cv z) R))) B2) A2) $;

--| A quantifier-free way of expressing the total order predicate. (Contributed by Mario Carneiro, 22-Nov-2013.)
theorem qfto {x3 y1: setvar} (A2 B2 R: class):
  $ wb (wss (cxp A2 B2) (cun R (ccnv R))) (wral x3 (wral y1 (wo (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)) B2) A2) $;

--| A square cross product ` ( A X. A ) ` is a transitive relation. (Contributed by FL, 31-Jul-2009.)
theorem xpidtr (A2: class):
  $ wss (ccom (cxp A2 A2) (cxp A2 A2)) (cxp A2 A2) $;

--| The intersection of two transitive classes is transitive. (Contributed by FL, 31-Jul-2009.)
theorem trin2 (R S: class):
  $ wi (wa (wss (ccom R R) R) (wss (ccom S S) S)) (wss (ccom (cin R S) (cin R S)) (cin R S)) $;

--| A partial order relation is irreflexive. (Contributed by Mario Carneiro, 2-Nov-2015.)
theorem poirr2 (A2 R: class):
  $ wi (wpo A2 R) (wceq (cin R (cres cid A2)) c0) $;

--| The relation induced by a transitive relation on a part of its field is transitive. (Taking the intersection of a relation with a square cross product is a way to restrict it to a subset of its field.) (Contributed by FL, 31-Jul-2009.)
theorem trinxp (A2 R: class):
  $ wi (wss (ccom R R) R) (wss (ccom (cin R (cxp A2 A2)) (cin R (cxp A2 A2))) (cin R (cxp A2 A2))) $;

--| A strict order relation is irreflexive. (Contributed by NM, 10-Feb-1996.) (Revised by Mario Carneiro, 10-May-2013.)
theorem soirri (A2 R S: class):
  $ wor S R $ >
  $ wss R (cxp S S) $ >
  $ wn (wbr A2 A2 R) $;

--| A strict order relation is a transitive relation. (Contributed by NM, 10-Feb-1996.) (Revised by Mario Carneiro, 10-May-2013.)
theorem sotri (A2 B2 C R S: class):
  $ wor S R $ >
  $ wss R (cxp S S) $ >
  $ wi (wa (wbr A2 B2 R) (wbr B2 C R)) (wbr A2 C R) $;

--| A strict order relation has no 2-cycle loops. (Contributed by NM, 10-Feb-1996.) (Revised by Mario Carneiro, 10-May-2013.)
theorem son2lpi (A2 B2 R S: class):
  $ wor S R $ >
  $ wss R (cxp S S) $ >
  $ wn (wa (wbr A2 B2 R) (wbr B2 A2 R)) $;

--| A transitivity relation. (Read ` -. ` B < A and B < C implies A < C .) (Contributed by Mario Carneiro, 10-May-2013.)
theorem sotri2 (A2 B2 C R S: class):
  $ wor S R $ >
  $ wss R (cxp S S) $ >
  $ wi (w3a (wcel A2 S) (wn (wbr B2 A2 R)) (wbr B2 C R)) (wbr A2 C R) $;

--| A transitivity relation. (Read A < B and ` -. ` C < B implies A < C .) (Contributed by Mario Carneiro, 10-May-2013.)
theorem sotri3 (A2 B2 C R S: class):
  $ wor S R $ >
  $ wss R (cxp S S) $ >
  $ wi (w3a (wcel C S) (wbr A2 B2 R) (wn (wbr C B2 R))) (wbr A2 C R) $;

--| Express "less than or equals" for general strict orders. (Contributed by Stefan O'Rear, 17-Jan-2015.)
theorem poleloe (A2 B2 R V: class):
  $ wi (wcel B2 V) (wb (wbr A2 B2 (cun R cid)) (wo (wbr A2 B2 R) (wceq A2 B2))) $;

--| Transitive law for general strict orders. (Contributed by Stefan O'Rear, 17-Jan-2015.)
theorem poltletr (A2 B2 C R X: class):
  $ wi (wa (wpo X R) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wi (wa (wbr A2 B2 R) (wbr B2 C (cun R cid))) (wbr A2 C R)) $;

--| The converse of a class abstraction of ordered pairs. (Contributed by NM, 11-Dec-2003.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem cnvopab {x3 y1: setvar} (ph: wff x3 y1):
  $ wceq (ccnv (copab x3 y1 ph)) (copab y1 x3 ph) $;

--| The converse of the empty set. (Contributed by NM, 6-Apr-1998.)
theorem cnv0:
  $ wceq (ccnv c0) c0 $;

--| The converse of the identity relation. Theorem 3.7(ii) of [Monk1] p. 36. (Contributed by NM, 26-Apr-1998.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem cnvi:
  $ wceq (ccnv cid) cid $;

--| The converse of a union is the union of converses. Theorem 16 of [Suppes] p. 62. (Contributed by NM, 25-Mar-1998.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem cnvun (A2 B2: class):
  $ wceq (ccnv (cun A2 B2)) (cun (ccnv A2) (ccnv B2)) $;

--| Distributive law for converse over set difference. (Contributed by Mario Carneiro, 26-Jun-2014.)
theorem cnvdif (A2 B2: class):
  $ wceq (ccnv (cdif A2 B2)) (cdif (ccnv A2) (ccnv B2)) $;

--| Distributive law for converse over intersection. Theorem 15 of [Suppes] p. 62. (Contributed by NM, 25-Mar-1998.) (Revised by Mario Carneiro, 26-Jun-2014.)
theorem cnvin (A2 B2: class):
  $ wceq (ccnv (cin A2 B2)) (cin (ccnv A2) (ccnv B2)) $;

--| Distributive law for range over union. Theorem 8 of [Suppes] p. 60. (Contributed by NM, 24-Mar-1998.)
theorem rnun (A2 B2: class):
  $ wceq (crn (cun A2 B2)) (cun (crn A2) (crn B2)) $;

--| The range of an intersection belongs the intersection of ranges. Theorem 9 of [Suppes] p. 60. (Contributed by NM, 15-Sep-2004.)
theorem rnin (A2 B2: class):
  $ wss (crn (cin A2 B2)) (cin (crn A2) (crn B2)) $;

--| The range of an indexed union. (Contributed by Mario Carneiro, 29-May-2015.)
theorem rniun {x3: setvar} (A2 B2: class x3):
  $ wceq (crn (ciun x3 A2 B2)) (ciun x3 A2 (crn B2)) $;

--| The range of a union. Part of Exercise 8 of [Enderton] p. 41. (Contributed by NM, 17-Mar-2004.) (Revised by Mario Carneiro, 29-May-2015.)
theorem rnuni {x3: setvar} (A2: class):
  $ wceq (crn (cuni A2)) (ciun x3 A2 (crn (cv x3))) $;

--| Distributive law for image over union. Theorem 35 of [Suppes] p. 65. (Contributed by NM, 30-Sep-2002.)
theorem imaundi (A2 B2 C: class):
  $ wceq (cima A2 (cun B2 C)) (cun (cima A2 B2) (cima A2 C)) $;

--| The image of a union. (Contributed by Jeff Hoffman, 17-Feb-2008.)
theorem imaundir (A2 B2 C: class):
  $ wceq (cima (cun A2 B2) C) (cun (cima A2 C) (cima B2 C)) $;

--| An upper bound for intersection with a domain. Theorem 40 of [Suppes] p. 66, who calls it "somewhat surprising." (Contributed by NM, 11-Aug-2004.)
theorem dminss (A2 R: class):
  $ wss (cin (cdm R) A2) (cima (ccnv R) (cima R A2)) $;

--| An upper bound for intersection with an image. Theorem 41 of [Suppes] p. 66. (Contributed by NM, 11-Aug-2004.)
theorem imainss (A2 B2 R: class):
  $ wss (cin (cima R A2) B2) (cima R (cin A2 (cima (ccnv R) B2))) $;

--| The image of an intersection (Contributed by Thierry Arnoux, 16-Dec-2017.)
theorem inimass (A2 B2 C: class):
  $ wss (cima (cin A2 B2) C) (cin (cima A2 C) (cima B2 C)) $;

--| The intersection of the image of singleton (Contributed by Thierry Arnoux, 16-Dec-2017.)
theorem inimasn (A2 B2 C V: class):
  $ wi (wcel C V) (wceq (cima (cin A2 B2) (csn C)) (cin (cima A2 (csn C)) (cima B2 (csn C)))) $;

--| The converse of a cross product. Exercise 11 of [Suppes] p. 67. (Contributed by NM, 14-Aug-1999.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem cnvxp (A2 B2: class):
  $ wceq (ccnv (cxp A2 B2)) (cxp B2 A2) $;

--| The cross product with the empty set is empty. Part of Theorem 3.13(ii) of [Monk1] p. 37. (Contributed by NM, 12-Apr-2004.)
theorem xp0 (A2: class):
  $ wceq (cxp A2 c0) c0 $;

--| The cross product of inhabited classes is inhabited. (Contributed by Jim Kingdon, 11-Dec-2018.)
theorem xpmlem {x3 y1 z: setvar} (A2 B2: class):
  $ wb (wa (wex x3 (wcel (cv x3) A2)) (wex y1 (wcel (cv y1) B2))) (wex z (wcel (cv z) (cxp A2 B2))) $;

--| The cross product of inhabited classes is inhabited. (Contributed by Jim Kingdon, 13-Dec-2018.)
theorem xpm {x3 y1 z: setvar} (A2: class y1) (B2: class x3):
  $ wb (wa (wex x3 (wcel (cv x3) A2)) (wex y1 (wcel (cv y1) B2))) (wex z (wcel (cv z) (cxp A2 B2))) $;

--| A cross product is empty if at least one member is empty. (Contributed by Jim Kingdon, 12-Dec-2018.)
theorem xpeq0r (A2 B2: class):
  $ wi (wo (wceq A2 c0) (wceq B2 c0)) (wceq (cxp A2 B2) c0) $;

--| Cross products with disjoint sets are disjoint. (Contributed by NM, 13-Sep-2004.)
theorem xpdisj1 (A2 B2 C D: class):
  $ wi (wceq (cin A2 B2) c0) (wceq (cin (cxp A2 C) (cxp B2 D)) c0) $;

--| Cross products with disjoint sets are disjoint. (Contributed by NM, 13-Sep-2004.)
theorem xpdisj2 (A2 B2 C D: class):
  $ wi (wceq (cin A2 B2) c0) (wceq (cin (cxp C A2) (cxp D B2)) c0) $;

--| Cross products with two different singletons are disjoint. (Contributed by NM, 28-Jul-2004.)
theorem xpsndisj (A2 B2 C D: class):
  $ wi (wne B2 D) (wceq (cin (cxp A2 (csn B2)) (cxp C (csn D))) c0) $;

--| Disjoint unions with disjoint index sets are disjoint. (Contributed by Stefan O'Rear, 21-Nov-2014.)
theorem djudisj {x3 y1: setvar} (A2: class y1) (B2: class x3) (C D: class x3 y1):
  $ wi (wceq (cin A2 B2) c0) (wceq (cin (ciun x3 A2 (cxp (csn (cv x3)) C)) (ciun y1 B2 (cxp (csn (cv y1)) D))) c0) $;

--| A double restriction to disjoint classes is the empty set. (Contributed by NM, 7-Oct-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem resdisj (A2 B2 C: class):
  $ wi (wceq (cin A2 B2) c0) (wceq (cres (cres C A2) B2) c0) $;

--| The range of a cross product. Part of Theorem 3.13(x) of [Monk1] p. 37, with non-empty changed to inhabited. (Contributed by Jim Kingdon, 12-Dec-2018.)
theorem rnxpm {x3: setvar} (A2: class) (B2: class x3):
  $ wi (wex x3 (wcel (cv x3) A2)) (wceq (crn (cxp A2 B2)) B2) $;

--| The domain of a cross product is a subclass of the first factor. (Contributed by NM, 19-Mar-2007.)
theorem dmxpss (A2 B2: class):
  $ wss (cdm (cxp A2 B2)) A2 $;

--| The range of a cross product is a subclass of the second factor. (Contributed by NM, 16-Jan-2006.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem rnxpss (A2 B2: class):
  $ wss (crn (cxp A2 B2)) B2 $;

--| The range of a square cross product. (Contributed by FL, 17-May-2010.)
theorem rnxpid (A2: class):
  $ wceq (crn (cxp A2 A2)) A2 $;

--| A cross-product subclass relationship is equivalent to the relationship for its components. (Contributed by Jim Kingdon, 12-Dec-2018.)
theorem ssxpbm {x3: setvar} (A2 B2: class) (C D: class x3):
  $ wi (wex x3 (wcel (cv x3) (cxp A2 B2))) (wb (wss (cxp A2 B2) (cxp C D)) (wa (wss A2 C) (wss B2 D))) $;

--| Cross product subset cancellation. (Contributed by Jim Kingdon, 14-Dec-2018.)
theorem ssxp1 {x3: setvar} (A2 B2: class x3) (C: class):
  $ wi (wex x3 (wcel (cv x3) C)) (wb (wss (cxp A2 C) (cxp B2 C)) (wss A2 B2)) $;

--| Cross product subset cancellation. (Contributed by Jim Kingdon, 14-Dec-2018.)
theorem ssxp2 {x3: setvar} (A2 B2: class x3) (C: class):
  $ wi (wex x3 (wcel (cv x3) C)) (wb (wss (cxp C A2) (cxp C B2)) (wss A2 B2)) $;

--| The cross product of inhabited classes is one-to-one. (Contributed by Jim Kingdon, 13-Dec-2018.)
theorem xp11m {x3 y1: setvar} (A2: class y1) (B2: class x3) (C D: class x3 y1):
  $ wi (wa (wex x3 (wcel (cv x3) A2)) (wex y1 (wcel (cv y1) B2))) (wb (wceq (cxp A2 B2) (cxp C D)) (wa (wceq A2 C) (wceq B2 D))) $;

--| Cancellation law for cross-product. (Contributed by Jim Kingdon, 14-Dec-2018.)
theorem xpcanm {x3: setvar} (A2 B2: class x3) (C: class):
  $ wi (wex x3 (wcel (cv x3) C)) (wb (wceq (cxp C A2) (cxp C B2)) (wceq A2 B2)) $;

--| Cancellation law for cross-product. (Contributed by Jim Kingdon, 14-Dec-2018.)
theorem xpcan2m {x3: setvar} (A2 B2: class x3) (C: class):
  $ wi (wex x3 (wcel (cv x3) C)) (wb (wceq (cxp A2 C) (cxp B2 C)) (wceq A2 B2)) $;

--| If a nonempty cross product is a set, so are both of its components. (Contributed by Jim Kingdon, 14-Dec-2018.)
theorem xpexr2m {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wa (wcel (cxp A2 B2) C) (wex x3 (wcel (cv x3) (cxp A2 B2)))) (wa (wcel A2 cvv) (wcel B2 cvv)) $;

--| Subset of the range of a restriction. (Contributed by NM, 16-Jan-2006.)
theorem ssrnres (A2 B2 C: class):
  $ wb (wss B2 (crn (cres C A2))) (wceq (crn (cin C (cxp A2 B2))) B2) $;

--| Range of the intersection with a cross product. (Contributed by NM, 17-Jan-2006.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem rninxp {x3 y1: setvar} (A2: class) (B2: class x3) (C: class):
  $ wb (wceq (crn (cin C (cxp A2 B2))) B2) (wral y1 (wrex x3 (wbr (cv x3) (cv y1) C) A2) B2) $;

--| Domain of the intersection with a cross product. (Contributed by NM, 17-Jan-2006.)
theorem dminxp {x3 y1: setvar} (A2: class y1) (B2 C: class):
  $ wb (wceq (cdm (cin C (cxp A2 B2))) A2) (wral x3 (wrex y1 (wbr (cv x3) (cv y1) C) B2) A2) $;

--| Image of a relation restricted to a rectangular region. (Contributed by Stefan O'Rear, 19-Feb-2015.)
theorem imainrect (A2 B2 G Y: class):
  $ wceq (cima (cin G (cxp A2 B2)) Y) (cin (cima G (cin Y A2)) B2) $;

--| The image by a cross product. (Contributed by Thierry Arnoux, 16-Dec-2017.)
theorem xpima1 (A2 B2 C: class):
  $ wi (wceq (cin A2 C) c0) (wceq (cima (cxp A2 B2) C) c0) $;

--| The image by a cross product. (Contributed by Thierry Arnoux, 16-Dec-2017.)
theorem xpima2m {x3: setvar} (A2: class) (B2: class x3) (C: class):
  $ wi (wex x3 (wcel (cv x3) (cin A2 C))) (wceq (cima (cxp A2 B2) C) B2) $;

--| The image of a singleton by a cross product. (Contributed by Thierry Arnoux, 14-Jan-2018.)
theorem xpimasn (A2 B2 X: class):
  $ wi (wcel X A2) (wceq (cima (cxp A2 B2) (csn X)) B2) $;

--| The set of all ordered pairs in a class is the same as the double converse. (Contributed by Mario Carneiro, 16-Aug-2015.)
theorem cnvcnv3 {x3 y1: setvar} (R: class):
  $ wceq (ccnv (ccnv R)) (copab x3 y1 (wbr (cv x3) (cv y1) R)) $;

--| Alternate definition of relation. Exercise 2 of [TakeutiZaring] p. 25. (Contributed by NM, 29-Dec-1996.)
theorem dfrel2 (R: class):
  $ wb (wrel R) (wceq (ccnv (ccnv R)) R) $;

--| A relation can be expressed as the set of ordered pairs in it. (Contributed by Mario Carneiro, 16-Aug-2015.)
theorem dfrel4v {x3 y1: setvar} (R: class):
  $ wb (wrel R) (wceq R (copab x3 y1 (wbr (cv x3) (cv y1) R))) $;

--| The double converse of a class strips out all elements that are not ordered pairs. (Contributed by NM, 8-Dec-2003.)
theorem cnvcnv (A2: class):
  $ wceq (ccnv (ccnv A2)) (cin A2 (cxp cvv cvv)) $;

--| The double converse of a class equals its restriction to the universe. (Contributed by NM, 8-Oct-2007.)
theorem cnvcnv2 (A2: class):
  $ wceq (ccnv (ccnv A2)) (cres A2 cvv) $;

--| The double converse of a class is a subclass. Exercise 2 of [TakeutiZaring] p. 25. (Contributed by NM, 23-Jul-2004.)
theorem cnvcnvss (A2: class):
  $ wss (ccnv (ccnv A2)) A2 $;

--| Equality theorem for converse. (Contributed by FL, 19-Sep-2011.)
theorem cnveqb (A2 B2: class):
  $ wi (wa (wrel A2) (wrel B2)) (wb (wceq A2 B2) (wceq (ccnv A2) (ccnv B2))) $;

--| A relation empty iff its converse is empty. (Contributed by FL, 19-Sep-2011.)
theorem cnveq0 (A2: class):
  $ wi (wrel A2) (wb (wceq A2 c0) (wceq (ccnv A2) c0)) $;

--| Alternate definition of relation. (Contributed by NM, 14-May-2008.)
theorem dfrel3 (R: class):
  $ wb (wrel R) (wceq (cres R cvv) R) $;

--| The domain of a universal restriction. (Contributed by NM, 14-May-2008.)
theorem dmresv (A2: class):
  $ wceq (cdm (cres A2 cvv)) (cdm A2) $;

--| The range of a universal restriction. (Contributed by NM, 14-May-2008.)
theorem rnresv (A2: class):
  $ wceq (crn (cres A2 cvv)) (crn A2) $;

--| Range defined in terms of image. (Contributed by NM, 14-May-2008.)
theorem dfrn4 (A2: class):
  $ wceq (crn A2) (cima A2 cvv) $;

--| Distribute proper substitution through the range of a class. (Contributed by Alan Sare, 10-Nov-2012.)
theorem csbrng {x3: setvar} (A2 B2 V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (crn B2)) (crn (csb x3 A2 B2))) $;

--| The restriction of the double converse of a class. (Contributed by NM, 8-Apr-2007.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem rescnvcnv (A2 B2: class):
  $ wceq (cres (ccnv (ccnv A2)) B2) (cres A2 B2) $;

--| The double converse of the restriction of a class. (Contributed by NM, 3-Jun-2007.)
theorem cnvcnvres (A2 B2: class):
  $ wceq (ccnv (ccnv (cres A2 B2))) (cres (ccnv (ccnv A2)) B2) $;

--| The image of the double converse of a class. (Contributed by NM, 8-Apr-2007.)
theorem imacnvcnv (A2 B2: class):
  $ wceq (cima (ccnv (ccnv A2)) B2) (cima A2 B2) $;

--| The domain of a singleton is inhabited iff the singleton argument is an ordered pair. (Contributed by Jim Kingdon, 15-Dec-2018.)
theorem dmsnm {x3: setvar} (A2: class):
  $ wb (wcel A2 (cxp cvv cvv)) (wex x3 (wcel (cv x3) (cdm (csn A2)))) $;

--| The range of a singleton is inhabited iff the singleton argument is an ordered pair. (Contributed by Jim Kingdon, 15-Dec-2018.)
theorem rnsnm {x3: setvar} (A2: class):
  $ wb (wcel A2 (cxp cvv cvv)) (wex x3 (wcel (cv x3) (crn (csn A2)))) $;

--| The domain of the singleton of the empty set is empty. (Contributed by NM, 30-Jan-2004.)
theorem dmsn0:
  $ wceq (cdm (csn c0)) c0 $;

--| The converse of the singleton of the empty set is empty. (Contributed by Mario Carneiro, 30-Aug-2015.)
theorem cnvsn0:
  $ wceq (ccnv (csn c0)) c0 $;

--| The domain of a singleton is empty if the singleton's argument contains the empty set. (Contributed by NM, 15-Dec-2008.)
theorem dmsn0el (A2: class):
  $ wi (wcel c0 A2) (wceq (cdm (csn A2)) c0) $;

--| A singleton is a relation iff it has an inhabited domain. (Contributed by Jim Kingdon, 16-Dec-2018.)
theorem relsn2m {x3: setvar} (A2: class):
  $ wcel A2 cvv $ >
  $ wb (wrel (csn A2)) (wex x3 (wcel (cv x3) (cdm (csn A2)))) $;

--| The domain of a singleton of an ordered pair is the singleton of the first member. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem dmsnopg (A2 B2 V: class):
  $ wi (wcel B2 V) (wceq (cdm (csn (cop A2 B2))) (csn A2)) $;

--| The domain of an unordered pair of ordered pairs. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem dmpropg (A2 B2 C D V W: class):
  $ wi (wa (wcel B2 V) (wcel D W)) (wceq (cdm (cpr (cop A2 B2) (cop C D))) (cpr A2 C)) $;

--| The domain of a singleton of an ordered pair is the singleton of the first member. (Contributed by NM, 30-Jan-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem dmsnop (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wceq (cdm (csn (cop A2 B2))) (csn A2) $;

--| The domain of an unordered pair of ordered pairs. (Contributed by NM, 13-Sep-2011.)
theorem dmprop (A2 B2 C D: class):
  $ wcel B2 cvv $ >
  $ wcel D cvv $ >
  $ wceq (cdm (cpr (cop A2 B2) (cop C D))) (cpr A2 C) $;

--| The domain of an unordered triple of ordered pairs. (Contributed by NM, 14-Sep-2011.)
theorem dmtpop (A2 B2 C D E F: class):
  $ wcel B2 cvv $ >
  $ wcel D cvv $ >
  $ wcel F cvv $ >
  $ wceq (cdm (ctp (cop A2 B2) (cop C D) (cop E F))) (ctp A2 C E) $;

--| Double converse of a singleton of an ordered pair. (Unlike ~ cnvsn , this does not need any sethood assumptions on ` A ` and ` B ` .) (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem cnvcnvsn (A2 B2: class):
  $ wceq (ccnv (ccnv (csn (cop A2 B2)))) (ccnv (csn (cop B2 A2))) $;

--| The domain of the singleton of the singleton of a singleton. (Contributed by Jim Kingdon, 16-Dec-2018.)
theorem dmsnsnsng (A2: class):
  $ wi (wcel A2 cvv) (wceq (cdm (csn (csn (csn A2)))) (csn A2)) $;

--| The range of a singleton of an ordered pair is the singleton of the second member. (Contributed by NM, 24-Jul-2004.) (Revised by Mario Carneiro, 30-Apr-2015.)
theorem rnsnopg (A2 B2 V: class):
  $ wi (wcel A2 V) (wceq (crn (csn (cop A2 B2))) (csn B2)) $;

--| The range of a pair of ordered pairs is the pair of second members. (Contributed by Thierry Arnoux, 3-Jan-2017.)
theorem rnpropg (A2 B2 C D V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (crn (cpr (cop A2 C) (cop B2 D))) (cpr C D)) $;

--| The range of a singleton of an ordered pair is the singleton of the second member. (Contributed by NM, 24-Jul-2004.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem rnsnop (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wceq (crn (csn (cop A2 B2))) (csn B2) $;

--| Extract the first member of an ordered pair. (See ~ op2nda to extract the second member and ~ op1stb for an alternate version.) (Contributed by Raph Levien, 4-Dec-2003.)
theorem op1sta (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cuni (cdm (csn (cop A2 B2)))) A2 $;

--| Converse of a singleton of an ordered pair. (Contributed by NM, 11-May-1998.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem cnvsn (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (ccnv (csn (cop A2 B2))) (csn (cop B2 A2)) $;

--| Extract the second member of an ordered pair. Theorem 5.12(ii) of [Monk1] p. 52. (See ~ op1stb to extract the first member and ~ op2nda for an alternate version.) (Contributed by NM, 25-Nov-2003.)
theorem op2ndb (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cint (cint (cint (ccnv (csn (cop A2 B2)))))) B2 $;

--| Extract the second member of an ordered pair. (See ~ op1sta to extract the first member and ~ op2ndb for an alternate version.) (Contributed by NM, 17-Feb-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem op2nda (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cuni (crn (csn (cop A2 B2)))) B2 $;

--| Converse of a singleton of an ordered pair. (Contributed by NM, 23-Jan-2015.)
theorem cnvsng (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (ccnv (csn (cop A2 B2))) (csn (cop B2 A2))) $;

--| Swap the members of an ordered pair. (Contributed by Jim Kingdon, 16-Dec-2018.)
theorem opswapg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (cuni (ccnv (csn (cop A2 B2)))) (cop B2 A2)) $;

--| Membership in a cross product. This version requires no quantifiers or dummy variables. See also ~ elxp5 . (Contributed by NM, 17-Feb-2004.)
theorem elxp4 (A2 B2 C: class):
  $ wb (wcel A2 (cxp B2 C)) (wa (wceq A2 (cop (cuni (cdm (csn A2))) (cuni (crn (csn A2))))) (wa (wcel (cuni (cdm (csn A2))) B2) (wcel (cuni (crn (csn A2))) C))) $;

--| Membership in a cross product requiring no quantifiers or dummy variables. Provides a slightly shorter version of ~ elxp4 when the double intersection does not create class existence problems (caused by ~ int0 ). (Contributed by NM, 1-Aug-2004.)
theorem elxp5 (A2 B2 C: class):
  $ wb (wcel A2 (cxp B2 C)) (wa (wceq A2 (cop (cint (cint A2)) (cuni (crn (csn A2))))) (wa (wcel (cint (cint A2)) B2) (wcel (cuni (crn (csn A2))) C))) $;

--| An image under the converse of a restriction. (Contributed by Jeff Hankins, 12-Jul-2009.)
theorem cnvresima (A2 B2 F: class):
  $ wceq (cima (ccnv (cres F A2)) B2) (cin (cima (ccnv F) B2) A2) $;

--| A class restricted to its domain equals its double converse. (Contributed by NM, 8-Apr-2007.)
theorem resdm2 (A2: class):
  $ wceq (cres A2 (cdm A2)) (ccnv (ccnv A2)) $;

--| Restriction to the domain of a restriction. (Contributed by NM, 8-Apr-2007.)
theorem resdmres (A2 B2: class):
  $ wceq (cres A2 (cdm (cres A2 B2))) (cres A2 B2) $;

--| The image of the domain of a restriction. (Contributed by NM, 8-Apr-2007.)
theorem imadmres (A2 B2: class):
  $ wceq (cima A2 (cdm (cres A2 B2))) (cima A2 B2) $;

--| The preimage of a function in maps-to notation. (Contributed by Stefan O'Rear, 25-Jan-2015.)
theorem mptpreima {x3: setvar} (A2 B2: class x3) (C: class) (F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wceq (cima (ccnv F) C) (crab x3 (wcel B2 C) A2) $;

--| Converse singleton image of a function defined by maps-to. (Contributed by Stefan O'Rear, 25-Jan-2015.)
theorem mptiniseg {x3: setvar} (A2 B2: class x3) (C: class) (F: class x3) (V: class):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wcel C V) (wceq (cima (ccnv F) (csn C)) (crab x3 (wceq B2 C) A2)) $;

--| The domain of the mapping operation in general. (Contributed by NM, 16-May-1995.) (Revised by Mario Carneiro, 22-Mar-2015.)
theorem dmmpt {x3: setvar} (A2 B2 F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wceq (cdm F) (crab x3 (wcel B2 cvv) A2) $;

--| The domain of a mapping is a subset of its base class. (Contributed by Scott Fenton, 17-Jun-2013.)
theorem dmmptss {x3: setvar} (A2: class) (B2 F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wss (cdm F) A2 $;

--| The domain of the mapping operation is the stated domain, if the function value is always a set. (Contributed by Mario Carneiro, 9-Feb-2013.) (Revised by Mario Carneiro, 14-Sep-2013.)
theorem dmmptg {x3: setvar} (A2: class) (B2 V: class x3):
  $ wi (wral x3 (wcel B2 V) A2) (wceq (cdm (cmpt x3 A2 B2)) A2) $;

--| A composition is a relation. Exercise 24 of [TakeutiZaring] p. 25. (Contributed by NM, 26-Jan-1997.)
theorem relco (A2 B2: class):
  $ wrel (ccom A2 B2) $;

--| Alternate definition of a class composition, using only one bound variable. (Contributed by NM, 19-Dec-2008.)
theorem dfco2 {x3: setvar} (A2 B2: class):
  $ wceq (ccom A2 B2) (ciun x3 cvv (cxp (cima (ccnv B2) (csn (cv x3))) (cima A2 (csn (cv x3))))) $;

--| Generalization of ~ dfco2 , where ` C ` can have any value between ` dom A i^i ran B ` and ` _V ` . (Contributed by NM, 21-Dec-2008.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem dfco2a {x3: setvar} (A2 B2 C: class):
  $ wi (wss (cin (cdm A2) (crn B2)) C) (wceq (ccom A2 B2) (ciun x3 C (cxp (cima (ccnv B2) (csn (cv x3))) (cima A2 (csn (cv x3)))))) $;

--| Class composition distributes over union. (Contributed by NM, 21-Dec-2008.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem coundi (A2 B2 C: class):
  $ wceq (ccom A2 (cun B2 C)) (cun (ccom A2 B2) (ccom A2 C)) $;

--| Class composition distributes over union. (Contributed by NM, 21-Dec-2008.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem coundir (A2 B2 C: class):
  $ wceq (ccom (cun A2 B2) C) (cun (ccom A2 C) (ccom B2 C)) $;

--| Restricted first member of a class composition. (Contributed by NM, 12-Oct-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem cores (A2 B2 C: class):
  $ wi (wss (crn B2) C) (wceq (ccom (cres A2 C) B2) (ccom A2 B2)) $;

--| Associative law for the restriction of a composition. (Contributed by NM, 12-Dec-2006.)
theorem resco (A2 B2 C: class):
  $ wceq (cres (ccom A2 B2) C) (ccom A2 (cres B2 C)) $;

--| Image of the composition of two classes. (Contributed by Jason Orendorff, 12-Dec-2006.)
theorem imaco (A2 B2 C: class):
  $ wceq (cima (ccom A2 B2) C) (cima A2 (cima B2 C)) $;

--| The range of the composition of two classes. (Contributed by NM, 12-Dec-2006.)
theorem rnco (A2 B2: class):
  $ wceq (crn (ccom A2 B2)) (crn (cres A2 (crn B2))) $;

--| The range of the composition of two classes. (Contributed by NM, 27-Mar-2008.)
theorem rnco2 (A2 B2: class):
  $ wceq (crn (ccom A2 B2)) (cima A2 (crn B2)) $;

--| The domain of a composition. Exercise 27 of [Enderton] p. 53. (Contributed by NM, 4-Feb-2004.)
theorem dmco (A2 B2: class):
  $ wceq (cdm (ccom A2 B2)) (cima (ccnv B2) (cdm A2)) $;

--| Composition with an indexed union. (Contributed by NM, 21-Dec-2008.)
theorem coiun {x3: setvar} (A2: class) (B2 C: class x3):
  $ wceq (ccom A2 (ciun x3 C B2)) (ciun x3 C (ccom A2 B2)) $;

--| A composition is not affected by a double converse of its first argument. (Contributed by NM, 8-Oct-2007.)
theorem cocnvcnv1 (A2 B2: class):
  $ wceq (ccom (ccnv (ccnv A2)) B2) (ccom A2 B2) $;

--| A composition is not affected by a double converse of its second argument. (Contributed by NM, 8-Oct-2007.)
theorem cocnvcnv2 (A2 B2: class):
  $ wceq (ccom A2 (ccnv (ccnv B2))) (ccom A2 B2) $;

--| Absorption of a reverse (preimage) restriction of the second member of a class composition. (Contributed by NM, 11-Dec-2006.)
theorem cores2 (A2 B2 C: class):
  $ wi (wss (cdm A2) C) (wceq (ccom A2 (ccnv (cres (ccnv B2) C))) (ccom A2 B2)) $;

--| Composition with the empty set. Theorem 20 of [Suppes] p. 63. (Contributed by NM, 24-Apr-2004.)
theorem co02 (A2: class):
  $ wceq (ccom A2 c0) c0 $;

--| Composition with the empty set. (Contributed by NM, 24-Apr-2004.)
theorem co01 (A2: class):
  $ wceq (ccom c0 A2) c0 $;

--| Composition with the identity relation. Part of Theorem 3.7(i) of [Monk1] p. 36. (Contributed by NM, 22-Apr-2004.)
theorem coi1 (A2: class):
  $ wi (wrel A2) (wceq (ccom A2 cid) A2) $;

--| Composition with the identity relation. Part of Theorem 3.7(i) of [Monk1] p. 36. (Contributed by NM, 22-Apr-2004.)
theorem coi2 (A2: class):
  $ wi (wrel A2) (wceq (ccom cid A2) A2) $;

--| Composition with a restricted identity relation. (Contributed by FL, 19-Jun-2011.) (Revised by Stefan O'Rear, 7-Mar-2015.)
theorem coires1 (A2 B2: class):
  $ wceq (ccom A2 (cres cid B2)) (cres A2 B2) $;

--| Associative law for class composition. Theorem 27 of [Suppes] p. 64. Also Exercise 21 of [Enderton] p. 53. Interestingly, this law holds for any classes whatsoever, not just functions or even relations. (Contributed by NM, 27-Jan-1997.)
theorem coass (A2 B2 C: class):
  $ wceq (ccom (ccom A2 B2) C) (ccom A2 (ccom B2 C)) $;

--| A relation is transitive iff its converse is transitive. (Contributed by FL, 19-Sep-2011.)
theorem relcnvtr (R: class):
  $ wi (wrel R) (wb (wss (ccom R R) R) (wss (ccom (ccnv R) (ccnv R)) (ccnv R))) $;

--| A relation is included in the cross product of its domain and range. Exercise 4.12(t) of [Mendelson] p. 235. (Contributed by NM, 3-Aug-1994.)
theorem relssdmrn (A2: class):
  $ wi (wrel A2) (wss A2 (cxp (cdm A2) (crn A2))) $;

--| The converse is a subset of the cartesian product of range and domain. (Contributed by Mario Carneiro, 2-Jan-2017.)
theorem cnvssrndm (A2: class):
  $ wss (ccnv A2) (cxp (crn A2) (cdm A2)) $;

--| Composition as a subset of the cross product of factors. (Contributed by Mario Carneiro, 12-Jan-2017.)
theorem cossxp (A2 B2: class):
  $ wss (ccom A2 B2) (cxp (cdm B2) (crn A2)) $;

--| Two ways to describe the structure of a two-place operation. (Contributed by NM, 17-Dec-2008.)
theorem relrelss (A2: class):
  $ wb (wa (wrel A2) (wrel (cdm A2))) (wss A2 (cxp (cxp cvv cvv) cvv)) $;

--| The membership relation for a relation is inherited by class union. (Contributed by NM, 17-Sep-2006.)
theorem unielrel (A2 R: class):
  $ wi (wa (wrel R) (wcel A2 R)) (wcel (cuni A2) (cuni R)) $;

--| The double union of a relation is its field. (Contributed by NM, 17-Sep-2006.)
theorem relfld (R: class):
  $ wi (wrel R) (wceq (cuni (cuni R)) (cun (cdm R) (crn R))) $;

--| Restriction of a relation to its field. (Contributed by FL, 15-Apr-2012.)
theorem relresfld (R: class):
  $ wi (wrel R) (wceq (cres R (cuni (cuni R))) R) $;

--| Composition with the identity relation restricted to a relation's field. (Contributed by FL, 2-May-2011.)
theorem relcoi2 (R: class):
  $ wi (wrel R) (wceq (ccom (cres cid (cuni (cuni R))) R) R) $;

--| Composition with the identity relation restricted to a relation's field. (Contributed by FL, 8-May-2011.)
theorem relcoi1 (R: class):
  $ wi (wrel R) (wceq (ccom R (cres cid (cuni (cuni R)))) R) $;

--| The double union of the converse of a class is its field. (Contributed by NM, 4-Jun-2008.)
theorem unidmrn (A2: class):
  $ wceq (cuni (cuni (ccnv A2))) (cun (cdm A2) (crn A2)) $;

--| if ` R ` is a relation, its double union equals the double union of its converse. (Contributed by FL, 5-Jan-2009.)
theorem relcnvfld (R: class):
  $ wi (wrel R) (wceq (cuni (cuni R)) (cuni (cuni (ccnv R)))) $;

--| Alternate definition of domain ~ df-dm that doesn't require dummy variables. (Contributed by NM, 2-Aug-2010.)
theorem dfdm2 (A2: class):
  $ wceq (cdm A2) (cuni (cuni (ccom (ccnv A2) A2))) $;

--| The double class union of an inhabited cross product is the union of its members. (Contributed by Jim Kingdon, 18-Dec-2018.)
theorem unixpm {x3: setvar} (A2 B2: class):
  $ wi (wex x3 (wcel (cv x3) (cxp A2 B2))) (wceq (cuni (cuni (cxp A2 B2))) (cun A2 B2)) $;

--| The union of an empty cross product is empty. (Contributed by Jim Kingdon, 18-Dec-2018.)
theorem unixp0im (A2 B2: class):
  $ wi (wceq (cxp A2 B2) c0) (wceq (cuni (cxp A2 B2)) c0) $;

--| The converse of a set is a set. Corollary 6.8(1) of [TakeutiZaring] p. 26. (Contributed by NM, 17-Mar-1998.)
theorem cnvexg (A2 V: class):
  $ wi (wcel A2 V) (wcel (ccnv A2) cvv) $;

--| The converse of a set is a set. Corollary 6.8(1) of [TakeutiZaring] p. 26. (Contributed by NM, 19-Dec-2003.)
theorem cnvex (A2: class):
  $ wcel A2 cvv $ >
  $ wcel (ccnv A2) cvv $;

--| A relation is a set iff its converse is a set. (Contributed by FL, 3-Mar-2007.)
theorem relcnvexb (R: class):
  $ wi (wrel R) (wb (wcel R cvv) (wcel (ccnv R) cvv)) $;

--| Restriction of a class to a singleton. (Contributed by Mario Carneiro, 28-Dec-2014.)
theorem ressn (A2 B2: class):
  $ wceq (cres A2 (csn B2)) (cxp (csn B2) (cima A2 (csn B2))) $;

--| The converse of an intersection is the intersection of the converse. (Contributed by Jim Kingdon, 18-Dec-2018.)
theorem cnviinm {x3 y1: setvar} (A2: class) (B2: class x3 y1):
  $ wi (wex y1 (wcel (cv y1) A2)) (wceq (ccnv (ciin x3 A2 B2)) (ciin x3 A2 (ccnv B2))) $;

--| The converse of a partial order relation is a partial order relation. (Contributed by NM, 15-Jun-2005.)
theorem cnvpom {x3: setvar} (A2 R: class):
  $ wi (wex x3 (wcel (cv x3) A2)) (wb (wpo A2 R) (wpo A2 (ccnv R))) $;

--| The converse of a strict order relation is a strict order relation. (Contributed by Jim Kingdon, 19-Dec-2018.)
theorem cnvsom {x3: setvar} (A2 R: class):
  $ wi (wex x3 (wcel (cv x3) A2)) (wb (wor A2 R) (wor A2 (ccnv R))) $;

--| The composition of two sets is a set. (Contributed by NM, 19-Mar-1998.)
theorem coexg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wcel (ccom A2 B2) cvv) $;

--| The composition of two sets is a set. (Contributed by NM, 15-Dec-2003.)
theorem coex (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel (ccom A2 B2) cvv $;

--| Composition of two cross products. (Contributed by Jim Kingdon, 20-Dec-2018.)
theorem xpcom {x3: setvar} (A2 B2 C: class):
  $ wi (wex x3 (wcel (cv x3) B2)) (wceq (ccom (cxp B2 C) (cxp A2 B2)) (cxp A2 C)) $;

--| Extend class notation with Russell's definition description binder (inverted iota).
term cio {x3: setvar} (ph: wff x3): class;

--| Soundness justification theorem for ~ df-iota . (Contributed by Andrew Salmon, 29-Jun-2011.)
theorem iotajust {x3 y1 z: setvar} (ph: wff x3):
  $ wceq (cuni (cab y1 (wceq (cab x3 ph) (csn (cv y1))))) (cuni (cab z (wceq (cab x3 ph) (csn (cv z))))) $;

--| Define Russell's definition description binder, which can be read as "the unique ` x ` such that ` ph ` ," where ` ph ` ordinarily contains ` x ` as a free variable. Our definition is meaningful only when there is exactly one ` x ` such that ` ph ` is true (see ~ iotaval ); otherwise, it evaluates to the empty set (see ~ iotanul ). Russell used the inverted iota symbol ` iota ` to represent the binder. Sometimes proofs need to expand an iota-based definition. That is, given "X = the x for which ... x ... x ..." holds, the proof needs to get to "... X ... X ...". A general strategy to do this is to use ~ iotacl (for unbounded iota). This can be easier than applying a version that applies an explicit substitution, because substituting an iota into its own property always has a bound variable clash which must be first renamed or else guarded with NF. (Contributed by Andrew Salmon, 30-Jun-2011.)
axiom df_iota {x3 y1: setvar} (ph: wff x3):
  $ wceq (cio x3 ph) (cuni (cab y1 (wceq (cab x3 ph) (csn (cv y1))))) $;

--| Alternate definition for descriptions. Definition 8.18 in [Quine] p. 56. (Contributed by Andrew Salmon, 30-Jun-2011.)
theorem dfiota2 {x3 y1: setvar} (ph: wff x3):
  $ wceq (cio x3 ph) (cuni (cab y1 (wal x3 (wb ph (wceq (cv x3) (cv y1)))))) $;

--| Bound-variable hypothesis builder for the ` iota ` class. (Contributed by Andrew Salmon, 11-Jul-2011.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfiota1 {x3: setvar} (ph: wff x3):
  $ wnfc x3 (cio x3 ph) $;

--| Deduction version of ~ nfiotaxy . (Contributed by Jim Kingdon, 21-Dec-2018.)
theorem nfiotadxy {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnfc x3 (cio y1 ps)) $;

--| Bound-variable hypothesis builder for the ` iota ` class. (Contributed by NM, 23-Aug-2011.)
theorem nfiotaxy {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnfc x3 (cio y1 ph) $;

--| Change bound variables in a description binder. (Contributed by Andrew Salmon, 1-Aug-2011.)
theorem cbviota {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wceq (cio x3 ph) (cio y1 ps) $;

--| Change bound variables in a description binder. (Contributed by Andrew Salmon, 1-Aug-2011.)
theorem cbviotav {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (cio x3 ph) (cio y1 ps) $;

--| Variable substitution in description binder. Compare ~ sb8eu . (Contributed by NM, 18-Mar-2013.)
theorem sb8iota {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wceq (cio x3 ph) (cio y1 (wsb x3 y1 ph)) $;

--| Equality theorem for descriptions. (Contributed by Andrew Salmon, 30-Jun-2011.)
theorem iotaeq {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wceq (cio x3 ph) (cio y1 ph)) $;

--| Equivalence theorem for descriptions. (Contributed by Andrew Salmon, 30-Jun-2011.)
theorem iotabi {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wb ph ps)) (wceq (cio x3 ph) (cio x3 ps)) $;

--| Part of Theorem 8.17 in [Quine] p. 56. This theorem serves as a lemma for the fundamental property of iota. (Contributed by Andrew Salmon, 11-Jul-2011.)
theorem uniabio {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wb ph (wceq (cv x3) (cv y1)))) (wceq (cuni (cab x3 ph)) (cv y1)) $;

--| Theorem 8.19 in [Quine] p. 57. This theorem is the fundamental property of iota. (Contributed by Andrew Salmon, 11-Jul-2011.)
theorem iotaval {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wb ph (wceq (cv x3) (cv y1)))) (wceq (cio x3 ph) (cv y1)) $;

--| Equivalence between two different forms of ` iota ` . (Contributed by Andrew Salmon, 12-Jul-2011.)
theorem iotauni {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wceq (cio x3 ph) (cuni (cab x3 ph))) $;

--| Equivalence between two different forms of ` iota ` . (Contributed by Mario Carneiro, 24-Dec-2016.)
theorem iotaint {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wceq (cio x3 ph) (cint (cab x3 ph))) $;

--| Property of iota. (Contributed by NM, 23-Aug-2011.) (Revised by Mario Carneiro, 23-Dec-2016.)
theorem iota1 {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wb ph (wceq (cio x3 ph) (cv x3))) $;

--| Theorem 8.22 in [Quine] p. 57. This theorem is the result if there isn't exactly one ` x ` that satisfies ` ph ` . (Contributed by Andrew Salmon, 11-Jul-2011.)
theorem iotanul {x3: setvar} (ph: wff x3):
  $ wi (wn (weu x3 ph)) (wceq (cio x3 ph) c0) $;

--| Theorem 8.23 in [Quine] p. 58, with existential uniqueness condition added. This theorem proves the existence of the ` iota ` class under our definition. (Contributed by Jim Kingdon, 21-Dec-2018.)
theorem euiotaex {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wcel (cio x3 ph) cvv) $;

--| Value of iota based on a proposition which holds only for values which are subsets of a given class. (Contributed by Mario Carneiro and Jim Kingdon, 21-Dec-2018.)
theorem iotass {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wal x3 (wi ph (wss (cv x3) A2))) (wss (cio x3 ph) A2) $;

--| Theorem *14.22 in [WhiteheadRussell] p. 190. (Contributed by Andrew Salmon, 12-Jul-2011.)
theorem iota4 {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wsbc x3 ph (cio x3 ph)) $;

--| Theorem *14.23 in [WhiteheadRussell] p. 191. (Contributed by Andrew Salmon, 12-Jul-2011.)
theorem iota4an {x3: setvar} (ph ps: wff x3):
  $ wi (weu x3 (wa ph ps)) (wsbc x3 ph (cio x3 (wa ph ps))) $;

--| A method for computing iota. (Contributed by NM, 17-Sep-2013.)
theorem iota5 {x3: setvar} (ph: wff) (ps: wff x3) (A2 V: class):
  $ wi (wa ph (wcel A2 V)) (wb ps (wceq (cv x3) A2)) $ >
  $ wi (wa ph (wcel A2 V)) (wceq (cio x3 ps) A2) $;

--| Formula-building deduction rule for iota. (Contributed by NM, 20-Aug-2011.)
theorem iotabidv {x3: setvar} (ph: wff) (ps ch: wff x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (cio x3 ps) (cio x3 ch)) $;

--| Formula-building deduction rule for iota. (Contributed by Mario Carneiro, 2-Oct-2015.)
theorem iotabii {x3: setvar} (ph ps: wff x3):
  $ wb ph ps $ >
  $ wceq (cio x3 ph) (cio x3 ps) $;

--| Membership law for descriptions. This can useful for expanding an unbounded iota-based definition (see ~ df-iota ). (Contributed by Andrew Salmon, 1-Aug-2011.)
theorem iotacl {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wcel (cio x3 ph) (cab x3 ph)) $;

--| A condition that allows us to represent "the unique element such that ` ph ` " with a class expression ` A ` . (Contributed by NM, 30-Dec-2014.)
theorem iota2df {x3: setvar} (ph ps ch: wff x3) (B2 V: class x3):
  $ wi ph (wcel B2 V) $ >
  $ wi ph (weu x3 ps) $ >
  $ wi (wa ph (wceq (cv x3) B2)) (wb ps ch) $ >
  $ wnf x3 ph $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wb ch (wceq (cio x3 ps) B2)) $;

--| A condition that allows us to represent "the unique element such that ` ph ` " with a class expression ` A ` . (Contributed by NM, 30-Dec-2014.)
theorem iota2d {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (B2: class) (V: class x3):
  $ wi ph (wcel B2 V) $ >
  $ wi ph (weu x3 ps) $ >
  $ wi (wa ph (wceq (cv x3) B2)) (wb ps ch) $ >
  $ wi ph (wb ch (wceq (cio x3 ps) B2)) $;

--| The unique element such that ` ph ` . (Contributed by Jeff Madsen, 1-Jun-2011.) (Revised by Mario Carneiro, 23-Dec-2016.)
theorem iota2 {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wa (wcel A2 B2) (weu x3 ph)) (wb ps (wceq (cio x3 ph) A2)) $;

--| A class abstraction with a unique member can be expressed as a singleton. (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem sniota {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wceq (cab x3 ph) (csn (cio x3 ph))) $;

--| Class substitution within a description binder. (Contributed by Scott Fenton, 6-Oct-2017.)
theorem csbiotag {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (V: class x3 y1):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (cio y1 ph)) (cio y1 (wsbc x3 ph A2))) $;

--| Extend the definition of a wff to include the function predicate. (Read: ` A ` is a function.)
term wfun (A2: class): wff;

--| Extend the definition of a wff to include the function predicate with a domain. (Read: ` A ` is a function on ` B ` .)
term wfn (A2 B2: class): wff;

--| Extend the definition of a wff to include the function predicate with domain and codomain. (Read: ` F ` maps ` A ` into ` B ` .)
term wf (A2 B2 F: class): wff;

--| Extend the definition of a wff to include one-to-one functions. (Read: ` F ` maps ` A ` one-to-one into ` B ` .) The notation ("1-1" above the arrow) is from Definition 6.15(5) of [TakeutiZaring] p. 27.
term wf1 (A2 B2 F: class): wff;

--| Extend the definition of a wff to include onto functions. (Read: ` F ` maps ` A ` onto ` B ` .) The notation ("onto" below the arrow) is from Definition 6.15(4) of [TakeutiZaring] p. 27.
term wfo (A2 B2 F: class): wff;

--| Extend the definition of a wff to include one-to-one onto functions. (Read: ` F ` maps ` A ` one-to-one onto ` B ` .) The notation ("1-1" above the arrow and "onto" below the arrow) is from Definition 6.15(6) of [TakeutiZaring] p. 27.
term wf1o (A2 B2 F: class): wff;

--| Extend the definition of a class to include the value of a function. (Read: The value of ` F ` at ` A ` , or " ` F ` of ` A ` .")
term cfv (A2 F: class): class;

--| Extend the definition of a wff to include the isomorphism property. (Read: ` H ` is an ` R ` , ` S ` isomorphism of ` A ` onto ` B ` .)
term wiso (A2 B2 R S H: class): wff;

--| Define predicate that determines if some class ` A ` is a function. Definition 10.1 of [Quine] p. 65. For example, the expression ` Fun _I ` is true ( ~ funi ). This is not the same as defining a specific function's mapping, which is typically done using the format of ~ cmpt with the maps-to notation (see ~ df-mpt ). Contrast this predicate with the predicates to determine if some class is a function with a given domain ( ~ df-fn ), a function with a given domain and codomain ( ~ df-f ), a one-to-one function ( ~ df-f1 ), an onto function ( ~ df-fo ), or a one-to-one onto function ( ~ df-f1o ). For alternate definitions, see ~ dffun2 , ~ dffun4 , ~ dffun6 , ~ dffun7 , ~ dffun8 , and ~ dffun9 . (Contributed by NM, 1-Aug-1994.)
axiom df_fun (A2: class):
  $ wb (wfun A2) (wa (wrel A2) (wss (ccom A2 (ccnv A2)) cid)) $;

--| Define a function with domain. Definition 6.15(1) of [TakeutiZaring] p. 27. (Contributed by NM, 1-Aug-1994.)
axiom df_fn (A2 B2: class):
  $ wb (wfn A2 B2) (wa (wfun A2) (wceq (cdm A2) B2)) $;

--| Define a function (mapping) with domain and codomain. Definition 6.15(3) of [TakeutiZaring] p. 27. (Contributed by NM, 1-Aug-1994.)
axiom df_f (A2 B2 F: class):
  $ wb (wf A2 B2 F) (wa (wfn F A2) (wss (crn F) B2)) $;

--| Define a one-to-one function. Compare Definition 6.15(5) of [TakeutiZaring] p. 27. We use their notation ("1-1" above the arrow). (Contributed by NM, 1-Aug-1994.)
axiom df_f1 (A2 B2 F: class):
  $ wb (wf1 A2 B2 F) (wa (wf A2 B2 F) (wfun (ccnv F))) $;

--| Define an onto function. Definition 6.15(4) of [TakeutiZaring] p. 27. We use their notation ("onto" under the arrow). (Contributed by NM, 1-Aug-1994.)
axiom df_fo (A2 B2 F: class):
  $ wb (wfo A2 B2 F) (wa (wfn F A2) (wceq (crn F) B2)) $;

--| Define a one-to-one onto function. Compare Definition 6.15(6) of [TakeutiZaring] p. 27. We use their notation ("1-1" above the arrow and "onto" below the arrow). (Contributed by NM, 1-Aug-1994.)
axiom df_f1o (A2 B2 F: class):
  $ wb (wf1o A2 B2 F) (wa (wf1 A2 B2 F) (wfo A2 B2 F)) $;

--| Define the value of a function, ` ( F `` A ) ` , also known as function application. For example, ` ( _I `` (/) ) = (/) ` . Typically, function ` F ` is defined using maps-to notation (see ~ df-mpt ), but this is not required. For example, F = { ` <. ` 2 , 6 ` >. ` , ` <. ` 3 , 9 ` >. ` } -> ( F ` `` ` 3 ) = 9 . We will later define two-argument functions using ordered pairs as ` ( A F B ) = ( F `` <. A , B >. ) ` . This particular definition is quite convenient: it can be applied to any class and evaluates to the empty set when it is not meaningful. The left apostrophe notation originated with Peano and was adopted in Definition *30.01 of [WhiteheadRussell] p. 235, Definition 10.11 of [Quine] p. 68, and Definition 6.11 of [TakeutiZaring] p. 26. It means the same thing as the more familiar ` F ( A ) ` notation for a function's value at ` A ` , i.e. " ` F ` of ` A ` ," but without context-dependent notational ambiguity. (Contributed by NM, 1-Aug-1994.) Revised to use ` iota ` . (Revised by Scott Fenton, 6-Oct-2017.)
axiom df_fv {x3: setvar} (A2 F: class):
  $ wceq (cfv A2 F) (cio x3 (wbr A2 (cv x3) F)) $;

--| Define the isomorphism predicate. We read this as " ` H ` is an ` R ` , ` S ` isomorphism of ` A ` onto ` B ` ." Normally, ` R ` and ` S ` are ordering relations on ` A ` and ` B ` respectively. Definition 6.28 of [TakeutiZaring] p. 32, whose notation is the same as ours except that ` R ` and ` S ` are subscripts. (Contributed by NM, 4-Mar-1997.)
axiom df_isom {x3 y1: setvar} (A2 B2 R S H: class):
  $ wb (wiso A2 B2 R S H) (wa (wf1o A2 B2 H) (wral x3 (wral y1 (wb (wbr (cv x3) (cv y1) R) (wbr (cfv (cv x3) H) (cfv (cv y1) H) S)) A2) A2)) $;

--| Alternate definition of a function. (Contributed by NM, 29-Dec-1996.)
theorem dffun2 {x3 y1 z: setvar} (A2: class):
  $ wb (wfun A2) (wa (wrel A2) (wal x3 (wal y1 (wal z (wi (wa (wbr (cv x3) (cv y1) A2) (wbr (cv x3) (cv z) A2)) (wceq (cv y1) (cv z))))))) $;

--| Alternate definition of a function. Definition 6.4(4) of [TakeutiZaring] p. 24. (Contributed by NM, 29-Dec-1996.)
theorem dffun4 {x3 y1 z: setvar} (A2: class):
  $ wb (wfun A2) (wa (wrel A2) (wal x3 (wal y1 (wal z (wi (wa (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv z)) A2)) (wceq (cv y1) (cv z))))))) $;

--| A way of proving a relation is a function, analogous to ~ mo2r . (Contributed by Jim Kingdon, 27-May-2020.)
theorem dffun5r {x3 y1 z: setvar} (A2: class):
  $ wi (wa (wrel A2) (wal x3 (wex z (wal y1 (wi (wcel (cop (cv x3) (cv y1)) A2) (wceq (cv y1) (cv z))))))) (wfun A2) $;

--| Definition of function, using bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 9-Mar-1995.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem dffun6f {x3 y1: setvar} (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wb (wfun A2) (wa (wrel A2) (wal x3 (wmo y1 (wbr (cv x3) (cv y1) A2)))) $;

--| Alternate definition of a function using "at most one" notation. (Contributed by NM, 9-Mar-1995.)
theorem dffun6 {x3 y1: setvar} (F: class):
  $ wb (wfun F) (wa (wrel F) (wal x3 (wmo y1 (wbr (cv x3) (cv y1) F)))) $;

--| A function has at most one value for each argument. (Contributed by NM, 24-May-1998.)
theorem funmo {y1: setvar} (A2 F: class):
  $ wi (wfun F) (wmo y1 (wbr A2 (cv y1) F)) $;

--| Definition of function like ~ dffun4 but using bound-variable hypotheses instead of distinct variable conditions. (Contributed by Jim Kingdon, 17-Mar-2019.)
theorem dffun4f {x3 y1 z: setvar} (A2: class x3 y1 z):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc z A2 $ >
  $ wb (wfun A2) (wa (wrel A2) (wal x3 (wal y1 (wal z (wi (wa (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv z)) A2)) (wceq (cv y1) (cv z))))))) $;

--| A function is a relation. (Contributed by NM, 1-Aug-1994.)
theorem funrel (A2: class):
  $ wi (wfun A2) (wrel A2) $;

--| Subclass theorem for function predicate. (Contributed by NM, 16-Aug-1994.) (Proof shortened by Mario Carneiro, 24-Jun-2014.)
theorem funss (A2 B2: class):
  $ wi (wss A2 B2) (wi (wfun B2) (wfun A2)) $;

--| Equality theorem for function predicate. (Contributed by NM, 16-Aug-1994.)
theorem funeq (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wfun A2) (wfun B2)) $;

--| Equality inference for the function predicate. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem funeqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wb (wfun A2) (wfun B2) $;

--| Equality deduction for the function predicate. (Contributed by NM, 23-Feb-2013.)
theorem funeqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wfun A2) (wfun B2)) $;

--| Bound-variable hypothesis builder for a function. (Contributed by NM, 30-Jan-2004.)
theorem nffun {x3: setvar} (F: class x3):
  $ wnfc x3 F $ >
  $ wnf x3 (wfun F) $;

--| Distribute proper substitution through the function predicate. (Contributed by Alexander van der Vekens, 23-Jul-2017.)
theorem sbcfung {x3: setvar} (A2 F V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wfun F) A2) (wfun (csb x3 A2 F))) $;

--| There is exactly one value of a function. (Contributed by NM, 22-Apr-2004.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem funeu {y1: setvar} (A2: class) (B2: class y1) (F: class):
  $ wi (wa (wfun F) (wbr A2 B2 F)) (weu y1 (wbr A2 (cv y1) F)) $;

--| There is exactly one value of a function. (Contributed by NM, 3-Aug-1994.)
theorem funeu2 {y1: setvar} (A2: class) (B2: class y1) (F: class):
  $ wi (wa (wfun F) (wcel (cop A2 B2) F)) (weu y1 (wcel (cop A2 (cv y1)) F)) $;

--| Alternate definition of a function. One possibility for the definition of a function in [Enderton] p. 42. (Enderton's definition is ambiguous because "there is only one" could mean either "there is at most one" or "there is exactly one." However, ~ dffun8 shows that it doesn't matter which meaning we pick.) (Contributed by NM, 4-Nov-2002.)
theorem dffun7 {x3 y1: setvar} (A2: class):
  $ wb (wfun A2) (wa (wrel A2) (wral x3 (wmo y1 (wbr (cv x3) (cv y1) A2)) (cdm A2))) $;

--| Alternate definition of a function. One possibility for the definition of a function in [Enderton] p. 42. Compare ~ dffun7 . (Contributed by NM, 4-Nov-2002.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem dffun8 {x3 y1: setvar} (A2: class):
  $ wb (wfun A2) (wa (wrel A2) (wral x3 (weu y1 (wbr (cv x3) (cv y1) A2)) (cdm A2))) $;

--| Alternate definition of a function. (Contributed by NM, 28-Mar-2007.) (Revised by NM, 16-Jun-2017.)
theorem dffun9 {x3 y1: setvar} (A2: class):
  $ wb (wfun A2) (wa (wrel A2) (wral x3 (wrmo y1 (wbr (cv x3) (cv y1) A2) (crn A2)) (cdm A2))) $;

--| An equivalence for the function predicate. (Contributed by NM, 13-Aug-2004.)
theorem funfn (A2: class):
  $ wb (wfun A2) (wfn A2 (cdm A2)) $;

--| The identity relation is a function. Part of Theorem 10.4 of [Quine] p. 65. (Contributed by NM, 30-Apr-1998.)
theorem funi:
  $ wfun cid $;

--| The universe is not a function. (Contributed by Raph Levien, 27-Jan-2004.)
theorem nfunv:
  $ wn (wfun cvv) $;

--| A Kuratowski ordered pair is a function only if its components are equal. (Contributed by NM, 5-Jun-2008.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem funopg (A2 B2 V W: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wfun (cop A2 B2))) (wceq A2 B2) $;

--| A class of ordered pairs is a function when there is at most one second member for each pair. (Contributed by NM, 16-May-1995.)
theorem funopab {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wfun (copab x3 y1 ph)) (wal x3 (wmo y1 ph)) $;

--| A class of ordered pairs of values is a function. (Contributed by NM, 14-Nov-1995.)
theorem funopabeq {x3 y1: setvar} (A2: class x3):
  $ wfun (copab x3 y1 (wceq (cv y1) A2)) $;

--| A class of ordered pairs of values in the form used by ~ df-mpt is a function. (Contributed by NM, 17-Feb-2013.)
theorem funopab4 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wfun (copab x3 y1 (wa ph (wceq (cv y1) A2))) $;

--| A function in maps-to notation is a function. (Contributed by Mario Carneiro, 13-Jan-2013.)
theorem funmpt {x3: setvar} (A2 B2: class x3):
  $ wfun (cmpt x3 A2 B2) $;

--| Functionality of a class given by a "maps to" notation. (Contributed by FL, 17-Feb-2008.) (Revised by Mario Carneiro, 31-May-2014.)
theorem funmpt2 {x3: setvar} (A2 B2 F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wfun F $;

--| The composition of two functions is a function. Exercise 29 of [TakeutiZaring] p. 25. (Contributed by NM, 26-Jan-1997.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem funco (F G: class):
  $ wi (wa (wfun F) (wfun G)) (wfun (ccom F G)) $;

--| A restriction of a function is a function. Compare Exercise 18 of [TakeutiZaring] p. 25. (Contributed by NM, 16-Aug-1994.)
theorem funres (A2 F: class):
  $ wi (wfun F) (wfun (cres F A2)) $;

--| The restriction of a function to the domain of a subclass equals the subclass. (Contributed by NM, 15-Aug-1994.)
theorem funssres (F G: class):
  $ wi (wa (wfun F) (wss G F)) (wceq (cres F (cdm G)) G) $;

--| Equality of restrictions of a function and a subclass. (Contributed by NM, 16-Aug-1994.)
theorem fun2ssres (A2 F G: class):
  $ wi (w3a (wfun F) (wss G F) (wss A2 (cdm G))) (wceq (cres F A2) (cres G A2)) $;

--| The union of functions with disjoint domains is a function. Theorem 4.6 of [Monk1] p. 43. (Contributed by NM, 12-Aug-1994.)
theorem funun (F G: class):
  $ wi (wa (wa (wfun F) (wfun G)) (wceq (cin (cdm F) (cdm G)) c0)) (wfun (cun F G)) $;

--| The converse singleton of an ordered pair is a function. This is equivalent to ~ funsn via ~ cnvsn , but stating it this way allows us to skip the sethood assumptions on ` A ` and ` B ` . (Contributed by NM, 30-Apr-2015.)
theorem funcnvsn (A2 B2: class):
  $ wfun (ccnv (csn (cop A2 B2))) $;

--| A singleton of an ordered pair is a function. Theorem 10.5 of [Quine] p. 65. (Contributed by NM, 28-Jun-2011.)
theorem funsng (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wfun (csn (cop A2 B2))) $;

--| Functionality and domain of the singleton of an ordered pair. (Contributed by Mario Carneiro, 30-Apr-2015.)
theorem fnsng (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wfn (csn (cop A2 B2)) (csn A2)) $;

--| A singleton of an ordered pair is a function. Theorem 10.5 of [Quine] p. 65. (Contributed by NM, 12-Aug-1994.)
theorem funsn (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wfun (csn (cop A2 B2)) $;

--| A set of two pairs is a function if their first members are different. (Contributed by FL, 26-Jun-2011.)
theorem funprg (A2 B2 C D V W X Y: class):
  $ wi (w3a (wa (wcel A2 V) (wcel B2 W)) (wa (wcel C X) (wcel D Y)) (wne A2 B2)) (wfun (cpr (cop A2 C) (cop B2 D))) $;

--| A set of three pairs is a function if their first members are different. (Contributed by Alexander van der Vekens, 5-Dec-2017.)
theorem funtpg (A2 B2 C U F G H V W X Y Z: class):
  $ wi (w3a (w3a (wcel X U) (wcel Y V) (wcel Z W)) (w3a (wcel A2 F) (wcel B2 G) (wcel C H)) (w3a (wne X Y) (wne X Z) (wne Y Z))) (wfun (ctp (cop X A2) (cop Y B2) (cop Z C))) $;

--| A function with a domain of two elements. (Contributed by Jeff Madsen, 20-Jun-2010.)
theorem funpr (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wi (wne A2 B2) (wfun (cpr (cop A2 C) (cop B2 D))) $;

--| A function with a domain of three elements. (Contributed by NM, 14-Sep-2011.)
theorem funtp (A2 B2 C D E F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wcel E cvv $ >
  $ wcel F cvv $ >
  $ wi (w3a (wne A2 B2) (wne A2 C) (wne B2 C)) (wfun (ctp (cop A2 D) (cop B2 E) (cop C F))) $;

--| Functionality and domain of the singleton of an ordered pair. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem fnsn (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wfn (csn (cop A2 B2)) (csn A2) $;

--| Function with a domain of two different values. (Contributed by FL, 26-Jun-2011.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem fnprg (A2 B2 C D V W X Y: class):
  $ wi (w3a (wa (wcel A2 V) (wcel B2 W)) (wa (wcel C X) (wcel D Y)) (wne A2 B2)) (wfn (cpr (cop A2 C) (cop B2 D)) (cpr A2 B2)) $;

--| Function with a domain of three different values. (Contributed by Alexander van der Vekens, 5-Dec-2017.)
theorem fntpg (A2 B2 C U F G H V W X Y Z: class):
  $ wi (w3a (w3a (wcel X U) (wcel Y V) (wcel Z W)) (w3a (wcel A2 F) (wcel B2 G) (wcel C H)) (w3a (wne X Y) (wne X Z) (wne Y Z))) (wfn (ctp (cop X A2) (cop Y B2) (cop Z C)) (ctp X Y Z)) $;

--| A function with a domain of three elements. (Contributed by NM, 14-Sep-2011.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem fntp (A2 B2 C D E F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wcel E cvv $ >
  $ wcel F cvv $ >
  $ wi (w3a (wne A2 B2) (wne A2 C) (wne B2 C)) (wfn (ctp (cop A2 D) (cop B2 E) (cop C F)) (ctp A2 B2 C)) $;

--| The empty set is a function. Theorem 10.3 of [Quine] p. 65. (Contributed by NM, 7-Apr-1998.)
theorem fun0:
  $ wfun c0 $;

--| The double converse of a function is a function. (Contributed by NM, 21-Sep-2004.)
theorem funcnvcnv (A2: class):
  $ wi (wfun A2) (wfun (ccnv (ccnv A2))) $;

--| A simpler equivalence for single-rooted (see ~ funcnv ). (Contributed by NM, 9-Aug-2004.)
theorem funcnv2 {x3 y1: setvar} (A2: class):
  $ wb (wfun (ccnv A2)) (wal y1 (wmo x3 (wbr (cv x3) (cv y1) A2))) $;

--| The converse of a class is a function iff the class is single-rooted, which means that for any ` y ` in the range of ` A ` there is at most one ` x ` such that ` x A y ` . Definition of single-rooted in [Enderton] p. 43. See ~ funcnv2 for a simpler version. (Contributed by NM, 13-Aug-2004.)
theorem funcnv {x3 y1: setvar} (A2: class):
  $ wb (wfun (ccnv A2)) (wral y1 (wmo x3 (wbr (cv x3) (cv y1) A2)) (crn A2)) $;

--| A condition showing a class is single-rooted. (See ~ funcnv ). (Contributed by NM, 26-May-2006.)
theorem funcnv3 {x3 y1: setvar} (A2: class):
  $ wb (wfun (ccnv A2)) (wral y1 (wreu x3 (wbr (cv x3) (cv y1) A2) (cdm A2)) (crn A2)) $;

--| Another way of expressing that a class is single-rooted. Counterpart to ~ dffun2 . (Contributed by Jim Kingdon, 24-Dec-2018.)
theorem funcnveq {x3 y1 z: setvar} (A2: class):
  $ wb (wfun (ccnv A2)) (wal x3 (wal y1 (wal z (wi (wa (wbr (cv x3) (cv y1) A2) (wbr (cv z) (cv y1) A2)) (wceq (cv x3) (cv z)))))) $;

--| The double converse of a class is a function iff the class is single-valued. Each side is equivalent to Definition 6.4(2) of [TakeutiZaring] p. 23, who use the notation "Un(A)" for single-valued. Note that ` A ` is not necessarily a function. (Contributed by NM, 13-Aug-2004.)
theorem fun2cnv {x3 y1: setvar} (A2: class):
  $ wb (wfun (ccnv (ccnv A2))) (wal x3 (wmo y1 (wbr (cv x3) (cv y1) A2))) $;

--| A single-valued relation is a function. (See ~ fun2cnv for "single-valued.") Definition 6.4(4) of [TakeutiZaring] p. 24. (Contributed by NM, 17-Jan-2006.)
theorem svrelfun (A2: class):
  $ wb (wfun A2) (wa (wrel A2) (wfun (ccnv (ccnv A2)))) $;

--| Single-rootedness (see ~ funcnv ) of a class cut down by a cross product. (Contributed by NM, 5-Mar-2007.)
theorem fncnv {x3 y1: setvar} (A2 B2 R: class):
  $ wb (wfn (ccnv (cin R (cxp A2 B2))) B2) (wral y1 (wreu x3 (wbr (cv x3) (cv y1) R) A2) B2) $;

--| Two ways of stating that ` A ` is one-to-one (but not necessarily a function). Each side is equivalent to Definition 6.4(3) of [TakeutiZaring] p. 24, who use the notation "Un_2 (A)" for one-to-one (but not necessarily a function). (Contributed by NM, 17-Jan-2006.)
theorem fun11 {x3 y1 z w: setvar} (A2: class):
  $ wb (wa (wfun (ccnv (ccnv A2))) (wfun (ccnv A2))) (wal x3 (wal y1 (wal z (wal w (wi (wa (wbr (cv x3) (cv y1) A2) (wbr (cv z) (cv w) A2)) (wb (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w)))))))) $;

--| The union of a chain (with respect to inclusion) of functions is a function. (Contributed by NM, 10-Aug-2004.)
theorem fununi {f2 g1: setvar} (A2: class):
  $ wi (wral f2 (wa (wfun (cv f2)) (wral g1 (wo (wss (cv f2) (cv g1)) (wss (cv g1) (cv f2))) A2)) A2) (wfun (cuni A2)) $;

--| The union of a chain (with respect to inclusion) of single-rooted sets is single-rooted. (See ~ funcnv for "single-rooted" definition.) (Contributed by NM, 11-Aug-2004.)
theorem funcnvuni {f2 g1: setvar} (A2: class):
  $ wi (wral f2 (wa (wfun (ccnv (cv f2))) (wral g1 (wo (wss (cv f2) (cv g1)) (wss (cv g1) (cv f2))) A2)) A2) (wfun (ccnv (cuni A2))) $;

--| The union of a chain (with respect to inclusion) of one-to-one functions is a one-to-one function. (Contributed by NM, 11-Aug-2004.)
theorem fun11uni {f2 g1: setvar} (A2: class):
  $ wi (wral f2 (wa (wa (wfun (cv f2)) (wfun (ccnv (cv f2)))) (wral g1 (wo (wss (cv f2) (cv g1)) (wss (cv g1) (cv f2))) A2)) A2) (wa (wfun (cuni A2)) (wfun (ccnv (cuni A2)))) $;

--| The intersection with a function is a function. Exercise 14(a) of [Enderton] p. 53. (Contributed by NM, 19-Mar-2004.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem funin (F G: class):
  $ wi (wfun F) (wfun (cin F G)) $;

--| The restriction of a one-to-one function is one-to-one. (Contributed by NM, 25-Mar-1998.)
theorem funres11 (A2 F: class):
  $ wi (wfun (ccnv F)) (wfun (ccnv (cres F A2))) $;

--| The converse of a restricted function. (Contributed by NM, 27-Mar-1998.)
theorem funcnvres (A2 F: class):
  $ wi (wfun (ccnv F)) (wceq (ccnv (cres F A2)) (cres (ccnv F) (cima F A2))) $;

--| Converse of a restricted identity function. (Contributed by FL, 4-Mar-2007.)
theorem cnvresid (A2: class):
  $ wceq (ccnv (cres cid A2)) (cres cid A2) $;

--| The converse of a restriction of the converse of a function equals the function restricted to the image of its converse. (Contributed by NM, 4-May-2005.)
theorem funcnvres2 (A2 F: class):
  $ wi (wfun F) (wceq (ccnv (cres (ccnv F) A2)) (cres F (cima (ccnv F) A2))) $;

--| The image of the preimage of a function. (Contributed by NM, 25-May-2004.)
theorem funimacnv (A2 F: class):
  $ wi (wfun F) (wceq (cima F (cima (ccnv F) A2)) (cin A2 (crn F))) $;

--| A kind of contraposition law that infers a subclass of an image from a preimage subclass. (Contributed by NM, 25-May-2004.)
theorem funimass1 (A2 B2 F: class):
  $ wi (wa (wfun F) (wss A2 (crn F))) (wi (wss (cima (ccnv F) A2) B2) (wss A2 (cima F B2))) $;

--| A kind of contraposition law that infers an image subclass from a subclass of a preimage. (Contributed by NM, 25-May-2004.)
theorem funimass2 (A2 B2 F: class):
  $ wi (wa (wfun F) (wss A2 (cima (ccnv F) B2))) (wss (cima F A2) B2) $;

--| One direction of ~ imadif . This direction does not require ` Fun ``' F ` . (Contributed by Jim Kingdon, 25-Dec-2018.)
theorem imadiflem (A2 B2 F: class):
  $ wss (cdif (cima F A2) (cima F B2)) (cima F (cdif A2 B2)) $;

--| The image of a difference is the difference of images. (Contributed by NM, 24-May-1998.)
theorem imadif (A2 B2 F: class):
  $ wi (wfun (ccnv F)) (wceq (cima F (cdif A2 B2)) (cdif (cima F A2) (cima F B2))) $;

--| One direction of ~ imain . This direction does not require ` Fun ``' F ` . (Contributed by Jim Kingdon, 25-Dec-2018.)
theorem imainlem (A2 B2 F: class):
  $ wss (cima F (cin A2 B2)) (cin (cima F A2) (cima F B2)) $;

--| The image of an intersection is the intersection of images. (Contributed by Paul Chapman, 11-Apr-2009.)
theorem imain (A2 B2 F: class):
  $ wi (wfun (ccnv F)) (wceq (cima F (cin A2 B2)) (cin (cima F A2) (cima F B2))) $;

--| Lemma for ~ funimaexg . It constitutes the interesting part of ~ funimaexg , in which ` B C_ dom A ` . (Contributed by Jim Kingdon, 27-Dec-2018.)
theorem funimaexglem (A2 B2 C: class):
  $ wi (w3a (wfun A2) (wcel B2 C) (wss B2 (cdm A2))) (wcel (cima A2 B2) cvv) $;

--| Axiom of Replacement using abbreviations. Axiom 39(vi) of [Quine] p. 284. Compare Exercise 9 of [TakeutiZaring] p. 29. (Contributed by NM, 10-Sep-2006.)
theorem funimaexg (A2 B2 C: class):
  $ wi (wa (wfun A2) (wcel B2 C)) (wcel (cima A2 B2) cvv) $;

--| The image of a set under any function is also a set. Equivalent of Axiom of Replacement. Axiom 39(vi) of [Quine] p. 284. Compare Exercise 9 of [TakeutiZaring] p. 29. (Contributed by NM, 17-Nov-2002.)
theorem funimaex (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wi (wfun A2) (wcel (cima A2 B2) cvv) $;

--| Part of a study of the Axiom of Replacement used by the Isabelle prover. The object PrimReplace is apparently the image of the function encoded by ` ph ( x , y ) ` i.e. the class ` ( { <. x , y >. | ph } " A ) ` . If so, we can prove Isabelle's "Axiom of Replacement" conclusion without using the Axiom of Replacement, for which I (N. Megill) currently have no explanation. (Contributed by NM, 26-Oct-2006.) (Proof shortened by Mario Carneiro, 4-Dec-2016.)
theorem isarep1 {x3 y1 b: setvar} (ph: wff x3 y1 b) (A2: class y1 b):
  $ wb (wcel (cv b) (cima (copab x3 y1 ph) A2)) (wrex x3 (wsb y1 b ph) A2) $;

--| Part of a study of the Axiom of Replacement used by the Isabelle prover. In Isabelle, the sethood of PrimReplace is apparently postulated implicitly by its type signature " ` [ ` i, ` [ ` i, i ` ] ` => o ` ] ` => i", which automatically asserts that it is a set without using any axioms. To prove that it is a set in Metamath, we need the hypotheses of Isabelle's "Axiom of Replacement" as well as the Axiom of Replacement in the form ~ funimaex . (Contributed by NM, 26-Oct-2006.)
theorem isarep2 {x3 y1 z w: setvar} (ph: wff x3 y1) (A2: class z):
  $ wcel A2 cvv $ >
  $ wral x3 (wal y1 (wal z (wi (wa ph (wsb y1 z ph)) (wceq (cv y1) (cv z))))) A2 $ >
  $ wex w (wceq (cv w) (cima (copab x3 y1 ph) A2)) $;

--| Equality theorem for function predicate with domain. (Contributed by NM, 1-Aug-1994.)
theorem fneq1 (A2 F G: class):
  $ wi (wceq F G) (wb (wfn F A2) (wfn G A2)) $;

--| Equality theorem for function predicate with domain. (Contributed by NM, 1-Aug-1994.)
theorem fneq2 (A2 B2 F: class):
  $ wi (wceq A2 B2) (wb (wfn F A2) (wfn F B2)) $;

--| Equality deduction for function predicate with domain. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem fneq1d (ph: wff) (A2 F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wb (wfn F A2) (wfn G A2)) $;

--| Equality deduction for function predicate with domain. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem fneq2d (ph: wff) (A2 B2 F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wfn F A2) (wfn F B2)) $;

--| Equality deduction for function predicate with domain. (Contributed by NM, 26-Jun-2011.)
theorem fneq12d (ph: wff) (A2 B2 F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wfn F A2) (wfn G B2)) $;

--| Equality theorem for function predicate with domain. (Contributed by Thierry Arnoux, 31-Jan-2017.)
theorem fneq12 (A2 B2 F G: class):
  $ wi (wa (wceq F G) (wceq A2 B2)) (wb (wfn F A2) (wfn G B2)) $;

--| Equality inference for function predicate with domain. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem fneq1i (A2 F G: class):
  $ wceq F G $ >
  $ wb (wfn F A2) (wfn G A2) $;

--| Equality inference for function predicate with domain. (Contributed by NM, 4-Sep-2011.)
theorem fneq2i (A2 B2 F: class):
  $ wceq A2 B2 $ >
  $ wb (wfn F A2) (wfn F B2) $;

--| Bound-variable hypothesis builder for a function with domain. (Contributed by NM, 30-Jan-2004.)
theorem nffn {x3: setvar} (A2 F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 A2 $ >
  $ wnf x3 (wfn F A2) $;

--| A function with domain is a function. (Contributed by NM, 1-Aug-1994.)
theorem fnfun (A2 F: class):
  $ wi (wfn F A2) (wfun F) $;

--| A function with domain is a relation. (Contributed by NM, 1-Aug-1994.)
theorem fnrel (A2 F: class):
  $ wi (wfn F A2) (wrel F) $;

--| The domain of a function. (Contributed by NM, 2-Aug-1994.)
theorem fndm (A2 F: class):
  $ wi (wfn F A2) (wceq (cdm F) A2) $;

--| Inference to convert a function and domain antecedent. (Contributed by NM, 22-Apr-2004.)
theorem funfni (ph: wff) (A2 B2 F: class):
  $ wi (wa (wfun F) (wcel B2 (cdm F))) ph $ >
  $ wi (wa (wfn F A2) (wcel B2 A2)) ph $;

--| A function has a unique domain. (Contributed by NM, 11-Aug-1994.)
theorem fndmu (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wfn F B2)) (wceq A2 B2) $;

--| The first argument of binary relation on a function belongs to the function's domain. (Contributed by NM, 7-May-2004.)
theorem fnbr (A2 B2 C F: class):
  $ wi (wa (wfn F A2) (wbr B2 C F)) (wcel B2 A2) $;

--| The first argument of an ordered pair in a function belongs to the function's domain. (Contributed by NM, 8-Aug-1994.)
theorem fnop (A2 B2 C F: class):
  $ wi (wa (wfn F A2) (wcel (cop B2 C) F)) (wcel B2 A2) $;

--| There is exactly one value of a function. (Contributed by NM, 22-Apr-2004.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fneu {y1: setvar} (A2: class y1) (B2 F: class):
  $ wi (wa (wfn F A2) (wcel B2 A2)) (weu y1 (wbr B2 (cv y1) F)) $;

--| There is exactly one value of a function. (Contributed by NM, 7-Nov-1995.)
theorem fneu2 {y1: setvar} (A2: class y1) (B2 F: class):
  $ wi (wa (wfn F A2) (wcel B2 A2)) (weu y1 (wcel (cop B2 (cv y1)) F)) $;

--| The union of two functions with disjoint domains. (Contributed by NM, 22-Sep-2004.)
theorem fnun (A2 B2 F G: class):
  $ wi (wa (wa (wfn F A2) (wfn G B2)) (wceq (cin A2 B2) c0)) (wfn (cun F G) (cun A2 B2)) $;

--| Extension of a function with a new ordered pair. (Contributed by NM, 28-Sep-2013.) (Revised by Mario Carneiro, 30-Apr-2015.)
theorem fnunsn (ph: wff) (D E F G X Y: class):
  $ wi ph (wcel X cvv) $ >
  $ wi ph (wcel Y cvv) $ >
  $ wi ph (wfn F D) $ >
  $ wceq G (cun F (csn (cop X Y))) $ >
  $ wceq E (cun D (csn X)) $ >
  $ wi ph (wn (wcel X D)) $ >
  $ wi ph (wfn G E) $;

--| Composition of two functions. (Contributed by NM, 22-May-2006.)
theorem fnco (A2 B2 F G: class):
  $ wi (w3a (wfn F A2) (wfn G B2) (wss (crn G) A2)) (wfn (ccom F G) B2) $;

--| A function does not change when restricted to its domain. (Contributed by NM, 5-Sep-2004.)
theorem fnresdm (A2 F: class):
  $ wi (wfn F A2) (wceq (cres F A2) F) $;

--| A function restricted to a class disjoint with its domain is empty. (Contributed by NM, 23-Sep-2004.)
theorem fnresdisj (A2 B2 F: class):
  $ wi (wfn F A2) (wb (wceq (cin A2 B2) c0) (wceq (cres F B2) c0)) $;

--| Membership in two functions restricted by each other's domain. (Contributed by NM, 8-Aug-1994.)
theorem _2elresin {y1 z: setvar} (x3: setvar) (A2 B2 F G: class y1 z):
  $ wi (wa (wfn F A2) (wfn G B2)) (wb (wa (wcel (cop (cv x3) (cv y1)) F) (wcel (cop (cv x3) (cv z)) G)) (wa (wcel (cop (cv x3) (cv y1)) (cres F (cin A2 B2))) (wcel (cop (cv x3) (cv z)) (cres G (cin A2 B2))))) $;

--| Restriction of a function with a subclass of its domain. (Contributed by NM, 10-Oct-2007.)
theorem fnssresb (A2 B2 F: class):
  $ wi (wfn F A2) (wb (wfn (cres F B2) B2) (wss B2 A2)) $;

--| Restriction of a function with a subclass of its domain. (Contributed by NM, 2-Aug-1994.)
theorem fnssres (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wss B2 A2)) (wfn (cres F B2) B2) $;

--| Restriction of a function's domain with an intersection. (Contributed by NM, 9-Aug-1994.)
theorem fnresin1 (A2 B2 F: class):
  $ wi (wfn F A2) (wfn (cres F (cin A2 B2)) (cin A2 B2)) $;

--| Restriction of a function's domain with an intersection. (Contributed by NM, 9-Aug-1994.)
theorem fnresin2 (A2 B2 F: class):
  $ wi (wfn F A2) (wfn (cres F (cin B2 A2)) (cin B2 A2)) $;

--| An equivalence for functionality of a restriction. Compare ~ dffun8 . (Contributed by Mario Carneiro, 20-May-2015.)
theorem fnres {x3 y1: setvar} (A2 F: class):
  $ wb (wfn (cres F A2) A2) (wral x3 (weu y1 (wbr (cv x3) (cv y1) F)) A2) $;

--| Functionality and domain of restricted identity. (Contributed by NM, 27-Aug-2004.)
theorem fnresi (A2: class):
  $ wfn (cres cid A2) A2 $;

--| The image of a function's domain is its range. (Contributed by NM, 4-Nov-2004.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fnima (A2 F: class):
  $ wi (wfn F A2) (wceq (cima F A2) (crn F)) $;

--| A function with empty domain is empty. (Contributed by NM, 15-Apr-1998.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fn0 (F: class):
  $ wb (wfn F c0) (wceq F c0) $;

--| A class that is disjoint with the domain of a function has an empty image under the function. (Contributed by FL, 24-Jan-2007.)
theorem fnimadisj (A2 C F: class):
  $ wi (wa (wfn F A2) (wceq (cin A2 C) c0)) (wceq (cima F C) c0) $;

--| Images under a function never map nonempty sets to empty sets. (Contributed by Stefan O'Rear, 21-Jan-2015.)
theorem fnimaeq0 (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wss B2 A2)) (wb (wceq (cima F B2) c0) (wceq B2 c0)) $;

--| Alternate definition for the "maps to" notation ~ df-mpt . (Contributed by Mario Carneiro, 30-Dec-2016.)
theorem dfmpt3 {x3: setvar} (A2 B2: class x3):
  $ wceq (cmpt x3 A2 B2) (ciun x3 A2 (cxp (csn (cv x3)) (csn B2))) $;

--| Functionality and domain of an ordered-pair class abstraction. (Contributed by NM, 30-Jan-2004.) (Proof shortened by Mario Carneiro, 4-Dec-2016.)
theorem fnopabg {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (F: class x3 y1):
  $ wceq F (copab x3 y1 (wa (wcel (cv x3) A2) ph)) $ >
  $ wb (wral x3 (weu y1 ph) A2) (wfn F A2) $;

--| Functionality and domain of an ordered-pair class abstraction. (Contributed by NM, 5-Mar-1996.)
theorem fnopab {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (F: class x3 y1):
  $ wi (wcel (cv x3) A2) (weu y1 ph) $ >
  $ wceq F (copab x3 y1 (wa (wcel (cv x3) A2) ph)) $ >
  $ wfn F A2 $;

--| The maps-to notation defines a function with domain. (Contributed by Scott Fenton, 21-Mar-2011.)
theorem mptfng {x3: setvar} (A2: class) (B2 F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wb (wral x3 (wcel B2 cvv) A2) (wfn F A2) $;

--| The maps-to notation defines a function with domain. (Contributed by NM, 9-Apr-2013.)
theorem fnmpt {x3: setvar} (A2: class) (B2 F V: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wral x3 (wcel B2 V) A2) (wfn F A2) $;

--| A mapping operation with empty domain. (Contributed by Mario Carneiro, 28-Dec-2014.)
theorem mpt0 {x3: setvar} (A2: class x3):
  $ wceq (cmpt x3 c0 A2) c0 $;

--| Functionality and domain of an ordered-pair class abstraction. (Contributed by NM, 29-Jan-2004.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem fnmpti {x3: setvar} (A2: class) (B2 F: class x3):
  $ wcel B2 cvv $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wfn F A2 $;

--| Domain of an ordered-pair class abstraction that specifies a function. (Contributed by NM, 6-Sep-2005.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem dmmpti {x3: setvar} (A2: class) (B2 F: class x3):
  $ wcel B2 cvv $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wceq (cdm F) A2 $;

--| Union of mappings which are mutually compatible. (Contributed by Mario Carneiro, 31-Aug-2015.)
theorem mptun {x3: setvar} (A2 B2 C: class x3):
  $ wceq (cmpt x3 (cun A2 B2) C) (cun (cmpt x3 A2 C) (cmpt x3 B2 C)) $;

--| Equality theorem for functions. (Contributed by NM, 1-Aug-1994.)
theorem feq1 (A2 B2 F G: class):
  $ wi (wceq F G) (wb (wf A2 B2 F) (wf A2 B2 G)) $;

--| Equality theorem for functions. (Contributed by NM, 1-Aug-1994.)
theorem feq2 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wb (wf A2 C F) (wf B2 C F)) $;

--| Equality theorem for functions. (Contributed by NM, 1-Aug-1994.)
theorem feq3 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wb (wf C A2 F) (wf C B2 F)) $;

--| Equality theorem for functions. (Contributed by FL, 14-Jul-2007.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem feq23 (A2 B2 C D F: class):
  $ wi (wa (wceq A2 C) (wceq B2 D)) (wb (wf A2 B2 F) (wf C D F)) $;

--| Equality deduction for functions. (Contributed by NM, 19-Feb-2008.)
theorem feq1d (ph: wff) (A2 B2 F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wb (wf A2 B2 F) (wf A2 B2 G)) $;

--| Equality deduction for functions. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem feq2d (ph: wff) (A2 B2 C F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wf A2 C F) (wf B2 C F)) $;

--| Equality deduction for functions. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem feq12d (ph: wff) (A2 B2 C F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wf A2 C F) (wf B2 C G)) $;

--| Equality deduction for functions. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem feq123d (ph: wff) (A2 B2 C D F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wf A2 C F) (wf B2 D G)) $;

--| Equality theorem for functions. (Contributed by FL, 16-Nov-2008.)
theorem feq123 (A2 B2 C D F G: class):
  $ wi (w3a (wceq F G) (wceq A2 C) (wceq B2 D)) (wb (wf A2 B2 F) (wf C D G)) $;

--| Equality inference for functions. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem feq1i (A2 B2 F G: class):
  $ wceq F G $ >
  $ wb (wf A2 B2 F) (wf A2 B2 G) $;

--| Equality inference for functions. (Contributed by NM, 5-Sep-2011.)
theorem feq2i (A2 B2 C F: class):
  $ wceq A2 B2 $ >
  $ wb (wf A2 C F) (wf B2 C F) $;

--| Equality inference for functions. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem feq23i (A2 B2 C D F: class):
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wb (wf A2 B2 F) (wf C D F) $;

--| Equality deduction for functions. (Contributed by NM, 8-Jun-2013.)
theorem feq23d (ph: wff) (A2 B2 C D F: class):
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wb (wf A2 B2 F) (wf C D F)) $;

--| Bound-variable hypothesis builder for a mapping. (Contributed by NM, 29-Jan-2004.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nff {x3: setvar} (A2 B2 F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wf A2 B2 F) $;

--| Distribute proper substitution through the function predicate with a domain. (Contributed by Alexander van der Vekens, 15-Jul-2018.)
theorem sbcfng {x3: setvar} (A2 F: class x3) (V X: class):
  $ wi (wcel X V) (wb (wsbc x3 (wfn F A2) X) (wfn (csb x3 X F) (csb x3 X A2))) $;

--| Distribute proper substitution through the function predicate with domain and codomain. (Contributed by Alexander van der Vekens, 15-Jul-2018.)
theorem sbcfg {x3: setvar} (A2 B2 F: class x3) (V X: class):
  $ wi (wcel X V) (wb (wsbc x3 (wf A2 B2 F) X) (wf (csb x3 X A2) (csb x3 X B2) (csb x3 X F))) $;

--| A mapping is a function. (Contributed by NM, 2-Aug-1994.)
theorem ffn (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wfn F A2) $;

--| Any function is a mapping into ` _V ` . (Contributed by NM, 31-Oct-1995.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem dffn2 (A2 F: class):
  $ wb (wfn F A2) (wf A2 cvv F) $;

--| A mapping is a function. (Contributed by NM, 3-Aug-1994.)
theorem ffun (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wfun F) $;

--| A mapping is a relation. (Contributed by NM, 3-Aug-1994.)
theorem frel (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wrel F) $;

--| The domain of a mapping. (Contributed by NM, 2-Aug-1994.)
theorem fdm (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wceq (cdm F) A2) $;

--| The domain of a mapping. (Contributed by NM, 28-Jul-2008.)
theorem fdmi (A2 B2 F: class):
  $ wf A2 B2 F $ >
  $ wceq (cdm F) A2 $;

--| The range of a mapping. (Contributed by NM, 3-Aug-1994.)
theorem frn (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wss (crn F) B2) $;

--| A function maps to its range. (Contributed by NM, 1-Sep-1999.)
theorem dffn3 (A2 F: class):
  $ wb (wfn F A2) (wf A2 (crn F) F) $;

--| Expanding the codomain of a mapping. (Contributed by NM, 10-May-1998.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fss (A2 B2 C F: class):
  $ wi (wa (wf A2 B2 F) (wss B2 C)) (wf A2 C F) $;

--| Expanding the codomain of a mapping, deduction form. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fssd (ph: wff) (A2 B2 C F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wss B2 C) $ >
  $ wi ph (wf A2 C F) $;

--| Composition of two mappings. (Contributed by NM, 29-Aug-1999.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fco (A2 B2 C F G: class):
  $ wi (wa (wf B2 C F) (wf A2 B2 G)) (wf A2 C (ccom F G)) $;

--| Functionality of a composition with weakened out of domain condition on the first argument. (Contributed by Stefan O'Rear, 11-Mar-2015.)
theorem fco2 (A2 B2 C F G: class):
  $ wi (wa (wf B2 C (cres F B2)) (wf A2 B2 G)) (wf A2 C (ccom F G)) $;

--| A mapping is a class of ordered pairs. (Contributed by NM, 3-Aug-1994.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fssxp (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wss F (cxp A2 B2)) $;

--| A function with bounded domain and range is a set. This version is proven without the Axiom of Replacement. (Contributed by Mario Carneiro, 24-Jun-2015.)
theorem fex2 (A2 B2 F V W: class):
  $ wi (w3a (wf A2 B2 F) (wcel A2 V) (wcel B2 W)) (wcel F cvv) $;

--| Two ways of specifying a partial function from ` A ` to ` B ` . (Contributed by NM, 13-Nov-2007.)
theorem funssxp (A2 B2 F: class):
  $ wb (wa (wfun F) (wss F (cxp A2 B2))) (wa (wf (cdm F) B2 F) (wss (cdm F) A2)) $;

--| A mapping is a partial function. (Contributed by NM, 25-Nov-2007.)
theorem ffdm (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wa (wf (cdm F) B2 F) (wss (cdm F) A2)) $;

--| The members of an ordered pair element of a mapping belong to the mapping's domain and codomain. (Contributed by NM, 10-Dec-2003.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opelf (A2 B2 C D F: class):
  $ wi (wa (wf A2 B2 F) (wcel (cop C D) F)) (wa (wcel C A2) (wcel D B2)) $;

--| The union of two functions with disjoint domains. (Contributed by NM, 22-Sep-2004.)
theorem fun (A2 B2 C D F G: class):
  $ wi (wa (wa (wf A2 C F) (wf B2 D G)) (wceq (cin A2 B2) c0)) (wf (cun A2 B2) (cun C D) (cun F G)) $;

--| The union of two functions with disjoint domains. (Contributed by Mario Carneiro, 12-Mar-2015.)
theorem fun2 (A2 B2 C F G: class):
  $ wi (wa (wa (wf A2 C F) (wf B2 C G)) (wceq (cin A2 B2) c0)) (wf (cun A2 B2) C (cun F G)) $;

--| Composition of two functions. (Contributed by NM, 22-May-2006.)
theorem fnfco (A2 B2 F G: class):
  $ wi (wa (wfn F A2) (wf B2 A2 G)) (wfn (ccom F G) B2) $;

--| Restriction of a function with a subclass of its domain. (Contributed by NM, 23-Sep-2004.)
theorem fssres (A2 B2 C F: class):
  $ wi (wa (wf A2 B2 F) (wss C A2)) (wf C B2 (cres F C)) $;

--| Restriction of a restricted function with a subclass of its domain. (Contributed by NM, 21-Jul-2005.)
theorem fssres2 (A2 B2 C F: class):
  $ wi (wa (wf A2 B2 (cres F A2)) (wss C A2)) (wf C B2 (cres F C)) $;

--| An identity for the mapping relationship under restriction. (Contributed by Scott Fenton, 4-Sep-2011.) (Proof shortened by Mario Carneiro, 26-May-2016.)
theorem fresin (A2 B2 F X: class):
  $ wi (wf A2 B2 F) (wf (cin A2 X) B2 (cres F X)) $;

--| If two functions agree on their common domain, their union contains a union of three functions with pairwise disjoint domains. If we assumed the law of the excluded middle, this would be equality rather than subset. (Contributed by Jim Kingdon, 28-Dec-2018.)
theorem resasplitss (A2 B2 F G: class):
  $ wi (w3a (wfn F A2) (wfn G B2) (wceq (cres F (cin A2 B2)) (cres G (cin A2 B2)))) (wss (cun (cres F (cin A2 B2)) (cun (cres F (cdif A2 B2)) (cres G (cdif B2 A2)))) (cun F G)) $;

--| Composition of a mapping and restricted identity. (Contributed by NM, 13-Dec-2003.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fcoi1 (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wceq (ccom F (cres cid A2)) F) $;

--| Composition of restricted identity and a mapping. (Contributed by NM, 13-Dec-2003.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fcoi2 (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wceq (ccom (cres cid B2) F) F) $;

--| There is exactly one value of a function in its codomain. (Contributed by NM, 10-Dec-2003.)
theorem feu {y1: setvar} (A2 B2 C F: class):
  $ wi (wa (wf A2 B2 F) (wcel C A2)) (wreu y1 (wcel (cop C (cv y1)) F) B2) $;

--| The converse of a restriction of a function. (Contributed by NM, 26-Mar-1998.)
theorem fcnvres (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wceq (ccnv (cres F A2)) (cres (ccnv F) B2)) $;

--| The preimage of a class disjoint with a mapping's codomain is empty. (Contributed by FL, 24-Jan-2007.)
theorem fimacnvdisj (A2 B2 C F: class):
  $ wi (wa (wf A2 B2 F) (wceq (cin B2 C) c0)) (wceq (cima (ccnv F) C) c0) $;

--| Function into an intersection. (Contributed by Jim Kingdon, 28-Dec-2018.)
theorem fintm {x3: setvar} (A2 B2 F: class):
  $ wex x3 (wcel (cv x3) B2) $ >
  $ wb (wf A2 (cint B2) F) (wral x3 (wf A2 (cv x3) F) B2) $;

--| Mapping into an intersection. (Contributed by NM, 14-Sep-1999.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fin (A2 B2 C F: class):
  $ wb (wf A2 (cin B2 C) F) (wa (wf A2 B2 F) (wf A2 C F)) $;

--| Existence of a set of functions. (Contributed by Paul Chapman, 25-Feb-2008.)
theorem fabexg {x3: setvar} (ph: wff x3) (A2 B2: class) (C D F: class x3):
  $ wceq F (cab x3 (wa (wf A2 B2 (cv x3)) ph)) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wcel F cvv) $;

--| Existence of a set of functions. (Contributed by NM, 3-Dec-2007.)
theorem fabex {x3: setvar} (ph: wff x3) (A2 B2: class) (F: class x3):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq F (cab x3 (wa (wf A2 B2 (cv x3)) ph)) $ >
  $ wcel F cvv $;

--| If a mapping is a set, its domain is a set. (Contributed by NM, 27-Aug-2006.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem dmfex (A2 B2 C F: class):
  $ wi (wa (wcel F C) (wf A2 B2 F)) (wcel A2 cvv) $;

--| The empty function. (Contributed by NM, 14-Aug-1999.)
theorem f0 (A2: class):
  $ wf c0 A2 c0 $;

--| A class is a function with empty codomain iff it and its domain are empty. (Contributed by NM, 10-Dec-2003.)
theorem f00 (A2 F: class):
  $ wb (wf A2 c0 F) (wa (wceq F c0) (wceq A2 c0)) $;

--| A cross product with a singleton is a constant function. (Contributed by NM, 14-Aug-1999.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fconst (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wf A2 (csn B2) (cxp A2 (csn B2)) $;

--| A cross product with a singleton is a constant function. (Contributed by NM, 19-Oct-2004.)
theorem fconstg (A2 B2 V: class):
  $ wi (wcel B2 V) (wf A2 (csn B2) (cxp A2 (csn B2))) $;

--| A cross product with a singleton is a constant function. (Contributed by NM, 24-Jul-2014.)
theorem fnconstg (A2 B2 V: class):
  $ wi (wcel B2 V) (wfn (cxp A2 (csn B2)) A2) $;

--| Constant function with loose range. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem fconst6g (A2 B2 C: class):
  $ wi (wcel B2 C) (wf A2 C (cxp A2 (csn B2))) $;

--| A constant function as a mapping. (Contributed by Jeff Madsen, 30-Nov-2009.) (Revised by Mario Carneiro, 22-Apr-2015.)
theorem fconst6 (A2 B2 C: class):
  $ wcel B2 C $ >
  $ wf A2 C (cxp A2 (csn B2)) $;

--| Equality theorem for one-to-one functions. (Contributed by NM, 10-Feb-1997.)
theorem f1eq1 (A2 B2 F G: class):
  $ wi (wceq F G) (wb (wf1 A2 B2 F) (wf1 A2 B2 G)) $;

--| Equality theorem for one-to-one functions. (Contributed by NM, 10-Feb-1997.)
theorem f1eq2 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wb (wf1 A2 C F) (wf1 B2 C F)) $;

--| Equality theorem for one-to-one functions. (Contributed by NM, 10-Feb-1997.)
theorem f1eq3 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wb (wf1 C A2 F) (wf1 C B2 F)) $;

--| Bound-variable hypothesis builder for a one-to-one function. (Contributed by NM, 16-May-2004.)
theorem nff1 {x3: setvar} (A2 B2 F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wf1 A2 B2 F) $;

--| Alternate definition of a one-to-one function. (Contributed by NM, 31-Dec-1996.)
theorem dff12 {x3 y1: setvar} (A2 B2: class x3 y1) (F: class):
  $ wb (wf1 A2 B2 F) (wa (wf A2 B2 F) (wal y1 (wmo x3 (wbr (cv x3) (cv y1) F)))) $;

--| A one-to-one mapping is a mapping. (Contributed by NM, 31-Dec-1996.)
theorem f1f (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wf A2 B2 F) $;

--| A one-to-one mapping is a function on its domain. (Contributed by NM, 8-Mar-2014.)
theorem f1fn (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wfn F A2) $;

--| A one-to-one mapping is a function. (Contributed by NM, 8-Mar-2014.)
theorem f1fun (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wfun F) $;

--| A one-to-one onto mapping is a relation. (Contributed by NM, 8-Mar-2014.)
theorem f1rel (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wrel F) $;

--| The domain of a one-to-one mapping. (Contributed by NM, 8-Mar-2014.)
theorem f1dm (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wceq (cdm F) A2) $;

--| A function that is one-to-one is also one-to-one on some superset of its range. (Contributed by Mario Carneiro, 12-Jan-2013.)
theorem f1ss (A2 B2 C F: class):
  $ wi (wa (wf1 A2 B2 F) (wss B2 C)) (wf1 A2 C F) $;

--| Combine a one-to-one function with a restriction on the domain. (Contributed by Stefan O'Rear, 20-Feb-2015.)
theorem f1ssr (A2 B2 C F: class):
  $ wi (wa (wf1 A2 B2 F) (wss (crn F) C)) (wf1 A2 C F) $;

--| A function that is one-to-one is also one-to-one on some aubset of its domain. (Contributed by Mario Carneiro, 17-Jan-2015.)
theorem f1ssres (A2 B2 C F: class):
  $ wi (wa (wf1 A2 B2 F) (wss C A2)) (wf1 C B2 (cres F C)) $;

--| Two ways to express that a set ` A ` (not necessarily a function) is one-to-one. Each side is equivalent to Definition 6.4(3) of [TakeutiZaring] p. 24, who use the notation "Un_2 (A)" for one-to-one. We do not introduce a separate notation since we rarely use it. (Contributed by NM, 13-Aug-2004.)
theorem f1cnvcnv (A2: class):
  $ wb (wf1 (cdm A2) cvv (ccnv (ccnv A2))) (wa (wfun (ccnv A2)) (wfun (ccnv (ccnv A2)))) $;

--| Composition of one-to-one functions. Exercise 30 of [TakeutiZaring] p. 25. (Contributed by NM, 28-May-1998.)
theorem f1co (A2 B2 C F G: class):
  $ wi (wa (wf1 B2 C F) (wf1 A2 B2 G)) (wf1 A2 C (ccom F G)) $;

--| Equality theorem for onto functions. (Contributed by NM, 1-Aug-1994.)
theorem foeq1 (A2 B2 F G: class):
  $ wi (wceq F G) (wb (wfo A2 B2 F) (wfo A2 B2 G)) $;

--| Equality theorem for onto functions. (Contributed by NM, 1-Aug-1994.)
theorem foeq2 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wb (wfo A2 C F) (wfo B2 C F)) $;

--| Equality theorem for onto functions. (Contributed by NM, 1-Aug-1994.)
theorem foeq3 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wb (wfo C A2 F) (wfo C B2 F)) $;

--| Bound-variable hypothesis builder for an onto function. (Contributed by NM, 16-May-2004.)
theorem nffo {x3: setvar} (A2 B2 F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wfo A2 B2 F) $;

--| An onto mapping is a mapping. (Contributed by NM, 3-Aug-1994.)
theorem fof (A2 B2 F: class):
  $ wi (wfo A2 B2 F) (wf A2 B2 F) $;

--| An onto mapping is a function. (Contributed by NM, 29-Mar-2008.)
theorem fofun (A2 B2 F: class):
  $ wi (wfo A2 B2 F) (wfun F) $;

--| An onto mapping is a function on its domain. (Contributed by NM, 16-Dec-2008.)
theorem fofn (A2 B2 F: class):
  $ wi (wfo A2 B2 F) (wfn F A2) $;

--| The codomain of an onto function is its range. (Contributed by NM, 3-Aug-1994.)
theorem forn (A2 B2 F: class):
  $ wi (wfo A2 B2 F) (wceq (crn F) B2) $;

--| Alternate definition of an onto function. (Contributed by NM, 22-Mar-2006.)
theorem dffo2 (A2 B2 F: class):
  $ wb (wfo A2 B2 F) (wa (wf A2 B2 F) (wceq (crn F) B2)) $;

--| The image of the domain of an onto function. (Contributed by NM, 29-Nov-2002.)
theorem foima (A2 B2 F: class):
  $ wi (wfo A2 B2 F) (wceq (cima F A2) B2) $;

--| A function maps onto its range. (Contributed by NM, 10-May-1998.)
theorem dffn4 (A2 F: class):
  $ wb (wfn F A2) (wfo A2 (crn F) F) $;

--| A function maps its domain onto its range. (Contributed by NM, 23-Jul-2004.)
theorem funforn (A2: class):
  $ wb (wfun A2) (wfo (cdm A2) (crn A2) A2) $;

--| An onto function has unique domain and range. (Contributed by NM, 5-Nov-2006.)
theorem fodmrnu (A2 B2 C D F: class):
  $ wi (wa (wfo A2 B2 F) (wfo C D F)) (wa (wceq A2 C) (wceq B2 D)) $;

--| Restriction of a function. (Contributed by NM, 4-Mar-1997.)
theorem fores (A2 F: class):
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wfo A2 (cima F A2) (cres F A2)) $;

--| Composition of onto functions. (Contributed by NM, 22-Mar-2006.)
theorem foco (A2 B2 C F G: class):
  $ wi (wa (wfo B2 C F) (wfo A2 B2 G)) (wfo A2 C (ccom F G)) $;

--| Equality theorem for one-to-one onto functions. (Contributed by NM, 10-Feb-1997.)
theorem f1oeq1 (A2 B2 F G: class):
  $ wi (wceq F G) (wb (wf1o A2 B2 F) (wf1o A2 B2 G)) $;

--| Equality theorem for one-to-one onto functions. (Contributed by NM, 10-Feb-1997.)
theorem f1oeq2 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wb (wf1o A2 C F) (wf1o B2 C F)) $;

--| Equality theorem for one-to-one onto functions. (Contributed by NM, 10-Feb-1997.)
theorem f1oeq3 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wb (wf1o C A2 F) (wf1o C B2 F)) $;

--| Equality theorem for one-to-one onto functions. (Contributed by FL, 14-Jul-2012.)
theorem f1oeq23 (A2 B2 C D F: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wb (wf1o A2 C F) (wf1o B2 D F)) $;

--| Equality deduction for one-to-one functions. (Contributed by Mario Carneiro, 27-Jan-2017.)
theorem f1eq123d (ph: wff) (A2 B2 C D F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wf1 A2 C F) (wf1 B2 D G)) $;

--| Equality deduction for onto functions. (Contributed by Mario Carneiro, 27-Jan-2017.)
theorem foeq123d (ph: wff) (A2 B2 C D F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wfo A2 C F) (wfo B2 D G)) $;

--| Equality deduction for one-to-one onto functions. (Contributed by Mario Carneiro, 27-Jan-2017.)
theorem f1oeq123d (ph: wff) (A2 B2 C D F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wf1o A2 C F) (wf1o B2 D G)) $;

--| Bound-variable hypothesis builder for a one-to-one onto function. (Contributed by NM, 16-May-2004.)
theorem nff1o {x3: setvar} (A2 B2 F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wf1o A2 B2 F) $;

--| A one-to-one onto mapping is a one-to-one mapping. (Contributed by NM, 12-Dec-2003.)
theorem f1of1 (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wf1 A2 B2 F) $;

--| A one-to-one onto mapping is a mapping. (Contributed by NM, 12-Dec-2003.)
theorem f1of (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wf A2 B2 F) $;

--| A one-to-one onto mapping is function on its domain. (Contributed by NM, 12-Dec-2003.)
theorem f1ofn (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wfn F A2) $;

--| A one-to-one onto mapping is a function. (Contributed by NM, 12-Dec-2003.)
theorem f1ofun (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wfun F) $;

--| A one-to-one onto mapping is a relation. (Contributed by NM, 13-Dec-2003.)
theorem f1orel (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wrel F) $;

--| The domain of a one-to-one onto mapping. (Contributed by NM, 8-Mar-2014.)
theorem f1odm (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wceq (cdm F) A2) $;

--| Alternate definition of one-to-one onto function. (Contributed by NM, 10-Feb-1997.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem dff1o2 (A2 B2 F: class):
  $ wb (wf1o A2 B2 F) (w3a (wfn F A2) (wfun (ccnv F)) (wceq (crn F) B2)) $;

--| Alternate definition of one-to-one onto function. (Contributed by NM, 25-Mar-1998.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem dff1o3 (A2 B2 F: class):
  $ wb (wf1o A2 B2 F) (wa (wfo A2 B2 F) (wfun (ccnv F))) $;

--| A one-to-one onto function is an onto function. (Contributed by NM, 28-Apr-2004.)
theorem f1ofo (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wfo A2 B2 F) $;

--| Alternate definition of one-to-one onto function. (Contributed by NM, 25-Mar-1998.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem dff1o4 (A2 B2 F: class):
  $ wb (wf1o A2 B2 F) (wa (wfn F A2) (wfn (ccnv F) B2)) $;

--| Alternate definition of one-to-one onto function. (Contributed by NM, 10-Dec-2003.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem dff1o5 (A2 B2 F: class):
  $ wb (wf1o A2 B2 F) (wa (wf1 A2 B2 F) (wceq (crn F) B2)) $;

--| A one-to-one function maps onto its range. (Contributed by NM, 13-Aug-2004.)
theorem f1orn (A2 F: class):
  $ wb (wf1o A2 (crn F) F) (wa (wfn F A2) (wfun (ccnv F))) $;

--| A one-to-one function maps one-to-one onto its range. (Contributed by NM, 4-Sep-2004.)
theorem f1f1orn (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wf1o A2 (crn F) F) $;

--| The class of all 1-1-onto functions mapping one set to another is a set. (Contributed by Paul Chapman, 25-Feb-2008.)
theorem f1oabexg {f2: setvar} (ph: wff f2) (A2 B2: class) (C D F: class f2):
  $ wceq F (cab f2 (wa (wf1o A2 B2 (cv f2)) ph)) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wcel F cvv) $;

--| The converse of a one-to-one onto function is also one-to-one onto. (Contributed by NM, 11-Feb-1997.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem f1ocnv (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wf1o B2 A2 (ccnv F)) $;

--| A relation is a one-to-one onto function iff its converse is a one-to-one onto function with domain and range interchanged. (Contributed by NM, 8-Dec-2003.)
theorem f1ocnvb (A2 B2 F: class):
  $ wi (wrel F) (wb (wf1o A2 B2 F) (wf1o B2 A2 (ccnv F))) $;

--| The restriction of a one-to-one function maps one-to-one onto the image. (Contributed by NM, 25-Mar-1998.)
theorem f1ores (A2 B2 C F: class):
  $ wi (wa (wf1 A2 B2 F) (wss C A2)) (wf1o C (cima F C) (cres F C)) $;

--| The converse of a one-to-one-onto restricted function. (Contributed by Paul Chapman, 21-Apr-2008.)
theorem f1orescnv (P R F: class):
  $ wi (wa (wfun (ccnv F)) (wf1o R P (cres F R))) (wf1o P R (cres (ccnv F) P)) $;

--| Preimage of an image. (Contributed by NM, 30-Sep-2004.)
theorem f1imacnv (A2 B2 C F: class):
  $ wi (wa (wf1 A2 B2 F) (wss C A2)) (wceq (cima (ccnv F) (cima F C)) C) $;

--| A reverse version of ~ f1imacnv . (Contributed by Jeff Hankins, 16-Jul-2009.)
theorem foimacnv (A2 B2 C F: class):
  $ wi (wa (wfo A2 B2 F) (wss C B2)) (wceq (cima F (cima (ccnv F) C)) C) $;

--| The union of two onto functions with disjoint domains is an onto function. (Contributed by Mario Carneiro, 22-Jun-2016.)
theorem foun (A2 B2 C D F G: class):
  $ wi (wa (wa (wfo A2 B2 F) (wfo C D G)) (wceq (cin A2 C) c0)) (wfo (cun A2 C) (cun B2 D) (cun F G)) $;

--| The union of two one-to-one onto functions with disjoint domains and ranges. (Contributed by NM, 26-Mar-1998.)
theorem f1oun (A2 B2 C D F G: class):
  $ wi (wa (wa (wf1o A2 B2 F) (wf1o C D G)) (wa (wceq (cin A2 C) c0) (wceq (cin B2 D) c0))) (wf1o (cun A2 C) (cun B2 D) (cun F G)) $;

--| The union of a chain (with respect to inclusion) of one-to-one functions is a one-to-one function. (Contributed by Mario Carneiro, 20-May-2013.) (Revised by Mario Carneiro, 24-Jun-2015.)
theorem fun11iun {x3 y1: setvar} (A2: class) (B2: class x3) (C: class y1) (D: class x3 y1) (S: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wcel B2 cvv $ >
  $ wi (wral x3 (wa (wf1 D S B2) (wral y1 (wo (wss B2 C) (wss C B2)) A2)) A2) (wf1 (ciun x3 A2 D) S (ciun x3 A2 B2)) $;

--| The restriction of a one-to-one onto function to a difference maps onto the difference of the images. (Contributed by Paul Chapman, 11-Apr-2009.)
theorem resdif (A2 B2 C D F: class):
  $ wi (w3a (wfun (ccnv F)) (wfo A2 C (cres F A2)) (wfo B2 D (cres F B2))) (wf1o (cdif A2 B2) (cdif C D) (cres F (cdif A2 B2))) $;

--| Composition of one-to-one onto functions. (Contributed by NM, 19-Mar-1998.)
theorem f1oco (A2 B2 C F G: class):
  $ wi (wa (wf1o B2 C F) (wf1o A2 B2 G)) (wf1o A2 C (ccom F G)) $;

--| The converse of an injective function is bijective. (Contributed by FL, 11-Nov-2011.)
theorem f1cnv (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wf1o (crn F) A2 (ccnv F)) $;

--| Composition with the converse. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem funcocnv2 (F: class):
  $ wi (wfun F) (wceq (ccom F (ccnv F)) (cres cid (crn F))) $;

--| The composition of an onto function and its converse. (Contributed by Stefan O'Rear, 12-Feb-2015.)
theorem fococnv2 (A2 B2 F: class):
  $ wi (wfo A2 B2 F) (wceq (ccom F (ccnv F)) (cres cid B2)) $;

--| The composition of a one-to-one onto function and its converse equals the identity relation restricted to the function's range. (Contributed by NM, 13-Dec-2003.) (Proof shortened by Stefan O'Rear, 12-Feb-2015.)
theorem f1ococnv2 (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wceq (ccom F (ccnv F)) (cres cid B2)) $;

--| Composition of an injective function with its converse. (Contributed by FL, 11-Nov-2011.)
theorem f1cocnv2 (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wceq (ccom F (ccnv F)) (cres cid (crn F))) $;

--| The composition of a one-to-one onto function's converse and itself equals the identity relation restricted to the function's domain. (Contributed by NM, 13-Dec-2003.)
theorem f1ococnv1 (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wceq (ccom (ccnv F) F) (cres cid A2)) $;

--| Composition of an injective function with its converse. (Contributed by FL, 11-Nov-2011.)
theorem f1cocnv1 (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wceq (ccom (ccnv F) F) (cres cid A2)) $;

--| Re-express a constraint on a composition as a constraint on the composand. (Contributed by Stefan O'Rear, 7-Mar-2015.)
theorem funcoeqres (F G H: class):
  $ wi (wa (wfun G) (wceq (ccom F G) H)) (wceq (cres F (crn G)) (ccom H (ccnv G))) $;

--| Relationship between a mapping and an onto mapping. Figure 38 of [Enderton] p. 145. (Contributed by NM, 10-May-1998.)
theorem ffoss {x3: setvar} (A2 B2 F: class):
  $ wcel F cvv $ >
  $ wb (wf A2 B2 F) (wex x3 (wa (wfo A2 (cv x3) F) (wss (cv x3) B2))) $;

--| Relationship between one-to-one and one-to-one onto function. (Contributed by NM, 4-Apr-1998.)
theorem f11o {x3: setvar} (A2 B2 F: class):
  $ wcel F cvv $ >
  $ wb (wf1 A2 B2 F) (wex x3 (wa (wf1o A2 (cv x3) F) (wss (cv x3) B2))) $;

--| The empty set maps one-to-one into any class. (Contributed by NM, 7-Apr-1998.)
theorem f10 (A2: class):
  $ wf1 c0 A2 c0 $;

--| One-to-one onto mapping of the empty set. (Contributed by NM, 15-Apr-1998.)
theorem f1o00 (A2 F: class):
  $ wb (wf1o c0 A2 F) (wa (wceq F c0) (wceq A2 c0)) $;

--| Onto mapping of the empty set. (Contributed by NM, 22-Mar-2006.)
theorem fo00 (A2 F: class):
  $ wb (wfo c0 A2 F) (wa (wceq F c0) (wceq A2 c0)) $;

--| One-to-one onto mapping of the empty set. (Contributed by NM, 10-Sep-2004.)
theorem f1o0:
  $ wf1o c0 c0 c0 $;

--| A restriction of the identity relation is a one-to-one onto function. (Contributed by NM, 30-Apr-1998.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem f1oi (A2: class):
  $ wf1o A2 A2 (cres cid A2) $;

--| The identity relation is a one-to-one onto function on the universe. (Contributed by NM, 16-May-2004.)
theorem f1ovi:
  $ wf1o cvv cvv cid $;

--| A singleton of an ordered pair is one-to-one onto function. (Contributed by NM, 18-May-1998.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem f1osn (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wf1o (csn A2) (csn B2) (csn (cop A2 B2)) $;

--| A singleton of an ordered pair is one-to-one onto function. (Contributed by Mario Carneiro, 12-Jan-2013.)
theorem f1osng (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wf1o (csn A2) (csn B2) (csn (cop A2 B2))) $;

--| An unordered pair of ordered pairs with different elements is a one-to-one onto function. (Contributed by Alexander van der Vekens, 14-Aug-2017.)
theorem f1oprg (A2 B2 C D V W X Y: class):
  $ wi (wa (wa (wcel A2 V) (wcel B2 W)) (wa (wcel C X) (wcel D Y))) (wi (wa (wne A2 C) (wne B2 D)) (wf1o (cpr A2 C) (cpr B2 D) (cpr (cop A2 B2) (cop C D)))) $;

--| Function value when ` F ` is not a function. Theorem 6.12(2) of [TakeutiZaring] p. 27. (Contributed by NM, 30-Apr-2004.) (Proof shortened by Mario Carneiro, 31-Aug-2015.)
theorem tz6_12_2 {x3: setvar} (A2 F: class):
  $ wi (wn (weu x3 (wbr A2 (cv x3) F))) (wceq (cfv A2 F) c0) $;

--| The value of a function at a unique point. (Contributed by Scott Fenton, 6-Oct-2017.)
theorem fveu {x3: setvar} (A2 F: class):
  $ wi (weu x3 (wbr A2 (cv x3) F)) (wceq (cfv A2 F) (cuni (cab x3 (wbr A2 (cv x3) F)))) $;

--| If ` A ` is a proper class, then there is no unique binary relationship with ` A ` as the first element. (Contributed by Scott Fenton, 7-Oct-2017.)
theorem brprcneu {x3: setvar} (A2 F: class):
  $ wi (wn (wcel A2 cvv)) (wn (weu x3 (wbr A2 (cv x3) F))) $;

--| A function's value at a proper class is the empty set. (Contributed by NM, 20-May-1998.)
theorem fvprc (A2 F: class):
  $ wi (wn (wcel A2 cvv)) (wceq (cfv A2 F) c0) $;

--| Alternate definition of function value. Definition 10.11 of [Quine] p. 68. (Contributed by NM, 30-Apr-2004.) (Proof shortened by Andrew Salmon, 17-Sep-2011.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem fv2 {x3 y1: setvar} (A2 F: class):
  $ wceq (cfv A2 F) (cuni (cab x3 (wal y1 (wb (wbr A2 (cv y1) F) (wceq (cv y1) (cv x3)))))) $;

--| A definition of function value in terms of iota. (Contributed by Jim Kingdon, 29-Dec-2018.)
theorem dffv3g {x3: setvar} (A2 F V: class):
  $ wi (wcel A2 V) (wceq (cfv A2 F) (cio x3 (wcel (cv x3) (cima F (csn A2))))) $;

--| The previous definition of function value, from before the ` iota ` operator was introduced. Although based on the idea embodied by Definition 10.2 of [Quine] p. 65 (see ~ args ), this definition apparently does not appear in the literature. (Contributed by NM, 1-Aug-1994.)
theorem dffv4g {x3: setvar} (A2 F V: class):
  $ wi (wcel A2 V) (wceq (cfv A2 F) (cuni (cab x3 (wceq (cima F (csn A2)) (csn (cv x3)))))) $;

--| Membership in a function value. (Contributed by NM, 30-Apr-2004.)
theorem elfv {x3 y1: setvar} (A2: class y1) (B2 F: class):
  $ wb (wcel A2 (cfv B2 F)) (wex x3 (wa (wcel A2 (cv x3)) (wal y1 (wb (wbr B2 (cv y1) F) (wceq (cv y1) (cv x3)))))) $;

--| Equality theorem for function value. (Contributed by NM, 29-Dec-1996.)
theorem fveq1 (A2 F G: class):
  $ wi (wceq F G) (wceq (cfv A2 F) (cfv A2 G)) $;

--| Equality theorem for function value. (Contributed by NM, 29-Dec-1996.)
theorem fveq2 (A2 B2 F: class):
  $ wi (wceq A2 B2) (wceq (cfv A2 F) (cfv B2 F)) $;

--| Equality inference for function value. (Contributed by NM, 2-Sep-2003.)
theorem fveq1i (A2 F G: class):
  $ wceq F G $ >
  $ wceq (cfv A2 F) (cfv A2 G) $;

--| Equality deduction for function value. (Contributed by NM, 2-Sep-2003.)
theorem fveq1d (ph: wff) (A2 F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq (cfv A2 F) (cfv A2 G)) $;

--| Equality inference for function value. (Contributed by NM, 28-Jul-1999.)
theorem fveq2i (A2 B2 F: class):
  $ wceq A2 B2 $ >
  $ wceq (cfv A2 F) (cfv B2 F) $;

--| Equality deduction for function value. (Contributed by NM, 29-May-1999.)
theorem fveq2d (ph: wff) (A2 B2 F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cfv A2 F) (cfv B2 F)) $;

--| Equality deduction for function value. (Contributed by FL, 27-Jun-2014.)
theorem fveq12i (A2 B2 F G: class):
  $ wceq F G $ >
  $ wceq A2 B2 $ >
  $ wceq (cfv A2 F) (cfv B2 G) $;

--| Equality deduction for function value. (Contributed by FL, 22-Dec-2008.)
theorem fveq12d (ph: wff) (A2 B2 F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cfv A2 F) (cfv B2 G)) $;

--| Bound-variable hypothesis builder for function value. (Contributed by NM, 14-Nov-1995.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nffv {x3: setvar} (A2 F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 (cfv A2 F) $;

--| Bound-variable hypothesis builder for mapping, special case. (Contributed by Mario Carneiro, 25-Dec-2016.)
theorem nffvmpt1 {x3: setvar} (A2 B2: class x3) (C: class):
  $ wnfc x3 (cfv C (cmpt x3 A2 B2)) $;

--| Deduction version of bound-variable hypothesis builder ~ nffv . (Contributed by NM, 10-Nov-2005.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nffvd {x3: setvar} (ph: wff x3) (A2 F: class x3):
  $ wi ph (wnfc x3 F) $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 (cfv A2 F)) $;

--| A function has one value given an argument in its domain. (Contributed by Jim Kingdon, 29-Dec-2018.)
theorem funfveu {y1: setvar} (A2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cdm F))) (weu y1 (wbr A2 (cv y1) F)) $;

--| The value of a function is a subset of ` B ` if every element that could be a candidate for the value is a subset of ` B ` . (Contributed by Mario Carneiro, 24-May-2019.)
theorem fvss {x3: setvar} (A2 B2 F: class):
  $ wi (wal x3 (wi (wbr A2 (cv x3) F) (wss (cv x3) B2))) (wss (cfv A2 F) B2) $;

--| The result of a function value is always a subset of the union of the range, if the input is a set. (Contributed by Stefan O'Rear, 2-Nov-2014.) (Revised by Mario Carneiro, 24-May-2019.)
theorem fvssunirng (A2 F: class):
  $ wi (wcel A2 cvv) (wss (cfv A2 F) (cuni (crn F))) $;

--| The result of a function value is always a subset of the union of the range, even if it is invalid and thus empty. (Contributed by Stefan O'Rear, 2-Nov-2014.) (Revised by Mario Carneiro, 24-May-2019.)
theorem relfvssunirn (A2 F: class):
  $ wi (wrel F) (wss (cfv A2 F) (cuni (crn F))) $;

--| The value of a function exists. A special case of Corollary 6.13 of [TakeutiZaring] p. 27. (Contributed by Jim Kingdon, 29-Dec-2018.)
theorem funfvex (A2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cdm F))) (wcel (cfv A2 F) cvv) $;

--| If a function has a set range, then the function value exists unconditional on the domain. (Contributed by Mario Carneiro, 24-May-2019.)
theorem relrnfvex (A2 F: class):
  $ wi (wa (wrel F) (wcel (crn F) cvv)) (wcel (cfv A2 F) cvv) $;

--| Evaluating a set function at a set exists. (Contributed by Mario Carneiro and Jim Kingdon, 28-May-2019.)
theorem fvexg (A2 F V W: class):
  $ wi (wa (wcel F V) (wcel A2 W)) (wcel (cfv A2 F) cvv) $;

--| Evaluating a set function at a set exists. (Contributed by Mario Carneiro and Jim Kingdon, 28-May-2019.)
theorem fvex (A2 F V W: class):
  $ wcel F V $ >
  $ wcel A2 W $ >
  $ wcel (cfv A2 F) cvv $;

--| If a function is set-like, then the function value exists if the input does. (Contributed by Mario Carneiro, 24-May-2019.)
theorem sefvex (A2 F: class):
  $ wi (wa (wse cvv (ccnv F)) (wcel A2 cvv)) (wcel (cfv A2 F) cvv) $;

--| Alternate definition of the value of a function. Definition 6.11 of [TakeutiZaring] p. 26. (Contributed by NM, 30-Apr-2004.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem fv3 {x3 y1: setvar} (A2 F: class):
  $ wceq (cfv A2 F) (cab x3 (wa (wex y1 (wa (wcel (cv x3) (cv y1)) (wbr A2 (cv y1) F))) (weu y1 (wbr A2 (cv y1) F)))) $;

--| The value of a restricted function. (Contributed by NM, 2-Aug-1994.)
theorem fvres (A2 B2 F: class):
  $ wi (wcel A2 B2) (wceq (cfv A2 (cres F B2)) (cfv A2 F)) $;

--| The value of a member of the domain of a subclass of a function. (Contributed by NM, 15-Aug-1994.)
theorem funssfv (A2 F G: class):
  $ wi (w3a (wfun F) (wss G F) (wcel A2 (cdm G))) (wceq (cfv A2 F) (cfv A2 G)) $;

--| Function value. Theorem 6.12(1) of [TakeutiZaring] p. 27. (Contributed by NM, 30-Apr-2004.)
theorem tz6_12_1 {y1: setvar} (A2 F: class):
  $ wi (wa (wbr A2 (cv y1) F) (weu y1 (wbr A2 (cv y1) F))) (wceq (cfv A2 F) (cv y1)) $;

--| Function value. Theorem 6.12(1) of [TakeutiZaring] p. 27. (Contributed by NM, 10-Jul-1994.)
theorem tz6_12 {y1: setvar} (A2 F: class):
  $ wi (wa (wcel (cop A2 (cv y1)) F) (weu y1 (wcel (cop A2 (cv y1)) F))) (wceq (cfv A2 F) (cv y1)) $;

--| Function value, using bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 30-Aug-1999.)
theorem tz6_12f {y1: setvar} (A2: class) (F: class y1):
  $ wnfc y1 F $ >
  $ wi (wa (wcel (cop A2 (cv y1)) F) (weu y1 (wcel (cop A2 (cv y1)) F))) (wceq (cfv A2 F) (cv y1)) $;

--| Corollary of Theorem 6.12(1) of [TakeutiZaring] p. 27. (Contributed by NM, 30-Apr-2004.)
theorem tz6_12c {y1: setvar} (A2 F: class):
  $ wi (weu y1 (wbr A2 (cv y1) F)) (wb (wceq (cfv A2 F) (cv y1)) (wbr A2 (cv y1) F)) $;

--| The value of a class outside its domain is the empty set. (Contributed by Jim Kingdon, 15-Jan-2019.)
theorem ndmfvg (A2 F: class):
  $ wi (wa (wcel A2 cvv) (wn (wcel A2 (cdm F)))) (wceq (cfv A2 F) c0) $;

--| If a function value has a member, the argument belongs to the domain. (Contributed by Jim Kingdon, 22-Jan-2019.)
theorem relelfvdm (A2 B2 F: class):
  $ wi (wa (wrel F) (wcel A2 (cfv B2 F))) (wcel B2 (cdm F)) $;

--| The value of a non-member of a restriction is the empty set. (Contributed by NM, 13-Nov-1995.)
theorem nfvres (A2 B2 F: class):
  $ wi (wn (wcel A2 B2)) (wceq (cfv A2 (cres F B2)) c0) $;

--| If the restriction of a class to a singleton is not a function, its value is the empty set. (Contributed by NM, 8-Aug-2010.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem nfunsn (A2 F: class):
  $ wi (wn (wfun (cres F (csn A2)))) (wceq (cfv A2 F) c0) $;

--| Function value of the empty set. (Contributed by Stefan O'Rear, 26-Nov-2014.)
theorem _0fv (A2: class):
  $ wceq (cfv A2 c0) c0 $;

--| Move class substitution in and out of a function value. (Contributed by NM, 11-Nov-2005.)
theorem csbfv12g {x3: setvar} (A2 B2 C F: class x3):
  $ wi (wcel A2 C) (wceq (csb x3 A2 (cfv B2 F)) (cfv (csb x3 A2 B2) (csb x3 A2 F))) $;

--| Move class substitution in and out of a function value. (Contributed by NM, 10-Nov-2005.)
theorem csbfv2g {x3: setvar} (A2 B2 C: class x3) (F: class):
  $ wi (wcel A2 C) (wceq (csb x3 A2 (cfv B2 F)) (cfv (csb x3 A2 B2) F)) $;

--| Substitution for a function value. (Contributed by NM, 1-Jan-2006.)
theorem csbfvg {x3: setvar} (A2 C: class x3) (F: class):
  $ wi (wcel A2 C) (wceq (csb x3 A2 (cfv (cv x3) F)) (cfv A2 F)) $;

--| The second argument of a binary relation on a function is the function's value. (Contributed by NM, 30-Apr-2004.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem funbrfv (A2 B2 F: class):
  $ wi (wfun F) (wi (wbr A2 B2 F) (wceq (cfv A2 F) B2)) $;

--| The second element in an ordered pair member of a function is the function's value. (Contributed by NM, 19-Jul-1996.)
theorem funopfv (A2 B2 F: class):
  $ wi (wfun F) (wi (wcel (cop A2 B2) F) (wceq (cfv A2 F) B2)) $;

--| Equivalence of function value and binary relation. (Contributed by NM, 19-Apr-2004.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem fnbrfvb (A2 B2 C F: class):
  $ wi (wa (wfn F A2) (wcel B2 A2)) (wb (wceq (cfv B2 F) C) (wbr B2 C F)) $;

--| Equivalence of function value and ordered pair membership. (Contributed by NM, 7-Nov-1995.)
theorem fnopfvb (A2 B2 C F: class):
  $ wi (wa (wfn F A2) (wcel B2 A2)) (wb (wceq (cfv B2 F) C) (wcel (cop B2 C) F)) $;

--| Equivalence of function value and binary relation. (Contributed by NM, 26-Mar-2006.)
theorem funbrfvb (A2 B2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cdm F))) (wb (wceq (cfv A2 F) B2) (wbr A2 B2 F)) $;

--| Equivalence of function value and ordered pair membership. Theorem 4.3(ii) of [Monk1] p. 42. (Contributed by NM, 26-Jan-1997.)
theorem funopfvb (A2 B2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cdm F))) (wb (wceq (cfv A2 F) B2) (wcel (cop A2 B2) F)) $;

--| Function value in terms of a binary relation. (Contributed by Mario Carneiro, 19-Mar-2014.)
theorem funbrfv2b (A2 B2 F: class):
  $ wi (wfun F) (wb (wbr A2 B2 F) (wa (wcel A2 (cdm F)) (wceq (cfv A2 F) B2))) $;

--| Representation of a function in terms of its values. The converse holds given the law of the excluded middle; as it is we have most of the converse via ~ funmpt and ~ dmmptss . (Contributed by Jim Kingdon, 31-Dec-2018.)
theorem dffn5im {x3: setvar} (A2 F: class):
  $ wi (wfn F A2) (wceq F (cmpt x3 A2 (cfv (cv x3) F))) $;

--| The range of a function expressed as a collection of the function's values. (Contributed by NM, 20-Oct-2005.) (Proof shortened by Mario Carneiro, 31-Aug-2015.)
theorem fnrnfv {x3 y1: setvar} (A2 F: class):
  $ wi (wfn F A2) (wceq (crn F) (cab y1 (wrex x3 (wceq (cv y1) (cfv (cv x3) F)) A2))) $;

--| A member of a function's range is a value of the function. (Contributed by NM, 31-Oct-1995.)
theorem fvelrnb {x3: setvar} (A2 B2 F: class):
  $ wi (wfn F A2) (wb (wcel B2 (crn F)) (wrex x3 (wceq (cfv (cv x3) F) B2) A2)) $;

--| Alternate definition of the image of a function. (Contributed by Raph Levien, 20-Nov-2006.)
theorem dfimafn {x3 y1: setvar} (A2 F: class):
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wceq (cima F A2) (cab y1 (wrex x3 (wceq (cfv (cv x3) F) (cv y1)) A2))) $;

--| Alternate definition of the image of a function as an indexed union of singletons of function values. (Contributed by Raph Levien, 20-Nov-2006.)
theorem dfimafn2 {x3: setvar} (A2 F: class):
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wceq (cima F A2) (ciun x3 A2 (csn (cfv (cv x3) F)))) $;

--| Membership relation for the values of a function whose image is a subclass. (Contributed by Raph Levien, 20-Nov-2006.)
theorem funimass4 {x3: setvar} (A2 B2 F: class):
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wb (wss (cima F A2) B2) (wral x3 (wcel (cfv (cv x3) F) B2) A2)) $;

--| Function value in an image. Part of Theorem 4.4(iii) of [Monk1] p. 42. (Contributed by NM, 29-Apr-2004.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem fvelima {x3: setvar} (A2 B2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cima F B2))) (wrex x3 (wceq (cfv (cv x3) F) A2) B2) $;

--| Deduction form of ~ dffn5im . (Contributed by Mario Carneiro, 8-Jan-2015.)
theorem feqmptd {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wceq F (cmpt x3 A2 (cfv (cv x3) F))) $;

--| Express a restricted function as a mapping. (Contributed by Mario Carneiro, 18-May-2016.)
theorem feqresmpt {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wss C A2) $ >
  $ wi ph (wceq (cres F C) (cmpt x3 C (cfv (cv x3) F))) $;

--| Representation of a function in terms of its values. (Contributed by Jim Kingdon, 31-Dec-2018.)
theorem dffn5imf {x3: setvar} (A2: class) (F: class x3):
  $ wnfc x3 F $ >
  $ wi (wfn F A2) (wceq F (cmpt x3 A2 (cfv (cv x3) F))) $;

--| Function value in an image. (Contributed by NM, 20-Jan-2007.) (Proof shortened by Andrew Salmon, 22-Oct-2011.) (Revised by David Abernethy, 17-Dec-2011.)
theorem fvelimab {x3: setvar} (A2: class x3) (B2 C F: class):
  $ wi (wa (wfn F A2) (wss B2 A2)) (wb (wcel C (cima F B2)) (wrex x3 (wceq (cfv (cv x3) F) C) B2)) $;

--| The value of the identity function. (Contributed by NM, 1-May-2004.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem fvi (A2 V: class):
  $ wi (wcel A2 V) (wceq (cfv A2 cid) A2) $;

--| The indexed intersection of a function's values is the intersection of its range. (Contributed by NM, 20-Oct-2005.)
theorem fniinfv {x3: setvar} (A2 F: class):
  $ wi (wfn F A2) (wceq (ciin x3 A2 (cfv (cv x3) F)) (cint (crn F))) $;

--| Singleton of function value. (Contributed by NM, 22-May-1998.)
theorem fnsnfv (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wcel B2 A2)) (wceq (csn (cfv B2 F)) (cima F (csn B2))) $;

--| The image of a pair under a function. (Contributed by Jeff Madsen, 6-Jan-2011.)
theorem fnimapr (A2 B2 C F: class):
  $ wi (w3a (wfn F A2) (wcel B2 A2) (wcel C A2)) (wceq (cima F (cpr B2 C)) (cpr (cfv B2 F) (cfv C F))) $;

--| The existence of a subimage. (Contributed by NM, 8-Apr-2007.)
theorem ssimaex {x3: setvar} (A2 B2 F: class):
  $ wcel A2 cvv $ >
  $ wi (wa (wfun F) (wss B2 (cima F A2))) (wex x3 (wa (wss (cv x3) A2) (wceq B2 (cima F (cv x3))))) $;

--| The existence of a subimage. (Contributed by FL, 15-Apr-2007.)
theorem ssimaexg {x3: setvar} (A2 B2: class) (C: class x3) (F: class):
  $ wi (w3a (wcel A2 C) (wfun F) (wss B2 (cima F A2))) (wex x3 (wa (wss (cv x3) A2) (wceq B2 (cima F (cv x3))))) $;

--| A simplified expression for the value of a function when we know it's a function. (Contributed by Jim Kingdon, 1-Jan-2019.)
theorem funfvdm (A2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cdm F))) (wceq (cfv A2 F) (cuni (cima F (csn A2)))) $;

--| The value of a function. Definition of function value in [Enderton] p. 43. (Contributed by Jim Kingdon, 1-Jan-2019.)
theorem funfvdm2 {y1: setvar} (A2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cdm F))) (wceq (cfv A2 F) (cuni (cab y1 (wbr A2 (cv y1) F)))) $;

--| The value of a function. Version of ~ funfvdm2 using a bound-variable hypotheses instead of distinct variable conditions. (Contributed by Jim Kingdon, 1-Jan-2019.)
theorem funfvdm2f {y1: setvar} (A2 F: class y1):
  $ wnfc y1 A2 $ >
  $ wnfc y1 F $ >
  $ wi (wa (wfun F) (wcel A2 (cdm F))) (wceq (cfv A2 F) (cuni (cab y1 (wbr A2 (cv y1) F)))) $;

--| The value of a union when the argument is in the first domain. (Contributed by Scott Fenton, 29-Jun-2013.)
theorem fvun1 (A2 B2 F G X: class):
  $ wi (w3a (wfn F A2) (wfn G B2) (wa (wceq (cin A2 B2) c0) (wcel X A2))) (wceq (cfv X (cun F G)) (cfv X F)) $;

--| The value of a union when the argument is in the second domain. (Contributed by Scott Fenton, 29-Jun-2013.)
theorem fvun2 (A2 B2 F G X: class):
  $ wi (w3a (wfn F A2) (wfn G B2) (wa (wceq (cin A2 B2) c0) (wcel X B2))) (wceq (cfv X (cun F G)) (cfv X G)) $;

--| Domains of a function composition. (Contributed by NM, 27-Jan-1997.)
theorem dmfco (A2 F G: class):
  $ wi (wa (wfun G) (wcel A2 (cdm G))) (wb (wcel A2 (cdm (ccom F G))) (wcel (cfv A2 G) (cdm F))) $;

--| Value of a function composition. Similar to second part of Theorem 3H of [Enderton] p. 47. (Contributed by NM, 9-Oct-2004.) (Proof shortened by Andrew Salmon, 22-Oct-2011.) (Revised by Stefan O'Rear, 16-Oct-2014.)
theorem fvco2 (A2 F G X: class):
  $ wi (wa (wfn G A2) (wcel X A2)) (wceq (cfv X (ccom F G)) (cfv (cfv X G) F)) $;

--| Value of a function composition. Similar to Exercise 5 of [TakeutiZaring] p. 28. (Contributed by NM, 22-Apr-2006.) (Proof shortened by Mario Carneiro, 26-Dec-2014.)
theorem fvco (A2 F G: class):
  $ wi (wa (wfun G) (wcel A2 (cdm G))) (wceq (cfv A2 (ccom F G)) (cfv (cfv A2 G) F)) $;

--| Value of a function composition. (Contributed by NM, 3-Jan-2004.) (Revised by Mario Carneiro, 26-Dec-2014.)
theorem fvco3 (A2 B2 C F G: class):
  $ wi (wa (wf A2 B2 G) (wcel C A2)) (wceq (cfv C (ccom F G)) (cfv (cfv C G) F)) $;

--| Value of a function given by ordered-pair class abstraction. (Contributed by NM, 6-Mar-1996.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem fvopab3g {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2 C: class) (D F: class x3 y1):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wcel (cv x3) C) (weu y1 ph) $ >
  $ wceq F (copab x3 y1 (wa (wcel (cv x3) C) ph)) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wb (wceq (cfv A2 F) B2) ch) $;

--| Value of a function given by ordered-pair class abstraction. (Contributed by NM, 23-Oct-1999.)
theorem fvopab3ig {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2 C: class) (D F: class x3 y1):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wcel (cv x3) C) (wmo y1 ph) $ >
  $ wceq F (copab x3 y1 (wa (wcel (cv x3) C) ph)) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wi ch (wceq (cfv A2 F) B2)) $;

--| A mapping always evaluates to a subset of the substituted expression in the mapping, even if this is a proper class, or we are out of the domain. (Contributed by Mario Carneiro, 13-Feb-2015.) (Revised by Mario Carneiro, 3-Jul-2019.)
theorem fvmptss2 {x3: setvar} (A2: class) (B2: class x3) (C D: class) (F: class x3):
  $ wi (wceq (cv x3) D) (wceq B2 C) $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wss (cfv D F) C $;

--| Value of a function given in maps-to notation. (Contributed by NM, 2-Oct-2007.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem fvmptg {x3: setvar} (A2: class) (B2: class x3) (C D: class) (R F: class x3):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq F (cmpt x3 D B2) $ >
  $ wi (wa (wcel A2 D) (wcel C R)) (wceq (cfv A2 F) C) $;

--| Value of a function given in maps-to notation. (Contributed by NM, 17-Aug-2011.)
theorem fvmpt {x3: setvar} (A2: class) (B2: class x3) (C D: class) (F: class x3):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq F (cmpt x3 D B2) $ >
  $ wcel C cvv $ >
  $ wi (wcel A2 D) (wceq (cfv A2 F) C) $;

--| Value of a function given in maps-to notation, using explicit class substitution. (Contributed by Scott Fenton, 17-Jul-2013.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem fvmpts {x3: setvar} (A2 B2: class x3) (C: class) (F V: class x3):
  $ wceq F (cmpt x3 C B2) $ >
  $ wi (wa (wcel A2 C) (wcel (csb x3 A2 B2) V)) (wceq (cfv A2 F) (csb x3 A2 B2)) $;

--| Value of a function given in maps-to notation, with a slightly different sethood condition. (Contributed by Stefan O'Rear, 30-Jan-2015.)
theorem fvmpt3 {x3: setvar} (A2: class) (B2: class x3) (C D: class) (F: class x3) (V: class):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq F (cmpt x3 D B2) $ >
  $ wi (wcel (cv x3) D) (wcel B2 V) $ >
  $ wi (wcel A2 D) (wceq (cfv A2 F) C) $;

--| Value of a function given in maps-to notation, with a slightly different sethood condition. (Contributed by Mario Carneiro, 11-Sep-2015.)
theorem fvmpt3i {x3: setvar} (A2: class) (B2: class x3) (C D: class) (F: class x3):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq F (cmpt x3 D B2) $ >
  $ wcel B2 cvv $ >
  $ wi (wcel A2 D) (wceq (cfv A2 F) C) $;

--| Deduction version of ~ fvmpt . (Contributed by Scott Fenton, 18-Feb-2013.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem fvmptd {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C D: class) (F V: class x3):
  $ wi ph (wceq F (cmpt x3 D B2)) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wceq (cfv A2 F) C) $;

--| Value of a function given by the "maps to" notation. (Contributed by FL, 21-Jun-2010.)
theorem fvmpt2 {x3: setvar} (A2: class) (B2 C F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wa (wcel (cv x3) A2) (wcel B2 C)) (wceq (cfv (cv x3) F) B2) $;

--| If all the values of the mapping are subsets of a class ` C ` , then so is any evaluation of the mapping at a value in the domain of the mapping. (Contributed by Jim Kingdon, 3-Jan-2018.)
theorem fvmptssdm {x3: setvar} (A2: class) (B2: class x3) (C: class) (D F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wa (wcel D (cdm F)) (wral x3 (wss B2 C) A2)) (wss (cfv D F) C) $;

--| Sufficient condition for a maps-to notation to be set-like. (Contributed by Mario Carneiro, 3-Jul-2019.)
theorem mptfvex {x3: setvar} (A2: class) (B2: class x3) (C: class) (F V W: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wa (wal x3 (wcel B2 V)) (wcel C W)) (wcel (cfv C F) cvv) $;

--| Deduction version of ~ fvmpt2 . (Contributed by Thierry Arnoux, 8-Dec-2016.)
theorem fvmpt2d {x3: setvar} (ph: wff x3) (A2: class) (B2 F V: class x3):
  $ wi ph (wceq F (cmpt x3 A2 B2)) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq (cfv (cv x3) F) B2) $;

--| Alternate deduction version of ~ fvmpt , suitable for iteration. (Contributed by Mario Carneiro, 7-Jan-2017.)
theorem fvmptdf {x3: setvar} (ph: wff) (ps: wff x3) (A2: class) (B2: class x3) (D: class) (F V: class x3):
  $ wi ph (wcel A2 D) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wi (wceq (cfv A2 F) B2) ps) $ >
  $ wnfc x3 F $ >
  $ wnf x3 ps $ >
  $ wi ph (wi (wceq F (cmpt x3 D B2)) ps) $;

--| Alternate deduction version of ~ fvmpt , suitable for iteration. (Contributed by Mario Carneiro, 7-Jan-2017.)
theorem fvmptdv {x3: setvar} (ph ps: wff) (A2: class) (B2: class x3) (D F: class) (V: class x3):
  $ wi ph (wcel A2 D) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wi (wceq (cfv A2 F) B2) ps) $ >
  $ wi ph (wi (wceq F (cmpt x3 D B2)) ps) $;

--| Alternate deduction version of ~ fvmpt , suitable for iteration. (Contributed by Mario Carneiro, 7-Jan-2017.)
theorem fvmptdv2 {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C D: class) (F V: class x3):
  $ wi ph (wcel A2 D) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wi (wceq F (cmpt x3 D B2)) (wceq (cfv A2 F) C)) $;

--| Bidirectional equality theorem for a mapping abstraction. Equivalent to ~ eqfnfv . (Contributed by Mario Carneiro, 14-Nov-2014.)
theorem mpteqb {x3: setvar} (A2: class) (B2 C V: class x3):
  $ wi (wral x3 (wcel B2 V) A2) (wb (wceq (cmpt x3 A2 B2) (cmpt x3 A2 C)) (wral x3 (wceq B2 C) A2)) $;

--| Closed theorem form of ~ fvmpt . (Contributed by Scott Fenton, 21-Feb-2013.) (Revised by Mario Carneiro, 11-Sep-2015.)
theorem fvmptt {x3: setvar} (A2: class) (B2: class x3) (C D: class) (F V: class x3):
  $ wi (w3a (wal x3 (wi (wceq (cv x3) A2) (wceq B2 C))) (wceq F (cmpt x3 D B2)) (wa (wcel A2 D) (wcel C V))) (wceq (cfv A2 F) C) $;

--| Value of a function given by an ordered-pair class abstraction. This version of ~ fvmptg uses bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 8-Nov-2005.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem fvmptf {x3: setvar} (A2 B2 C: class x3) (D: class) (F V: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq F (cmpt x3 D B2) $ >
  $ wi (wa (wcel A2 D) (wcel C V)) (wceq (cfv A2 F) C) $;

--| Value of a function given by ordered-pair class abstraction. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 11-Sep-2015.)
theorem fvopab6 {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2: class) (B2: class x3) (C: class) (D R F: class x3 y1):
  $ wceq F (copab x3 y1 (wa ph (wceq (cv y1) B2))) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi (w3a (wcel A2 D) (wcel C R) ps) (wceq (cfv A2 F) C) $;

--| Equality of functions is determined by their values. Special case of Exercise 4 of [TakeutiZaring] p. 28 (with domain equality omitted). (Contributed by NM, 3-Aug-1994.) (Proof shortened by Andrew Salmon, 22-Oct-2011.) (Proof shortened by Mario Carneiro, 31-Aug-2015.)
theorem eqfnfv {x3: setvar} (A2 F G: class):
  $ wi (wa (wfn F A2) (wfn G A2)) (wb (wceq F G) (wral x3 (wceq (cfv (cv x3) F) (cfv (cv x3) G)) A2)) $;

--| Equality of functions is determined by their values. Exercise 4 of [TakeutiZaring] p. 28. (Contributed by NM, 3-Aug-1994.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem eqfnfv2 {x3: setvar} (A2: class) (B2: class x3) (F G: class):
  $ wi (wa (wfn F A2) (wfn G B2)) (wb (wceq F G) (wa (wceq A2 B2) (wral x3 (wceq (cfv (cv x3) F) (cfv (cv x3) G)) A2))) $;

--| Derive equality of functions from equality of their values. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem eqfnfv3 {x3: setvar} (A2 B2 F G: class):
  $ wi (wa (wfn F A2) (wfn G B2)) (wb (wceq F G) (wa (wss B2 A2) (wral x3 (wa (wcel (cv x3) B2) (wceq (cfv (cv x3) F) (cfv (cv x3) G))) A2))) $;

--| Deduction for equality of functions. (Contributed by Mario Carneiro, 24-Jul-2014.)
theorem eqfnfvd {x3: setvar} (ph: wff) (A2 F G: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wfn G A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq (cfv (cv x3) F) (cfv (cv x3) G)) $ >
  $ wi ph (wceq F G) $;

--| Equality of functions is determined by their values. Special case of Exercise 4 of [TakeutiZaring] p. 28 (with domain equality omitted). This version of ~ eqfnfv uses bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 29-Jan-2004.)
theorem eqfnfv2f {x3: setvar} (A2: class) (F G: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 G $ >
  $ wi (wa (wfn F A2) (wfn G A2)) (wb (wceq F G) (wral x3 (wceq (cfv (cv x3) F) (cfv (cv x3) G)) A2)) $;

--| Equality of functions is determined by their values. (Contributed by Scott Fenton, 19-Jun-2011.)
theorem eqfunfv {x3: setvar} (F G: class):
  $ wi (wa (wfun F) (wfun G)) (wb (wceq F G) (wa (wceq (cdm F) (cdm G)) (wral x3 (wceq (cfv (cv x3) F) (cfv (cv x3) G)) (cdm F)))) $;

--| Equality of restricted functions is determined by their values. (Contributed by NM, 3-Aug-1994.)
theorem fvreseq {x3: setvar} (A2: class x3) (B2 F G: class):
  $ wi (wa (wa (wfn F A2) (wfn G A2)) (wss B2 A2)) (wb (wceq (cres F B2) (cres G B2)) (wral x3 (wceq (cfv (cv x3) F) (cfv (cv x3) G)) B2)) $;

--| Two ways to express the locus of differences between two functions. (Contributed by Stefan O'Rear, 17-Jan-2015.)
theorem fndmdif {x3: setvar} (A2 F G: class):
  $ wi (wa (wfn F A2) (wfn G A2)) (wceq (cdm (cdif F G)) (crab x3 (wne (cfv (cv x3) F) (cfv (cv x3) G)) A2)) $;

--| The difference set between two functions is commutative. (Contributed by Stefan O'Rear, 17-Jan-2015.)
theorem fndmdifcom (A2 F G: class):
  $ wi (wa (wfn F A2) (wfn G A2)) (wceq (cdm (cdif F G)) (cdm (cdif G F))) $;

--| Two ways to express the locus of equality between two functions. (Contributed by Stefan O'Rear, 17-Jan-2015.)
theorem fndmin {x3: setvar} (A2 F G: class):
  $ wi (wa (wfn F A2) (wfn G A2)) (wceq (cdm (cin F G)) (crab x3 (wceq (cfv (cv x3) F) (cfv (cv x3) G)) A2)) $;

--| Two functions are equal iff their equalizer is the whole domain. (Contributed by Stefan O'Rear, 7-Mar-2015.)
theorem fneqeql (A2 F G: class):
  $ wi (wa (wfn F A2) (wfn G A2)) (wb (wceq F G) (wceq (cdm (cin F G)) A2)) $;

--| Two functions are equal iff their equalizer contains the whole domain. (Contributed by Stefan O'Rear, 9-Mar-2015.)
theorem fneqeql2 (A2 F G: class):
  $ wi (wa (wfn F A2) (wfn G A2)) (wb (wceq F G) (wss A2 (cdm (cin F G)))) $;

--| Two functions are equal on a subset iff their equalizer contains that subset. (Contributed by Stefan O'Rear, 7-Mar-2015.)
theorem fnreseql (A2 F G X: class):
  $ wi (w3a (wfn F A2) (wfn G A2) (wss X A2)) (wb (wceq (cres F X) (cres G X)) (wss X (cdm (cin F G)))) $;

--| The range of a choice function (a function that chooses an element from each member of its domain) is included in the union of its domain. (Contributed by NM, 31-Aug-1999.)
theorem chfnrn {x3: setvar} (A2 F: class):
  $ wi (wa (wfn F A2) (wral x3 (wcel (cfv (cv x3) F) (cv x3)) A2)) (wss (crn F) (cuni A2)) $;

--| Ordered pair with function value. Part of Theorem 4.3(i) of [Monk1] p. 41. (Contributed by NM, 14-Oct-1996.)
theorem funfvop (A2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cdm F))) (wcel (cop A2 (cfv A2 F)) F) $;

--| Two ways to say that ` A ` is in the domain of ` F ` . (Contributed by Mario Carneiro, 1-May-2014.)
theorem funfvbrb (A2 F: class):
  $ wi (wfun F) (wb (wcel A2 (cdm F)) (wbr A2 (cfv A2 F) F)) $;

--| A member of a preimage is a function value argument. (Contributed by NM, 4-May-2007.)
theorem fvimacnvi (A2 B2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cima (ccnv F) B2))) (wcel (cfv A2 F) B2) $;

--| The argument of a function value belongs to the preimage of any class containing the function value. Raph Levien remarks: "This proof is unsatisfying, because it seems to me that ~ funimass2 could probably be strengthened to a biconditional." (Contributed by Raph Levien, 20-Nov-2006.)
theorem fvimacnv (A2 B2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cdm F))) (wb (wcel (cfv A2 F) B2) (wcel A2 (cima (ccnv F) B2))) $;

--| A kind of contraposition law that infers an image subclass from a subclass of a preimage. Raph Levien remarks: "Likely this could be proved directly, and ~ fvimacnv would be the special case of ` A ` being a singleton, but it works this way round too." (Contributed by Raph Levien, 20-Nov-2006.)
theorem funimass3 (A2 B2 F: class):
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wb (wss (cima F A2) B2) (wss A2 (cima (ccnv F) B2))) $;

--| A subclass of a preimage in terms of function values. (Contributed by NM, 15-May-2007.)
theorem funimass5 {x3: setvar} (A2 B2 F: class):
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wb (wss A2 (cima (ccnv F) B2)) (wral x3 (wcel (cfv (cv x3) F) B2) A2)) $;

--| Two ways of specifying that a function is constant on a subdomain. (Contributed by NM, 8-Mar-2007.)
theorem funconstss {x3: setvar} (A2 B2 F: class):
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wb (wral x3 (wceq (cfv (cv x3) F) B2) A2) (wss A2 (cima (ccnv F) (csn B2)))) $;

--| Membership in the preimage of a set under a function. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem elpreima (A2 B2 C F: class):
  $ wi (wfn F A2) (wb (wcel B2 (cima (ccnv F) C)) (wa (wcel B2 A2) (wcel (cfv B2 F) C))) $;

--| Membership in the preimage of a singleton, under a function. (Contributed by Mario Carneiro, 12-May-2014.) (Proof shortened by Mario Carneiro, 28-Apr-2015.)
theorem fniniseg (A2 B2 C F: class):
  $ wi (wfn F A2) (wb (wcel C (cima (ccnv F) (csn B2))) (wa (wcel C A2) (wceq (cfv C F) B2))) $;

--| Inverse images under functions expressed as abstractions. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem fncnvima2 {x3: setvar} (A2 B2 F: class):
  $ wi (wfn F A2) (wceq (cima (ccnv F) B2) (crab x3 (wcel (cfv (cv x3) F) B2) A2)) $;

--| Inverse point images under functions expressed as abstractions. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem fniniseg2 {x3: setvar} (A2 B2 F: class):
  $ wi (wfn F A2) (wceq (cima (ccnv F) (csn B2)) (crab x3 (wceq (cfv (cv x3) F) B2) A2)) $;

--| Support sets of functions expressed as abstractions. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem fnniniseg2 {x3: setvar} (A2 B2 F: class):
  $ wi (wfn F A2) (wceq (cima (ccnv F) (cdif cvv (csn B2))) (crab x3 (wne (cfv (cv x3) F) B2) A2)) $;

--| Existential quantification restricted to a support. (Contributed by Stefan O'Rear, 23-Mar-2015.)
theorem rexsupp {x3: setvar} (ph: wff x3) (A2 F: class) (Z: class x3):
  $ wi (wfn F A2) (wb (wrex x3 ph (cima (ccnv F) (cdif cvv (csn Z)))) (wrex x3 (wa (wne (cfv (cv x3) F) Z) ph) A2)) $;

--| Preimage of a union. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem unpreima (A2 B2 F: class):
  $ wi (wfun F) (wceq (cima (ccnv F) (cun A2 B2)) (cun (cima (ccnv F) A2) (cima (ccnv F) B2))) $;

--| Preimage of an intersection. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 14-Jun-2016.)
theorem inpreima (A2 B2 F: class):
  $ wi (wfun F) (wceq (cima (ccnv F) (cin A2 B2)) (cin (cima (ccnv F) A2) (cima (ccnv F) B2))) $;

--| Preimage of a difference. (Contributed by Mario Carneiro, 14-Jun-2016.)
theorem difpreima (A2 B2 F: class):
  $ wi (wfun F) (wceq (cima (ccnv F) (cdif A2 B2)) (cdif (cima (ccnv F) A2) (cima (ccnv F) B2))) $;

--| The preimage of a restricted function. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem respreima (A2 B2 F: class):
  $ wi (wfun F) (wceq (cima (ccnv (cres F B2)) A2) (cin (cima (ccnv F) A2) B2)) $;

--| The preimage of the codomain of a mapping is the mapping's domain. (Contributed by FL, 25-Jan-2007.)
theorem fimacnv (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wceq (cima (ccnv F) B2) A2) $;

--| Ordered pair with function value. Part of Theorem 4.3(i) of [Monk1] p. 41. (Contributed by NM, 30-Sep-2004.)
theorem fnopfv (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wcel B2 A2)) (wcel (cop B2 (cfv B2 F)) F) $;

--| A function's value belongs to its range. (Contributed by NM, 14-Oct-1996.)
theorem fvelrn (A2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cdm F))) (wcel (cfv A2 F) (crn F)) $;

--| A function's value belongs to its range. (Contributed by NM, 15-Oct-1996.)
theorem fnfvelrn (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wcel B2 A2)) (wcel (cfv B2 F) (crn F)) $;

--| A function's value belongs to its codomain. (Contributed by NM, 12-Aug-1999.)
theorem ffvelrn (A2 B2 C F: class):
  $ wi (wa (wf A2 B2 F) (wcel C A2)) (wcel (cfv C F) B2) $;

--| A function's value belongs to its codomain. (Contributed by NM, 6-Apr-2005.)
theorem ffvelrni (A2 B2 C F: class):
  $ wf A2 B2 F $ >
  $ wi (wcel C A2) (wcel (cfv C F) B2) $;

--| A function's value belongs to its codomain. (Contributed by Mario Carneiro, 29-Dec-2016.)
theorem ffvelrnda (ph: wff) (A2 B2 C F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi (wa ph (wcel C A2)) (wcel (cfv C F) B2) $;

--| A function's value belongs to its codomain. (Contributed by Mario Carneiro, 29-Dec-2016.)
theorem ffvelrnd (ph: wff) (A2 B2 C F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wcel C A2) $ >
  $ wi ph (wcel (cfv C F) B2) $;

--| Restricted existential quantification over the range of a function. (Contributed by Mario Carneiro, 24-Dec-2013.) (Revised by Mario Carneiro, 20-Aug-2014.)
theorem rexrn {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2 F: class):
  $ wi (wceq (cv x3) (cfv (cv y1) F)) (wb ph ps) $ >
  $ wi (wfn F A2) (wb (wrex x3 ph (crn F)) (wrex y1 ps A2)) $;

--| Restricted universal quantification over the range of a function. (Contributed by Mario Carneiro, 24-Dec-2013.) (Revised by Mario Carneiro, 20-Aug-2014.)
theorem ralrn {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2 F: class):
  $ wi (wceq (cv x3) (cfv (cv y1) F)) (wb ph ps) $ >
  $ wi (wfn F A2) (wb (wral x3 ph (crn F)) (wral y1 ps A2)) $;

--| For any element in the range of a function there is an element in the domain of the function for which the function value is the element of the range. (Contributed by Alexander van der Vekens, 8-Dec-2017.)
theorem elrnrexdm {x3: setvar} (F Y: class):
  $ wi (wfun F) (wi (wcel Y (crn F)) (wrex x3 (wceq Y (cfv (cv x3) F)) (cdm F))) $;

--| For any element in the range of a function there is an element in the domain of the function for which the function value is the element of the range. (Contributed by Alexander van der Vekens, 17-Dec-2017.)
theorem elrnrexdmb {x3: setvar} (F Y: class):
  $ wi (wfun F) (wb (wcel Y (crn F)) (wrex x3 (wceq Y (cfv (cv x3) F)) (cdm F))) $;

--| For any element in the domain of a function there is an element in the range of the function which is the function value for the element of the domain. (Contributed by Alexander van der Vekens, 8-Dec-2017.)
theorem eldmrexrn {x3: setvar} (F Y: class):
  $ wi (wfun F) (wi (wcel Y (cdm F)) (wrex x3 (wceq (cv x3) (cfv Y F)) (crn F))) $;

--| A restricted quantifier over an image set. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem ralrnmpt {x3 y1: setvar} (ps: wff y1) (ch: wff x3) (A2: class y1) (B2 F: class x3) (V: class x3 y1):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wral x3 (wcel B2 V) A2) (wb (wral y1 ps (crn F)) (wral x3 ch A2)) $;

--| A restricted quantifier over an image set. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem rexrnmpt {x3 y1: setvar} (ps: wff y1) (ch: wff x3) (A2: class y1) (B2 F: class x3) (V: class x3 y1):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wral x3 (wcel B2 V) A2) (wb (wrex y1 ps (crn F)) (wrex x3 ch A2)) $;

--| Alternate definition of a mapping. (Contributed by NM, 14-Nov-2007.)
theorem dff2 (A2 B2 F: class):
  $ wb (wf A2 B2 F) (wa (wfn F A2) (wss F (cxp A2 B2))) $;

--| Property of a mapping. (Contributed by Jim Kingdon, 4-Jan-2019.)
theorem dff3im {x3 y1: setvar} (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wa (wss F (cxp A2 B2)) (wral x3 (weu y1 (wbr (cv x3) (cv y1) F)) A2)) $;

--| Property of a mapping. (Contributed by Jim Kingdon, 4-Jan-2019.)
theorem dff4im {x3 y1: setvar} (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wa (wss F (cxp A2 B2)) (wral x3 (wreu y1 (wbr (cv x3) (cv y1) F) B2) A2)) $;

--| An onto mapping expressed in terms of function values. (Contributed by NM, 29-Oct-2006.)
theorem dffo3 {x3 y1: setvar} (A2 B2 F: class):
  $ wb (wfo A2 B2 F) (wa (wf A2 B2 F) (wral y1 (wrex x3 (wceq (cv y1) (cfv (cv x3) F)) A2) B2)) $;

--| Alternate definition of an onto mapping. (Contributed by NM, 20-Mar-2007.)
theorem dffo4 {x3 y1: setvar} (A2 B2 F: class):
  $ wb (wfo A2 B2 F) (wa (wf A2 B2 F) (wral y1 (wrex x3 (wbr (cv x3) (cv y1) F) A2) B2)) $;

--| Alternate definition of an onto mapping. (Contributed by NM, 20-Mar-2007.)
theorem dffo5 {x3 y1: setvar} (A2 B2 F: class):
  $ wb (wfo A2 B2 F) (wa (wf A2 B2 F) (wral y1 (wex x3 (wbr (cv x3) (cv y1) F)) B2)) $;

--| Property of a surjective function. (Contributed by Jeff Madsen, 4-Jan-2011.)
theorem foelrn {x3: setvar} (A2 B2 C F: class):
  $ wi (wa (wfo A2 B2 F) (wcel C B2)) (wrex x3 (wceq C (cfv (cv x3) F)) A2) $;

--| If a composition of two functions is surjective, then the function on the left is surjective. (Contributed by Jeff Madsen, 16-Jun-2011.)
theorem foco2 (A2 B2 C F G: class):
  $ wi (w3a (wf B2 C F) (wf A2 B2 G) (wfo A2 C (ccom F G))) (wfo B2 C F) $;

--| Functionality of the mapping operation. (Contributed by Mario Carneiro, 26-Jul-2013.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem fmpt {x3: setvar} (A2 B2: class) (C F: class x3):
  $ wceq F (cmpt x3 A2 C) $ >
  $ wb (wral x3 (wcel C B2) A2) (wf A2 B2 F) $;

--| Express bijection for a mapping operation. (Contributed by Mario Carneiro, 30-May-2015.) (Revised by Mario Carneiro, 4-Dec-2016.)
theorem f1ompt {x3 y1: setvar} (A2 B2: class) (C F: class x3):
  $ wceq F (cmpt x3 A2 C) $ >
  $ wb (wf1o A2 B2 F) (wa (wral x3 (wcel C B2) A2) (wral y1 (wreu x3 (wceq (cv y1) C) A2) B2)) $;

--| Functionality of the mapping operation. (Contributed by NM, 19-Mar-2005.) (Revised by Mario Carneiro, 1-Sep-2015.)
theorem fmpti {x3: setvar} (A2 B2: class) (C F: class x3):
  $ wceq F (cmpt x3 A2 C) $ >
  $ wi (wcel (cv x3) A2) (wcel C B2) $ >
  $ wf A2 B2 F $;

--| Domain and codomain of the mapping operation; deduction form. (Contributed by Mario Carneiro, 13-Jan-2013.)
theorem fmptd {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class) (F: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 C) $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi ph (wf A2 C F) $;

--| A function maps to a class to which all values belong. (Contributed by NM, 3-Dec-2003.)
theorem ffnfv {x3: setvar} (A2 B2 F: class):
  $ wb (wf A2 B2 F) (wa (wfn F A2) (wral x3 (wcel (cfv (cv x3) F) B2) A2)) $;

--| A function maps to a class to which all values belong. This version of ~ ffnfv uses bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 28-Sep-2006.)
theorem ffnfvf {x3: setvar} (A2 B2 F: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 F $ >
  $ wb (wf A2 B2 F) (wa (wfn F A2) (wral x3 (wcel (cfv (cv x3) F) B2) A2)) $;

--| An upper bound for range determined by function values. (Contributed by NM, 8-Oct-2004.)
theorem fnfvrnss {x3: setvar} (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wral x3 (wcel (cfv (cv x3) F) B2) A2)) (wss (crn F) B2) $;

--| The range of an operation given by the "maps to" notation as a subset. (Contributed by Thierry Arnoux, 24-Sep-2017.)
theorem rnmptss {x3: setvar} (A2: class) (B2: class x3) (C: class) (F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wral x3 (wcel B2 C) A2) (wss (crn F) C) $;

--| Domain and codomain of the mapping operation; deduction form. (Contributed by NM, 27-Dec-2014.)
theorem fmpt2d {x3 y1: setvar} (ph: wff) (A2: class) (B2: class x3 y1) (C F: class x3) (V: class x3 y1):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wceq F (cmpt x3 A2 B2)) $ >
  $ wi (wa ph (wcel (cv y1) A2)) (wcel (cfv (cv y1) F) C) $ >
  $ wi ph (wf A2 C F) $;

--| A necessary and sufficient condition for a restricted function. (Contributed by Mario Carneiro, 14-Nov-2013.)
theorem ffvresb {x3: setvar} (A2 B2 F: class):
  $ wi (wfun F) (wb (wf A2 B2 (cres F A2)) (wral x3 (wa (wcel (cv x3) (cdm F)) (wcel (cfv (cv x3) F) B2)) A2)) $;

--| Build a bijection between restricted abstract builders, given a bijection between the base classes, deduction version. (Contributed by Thierry Arnoux, 17-Aug-2018.)
theorem f1oresrab {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2 B2: class) (C: class x3) (F: class x3 y1):
  $ wceq F (cmpt x3 A2 C) $ >
  $ wi ph (wf1o A2 B2 F) $ >
  $ wi (w3a ph (wcel (cv x3) A2) (wceq (cv y1) C)) (wb ch ps) $ >
  $ wi ph (wf1o (crab x3 ps A2) (crab y1 ch B2) (cres F (crab x3 ps A2))) $;

--| Composition of two functions expressed as ordered-pair class abstractions. If ` F ` has the equation ( x + 2 ) and ` G ` the equation ( 3 * z ) then ` ( G o. F ) ` has the equation ( 3 * ( x + 2 ) ) . (Contributed by FL, 21-Jun-2012.) (Revised by Mario Carneiro, 24-Jul-2014.)
theorem fmptco {x3 y1: setvar} (ph: wff y1) (A2: class y1) (B2: class) (R: class x3) (S: class y1) (T: class x3) (F G: class x3 y1):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel R B2) $ >
  $ wi ph (wceq F (cmpt x3 A2 R)) $ >
  $ wi ph (wceq G (cmpt y1 B2 S)) $ >
  $ wi (wceq (cv y1) R) (wceq S T) $ >
  $ wi ph (wceq (ccom G F) (cmpt x3 A2 T)) $;

--| Version of ~ fmptco where ` ph ` needn't be distinct from ` x ` . (Contributed by NM, 27-Dec-2014.)
theorem fmptcof {x3 y1: setvar} (ph: wff x3 y1) (A2: class y1) (B2: class) (R: class x3) (S: class y1) (T: class x3) (F G: class x3 y1):
  $ wi ph (wral x3 (wcel R B2) A2) $ >
  $ wi ph (wceq F (cmpt x3 A2 R)) $ >
  $ wi ph (wceq G (cmpt y1 B2 S)) $ >
  $ wi (wceq (cv y1) R) (wceq S T) $ >
  $ wi ph (wceq (ccom G F) (cmpt x3 A2 T)) $;

--| Composition of two functions expressed as mapping abstractions. (Contributed by NM, 22-May-2006.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem fmptcos {x3 y1: setvar} (ph: wff x3 y1) (A2: class y1) (B2: class) (R: class x3) (S: class y1) (F G: class x3 y1):
  $ wi ph (wral x3 (wcel R B2) A2) $ >
  $ wi ph (wceq F (cmpt x3 A2 R)) $ >
  $ wi ph (wceq G (cmpt y1 B2 S)) $ >
  $ wi ph (wceq (ccom G F) (cmpt x3 A2 (csb y1 R S))) $;

--| Express composition of two functions as a maps-to applying both in sequence. (Contributed by Stefan O'Rear, 5-Oct-2014.) (Proof shortened by Mario Carneiro, 27-Dec-2014.)
theorem fcompt {x3: setvar} (A2 B2 C D E: class):
  $ wi (wa (wf D E A2) (wf C D B2)) (wceq (ccom A2 B2) (cmpt x3 C (cfv (cfv (cv x3) B2) A2))) $;

--| Composition with a constant function. (Contributed by Stefan O'Rear, 11-Mar-2015.)
theorem fcoconst (F I X Y: class):
  $ wi (wa (wfn F X) (wcel Y X)) (wceq (ccom F (cxp I (csn Y))) (cxp I (csn (cfv Y F)))) $;

--| A function maps a singleton to a singleton iff it is the singleton of an ordered pair. (Contributed by NM, 10-Dec-2003.)
theorem fsn (A2 B2 F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wf (csn A2) (csn B2) F) (wceq F (csn (cop A2 B2))) $;

--| A function maps a singleton to a singleton iff it is the singleton of an ordered pair. (Contributed by NM, 26-Oct-2012.)
theorem fsng (A2 B2 C D F: class):
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wb (wf (csn A2) (csn B2) F) (wceq F (csn (cop A2 B2)))) $;

--| A function that maps a singleton to a class is the singleton of an ordered pair. (Contributed by NM, 19-May-2004.)
theorem fsn2 (A2 B2 F: class):
  $ wcel A2 cvv $ >
  $ wb (wf (csn A2) B2 F) (wa (wcel (cfv A2 F) B2) (wceq F (csn (cop A2 (cfv A2 F))))) $;

--| The cross product of two singletons. (Contributed by Mario Carneiro, 30-Apr-2015.)
theorem xpsng (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (cxp (csn A2) (csn B2)) (csn (cop A2 B2))) $;

--| The cross product of two singletons. (Contributed by NM, 4-Nov-2006.)
theorem xpsn (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cxp (csn A2) (csn B2)) (csn (cop A2 B2)) $;

--| Alternate definition for the "maps to" notation ~ df-mpt (although it requires that ` B ` be a set). (Contributed by NM, 24-Aug-2010.) (Revised by Mario Carneiro, 30-Dec-2016.)
theorem dfmpt {x3: setvar} (A2 B2: class x3):
  $ wcel B2 cvv $ >
  $ wceq (cmpt x3 A2 B2) (ciun x3 A2 (csn (cop (cv x3) B2))) $;

--| A function expressed as the range of another function. (Contributed by Mario Carneiro, 22-Jun-2013.) (Proof shortened by Mario Carneiro, 31-Aug-2015.)
theorem fnasrn {x3: setvar} (A2 B2: class x3):
  $ wcel B2 cvv $ >
  $ wceq (cmpt x3 A2 B2) (crn (cmpt x3 A2 (cop (cv x3) B2))) $;

--| Alternate definition for the "maps to" notation ~ df-mpt (which requires that ` B ` be a set). (Contributed by Jim Kingdon, 9-Jan-2019.)
theorem dfmptg {x3: setvar} (A2 B2 V: class x3):
  $ wi (wral x3 (wcel B2 V) A2) (wceq (cmpt x3 A2 B2) (ciun x3 A2 (csn (cop (cv x3) B2)))) $;

--| A function expressed as the range of another function. (Contributed by Jim Kingdon, 9-Jan-2019.)
theorem fnasrng {x3: setvar} (A2 B2 V: class x3):
  $ wi (wral x3 (wcel B2 V) A2) (wceq (cmpt x3 A2 B2) (crn (cmpt x3 A2 (cop (cv x3) B2)))) $;

--| If ` A ` is not in ` C ` , then the restriction of a singleton of ` <. A , B >. ` to ` C ` is null. (Contributed by Scott Fenton, 15-Apr-2011.)
theorem ressnop0 (A2 B2 C: class):
  $ wi (wn (wcel A2 C)) (wceq (cres (csn (cop A2 B2)) C) c0) $;

--| A function with a domain of two elements. (Contributed by Jeff Madsen, 20-Jun-2010.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem fpr (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wi (wne A2 B2) (wf (cpr A2 B2) (cpr C D) (cpr (cop A2 C) (cop B2 D))) $;

--| A function with a domain of two elements. (Contributed by FL, 2-Feb-2014.)
theorem fprg (A2 B2 C D E F G H: class):
  $ wi (w3a (wa (wcel A2 E) (wcel B2 F)) (wa (wcel C G) (wcel D H)) (wne A2 B2)) (wf (cpr A2 B2) (cpr C D) (cpr (cop A2 C) (cop B2 D))) $;

--| A function with a domain of three elements. (Contributed by Alexander van der Vekens, 4-Dec-2017.)
theorem ftpg (A2 B2 C U F G H V W X Y Z: class):
  $ wi (w3a (w3a (wcel X U) (wcel Y V) (wcel Z W)) (w3a (wcel A2 F) (wcel B2 G) (wcel C H)) (w3a (wne X Y) (wne X Z) (wne Y Z))) (wf (ctp X Y Z) (ctp A2 B2 C) (ctp (cop X A2) (cop Y B2) (cop Z C))) $;

--| A function with a domain of three elements. (Contributed by Stefan O'Rear, 17-Oct-2014.) (Proof shortened by Alexander van der Vekens, 23-Jan-2018.)
theorem ftp (A2 B2 C X Y Z: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel X cvv $ >
  $ wcel Y cvv $ >
  $ wcel Z cvv $ >
  $ wne A2 B2 $ >
  $ wne A2 C $ >
  $ wne B2 C $ >
  $ wf (ctp A2 B2 C) (ctp X Y Z) (ctp (cop A2 X) (cop B2 Y) (cop C Z)) $;

--| A function restricted to a singleton. (Contributed by NM, 9-Oct-2004.)
theorem fnressn (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wcel B2 A2)) (wceq (cres F (csn B2)) (csn (cop B2 (cfv B2 F)))) $;

--| The value of a function restricted to a singleton. (Contributed by NM, 9-Oct-2004.)
theorem fressnfv (A2 B2 C F: class):
  $ wi (wa (wfn F A2) (wcel B2 A2)) (wb (wf (csn B2) C (cres F (csn B2))) (wcel (cfv B2 F) C)) $;

--| The value of a constant function. (Contributed by NM, 30-May-1999.)
theorem fvconst (A2 B2 C F: class):
  $ wi (wa (wf A2 (csn B2) F) (wcel C A2)) (wceq (cfv C F) B2) $;

--| Express a singleton function in maps-to notation. (Contributed by NM, 6-Jun-2006.) (Proof shortened by Andrew Salmon, 22-Oct-2011.) (Revised by Stefan O'Rear, 28-Feb-2015.)
theorem fmptsn {x3: setvar} (A2 B2: class) (V W: class x3):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (csn (cop A2 B2)) (cmpt x3 (csn A2) B2)) $;

--| Append an additional value to a function. (Contributed by NM, 6-Jun-2006.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem fmptap {x3: setvar} (A2 B2: class) (C: class x3) (R S: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cun R (csn A2)) S $ >
  $ wi (wceq (cv x3) A2) (wceq C B2) $ >
  $ wceq (cun (cmpt x3 R C) (csn (cop A2 B2))) (cmpt x3 S C) $;

--| Append an additional value to a function. (Contributed by Thierry Arnoux, 3-Jan-2017.)
theorem fmptapd {x3: setvar} (ph: wff) (A2 B2: class) (C: class x3) (R S: class):
  $ wi ph (wcel A2 cvv) $ >
  $ wi ph (wcel B2 cvv) $ >
  $ wi ph (wceq (cun R (csn A2)) S) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq C B2) $ >
  $ wi ph (wceq (cun (cmpt x3 R C) (csn (cop A2 B2))) (cmpt x3 S C)) $;

--| Express a pair function in maps-to notation. (Contributed by Thierry Arnoux, 3-Jan-2017.)
theorem fmptpr {x3: setvar} (ph: wff) (A2 B2 C D: class) (E V W X Y: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wcel D Y) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq E C) $ >
  $ wi (wa ph (wceq (cv x3) B2)) (wceq E D) $ >
  $ wi ph (wceq (cpr (cop A2 C) (cop B2 D)) (cmpt x3 (cpr A2 B2) E)) $;

--| The value of a restricted identity function. (Contributed by NM, 19-May-2004.)
theorem fvresi (A2 B2: class):
  $ wi (wcel B2 A2) (wceq (cfv B2 (cres cid A2)) B2) $;

--| Remove an ordered pair not participating in a function value. (Contributed by Jim Kingdon, 7-Jan-2019.)
theorem fvunsng (A2 B2 C D V: class):
  $ wi (wa (wcel D V) (wne B2 D)) (wceq (cfv D (cun A2 (csn (cop B2 C)))) (cfv D A2)) $;

--| The value of a singleton of an ordered pair is the second member. (Contributed by NM, 12-Aug-1994.)
theorem fvsn (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cfv A2 (csn (cop A2 B2))) B2 $;

--| The value of a singleton of an ordered pair is the second member. (Contributed by NM, 26-Oct-2012.)
theorem fvsng (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (cfv A2 (csn (cop A2 B2))) B2) $;

--| The value of a function with one of its ordered pairs replaced, at the replaced ordered pair. See also ~ fvsnun2 . (Contributed by NM, 23-Sep-2007.)
theorem fvsnun1 (A2 B2 C F G: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq G (cun (csn (cop A2 B2)) (cres F (cdif C (csn A2)))) $ >
  $ wceq (cfv A2 G) B2 $;

--| The value of a function with one of its ordered pairs replaced, at arguments other than the replaced one. See also ~ fvsnun1 . (Contributed by NM, 23-Sep-2007.)
theorem fvsnun2 (A2 B2 C D F G: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq G (cun (csn (cop A2 B2)) (cres F (cdif C (csn A2)))) $ >
  $ wi (wcel D (cdif C (csn A2))) (wceq (cfv D G) (cfv D F)) $;

--| Adjoining a point to a function gives a function. (Contributed by Stefan O'Rear, 28-Feb-2015.)
theorem fsnunf (S T F V X Y: class):
  $ wi (w3a (wf S T F) (wa (wcel X V) (wn (wcel X S))) (wcel Y T)) (wf (cun S (csn X)) T (cun F (csn (cop X Y)))) $;

--| Recover the added point from a point-added function. (Contributed by Stefan O'Rear, 28-Feb-2015.) (Revised by NM, 18-May-2017.)
theorem fsnunfv (F V W X Y: class):
  $ wi (w3a (wcel X V) (wcel Y W) (wn (wcel X (cdm F)))) (wceq (cfv X (cun F (csn (cop X Y)))) Y) $;

--| Recover the original function from a point-added function. (Contributed by Stefan O'Rear, 28-Feb-2015.)
theorem fsnunres (S F X Y: class):
  $ wi (wa (wfn F S) (wn (wcel X S))) (wceq (cres (cun F (csn (cop X Y))) S) F) $;

--| The value of a function with a domain of two elements. (Contributed by Jeff Madsen, 20-Jun-2010.)
theorem fvpr1 (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel C cvv $ >
  $ wi (wne A2 B2) (wceq (cfv A2 (cpr (cop A2 C) (cop B2 D))) C) $;

--| The value of a function with a domain of two elements. (Contributed by Jeff Madsen, 20-Jun-2010.)
theorem fvpr2 (A2 B2 C D: class):
  $ wcel B2 cvv $ >
  $ wcel D cvv $ >
  $ wi (wne A2 B2) (wceq (cfv B2 (cpr (cop A2 C) (cop B2 D))) D) $;

--| The value of a function with a domain of (at most) two elements. (Contributed by Alexander van der Vekens, 3-Dec-2017.)
theorem fvpr1g (A2 B2 C D V W: class):
  $ wi (w3a (wcel A2 V) (wcel C W) (wne A2 B2)) (wceq (cfv A2 (cpr (cop A2 C) (cop B2 D))) C) $;

--| The value of a function with a domain of (at most) two elements. (Contributed by Alexander van der Vekens, 3-Dec-2017.)
theorem fvpr2g (A2 B2 C D V W: class):
  $ wi (w3a (wcel B2 V) (wcel D W) (wne A2 B2)) (wceq (cfv B2 (cpr (cop A2 C) (cop B2 D))) D) $;

--| The value of a function with a domain of (at most) three elements. (Contributed by Alexander van der Vekens, 4-Dec-2017.)
theorem fvtp1g (A2 B2 C D E F V W: class):
  $ wi (wa (wa (wcel A2 V) (wcel D W)) (wa (wne A2 B2) (wne A2 C))) (wceq (cfv A2 (ctp (cop A2 D) (cop B2 E) (cop C F))) D) $;

--| The value of a function with a domain of (at most) three elements. (Contributed by Alexander van der Vekens, 4-Dec-2017.)
theorem fvtp2g (A2 B2 C D E F V W: class):
  $ wi (wa (wa (wcel B2 V) (wcel E W)) (wa (wne A2 B2) (wne B2 C))) (wceq (cfv B2 (ctp (cop A2 D) (cop B2 E) (cop C F))) E) $;

--| The value of a function with a domain of (at most) three elements. (Contributed by Alexander van der Vekens, 4-Dec-2017.)
theorem fvtp3g (A2 B2 C D E F V W: class):
  $ wi (wa (wa (wcel C V) (wcel F W)) (wa (wne A2 C) (wne B2 C))) (wceq (cfv C (ctp (cop A2 D) (cop B2 E) (cop C F))) F) $;

--| The first value of a function with a domain of three elements. (Contributed by NM, 14-Sep-2011.)
theorem fvtp1 (A2 B2 C D E F: class):
  $ wcel A2 cvv $ >
  $ wcel D cvv $ >
  $ wi (wa (wne A2 B2) (wne A2 C)) (wceq (cfv A2 (ctp (cop A2 D) (cop B2 E) (cop C F))) D) $;

--| The second value of a function with a domain of three elements. (Contributed by NM, 14-Sep-2011.)
theorem fvtp2 (A2 B2 C D E F: class):
  $ wcel B2 cvv $ >
  $ wcel E cvv $ >
  $ wi (wa (wne A2 B2) (wne B2 C)) (wceq (cfv B2 (ctp (cop A2 D) (cop B2 E) (cop C F))) E) $;

--| The third value of a function with a domain of three elements. (Contributed by NM, 14-Sep-2011.)
theorem fvtp3 (A2 B2 C D E F: class):
  $ wcel C cvv $ >
  $ wcel F cvv $ >
  $ wi (wa (wne A2 C) (wne B2 C)) (wceq (cfv C (ctp (cop A2 D) (cop B2 E) (cop C F))) F) $;

--| The value of a constant function. (Contributed by NM, 20-Aug-2005.)
theorem fvconst2g (A2 B2 C D: class):
  $ wi (wa (wcel B2 D) (wcel C A2)) (wceq (cfv C (cxp A2 (csn B2))) B2) $;

--| A constant function expressed as a cross product. (Contributed by NM, 27-Nov-2007.)
theorem fconst2g (A2 B2 C F: class):
  $ wi (wcel B2 C) (wb (wf A2 (csn B2) F) (wceq F (cxp A2 (csn B2)))) $;

--| The value of a constant function. (Contributed by NM, 16-Apr-2005.)
theorem fvconst2 (A2 B2 C: class):
  $ wcel B2 cvv $ >
  $ wi (wcel C A2) (wceq (cfv C (cxp A2 (csn B2))) B2) $;

--| A constant function expressed as a cross product. (Contributed by NM, 20-Aug-1999.)
theorem fconst2 (A2 B2 F: class):
  $ wcel B2 cvv $ >
  $ wb (wf A2 (csn B2) F) (wceq F (cxp A2 (csn B2))) $;

--| A constant function expressed in terms of its functionality, domain, and value. See also ~ fconst2 . (Contributed by Jim Kingdon, 8-Jan-2019.)
theorem fconstfvm {x3 y1: setvar} (A2: class) (B2 F: class y1):
  $ wi (wex y1 (wcel (cv y1) A2)) (wb (wf A2 (csn B2) F) (wa (wfn F A2) (wral x3 (wceq (cfv (cv x3) F) B2) A2))) $;

--| Two ways to express a constant function. (Contributed by Jim Kingdon, 8-Jan-2019.)
theorem fconst3m {x3: setvar} (A2: class) (B2 F: class x3):
  $ wi (wex x3 (wcel (cv x3) A2)) (wb (wf A2 (csn B2) F) (wa (wfn F A2) (wss A2 (cima (ccnv F) (csn B2))))) $;

--| Two ways to express a constant function. (Contributed by NM, 8-Mar-2007.)
theorem fconst4m {x3: setvar} (A2: class) (B2 F: class x3):
  $ wi (wex x3 (wcel (cv x3) A2)) (wb (wf A2 (csn B2) F) (wa (wfn F A2) (wceq (cima (ccnv F) (csn B2)) A2))) $;

--| The restriction of a function to a set exists. Compare Proposition 6.17 of [TakeutiZaring] p. 28. (Contributed by NM, 7-Apr-1995.) (Revised by Mario Carneiro, 22-Jun-2013.)
theorem resfunexg (A2 B2 C: class):
  $ wi (wa (wfun A2) (wcel B2 C)) (wcel (cres A2 B2) cvv) $;

--| If the domain of a function is a set, the function is a set. Theorem 6.16(1) of [TakeutiZaring] p. 28. This theorem is derived using the Axiom of Replacement in the form of ~ resfunexg . (Contributed by NM, 14-Aug-1994.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fnex (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wcel A2 B2)) (wcel F cvv) $;

--| If the domain of a function exists, so the function. Part of Theorem 4.15(v) of [Monk1] p. 46. This theorem is derived using the Axiom of Replacement in the form of ~ fnex . (Note: Any resemblance between F.U.N.E.X. and "Have You Any Eggs" is purely a coincidence originated by Swedish chefs.) (Contributed by NM, 11-Nov-1995.)
theorem funex (B2 F: class):
  $ wi (wa (wfun F) (wcel (cdm F) B2)) (wcel F cvv) $;

--| Existence of a function expressed as class of ordered pairs. (Contributed by NM, 21-Jul-1996.)
theorem opabex {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wcel (cv x3) A2) (wmo y1 ph) $ >
  $ wcel (copab x3 y1 (wa (wcel (cv x3) A2) ph)) cvv $;

--| If the domain of a function given by maps-to notation is a set, the function is a set. (Contributed by FL, 6-Jun-2011.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem mptexg {x3: setvar} (A2: class) (B2 V: class x3):
  $ wi (wcel A2 V) (wcel (cmpt x3 A2 B2) cvv) $;

--| If the domain of a function given by maps-to notation is a set, the function is a set. (Contributed by NM, 22-Apr-2005.) (Revised by Mario Carneiro, 20-Dec-2013.)
theorem mptex {x3: setvar} (A2: class) (B2: class x3):
  $ wcel A2 cvv $ >
  $ wcel (cmpt x3 A2 B2) cvv $;

--| If the domain of a mapping is a set, the function is a set. (Contributed by NM, 3-Oct-1999.)
theorem fex (A2 B2 C F: class):
  $ wi (wa (wf A2 B2 F) (wcel A2 C)) (wcel F cvv) $;

--| A function is uniquely determined by its values. (Contributed by NM, 31-Aug-2011.)
theorem eufnfv {x3 f2: setvar} (A2: class) (B2: class x3):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ weu f2 (wa (wfn (cv f2) A2) (wral x3 (wceq (cfv (cv x3) (cv f2)) B2) A2)) $;

--| A function's value in a preimage belongs to the image. (Contributed by NM, 23-Sep-2003.)
theorem funfvima (A2 B2 F: class):
  $ wi (wa (wfun F) (wcel B2 (cdm F))) (wi (wcel B2 A2) (wcel (cfv B2 F) (cima F A2))) $;

--| A function's value in an included preimage belongs to the image. (Contributed by NM, 3-Feb-1997.)
theorem funfvima2 (A2 B2 F: class):
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wi (wcel B2 A2) (wcel (cfv B2 F) (cima F A2))) $;

--| A class including a function contains the function's value in the image of the singleton of the argument. (Contributed by NM, 23-Mar-2004.)
theorem funfvima3 (A2 F G: class):
  $ wi (wa (wfun F) (wss F G)) (wi (wcel A2 (cdm F)) (wcel (cfv A2 F) (cima G (csn A2)))) $;

--| The function value of an operand in a set is contained in the image of that set, using the ` Fn ` abbreviation. (Contributed by Stefan O'Rear, 10-Mar-2015.)
theorem fnfvima (A2 S F X: class):
  $ wi (w3a (wfn F A2) (wss S A2) (wcel X S)) (wcel (cfv X F) (cima F S)) $;

--| Existential quantification under an image in terms of the base set. (Contributed by Stefan O'Rear, 21-Jan-2015.)
theorem rexima {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2 B2 F: class):
  $ wi (wceq (cv x3) (cfv (cv y1) F)) (wb ph ps) $ >
  $ wi (wa (wfn F A2) (wss B2 A2)) (wb (wrex x3 ph (cima F B2)) (wrex y1 ps B2)) $;

--| Universal quantification under an image in terms of the base set. (Contributed by Stefan O'Rear, 21-Jan-2015.)
theorem ralima {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2 B2 F: class):
  $ wi (wceq (cv x3) (cfv (cv y1) F)) (wb ph ps) $ >
  $ wi (wa (wfn F A2) (wss B2 A2)) (wb (wral x3 ph (cima F B2)) (wral y1 ps B2)) $;

--| TODO: This is the same as ~ issref (which has a much longer proof). Should we replace ~ issref with this one? - NM 9-May-2016. Two ways to state a relation is reflexive. (Adapted from Tarski.) (Contributed by FL, 15-Jan-2012.) (Proof shortened by Mario Carneiro, 3-Nov-2015.) (Proof modification is discouraged.)
theorem idref {x3: setvar} (A2 R: class):
  $ wb (wss (cres cid A2) R) (wral x3 (wbr (cv x3) (cv x3) R) A2) $;

--| Elementhood in an image set. (Contributed by Mario Carneiro, 14-Jan-2014.)
theorem elabrex {x3 y1: setvar} (A2: class) (B2: class x3):
  $ wcel B2 cvv $ >
  $ wi (wcel (cv x3) A2) (wcel B2 (cab y1 (wrex x3 (wceq (cv y1) B2) A2))) $;

--| Composition of two image maps ` C ( y ) ` and ` B ( w ) ` . (Contributed by NM, 27-May-2013.)
theorem abrexco {x3 y1 z w: setvar} (A2 B2: class x3 w) (C: class x3 y1 z) (D: class x3 z w):
  $ wcel B2 cvv $ >
  $ wi (wceq (cv y1) B2) (wceq C D) $ >
  $ wceq (cab x3 (wrex y1 (wceq (cv x3) C) (cab z (wrex w (wceq (cv z) B2) A2)))) (cab x3 (wrex w (wceq (cv x3) D) A2)) $;

--| The image of an indexed union is the indexed union of the images. (Contributed by Mario Carneiro, 18-Jun-2014.)
theorem imaiun {x3: setvar} (A2: class) (B2 C: class x3):
  $ wceq (cima A2 (ciun x3 B2 C)) (ciun x3 B2 (cima A2 C)) $;

--| The image of a union is the indexed union of the images. Theorem 3K(a) of [Enderton] p. 50. (Contributed by NM, 9-Aug-2004.) (Proof shortened by Mario Carneiro, 18-Jun-2014.)
theorem imauni {x3: setvar} (A2 B2: class):
  $ wceq (cima A2 (cuni B2)) (ciun x3 B2 (cima A2 (cv x3))) $;

--| The indexed union of a function's values is the union of its range. Compare Definition 5.4 of [Monk1] p. 50. (Contributed by NM, 27-Sep-2004.)
theorem fniunfv {x3: setvar} (A2 F: class):
  $ wi (wfn F A2) (wceq (ciun x3 A2 (cfv (cv x3) F)) (cuni (crn F))) $;

--| The indexed union of a function's values is the union of its image under the index class. This theorem is a slight variation of ~ fniunfv . (Contributed by Jim Kingdon, 10-Jan-2019.)
theorem funiunfvdm {x3: setvar} (A2 F: class):
  $ wi (wfn F A2) (wceq (ciun x3 A2 (cfv (cv x3) F)) (cuni (cima F A2))) $;

--| The indexed union of a function's values is the union of its image under the index class. This version of ~ funiunfvdm uses a bound-variable hypothesis in place of a distinct variable condition. (Contributed by Jim Kingdon, 10-Jan-2019.)
theorem funiunfvdmf {x3: setvar} (A2: class) (F: class x3):
  $ wnfc x3 F $ >
  $ wi (wfn F A2) (wceq (ciun x3 A2 (cfv (cv x3) F)) (cuni (cima F A2))) $;

--| Membership in the union of an image of a function. (Contributed by Jim Kingdon, 10-Jan-2019.)
theorem eluniimadm {x3: setvar} (A2 B2 F: class):
  $ wi (wfn F A2) (wb (wcel B2 (cuni (cima F A2))) (wrex x3 (wcel B2 (cfv (cv x3) F)) A2)) $;

--| Membership in the union of the range of a function. (Contributed by NM, 24-Sep-2006.)
theorem elunirn {x3: setvar} (A2 F: class):
  $ wi (wfun F) (wb (wcel A2 (cuni (crn F))) (wrex x3 (wcel A2 (cfv (cv x3) F)) (cdm F))) $;

--| Membership in a union of some function-defined family of sets. (Contributed by Stefan O'Rear, 30-Jan-2015.)
theorem fnunirn {x3: setvar} (A2 F I: class):
  $ wi (wfn F I) (wb (wcel A2 (cuni (crn F))) (wrex x3 (wcel A2 (cfv (cv x3) F)) I)) $;

--| A one-to-one function in terms of function values. Compare Theorem 4.8(iv) of [Monk1] p. 43. (Contributed by NM, 29-Oct-1996.)
theorem dff13 {x3 y1: setvar} (A2: class) (B2: class x3 y1) (F: class):
  $ wb (wf1 A2 B2 F) (wa (wf A2 B2 F) (wral x3 (wral y1 (wi (wceq (cfv (cv x3) F) (cfv (cv y1) F)) (wceq (cv x3) (cv y1))) A2) A2)) $;

--| If the values of a one-to-one function for two arguments are equal, the arguments themselves must be equal. (Contributed by Alexander van der Vekens, 12-Nov-2017.)
theorem f1veqaeq (A2 B2 C D F: class):
  $ wi (wa (wf1 A2 B2 F) (wa (wcel C A2) (wcel D A2))) (wi (wceq (cfv C F) (cfv D F)) (wceq C D)) $;

--| A one-to-one function in terms of function values. Compare Theorem 4.8(iv) of [Monk1] p. 43. (Contributed by NM, 31-Jul-2003.)
theorem dff13f {x3 y1: setvar} (A2: class) (B2 F: class x3 y1):
  $ wnfc x3 F $ >
  $ wnfc y1 F $ >
  $ wb (wf1 A2 B2 F) (wa (wf A2 B2 F) (wral x3 (wral y1 (wi (wceq (cfv (cv x3) F) (cfv (cv y1) F)) (wceq (cv x3) (cv y1))) A2) A2)) $;

--| Express injection for a mapping operation. (Contributed by Mario Carneiro, 2-Jan-2017.)
theorem f1mpt {x3 y1: setvar} (A2 B2: class) (C: class x3) (D: class y1) (F: class x3):
  $ wceq F (cmpt x3 A2 C) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq C D) $ >
  $ wb (wf1 A2 B2 F) (wa (wral x3 (wcel C B2) A2) (wral x3 (wral y1 (wi (wceq C D) (wceq (cv x3) (cv y1))) A2) A2)) $;

--| Equality of function values for a one-to-one function. (Contributed by NM, 11-Feb-1997.)
theorem f1fveq (A2 B2 C D F: class):
  $ wi (wa (wf1 A2 B2 F) (wa (wcel C A2) (wcel D A2))) (wb (wceq (cfv C F) (cfv D F)) (wceq C D)) $;

--| Membership in the image of a 1-1 map. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem f1elima (A2 B2 F X Y: class):
  $ wi (w3a (wf1 A2 B2 F) (wcel X A2) (wss Y A2)) (wb (wcel (cfv X F) (cima F Y)) (wcel X Y)) $;

--| Taking images under a one-to-one function preserves subsets. (Contributed by Stefan O'Rear, 30-Oct-2014.)
theorem f1imass (A2 B2 C D F: class):
  $ wi (wa (wf1 A2 B2 F) (wa (wss C A2) (wss D A2))) (wb (wss (cima F C) (cima F D)) (wss C D)) $;

--| Taking images under a one-to-one function preserves equality. (Contributed by Stefan O'Rear, 30-Oct-2014.)
theorem f1imaeq (A2 B2 C D F: class):
  $ wi (wa (wf1 A2 B2 F) (wa (wss C A2) (wss D A2))) (wb (wceq (cima F C) (cima F D)) (wceq C D)) $;

--| Taking images under a one-to-one function preserves proper subsets. (Contributed by Stefan O'Rear, 30-Oct-2014.)
theorem f1imapss (A2 B2 C D F: class):
  $ wi (wa (wf1 A2 B2 F) (wa (wss C A2) (wss D A2))) (wb (wpss (cima F C) (cima F D)) (wpss C D)) $;

--| A one-to-one onto function in terms of function values. (Contributed by NM, 29-Mar-2008.)
theorem dff1o6 {x3 y1: setvar} (A2: class) (B2: class x3 y1) (F: class):
  $ wb (wf1o A2 B2 F) (w3a (wfn F A2) (wceq (crn F) B2) (wral x3 (wral y1 (wi (wceq (cfv (cv x3) F) (cfv (cv y1) F)) (wceq (cv x3) (cv y1))) A2) A2)) $;

--| The converse value of the value of a one-to-one onto function. (Contributed by NM, 20-May-2004.)
theorem f1ocnvfv1 (A2 B2 C F: class):
  $ wi (wa (wf1o A2 B2 F) (wcel C A2)) (wceq (cfv (cfv C F) (ccnv F)) C) $;

--| The value of the converse value of a one-to-one onto function. (Contributed by NM, 20-May-2004.)
theorem f1ocnvfv2 (A2 B2 C F: class):
  $ wi (wa (wf1o A2 B2 F) (wcel C B2)) (wceq (cfv (cfv C (ccnv F)) F) C) $;

--| Relationship between the value of a one-to-one onto function and the value of its converse. (Contributed by Raph Levien, 10-Apr-2004.)
theorem f1ocnvfv (A2 B2 C D F: class):
  $ wi (wa (wf1o A2 B2 F) (wcel C A2)) (wi (wceq (cfv C F) D) (wceq (cfv D (ccnv F)) C)) $;

--| Relationship between the value of a one-to-one onto function and the value of its converse. (Contributed by NM, 20-May-2004.)
theorem f1ocnvfvb (A2 B2 C D F: class):
  $ wi (w3a (wf1o A2 B2 F) (wcel C A2) (wcel D B2)) (wb (wceq (cfv C F) D) (wceq (cfv D (ccnv F)) C)) $;

--| The value of the converse of a one-to-one onto function belongs to its domain. (Contributed by NM, 26-May-2006.)
theorem f1ocnvdm (A2 B2 C F: class):
  $ wi (wa (wf1o A2 B2 F) (wcel C B2)) (wcel (cfv C (ccnv F)) A2) $;

--| If the values of a one-to-one function for two arguments from the range of the function are equal, the arguments themselves must be equal. (Contributed by Alexander van der Vekens, 12-Nov-2017.)
theorem f1ocnvfvrneq (A2 B2 C D F: class):
  $ wi (wa (wf1 A2 B2 F) (wa (wcel C (crn F)) (wcel D (crn F)))) (wi (wceq (cfv C (ccnv F)) (cfv D (ccnv F))) (wceq C D)) $;

--| An application is injective if a retraction exists. Proposition 8 of [BourbakiEns] p. E.II.18. (Contributed by FL, 11-Nov-2011.) (Revised by Mario Carneiro, 27-Dec-2014.)
theorem fcof1 (A2 B2 R F: class):
  $ wi (wa (wf A2 B2 F) (wceq (ccom R F) (cres cid A2))) (wf1 A2 B2 F) $;

--| An application is surjective if a section exists. Proposition 8 of [BourbakiEns] p. E.II.18. (Contributed by FL, 17-Nov-2011.) (Proof shortened by Mario Carneiro, 27-Dec-2014.)
theorem fcofo (A2 B2 S F: class):
  $ wi (w3a (wf A2 B2 F) (wf B2 A2 S) (wceq (ccom F S) (cres cid B2))) (wfo A2 B2 F) $;

--| Change bound variable between domain and range of function. (Contributed by NM, 23-Feb-1997.) (Proof shortened by Mario Carneiro, 21-Mar-2015.)
theorem cbvfo {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class) (B2: class x3) (F: class):
  $ wi (wceq (cfv (cv x3) F) (cv y1)) (wb ph ps) $ >
  $ wi (wfo A2 B2 F) (wb (wral x3 ph A2) (wral y1 ps B2)) $;

--| Change bound variable between domain and range of function. (Contributed by NM, 23-Feb-1997.)
theorem cbvexfo {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class) (B2: class x3) (F: class):
  $ wi (wceq (cfv (cv x3) F) (cv y1)) (wb ph ps) $ >
  $ wi (wfo A2 B2 F) (wb (wrex x3 ph A2) (wrex y1 ps B2)) $;

--| An injection is left-cancelable. (Contributed by FL, 2-Aug-2009.) (Revised by Mario Carneiro, 21-Mar-2015.)
theorem cocan1 (A2 B2 C F H K: class):
  $ wi (w3a (wf1 B2 C F) (wf A2 B2 H) (wf A2 B2 K)) (wb (wceq (ccom F H) (ccom F K)) (wceq H K)) $;

--| A surjection is right-cancelable. (Contributed by FL, 21-Nov-2011.) (Proof shortened by Mario Carneiro, 21-Mar-2015.)
theorem cocan2 (A2 B2 F H K: class):
  $ wi (w3a (wfo A2 B2 F) (wfn H B2) (wfn K B2)) (wb (wceq (ccom H F) (ccom K F)) (wceq H K)) $;

--| Show that two functions are inverse to each other by computing their compositions. (Contributed by Mario Carneiro, 21-Mar-2015.)
theorem fcof1o (A2 B2 F G: class):
  $ wi (wa (wa (wf A2 B2 F) (wf B2 A2 G)) (wa (wceq (ccom F G) (cres cid B2)) (wceq (ccom G F) (cres cid A2)))) (wa (wf1o A2 B2 F) (wceq (ccnv F) G)) $;

--| Condition for function equality in terms of vanishing of the composition with the converse. _EDITORIAL_: Is there a relation-algebraic proof of this? (Contributed by Stefan O'Rear, 12-Feb-2015.)
theorem foeqcnvco (A2 B2 F G: class):
  $ wi (wa (wfo A2 B2 F) (wfo A2 B2 G)) (wb (wceq F G) (wceq (ccom F (ccnv G)) (cres cid B2))) $;

--| Condition for function equality in terms of vanishing of the composition with the inverse. (Contributed by Stefan O'Rear, 12-Feb-2015.)
theorem f1eqcocnv (A2 B2 F G: class):
  $ wi (wa (wf1 A2 B2 F) (wf1 A2 B2 G)) (wb (wceq F G) (wceq (ccom (ccnv F) G) (cres cid A2))) $;

--| ` F ` , a function lift, is a subset of ` R X. S ` . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem fliftrel {x3: setvar} (ph: wff) (A2 B2: class x3) (R S: class) (F: class x3) (X: class):
  $ wceq F (crn (cmpt x3 X (cop A2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 R) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel B2 S) $ >
  $ wi ph (wss F (cxp R S)) $;

--| Elementhood in the relation ` F ` . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem fliftel {x3: setvar} (ph: wff) (A2 B2: class x3) (C D R S: class) (F: class x3) (X: class):
  $ wceq F (crn (cmpt x3 X (cop A2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 R) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel B2 S) $ >
  $ wi ph (wb (wbr C D F) (wrex x3 (wa (wceq C A2) (wceq D B2)) X)) $;

--| Elementhood in the relation ` F ` . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem fliftel1 {x3: setvar} (ph: wff) (A2 B2: class x3) (R S: class) (F: class x3) (X: class):
  $ wceq F (crn (cmpt x3 X (cop A2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 R) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel B2 S) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wbr A2 B2 F) $;

--| Converse of the relation ` F ` . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem fliftcnv {x3: setvar} (ph: wff) (A2 B2: class x3) (R S: class) (F: class x3) (X: class):
  $ wceq F (crn (cmpt x3 X (cop A2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 R) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel B2 S) $ >
  $ wi ph (wceq (ccnv F) (crn (cmpt x3 X (cop B2 A2)))) $;

--| The function ` F ` is the unique function defined by ` F `` A = B ` , provided that the well-definedness condition holds. (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem fliftfun {x3 y1: setvar} (ph: wff) (A2 B2: class x3) (C D: class y1) (R S: class) (F: class x3) (X: class):
  $ wceq F (crn (cmpt x3 X (cop A2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 R) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel B2 S) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 C) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 D) $ >
  $ wi ph (wb (wfun F) (wral x3 (wral y1 (wi (wceq A2 C) (wceq B2 D)) X) X)) $;

--| The function ` F ` is the unique function defined by ` F `` A = B ` , provided that the well-definedness condition holds. (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem fliftfund {x3 y1: setvar} (ph: wff) (A2 B2: class x3) (C D: class y1) (R S: class) (F: class x3) (X: class):
  $ wceq F (crn (cmpt x3 X (cop A2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 R) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel B2 S) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 C) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 D) $ >
  $ wi (wa ph (w3a (wcel (cv x3) X) (wcel (cv y1) X) (wceq A2 C))) (wceq B2 D) $ >
  $ wi ph (wfun F) $;

--| The function ` F ` is the unique function defined by ` F `` A = B ` , provided that the well-definedness condition holds. (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem fliftfuns {x3 y1 z: setvar} (ph: wff) (A2 B2: class x3) (R S: class) (F: class x3) (X: class):
  $ wceq F (crn (cmpt x3 X (cop A2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 R) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel B2 S) $ >
  $ wi ph (wb (wfun F) (wral y1 (wral z (wi (wceq (csb x3 (cv y1) A2) (csb x3 (cv z) A2)) (wceq (csb x3 (cv y1) B2) (csb x3 (cv z) B2))) X) X)) $;

--| The domain and range of the function ` F ` . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem fliftf {x3: setvar} (ph: wff) (A2 B2: class x3) (R S: class) (F: class x3) (X: class):
  $ wceq F (crn (cmpt x3 X (cop A2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 R) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel B2 S) $ >
  $ wi ph (wb (wfun F) (wf (crn (cmpt x3 X A2)) S F)) $;

--| The value of the function ` F ` . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem fliftval {x3: setvar} (ph: wff) (A2 B2: class x3) (C D R S: class) (F: class x3) (X Y: class):
  $ wceq F (crn (cmpt x3 X (cop A2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 R) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel B2 S) $ >
  $ wi (wceq (cv x3) Y) (wceq A2 C) $ >
  $ wi (wceq (cv x3) Y) (wceq B2 D) $ >
  $ wi ph (wfun F) $ >
  $ wi (wa ph (wcel Y X)) (wceq (cfv C F) D) $;

--| Equality theorem for isomorphisms. (Contributed by NM, 17-May-2004.)
theorem isoeq1 (A2 B2 R S G H: class):
  $ wi (wceq H G) (wb (wiso A2 B2 R S H) (wiso A2 B2 R S G)) $;

--| Equality theorem for isomorphisms. (Contributed by NM, 17-May-2004.)
theorem isoeq2 (A2 B2 R S T H: class):
  $ wi (wceq R T) (wb (wiso A2 B2 R S H) (wiso A2 B2 T S H)) $;

--| Equality theorem for isomorphisms. (Contributed by NM, 17-May-2004.)
theorem isoeq3 (A2 B2 R S T H: class):
  $ wi (wceq S T) (wb (wiso A2 B2 R S H) (wiso A2 B2 R T H)) $;

--| Equality theorem for isomorphisms. (Contributed by NM, 17-May-2004.)
theorem isoeq4 (A2 B2 C R S H: class):
  $ wi (wceq A2 C) (wb (wiso A2 B2 R S H) (wiso C B2 R S H)) $;

--| Equality theorem for isomorphisms. (Contributed by NM, 17-May-2004.)
theorem isoeq5 (A2 B2 C R S H: class):
  $ wi (wceq B2 C) (wb (wiso A2 B2 R S H) (wiso A2 C R S H)) $;

--| Bound-variable hypothesis builder for an isomorphism. (Contributed by NM, 17-May-2004.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem nfiso {x3: setvar} (A2 B2 R S H: class x3):
  $ wnfc x3 H $ >
  $ wnfc x3 R $ >
  $ wnfc x3 S $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wiso A2 B2 R S H) $;

--| An isomorphism is a one-to-one onto function. (Contributed by NM, 27-Apr-2004.)
theorem isof1o (A2 B2 R S H: class):
  $ wi (wiso A2 B2 R S H) (wf1o A2 B2 H) $;

--| An isomorphism connects binary relations via its function values. (Contributed by NM, 27-Apr-2004.)
theorem isorel (A2 B2 C D R S H: class):
  $ wi (wa (wiso A2 B2 R S H) (wa (wcel C A2) (wcel D A2))) (wb (wbr C D R) (wbr (cfv C H) (cfv D H) S)) $;

--| A consequence of isomorphism on two relations for a function's restriction. (Contributed by Jim Kingdon, 11-Jan-2019.)
theorem isoresbr {x3 y1: setvar} (A2 R S F: class):
  $ wi (wiso A2 (cima F A2) R S (cres F A2)) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) R) (wbr (cfv (cv x3) F) (cfv (cv y1) F) S)) A2) A2) $;

--| Identity law for isomorphism. Proposition 6.30(1) of [TakeutiZaring] p. 33. (Contributed by NM, 27-Apr-2004.)
theorem isoid (A2 R: class):
  $ wiso A2 A2 R R (cres cid A2) $;

--| Converse law for isomorphism. Proposition 6.30(2) of [TakeutiZaring] p. 33. (Contributed by NM, 27-Apr-2004.)
theorem isocnv (A2 B2 R S H: class):
  $ wi (wiso A2 B2 R S H) (wiso B2 A2 S R (ccnv H)) $;

--| Converse law for isomorphism. (Contributed by Mario Carneiro, 30-Jan-2014.)
theorem isocnv2 (A2 B2 R S H: class):
  $ wb (wiso A2 B2 R S H) (wiso A2 B2 (ccnv R) (ccnv S) H) $;

--| An isomorphism from one well-order to another can be restricted on either well-order. (Contributed by Mario Carneiro, 15-Jan-2013.)
theorem isores2 (A2 B2 R S H: class):
  $ wb (wiso A2 B2 R S H) (wiso A2 B2 R (cin S (cxp B2 B2)) H) $;

--| An isomorphism from one well-order to another can be restricted on either well-order. (Contributed by Mario Carneiro, 15-Jan-2013.)
theorem isores1 (A2 B2 R S H: class):
  $ wb (wiso A2 B2 R S H) (wiso A2 B2 (cin R (cxp A2 A2)) S H) $;

--| Induced isomorphism on a subset. (Contributed by Stefan O'Rear, 5-Nov-2014.)
theorem isores3 (A2 B2 R S H K X: class):
  $ wi (w3a (wiso A2 B2 R S H) (wss K A2) (wceq X (cima H K))) (wiso K X R S (cres H K)) $;

--| Composition (transitive) law for isomorphism. Proposition 6.30(3) of [TakeutiZaring] p. 33. (Contributed by NM, 27-Apr-2004.) (Proof shortened by Mario Carneiro, 5-Dec-2016.)
theorem isotr (A2 B2 C R S T G H: class):
  $ wi (wa (wiso A2 B2 R S H) (wiso B2 C S T G)) (wiso A2 C R T (ccom G H)) $;

--| Isomorphisms preserve initial segments. Proposition 6.31(2) of [TakeutiZaring] p. 33. (Contributed by NM, 20-Apr-2004.)
theorem isoini (A2 B2 D R S H: class):
  $ wi (wa (wiso A2 B2 R S H) (wcel D A2)) (wceq (cima H (cin A2 (cima (ccnv R) (csn D)))) (cin B2 (cima (ccnv S) (csn (cfv D H))))) $;

--| Isomorphisms are isomorphisms on their initial segments. (Contributed by Mario Carneiro, 29-Mar-2014.)
theorem isoini2 (A2 B2 C D R S H X: class):
  $ wceq C (cin A2 (cima (ccnv R) (csn X))) $ >
  $ wceq D (cin B2 (cima (ccnv S) (csn (cfv X H)))) $ >
  $ wi (wa (wiso A2 B2 R S H) (wcel X A2)) (wiso C D R S (cres H C)) $;

--| Lemma for ~ isose . (Contributed by Mario Carneiro, 23-Jun-2015.)
theorem isoselem {x3: setvar} (ph: wff) (A2 B2 R S H: class):
  $ wi ph (wiso A2 B2 R S H) $ >
  $ wi ph (wcel (cima H (cv x3)) cvv) $ >
  $ wi ph (wi (wse A2 R) (wse B2 S)) $;

--| An isomorphism preserves set-like relations. (Contributed by Mario Carneiro, 23-Jun-2015.)
theorem isose (A2 B2 R S H: class):
  $ wi (wiso A2 B2 R S H) (wb (wse A2 R) (wse B2 S)) $;

--| Lemma for ~ isopo . (Contributed by Stefan O'Rear, 16-Nov-2014.)
theorem isopolem (A2 B2 R S H: class):
  $ wi (wiso A2 B2 R S H) (wi (wpo B2 S) (wpo A2 R)) $;

--| An isomorphism preserves partial ordering. (Contributed by Stefan O'Rear, 16-Nov-2014.)
theorem isopo (A2 B2 R S H: class):
  $ wi (wiso A2 B2 R S H) (wb (wpo A2 R) (wpo B2 S)) $;

--| Lemma for ~ isoso . (Contributed by Stefan O'Rear, 16-Nov-2014.)
theorem isosolem (A2 B2 R S H: class):
  $ wi (wiso A2 B2 R S H) (wi (wor B2 S) (wor A2 R)) $;

--| An isomorphism preserves strict ordering. (Contributed by Stefan O'Rear, 16-Nov-2014.)
theorem isoso (A2 B2 R S H: class):
  $ wi (wiso A2 B2 R S H) (wb (wor A2 R) (wor B2 S)) $;

--| Any one-to-one onto function determines an isomorphism with an induced relation ` S ` . Proposition 6.33 of [TakeutiZaring] p. 34. (Contributed by NM, 30-Apr-2004.)
theorem f1oiso {x3 y1 z w: setvar} (A2: class) (B2: class z w) (R: class) (S: class x3 y1 z w) (H: class):
  $ wi (wa (wf1o A2 B2 H) (wceq S (copab z w (wrex x3 (wrex y1 (wa (wa (wceq (cv z) (cfv (cv x3) H)) (wceq (cv w) (cfv (cv y1) H))) (wbr (cv x3) (cv y1) R)) A2) A2)))) (wiso A2 B2 R S H) $;

--| Any one-to-one onto function determines an isomorphism with an induced relation ` S ` . (Contributed by Mario Carneiro, 9-Mar-2013.)
theorem f1oiso2 {x3 y1: setvar} (A2 B2 R: class) (S: class x3 y1) (H: class):
  $ wceq S (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wbr (cfv (cv x3) (ccnv H)) (cfv (cv y1) (ccnv H)) R))) $ >
  $ wi (wf1o A2 B2 H) (wiso A2 B2 R S H) $;

--| Extend class notation with restricted description binder.
term crio {x3: setvar} (ph: wff x3) (A2: class x3): class;

--| Define restricted description binder. In case there is no unique ` x ` such that ` ( x e. A /\ ph ) ` holds, it evaluates to the empty set. See also comments for ~ df-iota . (Contributed by NM, 15-Sep-2011.) (Revised by Mario Carneiro, 15-Oct-2016.) (Revised by NM, 2-Sep-2018.)
axiom df_riota {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wceq (crio x3 ph A2) (cio x3 (wa (wcel (cv x3) A2) ph)) $;

--| Formula-building deduction rule for iota. (Contributed by NM, 15-Sep-2011.)
theorem riotaeqdv {x3: setvar} (ph: wff) (ps: wff x3) (A2 B2: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (crio x3 ps A2) (crio x3 ps B2)) $;

--| Formula-building deduction rule for restricted iota. (Contributed by NM, 15-Sep-2011.)
theorem riotabidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (crio x3 ps A2) (crio x3 ch A2)) $;

--| Equality deduction for restricted universal quantifier. (Contributed by NM, 15-Sep-2011.)
theorem riotaeqbidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (crio x3 ps A2) (crio x3 ch B2)) $;

--| Restricted iota is a set. (Contributed by Jim Kingdon, 15-Jun-2020.)
theorem riotaexg {x3: setvar} (ps: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wcel (crio x3 ps A2) cvv) $;

--| An iota restricted to the universe is unrestricted. (Contributed by NM, 18-Sep-2011.)
theorem riotav {x3: setvar} (ph: wff x3):
  $ wceq (crio x3 ph cvv) (cio x3 ph) $;

--| Restricted iota in terms of class union. (Contributed by NM, 11-Oct-2011.)
theorem riotauni {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wreu x3 ph A2) (wceq (crio x3 ph A2) (cuni (crab x3 ph A2))) $;

--| The abstraction variable in a restricted iota descriptor isn't free. (Contributed by NM, 12-Oct-2011.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfriota1 {x3: setvar} (ph: wff x3) (A2: class):
  $ wnfc x3 (crio x3 ph A2) $;

--| Deduction version of ~ nfriota . (Contributed by Jim Kingdon, 12-Jan-2019.)
theorem nfriotadxy {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 (crio y1 ps A2)) $;

--| A variable not free in a wff remains so in a restricted iota descriptor. (Contributed by NM, 12-Oct-2011.)
theorem nfriota {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 (crio y1 ph A2) $;

--| Change bound variable in a restricted description binder. (Contributed by NM, 18-Mar-2013.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem cbvriota {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (crio x3 ph A2) (crio y1 ps A2) $;

--| Change bound variable in a restricted description binder. (Contributed by NM, 18-Mar-2013.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem cbvriotav {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (crio x3 ph A2) (crio y1 ps A2) $;

--| Interchange class substitution and restricted description binder. (Contributed by NM, 24-Feb-2013.)
theorem csbriotag {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1) (V: class x3 y1):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (crio y1 ph B2)) (crio y1 (wsbc x3 ph A2) B2)) $;

--| Membership law for "the unique element in ` A ` such that ` ph ` ." (Contributed by NM, 21-Aug-2011.) (Revised by Mario Carneiro, 23-Dec-2016.)
theorem riotacl2 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wreu x3 ph A2) (wcel (crio x3 ph A2) (crab x3 ph A2)) $;

--| Closure of restricted iota. (Contributed by NM, 21-Aug-2011.)
theorem riotacl {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wreu x3 ph A2) (wcel (crio x3 ph A2) A2) $;

--| Substitution law for descriptions. (Contributed by NM, 23-Aug-2011.) (Proof shortened by Mario Carneiro, 24-Dec-2016.)
theorem riotasbc {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wreu x3 ph A2) (wsbc x3 ph (crio x3 ph A2)) $;

--| Equivalent wff's yield equal restricted class abstractions (deduction rule). ( ~ rabbidva analog.) (Contributed by NM, 17-Jan-2012.)
theorem riotabidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wceq (crio x3 ps A2) (crio x3 ch A2)) $;

--| Equivalent wff's yield equal restricted iotas (inference rule). ( ~ rabbiia analog.) (Contributed by NM, 16-Jan-2012.)
theorem riotabiia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wb ph ps) $ >
  $ wceq (crio x3 ph A2) (crio x3 ps A2) $;

--| Property of restricted iota. Compare ~ iota1 . (Contributed by Mario Carneiro, 15-Oct-2016.)
theorem riota1 {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wreu x3 ph A2) (wb (wa (wcel (cv x3) A2) ph) (wceq (crio x3 ph A2) (cv x3))) $;

--| Property of iota. (Contributed by NM, 23-Aug-2011.)
theorem riota1a {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wa (wcel (cv x3) A2) (wreu x3 ph A2)) (wb ph (wceq (cio x3 (wa (wcel (cv x3) A2) ph)) (cv x3))) $;

--| A deduction version of ~ riota2f . (Contributed by NM, 17-Feb-2013.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem riota2df {x3: setvar} (ph ps ch: wff x3) (A2: class) (B2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wcel B2 A2) $ >
  $ wi (wa ph (wceq (cv x3) B2)) (wb ps ch) $ >
  $ wi (wa ph (wreu x3 ps A2)) (wb ch (wceq (crio x3 ps A2) B2)) $;

--| This theorem shows a condition that allows us to represent a descriptor with a class expression ` B ` . (Contributed by NM, 23-Aug-2011.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem riota2f {x3: setvar} (ph ps: wff x3) (A2: class) (B2: class x3):
  $ wnfc x3 B2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (wa (wcel B2 A2) (wreu x3 ph A2)) (wb ps (wceq (crio x3 ph A2) B2)) $;

--| This theorem shows a condition that allows us to represent a descriptor with a class expression ` B ` . (Contributed by NM, 23-Aug-2011.) (Revised by Mario Carneiro, 10-Dec-2016.)
theorem riota2 {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (wa (wcel B2 A2) (wreu x3 ph A2)) (wb ps (wceq (crio x3 ph A2) B2)) $;

--| Properties of a restricted definite description operator. Todo ( ~ df-riota update): can some uses of ~ riota2f be shortened with this? (Contributed by NM, 23-Nov-2013.)
theorem riotaprop {x3: setvar} (ph ps: wff x3) (A2: class) (B2: class x3):
  $ wnf x3 ps $ >
  $ wceq B2 (crio x3 ph A2) $ >
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (wreu x3 ph A2) (wa (wcel B2 A2) ps) $;

--| A method for computing restricted iota. (Contributed by NM, 16-Apr-2013.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem riota5f {x3: setvar} (ph: wff) (ps: wff x3) (A2: class) (B2: class x3):
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wcel B2 A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps (wceq (cv x3) B2)) $ >
  $ wi ph (wceq (crio x3 ps A2) B2) $;

--| A method for computing restricted iota. (Contributed by NM, 20-Oct-2011.) (Revised by Mario Carneiro, 6-Dec-2016.)
theorem riota5 {x3: setvar} (ph: wff) (ps: wff x3) (A2 B2: class):
  $ wi ph (wcel B2 A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps (wceq (cv x3) B2)) $ >
  $ wi ph (wceq (crio x3 ps A2) B2) $;

--| Restriction of a unique element to a smaller class. (Contributed by NM, 21-Aug-2011.) (Revised by NM, 22-Mar-2013.)
theorem riotass2 {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi (wa (wa (wss A2 B2) (wral x3 (wi ph ps) A2)) (wa (wrex x3 ph A2) (wreu x3 ps B2))) (wceq (crio x3 ph A2) (crio x3 ps B2)) $;

--| Restriction of a unique element to a smaller class. (Contributed by NM, 19-Oct-2005.) (Revised by Mario Carneiro, 24-Dec-2016.)
theorem riotass {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (w3a (wss A2 B2) (wrex x3 ph A2) (wreu x3 ph B2)) (wceq (crio x3 ph A2) (crio x3 ph B2)) $;

--| Restriction of a unique element to a smaller class. (Contributed by NM, 19-Feb-2006.) (Revised by NM, 16-Jun-2017.)
theorem moriotass {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (w3a (wss A2 B2) (wrex x3 ph A2) (wrmo x3 ph B2)) (wceq (crio x3 ph A2) (crio x3 ph B2)) $;

--| A restricted class abstraction with a unique member can be expressed as a singleton. (Contributed by NM, 30-May-2006.)
theorem snriota {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wreu x3 ph A2) (wceq (crab x3 ph A2) (csn (crio x3 ph A2))) $;

--| Specify the same property in two ways when class ` B ( y ) ` is single-valued. (Contributed by NM, 1-Nov-2010.) (Proof shortened by Mario Carneiro, 24-Dec-2016.)
theorem eusvobj2 {x3 y1: setvar} (A2: class) (B2: class y1):
  $ wcel B2 cvv $ >
  $ wi (weu x3 (wrex y1 (wceq (cv x3) B2) A2)) (wb (wrex y1 (wceq (cv x3) B2) A2) (wral y1 (wceq (cv x3) B2) A2)) $;

--| Specify the same object in two ways when class ` B ( y ) ` is single-valued. (Contributed by NM, 1-Nov-2010.) (Proof shortened by Mario Carneiro, 19-Nov-2016.)
theorem eusvobj1 {x3 y1: setvar} (A2: class) (B2: class y1):
  $ wcel B2 cvv $ >
  $ wi (weu x3 (wrex y1 (wceq (cv x3) B2) A2)) (wceq (cio x3 (wrex y1 (wceq (cv x3) B2) A2)) (cio x3 (wral y1 (wceq (cv x3) B2) A2))) $;

--| There is one domain element for each value of a one-to-one onto function. (Contributed by NM, 26-May-2006.)
theorem f1ofveu {x3: setvar} (A2 B2 C F: class):
  $ wi (wa (wf1o A2 B2 F) (wcel C B2)) (wreu x3 (wceq (cfv (cv x3) F) C) A2) $;

--| Value of the converse of a one-to-one onto function. (Contributed by NM, 26-May-2006.) (Proof shortened by Mario Carneiro, 24-Dec-2016.)
theorem f1ocnvfv3 {x3: setvar} (A2 B2 C F: class):
  $ wi (wa (wf1o A2 B2 F) (wcel C B2)) (wceq (cfv C (ccnv F)) (crio x3 (wceq (cfv (cv x3) F) C) A2)) $;

--| Restricted iota equals the empty set when not meaningful. (Contributed by NM, 16-Jan-2012.) (Revised by Mario Carneiro, 15-Oct-2016.) (Revised by NM, 13-Sep-2018.)
theorem riotaund {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wn (wreu x3 ph A2)) (wceq (crio x3 ph A2) c0) $;

--| Lemma for ~ acexmid . (Contributed by Jim Kingdon, 6-Aug-2019.)
theorem acexmidlema {x3: setvar} (ph: wff) (A2 B2 C: class):
  $ wceq A2 (crab x3 (wo (wceq (cv x3) c0) ph) (cpr c0 (csn c0))) $ >
  $ wceq B2 (crab x3 (wo (wceq (cv x3) (csn c0)) ph) (cpr c0 (csn c0))) $ >
  $ wceq C (cpr A2 B2) $ >
  $ wi (wcel (csn c0) A2) ph $;

--| Lemma for ~ acexmid . (Contributed by Jim Kingdon, 6-Aug-2019.)
theorem acexmidlemb {x3: setvar} (ph: wff) (A2 B2 C: class):
  $ wceq A2 (crab x3 (wo (wceq (cv x3) c0) ph) (cpr c0 (csn c0))) $ >
  $ wceq B2 (crab x3 (wo (wceq (cv x3) (csn c0)) ph) (cpr c0 (csn c0))) $ >
  $ wceq C (cpr A2 B2) $ >
  $ wi (wcel c0 B2) ph $;

--| Lemma for ~ acexmid . (Contributed by Jim Kingdon, 6-Aug-2019.)
theorem acexmidlemph {x3: setvar} (ph: wff) (A2 B2 C: class):
  $ wceq A2 (crab x3 (wo (wceq (cv x3) c0) ph) (cpr c0 (csn c0))) $ >
  $ wceq B2 (crab x3 (wo (wceq (cv x3) (csn c0)) ph) (cpr c0 (csn c0))) $ >
  $ wceq C (cpr A2 B2) $ >
  $ wi ph (wceq A2 B2) $;

--| Lemma for ~ acexmid . (Contributed by Jim Kingdon, 6-Aug-2019.)
theorem acexmidlemab {x3 v u: setvar} (ph: wff) (y1: setvar) (A2 B2 C: class):
  $ wceq A2 (crab x3 (wo (wceq (cv x3) c0) ph) (cpr c0 (csn c0))) $ >
  $ wceq B2 (crab x3 (wo (wceq (cv x3) (csn c0)) ph) (cpr c0 (csn c0))) $ >
  $ wceq C (cpr A2 B2) $ >
  $ wi (wa (wceq (crio v (wrex u (wa (wcel A2 (cv u)) (wcel (cv v) (cv u))) (cv y1)) A2) c0) (wceq (crio v (wrex u (wa (wcel B2 (cv u)) (wcel (cv v) (cv u))) (cv y1)) B2) (csn c0))) (wn ph) $;

--| Lemma for ~ acexmid . Here we divide the proof into cases (based on the disjunction implicit in an unordered pair, not the sort of case elimination which relies on excluded middle). The cases are (1) the choice function evaluated at ` A ` equals ` { (/) } ` , (2) the choice function evaluated at ` B ` equals ` (/) ` , and (3) the choice function evaluated at ` A ` equals ` (/) ` and the choice function evaluated at ` B ` equals ` { (/) } ` . Because of the way we represent the choice function ` y ` , the choice function evaluated at ` A ` is ` ( iota_ v e. A E. u e. y ( A e. u /\ v e. u ) ) ` and the choice function evaluated at ` B ` is ` ( iota_ v e. B E. u e. y ( B e. u /\ v e. u ) ) ` . Other than the difference in notation these work just as ` ( y `` A ) ` and ` ( y `` B ) ` would if ` y ` were a function as defined by ~ df-fun . Although it isn't exactly about the division into cases, it is also convenient for this lemma to also include the step that if the choice function evaluated at ` A ` equals ` { (/) } ` , then ` { (/) } e. A ` and likewise for ` B ` . (Contributed by Jim Kingdon, 7-Aug-2019.)
theorem acexmidlemcase {x3 z v u: setvar} (ph: wff) (y1: setvar) (A2 B2 C: class):
  $ wceq A2 (crab x3 (wo (wceq (cv x3) c0) ph) (cpr c0 (csn c0))) $ >
  $ wceq B2 (crab x3 (wo (wceq (cv x3) (csn c0)) ph) (cpr c0 (csn c0))) $ >
  $ wceq C (cpr A2 B2) $ >
  $ wi (wral z (wreu v (wrex u (wa (wcel (cv z) (cv u)) (wcel (cv v) (cv u))) (cv y1)) (cv z)) C) (w3o (wcel (csn c0) A2) (wcel c0 B2) (wa (wceq (crio v (wrex u (wa (wcel A2 (cv u)) (wcel (cv v) (cv u))) (cv y1)) A2) c0) (wceq (crio v (wrex u (wa (wcel B2 (cv u)) (wcel (cv v) (cv u))) (cv y1)) B2) (csn c0)))) $;

--| Lemma for ~ acexmid . List the cases identified in ~ acexmidlemcase and hook them up to the lemmas which handle each case. (Contributed by Jim Kingdon, 7-Aug-2019.)
theorem acexmidlem1 {x3 z v u: setvar} (ph: wff) (y1: setvar) (A2 B2 C: class):
  $ wceq A2 (crab x3 (wo (wceq (cv x3) c0) ph) (cpr c0 (csn c0))) $ >
  $ wceq B2 (crab x3 (wo (wceq (cv x3) (csn c0)) ph) (cpr c0 (csn c0))) $ >
  $ wceq C (cpr A2 B2) $ >
  $ wi (wral z (wreu v (wrex u (wa (wcel (cv z) (cv u)) (wcel (cv v) (cv u))) (cv y1)) (cv z)) C) (wo ph (wn ph)) $;

--| Lemma for ~ acexmid . This builds on ~ acexmidlem1 by noting that every element of ` C ` is inhabited. (Note that ` y ` is not quite a function in the ~ df-fun sense because it uses ordered pairs as described in ~ opthreg rather than ~ df-op ). The set ` A ` is also found in ~ onsucelsucexmidlem . (Contributed by Jim Kingdon, 5-Aug-2019.)
theorem acexmidlem2 {x3 z w v u: setvar} (ph: wff) (y1: setvar) (A2 B2 C: class):
  $ wceq A2 (crab x3 (wo (wceq (cv x3) c0) ph) (cpr c0 (csn c0))) $ >
  $ wceq B2 (crab x3 (wo (wceq (cv x3) (csn c0)) ph) (cpr c0 (csn c0))) $ >
  $ wceq C (cpr A2 B2) $ >
  $ wi (wral z (wral w (wreu v (wrex u (wa (wcel (cv z) (cv u)) (wcel (cv v) (cv u))) (cv y1)) (cv z)) (cv z)) C) (wo ph (wn ph)) $;

--| Lemma for ~ acexmid . This is ~ acexmid with additional distinct variable constraints, most notably between ` ph ` and ` x ` . (Contributed by Jim Kingdon, 6-Aug-2019.)
theorem acexmidlemv {x3 y1 z w v u: setvar} (ph: wff):
  $ wex y1 (wral z (wral w (wreu v (wrex u (wa (wcel (cv z) (cv u)) (wcel (cv v) (cv u))) (cv y1)) (cv z)) (cv z)) (cv x3)) $ >
  $ wo ph (wn ph) $;

--| The axiom of choice implies excluded middle. Theorem 1.3 in [Bauer] p. 483. The statement of the axiom of choice given here is ac2 in the Metamath Proof Explorer (version of 3-Aug-2019). In particular, note that the choice function ` y ` provides a value when ` z ` is inhabited (as opposed to non-empty as in some statements of the axiom of choice). Essentially the same proof can also be found at "The axiom of choice implies instances of EM", [Crosilla], p. "Set-theoretic principles incompatible with intuitionistic logic". Often referred to as Diaconescu's theorem, or Diaconescu-Goodman-Myhill theorem, after Radu Diaconescu who discovered it in 1975 in the framework of topos theory and N. D. Goodman and John Myhill in 1978 in the framework of set theory (although it already appeared as an exercise in Errett Bishop's book _Foundations of Constructive Analysis_ from 1967). (Contributed by Jim Kingdon, 4-Aug-2019.)
theorem acexmid {x3 y1 z w v u: setvar} (ph: wff x3 y1 z w v u):
  $ wex y1 (wral z (wral w (wreu v (wrex u (wa (wcel (cv z) (cv u)) (wcel (cv v) (cv u))) (cv y1)) (cv z)) (cv z)) (cv x3)) $ >
  $ wo ph (wn ph) $;

--| Extend class notation to include the value of an operation ` F ` (such as + ) for two arguments ` A ` and ` B ` . Note that the syntax is simply three class symbols in a row surrounded by parentheses. Since operation values are the only possible class expressions consisting of three class expressions in a row surrounded by parentheses, the syntax is unambiguous.
term co (A2 B2 F: class): class;

--| Extend class notation to include class abstraction (class builder) of nested ordered pairs.
term coprab {x3 y1 z: setvar} (ph: wff x3 y1 z): class;

--| Extend the definition of a class to include maps-to notation for defining an operation via a rule.
term cmpt2 {x3 y1: setvar} (A2 B2 C: class x3 y1): class;

--| Define the value of an operation. Definition of operation value in [Enderton] p. 79. Note that the syntax is simply three class expressions in a row bracketed by parentheses. There are no restrictions of any kind on what those class expressions may be, although only certain kinds of class expressions - a binary operation ` F ` and its arguments ` A ` and ` B ` - will be useful for proving meaningful theorems. For example, if class ` F ` is the operation + and arguments ` A ` and ` B ` are 3 and 2 , the expression ( 3 + 2 ) can be proved to equal 5 . This definition is well-defined, although not very meaningful, when classes ` A ` and/or ` B ` are proper classes (i.e. are not sets); see ~ ovprc1 and ~ ovprc2 . On the other hand, we often find uses for this definition when ` F ` is a proper class. ` F ` is normally equal to a class of nested ordered pairs of the form defined by ~ df-oprab . (Contributed by NM, 28-Feb-1995.)
axiom df_ov (A2 B2 F: class):
  $ wceq (co A2 B2 F) (cfv (cop A2 B2) F) $;

--| Define the class abstraction (class builder) of a collection of nested ordered pairs (for use in defining operations). This is a special case of Definition 4.16 of [TakeutiZaring] p. 14. Normally ` x ` , ` y ` , and ` z ` are distinct, although the definition doesn't strictly require it. See ~ df-ov for the value of an operation. The brace notation is called "class abstraction" by Quine; it is also called a "class builder" in the literature. The value of the most common operation class builder is given by ~ ovmpt2 . (Contributed by NM, 12-Mar-1995.)
axiom df_oprab {x3 y1 z w: setvar} (ph: wff x3 y1 z):
  $ wceq (coprab x3 y1 z ph) (cab w (wex x3 (wex y1 (wex z (wa (wceq (cv w) (cop (cop (cv x3) (cv y1)) (cv z))) ph))))) $;

--| Define maps-to notation for defining an operation via a rule. Read as "the operation defined by the map from ` x , y ` (in ` A X. B ` ) to ` B ( x , y ) ` ." An extension of ~ df-mpt for two arguments. (Contributed by NM, 17-Feb-2008.)
axiom df_mpt2 {x3 y1 z: setvar} (A2 B2 C: class x3 y1):
  $ wceq (cmpt2 x3 y1 A2 B2 C) (coprab x3 y1 z (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wceq (cv z) C))) $;

--| Equality theorem for operation value. (Contributed by NM, 28-Feb-1995.)
theorem oveq (A2 B2 F G: class):
  $ wi (wceq F G) (wceq (co A2 B2 F) (co A2 B2 G)) $;

--| Equality theorem for operation value. (Contributed by NM, 28-Feb-1995.)
theorem oveq1 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wceq (co A2 C F) (co B2 C F)) $;

--| Equality theorem for operation value. (Contributed by NM, 28-Feb-1995.)
theorem oveq2 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wceq (co C A2 F) (co C B2 F)) $;

--| Equality theorem for operation value. (Contributed by NM, 16-Jul-1995.)
theorem oveq12 (A2 B2 C D F: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wceq (co A2 C F) (co B2 D F)) $;

--| Equality inference for operation value. (Contributed by NM, 28-Feb-1995.)
theorem oveq1i (A2 B2 C F: class):
  $ wceq A2 B2 $ >
  $ wceq (co A2 C F) (co B2 C F) $;

--| Equality inference for operation value. (Contributed by NM, 28-Feb-1995.)
theorem oveq2i (A2 B2 C F: class):
  $ wceq A2 B2 $ >
  $ wceq (co C A2 F) (co C B2 F) $;

--| Equality inference for operation value. (Contributed by NM, 28-Feb-1995.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem oveq12i (A2 B2 C D F: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (co A2 C F) (co B2 D F) $;

--| Equality inference for operation value. (Contributed by NM, 24-Nov-2007.)
theorem oveqi (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq (co C D A2) (co C D B2) $;

--| Equality inference for operation value. (Contributed by FL, 11-Jul-2010.)
theorem oveq123i (A2 B2 C D F G: class):
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wceq F G $ >
  $ wceq (co A2 B2 F) (co C D G) $;

--| Equality deduction for operation value. (Contributed by NM, 13-Mar-1995.)
theorem oveq1d (ph: wff) (A2 B2 C F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (co A2 C F) (co B2 C F)) $;

--| Equality deduction for operation value. (Contributed by NM, 13-Mar-1995.)
theorem oveq2d (ph: wff) (A2 B2 C F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (co C A2 F) (co C B2 F)) $;

--| Equality deduction for operation value. (Contributed by NM, 9-Sep-2006.)
theorem oveqd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (co C D A2) (co C D B2)) $;

--| Equality deduction for operation value. (Contributed by NM, 13-Mar-1995.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem oveq12d (ph: wff) (A2 B2 C D F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (co A2 C F) (co B2 D F)) $;

--| Equality deduction for operation value. (Contributed by NM, 10-Aug-1995.)
theorem oveqan12d (ph ps: wff) (A2 B2 C D F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ps (wceq C D) $ >
  $ wi (wa ph ps) (wceq (co A2 C F) (co B2 D F)) $;

--| Equality deduction for operation value. (Contributed by NM, 10-Aug-1995.)
theorem oveqan12rd (ph ps: wff) (A2 B2 C D F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ps (wceq C D) $ >
  $ wi (wa ps ph) (wceq (co A2 C F) (co B2 D F)) $;

--| Equality deduction for operation value. (Contributed by FL, 22-Dec-2008.)
theorem oveq123d (ph: wff) (A2 B2 C D F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (co A2 C F) (co B2 D G)) $;

--| Deduction version of bound-variable hypothesis builder ~ nfov . (Contributed by NM, 13-Dec-2005.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem nfovd {x3: setvar} (ph: wff x3) (A2 B2 F: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 F) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnfc x3 (co A2 B2 F)) $;

--| Bound-variable hypothesis builder for operation value. (Contributed by NM, 4-May-2004.)
theorem nfov {x3: setvar} (A2 B2 F: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 F $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (co A2 B2 F) $;

--| Slight elaboration of ~ exdistrfor . A lemma for ~ oprabid . (Contributed by Jim Kingdon, 15-Jan-2019.)
theorem oprabidlem {x3 y1 z: setvar} (ps: wff x3 y1 z):
  $ wi (wex x3 (wex y1 (wa (wceq (cv x3) (cv z)) ps))) (wex x3 (wa (wceq (cv x3) (cv z)) (wex y1 ps))) $;

--| The law of concretion. Special case of Theorem 9.5 of [Quine] p. 61. Although this theorem would be useful with a distinct variable constraint between ` x ` , ` y ` , and ` z ` , we use ~ ax-bndl to eliminate that constraint. (Contributed by Mario Carneiro, 20-Mar-2013.)
theorem oprabid {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wb (wcel (cop (cop (cv x3) (cv y1)) (cv z)) (coprab x3 y1 z ph)) ph $;

--| The result of an operation is a set. (Contributed by Jim Kingdon, 15-Jan-2019.)
theorem fnovex (A2 B2 C D F: class):
  $ wi (w3a (wfn F (cxp C D)) (wcel A2 C) (wcel B2 D)) (wcel (co A2 B2 F) cvv) $;

--| Evaluating a set operation at two sets gives a set. (Contributed by Jim Kingdon, 19-Aug-2021.)
theorem ovexg (A2 B2 F V W X: class):
  $ wi (w3a (wcel A2 V) (wcel F W) (wcel B2 X)) (wcel (co A2 B2 F) cvv) $;

--| The value of an operation when the one of the arguments is a proper class. Note: this theorem is dependent on our particular definitions of operation value, function value, and ordered pair. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem ovprc (A2 B2 F: class):
  $ wrel (cdm F) $ >
  $ wi (wn (wa (wcel A2 cvv) (wcel B2 cvv))) (wceq (co A2 B2 F) c0) $;

--| The value of an operation when the first argument is a proper class. (Contributed by NM, 16-Jun-2004.)
theorem ovprc1 (A2 B2 F: class):
  $ wrel (cdm F) $ >
  $ wi (wn (wcel A2 cvv)) (wceq (co A2 B2 F) c0) $;

--| The value of an operation when the second argument is a proper class. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem ovprc2 (A2 B2 F: class):
  $ wrel (cdm F) $ >
  $ wi (wn (wcel B2 cvv)) (wceq (co A2 B2 F) c0) $;

--| Move class substitution in and out of an operation. (Contributed by NM, 12-Nov-2005.) (Proof shortened by Mario Carneiro, 5-Dec-2016.)
theorem csbov123g {x3: setvar} (A2 B2 C D F: class x3):
  $ wi (wcel A2 D) (wceq (csb x3 A2 (co B2 C F)) (co (csb x3 A2 B2) (csb x3 A2 C) (csb x3 A2 F))) $;

--| Move class substitution in and out of an operation. (Contributed by NM, 12-Nov-2005.)
theorem csbov12g {x3: setvar} (A2 B2 C: class x3) (F: class) (V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (co B2 C F)) (co (csb x3 A2 B2) (csb x3 A2 C) F)) $;

--| Move class substitution in and out of an operation. (Contributed by NM, 12-Nov-2005.)
theorem csbov1g {x3: setvar} (A2 B2: class x3) (C F: class) (V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (co B2 C F)) (co (csb x3 A2 B2) C F)) $;

--| Move class substitution in and out of an operation. (Contributed by NM, 12-Nov-2005.)
theorem csbov2g {x3: setvar} (A2: class x3) (B2: class) (C: class x3) (F: class) (V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (co B2 C F)) (co B2 (csb x3 A2 C) F)) $;

--| A frequently used special case of ~ rspc2ev for operation values. (Contributed by NM, 21-Mar-2007.)
theorem rspceov {x3 y1: setvar} (A2: class y1) (B2 C: class) (D: class x3) (S F: class):
  $ wi (w3a (wcel C A2) (wcel D B2) (wceq S (co C D F))) (wrex x3 (wrex y1 (wceq S (co (cv x3) (cv y1) F)) B2) A2) $;

--| Equivalence of operation value and ordered triple membership, analogous to ~ fnopfvb . (Contributed by NM, 17-Dec-2008.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem fnotovb (A2 B2 C D R F: class):
  $ wi (w3a (wfn F (cxp A2 B2)) (wcel C A2) (wcel D B2)) (wb (wceq (co C D F) R) (wcel (cotp C D R) F)) $;

--| A collection of ordered pairs with an extension of a binary relation is a set. (Contributed by Alexander van der Vekens, 1-Nov-2017.)
theorem opabbrex {f2 p: setvar} (ps th: wff f2 p) (E V: class) (W: class f2 p):
  $ wi (wa (wcel V cvv) (wcel E cvv)) (wi (wbr (cv f2) (cv p) (co V E W)) th) $ >
  $ wi (wa (wcel V cvv) (wcel E cvv)) (wcel (copab f2 p th) cvv) $ >
  $ wi (wa (wcel V cvv) (wcel E cvv)) (wcel (copab f2 p (wa (wbr (cv f2) (cv p) (co V E W)) ps)) cvv) $;

--| The empty set is never an element in an ordered-pair class abstraction. (Contributed by Alexander van der Vekens, 5-Nov-2017.)
theorem _0neqopab {x3 y1: setvar} (ph: wff x3 y1):
  $ wn (wcel c0 (copab x3 y1 ph)) $;

--| If two classes are in a relationship given by an ordered-pair class abstraction, the classes are sets. (Contributed by Jim Kingdon, 16-Jan-2019.)
theorem brabvv {x3 y1: setvar} (ph: wff x3 y1) (X Y: class):
  $ wi (wbr X Y (copab x3 y1 ph)) (wa (wcel X cvv) (wcel Y cvv)) $;

--| Class abstraction for operations in terms of class abstraction of ordered pairs. (Contributed by NM, 12-Mar-1995.)
theorem dfoprab2 {x3 y1 z w: setvar} (ph: wff x3 y1 z):
  $ wceq (coprab x3 y1 z ph) (copab w z (wex x3 (wex y1 (wa (wceq (cv w) (cop (cv x3) (cv y1))) ph)))) $;

--| An operation class abstraction is a relation. (Contributed by NM, 16-Jun-2004.)
theorem reloprab {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wrel (coprab x3 y1 z ph) $;

--| The abstraction variables in an operation class abstraction are not free. (Contributed by NM, 25-Apr-1995.) (Revised by David Abernethy, 19-Jun-2012.)
theorem nfoprab1 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wnfc x3 (coprab x3 y1 z ph) $;

--| The abstraction variables in an operation class abstraction are not free. (Contributed by NM, 25-Apr-1995.) (Revised by David Abernethy, 30-Jul-2012.)
theorem nfoprab2 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wnfc y1 (coprab x3 y1 z ph) $;

--| The abstraction variables in an operation class abstraction are not free. (Contributed by NM, 22-Aug-2013.)
theorem nfoprab3 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wnfc z (coprab x3 y1 z ph) $;

--| Bound-variable hypothesis builder for an operation class abstraction. (Contributed by NM, 22-Aug-2013.)
theorem nfoprab {x3 y1 z w: setvar} (ph: wff x3 y1 z w):
  $ wnf w ph $ >
  $ wnfc w (coprab x3 y1 z ph) $;

--| Equivalent wff's yield equal operation class abstractions (deduction rule). (Contributed by NM, 21-Feb-2004.) (Revised by Mario Carneiro, 24-Jun-2014.)
theorem oprabbid {x3 y1 z: setvar} (ph ps ch: wff x3 y1 z):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wnf z ph $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (coprab x3 y1 z ps) (coprab x3 y1 z ch)) $;

--| Equivalent wff's yield equal operation class abstractions (deduction rule). (Contributed by NM, 21-Feb-2004.)
theorem oprabbidv {x3 y1 z: setvar} (ph: wff) (ps ch: wff x3 y1 z):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (coprab x3 y1 z ps) (coprab x3 y1 z ch)) $;

--| Equivalent wff's yield equal operation class abstractions. (Contributed by NM, 28-May-1995.) (Revised by David Abernethy, 19-Jun-2012.)
theorem oprabbii {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wb ph ps $ >
  $ wceq (coprab x3 y1 z ph) (coprab x3 y1 z ps) $;

--| Equivalence of ordered pair abstraction subclass and implication. Compare ~ ssopab2 . (Contributed by FL, 6-Nov-2013.) (Proof shortened by Mario Carneiro, 11-Dec-2016.)
theorem ssoprab2 {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi (wal x3 (wal y1 (wal z (wi ph ps)))) (wss (coprab x3 y1 z ph) (coprab x3 y1 z ps)) $;

--| Equivalence of ordered pair abstraction subclass and implication. Compare ~ ssopab2b . (Contributed by FL, 6-Nov-2013.) (Proof shortened by Mario Carneiro, 11-Dec-2016.)
theorem ssoprab2b {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wb (wss (coprab x3 y1 z ph) (coprab x3 y1 z ps)) (wal x3 (wal y1 (wal z (wi ph ps)))) $;

--| Equivalence of ordered pair abstraction subclass and biconditional. Compare ~ eqopab2b . (Contributed by Mario Carneiro, 4-Jan-2017.)
theorem eqoprab2b {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wb (wceq (coprab x3 y1 z ph) (coprab x3 y1 z ps)) (wal x3 (wal y1 (wal z (wb ph ps)))) $;

--| An equality theorem for the maps to notation. (Contributed by Mario Carneiro, 16-Dec-2013.) (Revised by Mario Carneiro, 19-Mar-2015.)
theorem mpt2eq123 {x3 y1: setvar} (A2: class) (B2: class x3) (C: class x3 y1) (D: class) (E: class x3) (F: class x3 y1):
  $ wi (wa (wceq A2 D) (wral x3 (wa (wceq B2 E) (wral y1 (wceq C F) B2)) A2)) (wceq (cmpt2 x3 y1 A2 B2 C) (cmpt2 x3 y1 D E F)) $;

--| An equality theorem for the maps to notation. (Contributed by Mario Carneiro, 16-Dec-2013.)
theorem mpt2eq12 {x3 y1: setvar} (A2 B2 C D: class) (E: class x3 y1):
  $ wi (wa (wceq A2 C) (wceq B2 D)) (wceq (cmpt2 x3 y1 A2 B2 E) (cmpt2 x3 y1 C D E)) $;

--| An equality deduction for the maps to notation. (Contributed by Mario Carneiro, 26-Jan-2017.)
theorem mpt2eq123dva {x3 y1: setvar} (ph: wff) (A2 B2 C D E F: class x3 y1):
  $ wi ph (wceq A2 D) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 E) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wceq C F) $ >
  $ wi ph (wceq (cmpt2 x3 y1 A2 B2 C) (cmpt2 x3 y1 D E F)) $;

--| An equality deduction for the maps to notation. (Contributed by NM, 12-Sep-2011.)
theorem mpt2eq123dv {x3 y1: setvar} (ph: wff) (A2 B2 C D E F: class x3 y1):
  $ wi ph (wceq A2 D) $ >
  $ wi ph (wceq B2 E) $ >
  $ wi ph (wceq C F) $ >
  $ wi ph (wceq (cmpt2 x3 y1 A2 B2 C) (cmpt2 x3 y1 D E F)) $;

--| An equality inference for the maps to notation. (Contributed by NM, 15-Jul-2013.)
theorem mpt2eq123i {x3 y1: setvar} (A2 B2 C D E F: class x3 y1):
  $ wceq A2 D $ >
  $ wceq B2 E $ >
  $ wceq C F $ >
  $ wceq (cmpt2 x3 y1 A2 B2 C) (cmpt2 x3 y1 D E F) $;

--| Slightly more general equality inference for the maps to notation. (Contributed by NM, 17-Oct-2013.)
theorem mpt2eq3dva {x3 y1: setvar} (ph: wff) (A2 B2 C D: class x3 y1):
  $ wi (w3a ph (wcel (cv x3) A2) (wcel (cv y1) B2)) (wceq C D) $ >
  $ wi ph (wceq (cmpt2 x3 y1 A2 B2 C) (cmpt2 x3 y1 A2 B2 D)) $;

--| An equality inference for the maps to notation. (Contributed by Mario Carneiro, 16-Dec-2013.)
theorem mpt2eq3ia {x3 y1: setvar} (A2 B2 C D: class x3 y1):
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wceq C D) $ >
  $ wceq (cmpt2 x3 y1 A2 B2 C) (cmpt2 x3 y1 A2 B2 D) $;

--| Bound-variable hypothesis builder for an operation in maps-to notation. (Contributed by NM, 27-Aug-2013.)
theorem nfmpt21 {x3 y1: setvar} (A2 B2 C: class x3 y1):
  $ wnfc x3 (cmpt2 x3 y1 A2 B2 C) $;

--| Bound-variable hypothesis builder for an operation in maps-to notation. (Contributed by NM, 27-Aug-2013.)
theorem nfmpt22 {x3 y1: setvar} (A2 B2 C: class x3 y1):
  $ wnfc y1 (cmpt2 x3 y1 A2 B2 C) $;

--| Bound-variable hypothesis builder for the maps-to notation. (Contributed by NM, 20-Feb-2013.)
theorem nfmpt2 {x3 y1 z: setvar} (A2 B2 C: class x3 y1 z):
  $ wnfc z A2 $ >
  $ wnfc z B2 $ >
  $ wnfc z C $ >
  $ wnfc z (cmpt2 x3 y1 A2 B2 C) $;

--| A mapping operation with empty domain. (Contributed by Stefan O'Rear, 29-Jan-2015.) (Revised by Mario Carneiro, 15-May-2015.)
theorem mpt20 {x3 y1: setvar} (B2 C: class x3 y1):
  $ wceq (cmpt2 x3 y1 c0 B2 C) c0 $;

--| Two ways to state the domain of an operation. (Contributed by FL, 24-Jan-2010.)
theorem oprab4 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2 B2: class x3 y1 z):
  $ wceq (coprab x3 y1 z (wa (wcel (cop (cv x3) (cv y1)) (cxp A2 B2)) ph)) (coprab x3 y1 z (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph)) $;

--| Rule used to change first bound variable in an operation abstraction, using implicit substitution. (Contributed by NM, 20-Dec-2008.) (Revised by Mario Carneiro, 5-Dec-2016.)
theorem cbvoprab1 {x3 y1 z w: setvar} (ph ps: wff x3 y1 z w):
  $ wnf w ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv w)) (wb ph ps) $ >
  $ wceq (coprab x3 y1 z ph) (coprab w y1 z ps) $;

--| Change the second bound variable in an operation abstraction. (Contributed by Jeff Madsen, 11-Jun-2010.) (Revised by Mario Carneiro, 11-Dec-2016.)
theorem cbvoprab2 {x3 y1 z w: setvar} (ph ps: wff x3 y1 z w):
  $ wnf w ph $ >
  $ wnf y1 ps $ >
  $ wi (wceq (cv y1) (cv w)) (wb ph ps) $ >
  $ wceq (coprab x3 y1 z ph) (coprab x3 w z ps) $;

--| Rule used to change first two bound variables in an operation abstraction, using implicit substitution. (Contributed by NM, 21-Feb-2004.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem cbvoprab12 {x3 y1 z w v: setvar} (ph ps: wff x3 y1 z w v):
  $ wnf w ph $ >
  $ wnf v ph $ >
  $ wnf x3 ps $ >
  $ wnf y1 ps $ >
  $ wi (wa (wceq (cv x3) (cv w)) (wceq (cv y1) (cv v))) (wb ph ps) $ >
  $ wceq (coprab x3 y1 z ph) (coprab w v z ps) $;

--| Rule used to change first two bound variables in an operation abstraction, using implicit substitution. (Contributed by NM, 8-Oct-2004.)
theorem cbvoprab12v {x3 y1 z w v: setvar} (ph: wff x3 y1 z) (ps: wff z w v):
  $ wi (wa (wceq (cv x3) (cv w)) (wceq (cv y1) (cv v))) (wb ph ps) $ >
  $ wceq (coprab x3 y1 z ph) (coprab w v z ps) $;

--| Rule used to change the third bound variable in an operation abstraction, using implicit substitution. (Contributed by NM, 22-Aug-2013.)
theorem cbvoprab3 {x3 y1 z w: setvar} (ph ps: wff x3 y1 z w):
  $ wnf w ph $ >
  $ wnf z ps $ >
  $ wi (wceq (cv z) (cv w)) (wb ph ps) $ >
  $ wceq (coprab x3 y1 z ph) (coprab x3 y1 w ps) $;

--| Rule used to change the third bound variable in an operation abstraction, using implicit substitution. (Contributed by NM, 8-Oct-2004.) (Revised by David Abernethy, 19-Jun-2012.)
theorem cbvoprab3v {x3 y1 z w: setvar} (ph: wff x3 y1 z) (ps: wff x3 y1 w):
  $ wi (wceq (cv z) (cv w)) (wb ph ps) $ >
  $ wceq (coprab x3 y1 z ph) (coprab x3 y1 w ps) $;

--| Rule to change the bound variable in a maps-to function, using implicit substitution. This version of ~ cbvmpt2 allows ` B ` to be a function of ` x ` . (Contributed by NM, 29-Dec-2014.)
theorem cbvmpt2x {x3 y1 z w: setvar} (A2: class) (B2: class x3 y1 z) (C: class x3 y1 z w) (D: class x3 z w) (E: class x3 y1 z w):
  $ wnfc z B2 $ >
  $ wnfc x3 D $ >
  $ wnfc z C $ >
  $ wnfc w C $ >
  $ wnfc x3 E $ >
  $ wnfc y1 E $ >
  $ wi (wceq (cv x3) (cv z)) (wceq B2 D) $ >
  $ wi (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) (wceq C E) $ >
  $ wceq (cmpt2 x3 y1 A2 B2 C) (cmpt2 z w A2 D E) $;

--| Rule to change the bound variable in a maps-to function, using implicit substitution. (Contributed by NM, 17-Dec-2013.)
theorem cbvmpt2 {x3 y1 z w: setvar} (A2 B2: class) (C D: class x3 y1 z w):
  $ wnfc z C $ >
  $ wnfc w C $ >
  $ wnfc x3 D $ >
  $ wnfc y1 D $ >
  $ wi (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) (wceq C D) $ >
  $ wceq (cmpt2 x3 y1 A2 B2 C) (cmpt2 z w A2 B2 D) $;

--| Rule to change the bound variable in a maps-to function, using implicit substitution. With a longer proof analogous to ~ cbvmpt , some distinct variable requirements could be eliminated. (Contributed by NM, 11-Jun-2013.)
theorem cbvmpt2v {x3 y1 z w: setvar} (A2 B2: class) (C: class x3 y1) (D: class z w) (E: class x3 y1 z w):
  $ wi (wceq (cv x3) (cv z)) (wceq C E) $ >
  $ wi (wceq (cv y1) (cv w)) (wceq E D) $ >
  $ wceq (cmpt2 x3 y1 A2 B2 C) (cmpt2 z w A2 B2 D) $;

--| The domain of an operation class abstraction. (Contributed by NM, 17-Mar-1995.) (Revised by David Abernethy, 19-Jun-2012.)
theorem dmoprab {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wceq (cdm (coprab x3 y1 z ph)) (copab x3 y1 (wex z ph)) $;

--| The domain of an operation class abstraction. (Contributed by NM, 24-Aug-1995.)
theorem dmoprabss {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2 B2: class):
  $ wss (cdm (coprab x3 y1 z (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph))) (cxp A2 B2) $;

--| The range of an operation class abstraction. (Contributed by NM, 30-Aug-2004.) (Revised by David Abernethy, 19-Apr-2013.)
theorem rnoprab {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wceq (crn (coprab x3 y1 z ph)) (cab z (wex x3 (wex y1 ph))) $;

--| The range of a restricted operation class abstraction. (Contributed by Scott Fenton, 21-Mar-2012.)
theorem rnoprab2 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class x3 z) (B2: class x3 y1 z):
  $ wceq (crn (coprab x3 y1 z (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph))) (cab z (wrex x3 (wrex y1 ph B2) A2)) $;

--| The domain of an operation class abstraction is a relation. (Contributed by NM, 17-Mar-1995.)
theorem reldmoprab {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wrel (cdm (coprab x3 y1 z ph)) $;

--| Structure of an operation class abstraction. (Contributed by NM, 28-Nov-2006.)
theorem oprabss {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wss (coprab x3 y1 z ph) (cxp (cxp cvv cvv) cvv) $;

--| The law of concretion for operation class abstraction. Compare ~ elopab . (Contributed by NM, 14-Sep-1999.) (Unnecessary distinct variable restrictions were removed by David Abernethy, 19-Jun-2012.) (Revised by Mario Carneiro, 19-Dec-2013.)
theorem eloprabga {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff) (A2 B2 C: class) (V W X: class x3 y1 z):
  $ wi (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) (wb ph ps) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wb (wcel (cop (cop A2 B2) C) (coprab x3 y1 z ph)) ps) $;

--| The law of concretion for operation class abstraction. Compare ~ elopab . (Contributed by NM, 14-Sep-1999.) (Revised by David Abernethy, 19-Jun-2012.)
theorem eloprabg {x3 y1 z: setvar} (ph ps ch: wff x3 y1 z) (th: wff) (A2 B2 C: class) (V W X: class x3 y1 z):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wb (wcel (cop (cop A2 B2) C) (coprab x3 y1 z ph)) th) $;

--| Inference of operation class abstraction subclass from implication. (Contributed by NM, 11-Nov-1995.) (Revised by David Abernethy, 19-Jun-2012.)
theorem ssoprab2i {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi ph ps $ >
  $ wss (coprab x3 y1 z ph) (coprab x3 y1 z ps) $;

--| Operation with universal domain in maps-to notation. (Contributed by NM, 16-Aug-2013.)
theorem mpt2v {x3 y1 z: setvar} (C: class x3 y1):
  $ wceq (cmpt2 x3 y1 cvv cvv C) (coprab x3 y1 z (wceq (cv z) C)) $;

--| Express a two-argument function as a one-argument function, or vice-versa. In this version ` B ( x ) ` is not assumed to be constant w.r.t ` x ` . (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem mpt2mptx {x3 y1 z: setvar} (A2: class) (B2: class x3) (C: class z) (D: class x3 y1):
  $ wi (wceq (cv z) (cop (cv x3) (cv y1))) (wceq C D) $ >
  $ wceq (cmpt z (ciun x3 A2 (cxp (csn (cv x3)) B2)) C) (cmpt2 x3 y1 A2 B2 D) $;

--| Express a two-argument function as a one-argument function, or vice-versa. (Contributed by Mario Carneiro, 17-Dec-2013.) (Revised by Mario Carneiro, 29-Dec-2014.)
theorem mpt2mpt {x3 y1 z: setvar} (A2 B2: class) (C: class z) (D: class x3 y1):
  $ wi (wceq (cv z) (cop (cv x3) (cv y1))) (wceq C D) $ >
  $ wceq (cmpt z (cxp A2 B2) C) (cmpt2 x3 y1 A2 B2 D) $;

--| Restriction of an operation class abstraction. (Contributed by NM, 10-Feb-2007.)
theorem resoprab {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2 B2: class):
  $ wceq (cres (coprab x3 y1 z ph) (cxp A2 B2)) (coprab x3 y1 z (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph)) $;

--| Restriction of an operator abstraction. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem resoprab2 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2 B2 C D: class):
  $ wi (wa (wss C A2) (wss D B2)) (wceq (cres (coprab x3 y1 z (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph)) (cxp C D)) (coprab x3 y1 z (wa (wa (wcel (cv x3) C) (wcel (cv y1) D)) ph))) $;

--| Restriction of the mapping operation. (Contributed by Mario Carneiro, 17-Dec-2013.)
theorem resmpt2 {x3 y1: setvar} (A2 B2 C D: class) (E: class x3 y1):
  $ wi (wa (wss C A2) (wss D B2)) (wceq (cres (cmpt2 x3 y1 A2 B2 E) (cxp C D)) (cmpt2 x3 y1 C D E)) $;

--| "At most one" is a sufficient condition for an operation class abstraction to be a function. (Contributed by NM, 28-Aug-2007.)
theorem funoprabg {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wal x3 (wal y1 (wmo z ph))) (wfun (coprab x3 y1 z ph)) $;

--| "At most one" is a sufficient condition for an operation class abstraction to be a function. (Contributed by NM, 17-Mar-1995.)
theorem funoprab {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wmo z ph $ >
  $ wfun (coprab x3 y1 z ph) $;

--| Functionality and domain of an operation class abstraction. (Contributed by NM, 28-Aug-2007.)
theorem fnoprabg {x3 y1 z: setvar} (ph: wff x3 y1) (ps: wff x3 y1 z):
  $ wi (wal x3 (wal y1 (wi ph (weu z ps)))) (wfn (coprab x3 y1 z (wa ph ps)) (copab x3 y1 ph)) $;

--| The maps-to notation for an operation is always a function. (Contributed by Scott Fenton, 21-Mar-2012.)
theorem mpt2fun {x3 y1: setvar} (A2 B2 C F: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wfun F $;

--| Functionality and domain of an operation class abstraction. (Contributed by NM, 15-May-1995.)
theorem fnoprab {x3 y1 z: setvar} (ph: wff x3 y1) (ps: wff x3 y1 z):
  $ wi ph (weu z ps) $ >
  $ wfn (coprab x3 y1 z (wa ph ps)) (copab x3 y1 ph) $;

--| An operation maps to a class to which all values belong. (Contributed by NM, 7-Feb-2004.)
theorem ffnov {x3 y1: setvar} (A2 B2 C F: class):
  $ wb (wf (cxp A2 B2) C F) (wa (wfn F (cxp A2 B2)) (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) F) C) B2) A2)) $;

--| Closure law for an operation. (Contributed by NM, 19-Apr-2007.)
theorem fovcl (A2 B2 C R S F: class):
  $ wf (cxp R S) C F $ >
  $ wi (wa (wcel A2 R) (wcel B2 S)) (wcel (co A2 B2 F) C) $;

--| Equality of two operations is determined by their values. (Contributed by NM, 1-Sep-2005.)
theorem eqfnov {x3 y1: setvar} (A2 B2: class) (C D: class x3 y1) (F G: class):
  $ wi (wa (wfn F (cxp A2 B2)) (wfn G (cxp C D))) (wb (wceq F G) (wa (wceq (cxp A2 B2) (cxp C D)) (wral x3 (wral y1 (wceq (co (cv x3) (cv y1) F) (co (cv x3) (cv y1) G)) B2) A2))) $;

--| Two operators with the same domain are equal iff their values at each point in the domain are equal. (Contributed by Jeff Madsen, 7-Jun-2010.)
theorem eqfnov2 {x3 y1: setvar} (A2 B2 F G: class):
  $ wi (wa (wfn F (cxp A2 B2)) (wfn G (cxp A2 B2))) (wb (wceq F G) (wral x3 (wral y1 (wceq (co (cv x3) (cv y1) F) (co (cv x3) (cv y1) G)) B2) A2)) $;

--| Representation of a function in terms of its values. (Contributed by Jim Kingdon, 16-Jan-2019.)
theorem fnovim {x3 y1: setvar} (A2 B2 F: class):
  $ wi (wfn F (cxp A2 B2)) (wceq F (cmpt2 x3 y1 A2 B2 (co (cv x3) (cv y1) F))) $;

--| Bidirectional equality theorem for a mapping abstraction. Equivalent to ~ eqfnov2 . (Contributed by Mario Carneiro, 4-Jan-2017.)
theorem mpt22eqb {x3 y1: setvar} (A2: class) (B2: class x3) (C D V: class x3 y1):
  $ wi (wral x3 (wral y1 (wcel C V) B2) A2) (wb (wceq (cmpt2 x3 y1 A2 B2 C) (cmpt2 x3 y1 A2 B2 D)) (wral x3 (wral y1 (wceq C D) B2) A2)) $;

--| The range of an operation given by the "maps to" notation. (Contributed by FL, 20-Jun-2011.)
theorem rnmpt2 {x3 y1 z: setvar} (A2: class x3) (B2 C F: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wceq (crn F) (cab z (wrex x3 (wrex y1 (wceq (cv z) C) B2) A2)) $;

--| The domain of an operation defined by maps-to notation is a relation. (Contributed by Stefan O'Rear, 27-Nov-2014.)
theorem reldmmpt2 {x3 y1: setvar} (A2: class x3) (B2 C F: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wrel (cdm F) $;

--| Membership in the range of an operation class abstraction. (Contributed by NM, 27-Aug-2007.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem elrnmpt2g {x3 y1: setvar} (A2: class x3) (B2 C: class x3 y1) (D: class) (F V: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wi (wcel D V) (wb (wcel D (crn F)) (wrex x3 (wrex y1 (wceq D C) B2) A2)) $;

--| Membership in the range of an operation class abstraction. (Contributed by NM, 1-Aug-2004.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem elrnmpt2 {x3 y1: setvar} (A2: class x3) (B2 C: class x3 y1) (D: class) (F: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wcel C cvv $ >
  $ wb (wcel D (crn F)) (wrex x3 (wrex y1 (wceq D C) B2) A2) $;

--| A restricted quantifier over an image set. (Contributed by Mario Carneiro, 1-Sep-2015.)
theorem ralrnmpt2 {x3 y1 z: setvar} (ph: wff z) (ps: wff x3 y1) (A2: class x3) (B2 C F: class x3 y1) (V: class x3 y1 z):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wi (wceq (cv z) C) (wb ph ps) $ >
  $ wi (wral x3 (wral y1 (wcel C V) B2) A2) (wb (wral z ph (crn F)) (wral x3 (wral y1 ps B2) A2)) $;

--| A restricted quantifier over an image set. (Contributed by Mario Carneiro, 1-Sep-2015.)
theorem rexrnmpt2 {x3 y1 z: setvar} (ph: wff z) (ps: wff x3 y1) (A2: class x3) (B2 C F: class x3 y1) (V: class x3 y1 z):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wi (wceq (cv z) C) (wb ph ps) $ >
  $ wi (wral x3 (wral y1 (wcel C V) B2) A2) (wb (wrex z ph (crn F)) (wrex x3 (wrex y1 ps B2) A2)) $;

--| The value of an operation class abstraction. (Contributed by NM, 16-May-1995.) (Revised by David Abernethy, 19-Jun-2012.)
theorem ovid {x3 y1 z: setvar} (ph: wff x3 y1 z) (R S: class x3 y1) (F: class x3 y1 z):
  $ wi (wa (wcel (cv x3) R) (wcel (cv y1) S)) (weu z ph) $ >
  $ wceq F (coprab x3 y1 z (wa (wa (wcel (cv x3) R) (wcel (cv y1) S)) ph)) $ >
  $ wi (wa (wcel (cv x3) R) (wcel (cv y1) S)) (wb (wceq (co (cv x3) (cv y1) F) (cv z)) ph) $;

--| The value of an operation class abstraction. Compare ~ ovidi . The condition ` ( x e. R /\ y e. S ) ` is been removed. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem ovidig {x3 y1 z: setvar} (ph: wff x3 y1 z) (F: class x3 y1 z):
  $ wmo z ph $ >
  $ wceq F (coprab x3 y1 z ph) $ >
  $ wi ph (wceq (co (cv x3) (cv y1) F) (cv z)) $;

--| The value of an operation class abstraction (weak version). (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem ovidi {x3 y1 z: setvar} (ph: wff x3 y1 z) (R S: class x3 y1) (F: class x3 y1 z):
  $ wi (wa (wcel (cv x3) R) (wcel (cv y1) S)) (wmo z ph) $ >
  $ wceq F (coprab x3 y1 z (wa (wa (wcel (cv x3) R) (wcel (cv y1) S)) ph)) $ >
  $ wi (wa (wcel (cv x3) R) (wcel (cv y1) S)) (wi ph (wceq (co (cv x3) (cv y1) F) (cv z))) $;

--| The value of an operation class abstraction. (Contributed by NM, 16-May-1995.) (Revised by David Abernethy, 19-Jun-2012.)
theorem ov {x3 y1 z: setvar} (ph ps ch: wff x3 y1 z) (th: wff) (A2 B2 C R S: class) (F: class x3 y1 z):
  $ wcel C cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ wi (wa (wcel (cv x3) R) (wcel (cv y1) S)) (weu z ph) $ >
  $ wceq F (coprab x3 y1 z (wa (wa (wcel (cv x3) R) (wcel (cv y1) S)) ph)) $ >
  $ wi (wa (wcel A2 R) (wcel B2 S)) (wb (wceq (co A2 B2 F) C) th) $;

--| The value of an operation class abstraction. Compare ~ ovig . The condition ` ( x e. R /\ y e. S ) ` is been removed. (Contributed by FL, 24-Mar-2007.) (Revised by Mario Carneiro, 19-Dec-2013.)
theorem ovigg {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff) (A2 B2 C: class) (F V W X: class x3 y1 z):
  $ wi (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) (wb ph ps) $ >
  $ wmo z ph $ >
  $ wceq F (coprab x3 y1 z ph) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wi ps (wceq (co A2 B2 F) C)) $;

--| The value of an operation class abstraction (weak version). (Unnecessary distinct variable restrictions were removed by David Abernethy, 19-Jun-2012.) (Contributed by NM, 14-Sep-1999.) (Revised by Mario Carneiro, 19-Dec-2013.)
theorem ovig {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff) (A2 B2 C: class) (D: class x3 y1 z) (R S: class) (F: class x3 y1 z):
  $ wi (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) (wb ph ps) $ >
  $ wi (wa (wcel (cv x3) R) (wcel (cv y1) S)) (wmo z ph) $ >
  $ wceq F (coprab x3 y1 z (wa (wa (wcel (cv x3) R) (wcel (cv y1) S)) ph)) $ >
  $ wi (w3a (wcel A2 R) (wcel B2 S) (wcel C D)) (wi ps (wceq (co A2 B2 F) C)) $;

--| Value of a function given by the "maps to" notation. (This is the operation analog of ~ fvmpt2 .) (Contributed by NM, 21-Feb-2004.) (Revised by Mario Carneiro, 1-Sep-2015.)
theorem ovmpt4g {x3 y1: setvar} (A2 B2 C F V: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wi (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) (wcel C V)) (wceq (co (cv x3) (cv y1) F) C) $;

--| Value of a function given by the "maps to" notation, expressed using explicit substitution. (Contributed by Mario Carneiro, 30-Apr-2015.)
theorem ovmpt2s {x3 y1: setvar} (A2 B2 C D: class) (R F V: class x3 y1):
  $ wceq F (cmpt2 x3 y1 C D R) $ >
  $ wi (w3a (wcel A2 C) (wcel B2 D) (wcel (csb x3 A2 (csb y1 B2 R)) V)) (wceq (co A2 B2 F) (csb x3 A2 (csb y1 B2 R))) $;

--| The value of an operation class abstraction. A version of ~ ovmpt2g using bound-variable hypotheses. (Contributed by NM, 17-Aug-2006.) (Revised by Mario Carneiro, 19-Dec-2013.)
theorem ov2gf {x3 y1: setvar} (A2 B2: class x3 y1) (C D: class) (R S F G H: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc x3 G $ >
  $ wnfc y1 S $ >
  $ wi (wceq (cv x3) A2) (wceq R G) $ >
  $ wi (wceq (cv y1) B2) (wceq G S) $ >
  $ wceq F (cmpt2 x3 y1 C D R) $ >
  $ wi (w3a (wcel A2 C) (wcel B2 D) (wcel S H)) (wceq (co A2 B2 F) S) $;

--| Value of an operation given by a maps-to rule, deduction form. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem ovmpt2dxf {x3 y1: setvar} (ph: wff x3 y1) (A2: class y1) (B2: class x3) (C D R S F L X: class x3 y1):
  $ wi ph (wceq F (cmpt2 x3 y1 C D R)) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wceq R S) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq D L) $ >
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel B2 L) $ >
  $ wi ph (wcel S X) $ >
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wnfc y1 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 S $ >
  $ wnfc y1 S $ >
  $ wi ph (wceq (co A2 B2 F) S) $;

--| Value of an operation given by a maps-to rule, deduction form. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem ovmpt2dx {x3 y1: setvar} (ph: wff) (A2 B2: class) (C D R: class x3 y1) (S: class) (F L X: class x3 y1):
  $ wi ph (wceq F (cmpt2 x3 y1 C D R)) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wceq R S) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq D L) $ >
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel B2 L) $ >
  $ wi ph (wcel S X) $ >
  $ wi ph (wceq (co A2 B2 F) S) $;

--| Value of an operation given by a maps-to rule, deduction form. (Contributed by Mario Carneiro, 7-Dec-2014.)
theorem ovmpt2d {x3 y1: setvar} (ph: wff) (A2 B2: class) (C D R: class x3 y1) (S: class) (F X: class x3 y1):
  $ wi ph (wceq F (cmpt2 x3 y1 C D R)) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wceq R S) $ >
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wcel S X) $ >
  $ wi ph (wceq (co A2 B2 F) S) $;

--| The value of an operation class abstraction. Variant of ~ ovmpt2ga which does not require ` D ` and ` x ` to be distinct. (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by Mario Carneiro, 20-Dec-2013.)
theorem ovmpt2x {x3 y1: setvar} (A2 B2 C: class) (D R: class x3 y1) (S: class) (F H: class x3 y1) (L: class):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wceq R S) $ >
  $ wi (wceq (cv x3) A2) (wceq D L) $ >
  $ wceq F (cmpt2 x3 y1 C D R) $ >
  $ wi (w3a (wcel A2 C) (wcel B2 L) (wcel S H)) (wceq (co A2 B2 F) S) $;

--| Value of an operation given by a maps-to rule. (Contributed by Mario Carneiro, 19-Dec-2013.)
theorem ovmpt2ga {x3 y1: setvar} (A2 B2 C D: class) (R: class x3 y1) (S: class) (F H: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wceq R S) $ >
  $ wceq F (cmpt2 x3 y1 C D R) $ >
  $ wi (w3a (wcel A2 C) (wcel B2 D) (wcel S H)) (wceq (co A2 B2 F) S) $;

--| Value of an operation given by a maps-to rule. (Contributed by NM, 19-Dec-2013.)
theorem ovmpt2a {x3 y1: setvar} (A2 B2 C D: class) (R: class x3 y1) (S: class) (F: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wceq R S) $ >
  $ wceq F (cmpt2 x3 y1 C D R) $ >
  $ wcel S cvv $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wceq (co A2 B2 F) S) $;

--| Alternate deduction version of ~ ovmpt2 , suitable for iteration. (Contributed by Mario Carneiro, 7-Jan-2017.)
theorem ovmpt2df {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (A2: class) (B2: class x3) (C D R F V: class x3 y1):
  $ wi ph (wcel A2 C) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wcel B2 D) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wcel R V) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wi (wceq (co A2 B2 F) R) ps) $ >
  $ wnfc x3 F $ >
  $ wnf x3 ps $ >
  $ wnfc y1 F $ >
  $ wnf y1 ps $ >
  $ wi ph (wi (wceq F (cmpt2 x3 y1 C D R)) ps) $;

--| Alternate deduction version of ~ ovmpt2 , suitable for iteration. (Contributed by Mario Carneiro, 7-Jan-2017.)
theorem ovmpt2dv {x3 y1: setvar} (ph ps: wff) (A2: class) (B2: class x3) (C D R: class x3 y1) (F: class) (V: class x3 y1):
  $ wi ph (wcel A2 C) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wcel B2 D) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wcel R V) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wi (wceq (co A2 B2 F) R) ps) $ >
  $ wi ph (wi (wceq F (cmpt2 x3 y1 C D R)) ps) $;

--| Alternate deduction version of ~ ovmpt2 , suitable for iteration. (Contributed by Mario Carneiro, 7-Jan-2017.)
theorem ovmpt2dv2 {x3 y1: setvar} (ph: wff) (A2 B2: class) (C D R: class x3 y1) (S: class) (F V: class x3 y1):
  $ wi ph (wcel A2 C) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wcel B2 D) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wcel R V) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wceq R S) $ >
  $ wi ph (wi (wceq F (cmpt2 x3 y1 C D R)) (wceq (co A2 B2 F) S)) $;

--| Value of an operation given by a maps-to rule. Special case. (Contributed by NM, 14-Sep-1999.) (Revised by David Abernethy, 19-Jun-2012.)
theorem ovmpt2g {x3 y1: setvar} (A2 B2 C D: class) (R: class x3 y1) (S: class) (F G H: class x3 y1):
  $ wi (wceq (cv x3) A2) (wceq R G) $ >
  $ wi (wceq (cv y1) B2) (wceq G S) $ >
  $ wceq F (cmpt2 x3 y1 C D R) $ >
  $ wi (w3a (wcel A2 C) (wcel B2 D) (wcel S H)) (wceq (co A2 B2 F) S) $;

--| Value of an operation given by a maps-to rule. Special case. (Contributed by NM, 16-May-1995.) (Revised by David Abernethy, 19-Jun-2012.)
theorem ovmpt2 {x3 y1: setvar} (A2 B2 C D: class) (R: class x3 y1) (S: class) (F G: class x3 y1):
  $ wi (wceq (cv x3) A2) (wceq R G) $ >
  $ wi (wceq (cv y1) B2) (wceq G S) $ >
  $ wceq F (cmpt2 x3 y1 C D R) $ >
  $ wcel S cvv $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wceq (co A2 B2 F) S) $;

--| The value of an operation class abstraction. Special case. (Contributed by NM, 28-May-1995.) (Revised by Mario Carneiro, 29-Dec-2014.)
theorem ovi3 {x3 y1 z w v u f2: setvar} (A2 B2: class) (C D: class x3) (R: class w v u f2) (S: class x3 y1) (F: class x3 y1 z w v u f2) (H: class):
  $ wi (wa (wa (wcel A2 H) (wcel B2 H)) (wa (wcel C H) (wcel D H))) (wcel S (cxp H H)) $ >
  $ wi (wa (wa (wceq (cv w) A2) (wceq (cv v) B2)) (wa (wceq (cv u) C) (wceq (cv f2) D))) (wceq R S) $ >
  $ wceq F (coprab x3 y1 z (wa (wa (wcel (cv x3) (cxp H H)) (wcel (cv y1) (cxp H H))) (wex w (wex v (wex u (wex f2 (wa (wa (wceq (cv x3) (cop (cv w) (cv v))) (wceq (cv y1) (cop (cv u) (cv f2)))) (wceq (cv z) R)))))))) $ >
  $ wi (wa (wa (wcel A2 H) (wcel B2 H)) (wa (wcel C H) (wcel D H))) (wceq (co (cop A2 B2) (cop C D) F) S) $;

--| The value of an operation class abstraction. Special case. (Contributed by NM, 13-Nov-2006.)
theorem ov6g {x3 y1 z: setvar} (A2 B2 C: class) (R: class x3 y1) (S: class) (F G H J: class x3 y1 z):
  $ wi (wceq (cop (cv x3) (cv y1)) (cop A2 B2)) (wceq R S) $ >
  $ wceq F (coprab x3 y1 z (wa (wcel (cop (cv x3) (cv y1)) C) (wceq (cv z) R))) $ >
  $ wi (wa (w3a (wcel A2 G) (wcel B2 H) (wcel (cop A2 B2) C)) (wcel S J)) (wceq (co A2 B2 F) S) $;

--| The value of an operation class abstraction. (Contributed by Jeff Madsen, 10-Jun-2010.)
theorem ovg {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff y1 z) (ch: wff z) (th: wff) (ta: wff z) (A2 B2 C: class) (D: class x3 y1 z) (R S: class) (F: class x3 y1 z):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ wi (wa ta (wa (wcel (cv x3) R) (wcel (cv y1) S))) (weu z ph) $ >
  $ wceq F (coprab x3 y1 z (wa (wa (wcel (cv x3) R) (wcel (cv y1) S)) ph)) $ >
  $ wi (wa ta (w3a (wcel A2 R) (wcel B2 S) (wcel C D))) (wb (wceq (co A2 B2 F) C) th) $;

--| The value of a restricted operation. (Contributed by FL, 10-Nov-2006.)
theorem ovres (A2 B2 C D F: class):
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wceq (co A2 B2 (cres F (cxp C D))) (co A2 B2 F)) $;

--| Lemma for converting metric theorems to metric space theorems. (Contributed by Mario Carneiro, 2-Oct-2015.)
theorem ovresd (ph: wff) (A2 B2 D X: class):
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 X) $ >
  $ wi ph (wceq (co A2 B2 (cres D (cxp X X))) (co A2 B2 D)) $;

--| The value of a member of the domain of a subclass of an operation. (Contributed by NM, 23-Aug-2007.)
theorem oprssov (A2 B2 C D F G: class):
  $ wi (wa (w3a (wfun F) (wfn G (cxp C D)) (wss G F)) (wa (wcel A2 C) (wcel B2 D))) (wceq (co A2 B2 F) (co A2 B2 G)) $;

--| An operation's value belongs to its codomain. (Contributed by NM, 27-Aug-2006.)
theorem fovrn (A2 B2 C R S F: class):
  $ wi (w3a (wf (cxp R S) C F) (wcel A2 R) (wcel B2 S)) (wcel (co A2 B2 F) C) $;

--| An operation's value belongs to its codomain. (Contributed by Mario Carneiro, 29-Dec-2016.)
theorem fovrnda (ph: wff) (A2 B2 C R S F: class):
  $ wi ph (wf (cxp R S) C F) $ >
  $ wi (wa ph (wa (wcel A2 R) (wcel B2 S))) (wcel (co A2 B2 F) C) $;

--| An operation's value belongs to its codomain. (Contributed by Mario Carneiro, 29-Dec-2016.)
theorem fovrnd (ph: wff) (A2 B2 C R S F: class):
  $ wi ph (wf (cxp R S) C F) $ >
  $ wi ph (wcel A2 R) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel (co A2 B2 F) C) $;

--| The range of an operation expressed as a collection of the operation's values. (Contributed by NM, 29-Oct-2006.)
theorem fnrnov {x3 y1 z: setvar} (A2 B2 F: class):
  $ wi (wfn F (cxp A2 B2)) (wceq (crn F) (cab z (wrex x3 (wrex y1 (wceq (cv z) (co (cv x3) (cv y1) F)) B2) A2))) $;

--| An onto mapping of an operation expressed in terms of operation values. (Contributed by NM, 29-Oct-2006.)
theorem foov {x3 y1 z: setvar} (A2 B2: class) (C: class x3 y1) (F: class):
  $ wb (wfo (cxp A2 B2) C F) (wa (wf (cxp A2 B2) C F) (wral z (wrex x3 (wrex y1 (wceq (cv z) (co (cv x3) (cv y1) F)) B2) A2) C)) $;

--| An operation's value belongs to its range. (Contributed by NM, 10-Feb-2007.)
theorem fnovrn (A2 B2 C D F: class):
  $ wi (w3a (wfn F (cxp A2 B2)) (wcel C A2) (wcel D B2)) (wcel (co C D F) (crn F)) $;

--| A member of an operation's range is a value of the operation. (Contributed by NM, 7-Feb-2007.) (Revised by Mario Carneiro, 30-Jan-2014.)
theorem ovelrn {x3 y1: setvar} (A2 B2 C F: class):
  $ wi (wfn F (cxp A2 B2)) (wb (wcel C (crn F)) (wrex x3 (wrex y1 (wceq C (co (cv x3) (cv y1) F)) B2) A2)) $;

--| Membership relation for the values of a function whose image is a subclass. (Contributed by Mario Carneiro, 23-Dec-2013.)
theorem funimassov {x3 y1: setvar} (A2 B2 C F: class):
  $ wi (wa (wfun F) (wss (cxp A2 B2) (cdm F))) (wb (wss (cima F (cxp A2 B2)) C) (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) F) C) B2) A2)) $;

--| Operation value in an image. (Contributed by Mario Carneiro, 23-Dec-2013.) (Revised by Mario Carneiro, 29-Jan-2014.)
theorem ovelimab {x3 y1: setvar} (A2 B2 C D F: class):
  $ wi (wa (wfn F A2) (wss (cxp B2 C) A2)) (wb (wcel D (cima F (cxp B2 C))) (wrex x3 (wrex y1 (wceq D (co (cv x3) (cv y1) F)) C) B2)) $;

--| The value of a constant operation. (Contributed by NM, 5-Nov-2006.)
theorem ovconst2 (A2 B2 C R S: class):
  $ wcel C cvv $ >
  $ wi (wa (wcel R A2) (wcel S B2)) (wceq (co R S (cxp (cxp A2 B2) (csn C))) C) $;

--| Convert an operation closure law to class notation. (Contributed by Mario Carneiro, 26-May-2014.)
theorem caovclg {x3 y1: setvar} (ph: wff) (A2: class) (B2: class x3) (C D E F: class):
  $ wi (wa ph (wa (wcel (cv x3) C) (wcel (cv y1) D))) (wcel (co (cv x3) (cv y1) F) E) $ >
  $ wi (wa ph (wa (wcel A2 C) (wcel B2 D))) (wcel (co A2 B2 F) E) $;

--| Convert an operation closure law to class notation. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovcld {x3 y1: setvar} (ph: wff) (A2: class) (B2: class x3) (C D E F: class):
  $ wi (wa ph (wa (wcel (cv x3) C) (wcel (cv y1) D))) (wcel (co (cv x3) (cv y1) F) E) $ >
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wcel (co A2 B2 F) E) $;

--| Convert an operation closure law to class notation. (Contributed by NM, 4-Aug-1995.) (Revised by Mario Carneiro, 26-May-2014.)
theorem caovcl {x3 y1: setvar} (A2: class) (B2: class x3) (S F: class):
  $ wi (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wcel (co (cv x3) (cv y1) F) S) $ >
  $ wi (wa (wcel A2 S) (wcel B2 S)) (wcel (co A2 B2 F) S) $;

--| Convert an operation commutative law to class notation. (Contributed by Mario Carneiro, 1-Jun-2013.)
theorem caovcomg {x3 y1: setvar} (ph: wff) (A2 B2 S F: class):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi (wa ph (wa (wcel A2 S) (wcel B2 S))) (wceq (co A2 B2 F) (co B2 A2 F)) $;

--| Convert an operation commutative law to class notation. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovcomd {x3 y1: setvar} (ph: wff) (A2 B2 S F: class):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wceq (co A2 B2 F) (co B2 A2 F)) $;

--| Convert an operation commutative law to class notation. (Contributed by NM, 26-Aug-1995.) (Revised by Mario Carneiro, 1-Jun-2013.)
theorem caovcom {x3 y1: setvar} (A2 B2 F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F) $ >
  $ wceq (co A2 B2 F) (co B2 A2 F) $;

--| Convert an operation associative law to class notation. (Contributed by Mario Carneiro, 1-Jun-2013.) (Revised by Mario Carneiro, 26-May-2014.)
theorem caovassg {x3 y1 z: setvar} (ph: wff) (A2 B2 C S F: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F)) $ >
  $ wi (wa ph (w3a (wcel A2 S) (wcel B2 S) (wcel C S))) (wceq (co (co A2 B2 F) C F) (co A2 (co B2 C F) F)) $;

--| Convert an operation associative law to class notation. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovassd {x3 y1 z: setvar} (ph: wff) (A2 B2 C S F: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wceq (co (co A2 B2 F) C F) (co A2 (co B2 C F) F)) $;

--| Convert an operation associative law to class notation. (Contributed by NM, 26-Aug-1995.) (Revised by Mario Carneiro, 26-May-2014.)
theorem caovass {x3 y1 z: setvar} (A2 B2 C F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F) $ >
  $ wceq (co (co A2 B2 F) C F) (co A2 (co B2 C F) F) $;

--| Convert an operation cancellation law to class notation. (Contributed by NM, 20-Aug-1995.) (Revised by Mario Carneiro, 30-Dec-2014.)
theorem caovcang {x3 y1 z: setvar} (ph: wff) (A2 B2 C S T F: class):
  $ wi (wa ph (w3a (wcel (cv x3) T) (wcel (cv y1) S) (wcel (cv z) S))) (wb (wceq (co (cv x3) (cv y1) F) (co (cv x3) (cv z) F)) (wceq (cv y1) (cv z))) $ >
  $ wi (wa ph (w3a (wcel A2 T) (wcel B2 S) (wcel C S))) (wb (wceq (co A2 B2 F) (co A2 C F)) (wceq B2 C)) $;

--| Convert an operation cancellation law to class notation. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovcand {x3 y1 z: setvar} (ph: wff) (A2 B2 C S T F: class):
  $ wi (wa ph (w3a (wcel (cv x3) T) (wcel (cv y1) S) (wcel (cv z) S))) (wb (wceq (co (cv x3) (cv y1) F) (co (cv x3) (cv z) F)) (wceq (cv y1) (cv z))) $ >
  $ wi ph (wcel A2 T) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wb (wceq (co A2 B2 F) (co A2 C F)) (wceq B2 C)) $;

--| Commute the arguments of an operation cancellation law. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovcanrd {x3 y1 z: setvar} (ph: wff) (A2 B2 C S T F: class):
  $ wi (wa ph (w3a (wcel (cv x3) T) (wcel (cv y1) S) (wcel (cv z) S))) (wb (wceq (co (cv x3) (cv y1) F) (co (cv x3) (cv z) F)) (wceq (cv y1) (cv z))) $ >
  $ wi ph (wcel A2 T) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi ph (wb (wceq (co B2 A2 F) (co C A2 F)) (wceq B2 C)) $;

--| Convert an operation cancellation law to class notation. (Contributed by NM, 20-Aug-1995.)
theorem caovcan {x3 y1 z: setvar} (A2 B2 C S F: class):
  $ wcel C cvv $ >
  $ wi (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wi (wceq (co (cv x3) (cv y1) F) (co (cv x3) (cv z) F)) (wceq (cv y1) (cv z))) $ >
  $ wi (wa (wcel A2 S) (wcel B2 S)) (wi (wceq (co A2 B2 F) (co A2 C F)) (wceq B2 C)) $;

--| Convert an operation ordering law to class notation. (Contributed by Mario Carneiro, 31-Dec-2014.)
theorem caovordig {x3 y1 z: setvar} (ph: wff) (A2 B2 C R S F: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wi (wbr (cv x3) (cv y1) R) (wbr (co (cv z) (cv x3) F) (co (cv z) (cv y1) F) R)) $ >
  $ wi (wa ph (w3a (wcel A2 S) (wcel B2 S) (wcel C S))) (wi (wbr A2 B2 R) (wbr (co C A2 F) (co C B2 F) R)) $;

--| Convert an operation ordering law to class notation. (Contributed by Mario Carneiro, 31-Dec-2014.)
theorem caovordid {x3 y1 z: setvar} (ph: wff) (A2 B2 C R S F: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wi (wbr (cv x3) (cv y1) R) (wbr (co (cv z) (cv x3) F) (co (cv z) (cv y1) F) R)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wi (wbr A2 B2 R) (wbr (co C A2 F) (co C B2 F) R)) $;

--| Convert an operation ordering law to class notation. (Contributed by NM, 19-Feb-1996.) (Revised by Mario Carneiro, 30-Dec-2014.)
theorem caovordg {x3 y1 z: setvar} (ph: wff) (A2 B2 C R S F: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wb (wbr (cv x3) (cv y1) R) (wbr (co (cv z) (cv x3) F) (co (cv z) (cv y1) F) R)) $ >
  $ wi (wa ph (w3a (wcel A2 S) (wcel B2 S) (wcel C S))) (wb (wbr A2 B2 R) (wbr (co C A2 F) (co C B2 F) R)) $;

--| Convert an operation ordering law to class notation. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovordd {x3 y1 z: setvar} (ph: wff) (A2 B2 C R S F: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wb (wbr (cv x3) (cv y1) R) (wbr (co (cv z) (cv x3) F) (co (cv z) (cv y1) F) R)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wb (wbr A2 B2 R) (wbr (co C A2 F) (co C B2 F) R)) $;

--| Operation ordering law with commuted arguments. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovord2d {x3 y1 z: setvar} (ph: wff) (A2 B2 C R S F: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wb (wbr (cv x3) (cv y1) R) (wbr (co (cv z) (cv x3) F) (co (cv z) (cv y1) F) R)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi ph (wb (wbr A2 B2 R) (wbr (co A2 C F) (co B2 C F) R)) $;

--| Ordering law. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovord3d {x3 y1 z: setvar} (ph: wff) (A2 B2 C D R S F: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wb (wbr (cv x3) (cv y1) R) (wbr (co (cv z) (cv x3) F) (co (cv z) (cv y1) F) R)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi ph (wcel D S) $ >
  $ wi ph (wi (wceq (co A2 B2 F) (co C D F)) (wb (wbr A2 C R) (wbr D B2 R))) $;

--| Convert an operation ordering law to class notation. (Contributed by NM, 19-Feb-1996.)
theorem caovord {x3 y1 z: setvar} (A2 B2 C R S F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wcel (cv z) S) (wb (wbr (cv x3) (cv y1) R) (wbr (co (cv z) (cv x3) F) (co (cv z) (cv y1) F) R)) $ >
  $ wi (wcel C S) (wb (wbr A2 B2 R) (wbr (co C A2 F) (co C B2 F) R)) $;

--| Operation ordering law with commuted arguments. (Contributed by NM, 27-Feb-1996.)
theorem caovord2 {x3 y1 z: setvar} (A2 B2 C R S F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wcel (cv z) S) (wb (wbr (cv x3) (cv y1) R) (wbr (co (cv z) (cv x3) F) (co (cv z) (cv y1) F) R)) $ >
  $ wcel C cvv $ >
  $ wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F) $ >
  $ wi (wcel C S) (wb (wbr A2 B2 R) (wbr (co A2 C F) (co B2 C F) R)) $;

--| Ordering law. (Contributed by NM, 29-Feb-1996.)
theorem caovord3 {x3 y1 z: setvar} (A2 B2 C D R S F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wcel (cv z) S) (wb (wbr (cv x3) (cv y1) R) (wbr (co (cv z) (cv x3) F) (co (cv z) (cv y1) F) R)) $ >
  $ wcel C cvv $ >
  $ wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F) $ >
  $ wcel D cvv $ >
  $ wi (wa (wa (wcel B2 S) (wcel C S)) (wceq (co A2 B2 F) (co C D F))) (wb (wbr A2 C R) (wbr D B2 R)) $;

--| Convert an operation distributive law to class notation. (Contributed by NM, 25-Aug-1995.) (Revised by Mario Carneiro, 26-Jul-2014.)
theorem caovdig {x3 y1 z: setvar} (ph: wff) (A2 B2 C S F G H K: class):
  $ wi (wa ph (w3a (wcel (cv x3) K) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (cv x3) (co (cv y1) (cv z) F) G) (co (co (cv x3) (cv y1) G) (co (cv x3) (cv z) G) H)) $ >
  $ wi (wa ph (w3a (wcel A2 K) (wcel B2 S) (wcel C S))) (wceq (co A2 (co B2 C F) G) (co (co A2 B2 G) (co A2 C G) H)) $;

--| Convert an operation distributive law to class notation. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovdid {x3 y1 z: setvar} (ph: wff) (A2 B2 C S F G H K: class):
  $ wi (wa ph (w3a (wcel (cv x3) K) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (cv x3) (co (cv y1) (cv z) F) G) (co (co (cv x3) (cv y1) G) (co (cv x3) (cv z) G) H)) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wceq (co A2 (co B2 C F) G) (co (co A2 B2 G) (co A2 C G) H)) $;

--| Convert an operation distributive law to class notation. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovdir2d {x3 y1 z: setvar} (ph: wff) (A2 B2 C S F G: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (cv x3) (co (cv y1) (cv z) F) G) (co (co (cv x3) (cv y1) G) (co (cv x3) (cv z) G) F)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) F) S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) G) (co (cv y1) (cv x3) G)) $ >
  $ wi ph (wceq (co (co A2 B2 F) C G) (co (co A2 C G) (co B2 C G) F)) $;

--| Convert an operation reverse distributive law to class notation. (Contributed by Mario Carneiro, 19-Oct-2014.)
theorem caovdirg {x3 y1 z: setvar} (ph: wff) (A2 B2 C S F G H K: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) K))) (wceq (co (co (cv x3) (cv y1) F) (cv z) G) (co (co (cv x3) (cv z) G) (co (cv y1) (cv z) G) H)) $ >
  $ wi (wa ph (w3a (wcel A2 S) (wcel B2 S) (wcel C K))) (wceq (co (co A2 B2 F) C G) (co (co A2 C G) (co B2 C G) H)) $;

--| Convert an operation distributive law to class notation. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovdird {x3 y1 z: setvar} (ph: wff) (A2 B2 C S F G H K: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) K))) (wceq (co (co (cv x3) (cv y1) F) (cv z) G) (co (co (cv x3) (cv z) G) (co (cv y1) (cv z) G) H)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wceq (co (co A2 B2 F) C G) (co (co A2 C G) (co B2 C G) H)) $;

--| Convert an operation distributive law to class notation. (Contributed by NM, 25-Aug-1995.) (Revised by Mario Carneiro, 28-Jun-2013.)
theorem caovdi {x3 y1 z: setvar} (A2 B2 C F G: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wceq (co (cv x3) (co (cv y1) (cv z) F) G) (co (co (cv x3) (cv y1) G) (co (cv x3) (cv z) G) F) $ >
  $ wceq (co A2 (co B2 C F) G) (co (co A2 B2 G) (co A2 C G) F) $;

--| Rearrange arguments in a commutative, associative operation. (Contributed by NM, 26-Aug-1995.) (Revised by Mario Carneiro, 30-Dec-2014.)
theorem caov32d {x3 y1 z: setvar} (ph: wff) (A2 B2 C S F: class):
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F)) $ >
  $ wi ph (wceq (co (co A2 B2 F) C F) (co (co A2 C F) B2 F)) $;

--| Rearrange arguments in a commutative, associative operation. (Contributed by NM, 26-Aug-1995.) (Revised by Mario Carneiro, 30-Dec-2014.)
theorem caov12d {x3 y1 z: setvar} (ph: wff) (A2 B2 C S F: class):
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F)) $ >
  $ wi ph (wceq (co A2 (co B2 C F) F) (co B2 (co A2 C F) F)) $;

--| Rearrange arguments in a commutative, associative operation. (Contributed by NM, 26-Aug-1995.) (Revised by Mario Carneiro, 30-Dec-2014.)
theorem caov31d {x3 y1 z: setvar} (ph: wff) (A2 B2 C S F: class):
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F)) $ >
  $ wi ph (wceq (co (co A2 B2 F) C F) (co (co C B2 F) A2 F)) $;

--| Rearrange arguments in a commutative, associative operation. (Contributed by NM, 26-Aug-1995.) (Revised by Mario Carneiro, 30-Dec-2014.)
theorem caov13d {x3 y1 z: setvar} (ph: wff) (A2 B2 C S F: class):
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F)) $ >
  $ wi ph (wceq (co A2 (co B2 C F) F) (co C (co B2 A2 F) F)) $;

--| Rearrange arguments in a commutative, associative operation. (Contributed by NM, 26-Aug-1995.) (Revised by Mario Carneiro, 30-Dec-2014.)
theorem caov4d {x3 y1 z: setvar} (ph: wff) (A2 B2 C D S F: class):
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F)) $ >
  $ wi ph (wcel D S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) F) S) $ >
  $ wi ph (wceq (co (co A2 B2 F) (co C D F) F) (co (co A2 C F) (co B2 D F) F)) $;

--| Rearrange arguments in a commutative, associative operation. (Contributed by NM, 26-Aug-1995.) (Revised by Mario Carneiro, 30-Dec-2014.)
theorem caov411d {x3 y1 z: setvar} (ph: wff) (A2 B2 C D S F: class):
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F)) $ >
  $ wi ph (wcel D S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) F) S) $ >
  $ wi ph (wceq (co (co A2 B2 F) (co C D F) F) (co (co C B2 F) (co A2 D F) F)) $;

--| Rearrange arguments in a commutative, associative operation. (Contributed by NM, 26-Aug-1995.) (Revised by Mario Carneiro, 30-Dec-2014.)
theorem caov42d {x3 y1 z: setvar} (ph: wff) (A2 B2 C D S F: class):
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F)) $ >
  $ wi ph (wcel D S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) F) S) $ >
  $ wi ph (wceq (co (co A2 B2 F) (co C D F) F) (co (co A2 C F) (co D B2 F) F)) $;

--| Rearrange arguments in a commutative, associative operation. (Contributed by NM, 26-Aug-1995.)
theorem caov32 {x3 y1 z: setvar} (A2 B2 C F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F) $ >
  $ wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F) $ >
  $ wceq (co (co A2 B2 F) C F) (co (co A2 C F) B2 F) $;

--| Rearrange arguments in a commutative, associative operation. (Contributed by NM, 26-Aug-1995.)
theorem caov12 {x3 y1 z: setvar} (A2 B2 C F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F) $ >
  $ wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F) $ >
  $ wceq (co A2 (co B2 C F) F) (co B2 (co A2 C F) F) $;

--| Rearrange arguments in a commutative, associative operation. (Contributed by NM, 26-Aug-1995.)
theorem caov31 {x3 y1 z: setvar} (A2 B2 C F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F) $ >
  $ wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F) $ >
  $ wceq (co (co A2 B2 F) C F) (co (co C B2 F) A2 F) $;

--| Rearrange arguments in a commutative, associative operation. (Contributed by NM, 26-Aug-1995.)
theorem caov13 {x3 y1 z: setvar} (A2 B2 C F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F) $ >
  $ wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F) $ >
  $ wceq (co A2 (co B2 C F) F) (co C (co B2 A2 F) F) $;

--| Lemma used by real number construction. (Contributed by Jim Kingdon, 16-Sep-2019.)
theorem caovdilemd {x3 y1 z: setvar} (ph: wff) (A2 B2 C D S F G H: class):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) G) (co (cv y1) (cv x3) G)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) F) (cv z) G) (co (co (cv x3) (cv z) G) (co (cv y1) (cv z) G) F)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) G) (cv z) G) (co (cv x3) (co (cv y1) (cv z) G) G)) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) G) S) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wcel D S) $ >
  $ wi ph (wcel H S) $ >
  $ wi ph (wceq (co (co (co A2 C G) (co B2 D G) F) H G) (co (co A2 (co C H G) G) (co B2 (co D H G) G) F)) $;

--| Rearrangement of expression involving multiplication ( ` G ` ) and addition ( ` F ` ). (Contributed by Jim Kingdon, 3-Jan-2020.)
theorem caovlem2d {x3 y1 z: setvar} (ph: wff) (A2 B2 C D R S F G H: class):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) G) (co (cv y1) (cv x3) G)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) F) (cv z) G) (co (co (cv x3) (cv z) G) (co (cv y1) (cv z) G) F)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) G) (cv z) G) (co (cv x3) (co (cv y1) (cv z) G) G)) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) G) S) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wcel D S) $ >
  $ wi ph (wcel H S) $ >
  $ wi ph (wcel R S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F)) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) F) S) $ >
  $ wi ph (wceq (co (co (co (co A2 C G) (co B2 D G) F) H G) (co (co (co A2 D G) (co B2 C G) F) R G) F) (co (co A2 (co (co C H G) (co D R G) F) G) (co B2 (co (co C R G) (co D H G) F) G) F)) $;

--| Uniqueness of inverse element in commutative, associative operation with identity. The identity element is ` B ` . (Contributed by Jim Kingdon, 18-Sep-2019.)
theorem caovimo {x3 y1 z w: setvar} (A2: class) (B2: class z) (S F: class):
  $ wcel B2 S $ >
  $ wi (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S)) (wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F)) $ >
  $ wi (wcel (cv x3) S) (wceq (co (cv x3) B2 F) (cv x3)) $ >
  $ wi (wcel A2 S) (wmo w (wa (wcel (cv w) S) (wceq (co A2 (cv w) F) B2))) $;

--| Lemma for ~ grprinvd . (Contributed by NM, 9-Aug-2013.)
theorem grprinvlem {x3 y1 z: setvar} (ph: wff) (ps: wff x3 z) (B2 c_pl O: class) (X: class x3):
  $ wi (w3a ph (wcel (cv x3) B2) (wcel (cv y1) B2)) (wcel (co (cv x3) (cv y1) c_pl) B2) $ >
  $ wi ph (wcel O B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wceq (co O (cv x3) c_pl) (cv x3)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) B2) (wcel (cv y1) B2) (wcel (cv z) B2))) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_pl) (co (cv x3) (co (cv y1) (cv z) c_pl) c_pl)) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wrex y1 (wceq (co (cv y1) (cv x3) c_pl) O) B2) $ >
  $ wi (wa ph ps) (wcel X B2) $ >
  $ wi (wa ph ps) (wceq (co X X c_pl) X) $ >
  $ wi (wa ph ps) (wceq X O) $;

--| Deduce right inverse from left inverse and left identity in an associative structure (such as a group). (Contributed by NM, 10-Aug-2013.) (Proof shortened by Mario Carneiro, 6-Jan-2015.)
theorem grprinvd {x3 y1 z: setvar} (ph: wff) (ps: wff x3 z) (B2 c_pl: class) (N: class x3) (O: class) (X: class x3):
  $ wi (w3a ph (wcel (cv x3) B2) (wcel (cv y1) B2)) (wcel (co (cv x3) (cv y1) c_pl) B2) $ >
  $ wi ph (wcel O B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wceq (co O (cv x3) c_pl) (cv x3)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) B2) (wcel (cv y1) B2) (wcel (cv z) B2))) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_pl) (co (cv x3) (co (cv y1) (cv z) c_pl) c_pl)) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wrex y1 (wceq (co (cv y1) (cv x3) c_pl) O) B2) $ >
  $ wi (wa ph ps) (wcel X B2) $ >
  $ wi (wa ph ps) (wcel N B2) $ >
  $ wi (wa ph ps) (wceq (co N X c_pl) O) $ >
  $ wi (wa ph ps) (wceq (co X N c_pl) O) $;

--| Deduce right identity from left inverse and left identity in an associative structure (such as a group). (Contributed by NM, 10-Aug-2013.) (Proof shortened by Mario Carneiro, 6-Jan-2015.)
theorem grpridd {x3 y1 z: setvar} (ph: wff) (B2 c_pl O: class):
  $ wi (w3a ph (wcel (cv x3) B2) (wcel (cv y1) B2)) (wcel (co (cv x3) (cv y1) c_pl) B2) $ >
  $ wi ph (wcel O B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wceq (co O (cv x3) c_pl) (cv x3)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) B2) (wcel (cv y1) B2) (wcel (cv z) B2))) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_pl) (co (cv x3) (co (cv y1) (cv z) c_pl) c_pl)) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wrex y1 (wceq (co (cv y1) (cv x3) c_pl) O) B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wceq (co (cv x3) O c_pl) (cv x3)) $;

--| If a two-parameter class is not empty, constrain the implicit pair. (Contributed by Stefan O'Rear, 7-Mar-2015.)
theorem elmpt2cl {x3 y1: setvar} (A2 B2: class) (C S T F X: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wi (wcel X (co S T F)) (wa (wcel S A2) (wcel T B2)) $;

--| If a two-parameter class is not empty, the first argument is in its nominal domain. (Contributed by FL, 15-Oct-2012.) (Revised by Stefan O'Rear, 7-Mar-2015.)
theorem elmpt2cl1 {x3 y1: setvar} (A2 B2: class) (C S T F X: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wi (wcel X (co S T F)) (wcel S A2) $;

--| If a two-parameter class is not empty, the second argument is in its nominal domain. (Contributed by FL, 15-Oct-2012.) (Revised by Stefan O'Rear, 7-Mar-2015.)
theorem elmpt2cl2 {x3 y1: setvar} (A2 B2: class) (C S T F X: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wi (wcel X (co S T F)) (wcel T B2) $;

--| Utility lemma for two-parameter classes. (Contributed by Stefan O'Rear, 21-Jan-2015.)
theorem elovmpt2 {a b: setvar} (A2 B2: class) (C D: class a b) (E F X Y: class):
  $ wceq D (cmpt2 a b A2 B2 C) $ >
  $ wcel C cvv $ >
  $ wi (wa (wceq (cv a) X) (wceq (cv b) Y)) (wceq C E) $ >
  $ wb (wcel F (co X Y D)) (w3a (wcel X A2) (wcel Y B2) (wcel F E)) $;

--| Describe an implicit one-to-one onto function. (Contributed by Mario Carneiro, 30-Apr-2015.)
theorem f1ocnvd {x3 y1: setvar} (ph: wff) (A2 B2: class) (C: class x3) (D: class y1) (F W X: class x3 y1):
  $ wceq F (cmpt x3 A2 C) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C W) $ >
  $ wi (wa ph (wcel (cv y1) B2)) (wcel D X) $ >
  $ wi ph (wb (wa (wcel (cv x3) A2) (wceq (cv y1) C)) (wa (wcel (cv y1) B2) (wceq (cv x3) D))) $ >
  $ wi ph (wa (wf1o A2 B2 F) (wceq (ccnv F) (cmpt y1 B2 D))) $;

--| Describe an implicit one-to-one onto function. (Contributed by Mario Carneiro, 12-May-2014.)
theorem f1od {x3 y1: setvar} (ph: wff) (A2 B2: class) (C: class x3) (D: class y1) (F W X: class x3 y1):
  $ wceq F (cmpt x3 A2 C) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C W) $ >
  $ wi (wa ph (wcel (cv y1) B2)) (wcel D X) $ >
  $ wi ph (wb (wa (wcel (cv x3) A2) (wceq (cv y1) C)) (wa (wcel (cv y1) B2) (wceq (cv x3) D))) $ >
  $ wi ph (wf1o A2 B2 F) $;

--| Describe an implicit one-to-one onto function. (Contributed by Mario Carneiro, 30-Apr-2015.)
theorem f1ocnv2d {x3 y1: setvar} (ph: wff) (A2 B2: class) (C: class x3) (D: class y1) (F: class x3 y1):
  $ wceq F (cmpt x3 A2 C) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C B2) $ >
  $ wi (wa ph (wcel (cv y1) B2)) (wcel D A2) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wb (wceq (cv x3) D) (wceq (cv y1) C)) $ >
  $ wi ph (wa (wf1o A2 B2 F) (wceq (ccnv F) (cmpt y1 B2 D))) $;

--| Describe an implicit one-to-one onto function. (Contributed by Mario Carneiro, 12-May-2014.)
theorem f1o2d {x3 y1: setvar} (ph: wff) (A2 B2: class) (C: class x3) (D: class y1) (F: class x3 y1):
  $ wceq F (cmpt x3 A2 C) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C B2) $ >
  $ wi (wa ph (wcel (cv y1) B2)) (wcel D A2) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wb (wceq (cv x3) D) (wceq (cv y1) C)) $ >
  $ wi ph (wf1o A2 B2 F) $;

--| A one-to-one mapping induces a one-to-one mapping on power sets. This version of ~ f1opw avoids the Axiom of Replacement. (Contributed by Mario Carneiro, 26-Jun-2015.)
theorem f1opw2 {a b: setvar} (ph: wff) (A2 B2 F: class):
  $ wi ph (wf1o A2 B2 F) $ >
  $ wi ph (wcel (cima (ccnv F) (cv a)) cvv) $ >
  $ wi ph (wcel (cima F (cv b)) cvv) $ >
  $ wi ph (wf1o (cpw A2) (cpw B2) (cmpt b (cpw A2) (cima F (cv b)))) $;

--| A one-to-one mapping induces a one-to-one mapping on power sets. (Contributed by Stefan O'Rear, 18-Nov-2014.) (Revised by Mario Carneiro, 26-Jun-2015.)
theorem f1opw {b: setvar} (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wf1o (cpw A2) (cpw B2) (cmpt b (cpw A2) (cima F (cv b)))) $;

--| Formula building theorem for support restriction, on a function which preserves zero. (Contributed by Stefan O'Rear, 9-Mar-2015.)
theorem suppssfv {x3: setvar} (ph: wff) (A2 D F L V: class x3) (Y Z: class):
  $ wi ph (wss (cima (ccnv (cmpt x3 D A2)) (cdif cvv (csn Y))) L) $ >
  $ wi ph (wceq (cfv Y F) Z) $ >
  $ wi (wa ph (wcel (cv x3) D)) (wcel A2 V) $ >
  $ wi ph (wss (cima (ccnv (cmpt x3 D (cfv A2 F))) (cdif cvv (csn Z))) L) $;

--| Formula building theorem for support restrictions: operator with left annihilator. (Contributed by Stefan O'Rear, 9-Mar-2015.)
theorem suppssov1 {x3 v: setvar} (ph: wff) (A2: class x3 v) (B2: class x3) (D: class x3 v) (R: class x3) (L: class x3 v) (O: class x3) (V: class x3 v) (Y Z: class):
  $ wi ph (wss (cima (ccnv (cmpt x3 D A2)) (cdif cvv (csn Y))) L) $ >
  $ wi (wa ph (wcel (cv v) R)) (wceq (co Y (cv v) O) Z) $ >
  $ wi (wa ph (wcel (cv x3) D)) (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) D)) (wcel B2 R) $ >
  $ wi ph (wss (cima (ccnv (cmpt x3 D (co A2 B2 O))) (cdif cvv (csn Z))) L) $;

--| Extend class notation to include mapping of an operation to a function operation.
term cof (R: class): class;

--| Extend class notation to include mapping of a binary relation to a function relation.
term cofr (R: class): class;

--| Define the function operation map. The definition is designed so that if ` R ` is a binary operation, then ` oF R ` is the analogous operation on functions which corresponds to applying ` R ` pointwise to the values of the functions. (Contributed by Mario Carneiro, 20-Jul-2014.)
axiom df_of {x3 f2 g1: setvar} (R: class):
  $ wceq (cof R) (cmpt2 f2 g1 cvv cvv (cmpt x3 (cin (cdm (cv f2)) (cdm (cv g1))) (co (cfv (cv x3) (cv f2)) (cfv (cv x3) (cv g1)) R))) $;

--| Define the function relation map. The definition is designed so that if ` R ` is a binary relation, then ` oF R ` is the analogous relation on functions which is true when each element of the left function relates to the corresponding element of the right function. (Contributed by Mario Carneiro, 28-Jul-2014.)
axiom df_ofr {x3 f2 g1: setvar} (R: class):
  $ wceq (cofr R) (copab f2 g1 (wral x3 (wbr (cfv (cv x3) (cv f2)) (cfv (cv x3) (cv g1)) R) (cin (cdm (cv f2)) (cdm (cv g1))))) $;

--| Equality theorem for function operation. (Contributed by Mario Carneiro, 20-Jul-2014.)
theorem ofeq (R S: class):
  $ wi (wceq R S) (wceq (cof R) (cof S)) $;

--| Equality theorem for function relation. (Contributed by Mario Carneiro, 28-Jul-2014.)
theorem ofreq (R S: class):
  $ wi (wceq R S) (wceq (cofr R) (cofr S)) $;

--| A function operation restricted to a set is a set. (Contributed by NM, 28-Jul-2014.)
theorem ofexg (A2 R V: class):
  $ wi (wcel A2 V) (wcel (cres (cof R) A2) cvv) $;

--| Hypothesis builder for function operation. (Contributed by Mario Carneiro, 20-Jul-2014.)
theorem nfof {x3: setvar} (R: class):
  $ wnfc x3 R $ >
  $ wnfc x3 (cof R) $;

--| Hypothesis builder for function relation. (Contributed by Mario Carneiro, 28-Jul-2014.)
theorem nfofr {x3: setvar} (R: class):
  $ wnfc x3 R $ >
  $ wnfc x3 (cofr R) $;

--| Value of an operation applied to two functions. (Contributed by Mario Carneiro, 20-Jul-2014.)
theorem offval {x3: setvar} (ph: wff) (A2: class) (B2 C D: class x3) (R S F G: class) (V W: class x3):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wfn G B2) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq (cin A2 B2) S $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq (cfv (cv x3) F) C) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wceq (cfv (cv x3) G) D) $ >
  $ wi ph (wceq (co F G (cof R)) (cmpt x3 S (co C D R))) $;

--| Value of a relation applied to two functions. (Contributed by Mario Carneiro, 28-Jul-2014.)
theorem ofrfval {x3: setvar} (ph: wff) (A2: class) (B2 C D: class x3) (R S F G: class) (V W: class x3):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wfn G B2) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq (cin A2 B2) S $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq (cfv (cv x3) F) C) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wceq (cfv (cv x3) G) D) $ >
  $ wi ph (wb (wbr F G (cofr R)) (wral x3 (wbr C D R) S)) $;

--| Evaluate a function operation at a point. (Contributed by Mario Carneiro, 20-Jul-2014.)
theorem fnofval (ph: wff) (A2 B2 C D R S U F G V W X: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wfn G B2) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq (cin A2 B2) S $ >
  $ wi (wa ph (wcel X A2)) (wceq (cfv X F) C) $ >
  $ wi (wa ph (wcel X B2)) (wceq (cfv X G) D) $ >
  $ wi ph (wfn R (cxp U V)) $ >
  $ wi ph (wcel C U) $ >
  $ wi ph (wcel D V) $ >
  $ wi (wa ph (wcel X S)) (wceq (cfv X (co F G (cof R))) (co C D R)) $;

--| Exhibit a function relation at a point. (Contributed by Mario Carneiro, 28-Jul-2014.)
theorem ofrval (ph: wff) (A2 B2 C D R S F G V W X: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wfn G B2) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq (cin A2 B2) S $ >
  $ wi (wa ph (wcel X A2)) (wceq (cfv X F) C) $ >
  $ wi (wa ph (wcel X B2)) (wceq (cfv X G) D) $ >
  $ wi (w3a ph (wbr F G (cofr R)) (wcel X S)) (wbr C D R) $;

--| Value of a restriction of the function operation map. (Contributed by NM, 20-Oct-2014.)
theorem ofmresval (ph: wff) (A2 B2 R F G: class):
  $ wi ph (wcel F A2) $ >
  $ wi ph (wcel G B2) $ >
  $ wi ph (wceq (co F G (cres (cof R) (cxp A2 B2))) (co F G (cof R))) $;

--| The function operation produces a function. (Contributed by Mario Carneiro, 20-Jul-2014.)
theorem off {x3 y1: setvar} (ph: wff) (A2 B2 C: class x3 y1) (R S T U F: class) (G: class x3) (V W: class x3 y1):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) T))) (wcel (co (cv x3) (cv y1) R) U) $ >
  $ wi ph (wf A2 S F) $ >
  $ wi ph (wf B2 T G) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq (cin A2 B2) C $ >
  $ wi ph (wf C U (co F G (cof R))) $;

--| Restrict the operands of a function operation to the same domain as that of the operation itself. (Contributed by Mario Carneiro, 15-Sep-2014.)
theorem ofres (ph: wff) (A2 B2 C R F G V W: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wfn G B2) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq (cin A2 B2) C $ >
  $ wi ph (wceq (co F G (cof R)) (co (cres F C) (cres G C) (cof R))) $;

--| The function operation expressed as a mapping. (Contributed by Mario Carneiro, 20-Jul-2014.)
theorem offval2 {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (R: class) (F G V W X: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 W) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C X) $ >
  $ wi ph (wceq F (cmpt x3 A2 B2)) $ >
  $ wi ph (wceq G (cmpt x3 A2 C)) $ >
  $ wi ph (wceq (co F G (cof R)) (cmpt x3 A2 (co B2 C R))) $;

--| The function relation acting on maps. (Contributed by Mario Carneiro, 20-Jul-2014.)
theorem ofrfval2 {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (R: class) (F G V W X: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 W) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C X) $ >
  $ wi ph (wceq F (cmpt x3 A2 B2)) $ >
  $ wi ph (wceq G (cmpt x3 A2 C)) $ >
  $ wi ph (wb (wbr F G (cofr R)) (wral x3 (wbr B2 C R) A2)) $;

--| Formula building theorem for support restrictions: vector operation with left annihilator. (Contributed by Stefan O'Rear, 9-Mar-2015.)
theorem suppssof1 {v: setvar} (ph: wff) (A2: class v) (B2: class) (D: class v) (R: class) (L: class v) (O: class) (V W: class v) (Y Z: class):
  $ wi ph (wss (cima (ccnv A2) (cdif cvv (csn Y))) L) $ >
  $ wi (wa ph (wcel (cv v) R)) (wceq (co Y (cv v) O) Z) $ >
  $ wi ph (wf D V A2) $ >
  $ wi ph (wf D R B2) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wss (cima (ccnv (co A2 B2 (cof O))) (cdif cvv (csn Z))) L) $;

--| The composition of a function operation with another function. (Contributed by Mario Carneiro, 19-Dec-2014.)
theorem ofco (ph: wff) (A2 B2 C D R F G H V W X: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wfn G B2) $ >
  $ wi ph (wf D C H) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel D X) $ >
  $ wceq (cin A2 B2) C $ >
  $ wi ph (wceq (ccom (co F G (cof R)) H) (co (ccom F H) (ccom G H) (cof R))) $;

--| Equivalent expressions for equality with a function operation. (Contributed by NM, 9-Oct-2014.) (Proof shortened by Mario Carneiro, 5-Dec-2016.)
theorem offveqb {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (R F G H: class) (V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wfn F A2) $ >
  $ wi ph (wfn G A2) $ >
  $ wi ph (wfn H A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq (cfv (cv x3) F) B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq (cfv (cv x3) G) C) $ >
  $ wi ph (wb (wceq H (co F G (cof R))) (wral x3 (wceq (cfv (cv x3) H) (co B2 C R)) A2)) $;

--| Function operation on two constant functions. (Contributed by Mario Carneiro, 28-Jul-2014.)
theorem ofc12 (ph: wff) (A2 B2 C R V W X: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wceq (co (cxp A2 (csn B2)) (cxp A2 (csn C)) (cof R)) (cxp A2 (csn (co B2 C R)))) $;

--| Transfer a reflexive law to the function relation. (Contributed by Mario Carneiro, 28-Jul-2014.)
theorem caofref {x3: setvar} (ph: wff) (A2: class x3) (R S F: class) (V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wf A2 S F) $ >
  $ wi (wa ph (wcel (cv x3) S)) (wbr (cv x3) (cv x3) R) $ >
  $ wi ph (wbr F F (cofr R)) $;

--| Transfer a left inverse law to the function operation. (Contributed by NM, 22-Oct-2014.)
theorem caofinvl {x3 v: setvar} (ph: wff) (A2: class x3) (B2 R: class v) (S F: class) (G: class v) (N: class) (V W: class x3 v):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wf A2 S F) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wf S S N) $ >
  $ wi ph (wceq G (cmpt v A2 (cfv (cfv (cv v) F) N))) $ >
  $ wi (wa ph (wcel (cv x3) S)) (wceq (co (cfv (cv x3) N) (cv x3) R) B2) $ >
  $ wi ph (wceq (co G F (cof R)) (cxp A2 (csn B2))) $;

--| Transfer a commutative law to the function operation. (Contributed by Mario Carneiro, 26-Jul-2014.)
theorem caofcom {x3 y1: setvar} (ph: wff) (A2: class x3 y1) (R S F G: class) (V: class x3 y1):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wf A2 S F) $ >
  $ wi ph (wf A2 S G) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) R) (co (cv y1) (cv x3) R)) $ >
  $ wi ph (wceq (co F G (cof R)) (co G F (cof R))) $;

--| Transfer a relation subset law to the function relation. (Contributed by Mario Carneiro, 28-Jul-2014.)
theorem caofrss {x3 y1: setvar} (ph: wff) (A2: class x3 y1) (R S T F G: class) (V: class x3 y1):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wf A2 S F) $ >
  $ wi ph (wf A2 S G) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wi (wbr (cv x3) (cv y1) R) (wbr (cv x3) (cv y1) T)) $ >
  $ wi ph (wi (wbr F G (cofr R)) (wbr F G (cofr T))) $;

--| Transfer a transitivity law to the function relation. (Contributed by Mario Carneiro, 28-Jul-2014.)
theorem caoftrn {x3 y1 z: setvar} (ph: wff) (A2: class x3 y1 z) (R S T U F G H: class) (V: class x3 y1 z):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wf A2 S F) $ >
  $ wi ph (wf A2 S G) $ >
  $ wi ph (wf A2 S H) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) T)) (wbr (cv x3) (cv z) U)) $ >
  $ wi ph (wi (wa (wbr F G (cofr R)) (wbr G H (cofr T))) (wbr F H (cofr U))) $;

--| The restriction of a function to a set exists. Compare Proposition 6.17 of [TakeutiZaring] p. 28. This version has a shorter proof than ~ resfunexg but requires ~ ax-pow and ~ ax-un . (Contributed by NM, 7-Apr-1995.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem resfunexgALT (A2 B2 C: class):
  $ wi (wa (wfun A2) (wcel B2 C)) (wcel (cres A2 B2) cvv) $;

--| Existence of a composition when the first member is a function. (Contributed by NM, 8-Oct-2007.)
theorem cofunexg (A2 B2 C: class):
  $ wi (wa (wfun A2) (wcel B2 C)) (wcel (ccom A2 B2) cvv) $;

--| Existence of a composition when the second member is one-to-one. (Contributed by NM, 8-Oct-2007.)
theorem cofunex2g (A2 B2 V: class):
  $ wi (wa (wcel A2 V) (wfun (ccnv B2))) (wcel (ccom A2 B2) cvv) $;

--| If the domain of a function is a set, the function is a set. Theorem 6.16(1) of [TakeutiZaring] p. 28. This theorem is derived using the Axiom of Replacement in the form of ~ funimaexg . This version of ~ fnex uses ~ ax-pow and ~ ax-un , whereas ~ fnex does not. (Contributed by NM, 14-Aug-1994.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem fnexALT (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wcel A2 B2)) (wcel F cvv) $;

--| If the domain of a function exists, so does its range. Part of Theorem 4.15(v) of [Monk1] p. 46. This theorem is derived using the Axiom of Replacement in the form of ~ funex . (Contributed by NM, 11-Nov-1995.)
theorem funrnex (B2 F: class):
  $ wi (wcel (cdm F) B2) (wi (wfun F) (wcel (crn F) cvv)) $;

--| If the domain of an onto function exists, so does its codomain. (Contributed by NM, 23-Jul-2004.)
theorem fornex (A2 B2 C F: class):
  $ wi (wcel A2 C) (wi (wfo A2 B2 F) (wcel B2 cvv)) $;

--| If the codomain of a one-to-one function exists, so does its domain. This can be thought of as a form of the Axiom of Replacement. (Contributed by NM, 4-Sep-2004.)
theorem f1dmex (A2 B2 C F: class):
  $ wi (wa (wf1 A2 B2 F) (wcel B2 C)) (wcel A2 cvv) $;

--| Existence of a class abstraction of existentially restricted sets. ` x ` is normally a free-variable parameter in the class expression substituted for ` B ` , which can be thought of as ` B ( x ) ` . This simple-looking theorem is actually quite powerful and appears to involve the Axiom of Replacement in an intrinsic way, as can be seen by tracing back through the path ~ mptexg , ~ funex , ~ fnex , ~ resfunexg , and ~ funimaexg . See also ~ abrexex2 . (Contributed by NM, 16-Oct-2003.) (Proof shortened by Mario Carneiro, 31-Aug-2015.)
theorem abrexex {x3 y1: setvar} (A2: class) (B2: class x3):
  $ wcel A2 cvv $ >
  $ wcel (cab y1 (wrex x3 (wceq (cv y1) B2) A2)) cvv $;

--| Existence of a class abstraction of existentially restricted sets. ` x ` is normally a free-variable parameter in ` B ` . The antecedent assures us that ` A ` is a set. (Contributed by NM, 3-Nov-2003.)
theorem abrexexg {x3 y1: setvar} (A2: class) (B2: class x3) (V: class x3 y1):
  $ wi (wcel A2 V) (wcel (cab y1 (wrex x3 (wceq (cv y1) B2) A2)) cvv) $;

--| The existence of an indexed union. ` x ` is normally a free-variable parameter in ` B ` . (Contributed by NM, 23-Mar-2006.)
theorem iunexg {x3: setvar} (A2: class) (B2 V W: class x3):
  $ wi (wa (wcel A2 V) (wral x3 (wcel B2 W) A2)) (wcel (ciun x3 A2 B2) cvv) $;

--| Existence of an existentially restricted class abstraction. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem abrexex2g {x3 y1: setvar} (ph: wff x3 y1) (A2 V W: class):
  $ wi (wa (wcel A2 V) (wral x3 (wcel (cab y1 ph) W) A2)) (wcel (cab y1 (wrex x3 ph A2)) cvv) $;

--| Existence of an ordered pair abstraction, deduction version. (Contributed by Alexander van der Vekens, 19-Oct-2017.)
theorem opabex3d {x3 y1: setvar} (ph: wff y1) (ps: wff x3 y1) (A2: class):
  $ wi ph (wcel A2 cvv) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel (cab y1 ps) cvv) $ >
  $ wi ph (wcel (copab x3 y1 (wa (wcel (cv x3) A2) ps)) cvv) $;

--| Existence of an ordered pair abstraction. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem opabex3 {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wcel (cv x3) A2) (wcel (cab y1 ph) cvv) $ >
  $ wcel (copab x3 y1 (wa (wcel (cv x3) A2) ph)) cvv $;

--| The existence of an indexed union. ` x ` is normally a free-variable parameter in the class expression substituted for ` B ` , which can be read informally as ` B ( x ) ` . (Contributed by NM, 13-Oct-2003.)
theorem iunex {x3: setvar} (A2: class) (B2: class x3):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel (ciun x3 A2 B2) cvv $;

--| Existence of an existentially restricted class abstraction. ` ph ` is normally has free-variable parameters ` x ` and ` y ` . See also ~ abrexex . (Contributed by NM, 12-Sep-2004.)
theorem abrexex2 {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wcel A2 cvv $ >
  $ wcel (cab y1 ph) cvv $ >
  $ wcel (cab y1 (wrex x3 ph A2)) cvv $;

--| Existence of a class abstraction with an existentially quantified expression. Both ` x ` and ` y ` can be free in ` ph ` . (Contributed by NM, 29-Jul-2006.)
theorem abexssex {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wcel A2 cvv $ >
  $ wcel (cab y1 ph) cvv $ >
  $ wcel (cab y1 (wex x3 (wa (wss (cv x3) A2) ph))) cvv $;

--| A condition where a class builder continues to exist after its wff is existentially quantified. (Contributed by NM, 4-Mar-2007.)
theorem abexex {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wcel A2 cvv $ >
  $ wi ph (wcel (cv x3) A2) $ >
  $ wcel (cab y1 ph) cvv $ >
  $ wcel (cab y1 (wex x3 ph)) cvv $;

--| Existence of an operator abstraction. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem oprabexd {x3 y1 z: setvar} (ph: wff) (ps: wff x3 y1 z) (A2 B2: class) (F: class x3 y1 z):
  $ wi ph (wcel A2 cvv) $ >
  $ wi ph (wcel B2 cvv) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wmo z ps) $ >
  $ wi ph (wceq F (coprab x3 y1 z (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ps))) $ >
  $ wi ph (wcel F cvv) $;

--| Existence of an operation class abstraction. (Contributed by NM, 19-Oct-2004.)
theorem oprabex {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2 B2: class) (F: class x3 y1 z):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wmo z ph) $ >
  $ wceq F (coprab x3 y1 z (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph)) $ >
  $ wcel F cvv $;

--| Existence of an operation class abstraction (special case). (Contributed by NM, 19-Oct-2004.)
theorem oprabex3 {x3 y1 z w v u f2: setvar} (R: class w v u f2) (F: class x3 y1 z w v u f2) (H: class):
  $ wcel H cvv $ >
  $ wceq F (coprab x3 y1 z (wa (wa (wcel (cv x3) (cxp H H)) (wcel (cv y1) (cxp H H))) (wex w (wex v (wex u (wex f2 (wa (wa (wceq (cv x3) (cop (cv w) (cv v))) (wceq (cv y1) (cop (cv u) (cv f2)))) (wceq (cv z) R)))))))) $ >
  $ wcel F cvv $;

--| Existence of an existentially restricted operation abstraction. (Contributed by Jeff Madsen, 11-Jun-2010.)
theorem oprabrexex2 {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (A2: class):
  $ wcel A2 cvv $ >
  $ wcel (coprab x3 y1 z ph) cvv $ >
  $ wcel (coprab x3 y1 z (wrex w ph A2)) cvv $;

--| Existence of a class abstraction of existentially restricted sets. Variables ` x ` and ` y ` are normally free-variable parameters in the class expression substituted for ` C ` , which can be thought of as ` C ( x , y ) ` . See comments for ~ abrexex . (Contributed by NM, 20-Sep-2011.)
theorem ab2rexex {x3 y1 z: setvar} (A2: class y1) (B2: class x3) (C: class x3 y1):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel (cab z (wrex x3 (wrex y1 (wceq (cv z) C) B2) A2)) cvv $;

--| Existence of an existentially restricted class abstraction. ` ph ` normally has free-variable parameters ` x ` , ` y ` , and ` z ` . Compare ~ abrexex2 . (Contributed by NM, 20-Sep-2011.)
theorem ab2rexex2 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class y1) (B2: class x3):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel (cab z ph) cvv $ >
  $ wcel (cab z (wrex x3 (wrex y1 ph B2) A2)) cvv $;

--| The cross product of two sets is a set. Proposition 6.2 of [TakeutiZaring] p. 23. This version is proven using Replacement; see ~ xpexg for a version that uses the Power Set axiom instead. (Contributed by Mario Carneiro, 20-May-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem xpexgALT (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wcel (cxp A2 B2) cvv) $;

--| General value of ` ( F oF R G ) ` with no assumptions on functionality of ` F ` and ` G ` . (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem offval3 {x3: setvar} (R F G V W: class):
  $ wi (wa (wcel F V) (wcel G W)) (wceq (co F G (cof R)) (cmpt x3 (cin (cdm F) (cdm G)) (co (cfv (cv x3) F) (cfv (cv x3) G) R))) $;

--| Pointwise combination commutes with restriction. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem offres (D R F G V W: class):
  $ wi (wa (wcel F V) (wcel G W)) (wceq (cres (co F G (cof R)) D) (co (cres F D) (cres G D) (cof R))) $;

--| Equivalent expressions for a restriction of the function operation map. Unlike ` oF R ` which is a proper class, ` ( oF R | `` ( A X. B ) ) ` can be a set by ~ ofmresex , allowing it to be used as a function or structure argument. By ~ ofmresval , the restricted operation map values are the same as the original values, allowing theorems for ` oF R ` to be reused. (Contributed by NM, 20-Oct-2014.)
theorem ofmres {f2 g1: setvar} (A2 B2 R: class):
  $ wceq (cres (cof R) (cxp A2 B2)) (cmpt2 f2 g1 A2 B2 (co (cv f2) (cv g1) (cof R))) $;

--| Existence of a restriction of the function operation map. (Contributed by NM, 20-Oct-2014.)
theorem ofmresex (ph: wff) (A2 B2 R V W: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel (cres (cof R) (cxp A2 B2)) cvv) $;

--| Extend the definition of a class to include the first member an ordered pair function.
term c1st: class;

--| Extend the definition of a class to include the second member an ordered pair function.
term c2nd: class;

--| Define a function that extracts the first member, or abscissa, of an ordered pair. Theorem ~ op1st proves that it does this. For example, ( ` 1st `` <. ` 3 , 4 ` >. ` ) = 3 . Equivalent to Definition 5.13 (i) of [Monk1] p. 52 (compare ~ op1sta and ~ op1stb ). The notation is the same as Monk's. (Contributed by NM, 9-Oct-2004.)
axiom df_1st {x3: setvar}:
  $ wceq c1st (cmpt x3 cvv (cuni (cdm (csn (cv x3))))) $;

--| Define a function that extracts the second member, or ordinate, of an ordered pair. Theorem ~ op2nd proves that it does this. For example, ` ( 2nd `` <. ` 3 , 4 ` >. ` ) = 4 . Equivalent to Definition 5.13 (ii) of [Monk1] p. 52 (compare ~ op2nda and ~ op2ndb ). The notation is the same as Monk's. (Contributed by NM, 9-Oct-2004.)
axiom df_2nd {x3: setvar}:
  $ wceq c2nd (cmpt x3 cvv (cuni (crn (csn (cv x3))))) $;

--| The value of the function that extracts the first member of an ordered pair. (Contributed by NM, 9-Oct-2004.) (Revised by Mario Carneiro, 8-Sep-2013.)
theorem _1stvalg (A2: class):
  $ wi (wcel A2 cvv) (wceq (cfv A2 c1st) (cuni (cdm (csn A2)))) $;

--| The value of the function that extracts the second member of an ordered pair. (Contributed by NM, 9-Oct-2004.) (Revised by Mario Carneiro, 8-Sep-2013.)
theorem _2ndvalg (A2: class):
  $ wi (wcel A2 cvv) (wceq (cfv A2 c2nd) (cuni (crn (csn A2)))) $;

--| The value of the first-member function at the empty set. (Contributed by NM, 23-Apr-2007.)
theorem _1st0:
  $ wceq (cfv c0 c1st) c0 $;

--| The value of the second-member function at the empty set. (Contributed by NM, 23-Apr-2007.)
theorem _2nd0:
  $ wceq (cfv c0 c2nd) c0 $;

--| Extract the first member of an ordered pair. (Contributed by NM, 5-Oct-2004.)
theorem op1st (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cfv (cop A2 B2) c1st) A2 $;

--| Extract the second member of an ordered pair. (Contributed by NM, 5-Oct-2004.)
theorem op2nd (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cfv (cop A2 B2) c2nd) B2 $;

--| Extract the first member of an ordered pair. (Contributed by Mario Carneiro, 31-Aug-2015.)
theorem op1std (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq C (cop A2 B2)) (wceq (cfv C c1st) A2) $;

--| Extract the second member of an ordered pair. (Contributed by Mario Carneiro, 31-Aug-2015.)
theorem op2ndd (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq C (cop A2 B2)) (wceq (cfv C c2nd) B2) $;

--| Extract the first member of an ordered pair. (Contributed by NM, 19-Jul-2005.)
theorem op1stg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (cfv (cop A2 B2) c1st) A2) $;

--| Extract the second member of an ordered pair. (Contributed by NM, 19-Jul-2005.)
theorem op2ndg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (cfv (cop A2 B2) c2nd) B2) $;

--| Extract the first member of an ordered triple. (Due to infrequent usage, it isn't worthwhile at this point to define special extractors for triples, so we reuse the ordered pair extractors for ~ ot1stg , ~ ot2ndg , ~ ot3rdgg .) (Contributed by NM, 3-Apr-2015.) (Revised by Mario Carneiro, 2-May-2015.)
theorem ot1stg (A2 B2 C V W X: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wceq (cfv (cfv (cotp A2 B2 C) c1st) c1st) A2) $;

--| Extract the second member of an ordered triple. (See ~ ot1stg comment.) (Contributed by NM, 3-Apr-2015.) (Revised by Mario Carneiro, 2-May-2015.)
theorem ot2ndg (A2 B2 C V W X: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wceq (cfv (cfv (cotp A2 B2 C) c1st) c2nd) B2) $;

--| Extract the third member of an ordered triple. (See ~ ot1stg comment.) (Contributed by NM, 3-Apr-2015.)
theorem ot3rdgg (A2 B2 C V W X: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wceq (cfv (cotp A2 B2 C) c2nd) C) $;

--| Alternate value of the function that extracts the first member of an ordered pair. Definition 5.13 (i) of [Monk1] p. 52. (Contributed by NM, 18-Aug-2006.)
theorem _1stval2 (A2: class):
  $ wi (wcel A2 (cxp cvv cvv)) (wceq (cfv A2 c1st) (cint (cint A2))) $;

--| Alternate value of the function that extracts the second member of an ordered pair. Definition 5.13 (ii) of [Monk1] p. 52. (Contributed by NM, 18-Aug-2006.)
theorem _2ndval2 (A2: class):
  $ wi (wcel A2 (cxp cvv cvv)) (wceq (cfv A2 c2nd) (cint (cint (cint (ccnv (csn A2)))))) $;

--| The ` 1st ` function maps the universe onto the universe. (Contributed by NM, 14-Oct-2004.) (Revised by Mario Carneiro, 8-Sep-2013.)
theorem fo1st:
  $ wfo cvv cvv c1st $;

--| The ` 2nd ` function maps the universe onto the universe. (Contributed by NM, 14-Oct-2004.) (Revised by Mario Carneiro, 8-Sep-2013.)
theorem fo2nd:
  $ wfo cvv cvv c2nd $;

--| Mapping of a restriction of the ` 1st ` (first member of an ordered pair) function. (Contributed by NM, 11-Oct-2004.) (Revised by Mario Carneiro, 8-Sep-2013.)
theorem f1stres (A2 B2: class):
  $ wf (cxp A2 B2) A2 (cres c1st (cxp A2 B2)) $;

--| Mapping of a restriction of the ` 2nd ` (second member of an ordered pair) function. (Contributed by NM, 7-Aug-2006.) (Revised by Mario Carneiro, 8-Sep-2013.)
theorem f2ndres (A2 B2: class):
  $ wf (cxp A2 B2) B2 (cres c2nd (cxp A2 B2)) $;

--| Onto mapping of a restriction of the ` 1st ` (first member of an ordered pair) function. (Contributed by Jim Kingdon, 24-Jan-2019.)
theorem fo1stresm {y1: setvar} (A2: class y1) (B2: class):
  $ wi (wex y1 (wcel (cv y1) B2)) (wfo (cxp A2 B2) A2 (cres c1st (cxp A2 B2))) $;

--| Onto mapping of a restriction of the ` 2nd ` (second member of an ordered pair) function. (Contributed by Jim Kingdon, 24-Jan-2019.)
theorem fo2ndresm {x3: setvar} (A2: class) (B2: class x3):
  $ wi (wex x3 (wcel (cv x3) A2)) (wfo (cxp A2 B2) B2 (cres c2nd (cxp A2 B2))) $;

--| Composition of the first member function with another function. (Contributed by NM, 12-Oct-2007.)
theorem _1stcof (A2 B2 C F: class):
  $ wi (wf A2 (cxp B2 C) F) (wf A2 B2 (ccom c1st F)) $;

--| Composition of the second member function with another function. (Contributed by FL, 15-Oct-2012.)
theorem _2ndcof (A2 B2 C F: class):
  $ wi (wf A2 (cxp B2 C) F) (wf A2 C (ccom c2nd F)) $;

--| Location of the first element of a Cartesian product. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem xp1st (A2 B2 C: class):
  $ wi (wcel A2 (cxp B2 C)) (wcel (cfv A2 c1st) B2) $;

--| Location of the second element of a Cartesian product. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem xp2nd (A2 B2 C: class):
  $ wi (wcel A2 (cxp B2 C)) (wcel (cfv A2 c2nd) C) $;

--| Existence of the first member of a set. (Contributed by Jim Kingdon, 26-Jan-2019.)
theorem _1stexg (A2 V: class):
  $ wi (wcel A2 V) (wcel (cfv A2 c1st) cvv) $;

--| Existence of the first member of a set. (Contributed by Jim Kingdon, 26-Jan-2019.)
theorem _2ndexg (A2 V: class):
  $ wi (wcel A2 V) (wcel (cfv A2 c2nd) cvv) $;

--| Membership in a cross product. This version requires no quantifiers or dummy variables. See also ~ elxp4 . (Contributed by NM, 9-Oct-2004.)
theorem elxp6 (A2 B2 C: class):
  $ wb (wcel A2 (cxp B2 C)) (wa (wceq A2 (cop (cfv A2 c1st) (cfv A2 c2nd))) (wa (wcel (cfv A2 c1st) B2) (wcel (cfv A2 c2nd) C))) $;

--| Membership in a cross product. This version requires no quantifiers or dummy variables. See also ~ elxp4 . (Contributed by NM, 19-Aug-2006.)
theorem elxp7 (A2 B2 C: class):
  $ wb (wcel A2 (cxp B2 C)) (wa (wcel A2 (cxp cvv cvv)) (wa (wcel (cfv A2 c1st) B2) (wcel (cfv A2 c2nd) C))) $;

--| Equality with an ordered pair. (Contributed by NM, 15-Dec-2008.) (Revised by Mario Carneiro, 23-Feb-2014.)
theorem eqopi (A2 B2 C V W: class):
  $ wi (wa (wcel A2 (cxp V W)) (wa (wceq (cfv A2 c1st) B2) (wceq (cfv A2 c2nd) C))) (wceq A2 (cop B2 C)) $;

--| Representation of cross product based on ordered pair component functions. (Contributed by NM, 16-Sep-2006.)
theorem xp2 {x3: setvar} (A2 B2: class):
  $ wceq (cxp A2 B2) (crab x3 (wa (wcel (cfv (cv x3) c1st) A2) (wcel (cfv (cv x3) c2nd) B2)) (cxp cvv cvv)) $;

--| The membership relation for a cross product is inherited by union. (Contributed by NM, 16-Sep-2006.)
theorem unielxp (A2 B2 C: class):
  $ wi (wcel A2 (cxp B2 C)) (wcel (cuni A2) (cuni (cxp B2 C))) $;

--| Reconstruction of a member of a cross product in terms of its ordered pair components. (Contributed by NM, 20-Oct-2013.)
theorem _1st2nd2 (A2 B2 C: class):
  $ wi (wcel A2 (cxp B2 C)) (wceq A2 (cop (cfv A2 c1st) (cfv A2 c2nd))) $;

--| An ordered pair theorem for members of cross products. (Contributed by NM, 20-Jun-2007.)
theorem xpopth (A2 B2 C D R S: class):
  $ wi (wa (wcel A2 (cxp C D)) (wcel B2 (cxp R S))) (wb (wa (wceq (cfv A2 c1st) (cfv B2 c1st)) (wceq (cfv A2 c2nd) (cfv B2 c2nd))) (wceq A2 B2)) $;

--| Two ways to express equality with an ordered pair. (Contributed by NM, 3-Sep-2007.) (Proof shortened by Mario Carneiro, 26-Apr-2015.)
theorem eqop (A2 B2 C V W: class):
  $ wi (wcel A2 (cxp V W)) (wb (wceq A2 (cop B2 C)) (wa (wceq (cfv A2 c1st) B2) (wceq (cfv A2 c2nd) C))) $;

--| Two ways to express equality with an ordered pair. (Contributed by NM, 25-Feb-2014.)
theorem eqop2 (A2 B2 C: class):
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wb (wceq A2 (cop B2 C)) (wa (wcel A2 (cxp cvv cvv)) (wa (wceq (cfv A2 c1st) B2) (wceq (cfv A2 c2nd) C))) $;

--| Two ways of expressing that an element is the first member of an ordered pair. (Contributed by NM, 22-Sep-2013.) (Revised by Mario Carneiro, 23-Feb-2014.)
theorem op1steq {x3: setvar} (A2 B2: class) (V W: class x3):
  $ wi (wcel A2 (cxp V W)) (wb (wceq (cfv A2 c1st) B2) (wex x3 (wceq A2 (cop B2 (cv x3))))) $;

--| Swap the members of an ordered pair. (Contributed by NM, 31-Dec-2014.)
theorem _2nd1st (A2 B2 C: class):
  $ wi (wcel A2 (cxp B2 C)) (wceq (cuni (ccnv (csn A2))) (cop (cfv A2 c2nd) (cfv A2 c1st))) $;

--| Reconstruction of a member of a relation in terms of its ordered pair components. (Contributed by NM, 29-Aug-2006.)
theorem _1st2nd (A2 B2: class):
  $ wi (wa (wrel B2) (wcel A2 B2)) (wceq A2 (cop (cfv A2 c1st) (cfv A2 c2nd))) $;

--| The first ordered pair component of a member of a relation belongs to the domain of the relation. (Contributed by NM, 17-Sep-2006.)
theorem _1stdm (A2 R: class):
  $ wi (wa (wrel R) (wcel A2 R)) (wcel (cfv A2 c1st) (cdm R)) $;

--| The second ordered pair component of a member of a relation belongs to the range of the relation. (Contributed by NM, 17-Sep-2006.)
theorem _2ndrn (A2 R: class):
  $ wi (wa (wrel R) (wcel A2 R)) (wcel (cfv A2 c2nd) (crn R)) $;

--| Express an element of a relation as a relationship between first and second components. (Contributed by Mario Carneiro, 22-Jun-2016.)
theorem _1st2ndbr (A2 B2: class):
  $ wi (wa (wrel B2) (wcel A2 B2)) (wbr (cfv A2 c1st) (cfv A2 c2nd) B2) $;

--| Two ways of expressing membership in the domain of a relation. (Contributed by NM, 22-Sep-2013.)
theorem releldm2 {x3: setvar} (A2 B2: class):
  $ wi (wrel A2) (wb (wcel B2 (cdm A2)) (wrex x3 (wceq (cfv (cv x3) c1st) B2) A2)) $;

--| An expression for the domain of a relation. (Contributed by NM, 22-Sep-2013.)
theorem reldm {x3: setvar} (A2: class):
  $ wi (wrel A2) (wceq (cdm A2) (crn (cmpt x3 A2 (cfv (cv x3) c1st)))) $;

--| Equality theorem for substitution of a class for an ordered pair (analog of ~ sbceq1a that avoids the existential quantifiers of ~ copsexg ). (Contributed by NM, 19-Aug-2006.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem sbcopeq1a {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wi (wceq A2 (cop (cv x3) (cv y1))) (wb (wsbc x3 (wsbc y1 ph (cfv A2 c2nd)) (cfv A2 c1st)) ph) $;

--| Equality theorem for substitution of a class ` A ` for an ordered pair ` <. x , y >. ` in ` B ` (analog of ~ csbeq1a ). (Contributed by NM, 19-Aug-2006.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem csbopeq1a {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wi (wceq A2 (cop (cv x3) (cv y1))) (wceq (csb x3 (cfv A2 c1st) (csb y1 (cfv A2 c2nd) B2)) B2) $;

--| A way to define an ordered-pair class abstraction without using existential quantifiers. (Contributed by NM, 18-Aug-2006.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem dfopab2 {x3 y1 z: setvar} (ph: wff x3 y1):
  $ wceq (copab x3 y1 ph) (crab z (wsbc x3 (wsbc y1 ph (cfv (cv z) c2nd)) (cfv (cv z) c1st)) (cxp cvv cvv)) $;

--| A way to define an operation class abstraction without using existential quantifiers. (Contributed by NM, 18-Aug-2006.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem dfoprab3s {x3 y1 z w: setvar} (ph: wff x3 y1 z):
  $ wceq (coprab x3 y1 z ph) (copab w z (wa (wcel (cv w) (cxp cvv cvv)) (wsbc x3 (wsbc y1 ph (cfv (cv w) c2nd)) (cfv (cv w) c1st)))) $;

--| Operation class abstraction expressed without existential quantifiers. (Contributed by NM, 16-Dec-2008.)
theorem dfoprab3 {x3 y1 z w: setvar} (ph: wff z w) (ps: wff x3 y1 z):
  $ wi (wceq (cv w) (cop (cv x3) (cv y1))) (wb ph ps) $ >
  $ wceq (copab w z (wa (wcel (cv w) (cxp cvv cvv)) ph)) (coprab x3 y1 z ps) $;

--| Operation class abstraction expressed without existential quantifiers. (Contributed by NM, 3-Sep-2007.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem dfoprab4 {x3 y1 z w: setvar} (ph: wff z w) (ps: wff x3 y1 z) (A2 B2: class z):
  $ wi (wceq (cv w) (cop (cv x3) (cv y1))) (wb ph ps) $ >
  $ wceq (copab w z (wa (wcel (cv w) (cxp A2 B2)) ph)) (coprab x3 y1 z (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ps)) $;

--| Operation class abstraction expressed without existential quantifiers. (Unnecessary distinct variable restrictions were removed by David Abernethy, 19-Jun-2012.) (Contributed by NM, 20-Dec-2008.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem dfoprab4f {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (ps: wff x3 y1 z) (A2 B2: class z):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi (wceq (cv w) (cop (cv x3) (cv y1))) (wb ph ps) $ >
  $ wceq (copab w z (wa (wcel (cv w) (cxp A2 B2)) ph)) (coprab x3 y1 z (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ps)) $;

--| Define the cross product of three classes. Compare ~ df-xp . (Contributed by FL, 6-Nov-2013.) (Proof shortened by Mario Carneiro, 3-Nov-2015.)
theorem dfxp3 {x3 y1 z: setvar} (A2 B2 C: class):
  $ wceq (cxp (cxp A2 B2) C) (coprab x3 y1 z (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) (wcel (cv z) C))) $;

--| A consequence of membership in an ordered-pair class abstraction, using ordered pair extractors. (Contributed by NM, 29-Aug-2006.)
theorem elopabi {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2: class):
  $ wi (wceq (cv x3) (cfv A2 c1st)) (wb ph ps) $ >
  $ wi (wceq (cv y1) (cfv A2 c2nd)) (wb ps ch) $ >
  $ wi (wcel A2 (copab x3 y1 ph)) ch $;

--| A consequence of membership in an operation class abstraction, using ordered pair extractors. (Contributed by NM, 6-Nov-2006.) (Revised by David Abernethy, 19-Jun-2012.)
theorem eloprabi {x3 y1 z: setvar} (ph ps ch: wff x3 y1 z) (th: wff) (A2: class):
  $ wi (wceq (cv x3) (cfv (cfv A2 c1st) c1st)) (wb ph ps) $ >
  $ wi (wceq (cv y1) (cfv (cfv A2 c1st) c2nd)) (wb ps ch) $ >
  $ wi (wceq (cv z) (cfv A2 c2nd)) (wb ch th) $ >
  $ wi (wcel A2 (coprab x3 y1 z ph)) th $;

--| Express a two-argument function as a one-argument function, or vice-versa. (Contributed by Mario Carneiro, 24-Dec-2016.)
theorem mpt2mptsx {x3 y1 z: setvar} (A2: class) (B2: class x3) (C: class x3 y1):
  $ wceq (cmpt2 x3 y1 A2 B2 C) (cmpt z (ciun x3 A2 (cxp (csn (cv x3)) B2)) (csb x3 (cfv (cv z) c1st) (csb y1 (cfv (cv z) c2nd) C))) $;

--| Express a two-argument function as a one-argument function, or vice-versa. (Contributed by Mario Carneiro, 24-Sep-2015.)
theorem mpt2mpts {x3 y1 z: setvar} (A2 B2: class) (C: class x3 y1):
  $ wceq (cmpt2 x3 y1 A2 B2 C) (cmpt z (cxp A2 B2) (csb x3 (cfv (cv z) c1st) (csb y1 (cfv (cv z) c2nd) C))) $;

--| The domain of a mapping is a subset of its base class. (Contributed by Mario Carneiro, 9-Feb-2015.)
theorem dmmpt2ssx {x3 y1: setvar} (A2: class) (B2: class x3) (C F: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wss (cdm F) (ciun x3 A2 (cxp (csn (cv x3)) B2)) $;

--| Functionality, domain and codomain of a class given by the "maps to" notation, where ` B ( x ) ` is not constant but depends on ` x ` . (Contributed by NM, 29-Dec-2014.)
theorem fmpt2x {x3 y1: setvar} (A2: class) (B2: class x3) (C: class x3 y1) (D: class) (F: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wb (wral x3 (wral y1 (wcel C D) B2) A2) (wf (ciun x3 A2 (cxp (csn (cv x3)) B2)) D F) $;

--| Functionality, domain and range of a class given by the "maps to" notation. (Contributed by FL, 17-May-2010.)
theorem fmpt2 {x3 y1: setvar} (A2 B2: class) (C: class x3 y1) (D: class) (F: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wb (wral x3 (wral y1 (wcel C D) B2) A2) (wf (cxp A2 B2) D F) $;

--| Functionality and domain of a class given by the "maps to" notation. (Contributed by FL, 17-May-2010.)
theorem fnmpt2 {x3 y1: setvar} (A2 B2: class) (C F V: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wi (wral x3 (wral y1 (wcel C V) B2) A2) (wfn F (cxp A2 B2)) $;

--| Sufficient condition for an operation maps-to notation to be set-like. (Contributed by Mario Carneiro, 3-Jul-2019.)
theorem mpt2fvex {x3 y1: setvar} (A2 B2: class) (C R S F V W X: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wi (w3a (wal x3 (wal y1 (wcel C V))) (wcel R W) (wcel S X)) (wcel (co R S F) cvv) $;

--| Functionality and domain of a class given by the "maps to" notation. (Contributed by FL, 17-May-2010.)
theorem fnmpt2i {x3 y1: setvar} (A2 B2: class) (C F: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wcel C cvv $ >
  $ wfn F (cxp A2 B2) $;

--| Domain of a class given by the "maps to" notation. (Contributed by FL, 17-May-2010.)
theorem dmmpt2 {x3 y1: setvar} (A2 B2: class) (C F: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wcel C cvv $ >
  $ wceq (cdm F) (cxp A2 B2) $;

--| Sufficient condition for an operation maps-to notation to be set-like. (Contributed by Mario Carneiro, 3-Jul-2019.)
theorem mpt2fvexi {x3 y1: setvar} (A2 B2: class) (C R S F: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wcel C cvv $ >
  $ wcel R cvv $ >
  $ wcel S cvv $ >
  $ wcel (co R S F) cvv $;

--| Existence of an operation class abstraction (version for dependent domains). (Contributed by Mario Carneiro, 30-Dec-2016.)
theorem mpt2exxg {x3 y1: setvar} (A2: class) (B2: class x3) (C R S F: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wi (wa (wcel A2 R) (wral x3 (wcel B2 S) A2)) (wcel F cvv) $;

--| Existence of an operation class abstraction (special case). (Contributed by FL, 17-May-2010.) (Revised by Mario Carneiro, 1-Sep-2015.)
theorem mpt2exg {x3 y1: setvar} (A2 B2: class) (C R S F: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wi (wa (wcel A2 R) (wcel B2 S)) (wcel F cvv) $;

--| If the domain of a function given by maps-to notation is a set, the function is a set. (Contributed by NM, 12-Sep-2011.)
theorem mpt2exga {x3 y1: setvar} (A2 B2: class) (C V W: class x3 y1):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wcel (cmpt2 x3 y1 A2 B2 C) cvv) $;

--| If the domain of a function given by maps-to notation is a set, the function is a set. (Contributed by Mario Carneiro, 20-Dec-2013.)
theorem mpt2ex {x3 y1: setvar} (A2: class) (B2: class x3) (C: class x3 y1):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel (cmpt2 x3 y1 A2 B2 C) cvv $;

--| Composition of two functions. Variation of ~ fmptco when the second function has two arguments. (Contributed by Mario Carneiro, 8-Feb-2015.)
theorem fmpt2co {x3 y1 z: setvar} (ph: wff z) (A2 B2: class z) (C: class) (R: class x3 y1) (S: class z) (T: class x3 y1) (F G: class x3 y1 z):
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wcel R C) $ >
  $ wi ph (wceq F (cmpt2 x3 y1 A2 B2 R)) $ >
  $ wi ph (wceq G (cmpt z C S)) $ >
  $ wi (wceq (cv z) R) (wceq S T) $ >
  $ wi ph (wceq (ccom G F) (cmpt2 x3 y1 A2 B2 T)) $;

--| Composition of a function with an operator abstraction. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 26-Sep-2015.)
theorem oprabco {x3 y1: setvar} (A2 B2: class) (C: class x3 y1) (D: class) (F G: class x3 y1) (H: class):
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wcel C D) $ >
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wceq G (cmpt2 x3 y1 A2 B2 (cfv C H)) $ >
  $ wi (wfn H D) (wceq G (ccom H F)) $;

--| Composition of operator abstractions. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by David Abernethy, 23-Apr-2013.)
theorem oprab2co {x3 y1: setvar} (A2 B2: class) (C D: class x3 y1) (R S: class) (F G: class x3 y1) (M: class):
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wcel C R) $ >
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wcel D S) $ >
  $ wceq F (cmpt2 x3 y1 A2 B2 (cop C D)) $ >
  $ wceq G (cmpt2 x3 y1 A2 B2 (co C D M)) $ >
  $ wi (wfn M (cxp R S)) (wceq G (ccom M F)) $;

--| An alternate possible definition of the ` 1st ` function. (Contributed by NM, 14-Oct-2004.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem df1st2 {x3 y1 z: setvar}:
  $ wceq (coprab x3 y1 z (wceq (cv z) (cv x3))) (cres c1st (cxp cvv cvv)) $;

--| An alternate possible definition of the ` 2nd ` function. (Contributed by NM, 10-Aug-2006.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem df2nd2 {x3 y1 z: setvar}:
  $ wceq (coprab x3 y1 z (wceq (cv z) (cv y1))) (cres c2nd (cxp cvv cvv)) $;

--| The mapping of a restriction of the ` 1st ` function to a constant function. (Contributed by NM, 14-Dec-2008.)
theorem _1stconst (A2 B2 V: class):
  $ wi (wcel B2 V) (wf1o (cxp A2 (csn B2)) A2 (cres c1st (cxp A2 (csn B2)))) $;

--| The mapping of a restriction of the ` 2nd ` function to a converse constant function. (Contributed by NM, 27-Mar-2008.)
theorem _2ndconst (A2 B2 V: class):
  $ wi (wcel A2 V) (wf1o (cxp (csn A2) B2) B2 (cres c2nd (cxp (csn A2) B2))) $;

--| Alternate definition for the "maps to" notation ~ df-mpt2 (although it requires that ` C ` be a set). (Contributed by NM, 19-Dec-2008.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem dfmpt2 {x3 y1: setvar} (A2 B2: class) (C: class x3 y1):
  $ wcel C cvv $ >
  $ wceq (cmpt2 x3 y1 A2 B2 C) (ciun x3 A2 (ciun y1 B2 (csn (cop (cop (cv x3) (cv y1)) C)))) $;

--| Lemma for ~ cnvf1o . (Contributed by Mario Carneiro, 27-Apr-2014.)
theorem cnvf1olem (A2 B2 C: class):
  $ wi (wa (wrel A2) (wa (wcel B2 A2) (wceq C (cuni (ccnv (csn B2)))))) (wa (wcel C (ccnv A2)) (wceq B2 (cuni (ccnv (csn C))))) $;

--| Describe a function that maps the elements of a set to its converse bijectively. (Contributed by Mario Carneiro, 27-Apr-2014.)
theorem cnvf1o {x3: setvar} (A2: class):
  $ wi (wrel A2) (wf1o A2 (ccnv A2) (cmpt x3 A2 (cuni (ccnv (csn (cv x3)))))) $;

--| The ` 2nd ` (second member of an ordered pair) function restricted to a function ` F ` is a function of ` F ` into the codomain of ` F ` . (Contributed by Alexander van der Vekens, 4-Feb-2018.)
theorem f2ndf (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wf F B2 (cres c2nd F)) $;

--| The ` 2nd ` (second member of an ordered pair) function restricted to a function ` F ` is a function of ` F ` onto the range of ` F ` . (Contributed by Alexander van der Vekens, 4-Feb-2018.)
theorem fo2ndf (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wfo F (crn F) (cres c2nd F)) $;

--| The ` 2nd ` (second member of an ordered pair) function restricted to a one-to-one function ` F ` is a one-to-one function of ` F ` onto the range of ` F ` . (Contributed by Alexander van der Vekens, 4-Feb-2018.)
theorem f1o2ndf1 (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wf1o F (crn F) (cres c2nd F)) $;

--| Lemma for algrf and related theorems. (Contributed by Mario Carneiro, 28-May-2014.) (Revised by Mario Carneiro, 30-Apr-2015.)
theorem algrflem (B2 C F: class):
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wceq (co B2 C (ccom F c1st)) (cfv B2 F) $;

--| Lemma for algrf and related theorems. (Contributed by Jim Kingdon, 22-Jul-2021.)
theorem algrflemg (B2 C F V W: class):
  $ wi (wa (wcel B2 V) (wcel C W)) (wceq (co B2 C (ccom F c1st)) (cfv B2 F)) $;

--| Lemma for lexicographical ordering theorems. (Contributed by Scott Fenton, 16-Mar-2011.)
theorem xporderlem {x3 y1 a b c d: setvar} (A2 B2 R S: class a b c d) (T: class x3 y1 a b c d):
  $ wceq T (copab x3 y1 (wa (wa (wcel (cv x3) (cxp A2 B2)) (wcel (cv y1) (cxp A2 B2))) (wo (wbr (cfv (cv x3) c1st) (cfv (cv y1) c1st) R) (wa (wceq (cfv (cv x3) c1st) (cfv (cv y1) c1st)) (wbr (cfv (cv x3) c2nd) (cfv (cv y1) c2nd) S))))) $ >
  $ wb (wbr (cop (cv a) (cv b)) (cop (cv c) (cv d)) T) (wa (wa (wa (wcel (cv a) A2) (wcel (cv c) A2)) (wa (wcel (cv b) B2) (wcel (cv d) B2))) (wo (wbr (cv a) (cv c) R) (wa (wceq (cv a) (cv c)) (wbr (cv b) (cv d) S)))) $;

--| Lemma for lexicographical ordering theorems. (Contributed by Scott Fenton, 16-Mar-2011.)
theorem xporderlem_b {x3 y1 a b: setvar} (A2 B2 R S: class a b) (T: class x3 y1 a b):
  $ wceq T (copab x3 y1 (wa (wa (wcel (cv x3) (cxp A2 B2)) (wcel (cv y1) (cxp A2 B2))) (wo (wbr (cfv (cv x3) c1st) (cfv (cv y1) c1st) R) (wa (wceq (cfv (cv x3) c1st) (cfv (cv y1) c1st)) (wbr (cfv (cv x3) c2nd) (cfv (cv y1) c2nd) S))))) $ >
  $ wb (wbr (cop (cv a) (cv b)) (cop (cv a) (cv b)) T) (wa (wa (wa (wcel (cv a) A2) (wcel (cv a) A2)) (wa (wcel (cv b) B2) (wcel (cv b) B2))) (wo (wbr (cv a) (cv a) R) (wa (wceq (cv a) (cv a)) (wbr (cv b) (cv b) S)))) $;

--| A lexicographical ordering of two posets. (Contributed by Scott Fenton, 16-Mar-2011.) (Revised by Mario Carneiro, 7-Mar-2013.)
theorem poxp {x3 y1: setvar} (A2 B2 R S: class) (T: class x3 y1):
  $ wceq T (copab x3 y1 (wa (wa (wcel (cv x3) (cxp A2 B2)) (wcel (cv y1) (cxp A2 B2))) (wo (wbr (cfv (cv x3) c1st) (cfv (cv y1) c1st) R) (wa (wceq (cfv (cv x3) c1st) (cfv (cv y1) c1st)) (wbr (cfv (cv x3) c2nd) (cfv (cv y1) c2nd) S))))) $ >
  $ wi (wa (wpo A2 R) (wpo B2 S)) (wpo (cxp A2 B2) T) $;

--| If there is an element of the value of an operation given by a maps-to rule, where the first argument is a pair and the base set of the second argument is the first component of the first argument, then the second argument is an element of the first component of the first argument. (Contributed by Alexander van der Vekens, 10-Oct-2017.)
theorem mpt2xopn0yelv {x3 y1: setvar} (C F: class x3 y1) (K: class y1) (N: class x3 y1) (V W: class y1) (X Y: class x3 y1):
  $ wceq F (cmpt2 x3 y1 cvv (cfv (cv x3) c1st) C) $ >
  $ wi (wa (wcel V X) (wcel W Y)) (wi (wcel N (co (cop V W) K F)) (wcel K V)) $;

--| Value of an operation given by a maps-to rule, where the first argument is a pair and the base set of the second argument is the first component of the first argument. (Contributed by Alexander van der Vekens, 11-Oct-2017.)
theorem mpt2xopoveq {x3 y1 n: setvar} (ph: wff x3 y1 n) (F: class x3 y1 n) (K V W X Y: class):
  $ wceq F (cmpt2 x3 y1 cvv (cfv (cv x3) c1st) (crab n ph (cfv (cv x3) c1st))) $ >
  $ wi (wa (wa (wcel V X) (wcel W Y)) (wcel K V)) (wceq (co (cop V W) K F) (crab n (wsbc x3 (wsbc y1 ph K) (cop V W)) V)) $;

--| Element of the value of an operation given by a maps-to rule, where the first argument is a pair and the base set of the second argument is the first component of the first argument. (Contributed by Alexander van der Vekens and Mario Carneiro, 10-Oct-2017.)
theorem mpt2xopovel {x3 y1 n: setvar} (ph: wff x3 y1 n) (F: class x3 y1 n) (K: class) (N: class n) (V W X Y: class):
  $ wceq F (cmpt2 x3 y1 cvv (cfv (cv x3) c1st) (crab n ph (cfv (cv x3) c1st))) $ >
  $ wi (wa (wcel V X) (wcel W Y)) (wb (wcel N (co (cop V W) K F)) (w3a (wcel K V) (wcel N V) (wsbc x3 (wsbc y1 (wsbc n ph N) K) (cop V W)))) $;

--| The extension of a binary relation which is the value of an operation given in maps-to notation. (Contributed by Alexander van der Vekens, 30-Oct-2017.)
theorem sprmpt2 {v e f2 p: setvar} (ps: wff f2 p) (ch th: wff v e f2 p) (E: class) (M: class v e f2 p) (V: class) (W: class f2 p):
  $ wceq M (cmpt2 v e cvv cvv (copab f2 p (wa (wbr (cv f2) (cv p) (co (cv v) (cv e) W)) ch))) $ >
  $ wi (wa (wceq (cv v) V) (wceq (cv e) E)) (wb ch ps) $ >
  $ wi (wa (wcel V cvv) (wcel E cvv)) (wi (wbr (cv f2) (cv p) (co V E W)) th) $ >
  $ wi (wa (wcel V cvv) (wcel E cvv)) (wcel (copab f2 p th) cvv) $ >
  $ wi (wa (wcel V cvv) (wcel E cvv)) (wceq (co V E M) (copab f2 p (wa (wbr (cv f2) (cv p) (co V E W)) ps))) $;

--| Properties of a pair in an extended binary relation. (Contributed by Alexander van der Vekens, 30-Oct-2017.)
theorem isprmpt2 {f2 p: setvar} (ph ps: wff f2 p) (ch: wff) (P F: class) (M: class f2 p) (W: class) (X Y: class f2 p):
  $ wi ph (wceq M (copab f2 p (wa (wbr (cv f2) (cv p) W) ps))) $ >
  $ wi (wa (wceq (cv f2) F) (wceq (cv p) P)) (wb ps ch) $ >
  $ wi ph (wi (wa (wcel F X) (wcel P Y)) (wb (wbr F P M) (wa (wbr F P W) ch))) $;

--| The transposition of a function.
term ctpos (F: class): class;

--| Define the transposition of a function, which is a function ` G = tpos F ` satisfying ` G ( x , y ) = F ( y , x ) ` . (Contributed by Mario Carneiro, 10-Sep-2015.)
axiom df_tpos {x3: setvar} (F: class):
  $ wceq (ctpos F) (ccom F (cmpt x3 (cun (ccnv (cdm F)) (csn c0)) (cuni (ccnv (csn (cv x3)))))) $;

--| Subset theorem for transposition. (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem tposss (F G: class):
  $ wi (wss F G) (wss (ctpos F) (ctpos G)) $;

--| Equality theorem for transposition. (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem tposeq (F G: class):
  $ wi (wceq F G) (wceq (ctpos F) (ctpos G)) $;

--| Equality theorem for transposition. (Contributed by Mario Carneiro, 7-Jan-2017.)
theorem tposeqd (ph: wff) (F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq (ctpos F) (ctpos G)) $;

--| The transposition is a subset of a cross product. (Contributed by Mario Carneiro, 12-Jan-2017.)
theorem tposssxp (F: class):
  $ wss (ctpos F) (cxp (cun (ccnv (cdm F)) (csn c0)) (crn F)) $;

--| The transposition is a relation. (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem reltpos (F: class):
  $ wrel (ctpos F) $;

--| Value of the transposition at a pair ` <. A , B >. ` . (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem brtpos2 (A2 B2 F V: class):
  $ wi (wcel B2 V) (wb (wbr A2 B2 (ctpos F)) (wa (wcel A2 (cun (ccnv (cdm F)) (csn c0))) (wbr (cuni (ccnv (csn A2))) B2 F))) $;

--| The behavior of ` tpos ` when the left argument is the empty set (which is not an ordered pair but is the "default" value of an ordered pair when the arguments are proper classes). (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem brtpos0 (A2 F V: class):
  $ wi (wcel A2 V) (wb (wbr c0 A2 (ctpos F)) (wbr c0 A2 F)) $;

--| Necessary and sufficient condition for ` dom tpos F ` to be a relation. (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem reldmtpos (F: class):
  $ wb (wrel (cdm (ctpos F))) (wn (wcel c0 (cdm F))) $;

--| The transposition swaps arguments of a three-parameter relation. (Contributed by Jim Kingdon, 31-Jan-2019.)
theorem brtposg (A2 B2 C F V W X: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wb (wbr (cop A2 B2) C (ctpos F)) (wbr (cop B2 A2) C F)) $;

--| The transposition swaps the first two elements in a collection of ordered triples. (Contributed by Mario Carneiro, 1-Dec-2014.)
theorem ottposg (A2 B2 C F V W X: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wb (wcel (cotp A2 B2 C) (ctpos F)) (wcel (cotp B2 A2 C) F)) $;

--| The domain of ` tpos F ` when ` dom F ` is a relation. (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem dmtpos (F: class):
  $ wi (wrel (cdm F)) (wceq (cdm (ctpos F)) (ccnv (cdm F))) $;

--| The range of ` tpos F ` when ` dom F ` is a relation. (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem rntpos (F: class):
  $ wi (wrel (cdm F)) (wceq (crn (ctpos F)) (crn F)) $;

--| The transposition of a set is a set. (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem tposexg (F V: class):
  $ wi (wcel F V) (wcel (ctpos F) cvv) $;

--| The transposition swaps the arguments in a two-argument function. When ` F ` is a matrix, which is to say a function from ( 1 ... m ) ` X. ` ( 1 ... n ) to the reals or some ring, ` tpos F ` is the transposition of ` F ` , which is where the name comes from. (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem ovtposg (A2 B2 F V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (co A2 B2 (ctpos F)) (co B2 A2 F)) $;

--| The transposition of a function is a function. (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem tposfun (F: class):
  $ wi (wfun F) (wfun (ctpos F)) $;

--| Alternate definition of ` tpos ` when ` F ` has relational domain. (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem dftpos2 {x3: setvar} (F: class):
  $ wi (wrel (cdm F)) (wceq (ctpos F) (ccom F (cmpt x3 (ccnv (cdm F)) (cuni (ccnv (csn (cv x3))))))) $;

--| Alternate definition of ` tpos ` when ` F ` has relational domain. Compare ~ df-cnv . (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem dftpos3 {x3 y1 z: setvar} (F: class):
  $ wi (wrel (cdm F)) (wceq (ctpos F) (coprab x3 y1 z (wbr (cop (cv y1) (cv x3)) (cv z) F))) $;

--| Alternate definition of ` tpos ` . (Contributed by Mario Carneiro, 4-Oct-2015.)
theorem dftpos4 {x3: setvar} (F: class):
  $ wceq (ctpos F) (ccom F (cmpt x3 (cun (cxp cvv cvv) (csn c0)) (cuni (ccnv (csn (cv x3)))))) $;

--| Value of the double transposition for a general class ` F ` . (Contributed by Mario Carneiro, 16-Sep-2015.)
theorem tpostpos (F: class):
  $ wceq (ctpos (ctpos F)) (cin F (cxp (cun (cxp cvv cvv) (csn c0)) cvv)) $;

--| Value of the double transposition for a relation on triples. (Contributed by Mario Carneiro, 16-Sep-2015.)
theorem tpostpos2 (F: class):
  $ wi (wa (wrel F) (wrel (cdm F))) (wceq (ctpos (ctpos F)) F) $;

--| The domain of a transposition. (Contributed by NM, 10-Sep-2015.)
theorem tposfn2 (A2 F: class):
  $ wi (wrel A2) (wi (wfn F A2) (wfn (ctpos F) (ccnv A2))) $;

--| Condition for a surjective transposition. (Contributed by NM, 10-Sep-2015.)
theorem tposfo2 (A2 B2 F: class):
  $ wi (wrel A2) (wi (wfo A2 B2 F) (wfo (ccnv A2) B2 (ctpos F))) $;

--| The domain and range of a transposition. (Contributed by NM, 10-Sep-2015.)
theorem tposf2 (A2 B2 F: class):
  $ wi (wrel A2) (wi (wf A2 B2 F) (wf (ccnv A2) B2 (ctpos F))) $;

--| Condition for an injective transposition. (Contributed by NM, 10-Sep-2015.)
theorem tposf12 (A2 B2 F: class):
  $ wi (wrel A2) (wi (wf1 A2 B2 F) (wf1 (ccnv A2) B2 (ctpos F))) $;

--| Condition of a bijective transposition. (Contributed by NM, 10-Sep-2015.)
theorem tposf1o2 (A2 B2 F: class):
  $ wi (wrel A2) (wi (wf1o A2 B2 F) (wf1o (ccnv A2) B2 (ctpos F))) $;

--| The domain and range of a transposition. (Contributed by NM, 10-Sep-2015.)
theorem tposfo (A2 B2 C F: class):
  $ wi (wfo (cxp A2 B2) C F) (wfo (cxp B2 A2) C (ctpos F)) $;

--| The domain and range of a transposition. (Contributed by NM, 10-Sep-2015.)
theorem tposf (A2 B2 C F: class):
  $ wi (wf (cxp A2 B2) C F) (wf (cxp B2 A2) C (ctpos F)) $;

--| Functionality of a transposition. (Contributed by Mario Carneiro, 4-Oct-2015.)
theorem tposfn (A2 B2 F: class):
  $ wi (wfn F (cxp A2 B2)) (wfn (ctpos F) (cxp B2 A2)) $;

--| Transposition of the empty set. (Contributed by NM, 10-Sep-2015.)
theorem tpos0:
  $ wceq (ctpos c0) c0 $;

--| Transposition of a composition. (Contributed by Mario Carneiro, 4-Oct-2015.)
theorem tposco (F G: class):
  $ wceq (ctpos (ccom F G)) (ccom F (ctpos G)) $;

--| Two ways to say a function is symmetric. (Contributed by Mario Carneiro, 4-Oct-2015.)
theorem tpossym {x3 y1: setvar} (A2 F: class):
  $ wi (wfn F (cxp A2 A2)) (wb (wceq (ctpos F) F) (wral x3 (wral y1 (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) A2) A2)) $;

--| Equality theorem for transposition. (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem tposeqi (F G: class):
  $ wceq F G $ >
  $ wceq (ctpos F) (ctpos G) $;

--| A transposition is a set. (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem tposex (F: class):
  $ wcel F cvv $ >
  $ wcel (ctpos F) cvv $;

--| Hypothesis builder for transposition. (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem nftpos {x3: setvar} (F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 (ctpos F) $;

--| Transposition of a class of ordered triples. (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem tposoprab {x3 y1 z: setvar} (ph: wff x3 y1 z) (F: class x3 y1 z):
  $ wceq F (coprab x3 y1 z ph) $ >
  $ wceq (ctpos F) (coprab y1 x3 z ph) $;

--| Transposition of a two-argument mapping. (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem tposmpt2 {x3 y1: setvar} (A2 B2 C F: class x3 y1):
  $ wceq F (cmpt2 x3 y1 A2 B2 C) $ >
  $ wceq (ctpos F) (cmpt2 y1 x3 B2 A2 C) $;

--| The power set of the union of a set does not belong to the set. This theorem provides a way of constructing a new set that doesn't belong to a given set. (Contributed by Stefan O'Rear, 22-Feb-2015.)
theorem pwuninel2 (A2 V: class):
  $ wi (wcel (cuni A2) V) (wn (wcel (cpw (cuni A2)) A2)) $;

--| The power set of the power set of the union of a set does not belong to the set. This theorem provides a way of constructing a new set that doesn't belong to a given set. (Contributed by Jim Kingdon, 14-Jan-2020.)
theorem _2pwuninelg (A2 V: class):
  $ wi (wcel A2 V) (wn (wcel (cpw (cpw (cuni A2))) A2)) $;

--| The indexed union of a set of ordinal numbers ` B ( x ) ` is an ordinal number. (Contributed by NM, 13-Oct-2003.) (Revised by Mario Carneiro, 5-Dec-2016.)
theorem iunon {x3: setvar} (A2: class) (B2 V: class x3):
  $ wi (wa (wcel A2 V) (wral x3 (wcel B2 con0) A2)) (wcel (ciun x3 A2 B2) con0) $;

--| Introduce the strictly monotone ordinal function. A strictly monotone function is one that is constantly increasing across the ordinals.
term wsmo (A2: class): wff;

--| Definition of a strictly monotone ordinal function. Definition 7.46 in [TakeutiZaring] p. 50. (Contributed by Andrew Salmon, 15-Nov-2011.)
axiom df_smo {x3 y1: setvar} (A2: class):
  $ wb (wsmo A2) (w3a (wf (cdm A2) con0 A2) (word (cdm A2)) (wral x3 (wral y1 (wi (wcel (cv x3) (cv y1)) (wcel (cfv (cv x3) A2) (cfv (cv y1) A2))) (cdm A2)) (cdm A2))) $;

--| Alternate definition of a strictly monotone ordinal function. (Contributed by Mario Carneiro, 4-Mar-2013.)
theorem dfsmo2 {x3 y1: setvar} (F: class):
  $ wb (wsmo F) (w3a (wf (cdm F) con0 F) (word (cdm F)) (wral x3 (wral y1 (wcel (cfv (cv y1) F) (cfv (cv x3) F)) (cv x3)) (cdm F))) $;

--| Conditions for which ` A ` is a strictly monotone ordinal function. (Contributed by Andrew Salmon, 15-Nov-2011.)
theorem issmo {x3 y1: setvar} (A2: class) (B2: class x3 y1):
  $ wf B2 con0 A2 $ >
  $ word B2 $ >
  $ wi (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wi (wcel (cv x3) (cv y1)) (wcel (cfv (cv x3) A2) (cfv (cv y1) A2))) $ >
  $ wceq (cdm A2) B2 $ >
  $ wsmo A2 $;

--| Alternative definition of a strictly monotone ordinal function. (Contributed by Mario Carneiro, 12-Mar-2013.)
theorem issmo2 {x3 y1: setvar} (A2: class y1) (B2: class x3 y1) (F: class):
  $ wi (wf A2 B2 F) (wi (w3a (wss B2 con0) (word A2) (wral x3 (wral y1 (wcel (cfv (cv y1) F) (cfv (cv x3) F)) (cv x3)) A2)) (wsmo F)) $;

--| Equality theorem for strictly monotone functions. (Contributed by Andrew Salmon, 16-Nov-2011.)
theorem smoeq (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wsmo A2) (wsmo B2)) $;

--| The domain of a strictly monotone function is an ordinal. (Contributed by Andrew Salmon, 16-Nov-2011.)
theorem smodm (A2: class):
  $ wi (wsmo A2) (word (cdm A2)) $;

--| A strictly monotone function restricted to an ordinal remains strictly monotone. (Contributed by Andrew Salmon, 16-Nov-2011.) (Proof shortened by Mario Carneiro, 5-Dec-2016.)
theorem smores (A2 B2: class):
  $ wi (wa (wsmo A2) (wcel B2 (cdm A2))) (wsmo (cres A2 B2)) $;

--| A strictly monotone function restricted to an ordinal remains strictly monotone. (Contributed by Andrew Salmon, 19-Nov-2011.)
theorem smores3 (A2 B2 C: class):
  $ wi (w3a (wsmo (cres A2 B2)) (wcel C (cin (cdm A2) B2)) (word B2)) (wsmo (cres A2 C)) $;

--| A strictly monotone ordinal function restricted to an ordinal is still monotone. (Contributed by Mario Carneiro, 15-Mar-2013.)
theorem smores2 (A2 F: class):
  $ wi (wa (wsmo F) (word A2)) (wsmo (cres F A2)) $;

--| The domain of a strictly monotone ordinal function is an ordinal. (Contributed by Mario Carneiro, 12-Mar-2013.)
theorem smodm2 (A2 F: class):
  $ wi (wa (wfn F A2) (wsmo F)) (word A2) $;

--| The function values of a strictly monotone ordinal function are ordinals. (Contributed by Mario Carneiro, 12-Mar-2013.)
theorem smofvon2dm (B2 F: class):
  $ wi (wa (wsmo F) (wcel B2 (cdm F))) (wcel (cfv B2 F) con0) $;

--| The identity relation restricted to the ordinals is a strictly monotone function. (Contributed by Andrew Salmon, 16-Nov-2011.)
theorem iordsmo (A2: class):
  $ word A2 $ >
  $ wsmo (cres cid A2) $;

--| The null set is a strictly monotone ordinal function. (Contributed by Andrew Salmon, 20-Nov-2011.)
theorem smo0:
  $ wsmo c0 $;

--| If ` B ` is a strictly monotone ordinal function, and ` A ` is in the domain of ` B ` , then the value of the function at ` A ` is an ordinal. (Contributed by Andrew Salmon, 20-Nov-2011.)
theorem smofvon (A2 B2: class):
  $ wi (wa (wsmo B2) (wcel A2 (cdm B2))) (wcel (cfv A2 B2) con0) $;

--| If ` x ` is less than ` y ` then a strictly monotone function's value will be strictly less at ` x ` than at ` y ` . (Contributed by Andrew Salmon, 22-Nov-2011.)
theorem smoel (A2 B2 C: class):
  $ wi (w3a (wsmo B2) (wcel A2 (cdm B2)) (wcel C A2)) (wcel (cfv C B2) (cfv A2 B2)) $;

--| The value of a strictly monotone ordinal function contains its indexed union. (Contributed by Andrew Salmon, 22-Nov-2011.)
theorem smoiun {x3: setvar} (A2 B2: class):
  $ wi (wa (wsmo B2) (wcel A2 (cdm B2))) (wss (ciun x3 A2 (cfv (cv x3) B2)) (cfv A2 B2)) $;

--| If ` F ` is an isomorphism from an ordinal ` A ` onto ` B ` , which is a subset of the ordinals, then ` F ` is a strictly monotonic function. Exercise 3 in [TakeutiZaring] p. 50. (Contributed by Andrew Salmon, 24-Nov-2011.)
theorem smoiso (A2 B2 F: class):
  $ wi (w3a (wiso A2 B2 cep cep F) (word A2) (wss B2 con0)) (wsmo F) $;

--| A strictly monotone ordinal function preserves the epsilon relation. (Contributed by Mario Carneiro, 12-Mar-2013.)
theorem smoel2 (A2 B2 C F: class):
  $ wi (wa (wa (wfn F A2) (wsmo F)) (wa (wcel B2 A2) (wcel C B2))) (wcel (cfv C F) (cfv B2 F)) $;

--| Notation for a function defined by strong transfinite recursion.
term crecs (F: class): class;

--| Define a function ` recs ( F ) ` on ` On ` , the class of ordinal numbers, by transfinite recursion given a rule ` F ` which sets the next value given all values so far. See ~ df-irdg for more details on why this definition is desirable. Unlike ~ df-irdg which restricts the update rule to use only the previous value, this version allows the update rule to use _all_ previous values, which is why it is described as "strong", although it is actually more primitive. See ~ tfri1d and ~ tfri2d for the primary contract of this definition. (Contributed by Stefan O'Rear, 18-Jan-2015.)
axiom df_recs {x3 y1 f2: setvar} (F: class):
  $ wceq (crecs F) (cuni (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0))) $;

--| Equality theorem for ` recs ` . (Contributed by Stefan O'Rear, 18-Jan-2015.)
theorem recseq (F G: class):
  $ wi (wceq F G) (wceq (crecs F) (crecs G)) $;

--| Bound-variable hypothesis builder for ` recs ` . (Contributed by Stefan O'Rear, 18-Jan-2015.)
theorem nfrecs {x3: setvar} (F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 (crecs F) $;

--| A technical lemma for transfinite recursion. Compare Lemma 1 of [TakeutiZaring] p. 47. (Contributed by NM, 23-Mar-1995.) (Revised by Mario Carneiro, 24-May-2019.)
theorem tfrlem1 {x3: setvar} (ph: wff x3) (A2 B2 F G: class):
  $ wi ph (wcel A2 con0) $ >
  $ wi ph (wa (wfun F) (wss A2 (cdm F))) $ >
  $ wi ph (wa (wfun G) (wss A2 (cdm G))) $ >
  $ wi ph (wral x3 (wceq (cfv (cv x3) F) (cfv (cres F (cv x3)) B2)) A2) $ >
  $ wi ph (wral x3 (wceq (cfv (cv x3) G) (cfv (cres G (cv x3)) B2)) A2) $ >
  $ wi ph (wral x3 (wceq (cfv (cv x3) F) (cfv (cv x3) G)) A2) $;

--| Lemma for transfinite recursion. This lemma just changes some bound variables in ` A ` for later use. (Contributed by NM, 9-Apr-1995.)
theorem tfrlem3ag {x3 y1 z w f2: setvar} (A2: class x3 y1 z w f2) (F G: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wi (wcel G cvv) (wb (wcel G A2) (wrex z (wa (wfn G (cv z)) (wral w (wceq (cfv (cv w) G) (cfv (cres G (cv w)) F)) (cv z))) con0)) $;

--| Lemma for transfinite recursion. Let ` A ` be the class of "acceptable" functions. The final thing we're interested in is the union of all these acceptable functions. This lemma just changes some bound variables in ` A ` for later use. (Contributed by NM, 9-Apr-1995.)
theorem tfrlem3a {x3 y1 z w f2: setvar} (A2: class x3 y1 z w f2) (F G: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wcel G cvv $ >
  $ wb (wcel G A2) (wrex z (wa (wfn G (cv z)) (wral w (wceq (cfv (cv w) G) (cfv (cres G (cv w)) F)) (cv z))) con0) $;

--| Lemma for transfinite recursion. Let ` A ` be the class of "acceptable" functions. The final thing we're interested in is the union of all these acceptable functions. This lemma just changes some bound variables in ` A ` for later use. (Contributed by NM, 9-Apr-1995.)
theorem tfrlem3 {x3 y1 z w f2 g1: setvar} (A2: class x3 y1 z w f2) (F: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wceq A2 (cab g1 (wrex z (wa (wfn (cv g1) (cv z)) (wral w (wceq (cfv (cv w) (cv g1)) (cfv (cres (cv g1) (cv w)) F)) (cv z))) con0)) $;

--| Lemma for transfinite recursion which changes a bound variable (Contributed by Jim Kingdon, 17-Apr-2019.)
theorem tfrlem3_21 {x3 g1: setvar} (F: class):
  $ wa (wfun F) (wcel (cfv (cv x3) F) cvv) $ >
  $ wa (wfun F) (wcel (cfv (cv g1) F) cvv) $;

--| Lemma for transfinite recursion which changes a bound variable (Contributed by Jim Kingdon, 2-Jul-2019.)
theorem tfrlem3_2d {x3 g1: setvar} (ph: wff x3 g1) (F: class):
  $ wi ph (wal x3 (wa (wfun F) (wcel (cfv (cv x3) F) cvv))) $ >
  $ wi ph (wa (wfun F) (wcel (cfv (cv g1) F) cvv)) $;

--| Lemma for transfinite recursion. ` A ` is the class of all "acceptable" functions, and ` F ` is their union. First we show that an acceptable function is in fact a function. (Contributed by NM, 9-Apr-1995.)
theorem tfrlem4 {x3 y1 f2 g1: setvar} (A2: class x3 y1 f2) (F: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wi (wcel (cv g1) A2) (wfun (cv g1)) $;

--| Lemma for transfinite recursion. The values of two acceptable functions are the same within their domains. (Contributed by NM, 9-Apr-1995.) (Revised by Mario Carneiro, 24-May-2019.)
theorem tfrlem5 {x3 y1 f2 g1 h: setvar} (v u: setvar) (A2: class x3 y1 f2) (F: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wi (wa (wcel (cv g1) A2) (wcel (cv h) A2)) (wi (wa (wbr (cv x3) (cv u) (cv g1)) (wbr (cv x3) (cv v) (cv h))) (wceq (cv u) (cv v))) $;

--| Lemma for transfinite recursion. The definition ` recs ` is the union of all acceptable functions. (Contributed by Mario Carneiro, 9-May-2015.)
theorem recsfval {x3 y1 f2: setvar} (A2: class x3 y1 f2) (F: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wceq (crecs F) (cuni A2) $;

--| Lemma for transfinite recursion. The union of all acceptable functions is a relation. (Contributed by NM, 8-Aug-1994.) (Revised by Mario Carneiro, 9-May-2015.)
theorem tfrlem6 {x3 y1 f2: setvar} (A2: class x3 y1 f2) (F: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wrel (crecs F) $;

--| Lemma for transfinite recursion. The union of all acceptable functions is a function. (Contributed by NM, 9-Aug-1994.) (Revised by Mario Carneiro, 24-May-2019.)
theorem tfrlem7 {x3 y1 f2: setvar} (A2: class x3 y1 f2) (F: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wfun (crecs F) $;

--| Lemma for transfinite recursion. The domain of ` recs ` is ordinal. (Contributed by NM, 14-Aug-1994.) (Proof shortened by Alan Sare, 11-Mar-2008.)
theorem tfrlem8 {x3 y1 f2: setvar} (A2: class x3 y1 f2) (F: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ word (cdm (crecs F)) $;

--| Lemma for transfinite recursion. Here we compute the value of ` recs ` (the union of all acceptable functions). (Contributed by NM, 17-Aug-1994.)
theorem tfrlem9 {x3 y1 f2: setvar} (A2: class x3 y1 f2) (B2 F: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wi (wcel B2 (cdm (crecs F))) (wceq (cfv B2 (crecs F)) (cfv (cres (crecs F) B2) F)) $;

--| A weak version of transfinite recursion. (Contributed by Mario Carneiro, 24-Jun-2015.)
theorem tfr2a (A2 F G: class):
  $ wceq F (crecs G) $ >
  $ wi (wcel A2 (cdm F)) (wceq (cfv A2 F) (cfv (cres F A2) G)) $;

--| Transfinite recursion at the empty set. (Contributed by Jim Kingdon, 8-May-2020.)
theorem tfr0 (F G V: class):
  $ wceq F (crecs G) $ >
  $ wi (wcel (cfv c0 G) V) (wceq (cfv c0 F) (cfv c0 G)) $;

--| We can extend an acceptable function by one element to produce a function. Lemma for ~ tfrlemi1 . (Contributed by Jim Kingdon, 2-Jul-2019.)
theorem tfrlemisucfn {x3 y1 z f2 g1: setvar} (ph: wff x3 z f2 g1) (A2 F: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wi ph (wal x3 (wa (wfun F) (wcel (cfv (cv x3) F) cvv))) $ >
  $ wi ph (wcel (cv z) con0) $ >
  $ wi ph (wfn (cv g1) (cv z)) $ >
  $ wi ph (wcel (cv g1) A2) $ >
  $ wi ph (wfn (cun (cv g1) (csn (cop (cv z) (cfv (cv g1) F)))) (csuc (cv z))) $;

--| We can extend an acceptable function by one element to produce an acceptable function. Lemma for ~ tfrlemi1 . (Contributed by Jim Kingdon, 4-Mar-2019.) (Proof shortened by Mario Carneiro, 24-May-2019.)
theorem tfrlemisucaccv {x3 y1 z f2 g1: setvar} (ph: wff x3 z f2 g1) (A2 F: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wi ph (wal x3 (wa (wfun F) (wcel (cfv (cv x3) F) cvv))) $ >
  $ wi ph (wcel (cv z) con0) $ >
  $ wi ph (wfn (cv g1) (cv z)) $ >
  $ wi ph (wcel (cv g1) A2) $ >
  $ wi ph (wcel (cun (cv g1) (csn (cop (cv z) (cfv (cv g1) F)))) A2) $;

--| Each element of ` B ` is an acceptable function. Lemma for ~ tfrlemi1 . (Contributed by Jim Kingdon, 14-Mar-2019.) (Proof shortened by Mario Carneiro, 24-May-2019.)
theorem tfrlemibacc {x3 y1 z w f2 g1 h: setvar} (ph: wff x3 f2) (A2: class) (B2: class x3 y1) (F: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wi ph (wal x3 (wa (wfun F) (wcel (cfv (cv x3) F) cvv))) $ >
  $ wceq B2 (cab h (wrex z (wex g1 (w3a (wfn (cv g1) (cv z)) (wcel (cv g1) A2) (wceq (cv h) (cun (cv g1) (csn (cop (cv z) (cfv (cv g1) F))))))) (cv x3))) $ >
  $ wi ph (wcel (cv x3) con0) $ >
  $ wi ph (wral z (wex g1 (wa (wfn (cv g1) (cv z)) (wral w (wceq (cfv (cv w) (cv g1)) (cfv (cres (cv g1) (cv w)) F)) (cv z)))) (cv x3)) $ >
  $ wi ph (wss B2 A2) $;

--| The union of ` B ` is defined on all ordinals. Lemma for ~ tfrlemi1 . (Contributed by Jim Kingdon, 18-Mar-2019.) (Proof shortened by Mario Carneiro, 24-May-2019.)
theorem tfrlemibxssdm {x3 y1 z w f2 g1 h: setvar} (ph: wff x3 f2) (A2: class) (B2: class x3 y1) (F: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wi ph (wal x3 (wa (wfun F) (wcel (cfv (cv x3) F) cvv))) $ >
  $ wceq B2 (cab h (wrex z (wex g1 (w3a (wfn (cv g1) (cv z)) (wcel (cv g1) A2) (wceq (cv h) (cun (cv g1) (csn (cop (cv z) (cfv (cv g1) F))))))) (cv x3))) $ >
  $ wi ph (wcel (cv x3) con0) $ >
  $ wi ph (wral z (wex g1 (wa (wfn (cv g1) (cv z)) (wral w (wceq (cfv (cv w) (cv g1)) (cfv (cres (cv g1) (cv w)) F)) (cv z)))) (cv x3)) $ >
  $ wi ph (wss (cv x3) (cdm (cuni B2))) $;

--| The union of ` B ` is a function defined on ` x ` . Lemma for ~ tfrlemi1 . (Contributed by Jim Kingdon, 18-Mar-2019.) (Proof shortened by Mario Carneiro, 24-May-2019.)
theorem tfrlemibfn {x3 y1 z w f2 g1 h: setvar} (ph: wff x3 f2) (A2: class) (B2: class x3 y1) (F: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wi ph (wal x3 (wa (wfun F) (wcel (cfv (cv x3) F) cvv))) $ >
  $ wceq B2 (cab h (wrex z (wex g1 (w3a (wfn (cv g1) (cv z)) (wcel (cv g1) A2) (wceq (cv h) (cun (cv g1) (csn (cop (cv z) (cfv (cv g1) F))))))) (cv x3))) $ >
  $ wi ph (wcel (cv x3) con0) $ >
  $ wi ph (wral z (wex g1 (wa (wfn (cv g1) (cv z)) (wral w (wceq (cfv (cv w) (cv g1)) (cfv (cres (cv g1) (cv w)) F)) (cv z)))) (cv x3)) $ >
  $ wi ph (wfn (cuni B2) (cv x3)) $;

--| The set ` B ` exists. Lemma for ~ tfrlemi1 . (Contributed by Jim Kingdon, 17-Mar-2019.) (Proof shortened by Mario Carneiro, 24-May-2019.)
theorem tfrlemibex {x3 y1 z w f2 g1 h: setvar} (ph: wff x3 f2) (A2: class) (B2: class x3 y1) (F: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wi ph (wal x3 (wa (wfun F) (wcel (cfv (cv x3) F) cvv))) $ >
  $ wceq B2 (cab h (wrex z (wex g1 (w3a (wfn (cv g1) (cv z)) (wcel (cv g1) A2) (wceq (cv h) (cun (cv g1) (csn (cop (cv z) (cfv (cv g1) F))))))) (cv x3))) $ >
  $ wi ph (wcel (cv x3) con0) $ >
  $ wi ph (wral z (wex g1 (wa (wfn (cv g1) (cv z)) (wral w (wceq (cfv (cv w) (cv g1)) (cfv (cres (cv g1) (cv w)) F)) (cv z)))) (cv x3)) $ >
  $ wi ph (wcel B2 cvv) $;

--| The union of ` B ` satisfies the recursion rule (lemma for ~ tfrlemi1 ). (Contributed by Jim Kingdon, 22-Apr-2019.) (Proof shortened by Mario Carneiro, 24-May-2019.)
theorem tfrlemiubacc {x3 y1 z w u f2 g1 h: setvar} (ph: wff x3 u f2) (A2: class) (B2: class x3 y1) (F: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wi ph (wal x3 (wa (wfun F) (wcel (cfv (cv x3) F) cvv))) $ >
  $ wceq B2 (cab h (wrex z (wex g1 (w3a (wfn (cv g1) (cv z)) (wcel (cv g1) A2) (wceq (cv h) (cun (cv g1) (csn (cop (cv z) (cfv (cv g1) F))))))) (cv x3))) $ >
  $ wi ph (wcel (cv x3) con0) $ >
  $ wi ph (wral z (wex g1 (wa (wfn (cv g1) (cv z)) (wral w (wceq (cfv (cv w) (cv g1)) (cfv (cres (cv g1) (cv w)) F)) (cv z)))) (cv x3)) $ >
  $ wi ph (wral u (wceq (cfv (cv u) (cuni B2)) (cfv (cres (cuni B2) (cv u)) F)) (cv x3)) $;

--| Lemma for ~ tfrlemi1 . (Contributed by Jim Kingdon, 18-Mar-2019.) (Proof shortened by Mario Carneiro, 24-May-2019.)
theorem tfrlemiex {x3 y1 z w u f2 g1 h: setvar} (ph: wff x3 u f2) (A2: class) (B2: class x3 y1) (F: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wi ph (wal x3 (wa (wfun F) (wcel (cfv (cv x3) F) cvv))) $ >
  $ wceq B2 (cab h (wrex z (wex g1 (w3a (wfn (cv g1) (cv z)) (wcel (cv g1) A2) (wceq (cv h) (cun (cv g1) (csn (cop (cv z) (cfv (cv g1) F))))))) (cv x3))) $ >
  $ wi ph (wcel (cv x3) con0) $ >
  $ wi ph (wral z (wex g1 (wa (wfn (cv g1) (cv z)) (wral w (wceq (cfv (cv w) (cv g1)) (cfv (cres (cv g1) (cv w)) F)) (cv z)))) (cv x3)) $ >
  $ wi ph (wex f2 (wa (wfn (cv f2) (cv x3)) (wral u (wceq (cfv (cv u) (cv f2)) (cfv (cres (cv f2) (cv u)) F)) (cv x3)))) $;

--| We can define an acceptable function on any ordinal. As with many of the transfinite recursion theorems, we have a hypothesis that states that ` F ` is a function and that it is defined for all ordinals. (Contributed by Jim Kingdon, 4-Mar-2019.) (Proof shortened by Mario Carneiro, 24-May-2019.)
theorem tfrlemi1 {x3 y1 u f2 g1: setvar} (ph: wff x3 u g1) (A2: class) (C: class x3 y1 f2) (F: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wi ph (wal x3 (wa (wfun F) (wcel (cfv (cv x3) F) cvv))) $ >
  $ wi (wa ph (wcel C con0)) (wex g1 (wa (wfn (cv g1) C) (wral u (wceq (cfv (cv u) (cv g1)) (cfv (cres (cv g1) (cv u)) F)) C))) $;

--| The domain of ` recs ` is all ordinals (lemma for transfinite recursion). (Contributed by Jim Kingdon, 9-Jul-2019.)
theorem tfrlemi14d {x3 y1 f2: setvar} (ph: wff x3) (A2 F: class):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wi ph (wal x3 (wa (wfun F) (wcel (cfv (cv x3) F) cvv))) $ >
  $ wi ph (wceq (cdm (crecs F)) con0) $;

--| The transfinite recursion function is set-like if the input is. (Contributed by Mario Carneiro, 3-Jul-2019.)
theorem tfrexlem {x3 y1 f2: setvar} (ph: wff x3 y1 f2) (A2: class) (C: class x3 y1 f2) (F: class) (V: class x3 y1 f2):
  $ wceq A2 (cab f2 (wrex x3 (wa (wfn (cv f2) (cv x3)) (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cres (cv f2) (cv y1)) F)) (cv x3))) con0)) $ >
  $ wi ph (wal x3 (wa (wfun F) (wcel (cfv (cv x3) F) cvv))) $ >
  $ wi (wa ph (wcel C V)) (wcel (cfv C (crecs F)) cvv) $;

--| Principle of Transfinite Recursion, part 1 of 3. Theorem 7.41(1) of [TakeutiZaring] p. 47, with an additional condition. The condition is that ` G ` is defined "everywhere" and here is stated as ` ( G `` x ) e. _V ` . Alternatively ` A. x e. On A. f ( f Fn x -> f e. dom G ) ` would suffice. Given a function ` G ` satisfying that condition, we define a class ` A ` of all "acceptable" functions. The final function we're interested in is the union ` F = recs ( G ) ` of them. ` F ` is then said to be defined by transfinite recursion. The purpose of the 3 parts of this theorem is to demonstrate properties of ` F ` . In this first part we show that ` F ` is a function whose domain is all ordinal numbers. (Contributed by Jim Kingdon, 4-May-2019.) (Revised by Mario Carneiro, 24-May-2019.)
theorem tfri1d {x3: setvar} (ph: wff x3) (F: class x3) (G: class):
  $ wceq F (crecs G) $ >
  $ wi ph (wal x3 (wa (wfun G) (wcel (cfv (cv x3) G) cvv))) $ >
  $ wi ph (wfn F con0) $;

--| Principle of Transfinite Recursion, part 2 of 3. Theorem 7.41(2) of [TakeutiZaring] p. 47, with an additional condition on the recursion rule ` G ` ( as described at ~ tfri1 ). Here we show that the function ` F ` has the property that for any function ` G ` satisfying that condition, the "next" value of ` F ` is ` G ` recursively applied to all "previous" values of ` F ` . (Contributed by Jim Kingdon, 4-May-2019.)
theorem tfri2d {x3: setvar} (ph: wff x3) (A2 F: class x3) (G: class):
  $ wceq F (crecs G) $ >
  $ wi ph (wal x3 (wa (wfun G) (wcel (cfv (cv x3) G) cvv))) $ >
  $ wi (wa ph (wcel A2 con0)) (wceq (cfv A2 F) (cfv (cres F A2) G)) $;

--| Principle of Transfinite Recursion, part 1 of 3. Theorem 7.41(1) of [TakeutiZaring] p. 47, with an additional condition. The condition is that ` G ` is defined "everywhere" and here is stated as ` ( G `` x ) e. _V ` . Alternatively ` A. x e. On A. f ( f Fn x -> f e. dom G ) ` would suffice. Given a function ` G ` satisfying that condition, we define a class ` A ` of all "acceptable" functions. The final function we're interested in is the union ` F = recs ( G ) ` of them. ` F ` is then said to be defined by transfinite recursion. The purpose of the 3 parts of this theorem is to demonstrate properties of ` F ` . In this first part we show that ` F ` is a function whose domain is all ordinal numbers. (Contributed by Jim Kingdon, 4-May-2019.) (Revised by Mario Carneiro, 24-May-2019.)
theorem tfri1 {x3: setvar} (F: class x3) (G: class):
  $ wceq F (crecs G) $ >
  $ wa (wfun G) (wcel (cfv (cv x3) G) cvv) $ >
  $ wfn F con0 $;

--| Principle of Transfinite Recursion, part 2 of 3. Theorem 7.41(2) of [TakeutiZaring] p. 47, with an additional condition on the recursion rule ` G ` ( as described at ~ tfri1 ). Here we show that the function ` F ` has the property that for any function ` G ` satisfying that condition, the "next" value of ` F ` is ` G ` recursively applied to all "previous" values of ` F ` . (Contributed by Jim Kingdon, 4-May-2019.)
theorem tfri2 {x3: setvar} (A2 F: class x3) (G: class):
  $ wceq F (crecs G) $ >
  $ wa (wfun G) (wcel (cfv (cv x3) G) cvv) $ >
  $ wi (wcel A2 con0) (wceq (cfv A2 F) (cfv (cres F A2) G)) $;

--| Principle of Transfinite Recursion, part 3 of 3. Theorem 7.41(3) of [TakeutiZaring] p. 47, with an additional condition on the recursion rule ` G ` ( as described at ~ tfri1 ). Finally, we show that ` F ` is unique. We do this by showing that any class ` B ` with the same properties of ` F ` that we showed in parts 1 and 2 is identical to ` F ` . (Contributed by Jim Kingdon, 4-May-2019.)
theorem tfri3 {x3: setvar} (B2 F G: class):
  $ wceq F (crecs G) $ >
  $ wa (wfun G) (wcel (cfv (cv x3) G) cvv) $ >
  $ wi (wa (wfn B2 con0) (wral x3 (wceq (cfv (cv x3) B2) (cfv (cres B2 (cv x3)) G)) con0)) (wceq B2 F) $;

--| The transfinite recursion function is set-like if the input is. (Contributed by Mario Carneiro, 3-Jul-2019.)
theorem tfrex {x3: setvar} (ph: wff x3) (A2 F: class x3) (G: class) (V: class x3):
  $ wceq F (crecs G) $ >
  $ wi ph (wal x3 (wa (wfun G) (wcel (cfv (cv x3) G) cvv))) $ >
  $ wi (wa ph (wcel A2 V)) (wcel (cfv A2 F) cvv) $;

--| Transfinite recursion produces a function. (Contributed by Jim Kingdon, 20-Aug-2021.)
theorem tfrfun (F: class):
  $ wfun (crecs F) $;

--| Extend class notation with the recursive definition generator, with characteristic function ` F ` and initial value ` I ` .
term crdg (F I: class): class;

--| Define a recursive definition generator on ` On ` (the class of ordinal numbers) with characteristic function ` F ` and initial value ` I ` . This rather amazing operation allows us to define, with compact direct definitions, functions that are usually defined in textbooks only with indirect self-referencing recursive definitions. A recursive definition requires advanced metalogic to justify - in particular, eliminating a recursive definition is very difficult and often not even shown in textbooks. On the other hand, the elimination of a direct definition is a matter of simple mechanical substitution. The price paid is the daunting complexity of our ` rec ` operation (especially when ~ df-recs that it is built on is also eliminated). But once we get past this hurdle, definitions that would otherwise be recursive become relatively simple. In classical logic it would be easier to divide this definition into cases based on whether the domain of ` g ` is zero, a successor, or a limit ordinal. Cases do not (in general) work that way in intuitionistic logic, so instead we choose a definition which takes the union of all the results of the characteristic function for ordinals in the domain of ` g ` . This means that this definition has the expected properties for increasing and continuous ordinal functions, which include ordinal addition and multiplication. For finite recursion we also define ~ df-frec and for suitable characteristic functions ~ df-frec yields the same result as ` rec ` restricted to ` _om ` , as seen at ~ frecrdg . _Note: We introduce_ ` rec ` _with the philosophical goal of being_ _able to eliminate all definitions with direct mechanical substitution_ _and to verify easily the soundness of definitions. Metamath itself_ _has no built-in technical limitation that prevents multiple-part_ _recursive definitions in the traditional textbook style_. (Contributed by Jim Kingdon, 19-May-2019.)
axiom df_irdg {x3 g1: setvar} (F I: class):
  $ wceq (crdg F I) (crecs (cmpt g1 cvv (cun I (ciun x3 (cdm (cv g1)) (cfv (cfv (cv x3) (cv g1)) F))))) $;

--| Equality theorem for the recursive definition generator. (Contributed by NM, 9-Apr-1995.) (Revised by Mario Carneiro, 9-May-2015.)
theorem rdgeq1 (A2 F G: class):
  $ wi (wceq F G) (wceq (crdg F A2) (crdg G A2)) $;

--| Equality theorem for the recursive definition generator. (Contributed by NM, 9-Apr-1995.) (Revised by Mario Carneiro, 9-May-2015.)
theorem rdgeq2 (A2 B2 F: class):
  $ wi (wceq A2 B2) (wceq (crdg F A2) (crdg F B2)) $;

--| The recursive definition generator is a function. (Contributed by Mario Carneiro, 16-Nov-2014.)
theorem rdgfun (A2 F: class):
  $ wfun (crdg F A2) $;

--| The recursion rule for the recursive definition generator is defined everywhere. (Contributed by Jim Kingdon, 14-May-2020.)
theorem rdgtfr {x3 z f2 g1: setvar} (A2: class x3 z f2) (F: class f2) (V: class x3 z f2 g1):
  $ wi (wa (wal z (wcel (cfv (cv z) F) cvv)) (wcel A2 V)) (wa (wfun (cmpt g1 cvv (cun A2 (ciun x3 (cdm (cv g1)) (cfv (cfv (cv x3) (cv g1)) F))))) (wcel (cfv (cv f2) (cmpt g1 cvv (cun A2 (ciun x3 (cdm (cv g1)) (cfv (cfv (cv x3) (cv g1)) F))))) cvv)) $;

--| The recursion rule for the recursive definition generator is defined everywhere. (Contributed by Jim Kingdon, 4-Jul-2019.)
theorem rdgruledefgg {x3 f2 g1: setvar} (A2: class x3 f2) (F: class f2) (V: class x3 f2 g1):
  $ wi (wa (wfn F cvv) (wcel A2 V)) (wa (wfun (cmpt g1 cvv (cun A2 (ciun x3 (cdm (cv g1)) (cfv (cfv (cv x3) (cv g1)) F))))) (wcel (cfv (cv f2) (cmpt g1 cvv (cun A2 (ciun x3 (cdm (cv g1)) (cfv (cfv (cv x3) (cv g1)) F))))) cvv)) $;

--| The recursion rule for the recursive definition generator is defined everywhere. (Contributed by Jim Kingdon, 4-Jul-2019.)
theorem rdgruledefg {x3 f2 g1: setvar} (A2: class x3 f2) (F: class f2) (V: class x3 f2):
  $ wfn F cvv $ >
  $ wi (wcel A2 V) (wa (wfun (cmpt g1 cvv (cun A2 (ciun x3 (cdm (cv g1)) (cfv (cfv (cv x3) (cv g1)) F))))) (wcel (cfv (cv f2) (cmpt g1 cvv (cun A2 (ciun x3 (cdm (cv g1)) (cfv (cfv (cv x3) (cv g1)) F))))) cvv)) $;

--| The recursive definition generator produces a set on a set input. (Contributed by Jim Kingdon, 4-Jul-2019.)
theorem rdgexggg (A2 B2 F V W: class):
  $ wi (w3a (wfn F cvv) (wcel A2 V) (wcel B2 W)) (wcel (cfv B2 (crdg F A2)) cvv) $;

--| The recursive definition generator produces a set on a set input. (Contributed by Jim Kingdon, 4-Jul-2019.)
theorem rdgexgg (A2 B2 F V W: class):
  $ wfn F cvv $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wcel (cfv B2 (crdg F A2)) cvv) $;

--| The recursive definition generator is a function on ordinal numbers. The ` F Fn _V ` condition states that the characteristic function is defined for all sets (being defined for all ordinals might be enough if being used in a manner similar to ~ rdgon ; in cases like ~ df-oadd either presumably could work). (Contributed by Jim Kingdon, 13-Jul-2019.)
theorem rdgifnon (A2 F V: class):
  $ wi (wa (wfn F cvv) (wcel A2 V)) (wfn (crdg F A2) con0) $;

--| The recursive definition generator is a function on ordinal numbers. (Contributed by Jim Kingdon, 14-May-2020.)
theorem rdgifnon2 {z: setvar} (A2: class z) (F: class) (V: class z):
  $ wi (wa (wal z (wcel (cfv (cv z) F) cvv)) (wcel A2 V)) (wfn (crdg F A2) con0) $;

--| Value of the recursive definition generator. Lemma for ~ rdgival which simplifies the value further. (Contributed by Jim Kingdon, 13-Jul-2019.) (New usage is discouraged.)
theorem rdgivallem {x3: setvar} (A2 B2 F V: class):
  $ wi (w3a (wfn F cvv) (wcel A2 V) (wcel B2 con0)) (wceq (cfv B2 (crdg F A2)) (cun A2 (ciun x3 B2 (cfv (cfv (cv x3) (cres (crdg F A2) B2)) F)))) $;

--| Value of the recursive definition generator. (Contributed by Jim Kingdon, 26-Jul-2019.)
theorem rdgival {x3: setvar} (A2 B2 F V: class):
  $ wi (w3a (wfn F cvv) (wcel A2 V) (wcel B2 con0)) (wceq (cfv B2 (crdg F A2)) (cun A2 (ciun x3 B2 (cfv (cfv (cv x3) (crdg F A2)) F)))) $;

--| Subset and recursive definition generator. (Contributed by Jim Kingdon, 15-Jul-2019.)
theorem rdgss (ph: wff) (A2 B2 F I V: class):
  $ wi ph (wfn F cvv) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel A2 con0) $ >
  $ wi ph (wcel B2 con0) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss (cfv A2 (crdg F I)) (cfv B2 (crdg F I))) $;

--| One way of describing the value of the recursive definition generator at a successor. There is no condition on the characteristic function ` F ` other than ` F Fn _V ` . Given that, the resulting expression encompasses both the expected successor term ` ( F `` ( rec ( F , A ) `` B ) ) ` but also terms that correspond to the initial value ` A ` and to limit ordinals ` U_ x e. B ( F `` ( rec ( F , A ) `` x ) ) ` . If we add conditions on the characteristic function, we can show tighter results such as ~ rdgisucinc . (Contributed by Jim Kingdon, 9-Jun-2019.)
theorem rdgisuc1 {x3: setvar} (ph: wff x3) (A2 B2 F V: class):
  $ wi ph (wfn F cvv) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 con0) $ >
  $ wi ph (wceq (cfv (csuc B2) (crdg F A2)) (cun A2 (cun (ciun x3 B2 (cfv (cfv (cv x3) (crdg F A2)) F)) (cfv (cfv B2 (crdg F A2)) F)))) $;

--| Value of the recursive definition generator at a successor. This can be thought of as a generalization of ~ oasuc and ~ omsuc . (Contributed by Jim Kingdon, 29-Aug-2019.)
theorem rdgisucinc {x3: setvar} (ph: wff x3) (A2 B2 F V: class):
  $ wi ph (wfn F cvv) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 con0) $ >
  $ wi ph (wal x3 (wss (cv x3) (cfv (cv x3) F))) $ >
  $ wi ph (wceq (cfv (csuc B2) (crdg F A2)) (cfv (cfv B2 (crdg F A2)) F)) $;

--| Evaluating the recursive definition generator produces an ordinal. There is a hypothesis that the characteristic function produces ordinals on ordinal arguments. (Contributed by Jim Kingdon, 26-Jul-2019.)
theorem rdgon {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (F: class):
  $ wi ph (wfn F cvv) $ >
  $ wi ph (wcel A2 con0) $ >
  $ wi ph (wral x3 (wcel (cfv (cv x3) F) con0) con0) $ >
  $ wi (wa ph (wcel B2 con0)) (wcel (cfv B2 (crdg F A2)) con0) $;

--| The initial value of the recursive definition generator. (Contributed by NM, 23-Apr-1995.) (Revised by Mario Carneiro, 14-Nov-2014.)
theorem rdg0 (A2 F: class):
  $ wcel A2 cvv $ >
  $ wceq (cfv c0 (crdg F A2)) A2 $;

--| The initial value of the recursive definition generator. (Contributed by NM, 25-Apr-1995.)
theorem rdg0g (A2 C F: class):
  $ wi (wcel A2 C) (wceq (cfv c0 (crdg F A2)) A2) $;

--| The recursive definition generator produces a set on a set input. (Contributed by Mario Carneiro, 3-Jul-2019.)
theorem rdgexg (A2 B2 F V: class):
  $ wcel A2 cvv $ >
  $ wfn F cvv $ >
  $ wi (wcel B2 V) (wcel (cfv B2 (crdg F A2)) cvv) $;

--| Extend class notation with the fnite recursive definition generator, with characteristic function ` F ` and initial value ` I ` .
term cfrec (F I: class): class;

--| Define a recursive definition generator on ` _om ` (the class of finite ordinals) with characteristic function ` F ` and initial value ` I ` . This rather amazing operation allows us to define, with compact direct definitions, functions that are usually defined in textbooks only with indirect self-referencing recursive definitions. A recursive definition requires advanced metalogic to justify - in particular, eliminating a recursive definition is very difficult and often not even shown in textbooks. On the other hand, the elimination of a direct definition is a matter of simple mechanical substitution. The price paid is the daunting complexity of our ` frec ` operation (especially when ~ df-recs that it is built on is also eliminated). But once we get past this hurdle, definitions that would otherwise be recursive become relatively simple; see ~ frec0g and ~ frecsuc . Unlike with transfinite recursion, finite recurson can readily divide definitions and proofs into zero and successor cases, because even without excluded middle we have theorems such as ~ nn0suc . The analogous situation with transfinite recursion - being able to say that an ordinal is zero, successor, or limit - is enabled by excluded middle and thus is not available to us. For the characteristic functions which satisfy the conditions given at ~ frecrdg , this definition and ~ df-irdg restricted to ` _om ` produce the same result. _Note: We introduce_ ` frec ` _with the philosophical goal of being_ _able to eliminate all definitions with direct mechanical substitution_ _and to verify easily the soundness of definitions. Metamath itself_ _has no built-in technical limitation that prevents multiple-part_ _recursive definitions in the traditional textbook style_. (Contributed by Mario Carneiro and Jim Kingdon, 10-Aug-2019.)
axiom df_frec {x3 g1 m: setvar} (F I: class):
  $ wceq (cfrec F I) (cres (crecs (cmpt g1 cvv (cab x3 (wo (wrex m (wa (wceq (cdm (cv g1)) (csuc (cv m))) (wcel (cv x3) (cfv (cfv (cv m) (cv g1)) F))) com) (wa (wceq (cdm (cv g1)) c0) (wcel (cv x3) I)))))) com) $;

--| Equality theorem for the finite recursive definition generator. (Contributed by Jim Kingdon, 30-May-2020.)
theorem freceq1 (A2 F G: class):
  $ wi (wceq F G) (wceq (cfrec F A2) (cfrec G A2)) $;

--| Equality theorem for the finite recursive definition generator. (Contributed by Jim Kingdon, 30-May-2020.)
theorem freceq2 (A2 B2 F: class):
  $ wi (wceq A2 B2) (wceq (cfrec F A2) (cfrec F B2)) $;

--| Finite recursion produces a set. (Contributed by Jim Kingdon, 20-Aug-2021.)
theorem frecex (A2 F: class):
  $ wcel (cfrec F A2) cvv $;

--| Bound-variable hypothesis builder for the finite recursive definition generator. (Contributed by Jim Kingdon, 30-May-2020.)
theorem nffrec {x3: setvar} (A2 F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 (cfrec F A2) $;

--| The initial value resulting from finite recursive definition generation. (Contributed by Jim Kingdon, 7-May-2020.)
theorem frec0g (A2 F V: class):
  $ wi (wcel A2 V) (wceq (cfv c0 (cfrec F A2)) A2) $;

--| The class abstraction from ~ df-frec exists. This is a lemma for other finite recursion proofs. (Contributed by Jim Kingdon, 13-May-2020.)
theorem frecabex {x3 y1 m: setvar} (ph: wff x3 y1) (A2: class y1 m) (S F: class m) (V W: class x3 y1 m):
  $ wi ph (wcel S V) $ >
  $ wi ph (wal y1 (wcel (cfv (cv y1) F) cvv)) $ >
  $ wi ph (wcel A2 W) $ >
  $ wi ph (wcel (cab x3 (wo (wrex m (wa (wceq (cdm S) (csuc (cv m))) (wcel (cv x3) (cfv (cfv (cv m) S) F))) com) (wa (wceq (cdm S) c0) (wcel (cv x3) A2)))) cvv) $;

--| Lemma to connect transfinite recursion theorems with finite recursion. That is, given the conditions ` F Fn _V ` and ` A e. V ` on ` frec ( F , A ) ` , we want to be able to apply ~ tfri1d or ~ tfri2d , and this lemma lets us satisfy hypotheses of those theorems. (Contributed by Jim Kingdon, 15-Aug-2019.)
theorem frectfr {x3 y1 z g1 m: setvar} (A2: class z) (F: class) (G: class x3 y1 z g1 m) (V: class x3 z):
  $ wceq G (cmpt g1 cvv (cab x3 (wo (wrex m (wa (wceq (cdm (cv g1)) (csuc (cv m))) (wcel (cv x3) (cfv (cfv (cv m) (cv g1)) F))) com) (wa (wceq (cdm (cv g1)) c0) (wcel (cv x3) A2))))) $ >
  $ wi (wa (wal z (wcel (cfv (cv z) F) cvv)) (wcel A2 V)) (wal y1 (wa (wfun G) (wcel (cfv (cv y1) G) cvv))) $;

--| The function generated by finite recursive definition generation is a function on omega. (Contributed by Jim Kingdon, 13-May-2020.)
theorem frecfnom {z: setvar} (A2 F: class) (V: class z):
  $ wi (wa (wal z (wcel (cfv (cv z) F) cvv)) (wcel A2 V)) (wfn (cfrec F A2) com) $;

--| Lemma for ~ frecsuc . (Contributed by Jim Kingdon, 13-Aug-2019.)
theorem frecsuclem1 {x3 z g1 m: setvar} (A2 B2 F G: class) (V: class z):
  $ wceq G (cmpt g1 cvv (cab x3 (wo (wrex m (wa (wceq (cdm (cv g1)) (csuc (cv m))) (wcel (cv x3) (cfv (cfv (cv m) (cv g1)) F))) com) (wa (wceq (cdm (cv g1)) c0) (wcel (cv x3) A2))))) $ >
  $ wi (w3a (wal z (wcel (cfv (cv z) F) cvv)) (wcel A2 V) (wcel B2 com)) (wceq (cfv (csuc B2) (cfrec F A2)) (cfv (cres (crecs G) (csuc B2)) G)) $;

--| Lemma for ~ frecsuc . (Contributed by Jim Kingdon, 15-Aug-2019.)
theorem frecsuclemdm {x3 z g1 m: setvar} (A2 B2 F G: class) (V: class z):
  $ wceq G (cmpt g1 cvv (cab x3 (wo (wrex m (wa (wceq (cdm (cv g1)) (csuc (cv m))) (wcel (cv x3) (cfv (cfv (cv m) (cv g1)) F))) com) (wa (wceq (cdm (cv g1)) c0) (wcel (cv x3) A2))))) $ >
  $ wi (w3a (wal z (wcel (cfv (cv z) F) cvv)) (wcel A2 V) (wcel B2 com)) (wceq (cdm (cres (crecs G) (csuc B2))) (csuc B2)) $;

--| Lemma for ~ frecsuc . (Contributed by Jim Kingdon, 15-Aug-2019.)
theorem frecsuclem2 {x3 z g1 m: setvar} (A2 B2 F G: class) (V: class z):
  $ wceq G (cmpt g1 cvv (cab x3 (wo (wrex m (wa (wceq (cdm (cv g1)) (csuc (cv m))) (wcel (cv x3) (cfv (cfv (cv m) (cv g1)) F))) com) (wa (wceq (cdm (cv g1)) c0) (wcel (cv x3) A2))))) $ >
  $ wi (w3a (wal z (wcel (cfv (cv z) F) cvv)) (wcel A2 V) (wcel B2 com)) (wceq (cfv B2 (cres (crecs G) (csuc B2))) (cfv B2 (cfrec F A2))) $;

--| Lemma for ~ frecsuc . (Contributed by Jim Kingdon, 15-Aug-2019.)
theorem frecsuclem3 {x3 z g1 m: setvar} (A2 B2 F G: class) (V: class z):
  $ wceq G (cmpt g1 cvv (cab x3 (wo (wrex m (wa (wceq (cdm (cv g1)) (csuc (cv m))) (wcel (cv x3) (cfv (cfv (cv m) (cv g1)) F))) com) (wa (wceq (cdm (cv g1)) c0) (wcel (cv x3) A2))))) $ >
  $ wi (w3a (wal z (wcel (cfv (cv z) F) cvv)) (wcel A2 V) (wcel B2 com)) (wceq (cfv (csuc B2) (cfrec F A2)) (cfv (cfv B2 (cfrec F A2)) F)) $;

--| The successor value resulting from finite recursive definition generation. (Contributed by Jim Kingdon, 15-Aug-2019.)
theorem frecsuc {z: setvar} (A2 B2 F: class) (V: class z):
  $ wi (w3a (wal z (wcel (cfv (cv z) F) cvv)) (wcel A2 V) (wcel B2 com)) (wceq (cfv (csuc B2) (cfrec F A2)) (cfv (cfv B2 (cfrec F A2)) F)) $;

--| Transfinite recursion restricted to omega. Given a suitable characteristic function, ~ df-frec produces the same results as ~ df-irdg restricted to ` _om ` . Presumably the theorem would also hold if ` F Fn _V ` were changed to ` A. z ( F `` z ) e. _V ` . (Contributed by Jim Kingdon, 29-Aug-2019.)
theorem frecrdg {x3: setvar} (ph: wff) (A2 F V: class):
  $ wi ph (wfn F cvv) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wal x3 (wss (cv x3) (cfv (cv x3) F))) $ >
  $ wi ph (wceq (cfrec F A2) (cres (crdg F A2) com)) $;

--| Closure for finite recursion. (Contributed by Jim Kingdon, 25-May-2020.)
theorem freccl {z: setvar} (ph: wff) (A2: class) (B2: class z) (S F: class):
  $ wi ph (wal z (wcel (cfv (cv z) F) cvv)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi (wa ph (wcel (cv z) S)) (wcel (cfv (cv z) F) S) $ >
  $ wi ph (wcel B2 com) $ >
  $ wi ph (wcel (cfv B2 (cfrec F A2)) S) $;

--| Extend the definition of a class to include the ordinal number 1.
term c1o: class;

--| Extend the definition of a class to include the ordinal number 2.
term c2o: class;

--| Extend the definition of a class to include the ordinal number 3.
term c3o: class;

--| Extend the definition of a class to include the ordinal number 4.
term c4o: class;

--| Extend the definition of a class to include the ordinal addition operation.
term coa: class;

--| Extend the definition of a class to include the ordinal multiplication operation.
term comu: class;

--| Extend the definition of a class to include the ordinal exponentiation operation.
term coei: class;

--| Define the ordinal number 1. (Contributed by NM, 29-Oct-1995.)
axiom df_1o:
  $ wceq c1o (csuc c0) $;

--| Define the ordinal number 2. (Contributed by NM, 18-Feb-2004.)
axiom df_2o:
  $ wceq c2o (csuc c1o) $;

--| Define the ordinal number 3. (Contributed by Mario Carneiro, 14-Jul-2013.)
axiom df_3o:
  $ wceq c3o (csuc c2o) $;

--| Define the ordinal number 4. (Contributed by Mario Carneiro, 14-Jul-2013.)
axiom df_4o:
  $ wceq c4o (csuc c3o) $;

--| Define the ordinal addition operation. (Contributed by NM, 3-May-1995.)
axiom df_oadd {x3 y1 z: setvar}:
  $ wceq coa (cmpt2 x3 y1 con0 con0 (cfv (cv y1) (crdg (cmpt z cvv (csuc (cv z))) (cv x3)))) $;

--| Define the ordinal multiplication operation. (Contributed by NM, 26-Aug-1995.)
axiom df_omul {x3 y1 z: setvar}:
  $ wceq comu (cmpt2 x3 y1 con0 con0 (cfv (cv y1) (crdg (cmpt z cvv (co (cv z) (cv x3) coa)) c0))) $;

--| Define the ordinal exponentiation operation. This definition is similar to a conventional definition of exponentiation except that it defines ` (/) ^oi A ` to be ` 1o ` for all ` A e. On ` , in order to avoid having different cases for whether the base is ` (/) ` or not. (Contributed by Mario Carneiro, 4-Jul-2019.)
axiom df_oexpi {x3 y1 z: setvar}:
  $ wceq coei (cmpt2 x3 y1 con0 con0 (cfv (cv y1) (crdg (cmpt z cvv (co (cv z) (cv x3) comu)) c1o))) $;

--| Ordinal 1 is an ordinal number. (Contributed by NM, 29-Oct-1995.)
theorem _1on:
  $ wcel c1o con0 $;

--| Ordinal 2 is an ordinal number. (Contributed by NM, 18-Feb-2004.) (Proof shortened by Andrew Salmon, 12-Aug-2011.)
theorem _2on:
  $ wcel c2o con0 $;

--| Ordinal two is not zero. (Contributed by Scott Fenton, 17-Jun-2011.)
theorem _2on0:
  $ wne c2o c0 $;

--| Ordinal 3 is an ordinal number. (Contributed by Mario Carneiro, 5-Jan-2016.)
theorem _3on:
  $ wcel c3o con0 $;

--| Ordinal 3 is an ordinal number. (Contributed by Mario Carneiro, 5-Jan-2016.)
theorem _4on:
  $ wcel c4o con0 $;

--| Expanded value of the ordinal number 1. (Contributed by NM, 4-Nov-2002.)
theorem df1o2:
  $ wceq c1o (csn c0) $;

--| Expanded value of the ordinal number 2. (Contributed by Mario Carneiro, 14-Aug-2015.)
theorem df2o3:
  $ wceq c2o (cpr c0 c1o) $;

--| Expanded value of the ordinal number 2. (Contributed by NM, 29-Jan-2004.)
theorem df2o2:
  $ wceq c2o (cpr c0 (csn c0)) $;

--| Ordinal one is not equal to ordinal zero. (Contributed by NM, 26-Dec-2004.)
theorem _1n0:
  $ wne c1o c0 $;

--| Cartesian products with the singletons of ordinals 0 and 1 are disjoint. (Contributed by NM, 2-Jun-2007.)
theorem xp01disj (A2 C: class):
  $ wceq (cin (cxp A2 (csn c0)) (cxp C (csn c1o))) c0 $;

--| Two ways to express that an ordinal class is positive. (Contributed by NM, 21-Dec-2004.)
theorem ordgt0ge1 (A2: class):
  $ wi (word A2) (wb (wcel c0 A2) (wss c1o A2)) $;

--| An ordinal greater than or equal to 1 is nonzero. (Contributed by Jim Kingdon, 26-Jun-2019.)
theorem ordge1n0im (A2: class):
  $ wi (word A2) (wi (wss c1o A2) (wne A2 c0)) $;

--| Membership in ordinal one. (Contributed by NM, 5-Jan-2005.)
theorem el1o (A2: class):
  $ wb (wcel A2 c1o) (wceq A2 c0) $;

--| Two ways to say that ` A ` is a nonzero number of the set ` B ` . (Contributed by Mario Carneiro, 21-May-2015.)
theorem dif1o (A2 B2: class):
  $ wb (wcel A2 (cdif B2 c1o)) (wa (wcel A2 B2) (wne A2 c0)) $;

--| Closure of the pair swapping function on ` 2o ` . (Contributed by Mario Carneiro, 27-Sep-2015.)
theorem _2oconcl (A2: class):
  $ wi (wcel A2 c2o) (wcel (cdif c1o A2) c2o) $;

--| Ordinal zero is less than ordinal one. (Contributed by NM, 5-Jan-2005.)
theorem _0lt1o:
  $ wcel c0 c1o $;

--| The characteristic function for ordinal addition is defined everywhere. (Contributed by Jim Kingdon, 27-Jul-2019.)
theorem oafnex {x3: setvar}:
  $ wfn (cmpt x3 cvv (csuc (cv x3))) cvv $;

--| Successor is increasing. (Contributed by Jim Kingdon, 25-Jun-2019.)
theorem sucinc {x3 z: setvar} (F: class x3 z):
  $ wceq F (cmpt z cvv (csuc (cv z))) $ >
  $ wal x3 (wss (cv x3) (cfv (cv x3) F)) $;

--| Successor is increasing. (Contributed by Jim Kingdon, 14-Jul-2019.)
theorem sucinc2 {z: setvar} (A2 B2: class) (F: class z):
  $ wceq F (cmpt z cvv (csuc (cv z))) $ >
  $ wi (wa (wcel B2 con0) (wcel A2 B2)) (wss (cfv A2 F) (cfv B2 F)) $;

--| Functionality and domain of ordinal addition. (Contributed by NM, 26-Aug-1995.) (Proof shortened by Mario Carneiro, 3-Jul-2019.)
theorem fnoa:
  $ wfn coa (cxp con0 con0) $;

--| Ordinal addition is a set. (Contributed by Mario Carneiro, 3-Jul-2019.)
theorem oaexg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wcel (co A2 B2 coa) cvv) $;

--| The characteristic function for ordinal multiplication is defined everywhere. (Contributed by Jim Kingdon, 23-Aug-2019.)
theorem omfnex {x3: setvar} (A2 V: class):
  $ wi (wcel A2 V) (wfn (cmpt x3 cvv (co (cv x3) A2 coa)) cvv) $;

--| Functionality and domain of ordinal multiplication. (Contributed by NM, 26-Aug-1995.) (Revised by Mario Carneiro, 3-Jul-2019.)
theorem fnom:
  $ wfn comu (cxp con0 con0) $;

--| Ordinal multiplication is a set. (Contributed by Mario Carneiro, 3-Jul-2019.)
theorem omexg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wcel (co A2 B2 comu) cvv) $;

--| Functionality and domain of ordinal exponentiation. (Contributed by Mario Carneiro, 29-May-2015.) (Revised by Mario Carneiro, 3-Jul-2019.)
theorem fnoei:
  $ wfn coei (cxp con0 con0) $;

--| Ordinal exponentiation is a set. (Contributed by Mario Carneiro, 3-Jul-2019.)
theorem oeiexg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wcel (co A2 B2 coei) cvv) $;

--| Value of ordinal addition. (Contributed by NM, 3-May-1995.) (Revised by Mario Carneiro, 8-Sep-2013.)
theorem oav {x3: setvar} (A2: class) (B2: class x3):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wceq (co A2 B2 coa) (cfv B2 (crdg (cmpt x3 cvv (csuc (cv x3))) A2))) $;

--| Value of ordinal multiplication. (Contributed by NM, 17-Sep-1995.) (Revised by Mario Carneiro, 23-Aug-2014.)
theorem omv {x3: setvar} (A2: class) (B2: class x3):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wceq (co A2 B2 comu) (cfv B2 (crdg (cmpt x3 cvv (co (cv x3) A2 coa)) c0))) $;

--| Value of ordinal exponentiation. (Contributed by Jim Kingdon, 9-Jul-2019.)
theorem oeiv {x3: setvar} (A2: class) (B2: class x3):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wceq (co A2 B2 coei) (cfv B2 (crdg (cmpt x3 cvv (co (cv x3) A2 comu)) c1o))) $;

--| Addition with zero. Proposition 8.3 of [TakeutiZaring] p. 57. (Contributed by NM, 3-May-1995.) (Revised by Mario Carneiro, 8-Sep-2013.)
theorem oa0 (A2: class):
  $ wi (wcel A2 con0) (wceq (co A2 c0 coa) A2) $;

--| Ordinal multiplication with zero. Definition 8.15 of [TakeutiZaring] p. 62. (Contributed by NM, 17-Sep-1995.) (Revised by Mario Carneiro, 8-Sep-2013.)
theorem om0 (A2: class):
  $ wi (wcel A2 con0) (wceq (co A2 c0 comu) c0) $;

--| Ordinal exponentiation with zero exponent. Definition 8.30 of [TakeutiZaring] p. 67. (Contributed by NM, 31-Dec-2004.) (Revised by Mario Carneiro, 8-Sep-2013.)
theorem oei0 (A2: class):
  $ wi (wcel A2 con0) (wceq (co A2 c0 coei) c1o) $;

--| Closure law for ordinal addition. Proposition 8.2 of [TakeutiZaring] p. 57. (Contributed by NM, 5-May-1995.) (Constructive proof by Jim Kingdon, 26-Jul-2019.)
theorem oacl (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wcel (co A2 B2 coa) con0) $;

--| Closure law for ordinal multiplication. Proposition 8.16 of [TakeutiZaring] p. 57. (Contributed by NM, 3-Aug-2004.) (Constructive proof by Jim Kingdon, 26-Jul-2019.)
theorem omcl (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wcel (co A2 B2 comu) con0) $;

--| Closure law for ordinal exponentiation. (Contributed by Jim Kingdon, 26-Jul-2019.)
theorem oeicl (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wcel (co A2 B2 coei) con0) $;

--| Value of ordinal addition. (Contributed by Mario Carneiro and Jim Kingdon, 12-Aug-2019.)
theorem oav2 {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wceq (co A2 B2 coa) (cun A2 (ciun x3 B2 (csuc (co A2 (cv x3) coa))))) $;

--| Addition with successor. Definition 8.1 of [TakeutiZaring] p. 56. (Contributed by NM, 3-May-1995.) (Revised by Mario Carneiro, 8-Sep-2013.)
theorem oasuc (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wceq (co A2 (csuc B2) coa) (csuc (co A2 B2 coa))) $;

--| Value of ordinal multiplication. (Contributed by Jim Kingdon, 23-Aug-2019.)
theorem omv2 {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wceq (co A2 B2 comu) (ciun x3 B2 (co (co A2 (cv x3) comu) A2 coa))) $;

--| Addition with successor. Theorem 4I(A2) of [Enderton] p. 79. (Contributed by Mario Carneiro, 16-Nov-2014.)
theorem onasuc (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 com)) (wceq (co A2 (csuc B2) coa) (csuc (co A2 B2 coa))) $;

--| Addition with 1 is same as successor. Proposition 4.34(a) of [Mendelson] p. 266. (Contributed by NM, 29-Oct-1995.) (Revised by Mario Carneiro, 16-Nov-2014.)
theorem oa1suc (A2: class):
  $ wi (wcel A2 con0) (wceq (co A2 c1o coa) (csuc A2)) $;

--| 1 + 1 = 2 for ordinal numbers. (Contributed by NM, 18-Feb-2004.)
theorem o1p1e2:
  $ wceq (co c1o c1o coa) c2o $;

--| Weak ordering property of ordinal addition. (Contributed by Jim Kingdon, 27-Jul-2019.)
theorem oawordi (A2 B2 C: class):
  $ wi (w3a (wcel A2 con0) (wcel B2 con0) (wcel C con0)) (wi (wss A2 B2) (wss (co C A2 coa) (co C B2 coa))) $;

--| An ordinal is less than or equal to its sum with another. Part of Exercise 5 of [TakeutiZaring] p. 62. (Contributed by NM, 6-Dec-2004.)
theorem oaword1 (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wss A2 (co A2 B2 coa)) $;

--| Multiplication with successor. Definition 8.15 of [TakeutiZaring] p. 62. (Contributed by NM, 17-Sep-1995.) (Revised by Mario Carneiro, 8-Sep-2013.)
theorem omsuc (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wceq (co A2 (csuc B2) comu) (co (co A2 B2 comu) A2 coa)) $;

--| Multiplication with successor. Theorem 4J(A2) of [Enderton] p. 80. (Contributed by NM, 20-Sep-1995.) (Revised by Mario Carneiro, 14-Nov-2014.)
theorem onmsuc (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 com)) (wceq (co A2 (csuc B2) comu) (co (co A2 B2 comu) A2 coa)) $;

--| Addition with zero. Theorem 4I(A1) of [Enderton] p. 79. (Contributed by NM, 20-Sep-1995.)
theorem nna0 (A2: class):
  $ wi (wcel A2 com) (wceq (co A2 c0 coa) A2) $;

--| Multiplication with zero. Theorem 4J(A1) of [Enderton] p. 80. (Contributed by NM, 20-Sep-1995.)
theorem nnm0 (A2: class):
  $ wi (wcel A2 com) (wceq (co A2 c0 comu) c0) $;

--| Addition with successor. Theorem 4I(A2) of [Enderton] p. 79. (Contributed by NM, 20-Sep-1995.) (Revised by Mario Carneiro, 14-Nov-2014.)
theorem nnasuc (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wceq (co A2 (csuc B2) coa) (csuc (co A2 B2 coa))) $;

--| Multiplication with successor. Theorem 4J(A2) of [Enderton] p. 80. (Contributed by NM, 20-Sep-1995.) (Revised by Mario Carneiro, 14-Nov-2014.)
theorem nnmsuc (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wceq (co A2 (csuc B2) comu) (co (co A2 B2 comu) A2 coa)) $;

--| Addition to zero. Remark in proof of Theorem 4K(2) of [Enderton] p. 81. (Contributed by NM, 20-Sep-1995.) (Revised by Mario Carneiro, 14-Nov-2014.)
theorem nna0r (A2: class):
  $ wi (wcel A2 com) (wceq (co c0 A2 coa) A2) $;

--| Multiplication with zero. Exercise 16 of [Enderton] p. 82. (Contributed by NM, 20-Sep-1995.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem nnm0r (A2: class):
  $ wi (wcel A2 com) (wceq (co c0 A2 comu) c0) $;

--| Closure of addition of natural numbers. Proposition 8.9 of [TakeutiZaring] p. 59. (Contributed by NM, 20-Sep-1995.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem nnacl (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wcel (co A2 B2 coa) com) $;

--| Closure of multiplication of natural numbers. Proposition 8.17 of [TakeutiZaring] p. 63. (Contributed by NM, 20-Sep-1995.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem nnmcl (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wcel (co A2 B2 comu) com) $;

--| ` _om ` is closed under addition. Inference form of ~ nnacl . (Contributed by Scott Fenton, 20-Apr-2012.)
theorem nnacli (A2 B2: class):
  $ wcel A2 com $ >
  $ wcel B2 com $ >
  $ wcel (co A2 B2 coa) com $;

--| ` _om ` is closed under multiplication. Inference form of ~ nnmcl . (Contributed by Scott Fenton, 20-Apr-2012.)
theorem nnmcli (A2 B2: class):
  $ wcel A2 com $ >
  $ wcel B2 com $ >
  $ wcel (co A2 B2 comu) com $;

--| Addition of natural numbers is commutative. Theorem 4K(2) of [Enderton] p. 81. (Contributed by NM, 6-May-1995.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem nnacom (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wceq (co A2 B2 coa) (co B2 A2 coa)) $;

--| Addition of natural numbers is associative. Theorem 4K(1) of [Enderton] p. 81. (Contributed by NM, 20-Sep-1995.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem nnaass (A2 B2 C: class):
  $ wi (w3a (wcel A2 com) (wcel B2 com) (wcel C com)) (wceq (co (co A2 B2 coa) C coa) (co A2 (co B2 C coa) coa)) $;

--| Distributive law for natural numbers (left-distributivity). Theorem 4K(3) of [Enderton] p. 81. (Contributed by NM, 20-Sep-1995.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem nndi (A2 B2 C: class):
  $ wi (w3a (wcel A2 com) (wcel B2 com) (wcel C com)) (wceq (co A2 (co B2 C coa) comu) (co (co A2 B2 comu) (co A2 C comu) coa)) $;

--| Multiplication of natural numbers is associative. Theorem 4K(4) of [Enderton] p. 81. (Contributed by NM, 20-Sep-1995.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem nnmass (A2 B2 C: class):
  $ wi (w3a (wcel A2 com) (wcel B2 com) (wcel C com)) (wceq (co (co A2 B2 comu) C comu) (co A2 (co B2 C comu) comu)) $;

--| Multiplication with successor. Exercise 16 of [Enderton] p. 82. (Contributed by NM, 21-Sep-1995.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem nnmsucr (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wceq (co (csuc A2) B2 comu) (co (co A2 B2 comu) B2 coa)) $;

--| Multiplication of natural numbers is commutative. Theorem 4K(5) of [Enderton] p. 81. (Contributed by NM, 21-Sep-1995.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem nnmcom (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wceq (co A2 B2 comu) (co B2 A2 comu)) $;

--| Distributive law for natural numbers (right-distributivity). (Contributed by Jim Kingdon, 3-Dec-2019.)
theorem nndir (A2 B2 C: class):
  $ wi (w3a (wcel A2 com) (wcel B2 com) (wcel C com)) (wceq (co (co A2 B2 coa) C comu) (co (co A2 C comu) (co B2 C comu) coa)) $;

--| Membership is inherited by successors. The reverse direction holds for all ordinals, as seen at ~ onsucelsucr , but the forward direction, for all ordinals, implies excluded middle as seen as ~ onsucelsucexmid . (Contributed by Jim Kingdon, 25-Aug-2019.)
theorem nnsucelsuc (A2 B2: class):
  $ wi (wcel B2 com) (wb (wcel A2 B2) (wcel (csuc A2) (csuc B2))) $;

--| Membership is inherited by successors. The reverse direction holds for all ordinals, as seen at ~ onsucsssucr , but the forward direction, for all ordinals, implies excluded middle as seen as ~ onsucsssucexmid . (Contributed by Jim Kingdon, 25-Aug-2019.)
theorem nnsucsssuc (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wb (wss A2 B2) (wss (csuc A2) (csuc B2))) $;

--| Trichotomy for natural numbers. (Contributed by Jim Kingdon, 25-Aug-2019.)
theorem nntri3or (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (w3o (wcel A2 B2) (wceq A2 B2) (wcel B2 A2)) $;

--| A trichotomy law for natural numbers. (Contributed by Jim Kingdon, 28-Aug-2019.)
theorem nntri2 (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wb (wcel A2 B2) (wn (wo (wceq A2 B2) (wcel B2 A2)))) $;

--| A trichotomy law for natural numbers. (Contributed by Jim Kingdon, 28-Aug-2019.)
theorem nntri1 (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wb (wss A2 B2) (wn (wcel B2 A2))) $;

--| A trichotomy law for natural numbers. (Contributed by Jim Kingdon, 15-May-2020.)
theorem nntri3 (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wb (wceq A2 B2) (wa (wn (wcel A2 B2)) (wn (wcel B2 A2)))) $;

--| A trichotomy law for natural numbers. (Contributed by Jim Kingdon, 15-Sep-2021.)
theorem nntri2or2 (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wo (wss A2 B2) (wss B2 A2)) $;

--| Equality of natural numbers is decidable. Theorem 7.2.6 of [HoTT], p. (varies). For the specific case where ` B ` is zero, see ~ nndceq0 . (Contributed by Jim Kingdon, 31-Aug-2019.)
theorem nndceq (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wdc (wceq A2 B2)) $;

--| Set membership between two natural numbers is decidable. (Contributed by Jim Kingdon, 6-Sep-2019.)
theorem nndcel (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wdc (wcel A2 B2)) $;

--| For natural numbers, inclusion is equivalent to membership or equality. (Contributed by Jim Kingdon, 16-Sep-2021.)
theorem nnsseleq (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wb (wss A2 B2) (wo (wcel A2 B2) (wceq A2 B2))) $;

--| If we remove a single element from a natural number then put it back in, we end up with the original natural number. This strengthens ~ difsnss from subset to equality but the proof relies on equality being decidable. (Contributed by Jim Kingdon, 31-Aug-2021.)
theorem nndifsnid (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 A2)) (wceq (cun (cdif A2 (csn B2)) (csn B2)) A2) $;

--| Ordering property of addition. Proposition 8.4 of [TakeutiZaring] p. 58, limited to natural numbers. (Contributed by NM, 3-Feb-1996.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem nnaordi (A2 B2 C: class):
  $ wi (wa (wcel B2 com) (wcel C com)) (wi (wcel A2 B2) (wcel (co C A2 coa) (co C B2 coa))) $;

--| Ordering property of addition. Proposition 8.4 of [TakeutiZaring] p. 58, limited to natural numbers, and its converse. (Contributed by NM, 7-Mar-1996.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem nnaord (A2 B2 C: class):
  $ wi (w3a (wcel A2 com) (wcel B2 com) (wcel C com)) (wb (wcel A2 B2) (wcel (co C A2 coa) (co C B2 coa))) $;

--| Ordering property of addition of natural numbers. (Contributed by NM, 9-Nov-2002.)
theorem nnaordr (A2 B2 C: class):
  $ wi (w3a (wcel A2 com) (wcel B2 com) (wcel C com)) (wb (wcel A2 B2) (wcel (co A2 C coa) (co B2 C coa))) $;

--| Weak ordering property of addition. (Contributed by NM, 17-Sep-1995.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem nnaword (A2 B2 C: class):
  $ wi (w3a (wcel A2 com) (wcel B2 com) (wcel C com)) (wb (wss A2 B2) (wss (co C A2 coa) (co C B2 coa))) $;

--| Cancellation law for addition of natural numbers. (Contributed by NM, 27-Oct-1995.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem nnacan (A2 B2 C: class):
  $ wi (w3a (wcel A2 com) (wcel B2 com) (wcel C com)) (wb (wceq (co A2 B2 coa) (co A2 C coa)) (wceq B2 C)) $;

--| Weak ordering property of addition. (Contributed by NM, 9-Nov-2002.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem nnaword1 (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wss A2 (co A2 B2 coa)) $;

--| Weak ordering property of addition. (Contributed by NM, 9-Nov-2002.)
theorem nnaword2 (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wss A2 (co B2 A2 coa)) $;

--| Adding to both sides of an inequality in ` _om ` (Contributed by Scott Fenton, 16-Apr-2012.) (Revised by Mario Carneiro, 12-May-2012.)
theorem nnawordi (A2 B2 C: class):
  $ wi (w3a (wcel A2 com) (wcel B2 com) (wcel C com)) (wi (wss A2 B2) (wss (co A2 C coa) (co B2 C coa))) $;

--| Ordering property of multiplication. Half of Proposition 8.19 of [TakeutiZaring] p. 63, limited to natural numbers. (Contributed by NM, 18-Sep-1995.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem nnmordi (A2 B2 C: class):
  $ wi (wa (wa (wcel B2 com) (wcel C com)) (wcel c0 C)) (wi (wcel A2 B2) (wcel (co C A2 comu) (co C B2 comu))) $;

--| Ordering property of multiplication. Proposition 8.19 of [TakeutiZaring] p. 63, limited to natural numbers. (Contributed by NM, 22-Jan-1996.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem nnmord (A2 B2 C: class):
  $ wi (w3a (wcel A2 com) (wcel B2 com) (wcel C com)) (wb (wa (wcel A2 B2) (wcel c0 C)) (wcel (co C A2 comu) (co C B2 comu))) $;

--| Weak ordering property of ordinal multiplication. (Contributed by Mario Carneiro, 17-Nov-2014.)
theorem nnmword (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 com) (wcel B2 com) (wcel C com)) (wcel c0 C)) (wb (wss A2 B2) (wss (co C A2 comu) (co C B2 comu))) $;

--| Cancellation law for multiplication of natural numbers. (Contributed by NM, 26-Oct-1995.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem nnmcan (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 com) (wcel B2 com) (wcel C com)) (wcel c0 A2)) (wb (wceq (co A2 B2 comu) (co A2 C comu)) (wceq B2 C)) $;

--| One is a natural number. (Contributed by NM, 29-Oct-1995.)
theorem _1onn:
  $ wcel c1o com $;

--| The ordinal 2 is a natural number. (Contributed by NM, 28-Sep-2004.)
theorem _2onn:
  $ wcel c2o com $;

--| The ordinal 3 is a natural number. (Contributed by Mario Carneiro, 5-Jan-2016.)
theorem _3onn:
  $ wcel c3o com $;

--| The ordinal 4 is a natural number. (Contributed by Mario Carneiro, 5-Jan-2016.)
theorem _4onn:
  $ wcel c4o com $;

--| Multiply an element of ` _om ` by ` 1o ` . (Contributed by Mario Carneiro, 17-Nov-2014.)
theorem nnm1 (A2: class):
  $ wi (wcel A2 com) (wceq (co A2 c1o comu) A2) $;

--| Multiply an element of ` _om ` by ` 2o ` (Contributed by Scott Fenton, 18-Apr-2012.) (Revised by Mario Carneiro, 17-Nov-2014.)
theorem nnm2 (A2: class):
  $ wi (wcel A2 com) (wceq (co A2 c2o comu) (co A2 A2 coa)) $;

--| Multiply an element of ` _om ` by ` 2o ` (Contributed by Scott Fenton, 16-Apr-2012.) (Revised by Mario Carneiro, 17-Nov-2014.)
theorem nn2m (A2: class):
  $ wi (wcel A2 com) (wceq (co c2o A2 comu) (co A2 A2 coa)) $;

--| Equivalence for ordering. Compare Exercise 23 of [Enderton] p. 88. (Contributed by NM, 5-Dec-1995.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem nnaordex {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wb (wcel A2 B2) (wrex x3 (wa (wcel c0 (cv x3)) (wceq (co A2 (cv x3) coa) B2)) com)) $;

--| Equivalence for weak ordering of natural numbers. (Contributed by NM, 8-Nov-2002.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem nnawordex {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wb (wss A2 B2) (wrex x3 (wceq (co A2 (cv x3) coa) B2) com)) $;

--| The product of two natural numbers is zero iff at least one of them is zero. (Contributed by Jim Kingdon, 11-Nov-2004.)
theorem nnm00 (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wb (wceq (co A2 B2 comu) c0) (wo (wceq A2 c0) (wceq B2 c0))) $;

--| Extend the definition of a wff to include the equivalence predicate.
term wer (A2 R: class): wff;

--| Extend the definition of a class to include equivalence class.
term cec (A2 R: class): class;

--| Extend the definition of a class to include quotient set.
term cqs (A2 R: class): class;

--| Define the equivalence relation predicate. Our notation is not standard. A formal notation doesn't seem to exist in the literature; instead only informal English tends to be used. The present definition, although somewhat cryptic, nicely avoids dummy variables. In ~ dfer2 we derive a more typical definition. We show that an equivalence relation is reflexive, symmetric, and transitive in ~ erref , ~ ersymb , and ~ ertr . (Contributed by NM, 4-Jun-1995.) (Revised by Mario Carneiro, 2-Nov-2015.)
axiom df_er (A2 R: class):
  $ wb (wer A2 R) (w3a (wrel R) (wceq (cdm R) A2) (wss (cun (ccnv R) (ccom R R)) R)) $;

--| Alternate definition of equivalence predicate. (Contributed by NM, 3-Jan-1997.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem dfer2 {x3 y1 z: setvar} (A2: class x3 y1 z) (R: class):
  $ wb (wer A2 R) (w3a (wrel R) (wceq (cdm R) A2) (wal x3 (wal y1 (wal z (wa (wi (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)) (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R)) (wbr (cv x3) (cv z) R))))))) $;

--| Define the ` R ` -coset of ` A ` . Exercise 35 of [Enderton] p. 61. This is called the equivalence class of ` A ` modulo ` R ` when ` R ` is an equivalence relation (i.e. when ` Er R ` ; see ~ dfer2 ). In this case, ` A ` is a representative (member) of the equivalence class ` [ A ] R ` , which contains all sets that are equivalent to ` A ` . Definition of [Enderton] p. 57 uses the notation ` [ A ] ` (subscript) ` R ` , although we simply follow the brackets by ` R ` since we don't have subscripted expressions. For an alternate definition, see ~ dfec2 . (Contributed by NM, 23-Jul-1995.)
axiom df_ec (A2 R: class):
  $ wceq (cec A2 R) (cima R (csn A2)) $;

--| Alternate definition of ` R ` -coset of ` A ` . Definition 34 of [Suppes] p. 81. (Contributed by NM, 3-Jan-1997.) (Proof shortened by Mario Carneiro, 9-Jul-2014.)
theorem dfec2 {y1: setvar} (A2 R: class) (V: class y1):
  $ wi (wcel A2 V) (wceq (cec A2 R) (cab y1 (wbr A2 (cv y1) R))) $;

--| An equivalence class modulo a set is a set. (Contributed by NM, 24-Jul-1995.)
theorem ecexg (A2 B2 R: class):
  $ wi (wcel R B2) (wcel (cec A2 R) cvv) $;

--| An inhabited equivalence class implies the representative is a set. (Contributed by Mario Carneiro, 9-Jul-2014.)
theorem ecexr (A2 B2 R: class):
  $ wi (wcel A2 (cec B2 R)) (wcel B2 cvv) $;

--| Define quotient set. ` R ` is usually an equivalence relation. Definition of [Enderton] p. 58. (Contributed by NM, 23-Jul-1995.)
axiom df_qs {x3 y1: setvar} (A2 R: class):
  $ wceq (cqs A2 R) (cab y1 (wrex x3 (wceq (cv y1) (cec (cv x3) R)) A2)) $;

--| Equality theorem for equivalence predicate. (Contributed by NM, 4-Jun-1995.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem ereq1 (A2 R S: class):
  $ wi (wceq R S) (wb (wer A2 R) (wer A2 S)) $;

--| Equality theorem for equivalence predicate. (Contributed by Mario Carneiro, 12-Aug-2015.)
theorem ereq2 (A2 B2 R: class):
  $ wi (wceq A2 B2) (wb (wer A2 R) (wer B2 R)) $;

--| An equivalence relation is a relation. (Contributed by Mario Carneiro, 12-Aug-2015.)
theorem errel (A2 R: class):
  $ wi (wer A2 R) (wrel R) $;

--| The domain of an equivalence relation. (Contributed by Mario Carneiro, 12-Aug-2015.)
theorem erdm (A2 R: class):
  $ wi (wer A2 R) (wceq (cdm R) A2) $;

--| Elementhood in the field of an equivalence relation. (Contributed by Mario Carneiro, 12-Aug-2015.)
theorem ercl (ph: wff) (A2 B2 R X: class):
  $ wi ph (wer X R) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wcel A2 X) $;

--| An equivalence relation is symmetric. (Contributed by NM, 4-Jun-1995.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem ersym (ph: wff) (A2 B2 R X: class):
  $ wi ph (wer X R) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wbr B2 A2 R) $;

--| Elementhood in the field of an equivalence relation. (Contributed by Mario Carneiro, 12-Aug-2015.)
theorem ercl2 (ph: wff) (A2 B2 R X: class):
  $ wi ph (wer X R) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wcel B2 X) $;

--| An equivalence relation is symmetric. (Contributed by NM, 30-Jul-1995.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem ersymb (ph: wff) (A2 B2 R X: class):
  $ wi ph (wer X R) $ >
  $ wi ph (wb (wbr A2 B2 R) (wbr B2 A2 R)) $;

--| An equivalence relation is transitive. (Contributed by NM, 4-Jun-1995.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem ertr (ph: wff) (A2 B2 C R X: class):
  $ wi ph (wer X R) $ >
  $ wi ph (wi (wa (wbr A2 B2 R) (wbr B2 C R)) (wbr A2 C R)) $;

--| A transitivity relation for equivalences. (Contributed by Mario Carneiro, 9-Jul-2014.)
theorem ertrd (ph: wff) (A2 B2 C R X: class):
  $ wi ph (wer X R) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wbr B2 C R) $ >
  $ wi ph (wbr A2 C R) $;

--| A transitivity relation for equivalences. (Contributed by Mario Carneiro, 9-Jul-2014.)
theorem ertr2d (ph: wff) (A2 B2 C R X: class):
  $ wi ph (wer X R) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wbr B2 C R) $ >
  $ wi ph (wbr C A2 R) $;

--| A transitivity relation for equivalences. (Contributed by Mario Carneiro, 9-Jul-2014.)
theorem ertr3d (ph: wff) (A2 B2 C R X: class):
  $ wi ph (wer X R) $ >
  $ wi ph (wbr B2 A2 R) $ >
  $ wi ph (wbr B2 C R) $ >
  $ wi ph (wbr A2 C R) $;

--| A transitivity relation for equivalences. (Contributed by Mario Carneiro, 9-Jul-2014.)
theorem ertr4d (ph: wff) (A2 B2 C R X: class):
  $ wi ph (wer X R) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wbr C B2 R) $ >
  $ wi ph (wbr A2 C R) $;

--| An equivalence relation is reflexive on its field. Compare Theorem 3M of [Enderton] p. 56. (Contributed by Mario Carneiro, 6-May-2013.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem erref (ph: wff) (A2 R X: class):
  $ wi ph (wer X R) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wbr A2 A2 R) $;

--| The converse of an equivalence relation is itself. (Contributed by Mario Carneiro, 12-Aug-2015.)
theorem ercnv (A2 R: class):
  $ wi (wer A2 R) (wceq (ccnv R) R) $;

--| The range and domain of an equivalence relation are equal. (Contributed by Rodolfo Medina, 11-Oct-2010.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem errn (A2 R: class):
  $ wi (wer A2 R) (wceq (crn R) A2) $;

--| An equivalence relation is a subset of the cartesian product of the field. (Contributed by Mario Carneiro, 12-Aug-2015.)
theorem erssxp (A2 R: class):
  $ wi (wer A2 R) (wss R (cxp A2 A2)) $;

--| An equivalence relation is a set if its domain is a set. (Contributed by Rodolfo Medina, 15-Oct-2010.) (Proof shortened by Mario Carneiro, 12-Aug-2015.)
theorem erex (A2 R V: class):
  $ wi (wer A2 R) (wi (wcel A2 V) (wcel R cvv)) $;

--| An equivalence relation is a set if and only if its domain is a set. (Contributed by Rodolfo Medina, 15-Oct-2010.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem erexb (A2 R: class):
  $ wi (wer A2 R) (wb (wcel R cvv) (wcel A2 cvv)) $;

--| A reflexive, symmetric, transitive relation is an equivalence relation on its domain. (Contributed by Mario Carneiro, 9-Jul-2014.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem iserd {x3 y1 z: setvar} (ph: wff) (A2: class y1 z) (R: class):
  $ wi ph (wrel R) $ >
  $ wi (wa ph (wbr (cv x3) (cv y1) R)) (wbr (cv y1) (cv x3) R) $ >
  $ wi (wa ph (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R))) (wbr (cv x3) (cv z) R) $ >
  $ wi ph (wb (wcel (cv x3) A2) (wbr (cv x3) (cv x3) R)) $ >
  $ wi ph (wer A2 R) $;

--| Evaluate the incomparability relation. (Contributed by Mario Carneiro, 9-Jul-2014.)
theorem brdifun (A2 B2 R c_lt X: class):
  $ wceq R (cdif (cxp X X) (cun c_lt (ccnv c_lt))) $ >
  $ wi (wa (wcel A2 X) (wcel B2 X)) (wb (wbr A2 B2 R) (wn (wo (wbr A2 B2 c_lt) (wbr B2 A2 c_lt)))) $;

--| Incomparability under a strict weak partial order is an equivalence relation. (Contributed by Mario Carneiro, 9-Jul-2014.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem swoer {x3 y1 z: setvar} (ph: wff) (R: class x3 y1 z) (c_lt X: class):
  $ wceq R (cdif (cxp X X) (cun c_lt (ccnv c_lt))) $ >
  $ wi (wa ph (wa (wcel (cv y1) X) (wcel (cv z) X))) (wi (wbr (cv y1) (cv z) c_lt) (wn (wbr (cv z) (cv y1) c_lt))) $ >
  $ wi (wa ph (w3a (wcel (cv x3) X) (wcel (cv y1) X) (wcel (cv z) X))) (wi (wbr (cv x3) (cv y1) c_lt) (wo (wbr (cv x3) (cv z) c_lt) (wbr (cv z) (cv y1) c_lt))) $ >
  $ wi ph (wer X R) $;

--| The incomparability equivalence relation is compatible with the original order. (Contributed by Mario Carneiro, 31-Dec-2014.)
theorem swoord1 {x3 y1 z: setvar} (ph: wff) (A2 B2 C: class) (R: class x3 y1 z) (c_lt X: class):
  $ wceq R (cdif (cxp X X) (cun c_lt (ccnv c_lt))) $ >
  $ wi (wa ph (wa (wcel (cv y1) X) (wcel (cv z) X))) (wi (wbr (cv y1) (cv z) c_lt) (wn (wbr (cv z) (cv y1) c_lt))) $ >
  $ wi (wa ph (w3a (wcel (cv x3) X) (wcel (cv y1) X) (wcel (cv z) X))) (wi (wbr (cv x3) (cv y1) c_lt) (wo (wbr (cv x3) (cv z) c_lt) (wbr (cv z) (cv y1) c_lt))) $ >
  $ wi ph (wcel B2 X) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wb (wbr A2 C c_lt) (wbr B2 C c_lt)) $;

--| The incomparability equivalence relation is compatible with the original order. (Contributed by Mario Carneiro, 31-Dec-2014.)
theorem swoord2 {x3 y1 z: setvar} (ph: wff) (A2 B2 C: class) (R: class x3 y1 z) (c_lt X: class):
  $ wceq R (cdif (cxp X X) (cun c_lt (ccnv c_lt))) $ >
  $ wi (wa ph (wa (wcel (cv y1) X) (wcel (cv z) X))) (wi (wbr (cv y1) (cv z) c_lt) (wn (wbr (cv z) (cv y1) c_lt))) $ >
  $ wi (wa ph (w3a (wcel (cv x3) X) (wcel (cv y1) X) (wcel (cv z) X))) (wi (wbr (cv x3) (cv y1) c_lt) (wo (wbr (cv x3) (cv z) c_lt) (wbr (cv z) (cv y1) c_lt))) $ >
  $ wi ph (wcel B2 X) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wb (wbr C A2 c_lt) (wbr C B2 c_lt)) $;

--| Lemma for ~ eqer . (Contributed by NM, 17-Mar-2008.) (Proof shortened by Mario Carneiro, 6-Dec-2016.)
theorem eqerlem {x3 y1 z w: setvar} (A2: class x3 z w) (B2: class y1 z w) (R: class x3 y1 z w):
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wceq R (copab x3 y1 (wceq A2 B2)) $ >
  $ wb (wbr (cv z) (cv w) R) (wceq (csb x3 (cv z) A2) (csb x3 (cv w) A2)) $;

--| Lemma for ~ eqer . (Contributed by NM, 17-Mar-2008.) (Proof shortened by Mario Carneiro, 6-Dec-2016.)
theorem eqerlem_b {x3 y1 z: setvar} (A2: class x3 z) (B2: class y1 z) (R: class x3 y1 z):
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wceq R (copab x3 y1 (wceq A2 B2)) $ >
  $ wb (wbr (cv z) (cv z) R) (wceq (csb x3 (cv z) A2) (csb x3 (cv z) A2)) $;

--| Equivalence relation involving equality of dependent classes ` A ( x ) ` and ` B ( y ) ` . (Contributed by NM, 17-Mar-2008.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem eqer {x3 y1: setvar} (A2: class x3) (B2: class y1) (R: class x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wceq R (copab x3 y1 (wceq A2 B2)) $ >
  $ wer cvv R $;

--| The identity relation is an equivalence relation. (Contributed by NM, 10-May-1998.) (Proof shortened by Andrew Salmon, 22-Oct-2011.) (Proof shortened by Mario Carneiro, 9-Jul-2014.)
theorem ider:
  $ wer cvv cid $;

--| The empty set is an equivalence relation on the empty set. (Contributed by Mario Carneiro, 5-Sep-2015.)
theorem _0er:
  $ wer c0 c0 $;

--| Equality theorem for equivalence class. (Contributed by NM, 23-Jul-1995.)
theorem eceq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cec A2 C) (cec B2 C)) $;

--| Equality theorem for equivalence class (deduction form). (Contributed by Jim Kingdon, 31-Dec-2019.)
theorem eceq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cec A2 C) (cec B2 C)) $;

--| Equality theorem for equivalence class. (Contributed by NM, 23-Jul-1995.)
theorem eceq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cec C A2) (cec C B2)) $;

--| Membership in an equivalence class. Theorem 72 of [Suppes] p. 82. (Contributed by Mario Carneiro, 9-Jul-2014.)
theorem elecg (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wcel A2 (cec B2 R)) (wbr B2 A2 R)) $;

--| Membership in an equivalence class. Theorem 72 of [Suppes] p. 82. (Contributed by NM, 23-Jul-1995.)
theorem elec (A2 B2 R: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wcel A2 (cec B2 R)) (wbr B2 A2 R) $;

--| Membership in an equivalence class when ` R ` is a relation. (Contributed by Mario Carneiro, 11-Sep-2015.)
theorem relelec (A2 B2 R: class):
  $ wi (wrel R) (wb (wcel A2 (cec B2 R)) (wbr B2 A2 R)) $;

--| An equivalence class is a subset of the domain. (Contributed by NM, 6-Aug-1995.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem ecss (ph: wff) (A2 R X: class):
  $ wi ph (wer X R) $ >
  $ wi ph (wss (cec A2 R) X) $;

--| A representative of an inhabited equivalence class belongs to the domain of the equivalence relation. (Contributed by Jim Kingdon, 21-Aug-2019.)
theorem ecdmn0m {x3: setvar} (A2 R: class):
  $ wb (wcel A2 (cdm R)) (wex x3 (wcel (cv x3) (cec A2 R))) $;

--| Equality of equivalence classes implies equivalence of domain membership. (Contributed by NM, 28-Jan-1996.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem ereldm (ph: wff) (A2 B2 R X: class):
  $ wi ph (wer X R) $ >
  $ wi ph (wceq (cec A2 R) (cec B2 R)) $ >
  $ wi ph (wb (wcel A2 X) (wcel B2 X)) $;

--| Basic property of equivalence relations. Theorem 73 of [Suppes] p. 82. (Contributed by NM, 23-Jul-1995.) (Revised by Mario Carneiro, 6-Jul-2015.)
theorem erth (ph: wff) (A2 B2 R X: class):
  $ wi ph (wer X R) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wb (wbr A2 B2 R) (wceq (cec A2 R) (cec B2 R))) $;

--| Basic property of equivalence relations. Compare Theorem 73 of [Suppes] p. 82. Assumes membership of the second argument in the domain. (Contributed by NM, 30-Jul-1995.) (Revised by Mario Carneiro, 6-Jul-2015.)
theorem erth2 (ph: wff) (A2 B2 R X: class):
  $ wi ph (wer X R) $ >
  $ wi ph (wcel B2 X) $ >
  $ wi ph (wb (wbr A2 B2 R) (wceq (cec A2 R) (cec B2 R))) $;

--| Basic property of equivalence relations. Part of Lemma 3N of [Enderton] p. 57. (Contributed by NM, 30-Jul-1995.) (Revised by Mario Carneiro, 9-Jul-2014.)
theorem erthi (ph: wff) (A2 B2 R X: class):
  $ wi ph (wer X R) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wceq (cec A2 R) (cec B2 R)) $;

--| An equivalence class modulo the identity relation is a singleton. (Contributed by NM, 24-Oct-2004.)
theorem ecidsn (A2: class):
  $ wceq (cec A2 cid) (csn A2) $;

--| Equality theorem for quotient set. (Contributed by NM, 23-Jul-1995.)
theorem qseq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cqs A2 C) (cqs B2 C)) $;

--| Equality theorem for quotient set. (Contributed by NM, 23-Jul-1995.)
theorem qseq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cqs C A2) (cqs C B2)) $;

--| Closed form of ~ elqs . (Contributed by Rodolfo Medina, 12-Oct-2010.)
theorem elqsg {x3: setvar} (A2 B2 R: class) (V: class x3):
  $ wi (wcel B2 V) (wb (wcel B2 (cqs A2 R)) (wrex x3 (wceq B2 (cec (cv x3) R)) A2)) $;

--| Membership in a quotient set. (Contributed by NM, 23-Jul-1995.)
theorem elqs {x3: setvar} (A2 B2 R: class):
  $ wcel B2 cvv $ >
  $ wb (wcel B2 (cqs A2 R)) (wrex x3 (wceq B2 (cec (cv x3) R)) A2) $;

--| Membership in a quotient set. (Contributed by NM, 23-Jul-1995.)
theorem elqsi {x3: setvar} (A2 B2 R: class):
  $ wi (wcel B2 (cqs A2 R)) (wrex x3 (wceq B2 (cec (cv x3) R)) A2) $;

--| Membership of an equivalence class in a quotient set. (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by Mario Carneiro, 9-Jul-2014.)
theorem ecelqsg (A2 B2 R V: class):
  $ wi (wa (wcel R V) (wcel B2 A2)) (wcel (cec B2 R) (cqs A2 R)) $;

--| Membership of an equivalence class in a quotient set. (Contributed by NM, 25-Jul-1995.) (Revised by Mario Carneiro, 9-Jul-2014.)
theorem ecelqsi (A2 B2 R: class):
  $ wcel R cvv $ >
  $ wi (wcel B2 A2) (wcel (cec B2 R) (cqs A2 R)) $;

--| "Closure" law for equivalence class of ordered pairs. (Contributed by NM, 25-Mar-1996.)
theorem ecopqsi (A2 B2 C R S: class):
  $ wcel R cvv $ >
  $ wceq S (cqs (cxp A2 A2) R) $ >
  $ wi (wa (wcel B2 A2) (wcel C A2)) (wcel (cec (cop B2 C) R) S) $;

--| A quotient set exists. (Contributed by FL, 19-May-2007.) (Revised by Mario Carneiro, 9-Jul-2014.)
theorem qsexg (A2 R V: class):
  $ wi (wcel A2 V) (wcel (cqs A2 R) cvv) $;

--| A quotient set exists. (Contributed by NM, 14-Aug-1995.)
theorem qsex (A2 R: class):
  $ wcel A2 cvv $ >
  $ wcel (cqs A2 R) cvv $;

--| The union of a quotient set. (Contributed by NM, 9-Dec-2008.)
theorem uniqs (A2 R V: class):
  $ wi (wcel R V) (wceq (cuni (cqs A2 R)) (cima R A2)) $;

--| A quotient set is a set of subsets of the base set. (Contributed by Mario Carneiro, 9-Jul-2014.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem qsss (ph: wff) (A2 R: class):
  $ wi ph (wer A2 R) $ >
  $ wi ph (wss (cqs A2 R) (cpw A2)) $;

--| The union of a quotient set. (Contributed by Mario Carneiro, 11-Jul-2014.)
theorem uniqs2 (ph: wff) (A2 R V: class):
  $ wi ph (wer A2 R) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wceq (cuni (cqs A2 R)) A2) $;

--| The singleton of an equivalence class. (Contributed by NM, 29-Jan-1999.) (Revised by Mario Carneiro, 9-Jul-2014.)
theorem snec (A2 R: class):
  $ wcel A2 cvv $ >
  $ wceq (csn (cec A2 R)) (cqs (csn A2) R) $;

--| Equivalence class in terms of quotient set. (Contributed by NM, 29-Jan-1999.)
theorem ecqs (A2 R: class):
  $ wcel R cvv $ >
  $ wceq (cec A2 R) (cuni (cqs (csn A2) R)) $;

--| A set is equal to its converse epsilon coset. (Note: converse epsilon is not an equivalence relation.) (Contributed by NM, 13-Aug-1995.) (Revised by Mario Carneiro, 9-Jul-2014.)
theorem ecid (A2: class):
  $ wcel A2 cvv $ >
  $ wceq (cec A2 (ccnv cep)) A2 $;

--| A set is equal to its converse epsilon coset. (Note: converse epsilon is not an equivalence relation.) (Contributed by Jim Kingdon, 8-Jan-2020.)
theorem ecidg (A2 V: class):
  $ wi (wcel A2 V) (wceq (cec A2 (ccnv cep)) A2) $;

--| A set is equal to its quotient set mod converse epsilon. (Note: converse epsilon is not an equivalence relation.) (Contributed by NM, 13-Aug-1995.) (Revised by Mario Carneiro, 9-Jul-2014.)
theorem qsid (A2: class):
  $ wceq (cqs A2 (ccnv cep)) A2 $;

--| Implicit substitution of class for equivalence class. (Contributed by Mario Carneiro, 9-Jul-2014.)
theorem ectocld {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2 R: class) (S: class x3):
  $ wceq S (cqs B2 R) $ >
  $ wi (wceq (cec (cv x3) R) A2) (wb ph ps) $ >
  $ wi (wa ch (wcel (cv x3) B2)) ph $ >
  $ wi (wa ch (wcel A2 S)) ps $;

--| Implicit substitution of class for equivalence class. (Contributed by NM, 23-Jul-1995.) (Revised by Mario Carneiro, 9-Jul-2014.)
theorem ectocl {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2 R: class) (S: class x3):
  $ wceq S (cqs B2 R) $ >
  $ wi (wceq (cec (cv x3) R) A2) (wb ph ps) $ >
  $ wi (wcel (cv x3) B2) ph $ >
  $ wi (wcel A2 S) ps $;

--| An element of a quotient set is inhabited. (Contributed by Jim Kingdon, 21-Aug-2019.)
theorem elqsn0m {x3: setvar} (A2 B2 R: class):
  $ wi (wa (wceq (cdm R) A2) (wcel B2 (cqs A2 R))) (wex x3 (wcel (cv x3) B2)) $;

--| A quotient set doesn't contain the empty set. (Contributed by NM, 24-Aug-1995.)
theorem elqsn0 (A2 B2 R: class):
  $ wi (wa (wceq (cdm R) A2) (wcel B2 (cqs A2 R))) (wne B2 c0) $;

--| Membership of an equivalence class in a quotient set. (Contributed by NM, 30-Jul-1995.)
theorem ecelqsdm (A2 B2 R: class):
  $ wi (wa (wceq (cdm R) A2) (wcel (cec B2 R) (cqs A2 R))) (wcel B2 A2) $;

--| A square Cartesian product is an equivalence relation (in general it's not a poset). (Contributed by Jim Kingdon, 22-Aug-2019.)
theorem xpiderm {x3: setvar} (A2: class):
  $ wi (wex x3 (wcel (cv x3) A2)) (wer A2 (cxp A2 A2)) $;

--| The intersection of a nonempty family of equivalence relations is an equivalence relation. (Contributed by Mario Carneiro, 27-Sep-2015.)
theorem iinerm {x3 y1: setvar} (A2: class) (B2: class y1) (R: class x3 y1):
  $ wi (wa (wex y1 (wcel (cv y1) A2)) (wral x3 (wer B2 R) A2)) (wer B2 (ciin x3 A2 R)) $;

--| The relative intersection of a family of equivalence relations is an equivalence relation. (Contributed by Mario Carneiro, 27-Sep-2015.)
theorem riinerm {x3 y1: setvar} (A2: class) (B2: class y1) (R: class x3 y1):
  $ wi (wa (wex y1 (wcel (cv y1) A2)) (wral x3 (wer B2 R) A2)) (wer B2 (cin (cxp B2 B2) (ciin x3 A2 R))) $;

--| A restricted equivalence relation is an equivalence relation. (Contributed by Mario Carneiro, 10-Jul-2015.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem erinxp (ph: wff) (A2 B2 R: class):
  $ wi ph (wer A2 R) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wer B2 (cin R (cxp B2 B2))) $;

--| Restrict the relation in an equivalence class to a base set. (Contributed by Mario Carneiro, 10-Jul-2015.)
theorem ecinxp (A2 B2 R: class):
  $ wi (wa (wss (cima R A2) A2) (wcel B2 A2)) (wceq (cec B2 R) (cec B2 (cin R (cxp A2 A2)))) $;

--| Restrict the equivalence relation in a quotient set to the base set. (Contributed by Mario Carneiro, 23-Feb-2015.)
theorem qsinxp (A2 R: class):
  $ wi (wss (cima R A2) A2) (wceq (cqs A2 R) (cqs A2 (cin R (cxp A2 A2)))) $;

--| If an element of a quotient set contains a given element, it is equal to the equivalence class of the element. (Contributed by Mario Carneiro, 12-Aug-2015.)
theorem qsel (A2 B2 C R X: class):
  $ wi (w3a (wer X R) (wcel B2 (cqs A2 R)) (wcel C B2)) (wceq B2 (cec C R)) $;

--| ` F ` , a function lift, is a subset of ` R X. S ` . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem qliftlem {x3: setvar} (ph: wff) (A2: class x3) (R: class) (F: class x3) (X Y: class):
  $ wceq F (crn (cmpt x3 X (cop (cec (cv x3) R) A2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 Y) $ >
  $ wi ph (wer X R) $ >
  $ wi ph (wcel X cvv) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel (cec (cv x3) R) (cqs X R)) $;

--| ` F ` , a function lift, is a subset of ` R X. S ` . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem qliftrel {x3: setvar} (ph: wff) (A2: class x3) (R: class) (F: class x3) (X Y: class):
  $ wceq F (crn (cmpt x3 X (cop (cec (cv x3) R) A2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 Y) $ >
  $ wi ph (wer X R) $ >
  $ wi ph (wcel X cvv) $ >
  $ wi ph (wss F (cxp (cqs X R) Y)) $;

--| Elementhood in the relation ` F ` . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem qliftel {x3: setvar} (ph: wff) (A2: class x3) (C D R: class) (F: class x3) (X Y: class):
  $ wceq F (crn (cmpt x3 X (cop (cec (cv x3) R) A2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 Y) $ >
  $ wi ph (wer X R) $ >
  $ wi ph (wcel X cvv) $ >
  $ wi ph (wb (wbr (cec C R) D F) (wrex x3 (wa (wbr C (cv x3) R) (wceq D A2)) X)) $;

--| Elementhood in the relation ` F ` . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem qliftel1 {x3: setvar} (ph: wff) (A2: class x3) (R: class) (F: class x3) (X Y: class):
  $ wceq F (crn (cmpt x3 X (cop (cec (cv x3) R) A2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 Y) $ >
  $ wi ph (wer X R) $ >
  $ wi ph (wcel X cvv) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wbr (cec (cv x3) R) A2 F) $;

--| The function ` F ` is the unique function defined by ` F `` [ x ] = A ` , provided that the well-definedness condition holds. (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem qliftfun {x3 y1: setvar} (ph: wff) (A2: class x3) (B2: class y1) (R: class) (F: class x3) (X Y: class):
  $ wceq F (crn (cmpt x3 X (cop (cec (cv x3) R) A2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 Y) $ >
  $ wi ph (wer X R) $ >
  $ wi ph (wcel X cvv) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wi ph (wb (wfun F) (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) R) (wceq A2 B2))))) $;

--| The function ` F ` is the unique function defined by ` F `` [ x ] = A ` , provided that the well-definedness condition holds. (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem qliftfund {x3 y1: setvar} (ph: wff) (A2: class x3) (B2: class y1) (R: class) (F: class x3) (X Y: class):
  $ wceq F (crn (cmpt x3 X (cop (cec (cv x3) R) A2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 Y) $ >
  $ wi ph (wer X R) $ >
  $ wi ph (wcel X cvv) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wi (wa ph (wbr (cv x3) (cv y1) R)) (wceq A2 B2) $ >
  $ wi ph (wfun F) $;

--| The function ` F ` is the unique function defined by ` F `` [ x ] = A ` , provided that the well-definedness condition holds. (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem qliftfuns {x3 y1 z: setvar} (ph: wff) (A2: class x3) (R: class) (F: class x3) (X Y: class):
  $ wceq F (crn (cmpt x3 X (cop (cec (cv x3) R) A2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 Y) $ >
  $ wi ph (wer X R) $ >
  $ wi ph (wcel X cvv) $ >
  $ wi ph (wb (wfun F) (wal y1 (wal z (wi (wbr (cv y1) (cv z) R) (wceq (csb x3 (cv y1) A2) (csb x3 (cv z) A2)))))) $;

--| The domain and range of the function ` F ` . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem qliftf {x3: setvar} (ph: wff) (A2: class x3) (R: class) (F: class x3) (X Y: class):
  $ wceq F (crn (cmpt x3 X (cop (cec (cv x3) R) A2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 Y) $ >
  $ wi ph (wer X R) $ >
  $ wi ph (wcel X cvv) $ >
  $ wi ph (wb (wfun F) (wf (cqs X R) Y F)) $;

--| The value of the function ` F ` . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem qliftval {x3: setvar} (ph: wff) (A2: class x3) (B2 C R: class) (F: class x3) (X Y: class):
  $ wceq F (crn (cmpt x3 X (cop (cec (cv x3) R) A2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 Y) $ >
  $ wi ph (wer X R) $ >
  $ wi ph (wcel X cvv) $ >
  $ wi (wceq (cv x3) C) (wceq A2 B2) $ >
  $ wi ph (wfun F) $ >
  $ wi (wa ph (wcel C X)) (wceq (cfv (cec C R) F) B2) $;

--| Implicit substitution of class for equivalence class of ordered pair. (Contributed by NM, 23-Jul-1995.)
theorem ecoptocl {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2 C R: class) (S: class x3 y1):
  $ wceq S (cqs (cxp B2 C) R) $ >
  $ wi (wceq (cec (cop (cv x3) (cv y1)) R) A2) (wb ph ps) $ >
  $ wi (wa (wcel (cv x3) B2) (wcel (cv y1) C)) ph $ >
  $ wi (wcel A2 S) ps $;

--| Implicit substitution of classes for equivalence classes of ordered pairs. (Contributed by NM, 23-Jul-1995.)
theorem _2ecoptocl {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (ps: wff z w) (ch: wff x3 y1) (A2: class) (B2: class x3 y1) (C D R: class) (S: class x3 y1):
  $ wceq S (cqs (cxp C D) R) $ >
  $ wi (wceq (cec (cop (cv x3) (cv y1)) R) A2) (wb ph ps) $ >
  $ wi (wceq (cec (cop (cv z) (cv w)) R) B2) (wb ps ch) $ >
  $ wi (wa (wa (wcel (cv x3) C) (wcel (cv y1) D)) (wa (wcel (cv z) C) (wcel (cv w) D))) ph $ >
  $ wi (wa (wcel A2 S) (wcel B2 S)) ch $;

--| Implicit substitution of classes for equivalence classes of ordered pairs. (Contributed by NM, 9-Aug-1995.)
theorem _3ecoptocl {x3 y1 z w v u: setvar} (ph: wff x3 y1 z w v u) (ps: wff z w v u) (ch: wff x3 y1 v u) (th: wff x3 y1 z w) (A2: class) (B2: class x3 y1) (C: class x3 y1 z w) (D R: class) (S: class x3 y1):
  $ wceq S (cqs (cxp D D) R) $ >
  $ wi (wceq (cec (cop (cv x3) (cv y1)) R) A2) (wb ph ps) $ >
  $ wi (wceq (cec (cop (cv z) (cv w)) R) B2) (wb ps ch) $ >
  $ wi (wceq (cec (cop (cv v) (cv u)) R) C) (wb ch th) $ >
  $ wi (w3a (wa (wcel (cv x3) D) (wcel (cv y1) D)) (wa (wcel (cv z) D) (wcel (cv w) D)) (wa (wcel (cv v) D) (wcel (cv u) D))) ph $ >
  $ wi (w3a (wcel A2 S) (wcel B2 S) (wcel C S)) th $;

--| Binary relation on a quotient set. Lemma for real number construction. (Contributed by NM, 29-Jan-1996.)
theorem brecop {x3 y1 z w v u: setvar} (ph: wff z w v u) (ps: wff x3 y1) (A2 B2 C D c_sm: class) (G: class x3 y1) (H: class z w v u) (c_le: class x3 y1 z w v u):
  $ wcel c_sm cvv $ >
  $ wer (cxp G G) c_sm $ >
  $ wceq H (cqs (cxp G G) c_sm) $ >
  $ wceq c_le (copab x3 y1 (wa (wa (wcel (cv x3) H) (wcel (cv y1) H)) (wex z (wex w (wex v (wex u (wa (wa (wceq (cv x3) (cec (cop (cv z) (cv w)) c_sm)) (wceq (cv y1) (cec (cop (cv v) (cv u)) c_sm))) ph))))))) $ >
  $ wi (wa (wa (wa (wcel (cv z) G) (wcel (cv w) G)) (wa (wcel A2 G) (wcel B2 G))) (wa (wa (wcel (cv v) G) (wcel (cv u) G)) (wa (wcel C G) (wcel D G)))) (wi (wa (wceq (cec (cop (cv z) (cv w)) c_sm) (cec (cop A2 B2) c_sm)) (wceq (cec (cop (cv v) (cv u)) c_sm) (cec (cop C D) c_sm))) (wb ph ps)) $ >
  $ wi (wa (wa (wcel A2 G) (wcel B2 G)) (wa (wcel C G) (wcel D G))) (wb (wbr (cec (cop A2 B2) c_sm) (cec (cop C D) c_sm) c_le) ps) $;

--| Lemma for ~ eroprf . (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by Mario Carneiro, 9-Jul-2014.)
theorem eroveu {z u t s1 r q p: setvar} (ph: wff) (A2 B2: class) (C: class z u t s1 r q p) (c_pl R S T: class) (U: class z u t s1 r q p) (J K: class u t s1 r) (V W: class z u t s1 r q p) (X Y: class) (Z: class z u t s1 r q p):
  $ wceq J (cqs A2 R) $ >
  $ wceq K (cqs B2 S) $ >
  $ wi ph (wcel T Z) $ >
  $ wi ph (wer U R) $ >
  $ wi ph (wer V S) $ >
  $ wi ph (wer W T) $ >
  $ wi ph (wss A2 U) $ >
  $ wi ph (wss B2 V) $ >
  $ wi ph (wss C W) $ >
  $ wi ph (wf (cxp A2 B2) C c_pl) $ >
  $ wi (wa ph (wa (wa (wcel (cv r) A2) (wcel (cv s1) A2)) (wa (wcel (cv t) B2) (wcel (cv u) B2)))) (wi (wa (wbr (cv r) (cv s1) R) (wbr (cv t) (cv u) S)) (wbr (co (cv r) (cv t) c_pl) (co (cv s1) (cv u) c_pl) T)) $ >
  $ wi (wa ph (wa (wcel X J) (wcel Y K))) (weu z (wrex p (wrex q (wa (wa (wceq X (cec (cv p) R)) (wceq Y (cec (cv q) S))) (wceq (cv z) (cec (co (cv p) (cv q) c_pl) T))) B2) A2)) $;

--| Lemma for ~ eroprf . (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by Mario Carneiro, 30-Dec-2014.)
theorem erovlem {x3 y1 z u t s1 r q p: setvar} (ph: wff) (A2 B2: class) (C: class x3 y1 z u t s1 r q p) (c_pl: class) (c_pd: class x3 y1 z u t s1 r q p) (R S T: class) (U: class x3 y1 z u t s1 r q p) (J K: class u t s1 r) (V W Z: class x3 y1 z u t s1 r q p):
  $ wceq J (cqs A2 R) $ >
  $ wceq K (cqs B2 S) $ >
  $ wi ph (wcel T Z) $ >
  $ wi ph (wer U R) $ >
  $ wi ph (wer V S) $ >
  $ wi ph (wer W T) $ >
  $ wi ph (wss A2 U) $ >
  $ wi ph (wss B2 V) $ >
  $ wi ph (wss C W) $ >
  $ wi ph (wf (cxp A2 B2) C c_pl) $ >
  $ wi (wa ph (wa (wa (wcel (cv r) A2) (wcel (cv s1) A2)) (wa (wcel (cv t) B2) (wcel (cv u) B2)))) (wi (wa (wbr (cv r) (cv s1) R) (wbr (cv t) (cv u) S)) (wbr (co (cv r) (cv t) c_pl) (co (cv s1) (cv u) c_pl) T)) $ >
  $ wceq c_pd (coprab x3 y1 z (wrex p (wrex q (wa (wa (wceq (cv x3) (cec (cv p) R)) (wceq (cv y1) (cec (cv q) S))) (wceq (cv z) (cec (co (cv p) (cv q) c_pl) T))) B2) A2)) $ >
  $ wi ph (wceq c_pd (cmpt2 x3 y1 J K (cio z (wrex p (wrex q (wa (wa (wceq (cv x3) (cec (cv p) R)) (wceq (cv y1) (cec (cv q) S))) (wceq (cv z) (cec (co (cv p) (cv q) c_pl) T))) B2) A2)))) $;

--| Functionality of an operation defined on equivalence classes. (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by Mario Carneiro, 30-Dec-2014.)
theorem eroprf {x3 y1 z u t s1 r q p: setvar} (ph: wff) (A2 B2: class) (C: class x3 y1 z u t s1 r q p) (c_pl: class) (c_pd: class x3 y1 z u t s1 r q p) (R S T: class) (U: class x3 y1 z u t s1 r q p) (J K L: class u t s1 r) (V W: class x3 y1 z u t s1 r q p) (X Y: class x3 y1) (Z: class x3 y1 z u t s1 r q p):
  $ wceq J (cqs A2 R) $ >
  $ wceq K (cqs B2 S) $ >
  $ wi ph (wcel T Z) $ >
  $ wi ph (wer U R) $ >
  $ wi ph (wer V S) $ >
  $ wi ph (wer W T) $ >
  $ wi ph (wss A2 U) $ >
  $ wi ph (wss B2 V) $ >
  $ wi ph (wss C W) $ >
  $ wi ph (wf (cxp A2 B2) C c_pl) $ >
  $ wi (wa ph (wa (wa (wcel (cv r) A2) (wcel (cv s1) A2)) (wa (wcel (cv t) B2) (wcel (cv u) B2)))) (wi (wa (wbr (cv r) (cv s1) R) (wbr (cv t) (cv u) S)) (wbr (co (cv r) (cv t) c_pl) (co (cv s1) (cv u) c_pl) T)) $ >
  $ wceq c_pd (coprab x3 y1 z (wrex p (wrex q (wa (wa (wceq (cv x3) (cec (cv p) R)) (wceq (cv y1) (cec (cv q) S))) (wceq (cv z) (cec (co (cv p) (cv q) c_pl) T))) B2) A2)) $ >
  $ wi ph (wcel R X) $ >
  $ wi ph (wcel S Y) $ >
  $ wceq L (cqs C T) $ >
  $ wi ph (wf (cxp J K) L c_pd) $;

--| Functionality of an operation defined on equivalence classes. (Contributed by Jeff Madsen, 10-Jun-2010.)
theorem eroprf2 {x3 y1 z u t s1 r q p: setvar} (ph: wff) (A2 c_pl: class) (c_pd: class x3 y1 z u t s1 r q p) (c_sm: class) (U: class x3 y1 z u t s1 r q p) (J: class u t s1 r) (X: class x3 y1):
  $ wceq J (cqs A2 c_sm) $ >
  $ wceq c_pd (coprab x3 y1 z (wrex p (wrex q (wa (wa (wceq (cv x3) (cec (cv p) c_sm)) (wceq (cv y1) (cec (cv q) c_sm))) (wceq (cv z) (cec (co (cv p) (cv q) c_pl) c_sm))) A2) A2)) $ >
  $ wi ph (wcel c_sm X) $ >
  $ wi ph (wer U c_sm) $ >
  $ wi ph (wss A2 U) $ >
  $ wi ph (wf (cxp A2 A2) A2 c_pl) $ >
  $ wi (wa ph (wa (wa (wcel (cv r) A2) (wcel (cv s1) A2)) (wa (wcel (cv t) A2) (wcel (cv u) A2)))) (wi (wa (wbr (cv r) (cv s1) c_sm) (wbr (cv t) (cv u) c_sm)) (wbr (co (cv r) (cv t) c_pl) (co (cv s1) (cv u) c_pl) c_sm)) $ >
  $ wi ph (wf (cxp J J) J c_pd) $;

--| This is the first of several theorems about equivalence relations of the kind used in construction of fractions and signed reals, involving operations on equivalent classes of ordered pairs. This theorem expresses the relation ` .~ ` (specified by the hypothesis) in terms of its operation ` F ` . (Contributed by NM, 16-Aug-1995.)
theorem ecopoveq {x3 y1 z w v u: setvar} (A2 B2 C D c_pl: class) (c_sm: class x3 y1 z w v u) (S: class):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) (cxp S S)) (wcel (cv y1) (cxp S S))) (wex z (wex w (wex v (wex u (wa (wa (wceq (cv x3) (cop (cv z) (cv w))) (wceq (cv y1) (cop (cv v) (cv u)))) (wceq (co (cv z) (cv u) c_pl) (co (cv w) (cv v) c_pl))))))))) $ >
  $ wi (wa (wa (wcel A2 S) (wcel B2 S)) (wa (wcel C S) (wcel D S))) (wb (wbr (cop A2 B2) (cop C D) c_sm) (wceq (co A2 D c_pl) (co B2 C c_pl))) $;

--| Assuming the operation ` F ` is commutative, show that the relation ` .~ ` , specified by the first hypothesis, is symmetric. (Contributed by NM, 27-Aug-1995.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem ecopovsym {x3 y1 z w v u: setvar} (A2 B2: class x3 y1 z w v u) (c_pl: class) (c_sm: class x3 y1 z w v u) (S: class):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) (cxp S S)) (wcel (cv y1) (cxp S S))) (wex z (wex w (wex v (wex u (wa (wa (wceq (cv x3) (cop (cv z) (cv w))) (wceq (cv y1) (cop (cv v) (cv u)))) (wceq (co (cv z) (cv u) c_pl) (co (cv w) (cv v) c_pl))))))))) $ >
  $ wceq (co (cv x3) (cv y1) c_pl) (co (cv y1) (cv x3) c_pl) $ >
  $ wi (wbr A2 B2 c_sm) (wbr B2 A2 c_sm) $;

--| Assuming that operation ` F ` is commutative (second hypothesis), closed (third hypothesis), associative (fourth hypothesis), and has the cancellation property (fifth hypothesis), show that the relation ` .~ ` , specified by the first hypothesis, is transitive. (Contributed by NM, 11-Feb-1996.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem ecopovtrn {x3 y1 z w v u: setvar} (A2 B2 C: class x3 y1 z w v u) (c_pl: class) (c_sm: class x3 y1 z w v u) (S: class):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) (cxp S S)) (wcel (cv y1) (cxp S S))) (wex z (wex w (wex v (wex u (wa (wa (wceq (cv x3) (cop (cv z) (cv w))) (wceq (cv y1) (cop (cv v) (cv u)))) (wceq (co (cv z) (cv u) c_pl) (co (cv w) (cv v) c_pl))))))))) $ >
  $ wceq (co (cv x3) (cv y1) c_pl) (co (cv y1) (cv x3) c_pl) $ >
  $ wi (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_pl) (co (cv x3) (co (cv y1) (cv z) c_pl) c_pl) $ >
  $ wi (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wi (wceq (co (cv x3) (cv y1) c_pl) (co (cv x3) (cv z) c_pl)) (wceq (cv y1) (cv z))) $ >
  $ wi (wa (wbr A2 B2 c_sm) (wbr B2 C c_sm)) (wbr A2 C c_sm) $;

--| Assuming that operation ` F ` is commutative (second hypothesis), closed (third hypothesis), associative (fourth hypothesis), and has the cancellation property (fifth hypothesis), show that the relation ` .~ ` , specified by the first hypothesis, is an equivalence relation. (Contributed by NM, 16-Feb-1996.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem ecopover {x3 y1 z w v u: setvar} (c_pl: class) (c_sm: class x3 y1 z w v u) (S: class):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) (cxp S S)) (wcel (cv y1) (cxp S S))) (wex z (wex w (wex v (wex u (wa (wa (wceq (cv x3) (cop (cv z) (cv w))) (wceq (cv y1) (cop (cv v) (cv u)))) (wceq (co (cv z) (cv u) c_pl) (co (cv w) (cv v) c_pl))))))))) $ >
  $ wceq (co (cv x3) (cv y1) c_pl) (co (cv y1) (cv x3) c_pl) $ >
  $ wi (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_pl) (co (cv x3) (co (cv y1) (cv z) c_pl) c_pl) $ >
  $ wi (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wi (wceq (co (cv x3) (cv y1) c_pl) (co (cv x3) (cv z) c_pl)) (wceq (cv y1) (cv z))) $ >
  $ wer (cxp S S) c_sm $;

--| Assuming the operation ` F ` is commutative, show that the relation ` .~ ` , specified by the first hypothesis, is symmetric. (Contributed by Jim Kingdon, 1-Sep-2019.)
theorem ecopovsymg {x3 y1 z w v u: setvar} (A2 B2: class x3 y1 z w v u) (c_pl: class) (c_sm: class x3 y1 z w v u) (S: class):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) (cxp S S)) (wcel (cv y1) (cxp S S))) (wex z (wex w (wex v (wex u (wa (wa (wceq (cv x3) (cop (cv z) (cv w))) (wceq (cv y1) (cop (cv v) (cv u)))) (wceq (co (cv z) (cv u) c_pl) (co (cv w) (cv v) c_pl))))))))) $ >
  $ wi (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wceq (co (cv x3) (cv y1) c_pl) (co (cv y1) (cv x3) c_pl)) $ >
  $ wi (wbr A2 B2 c_sm) (wbr B2 A2 c_sm) $;

--| Assuming that operation ` F ` is commutative (second hypothesis), closed (third hypothesis), associative (fourth hypothesis), and has the cancellation property (fifth hypothesis), show that the relation ` .~ ` , specified by the first hypothesis, is transitive. (Contributed by Jim Kingdon, 1-Sep-2019.)
theorem ecopovtrng {x3 y1 z w v u: setvar} (A2 B2 C: class x3 y1 z w v u) (c_pl: class) (c_sm: class x3 y1 z w v u) (S: class):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) (cxp S S)) (wcel (cv y1) (cxp S S))) (wex z (wex w (wex v (wex u (wa (wa (wceq (cv x3) (cop (cv z) (cv w))) (wceq (cv y1) (cop (cv v) (cv u)))) (wceq (co (cv z) (cv u) c_pl) (co (cv w) (cv v) c_pl))))))))) $ >
  $ wi (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wceq (co (cv x3) (cv y1) c_pl) (co (cv y1) (cv x3) c_pl)) $ >
  $ wi (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wi (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S)) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_pl) (co (cv x3) (co (cv y1) (cv z) c_pl) c_pl)) $ >
  $ wi (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S)) (wi (wceq (co (cv x3) (cv y1) c_pl) (co (cv x3) (cv z) c_pl)) (wceq (cv y1) (cv z))) $ >
  $ wi (wa (wbr A2 B2 c_sm) (wbr B2 C c_sm)) (wbr A2 C c_sm) $;

--| Assuming that operation ` F ` is commutative (second hypothesis), closed (third hypothesis), associative (fourth hypothesis), and has the cancellation property (fifth hypothesis), show that the relation ` .~ ` , specified by the first hypothesis, is an equivalence relation. (Contributed by Jim Kingdon, 1-Sep-2019.)
theorem ecopoverg {x3 y1 z w v u: setvar} (c_pl: class) (c_sm: class x3 y1 z w v u) (S: class):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) (cxp S S)) (wcel (cv y1) (cxp S S))) (wex z (wex w (wex v (wex u (wa (wa (wceq (cv x3) (cop (cv z) (cv w))) (wceq (cv y1) (cop (cv v) (cv u)))) (wceq (co (cv z) (cv u) c_pl) (co (cv w) (cv v) c_pl))))))))) $ >
  $ wi (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wceq (co (cv x3) (cv y1) c_pl) (co (cv y1) (cv x3) c_pl)) $ >
  $ wi (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wi (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S)) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_pl) (co (cv x3) (co (cv y1) (cv z) c_pl) c_pl)) $ >
  $ wi (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S)) (wi (wceq (co (cv x3) (cv y1) c_pl) (co (cv x3) (cv z) c_pl)) (wceq (cv y1) (cv z))) $ >
  $ wer (cxp S S) c_sm $;

--| Lemma for Exercise 44 version of Theorem 3Q of [Enderton] p. 60. The third hypothesis is the compatibility assumption. (Contributed by NM, 3-Aug-1995.) (Revised by Mario Carneiro, 9-Jul-2014.)
theorem th3qlem1 {x3 y1 z w v: setvar} (A2 B2 c_pl c_sm S: class):
  $ wer S c_sm $ >
  $ wi (wa (wa (wcel (cv y1) S) (wcel (cv w) S)) (wa (wcel (cv z) S) (wcel (cv v) S))) (wi (wa (wbr (cv y1) (cv w) c_sm) (wbr (cv z) (cv v) c_sm)) (wbr (co (cv y1) (cv z) c_pl) (co (cv w) (cv v) c_pl) c_sm)) $ >
  $ wi (wa (wcel A2 (cqs S c_sm)) (wcel B2 (cqs S c_sm))) (wmo x3 (wex y1 (wex z (wa (wa (wceq A2 (cec (cv y1) c_sm)) (wceq B2 (cec (cv z) c_sm))) (wceq (cv x3) (cec (co (cv y1) (cv z) c_pl) c_sm)))))) $;

--| Lemma for Exercise 44 version of Theorem 3Q of [Enderton] p. 60, extended to operations on ordered pairs. The fourth hypothesis is the compatibility assumption. (Contributed by NM, 4-Aug-1995.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem th3qlem2 {z w v u t f2 g1 h s1: setvar} (A2 B2: class g1 h) (c_pl c_sm S: class):
  $ wcel c_sm cvv $ >
  $ wer (cxp S S) c_sm $ >
  $ wi (wa (wa (wa (wcel (cv w) S) (wcel (cv v) S)) (wa (wcel (cv u) S) (wcel (cv t) S))) (wa (wa (wcel (cv s1) S) (wcel (cv f2) S)) (wa (wcel (cv g1) S) (wcel (cv h) S)))) (wi (wa (wbr (cop (cv w) (cv v)) (cop (cv u) (cv t)) c_sm) (wbr (cop (cv s1) (cv f2)) (cop (cv g1) (cv h)) c_sm)) (wbr (co (cop (cv w) (cv v)) (cop (cv s1) (cv f2)) c_pl) (co (cop (cv u) (cv t)) (cop (cv g1) (cv h)) c_pl) c_sm)) $ >
  $ wi (wa (wcel A2 (cqs (cxp S S) c_sm)) (wcel B2 (cqs (cxp S S) c_sm))) (wmo z (wex w (wex v (wex u (wex t (wa (wa (wceq A2 (cec (cop (cv w) (cv v)) c_sm)) (wceq B2 (cec (cop (cv u) (cv t)) c_sm))) (wceq (cv z) (cec (co (cop (cv w) (cv v)) (cop (cv u) (cv t)) c_pl) c_sm)))))))) $;

--| Corollary of Theorem 3Q of [Enderton] p. 60. (Contributed by NM, 12-Nov-1995.) (Revised by David Abernethy, 4-Jun-2013.)
theorem th3qcor {x3 y1 z w v u t f2 g1 h s1: setvar} (c_pl c_sm S: class) (G: class x3 y1 z w v u t f2 g1 h s1):
  $ wcel c_sm cvv $ >
  $ wer (cxp S S) c_sm $ >
  $ wi (wa (wa (wa (wcel (cv w) S) (wcel (cv v) S)) (wa (wcel (cv u) S) (wcel (cv t) S))) (wa (wa (wcel (cv s1) S) (wcel (cv f2) S)) (wa (wcel (cv g1) S) (wcel (cv h) S)))) (wi (wa (wbr (cop (cv w) (cv v)) (cop (cv u) (cv t)) c_sm) (wbr (cop (cv s1) (cv f2)) (cop (cv g1) (cv h)) c_sm)) (wbr (co (cop (cv w) (cv v)) (cop (cv s1) (cv f2)) c_pl) (co (cop (cv u) (cv t)) (cop (cv g1) (cv h)) c_pl) c_sm)) $ >
  $ wceq G (coprab x3 y1 z (wa (wa (wcel (cv x3) (cqs (cxp S S) c_sm)) (wcel (cv y1) (cqs (cxp S S) c_sm))) (wex w (wex v (wex u (wex t (wa (wa (wceq (cv x3) (cec (cop (cv w) (cv v)) c_sm)) (wceq (cv y1) (cec (cop (cv u) (cv t)) c_sm))) (wceq (cv z) (cec (co (cop (cv w) (cv v)) (cop (cv u) (cv t)) c_pl) c_sm))))))))) $ >
  $ wfun G $;

--| Theorem 3Q of [Enderton] p. 60, extended to operations on ordered pairs. (Contributed by NM, 4-Aug-1995.) (Revised by Mario Carneiro, 19-Dec-2013.)
theorem th3q {x3 y1 z w v u t f2 g1 h s1: setvar} (A2 B2: class g1 h) (C D: class f2 g1 h s1) (c_pl c_sm S: class) (G: class x3 y1 z w v u t f2 g1 h s1):
  $ wcel c_sm cvv $ >
  $ wer (cxp S S) c_sm $ >
  $ wi (wa (wa (wa (wcel (cv w) S) (wcel (cv v) S)) (wa (wcel (cv u) S) (wcel (cv t) S))) (wa (wa (wcel (cv s1) S) (wcel (cv f2) S)) (wa (wcel (cv g1) S) (wcel (cv h) S)))) (wi (wa (wbr (cop (cv w) (cv v)) (cop (cv u) (cv t)) c_sm) (wbr (cop (cv s1) (cv f2)) (cop (cv g1) (cv h)) c_sm)) (wbr (co (cop (cv w) (cv v)) (cop (cv s1) (cv f2)) c_pl) (co (cop (cv u) (cv t)) (cop (cv g1) (cv h)) c_pl) c_sm)) $ >
  $ wceq G (coprab x3 y1 z (wa (wa (wcel (cv x3) (cqs (cxp S S) c_sm)) (wcel (cv y1) (cqs (cxp S S) c_sm))) (wex w (wex v (wex u (wex t (wa (wa (wceq (cv x3) (cec (cop (cv w) (cv v)) c_sm)) (wceq (cv y1) (cec (cop (cv u) (cv t)) c_sm))) (wceq (cv z) (cec (co (cop (cv w) (cv v)) (cop (cv u) (cv t)) c_pl) c_sm))))))))) $ >
  $ wi (wa (wa (wcel A2 S) (wcel B2 S)) (wa (wcel C S) (wcel D S))) (wceq (co (cec (cop A2 B2) c_sm) (cec (cop C D) c_sm) G) (cec (co (cop A2 B2) (cop C D) c_pl) c_sm)) $;

--| Express an operation on equivalence classes of ordered pairs in terms of equivalence class of operations on ordered pairs. See iset.mm for additional comments describing the hypotheses. (Unnecessary distinct variable restrictions were removed by David Abernethy, 4-Jun-2013.) (Contributed by NM, 6-Aug-1995.) (Revised by Mario Carneiro, 4-Jun-2013.)
theorem oviec {x3 y1 z w v u t f2 g1 h s1 a b c d: setvar} (ph: wff z w v u t f2 g1 h s1 a b c d) (ps ch: wff x3 y1 t f2 g1 h s1 a b c d) (A2 B2: class t s1) (C D: class t g1 h s1) (c_pl: class w v u f2) (c_pd Q: class x3 y1 z w v u t f2 g1 h s1 a b c d) (c_sm: class w v u f2) (S: class) (H: class t g1 h s1 a b c d) (J: class w v u t f2 g1 h s1 a b c d) (K L: class t g1 h s1 a b c d):
  $ wi (wa (wa (wcel A2 S) (wcel B2 S)) (wa (wcel C S) (wcel D S))) (wcel H (cxp S S)) $ >
  $ wi (wa (wa (wcel (cv a) S) (wcel (cv b) S)) (wa (wcel (cv g1) S) (wcel (cv h) S))) (wcel K (cxp S S)) $ >
  $ wi (wa (wa (wcel (cv c) S) (wcel (cv d) S)) (wa (wcel (cv t) S) (wcel (cv s1) S))) (wcel L (cxp S S)) $ >
  $ wcel c_sm cvv $ >
  $ wer (cxp S S) c_sm $ >
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) (cxp S S)) (wcel (cv y1) (cxp S S))) (wex z (wex w (wex v (wex u (wa (wa (wceq (cv x3) (cop (cv z) (cv w))) (wceq (cv y1) (cop (cv v) (cv u)))) ph))))))) $ >
  $ wi (wa (wa (wceq (cv z) (cv a)) (wceq (cv w) (cv b))) (wa (wceq (cv v) (cv c)) (wceq (cv u) (cv d)))) (wb ph ps) $ >
  $ wi (wa (wa (wceq (cv z) (cv g1)) (wceq (cv w) (cv h))) (wa (wceq (cv v) (cv t)) (wceq (cv u) (cv s1)))) (wb ph ch) $ >
  $ wceq c_pl (coprab x3 y1 z (wa (wa (wcel (cv x3) (cxp S S)) (wcel (cv y1) (cxp S S))) (wex w (wex v (wex u (wex f2 (wa (wa (wceq (cv x3) (cop (cv w) (cv v))) (wceq (cv y1) (cop (cv u) (cv f2)))) (wceq (cv z) J)))))))) $ >
  $ wi (wa (wa (wceq (cv w) (cv a)) (wceq (cv v) (cv b))) (wa (wceq (cv u) (cv g1)) (wceq (cv f2) (cv h)))) (wceq J K) $ >
  $ wi (wa (wa (wceq (cv w) (cv c)) (wceq (cv v) (cv d))) (wa (wceq (cv u) (cv t)) (wceq (cv f2) (cv s1)))) (wceq J L) $ >
  $ wi (wa (wa (wceq (cv w) A2) (wceq (cv v) B2)) (wa (wceq (cv u) C) (wceq (cv f2) D))) (wceq J H) $ >
  $ wceq c_pd (coprab x3 y1 z (wa (wa (wcel (cv x3) Q) (wcel (cv y1) Q)) (wex a (wex b (wex c (wex d (wa (wa (wceq (cv x3) (cec (cop (cv a) (cv b)) c_sm)) (wceq (cv y1) (cec (cop (cv c) (cv d)) c_sm))) (wceq (cv z) (cec (co (cop (cv a) (cv b)) (cop (cv c) (cv d)) c_pl) c_sm))))))))) $ >
  $ wceq Q (cqs (cxp S S) c_sm) $ >
  $ wi (wa (wa (wa (wcel (cv a) S) (wcel (cv b) S)) (wa (wcel (cv c) S) (wcel (cv d) S))) (wa (wa (wcel (cv g1) S) (wcel (cv h) S)) (wa (wcel (cv t) S) (wcel (cv s1) S)))) (wi (wa ps ch) (wbr K L c_sm)) $ >
  $ wi (wa (wa (wcel A2 S) (wcel B2 S)) (wa (wcel C S) (wcel D S))) (wceq (co (cec (cop A2 B2) c_sm) (cec (cop C D) c_sm) c_pd) (cec H c_sm)) $;

--| Lemma used to transfer a commutative law via an equivalence relation. Most uses will want ~ ecovicom instead. (Contributed by NM, 29-Aug-1995.) (Revised by David Abernethy, 4-Jun-2013.)
theorem ecovcom {x3 y1 z w: setvar} (A2: class) (B2 C: class x3 y1) (D: class x3 y1 z w) (c_pl c_sm S: class) (G H J: class x3 y1 z w):
  $ wceq C (cqs (cxp S S) c_sm) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv z) S) (wcel (cv w) S))) (wceq (co (cec (cop (cv x3) (cv y1)) c_sm) (cec (cop (cv z) (cv w)) c_sm) c_pl) (cec (cop D G) c_sm)) $ >
  $ wi (wa (wa (wcel (cv z) S) (wcel (cv w) S)) (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cec (cop (cv z) (cv w)) c_sm) (cec (cop (cv x3) (cv y1)) c_sm) c_pl) (cec (cop H J) c_sm)) $ >
  $ wceq D H $ >
  $ wceq G J $ >
  $ wi (wa (wcel A2 C) (wcel B2 C)) (wceq (co A2 B2 c_pl) (co B2 A2 c_pl)) $;

--| Lemma used to transfer a commutative law via an equivalence relation. (Contributed by Jim Kingdon, 15-Sep-2019.)
theorem ecovicom {x3 y1 z w: setvar} (A2: class) (B2 C: class x3 y1) (D: class x3 y1 z w) (c_pl c_sm S: class) (G H J: class x3 y1 z w):
  $ wceq C (cqs (cxp S S) c_sm) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv z) S) (wcel (cv w) S))) (wceq (co (cec (cop (cv x3) (cv y1)) c_sm) (cec (cop (cv z) (cv w)) c_sm) c_pl) (cec (cop D G) c_sm)) $ >
  $ wi (wa (wa (wcel (cv z) S) (wcel (cv w) S)) (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cec (cop (cv z) (cv w)) c_sm) (cec (cop (cv x3) (cv y1)) c_sm) c_pl) (cec (cop H J) c_sm)) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv z) S) (wcel (cv w) S))) (wceq D H) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv z) S) (wcel (cv w) S))) (wceq G J) $ >
  $ wi (wa (wcel A2 C) (wcel B2 C)) (wceq (co A2 B2 c_pl) (co B2 A2 c_pl)) $;

--| Lemma used to transfer an associative law via an equivalence relation. In most cases ~ ecoviass will be more useful. (Contributed by NM, 31-Aug-1995.) (Revised by David Abernethy, 4-Jun-2013.)
theorem ecovass {x3 y1 z w v u: setvar} (A2: class) (B2: class x3 y1) (C: class) (D: class x3 y1) (c_pl: class) (Q: class x3 y1 z w v u) (c_sm S: class) (G H J K L M N: class x3 y1 z w v u):
  $ wceq D (cqs (cxp S S) c_sm) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv z) S) (wcel (cv w) S))) (wceq (co (cec (cop (cv x3) (cv y1)) c_sm) (cec (cop (cv z) (cv w)) c_sm) c_pl) (cec (cop G H) c_sm)) $ >
  $ wi (wa (wa (wcel (cv z) S) (wcel (cv w) S)) (wa (wcel (cv v) S) (wcel (cv u) S))) (wceq (co (cec (cop (cv z) (cv w)) c_sm) (cec (cop (cv v) (cv u)) c_sm) c_pl) (cec (cop N Q) c_sm)) $ >
  $ wi (wa (wa (wcel G S) (wcel H S)) (wa (wcel (cv v) S) (wcel (cv u) S))) (wceq (co (cec (cop G H) c_sm) (cec (cop (cv v) (cv u)) c_sm) c_pl) (cec (cop J K) c_sm)) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel N S) (wcel Q S))) (wceq (co (cec (cop (cv x3) (cv y1)) c_sm) (cec (cop N Q) c_sm) c_pl) (cec (cop L M) c_sm)) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv z) S) (wcel (cv w) S))) (wa (wcel G S) (wcel H S)) $ >
  $ wi (wa (wa (wcel (cv z) S) (wcel (cv w) S)) (wa (wcel (cv v) S) (wcel (cv u) S))) (wa (wcel N S) (wcel Q S)) $ >
  $ wceq J L $ >
  $ wceq K M $ >
  $ wi (w3a (wcel A2 D) (wcel B2 D) (wcel C D)) (wceq (co (co A2 B2 c_pl) C c_pl) (co A2 (co B2 C c_pl) c_pl)) $;

--| Lemma used to transfer an associative law via an equivalence relation. (Contributed by Jim Kingdon, 16-Sep-2019.)
theorem ecoviass {x3 y1 z w v u: setvar} (A2: class) (B2: class x3 y1) (C: class) (D: class x3 y1) (c_pl: class) (Q: class x3 y1 z w v u) (c_sm S: class) (G H J K L M N: class x3 y1 z w v u):
  $ wceq D (cqs (cxp S S) c_sm) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv z) S) (wcel (cv w) S))) (wceq (co (cec (cop (cv x3) (cv y1)) c_sm) (cec (cop (cv z) (cv w)) c_sm) c_pl) (cec (cop G H) c_sm)) $ >
  $ wi (wa (wa (wcel (cv z) S) (wcel (cv w) S)) (wa (wcel (cv v) S) (wcel (cv u) S))) (wceq (co (cec (cop (cv z) (cv w)) c_sm) (cec (cop (cv v) (cv u)) c_sm) c_pl) (cec (cop N Q) c_sm)) $ >
  $ wi (wa (wa (wcel G S) (wcel H S)) (wa (wcel (cv v) S) (wcel (cv u) S))) (wceq (co (cec (cop G H) c_sm) (cec (cop (cv v) (cv u)) c_sm) c_pl) (cec (cop J K) c_sm)) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel N S) (wcel Q S))) (wceq (co (cec (cop (cv x3) (cv y1)) c_sm) (cec (cop N Q) c_sm) c_pl) (cec (cop L M) c_sm)) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv z) S) (wcel (cv w) S))) (wa (wcel G S) (wcel H S)) $ >
  $ wi (wa (wa (wcel (cv z) S) (wcel (cv w) S)) (wa (wcel (cv v) S) (wcel (cv u) S))) (wa (wcel N S) (wcel Q S)) $ >
  $ wi (w3a (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv z) S) (wcel (cv w) S)) (wa (wcel (cv v) S) (wcel (cv u) S))) (wceq J L) $ >
  $ wi (w3a (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv z) S) (wcel (cv w) S)) (wa (wcel (cv v) S) (wcel (cv u) S))) (wceq K M) $ >
  $ wi (w3a (wcel A2 D) (wcel B2 D) (wcel C D)) (wceq (co (co A2 B2 c_pl) C c_pl) (co A2 (co B2 C c_pl) c_pl)) $;

--| Lemma used to transfer a distributive law via an equivalence relation. Most likely ~ ecovidi will be more helpful. (Contributed by NM, 2-Sep-1995.) (Revised by David Abernethy, 4-Jun-2013.)
theorem ecovdi {x3 y1 z w v u: setvar} (A2: class) (B2: class x3 y1) (C: class x3 y1 z) (D: class x3 y1) (c_pl c_sm S c_x: class) (H J K L M N W X Y Z: class x3 y1 z w v u):
  $ wceq D (cqs (cxp S S) c_sm) $ >
  $ wi (wa (wa (wcel (cv z) S) (wcel (cv w) S)) (wa (wcel (cv v) S) (wcel (cv u) S))) (wceq (co (cec (cop (cv z) (cv w)) c_sm) (cec (cop (cv v) (cv u)) c_sm) c_pl) (cec (cop M N) c_sm)) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel M S) (wcel N S))) (wceq (co (cec (cop (cv x3) (cv y1)) c_sm) (cec (cop M N) c_sm) c_x) (cec (cop H J) c_sm)) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv z) S) (wcel (cv w) S))) (wceq (co (cec (cop (cv x3) (cv y1)) c_sm) (cec (cop (cv z) (cv w)) c_sm) c_x) (cec (cop W X) c_sm)) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv v) S) (wcel (cv u) S))) (wceq (co (cec (cop (cv x3) (cv y1)) c_sm) (cec (cop (cv v) (cv u)) c_sm) c_x) (cec (cop Y Z) c_sm)) $ >
  $ wi (wa (wa (wcel W S) (wcel X S)) (wa (wcel Y S) (wcel Z S))) (wceq (co (cec (cop W X) c_sm) (cec (cop Y Z) c_sm) c_pl) (cec (cop K L) c_sm)) $ >
  $ wi (wa (wa (wcel (cv z) S) (wcel (cv w) S)) (wa (wcel (cv v) S) (wcel (cv u) S))) (wa (wcel M S) (wcel N S)) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv z) S) (wcel (cv w) S))) (wa (wcel W S) (wcel X S)) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv v) S) (wcel (cv u) S))) (wa (wcel Y S) (wcel Z S)) $ >
  $ wceq H K $ >
  $ wceq J L $ >
  $ wi (w3a (wcel A2 D) (wcel B2 D) (wcel C D)) (wceq (co A2 (co B2 C c_pl) c_x) (co (co A2 B2 c_x) (co A2 C c_x) c_pl)) $;

--| Lemma used to transfer a distributive law via an equivalence relation. (Contributed by Jim Kingdon, 17-Sep-2019.)
theorem ecovidi {x3 y1 z w v u: setvar} (A2: class) (B2: class x3 y1) (C: class x3 y1 z) (D: class x3 y1) (c_pl c_sm S c_x: class) (H J K L M N W X Y Z: class x3 y1 z w v u):
  $ wceq D (cqs (cxp S S) c_sm) $ >
  $ wi (wa (wa (wcel (cv z) S) (wcel (cv w) S)) (wa (wcel (cv v) S) (wcel (cv u) S))) (wceq (co (cec (cop (cv z) (cv w)) c_sm) (cec (cop (cv v) (cv u)) c_sm) c_pl) (cec (cop M N) c_sm)) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel M S) (wcel N S))) (wceq (co (cec (cop (cv x3) (cv y1)) c_sm) (cec (cop M N) c_sm) c_x) (cec (cop H J) c_sm)) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv z) S) (wcel (cv w) S))) (wceq (co (cec (cop (cv x3) (cv y1)) c_sm) (cec (cop (cv z) (cv w)) c_sm) c_x) (cec (cop W X) c_sm)) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv v) S) (wcel (cv u) S))) (wceq (co (cec (cop (cv x3) (cv y1)) c_sm) (cec (cop (cv v) (cv u)) c_sm) c_x) (cec (cop Y Z) c_sm)) $ >
  $ wi (wa (wa (wcel W S) (wcel X S)) (wa (wcel Y S) (wcel Z S))) (wceq (co (cec (cop W X) c_sm) (cec (cop Y Z) c_sm) c_pl) (cec (cop K L) c_sm)) $ >
  $ wi (wa (wa (wcel (cv z) S) (wcel (cv w) S)) (wa (wcel (cv v) S) (wcel (cv u) S))) (wa (wcel M S) (wcel N S)) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv z) S) (wcel (cv w) S))) (wa (wcel W S) (wcel X S)) $ >
  $ wi (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv v) S) (wcel (cv u) S))) (wa (wcel Y S) (wcel Z S)) $ >
  $ wi (w3a (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv z) S) (wcel (cv w) S)) (wa (wcel (cv v) S) (wcel (cv u) S))) (wceq H K) $ >
  $ wi (w3a (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv z) S) (wcel (cv w) S)) (wa (wcel (cv v) S) (wcel (cv u) S))) (wceq J L) $ >
  $ wi (w3a (wcel A2 D) (wcel B2 D) (wcel C D)) (wceq (co A2 (co B2 C c_pl) c_x) (co (co A2 B2 c_x) (co A2 C c_x) c_pl)) $;

--| Extend class definition to include the equinumerosity relation ("approximately equals" symbol)
term cen: class;

--| Extend class definition to include the dominance relation (curly less-than-or-equal)
term cdom: class;

--| Extend class definition to include the class of all finite sets.
term cfn: class;

--| Define the equinumerosity relation. Definition of [Enderton] p. 129. We define ` ~~ ` to be a binary relation rather than a connective, so its arguments must be sets to be meaningful. This is acceptable because we do not consider equinumerosity for proper classes. We derive the usual definition as ~ bren . (Contributed by NM, 28-Mar-1998.)
axiom df_en {x3 y1 f2: setvar}:
  $ wceq cen (copab x3 y1 (wex f2 (wf1o (cv x3) (cv y1) (cv f2)))) $;

--| Define the dominance relation. Compare Definition of [Enderton] p. 145. Typical textbook definitions are derived as ~ brdom and ~ domen . (Contributed by NM, 28-Mar-1998.)
axiom df_dom {x3 y1 f2: setvar}:
  $ wceq cdom (copab x3 y1 (wex f2 (wf1 (cv x3) (cv y1) (cv f2)))) $;

--| Define the (proper) class of all finite sets. Similar to Definition 10.29 of [TakeutiZaring] p. 91, whose "Fin(a)" corresponds to our " ` a e. Fin ` ". This definition is meaningful whether or not we accept the Axiom of Infinity ~ ax-inf2 . (Contributed by NM, 22-Aug-2008.)
axiom df_fin {x3 y1: setvar}:
  $ wceq cfn (cab x3 (wrex y1 (wbr (cv x3) (cv y1) cen) com)) $;

--| Equinumerosity is a relation. (Contributed by NM, 28-Mar-1998.)
theorem relen:
  $ wrel cen $;

--| Dominance is a relation. (Contributed by NM, 28-Mar-1998.)
theorem reldom:
  $ wrel cdom $;

--| If two classes are equinumerous, both classes are sets. (Contributed by AV, 21-Mar-2019.)
theorem encv (A2 B2: class):
  $ wi (wbr A2 B2 cen) (wa (wcel A2 cvv) (wcel B2 cvv)) $;

--| Equinumerosity relation. (Contributed by NM, 15-Jun-1998.)
theorem bren {f2: setvar} (A2 B2: class):
  $ wb (wbr A2 B2 cen) (wex f2 (wf1o A2 B2 (cv f2))) $;

--| Dominance relation. (Contributed by NM, 15-Jun-1998.)
theorem brdomg {f2: setvar} (A2 B2: class) (C: class f2):
  $ wi (wcel B2 C) (wb (wbr A2 B2 cdom) (wex f2 (wf1 A2 B2 (cv f2)))) $;

--| Dominance relation. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem brdomi {f2: setvar} (A2 B2: class):
  $ wi (wbr A2 B2 cdom) (wex f2 (wf1 A2 B2 (cv f2))) $;

--| Dominance relation. (Contributed by NM, 15-Jun-1998.)
theorem brdom {f2: setvar} (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wb (wbr A2 B2 cdom) (wex f2 (wf1 A2 B2 (cv f2))) $;

--| Dominance in terms of equinumerosity. Example 1 of [Enderton] p. 146. (Contributed by NM, 15-Jun-1998.)
theorem domen {x3: setvar} (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wb (wbr A2 B2 cdom) (wex x3 (wa (wbr A2 (cv x3) cen) (wss (cv x3) B2))) $;

--| Dominance in terms of equinumerosity, with the sethood requirement expressed as an antecedent. Example 1 of [Enderton] p. 146. (Contributed by NM, 24-Apr-2004.)
theorem domeng {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wcel B2 C) (wb (wbr A2 B2 cdom) (wex x3 (wa (wbr A2 (cv x3) cen) (wss (cv x3) B2)))) $;

--| The domain and range of a one-to-one, onto function are equinumerous. This variation of ~ f1oeng does not require the Axiom of Replacement. (Contributed by NM, 13-Jan-2007.) (Revised by Mario Carneiro, 10-Sep-2015.)
theorem f1oen3g (A2 B2 F V: class):
  $ wi (wa (wcel F V) (wf1o A2 B2 F)) (wbr A2 B2 cen) $;

--| The domain and range of a one-to-one, onto function are equinumerous. This variation of ~ f1oeng does not require the Axiom of Replacement. (Contributed by Mario Carneiro, 10-Sep-2015.)
theorem f1oen2g (A2 B2 F V W: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wf1o A2 B2 F)) (wbr A2 B2 cen) $;

--| The domain of a one-to-one function is dominated by its codomain. This variation of ~ f1domg does not require the Axiom of Replacement. (Contributed by Mario Carneiro, 24-Jun-2015.)
theorem f1dom2g (A2 B2 F V W: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wf1 A2 B2 F)) (wbr A2 B2 cdom) $;

--| The domain and range of a one-to-one, onto function are equinumerous. (Contributed by NM, 19-Jun-1998.)
theorem f1oeng (A2 B2 C F: class):
  $ wi (wa (wcel A2 C) (wf1o A2 B2 F)) (wbr A2 B2 cen) $;

--| The domain of a one-to-one function is dominated by its codomain. (Contributed by NM, 4-Sep-2004.)
theorem f1domg (A2 B2 C F: class):
  $ wi (wcel B2 C) (wi (wf1 A2 B2 F) (wbr A2 B2 cdom)) $;

--| The domain and range of a one-to-one, onto function are equinumerous. (Contributed by NM, 19-Jun-1998.)
theorem f1oen (A2 B2 F: class):
  $ wcel A2 cvv $ >
  $ wi (wf1o A2 B2 F) (wbr A2 B2 cen) $;

--| The domain of a one-to-one function is dominated by its codomain. (Contributed by NM, 19-Jun-1998.)
theorem f1dom (A2 B2 F: class):
  $ wcel B2 cvv $ >
  $ wi (wf1 A2 B2 F) (wbr A2 B2 cdom) $;

--| Express " ` A ` is finite." Definition 10.29 of [TakeutiZaring] p. 91 (whose " ` Fin ` " is a predicate instead of a class). (Contributed by NM, 22-Aug-2008.)
theorem isfi {x3: setvar} (A2: class):
  $ wb (wcel A2 cfn) (wrex x3 (wbr A2 (cv x3) cen) com) $;

--| Equinumerosity implies dominance. (Contributed by NM, 31-Mar-1998.)
theorem enssdom:
  $ wss cen cdom $;

--| Equinumerosity implies dominance. Theorem 15 of [Suppes] p. 94. (Contributed by NM, 28-May-1998.)
theorem endom (A2 B2: class):
  $ wi (wbr A2 B2 cen) (wbr A2 B2 cdom) $;

--| Equinumerosity is reflexive. Theorem 1 of [Suppes] p. 92. (Contributed by NM, 18-Jun-1998.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem enrefg (A2 V: class):
  $ wi (wcel A2 V) (wbr A2 A2 cen) $;

--| Equinumerosity is reflexive. Theorem 1 of [Suppes] p. 92. (Contributed by NM, 25-Sep-2004.)
theorem enref (A2: class):
  $ wcel A2 cvv $ >
  $ wbr A2 A2 cen $;

--| Equality implies equinumerosity. (Contributed by NM, 26-Oct-2003.)
theorem eqeng (A2 B2 V: class):
  $ wi (wcel A2 V) (wi (wceq A2 B2) (wbr A2 B2 cen)) $;

--| Dominance is reflexive. (Contributed by NM, 18-Jun-1998.)
theorem domrefg (A2 V: class):
  $ wi (wcel A2 V) (wbr A2 A2 cdom) $;

--| Equinumerosity inference from an implicit one-to-one onto function. (Contributed by NM, 27-Jul-2004.) (Revised by Mario Carneiro, 12-May-2014.)
theorem en2d {x3 y1: setvar} (ph: wff) (A2 B2: class) (C: class x3) (D: class y1):
  $ wi ph (wcel A2 cvv) $ >
  $ wi ph (wcel B2 cvv) $ >
  $ wi ph (wi (wcel (cv x3) A2) (wcel C cvv)) $ >
  $ wi ph (wi (wcel (cv y1) B2) (wcel D cvv)) $ >
  $ wi ph (wb (wa (wcel (cv x3) A2) (wceq (cv y1) C)) (wa (wcel (cv y1) B2) (wceq (cv x3) D))) $ >
  $ wi ph (wbr A2 B2 cen) $;

--| Equinumerosity inference from an implicit one-to-one onto function. (Contributed by NM, 27-Jul-2004.) (Revised by Mario Carneiro, 12-May-2014.)
theorem en3d {x3 y1: setvar} (ph: wff) (A2 B2: class) (C: class x3) (D: class y1):
  $ wi ph (wcel A2 cvv) $ >
  $ wi ph (wcel B2 cvv) $ >
  $ wi ph (wi (wcel (cv x3) A2) (wcel C B2)) $ >
  $ wi ph (wi (wcel (cv y1) B2) (wcel D A2)) $ >
  $ wi ph (wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wb (wceq (cv x3) D) (wceq (cv y1) C))) $ >
  $ wi ph (wbr A2 B2 cen) $;

--| Equinumerosity inference from an implicit one-to-one onto function. (Contributed by NM, 4-Jan-2004.)
theorem en2i {x3 y1: setvar} (A2 B2: class) (C: class x3) (D: class y1):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wcel (cv x3) A2) (wcel C cvv) $ >
  $ wi (wcel (cv y1) B2) (wcel D cvv) $ >
  $ wb (wa (wcel (cv x3) A2) (wceq (cv y1) C)) (wa (wcel (cv y1) B2) (wceq (cv x3) D)) $ >
  $ wbr A2 B2 cen $;

--| Equinumerosity inference from an implicit one-to-one onto function. (Contributed by NM, 19-Jul-2004.)
theorem en3i {x3 y1: setvar} (A2 B2: class) (C: class x3) (D: class y1):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wcel (cv x3) A2) (wcel C B2) $ >
  $ wi (wcel (cv y1) B2) (wcel D A2) $ >
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wb (wceq (cv x3) D) (wceq (cv y1) C)) $ >
  $ wbr A2 B2 cen $;

--| A mapping (first hypothesis) that is one-to-one (second hypothesis) implies its domain is dominated by its codomain. (Contributed by NM, 24-Jul-2004.)
theorem dom2lem {x3 y1: setvar} (ph: wff) (A2 B2: class) (C: class x3) (D: class y1):
  $ wi ph (wi (wcel (cv x3) A2) (wcel C B2)) $ >
  $ wi ph (wi (wa (wcel (cv x3) A2) (wcel (cv y1) A2)) (wb (wceq C D) (wceq (cv x3) (cv y1)))) $ >
  $ wi ph (wf1 A2 B2 (cmpt x3 A2 C)) $;

--| A mapping (first hypothesis) that is one-to-one (second hypothesis) implies its domain is dominated by its codomain. (Contributed by NM, 24-Jul-2004.) (Revised by Mario Carneiro, 20-May-2013.)
theorem dom2d {x3 y1: setvar} (ph: wff) (A2 B2: class) (C: class x3) (D: class y1) (R: class x3 y1):
  $ wi ph (wi (wcel (cv x3) A2) (wcel C B2)) $ >
  $ wi ph (wi (wa (wcel (cv x3) A2) (wcel (cv y1) A2)) (wb (wceq C D) (wceq (cv x3) (cv y1)))) $ >
  $ wi ph (wi (wcel B2 R) (wbr A2 B2 cdom)) $;

--| A mapping (first hypothesis) that is one-to-one (second hypothesis) implies its domain is dominated by its codomain. (Contributed by Mario Carneiro, 20-May-2013.)
theorem dom3d {x3 y1: setvar} (ph: wff) (A2 B2: class) (C: class x3) (D: class y1) (V W: class x3 y1):
  $ wi ph (wi (wcel (cv x3) A2) (wcel C B2)) $ >
  $ wi ph (wi (wa (wcel (cv x3) A2) (wcel (cv y1) A2)) (wb (wceq C D) (wceq (cv x3) (cv y1)))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wbr A2 B2 cdom) $;

--| A mapping (first hypothesis) that is one-to-one (second hypothesis) implies its domain is dominated by its codomain. ` C ` and ` D ` can be read ` C ( x ) ` and ` D ( y ) ` , as can be inferred from their distinct variable conditions. (Contributed by NM, 26-Oct-2003.)
theorem dom2 {x3 y1: setvar} (A2 B2: class) (C: class x3) (D: class y1) (V: class x3 y1):
  $ wi (wcel (cv x3) A2) (wcel C B2) $ >
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) A2)) (wb (wceq C D) (wceq (cv x3) (cv y1))) $ >
  $ wi (wcel B2 V) (wbr A2 B2 cdom) $;

--| A mapping (first hypothesis) that is one-to-one (second hypothesis) implies its domain is dominated by its codomain. ` C ` and ` D ` can be read ` C ( x ) ` and ` D ( y ) ` , as can be inferred from their distinct variable conditions. (Contributed by Mario Carneiro, 20-May-2013.)
theorem dom3 {x3 y1: setvar} (A2 B2: class) (C: class x3) (D: class y1) (V W: class):
  $ wi (wcel (cv x3) A2) (wcel C B2) $ >
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) A2)) (wb (wceq C D) (wceq (cv x3) (cv y1))) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wbr A2 B2 cdom) $;

--| Equality implies equinumerosity. (Contributed by NM, 30-Apr-1998.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem idssen:
  $ wss cid cen $;

--| A set dominates its subsets. Theorem 16 of [Suppes] p. 94. (Contributed by NM, 19-Jun-1998.) (Revised by Mario Carneiro, 24-Jun-2015.)
theorem ssdomg (A2 B2 V: class):
  $ wi (wcel B2 V) (wi (wss A2 B2) (wbr A2 B2 cdom)) $;

--| Equinumerosity is an equivalence relation. (Contributed by NM, 19-Mar-1998.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem ener:
  $ wer cvv cen $;

--| Symmetry of equinumerosity. Theorem 2 of [Suppes] p. 92. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem ensymb (A2 B2: class):
  $ wb (wbr A2 B2 cen) (wbr B2 A2 cen) $;

--| Symmetry of equinumerosity. Theorem 2 of [Suppes] p. 92. (Contributed by NM, 26-Oct-2003.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem ensym (A2 B2: class):
  $ wi (wbr A2 B2 cen) (wbr B2 A2 cen) $;

--| Symmetry of equinumerosity. Theorem 2 of [Suppes] p. 92. (Contributed by NM, 25-Sep-2004.)
theorem ensymi (A2 B2: class):
  $ wbr A2 B2 cen $ >
  $ wbr B2 A2 cen $;

--| Symmetry of equinumerosity. Deduction form of ~ ensym . (Contributed by David Moews, 1-May-2017.)
theorem ensymd (ph: wff) (A2 B2: class):
  $ wi ph (wbr A2 B2 cen) $ >
  $ wi ph (wbr B2 A2 cen) $;

--| Transitivity of equinumerosity. Theorem 3 of [Suppes] p. 92. (Contributed by NM, 9-Jun-1998.)
theorem entr (A2 B2 C: class):
  $ wi (wa (wbr A2 B2 cen) (wbr B2 C cen)) (wbr A2 C cen) $;

--| Transitivity of dominance relation. Theorem 17 of [Suppes] p. 94. (Contributed by NM, 4-Jun-1998.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem domtr (A2 B2 C: class):
  $ wi (wa (wbr A2 B2 cdom) (wbr B2 C cdom)) (wbr A2 C cdom) $;

--| A chained equinumerosity inference. (Contributed by NM, 25-Sep-2004.)
theorem entri (A2 B2 C: class):
  $ wbr A2 B2 cen $ >
  $ wbr B2 C cen $ >
  $ wbr A2 C cen $;

--| A chained equinumerosity inference. (Contributed by NM, 25-Sep-2004.)
theorem entr2i (A2 B2 C: class):
  $ wbr A2 B2 cen $ >
  $ wbr B2 C cen $ >
  $ wbr C A2 cen $;

--| A chained equinumerosity inference. (Contributed by NM, 25-Sep-2004.)
theorem entr3i (A2 B2 C: class):
  $ wbr A2 B2 cen $ >
  $ wbr A2 C cen $ >
  $ wbr B2 C cen $;

--| A chained equinumerosity inference. (Contributed by NM, 25-Sep-2004.)
theorem entr4i (A2 B2 C: class):
  $ wbr A2 B2 cen $ >
  $ wbr C B2 cen $ >
  $ wbr A2 C cen $;

--| Transitivity of equinumerosity and dominance. (Contributed by NM, 7-Jun-1998.)
theorem endomtr (A2 B2 C: class):
  $ wi (wa (wbr A2 B2 cen) (wbr B2 C cdom)) (wbr A2 C cdom) $;

--| Transitivity of dominance and equinumerosity. (Contributed by NM, 7-Jun-1998.)
theorem domentr (A2 B2 C: class):
  $ wi (wa (wbr A2 B2 cdom) (wbr B2 C cen)) (wbr A2 C cdom) $;

--| A one-to-one function's image under a subset of its domain is equinumerous to the subset. (Contributed by Mario Carneiro, 15-May-2015.)
theorem f1imaeng (A2 B2 C F V: class):
  $ wi (w3a (wf1 A2 B2 F) (wss C A2) (wcel C V)) (wbr (cima F C) C cen) $;

--| A one-to-one function's image under a subset of its domain is equinumerous to the subset. (This version of ~ f1imaen does not need ~ ax-setind .) (Contributed by Mario Carneiro, 16-Nov-2014.) (Revised by Mario Carneiro, 25-Jun-2015.)
theorem f1imaen2g (A2 B2 C F V: class):
  $ wi (wa (wa (wf1 A2 B2 F) (wcel B2 V)) (wa (wss C A2) (wcel C V))) (wbr (cima F C) C cen) $;

--| A one-to-one function's image under a subset of its domain is equinumerous to the subset. (Contributed by NM, 30-Sep-2004.)
theorem f1imaen (A2 B2 C F: class):
  $ wcel C cvv $ >
  $ wi (wa (wf1 A2 B2 F) (wss C A2)) (wbr (cima F C) C cen) $;

--| The empty set is equinumerous only to itself. Exercise 1 of [TakeutiZaring] p. 88. (Contributed by NM, 27-May-1998.)
theorem en0 (A2: class):
  $ wb (wbr A2 c0 cen) (wceq A2 c0) $;

--| A singleton is equinumerous to ordinal one. (Contributed by NM, 4-Nov-2002.)
theorem ensn1 (A2: class):
  $ wcel A2 cvv $ >
  $ wbr (csn A2) c1o cen $;

--| A singleton is equinumerous to ordinal one. (Contributed by NM, 23-Apr-2004.)
theorem ensn1g (A2 V: class):
  $ wi (wcel A2 V) (wbr (csn A2) c1o cen) $;

--| ` { A , A } ` has only one element. (Contributed by FL, 15-Feb-2010.)
theorem enpr1g (A2 V: class):
  $ wi (wcel A2 V) (wbr (cpr A2 A2) c1o cen) $;

--| A set is equinumerous to ordinal one iff it is a singleton. (Contributed by NM, 25-Jul-2004.)
theorem en1 {x3: setvar} (A2: class):
  $ wb (wbr A2 c1o cen) (wex x3 (wceq A2 (csn (cv x3)))) $;

--| A set is equinumerous to ordinal one iff it is a singleton. (Contributed by Jim Kingdon, 13-Apr-2020.)
theorem en1bg (A2 V: class):
  $ wi (wcel A2 V) (wb (wbr A2 c1o cen) (wceq A2 (csn (cuni A2)))) $;

--| Two ways to express "exactly one". (Contributed by Stefan O'Rear, 28-Oct-2014.)
theorem reuen1 {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wreu x3 ph A2) (wbr (crab x3 ph A2) c1o cen) $;

--| Two ways to express "exactly one". (Contributed by Stefan O'Rear, 28-Oct-2014.)
theorem euen1 {x3: setvar} (ph: wff x3):
  $ wb (weu x3 ph) (wbr (cab x3 ph) c1o cen) $;

--| Two ways to express " ` A ` has a unique element". (Contributed by Mario Carneiro, 9-Apr-2015.)
theorem euen1b {x3: setvar} (A2: class):
  $ wb (wbr A2 c1o cen) (weu x3 (wcel (cv x3) A2)) $;

--| A singleton contains its sole element. (Contributed by Stefan O'Rear, 16-Aug-2015.)
theorem en1uniel (S: class):
  $ wi (wbr S c1o cen) (wcel (cuni S) S) $;

--| A set that dominates ordinal 2 has at least 2 different members. (Contributed by NM, 25-Jul-2004.)
theorem _2dom {x3 y1: setvar} (A2: class):
  $ wi (wbr c2o A2 cdom) (wrex x3 (wrex y1 (wn (wceq (cv x3) (cv y1))) A2) A2) $;

--| A function is equinumerous to its domain. Exercise 4 of [Suppes] p. 98. (Contributed by NM, 28-Jul-2004.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem fundmen (F: class):
  $ wcel F cvv $ >
  $ wi (wfun F) (wbr (cdm F) F cen) $;

--| A function is equinumerous to its domain. Exercise 4 of [Suppes] p. 98. (Contributed by NM, 17-Sep-2013.)
theorem fundmeng (F V: class):
  $ wi (wa (wcel F V) (wfun F)) (wbr (cdm F) F cen) $;

--| A relational set is equinumerous to its converse. (Contributed by Mario Carneiro, 28-Dec-2014.)
theorem cnven (A2 V: class):
  $ wi (wa (wrel A2) (wcel A2 V)) (wbr A2 (ccnv A2) cen) $;

--| A function is equinumerate to its domain. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem fndmeng (A2 C F: class):
  $ wi (wa (wfn F A2) (wcel A2 C)) (wbr A2 F cen) $;

--| Two singletons are equinumerous. (Contributed by NM, 9-Nov-2003.)
theorem en2sn (A2 B2 C D: class):
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wbr (csn A2) (csn B2) cen) $;

--| A singleton is finite. (Contributed by Jim Kingdon, 13-Apr-2020.)
theorem snfig (A2 V: class):
  $ wi (wcel A2 V) (wcel (csn A2) cfn) $;

--| The class of finite sets is a proper class. (Contributed by Jeff Hankins, 3-Oct-2008.)
theorem fiprc:
  $ wnel cfn cvv $;

--| Equinumerosity of union of disjoint sets. Theorem 4 of [Suppes] p. 92. (Contributed by NM, 11-Jun-1998.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem unen (A2 B2 C D: class):
  $ wi (wa (wa (wbr A2 B2 cen) (wbr C D cen)) (wa (wceq (cin A2 C) c0) (wceq (cin B2 D) c0))) (wbr (cun A2 C) (cun B2 D) cen) $;

--| A set equinumerous to an inhabited set is inhabited. (Contributed by Jim Kingdon, 19-May-2020.)
theorem enm {x3 y1: setvar} (A2 B2: class):
  $ wi (wa (wbr A2 B2 cen) (wex x3 (wcel (cv x3) A2))) (wex y1 (wcel (cv y1) B2)) $;

--| A set is equinumerous to its Cartesian product with a singleton. Proposition 4.22(c) of [Mendelson] p. 254. (Contributed by NM, 4-Jan-2004.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem xpsnen (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wbr (cxp A2 (csn B2)) A2 cen $;

--| A set is equinumerous to its Cartesian product with a singleton. Proposition 4.22(c) of [Mendelson] p. 254. (Contributed by NM, 22-Oct-2004.)
theorem xpsneng (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wbr (cxp A2 (csn B2)) A2 cen) $;

--| One times a cardinal number. (Contributed by NM, 27-Sep-2004.) (Revised by Mario Carneiro, 29-Apr-2015.)
theorem xp1en (A2 V: class):
  $ wi (wcel A2 V) (wbr (cxp A2 c1o) A2 cen) $;

--| Any two sets are equinumerous to disjoint sets. Exercise 4.39 of [Mendelson] p. 255. (Contributed by NM, 16-Apr-2004.)
theorem endisj {x3 y1: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wex x3 (wex y1 (wa (wa (wbr (cv x3) A2 cen) (wbr (cv y1) B2 cen)) (wceq (cin (cv x3) (cv y1)) c0))) $;

--| The canonical bijection from ` ( A X. B ) ` to ` ( B X. A ) ` . (Contributed by Mario Carneiro, 23-Apr-2014.)
theorem xpcomf1o {x3: setvar} (A2 B2: class) (F: class x3):
  $ wceq F (cmpt x3 (cxp A2 B2) (cuni (ccnv (csn (cv x3))))) $ >
  $ wf1o (cxp A2 B2) (cxp B2 A2) F $;

--| Composition with the bijection of ~ xpcomf1o swaps the arguments to a mapping. (Contributed by Mario Carneiro, 30-May-2015.)
theorem xpcomco {x3 y1 z: setvar} (A2 B2: class) (C: class x3 y1 z) (F: class x3) (G: class x3 y1 z):
  $ wceq F (cmpt x3 (cxp A2 B2) (cuni (ccnv (csn (cv x3))))) $ >
  $ wceq G (cmpt2 y1 z B2 A2 C) $ >
  $ wceq (ccom G F) (cmpt2 z y1 A2 B2 C) $;

--| Commutative law for equinumerosity of Cartesian product. Proposition 4.22(d) of [Mendelson] p. 254. (Contributed by NM, 5-Jan-2004.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem xpcomen (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wbr (cxp A2 B2) (cxp B2 A2) cen $;

--| Commutative law for equinumerosity of Cartesian product. Proposition 4.22(d) of [Mendelson] p. 254. (Contributed by NM, 27-Mar-2006.)
theorem xpcomeng (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wbr (cxp A2 B2) (cxp B2 A2) cen) $;

--| A set is equinumerous to its Cartesian product with a singleton on the left. (Contributed by Stefan O'Rear, 21-Nov-2014.)
theorem xpsnen2g (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wbr (cxp (csn A2) B2) B2 cen) $;

--| Associative law for equinumerosity of Cartesian product. Proposition 4.22(e) of [Mendelson] p. 254. (Contributed by NM, 22-Jan-2004.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem xpassen (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wbr (cxp (cxp A2 B2) C) (cxp A2 (cxp B2 C)) cen $;

--| Dominance law for Cartesian product. Proposition 10.33(2) of [TakeutiZaring] p. 92. (Contributed by NM, 24-Jul-2004.) (Revised by Mario Carneiro, 15-Nov-2014.)
theorem xpdom2 (A2 B2 C: class):
  $ wcel C cvv $ >
  $ wi (wbr A2 B2 cdom) (wbr (cxp C A2) (cxp C B2) cdom) $;

--| Dominance law for Cartesian product. Theorem 6L(c) of [Enderton] p. 149. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem xpdom2g (A2 B2 C V: class):
  $ wi (wa (wcel C V) (wbr A2 B2 cdom)) (wbr (cxp C A2) (cxp C B2) cdom) $;

--| Dominance law for Cartesian product. Theorem 6L(c) of [Enderton] p. 149. (Contributed by NM, 25-Mar-2006.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem xpdom1g (A2 B2 C V: class):
  $ wi (wa (wcel C V) (wbr A2 B2 cdom)) (wbr (cxp A2 C) (cxp B2 C) cdom) $;

--| A set is dominated by its Cartesian product with an inhabited set. Exercise 6 of [Suppes] p. 98. (Contributed by Jim Kingdon, 15-Apr-2020.)
theorem xpdom3m {x3: setvar} (A2 B2 V W: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wex x3 (wcel (cv x3) B2))) (wbr A2 (cxp A2 B2) cdom) $;

--| Dominance law for Cartesian product. Theorem 6L(c) of [Enderton] p. 149. (Contributed by NM, 28-Sep-2004.) (Revised by NM, 29-Mar-2006.) (Revised by Mario Carneiro, 7-May-2015.)
theorem xpdom1 (A2 B2 C: class):
  $ wcel C cvv $ >
  $ wi (wbr A2 B2 cdom) (wbr (cxp A2 C) (cxp B2 C) cdom) $;

--| Covering implies injection on power sets. (Contributed by Stefan O'Rear, 6-Nov-2014.) (Revised by Mario Carneiro, 24-Jun-2015.)
theorem fopwdom (A2 B2 F: class):
  $ wi (wa (wcel F cvv) (wfo A2 B2 F)) (wbr (cpw B2) (cpw A2) cdom) $;

--| Equality-like theorem for equinumerosity. (Contributed by NM, 18-Dec-2003.)
theorem enen1 (A2 B2 C: class):
  $ wi (wbr A2 B2 cen) (wb (wbr A2 C cen) (wbr B2 C cen)) $;

--| Equality-like theorem for equinumerosity. (Contributed by NM, 18-Dec-2003.)
theorem enen2 (A2 B2 C: class):
  $ wi (wbr A2 B2 cen) (wb (wbr C A2 cen) (wbr C B2 cen)) $;

--| Equality-like theorem for equinumerosity and dominance. (Contributed by NM, 8-Nov-2003.)
theorem domen1 (A2 B2 C: class):
  $ wi (wbr A2 B2 cen) (wb (wbr A2 C cdom) (wbr B2 C cdom)) $;

--| Equality-like theorem for equinumerosity and dominance. (Contributed by NM, 8-Nov-2003.)
theorem domen2 (A2 B2 C: class):
  $ wi (wbr A2 B2 cen) (wb (wbr C A2 cdom) (wbr C B2 cdom)) $;

--| Lemma for Pigeonhole Principle. If we join a natural number to itself minus an element, we end up with its successor minus the same element. (Contributed by NM, 25-May-1998.)
theorem phplem1 (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 A2)) (wceq (cun (csn A2) (cdif A2 (csn B2))) (cdif (csuc A2) (csn B2))) $;

--| Lemma for Pigeonhole Principle. A natural number is equinumerous to its successor minus one of its elements. (Contributed by NM, 11-Jun-1998.) (Revised by Mario Carneiro, 16-Nov-2014.)
theorem phplem2 (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wcel A2 com) (wcel B2 A2)) (wbr A2 (cdif (csuc A2) (csn B2)) cen) $;

--| Lemma for Pigeonhole Principle. A natural number is equinumerous to its successor minus any element of the successor. For a version without the redundant hypotheses, see ~ phplem3g . (Contributed by NM, 26-May-1998.)
theorem phplem3 (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wcel A2 com) (wcel B2 (csuc A2))) (wbr A2 (cdif (csuc A2) (csn B2)) cen) $;

--| Lemma for Pigeonhole Principle. Equinumerosity of successors implies equinumerosity of the original natural numbers. (Contributed by NM, 28-May-1998.) (Revised by Mario Carneiro, 24-Jun-2015.)
theorem phplem4 (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wi (wbr (csuc A2) (csuc B2) cen) (wbr A2 B2 cen)) $;

--| A natural number is equinumerous to its successor minus any element of the successor. Version of ~ phplem3 with unnecessary hypotheses removed. (Contributed by Jim Kingdon, 1-Sep-2021.)
theorem phplem3g (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 (csuc A2))) (wbr A2 (cdif (csuc A2) (csn B2)) cen) $;

--| Two equinumerous natural numbers are equal. Proposition 10.20 of [TakeutiZaring] p. 90 and its converse. Also compare Corollary 6E of [Enderton] p. 136. (Contributed by NM, 28-May-1998.)
theorem nneneq (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wb (wbr A2 B2 cen) (wceq A2 B2)) $;

--| A natural number is not equinumerous to its successor. Corollary 10.21(1) of [TakeutiZaring] p. 90. (Contributed by NM, 26-Jul-2004.)
theorem php5 (A2: class):
  $ wi (wcel A2 com) (wn (wbr A2 (csuc A2) cen)) $;

--| A singleton ` { A } ` is never equinumerous with the ordinal number 2. If ` A ` is a proper class, see ~ snnen2oprc . (Contributed by Jim Kingdon, 1-Sep-2021.)
theorem snnen2og (A2 V: class):
  $ wi (wcel A2 V) (wn (wbr (csn A2) c2o cen)) $;

--| A singleton ` { A } ` is never equinumerous with the ordinal number 2. If ` A ` is a set, see ~ snnen2og . (Contributed by Jim Kingdon, 1-Sep-2021.)
theorem snnen2oprc (A2: class):
  $ wi (wn (wcel A2 cvv)) (wn (wbr (csn A2) c2o cen)) $;

--| Dominance of successors implies dominance of the original natural numbers. (Contributed by Jim Kingdon, 1-Sep-2021.)
theorem phplem4dom (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wi (wbr (csuc A2) (csuc B2) cdom) (wbr A2 B2 cdom)) $;

--| A natural number does not dominate its successor. (Contributed by Jim Kingdon, 1-Sep-2021.)
theorem php5dom (A2: class):
  $ wi (wcel A2 com) (wn (wbr (csuc A2) A2 cdom)) $;

--| Cardinal ordering agrees with natural number ordering. Example 3 of [Enderton] p. 146. (Contributed by NM, 17-Jun-1998.)
theorem nndomo (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wb (wbr A2 B2 cdom) (wss A2 B2)) $;

--| Pigeonhole Principle. A natural number is not equinumerous to a proper subset of itself. By "proper subset" here we mean that there is an element which is in the natural number and not in the subset, or in symbols ` E. x x e. ( A \ B ) ` (which is stronger than not being equal in the absence of excluded middle). Theorem (Pigeonhole Principle) of [Enderton] p. 134. The theorem is so-called because you can't put _n_ + 1 pigeons into _n_ holes (if each hole holds only one pigeon). The proof consists of lemmas ~ phplem1 through ~ phplem4 , ~ nneneq , and this final piece of the proof. (Contributed by NM, 29-May-1998.)
theorem phpm {x3: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 com) (wss B2 A2) (wex x3 (wcel (cv x3) (cdif A2 B2)))) (wn (wbr A2 B2 cen)) $;

--| Pigeonhole Principle. A natural number is not equinumerous to an element of itself. (Contributed by Jim Kingdon, 6-Sep-2021.)
theorem phpelm (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 A2)) (wn (wbr A2 B2 cen)) $;

--| Equinumerosity of successors of an ordinal and a natural number implies equinumerosity of the originals. (Contributed by Jim Kingdon, 5-Sep-2021.)
theorem phplem4on (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 com)) (wi (wbr (csuc A2) (csuc B2) cen) (wbr A2 B2 cen)) $;

--| Equality of members of a finite set is decidable. This may be counterintuitive: cannot any two sets be elements of a finite set? Well, to show, for example, that ` { B , C } ` is finite would require showing it is equinumerous to ` 1o ` or to ` 2o ` but to show that you'd need to know ` B = C ` or ` -. B = C ` , respectively. (Contributed by Jim Kingdon, 5-Sep-2021.)
theorem fidceq (A2 B2 C: class):
  $ wi (w3a (wcel A2 cfn) (wcel B2 A2) (wcel C A2)) (wdc (wceq B2 C)) $;

--| All decrements of a finite set are equinumerous. (Contributed by Jim Kingdon, 9-Sep-2021.)
theorem fidifsnen (A2 B2 X: class):
  $ wi (w3a (wcel X cfn) (wcel A2 X) (wcel B2 X)) (wbr (cdif X (csn A2)) (cdif X (csn B2)) cen) $;

--| If we remove a single element from a finite set then put it back in, we end up with the original finite set. This strengthens ~ difsnss from subset to equality when the set is finite. (Contributed by Jim Kingdon, 9-Sep-2021.)
theorem fidifsnid (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wcel B2 A2)) (wceq (cun (cdif A2 (csn B2)) (csn B2)) A2) $;

--| Natural numbers are finite sets. (Contributed by Stefan O'Rear, 21-Mar-2015.)
theorem nnfi (A2: class):
  $ wi (wcel A2 com) (wcel A2 cfn) $;

--| Equinumerous sets have the same finiteness. (Contributed by NM, 22-Aug-2008.)
theorem enfi (A2 B2: class):
  $ wi (wbr A2 B2 cen) (wb (wcel A2 cfn) (wcel B2 cfn)) $;

--| A set equinumerous to a finite set is finite. (Contributed by Mario Carneiro, 12-Mar-2015.)
theorem enfii (A2 B2: class):
  $ wi (wa (wcel B2 cfn) (wbr A2 B2 cen)) (wcel A2 cfn) $;

--| If any subset of a finite set is finite, excluded middle follows. One direction of Theorem 2.1 of [Bauer], p. 485. (Contributed by Jim Kingdon, 19-May-2020.)
theorem ssfiexmid {x3 y1: setvar} (ph: wff):
  $ wal x3 (wal y1 (wi (wa (wcel (cv x3) cfn) (wss (cv y1) (cv x3))) (wcel (cv y1) cfn))) $ >
  $ wo ph (wn ph) $;

--| If a set ` A ` is equinumerous to the successor of a natural number ` M ` , then ` A ` with an element removed is equinumerous to ` M ` . (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Stefan O'Rear, 16-Aug-2015.)
theorem dif1en (A2 M X: class):
  $ wi (w3a (wcel M com) (wbr A2 (csuc M) cen) (wcel X A2)) (wbr (cdif A2 (csn X)) M cen) $;

--| Adding one element to a finite set which is equinumerous to a natural number. (Contributed by Jim Kingdon, 13-Sep-2021.)
theorem fiunsnnn (A2 B2 N: class):
  $ wi (wa (wa (wcel A2 cfn) (wcel B2 (cdif cvv A2))) (wa (wcel N com) (wbr A2 N cen))) (wbr (cun A2 (csn B2)) (csuc N) cen) $;

--| A finite set is not equinumerous to a set which adds one element. (Contributed by Jim Kingdon, 13-Sep-2021.)
theorem php5fin (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wcel B2 (cdif cvv A2))) (wn (wbr A2 (cun A2 (csn B2)) cen)) $;

--| Schroeder-Bernstein Theorem for finite sets. (Contributed by Jim Kingdon, 12-Sep-2021.)
theorem fisbth (A2 B2: class):
  $ wi (wa (wa (wcel A2 cfn) (wcel B2 cfn)) (wa (wbr A2 B2 cdom) (wbr B2 A2 cdom))) (wbr A2 B2 cen) $;

--| The empty set is finite. (Contributed by FL, 14-Jul-2008.)
theorem _0fin:
  $ wcel c0 cfn $;

--| A nonempty finite set has at least one element. (Contributed by Jim Kingdon, 10-Sep-2021.)
theorem fin0 {x3: setvar} (A2: class):
  $ wi (wcel A2 cfn) (wb (wne A2 c0) (wex x3 (wcel (cv x3) A2))) $;

--| A finite set is either empty or inhabited. (Contributed by Jim Kingdon, 30-Sep-2021.)
theorem fin0or {x3: setvar} (A2: class):
  $ wi (wcel A2 cfn) (wo (wceq A2 c0) (wex x3 (wcel (cv x3) A2))) $;

--| If subtracting any set from a finite set gives a finite set, any proposition of the form ` -. ph ` is decidable. This is not a proof of full excluded middle, but it is close enough to show we won't be able to prove ` A e. Fin -> ( A \ B ) e. Fin ` . (Contributed by Jim Kingdon, 8-Sep-2021.)
theorem diffitest {a b: setvar} (ph: wff a):
  $ wral a (wal b (wcel (cdif (cv a) (cv b)) cfn)) cfn $ >
  $ wo (wn ph) (wn (wn ph)) $;

--| Schema for induction on the cardinality of a finite set. The inductive hypothesis is that the result is true on the given set with any one element removed. The result is then proven to be true for all finite sets. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem findcard {x3 y1 z: setvar} (ph: wff x3) (ps ch th ta: wff y1 z) (A2: class):
  $ wi (wceq (cv x3) c0) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cdif (cv y1) (csn (cv z)))) (wb ph ch) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph th) $ >
  $ wi (wceq (cv x3) A2) (wb ph ta) $ >
  $ ps $ >
  $ wi (wcel (cv y1) cfn) (wi (wral z ch (cv y1)) th) $ >
  $ wi (wcel A2 cfn) ta $;

--| Schema for induction on the cardinality of a finite set. The inductive step shows that the result is true if one more element is added to the set. The result is then proven to be true for all finite sets. (Contributed by Jeff Madsen, 8-Jul-2010.)
theorem findcard2 {x3 y1 z: setvar} (ph: wff x3) (ps ch th ta: wff y1 z) (A2: class):
  $ wi (wceq (cv x3) c0) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (cun (cv y1) (csn (cv z)))) (wb ph th) $ >
  $ wi (wceq (cv x3) A2) (wb ph ta) $ >
  $ ps $ >
  $ wi (wcel (cv y1) cfn) (wi ch th) $ >
  $ wi (wcel A2 cfn) ta $;

--| Variation of ~ findcard2 requiring that the element added in the induction step not be a member of the original set. (Contributed by Paul Chapman, 30-Nov-2012.)
theorem findcard2s {x3 y1 z: setvar} (ph: wff x3) (ps ch th ta: wff y1 z) (A2: class):
  $ wi (wceq (cv x3) c0) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (cun (cv y1) (csn (cv z)))) (wb ph th) $ >
  $ wi (wceq (cv x3) A2) (wb ph ta) $ >
  $ ps $ >
  $ wi (wa (wcel (cv y1) cfn) (wn (wcel (cv z) (cv y1)))) (wi ch th) $ >
  $ wi (wcel A2 cfn) ta $;

--| Deduction version of ~ findcard2 . If you also need ` y e. Fin ` (which doesn't come for free due to ~ ssfiexmid ), use ~findcard2sd instead. (Contributed by SO, 16-Jul-2018.)
theorem findcard2d {x3 y1 z: setvar} (ph: wff) (ps: wff x3) (ch th ta et: wff y1 z) (A2: class):
  $ wi (wceq (cv x3) c0) (wb ps ch) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ps th) $ >
  $ wi (wceq (cv x3) (cun (cv y1) (csn (cv z)))) (wb ps ta) $ >
  $ wi (wceq (cv x3) A2) (wb ps et) $ >
  $ wi ph ch $ >
  $ wi (wa ph (wa (wss (cv y1) A2) (wcel (cv z) (cdif A2 (cv y1))))) (wi th ta) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph et $;

--| Deduction form of finite set induction . (Contributed by Jim Kingdon, 14-Sep-2021.)
theorem findcard2sd {x3 y1 z: setvar} (ph: wff) (ps: wff x3) (ch th ta et: wff y1 z) (A2: class):
  $ wi (wceq (cv x3) c0) (wb ps ch) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ps th) $ >
  $ wi (wceq (cv x3) (cun (cv y1) (csn (cv z)))) (wb ps ta) $ >
  $ wi (wceq (cv x3) A2) (wb ps et) $ >
  $ wi ph ch $ >
  $ wi (wa (wa ph (wcel (cv y1) cfn)) (wa (wss (cv y1) A2) (wcel (cv z) (cdif A2 (cv y1))))) (wi th ta) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph et $;

--| Subtracting a singleton from a finite set produces a finite set. (Contributed by Jim Kingdon, 11-Sep-2021.)
theorem diffisn (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wcel B2 A2)) (wcel (cdif A2 (csn B2)) cfn) $;

--| Subtracting one finite set from another produces a finite set. (Contributed by Jim Kingdon, 8-Sep-2021.)
theorem diffifi (A2 B2: class):
  $ wi (w3a (wcel A2 cfn) (wcel B2 cfn) (wss B2 A2)) (wcel (cdif A2 B2) cfn) $;

--| Existence of a choice function for finite sets. (Contributed by Jeff Hankins, 26-Jun-2009.) (Proof shortened by Mario Carneiro, 29-Jan-2014.)
theorem ac6sfi {x3 y1 f2: setvar} (ph: wff x3 y1) (ps: wff x3 f2) (A2: class y1) (B2: class):
  $ wi (wceq (cv y1) (cfv (cv x3) (cv f2))) (wb ph ps) $ >
  $ wi (wa (wcel A2 cfn) (wral x3 (wrex y1 ph B2) A2)) (wex f2 (wa (wf A2 B2 (cv f2)) (wral x3 ps A2))) $;

--| Trichotomy of dominance for finite sets. (Contributed by Jim Kingdon, 15-Sep-2021.)
theorem fientri3 (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wcel B2 cfn)) (wo (wbr A2 B2 cdom) (wbr B2 A2 cdom)) $;

--| A natural number is well-ordered by ` _E ` . More specifically, this order both satisfies ` We ` and is trichotomous. (Contributed by Jim Kingdon, 25-Sep-2021.)
theorem nnwetri {x3 y1: setvar} (A2: class):
  $ wi (wcel A2 com) (wa (wwe A2 cep) (wral x3 (wral y1 (w3o (wbr (cv x3) (cv y1) cep) (wceq (cv x3) (cv y1)) (wbr (cv y1) (cv x3) cep)) A2) A2)) $;

--| Generalize ~ ordiso to proper classes. (Contributed by Mario Carneiro, 24-Jun-2015.)
theorem ordiso2 (A2 B2 F: class):
  $ wi (w3a (wiso A2 B2 cep cep F) (word A2) (word B2)) (wceq A2 B2) $;

--| Order-isomorphic ordinal numbers are equal. (Contributed by Jeff Hankins, 16-Oct-2009.) (Proof shortened by Mario Carneiro, 24-Jun-2015.)
theorem ordiso {f2: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wb (wceq A2 B2) (wex f2 (wiso A2 B2 cep cep (cv f2)))) $;

--| Extend class definition to include the cardinal size function.
term ccrd: class;

--| Define the cardinal number function. The cardinal number of a set is the least ordinal number equinumerous to it. In other words, it is the "size" of the set. Definition of [Enderton] p. 197. Our notation is from Enderton. Other textbooks often use a double bar over the set to express this function. (Contributed by NM, 21-Oct-2003.)
axiom df_card {x3 y1: setvar}:
  $ wceq ccrd (cmpt x3 cvv (cint (crab y1 (wbr (cv y1) (cv x3) cen) con0))) $;

--| The cardinality of a well-orderable set is an ordinal. (Contributed by Jim Kingdon, 30-Aug-2021.)
theorem cardcl {y1: setvar} (A2: class):
  $ wi (wrex y1 (wbr (cv y1) A2 cen) con0) (wcel (cfv A2 ccrd) con0) $;

--| A set equinumerous to an ordinal is numerable. (Contributed by Mario Carneiro, 29-Apr-2015.)
theorem isnumi (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wbr A2 B2 cen)) (wcel B2 (cdm ccrd)) $;

--| Every finite set is numerable. (Contributed by Mario Carneiro, 4-Feb-2013.) (Revised by Mario Carneiro, 29-Apr-2015.)
theorem finnum (A2: class):
  $ wi (wcel A2 cfn) (wcel A2 (cdm ccrd)) $;

--| Every ordinal number is numerable. (Contributed by Mario Carneiro, 29-Apr-2015.)
theorem onenon (A2: class):
  $ wi (wcel A2 con0) (wcel A2 (cdm ccrd)) $;

--| The value of ` ( card `` A ) ` . (Contributed by Jim Kingdon, 30-Aug-2021.)
theorem cardval3ex {x3 y1: setvar} (A2: class):
  $ wi (wrex x3 (wbr (cv x3) A2 cen) con0) (wceq (cfv A2 ccrd) (cint (crab y1 (wbr (cv y1) A2 cen) con0))) $;

--| The value of the cardinal number function with an ordinal number as its argument. (Contributed by NM, 24-Nov-2003.) (Revised by Mario Carneiro, 13-Sep-2013.)
theorem oncardval {x3: setvar} (A2: class):
  $ wi (wcel A2 con0) (wceq (cfv A2 ccrd) (cint (crab x3 (wbr (cv x3) A2 cen) con0))) $;

--| The cardinal of an ordinal number is less than or equal to the ordinal number. Proposition 10.6(3) of [TakeutiZaring] p. 85. (Contributed by NM, 22-Oct-2003.)
theorem cardonle (A2: class):
  $ wi (wcel A2 con0) (wss (cfv A2 ccrd) A2) $;

--| The cardinality of the empty set is the empty set. (Contributed by NM, 25-Oct-2003.)
theorem card0:
  $ wceq (cfv c0 ccrd) c0 $;

--| If two numerable sets are equinumerous, then they have equal cardinalities. (Contributed by Jim Kingdon, 30-Aug-2021.)
theorem carden2bex {x3: setvar} (A2 B2: class):
  $ wi (wa (wbr A2 B2 cen) (wrex x3 (wbr (cv x3) A2 cen) con0)) (wceq (cfv A2 ccrd) (cfv B2 ccrd)) $;

--| The set of positive integers, which is the set of natural numbers ` _om ` with 0 removed. _Note: This is the start of the Dedekind-cut construction of real and_ _complex numbers.
term cnpi: class;

--| Positive integer addition.
term cpli: class;

--| Positive integer multiplication.
term cmi: class;

--| Positive integer ordering relation.
term clti: class;

--| Positive pre-fraction addition.
term cplpq: class;

--| Positive pre-fraction multiplication.
term cmpq: class;

--| Positive pre-fraction ordering relation.
term cltpq: class;

--| Equivalence class used to construct positive fractions.
term ceq: class;

--| Set of positive fractions.
term cnq: class;

--| The positive fraction constant 1.
term c1q: class;

--| Positive fraction addition.
term cplq: class;

--| Positive fraction multiplication.
term cmq: class;

--| Positive fraction reciprocal operation.
term crq: class;

--| Positive fraction ordering relation.
term cltq: class;

--| Equivalence class used to construct non-negative fractions.
term ceq0: class;

--| Set of non-negative fractions.
term cnq0: class;

--| The non-negative fraction constant 0.
term c0q0: class;

--| Non-negative fraction addition.
term cplq0: class;

--| Non-negative fraction multiplication.
term cmq0: class;

--| Set of positive reals.
term cnp: class;

--| Positive real constant 1.
term c1p: class;

--| Positive real addition.
term cpp: class;

--| Positive real multiplication.
term cmp: class;

--| Positive real ordering relation.
term cltp: class;

--| Equivalence class used to construct signed reals.
term cer: class;

--| Set of signed reals.
term cnr: class;

--| The signed real constant 0.
term c0r: class;

--| The signed real constant 1.
term c1r: class;

--| The signed real constant -1.
term cm1r: class;

--| Signed real addition.
term cplr: class;

--| Signed real multiplication.
term cmr: class;

--| Signed real ordering relation.
term cltr: class;

--| Define the class of positive integers. This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. (Contributed by NM, 15-Aug-1995.)
axiom df_ni:
  $ wceq cnpi (cdif com (csn c0)) $;

--| Define addition on positive integers. This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. (Contributed by NM, 26-Aug-1995.)
axiom df_pli:
  $ wceq cpli (cres coa (cxp cnpi cnpi)) $;

--| Define multiplication on positive integers. This is a "temporary" set used in the construction of complex numbers and is intended to be used only by the construction. (Contributed by NM, 26-Aug-1995.)
axiom df_mi:
  $ wceq cmi (cres comu (cxp cnpi cnpi)) $;

--| Define 'less than' on positive integers. This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. (Contributed by NM, 6-Feb-1996.)
axiom df_lti:
  $ wceq clti (cin cep (cxp cnpi cnpi)) $;

--| Membership in the class of positive integers. (Contributed by NM, 15-Aug-1995.)
theorem elni (A2: class):
  $ wb (wcel A2 cnpi) (wa (wcel A2 com) (wne A2 c0)) $;

--| A positive integer is a natural number. (Contributed by NM, 15-Aug-1995.)
theorem pinn (A2: class):
  $ wi (wcel A2 cnpi) (wcel A2 com) $;

--| A positive integer is an ordinal number. (Contributed by NM, 23-Mar-1996.)
theorem pion (A2: class):
  $ wi (wcel A2 cnpi) (wcel A2 con0) $;

--| A positive integer is ordinal. (Contributed by NM, 29-Jan-1996.)
theorem piord (A2: class):
  $ wi (wcel A2 cnpi) (word A2) $;

--| The class of positive integers is a set. (Contributed by NM, 15-Aug-1995.)
theorem niex:
  $ wcel cnpi cvv $;

--| The empty set is not a positive integer. (Contributed by NM, 26-Aug-1995.)
theorem _0npi:
  $ wn (wcel c0 cnpi) $;

--| Membership in the class of positive integers. (Contributed by NM, 27-Nov-1995.)
theorem elni2 (A2: class):
  $ wb (wcel A2 cnpi) (wa (wcel A2 com) (wcel c0 A2)) $;

--| Ordinal 'one' is a positive integer. (Contributed by NM, 29-Oct-1995.)
theorem _1pi:
  $ wcel c1o cnpi $;

--| Positive integer addition in terms of ordinal addition. (Contributed by NM, 27-Aug-1995.)
theorem addpiord (A2 B2: class):
  $ wi (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wceq (co A2 B2 cpli) (co A2 B2 coa)) $;

--| Positive integer multiplication in terms of ordinal multiplication. (Contributed by NM, 27-Aug-1995.)
theorem mulpiord (A2 B2: class):
  $ wi (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wceq (co A2 B2 cmi) (co A2 B2 comu)) $;

--| 1 is an identity element for multiplication on positive integers. (Contributed by NM, 4-Mar-1996.) (Revised by Mario Carneiro, 17-Nov-2014.)
theorem mulidpi (A2: class):
  $ wi (wcel A2 cnpi) (wceq (co A2 c1o cmi) A2) $;

--| Positive integer 'less than' in terms of ordinal membership. (Contributed by NM, 6-Feb-1996.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem ltpiord (A2 B2: class):
  $ wi (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wb (wbr A2 B2 clti) (wcel A2 B2)) $;

--| Positive integer 'less than' is a strict ordering. (Contributed by NM, 8-Feb-1996.) (Proof shortened by Mario Carneiro, 10-Jul-2014.)
theorem ltsopi:
  $ wor cnpi clti $;

--| Trichotomy for positive integers. (Contributed by Jim Kingdon, 21-Sep-2019.)
theorem pitric (A2 B2: class):
  $ wi (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wb (wbr A2 B2 clti) (wn (wo (wceq A2 B2) (wbr B2 A2 clti)))) $;

--| Trichotomy for positive integers. (Contributed by Jim Kingdon, 21-Sep-2019.)
theorem pitri3or (A2 B2: class):
  $ wi (wa (wcel A2 cnpi) (wcel B2 cnpi)) (w3o (wbr A2 B2 clti) (wceq A2 B2) (wbr B2 A2 clti)) $;

--| Less-than for positive integers is decidable. (Contributed by Jim Kingdon, 12-Dec-2019.)
theorem ltdcpi (A2 B2: class):
  $ wi (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wdc (wbr A2 B2 clti)) $;

--| Positive integer 'less than' is a relation on positive integers. (Contributed by NM, 8-Feb-1996.)
theorem ltrelpi:
  $ wss clti (cxp cnpi cnpi) $;

--| Domain of addition on positive integers. (Contributed by NM, 26-Aug-1995.)
theorem dmaddpi:
  $ wceq (cdm cpli) (cxp cnpi cnpi) $;

--| Domain of multiplication on positive integers. (Contributed by NM, 26-Aug-1995.)
theorem dmmulpi:
  $ wceq (cdm cmi) (cxp cnpi cnpi) $;

--| Closure of addition of positive integers. (Contributed by NM, 18-Oct-1995.)
theorem addclpi (A2 B2: class):
  $ wi (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wcel (co A2 B2 cpli) cnpi) $;

--| Closure of multiplication of positive integers. (Contributed by NM, 18-Oct-1995.)
theorem mulclpi (A2 B2: class):
  $ wi (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wcel (co A2 B2 cmi) cnpi) $;

--| Addition of positive integers is commutative. (Contributed by Jim Kingdon, 26-Aug-2019.)
theorem addcompig (A2 B2: class):
  $ wi (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wceq (co A2 B2 cpli) (co B2 A2 cpli)) $;

--| Addition of positive integers is associative. (Contributed by Jim Kingdon, 26-Aug-2019.)
theorem addasspig (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnpi) (wcel B2 cnpi) (wcel C cnpi)) (wceq (co (co A2 B2 cpli) C cpli) (co A2 (co B2 C cpli) cpli)) $;

--| Multiplication of positive integers is commutative. (Contributed by Jim Kingdon, 26-Aug-2019.)
theorem mulcompig (A2 B2: class):
  $ wi (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wceq (co A2 B2 cmi) (co B2 A2 cmi)) $;

--| Multiplication of positive integers is associative. (Contributed by Jim Kingdon, 26-Aug-2019.)
theorem mulasspig (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnpi) (wcel B2 cnpi) (wcel C cnpi)) (wceq (co (co A2 B2 cmi) C cmi) (co A2 (co B2 C cmi) cmi)) $;

--| Multiplication of positive integers is distributive. (Contributed by Jim Kingdon, 26-Aug-2019.)
theorem distrpig (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnpi) (wcel B2 cnpi) (wcel C cnpi)) (wceq (co A2 (co B2 C cpli) cmi) (co (co A2 B2 cmi) (co A2 C cmi) cpli)) $;

--| Addition cancellation law for positive integers. (Contributed by Jim Kingdon, 27-Aug-2019.)
theorem addcanpig (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnpi) (wcel B2 cnpi) (wcel C cnpi)) (wb (wceq (co A2 B2 cpli) (co A2 C cpli)) (wceq B2 C)) $;

--| Multiplication cancellation law for positive integers. (Contributed by Jim Kingdon, 29-Aug-2019.)
theorem mulcanpig (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnpi) (wcel B2 cnpi) (wcel C cnpi)) (wb (wceq (co A2 B2 cmi) (co A2 C cmi)) (wceq B2 C)) $;

--| There is no identity element for addition on positive integers. (Contributed by NM, 28-Nov-1995.)
theorem addnidpig (A2 B2: class):
  $ wi (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wn (wceq (co A2 B2 cpli) A2)) $;

--| Ordering on positive integers in terms of existence of sum. (Contributed by NM, 15-Mar-1996.) (Revised by Mario Carneiro, 14-Jun-2013.)
theorem ltexpi {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wb (wbr A2 B2 clti) (wrex x3 (wceq (co A2 (cv x3) cpli) B2) cnpi)) $;

--| Ordering property of addition for positive integers. (Contributed by Jim Kingdon, 31-Aug-2019.)
theorem ltapig (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnpi) (wcel B2 cnpi) (wcel C cnpi)) (wb (wbr A2 B2 clti) (wbr (co C A2 cpli) (co C B2 cpli) clti)) $;

--| Ordering property of multiplication for positive integers. (Contributed by Jim Kingdon, 31-Aug-2019.)
theorem ltmpig (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnpi) (wcel B2 cnpi) (wcel C cnpi)) (wb (wbr A2 B2 clti) (wbr (co C A2 cmi) (co C B2 cmi) clti)) $;

--| One is less than two (one plus one). (Contributed by NM, 13-Mar-1996.)
theorem _1lt2pi:
  $ wbr c1o (co c1o c1o cpli) clti $;

--| No positive integer is less than one. (Contributed by Jim Kingdon, 31-Aug-2019.)
theorem nlt1pig (A2: class):
  $ wi (wcel A2 cnpi) (wn (wbr A2 c1o clti)) $;

--| Principle of Finite Induction on positive integers. (Contributed by NM, 23-Mar-1996.)
theorem indpi {x3 y1: setvar} (ph: wff x3) (ps ch th ta: wff y1) (A2: class y1):
  $ wi (wceq (cv x3) c1o) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (co (cv y1) c1o cpli)) (wb ph th) $ >
  $ wi (wceq (cv x3) A2) (wb ph ta) $ >
  $ ps $ >
  $ wi (wcel (cv y1) cnpi) (wi ch th) $ >
  $ wi (wcel A2 cnpi) ta $;

--| A natural number plus a positive integer is a positive integer. (Contributed by Jim Kingdon, 10-Nov-2019.)
theorem nnppipi (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 cnpi)) (wcel (co A2 B2 coa) cnpi) $;

--| Define pre-addition on positive fractions. This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. This "pre-addition" operation works directly with ordered pairs of integers. The actual positive fraction addition ` +Q ` ( ~ df-plqqs ) works with the equivalence classes of these ordered pairs determined by the equivalence relation ` ~Q ` ( ~ df-enq ). (Analogous remarks apply to the other "pre-" operations in the complex number construction that follows.) From Proposition 9-2.3 of [Gleason] p. 117. (Contributed by NM, 28-Aug-1995.)
axiom df_plpq {x3 y1: setvar}:
  $ wceq cplpq (cmpt2 x3 y1 (cxp cnpi cnpi) (cxp cnpi cnpi) (cop (co (co (cfv (cv x3) c1st) (cfv (cv y1) c2nd) cmi) (co (cfv (cv y1) c1st) (cfv (cv x3) c2nd) cmi) cpli) (co (cfv (cv x3) c2nd) (cfv (cv y1) c2nd) cmi))) $;

--| Define pre-multiplication on positive fractions. This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. From Proposition 9-2.4 of [Gleason] p. 119. (Contributed by NM, 28-Aug-1995.)
axiom df_mpq {x3 y1: setvar}:
  $ wceq cmpq (cmpt2 x3 y1 (cxp cnpi cnpi) (cxp cnpi cnpi) (cop (co (cfv (cv x3) c1st) (cfv (cv y1) c1st) cmi) (co (cfv (cv x3) c2nd) (cfv (cv y1) c2nd) cmi))) $;

--| Define pre-ordering relation on positive fractions. This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. Similar to Definition 5 of [Suppes] p. 162. (Contributed by NM, 28-Aug-1995.)
axiom df_ltpq {x3 y1: setvar}:
  $ wceq cltpq (copab x3 y1 (wa (wa (wcel (cv x3) (cxp cnpi cnpi)) (wcel (cv y1) (cxp cnpi cnpi))) (wbr (co (cfv (cv x3) c1st) (cfv (cv y1) c2nd) cmi) (co (cfv (cv y1) c1st) (cfv (cv x3) c2nd) cmi) clti))) $;

--| Define equivalence relation for positive fractions. This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. From Proposition 9-2.1 of [Gleason] p. 117. (Contributed by NM, 27-Aug-1995.)
axiom df_enq {x3 y1 z w v u: setvar}:
  $ wceq ceq (copab x3 y1 (wa (wa (wcel (cv x3) (cxp cnpi cnpi)) (wcel (cv y1) (cxp cnpi cnpi))) (wex z (wex w (wex v (wex u (wa (wa (wceq (cv x3) (cop (cv z) (cv w))) (wceq (cv y1) (cop (cv v) (cv u)))) (wceq (co (cv z) (cv u) cmi) (co (cv w) (cv v) cmi))))))))) $;

--| Define class of positive fractions. This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. From Proposition 9-2.2 of [Gleason] p. 117. (Contributed by NM, 16-Aug-1995.)
axiom df_nqqs:
  $ wceq cnq (cqs (cxp cnpi cnpi) ceq) $;

--| Define addition on positive fractions. This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. From Proposition 9-2.3 of [Gleason] p. 117. (Contributed by NM, 24-Aug-1995.)
axiom df_plqqs {x3 y1 z w v u f2: setvar}:
  $ wceq cplq (coprab x3 y1 z (wa (wa (wcel (cv x3) cnq) (wcel (cv y1) cnq)) (wex w (wex v (wex u (wex f2 (wa (wa (wceq (cv x3) (cec (cop (cv w) (cv v)) ceq)) (wceq (cv y1) (cec (cop (cv u) (cv f2)) ceq))) (wceq (cv z) (cec (co (cop (cv w) (cv v)) (cop (cv u) (cv f2)) cplpq) ceq))))))))) $;

--| Define multiplication on positive fractions. This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. From Proposition 9-2.4 of [Gleason] p. 119. (Contributed by NM, 24-Aug-1995.)
axiom df_mqqs {x3 y1 z w v u f2: setvar}:
  $ wceq cmq (coprab x3 y1 z (wa (wa (wcel (cv x3) cnq) (wcel (cv y1) cnq)) (wex w (wex v (wex u (wex f2 (wa (wa (wceq (cv x3) (cec (cop (cv w) (cv v)) ceq)) (wceq (cv y1) (cec (cop (cv u) (cv f2)) ceq))) (wceq (cv z) (cec (co (cop (cv w) (cv v)) (cop (cv u) (cv f2)) cmpq) ceq))))))))) $;

--| Define positive fraction constant 1. This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. From Proposition 9-2.2 of [Gleason] p. 117. (Contributed by NM, 29-Oct-1995.)
axiom df_1nqqs:
  $ wceq c1q (cec (cop c1o c1o) ceq) $;

--| Define reciprocal on positive fractions. It means the same thing as one divided by the argument (although we don't define full division since we will never need it). This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. From Proposition 9-2.5 of [Gleason] p. 119, who uses an asterisk to denote this unary operation. (Contributed by Jim Kingdon, 20-Sep-2019.)
axiom df_rq {x3 y1: setvar}:
  $ wceq crq (copab x3 y1 (w3a (wcel (cv x3) cnq) (wcel (cv y1) cnq) (wceq (co (cv x3) (cv y1) cmq) c1q))) $;

--| Define ordering relation on positive fractions. This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. Similar to Definition 5 of [Suppes] p. 162. (Contributed by NM, 13-Feb-1996.)
axiom df_ltnqqs {x3 y1 z w v u: setvar}:
  $ wceq cltq (copab x3 y1 (wa (wa (wcel (cv x3) cnq) (wcel (cv y1) cnq)) (wex z (wex w (wex v (wex u (wa (wa (wceq (cv x3) (cec (cop (cv z) (cv w)) ceq)) (wceq (cv y1) (cec (cop (cv v) (cv u)) ceq))) (wbr (co (cv z) (cv u) cmi) (co (cv w) (cv v) cmi) clti)))))))) $;

--| Alternative definition of pre-addition on positive fractions. (Contributed by Jim Kingdon, 12-Sep-2019.)
theorem dfplpq2 {x3 y1 z w v u f2: setvar}:
  $ wceq cplpq (coprab x3 y1 z (wa (wa (wcel (cv x3) (cxp cnpi cnpi)) (wcel (cv y1) (cxp cnpi cnpi))) (wex w (wex v (wex u (wex f2 (wa (wa (wceq (cv x3) (cop (cv w) (cv v))) (wceq (cv y1) (cop (cv u) (cv f2)))) (wceq (cv z) (cop (co (co (cv w) (cv f2) cmi) (co (cv v) (cv u) cmi) cpli) (co (cv v) (cv f2) cmi)))))))))) $;

--| Alternative definition of pre-multiplication on positive fractions. (Contributed by Jim Kingdon, 13-Sep-2019.)
theorem dfmpq2 {x3 y1 z w v u f2: setvar}:
  $ wceq cmpq (coprab x3 y1 z (wa (wa (wcel (cv x3) (cxp cnpi cnpi)) (wcel (cv y1) (cxp cnpi cnpi))) (wex w (wex v (wex u (wex f2 (wa (wa (wceq (cv x3) (cop (cv w) (cv v))) (wceq (cv y1) (cop (cv u) (cv f2)))) (wceq (cv z) (cop (co (cv w) (cv u) cmi) (co (cv v) (cv f2) cmi)))))))))) $;

--| Equivalence relation for positive fractions in terms of positive integers. (Contributed by NM, 27-Aug-1995.)
theorem enqbreq (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wa (wcel C cnpi) (wcel D cnpi))) (wb (wbr (cop A2 B2) (cop C D) ceq) (wceq (co A2 D cmi) (co B2 C cmi))) $;

--| Equivalence relation for positive fractions in terms of positive integers. (Contributed by Mario Carneiro, 8-May-2013.)
theorem enqbreq2 (A2 B2: class):
  $ wi (wa (wcel A2 (cxp cnpi cnpi)) (wcel B2 (cxp cnpi cnpi))) (wb (wbr A2 B2 ceq) (wceq (co (cfv A2 c1st) (cfv B2 c2nd) cmi) (co (cfv B2 c1st) (cfv A2 c2nd) cmi))) $;

--| The equivalence relation for positive fractions is an equivalence relation. Proposition 9-2.1 of [Gleason] p. 117. (Contributed by NM, 27-Aug-1995.) (Revised by Mario Carneiro, 6-Jul-2015.)
theorem enqer:
  $ wer (cxp cnpi cnpi) ceq $;

--| Equivalence class equality of positive fractions in terms of positive integers. (Contributed by NM, 29-Nov-1995.)
theorem enqeceq (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wa (wcel C cnpi) (wcel D cnpi))) (wb (wceq (cec (cop A2 B2) ceq) (cec (cop C D) ceq)) (wceq (co A2 D cmi) (co B2 C cmi))) $;

--| The equivalence relation for positive fractions exists. (Contributed by NM, 3-Sep-1995.)
theorem enqex:
  $ wcel ceq cvv $;

--| The equivalence relation for positive fractions is decidable. (Contributed by Jim Kingdon, 7-Sep-2019.)
theorem enqdc (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wa (wcel C cnpi) (wcel D cnpi))) (wdc (wbr (cop A2 B2) (cop C D) ceq)) $;

--| The equivalence relation for positive fractions is decidable. (Contributed by Jim Kingdon, 7-Sep-2019.)
theorem enqdc1 (A2 B2 C: class):
  $ wi (wa (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wcel C (cxp cnpi cnpi))) (wdc (wbr (cop A2 B2) C ceq)) $;

--| The class of positive fractions exists. (Contributed by NM, 16-Aug-1995.) (Revised by Mario Carneiro, 27-Apr-2013.)
theorem nqex:
  $ wcel cnq cvv $;

--| The empty set is not a positive fraction. (Contributed by NM, 24-Aug-1995.) (Revised by Mario Carneiro, 27-Apr-2013.)
theorem _0nnq:
  $ wn (wcel c0 cnq) $;

--| Positive fraction 'less than' is a relation on positive fractions. (Contributed by NM, 14-Feb-1996.) (Revised by Mario Carneiro, 27-Apr-2013.)
theorem ltrelnq:
  $ wss cltq (cxp cnq cnq) $;

--| The positive fraction 'one'. (Contributed by NM, 29-Oct-1995.)
theorem _1nq:
  $ wcel c1q cnq $;

--| Lemma showing compatibility of addition. (Contributed by NM, 27-Aug-1995.)
theorem addcmpblnq (A2 B2 C D R S F G: class):
  $ wi (wa (wa (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wa (wcel C cnpi) (wcel D cnpi))) (wa (wa (wcel F cnpi) (wcel G cnpi)) (wa (wcel R cnpi) (wcel S cnpi)))) (wi (wa (wceq (co A2 D cmi) (co B2 C cmi)) (wceq (co F S cmi) (co G R cmi))) (wbr (cop (co (co A2 G cmi) (co B2 F cmi) cpli) (co B2 G cmi)) (cop (co (co C S cmi) (co D R cmi) cpli) (co D S cmi)) ceq)) $;

--| Lemma showing compatibility of multiplication. (Contributed by NM, 27-Aug-1995.)
theorem mulcmpblnq (A2 B2 C D R S F G: class):
  $ wi (wa (wa (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wa (wcel C cnpi) (wcel D cnpi))) (wa (wa (wcel F cnpi) (wcel G cnpi)) (wa (wcel R cnpi) (wcel S cnpi)))) (wi (wa (wceq (co A2 D cmi) (co B2 C cmi)) (wceq (co F S cmi) (co G R cmi))) (wbr (cop (co A2 F cmi) (co B2 G cmi)) (cop (co C R cmi) (co D S cmi)) ceq)) $;

--| Lemma for ~ addpipqqs . (Contributed by Jim Kingdon, 11-Sep-2019.)
theorem addpipqqslem (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wa (wcel C cnpi) (wcel D cnpi))) (wcel (cop (co (co A2 D cmi) (co B2 C cmi) cpli) (co B2 D cmi)) (cxp cnpi cnpi)) $;

--| Addition of positive fractions in terms of positive integers. (Contributed by NM, 28-Aug-1995.)
theorem addpipqqs (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wa (wcel C cnpi) (wcel D cnpi))) (wceq (co (cec (cop A2 B2) ceq) (cec (cop C D) ceq) cplq) (cec (cop (co (co A2 D cmi) (co B2 C cmi) cpli) (co B2 D cmi)) ceq)) $;

--| Multiplication of positive fractions in terms of positive integers. (Contributed by Mario Carneiro, 8-May-2013.)
theorem mulpipq2 (A2 B2: class):
  $ wi (wa (wcel A2 (cxp cnpi cnpi)) (wcel B2 (cxp cnpi cnpi))) (wceq (co A2 B2 cmpq) (cop (co (cfv A2 c1st) (cfv B2 c1st) cmi) (co (cfv A2 c2nd) (cfv B2 c2nd) cmi))) $;

--| Multiplication of positive fractions in terms of positive integers. (Contributed by NM, 28-Aug-1995.) (Revised by Mario Carneiro, 8-May-2013.)
theorem mulpipq (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wa (wcel C cnpi) (wcel D cnpi))) (wceq (co (cop A2 B2) (cop C D) cmpq) (cop (co A2 C cmi) (co B2 D cmi))) $;

--| Multiplication of positive fractions in terms of positive integers. (Contributed by NM, 28-Aug-1995.)
theorem mulpipqqs (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wa (wcel C cnpi) (wcel D cnpi))) (wceq (co (cec (cop A2 B2) ceq) (cec (cop C D) ceq) cmq) (cec (cop (co A2 C cmi) (co B2 D cmi)) ceq)) $;

--| Ordering of positive fractions in terms of positive integers. (Contributed by Jim Kingdon, 14-Sep-2019.)
theorem ordpipqqs (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wa (wcel C cnpi) (wcel D cnpi))) (wb (wbr (cec (cop A2 B2) ceq) (cec (cop C D) ceq) cltq) (wbr (co A2 D cmi) (co B2 C cmi) clti)) $;

--| Closure of addition on positive fractions. (Contributed by NM, 29-Aug-1995.)
theorem addclnq (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wcel (co A2 B2 cplq) cnq) $;

--| Closure of multiplication on positive fractions. (Contributed by NM, 29-Aug-1995.)
theorem mulclnq (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wcel (co A2 B2 cmq) cnq) $;

--| Decomposition of a positive fraction into numerator and denominator. Lemma for ~ dmaddpq . (Contributed by Jim Kingdon, 15-Sep-2019.)
theorem dmaddpqlem {w v: setvar} (x3: setvar):
  $ wi (wcel (cv x3) cnq) (wex w (wex v (wceq (cv x3) (cec (cop (cv w) (cv v)) ceq)))) $;

--| Decomposition of a positive fraction into numerator and denominator. Similar to ~ dmaddpqlem but also shows that the numerator and denominator are positive integers. (Contributed by Jim Kingdon, 20-Sep-2019.)
theorem nqpi {w v: setvar} (A2: class):
  $ wi (wcel A2 cnq) (wex w (wex v (wa (wa (wcel (cv w) cnpi) (wcel (cv v) cnpi)) (wceq A2 (cec (cop (cv w) (cv v)) ceq))))) $;

--| Domain of addition on positive fractions. (Contributed by NM, 24-Aug-1995.)
theorem dmaddpq:
  $ wceq (cdm cplq) (cxp cnq cnq) $;

--| Domain of multiplication on positive fractions. (Contributed by NM, 24-Aug-1995.)
theorem dmmulpq:
  $ wceq (cdm cmq) (cxp cnq cnq) $;

--| Addition of positive fractions is commutative. (Contributed by Jim Kingdon, 15-Sep-2019.)
theorem addcomnqg (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wceq (co A2 B2 cplq) (co B2 A2 cplq)) $;

--| Addition of positive fractions is associative. (Contributed by Jim Kingdon, 16-Sep-2019.)
theorem addassnqg (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnq) (wcel B2 cnq) (wcel C cnq)) (wceq (co (co A2 B2 cplq) C cplq) (co A2 (co B2 C cplq) cplq)) $;

--| Multiplication of positive fractions is commutative. (Contributed by Jim Kingdon, 17-Sep-2019.)
theorem mulcomnqg (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wceq (co A2 B2 cmq) (co B2 A2 cmq)) $;

--| Multiplication of positive fractions is associative. (Contributed by Jim Kingdon, 17-Sep-2019.)
theorem mulassnqg (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnq) (wcel B2 cnq) (wcel C cnq)) (wceq (co (co A2 B2 cmq) C cmq) (co A2 (co B2 C cmq) cmq)) $;

--| Lemma for distributive law: cancellation of common factor. (Contributed by NM, 2-Sep-1995.) (Revised by Mario Carneiro, 8-May-2013.)
theorem mulcanenq (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnpi) (wcel B2 cnpi) (wcel C cnpi)) (wbr (cop (co A2 B2 cmi) (co A2 C cmi)) (cop B2 C) ceq) $;

--| Lemma for distributive law: cancellation of common factor. (Contributed by Jim Kingdon, 17-Sep-2019.)
theorem mulcanenqec (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnpi) (wcel B2 cnpi) (wcel C cnpi)) (wceq (cec (cop (co A2 B2 cmi) (co A2 C cmi)) ceq) (cec (cop B2 C) ceq)) $;

--| Multiplication of positive fractions is distributive. (Contributed by Jim Kingdon, 17-Sep-2019.)
theorem distrnqg (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnq) (wcel B2 cnq) (wcel C cnq)) (wceq (co A2 (co B2 C cplq) cmq) (co (co A2 B2 cmq) (co A2 C cmq) cplq)) $;

--| The equivalence class of ratio 1. (Contributed by NM, 4-Mar-1996.)
theorem _1qec (A2: class):
  $ wi (wcel A2 cnpi) (wceq c1q (cec (cop A2 A2) ceq)) $;

--| Multiplication identity element for positive fractions. (Contributed by NM, 3-Mar-1996.)
theorem mulidnq (A2: class):
  $ wi (wcel A2 cnq) (wceq (co A2 c1q cmq) A2) $;

--| Existence of positive fraction reciprocal. (Contributed by Jim Kingdon, 20-Sep-2019.)
theorem recexnq {y1: setvar} (A2: class):
  $ wi (wcel A2 cnq) (wex y1 (wa (wcel (cv y1) cnq) (wceq (co A2 (cv y1) cmq) c1q))) $;

--| Relationship between reciprocal and multiplication on positive fractions. (Contributed by Jim Kingdon, 19-Sep-2019.)
theorem recmulnqg (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wb (wceq (cfv A2 crq) B2) (wceq (co A2 B2 cmq) c1q)) $;

--| Closure law for positive fraction reciprocal. (Contributed by NM, 6-Mar-1996.) (Revised by Mario Carneiro, 8-May-2013.)
theorem recclnq (A2: class):
  $ wi (wcel A2 cnq) (wcel (cfv A2 crq) cnq) $;

--| A positive fraction times its reciprocal is 1. (Contributed by NM, 6-Mar-1996.) (Revised by Mario Carneiro, 8-May-2013.)
theorem recidnq (A2: class):
  $ wi (wcel A2 cnq) (wceq (co A2 (cfv A2 crq) cmq) c1q) $;

--| Reciprocal of reciprocal of positive fraction. (Contributed by NM, 26-Apr-1996.) (Revised by Mario Carneiro, 29-Apr-2013.)
theorem recrecnq (A2: class):
  $ wi (wcel A2 cnq) (wceq (cfv (cfv A2 crq) crq) A2) $;

--| Reciprocal of positive fraction one. (Contributed by Jim Kingdon, 29-Dec-2019.)
theorem rec1nq:
  $ wceq (cfv c1q crq) c1q $;

--| Trichotomy for positive fractions. (Contributed by Jim Kingdon, 21-Sep-2019.)
theorem nqtri3or (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (w3o (wbr A2 B2 cltq) (wceq A2 B2) (wbr B2 A2 cltq)) $;

--| Less-than for positive fractions is decidable. (Contributed by Jim Kingdon, 12-Dec-2019.)
theorem ltdcnq (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wdc (wbr A2 B2 cltq)) $;

--| 'Less than' is a strict ordering on positive fractions. (Contributed by NM, 19-Feb-1996.) (Revised by Mario Carneiro, 4-May-2013.)
theorem ltsonq:
  $ wor cnq cltq $;

--| Trichotomy for positive fractions. (Contributed by Jim Kingdon, 21-Sep-2019.)
theorem nqtric (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wb (wbr A2 B2 cltq) (wn (wo (wceq A2 B2) (wbr B2 A2 cltq)))) $;

--| Ordering property of addition for positive fractions. Proposition 9-2.6(ii) of [Gleason] p. 120. (Contributed by Jim Kingdon, 22-Sep-2019.)
theorem ltanqg (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnq) (wcel B2 cnq) (wcel C cnq)) (wb (wbr A2 B2 cltq) (wbr (co C A2 cplq) (co C B2 cplq) cltq)) $;

--| Ordering property of multiplication for positive fractions. Proposition 9-2.6(iii) of [Gleason] p. 120. (Contributed by Jim Kingdon, 22-Sep-2019.)
theorem ltmnqg (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnq) (wcel B2 cnq) (wcel C cnq)) (wb (wbr A2 B2 cltq) (wbr (co C A2 cmq) (co C B2 cmq) cltq)) $;

--| Ordering property of addition for positive fractions. One direction of ~ ltanqg . (Contributed by Jim Kingdon, 9-Dec-2019.)
theorem ltanqi (A2 B2 C: class):
  $ wi (wa (wbr A2 B2 cltq) (wcel C cnq)) (wbr (co C A2 cplq) (co C B2 cplq) cltq) $;

--| Ordering property of multiplication for positive fractions. One direction of ~ ltmnqg . (Contributed by Jim Kingdon, 9-Dec-2019.)
theorem ltmnqi (A2 B2 C: class):
  $ wi (wa (wbr A2 B2 cltq) (wcel C cnq)) (wbr (co C A2 cmq) (co C B2 cmq) cltq) $;

--| Ordering property of addition for positive fractions. (Contributed by Jim Kingdon, 7-Dec-2019.)
theorem lt2addnq (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cnq) (wcel B2 cnq)) (wa (wcel C cnq) (wcel D cnq))) (wi (wa (wbr A2 B2 cltq) (wbr C D cltq)) (wbr (co A2 C cplq) (co B2 D cplq) cltq)) $;

--| Ordering property of multiplication for positive fractions. (Contributed by Jim Kingdon, 18-Jul-2021.)
theorem lt2mulnq (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cnq) (wcel B2 cnq)) (wa (wcel C cnq) (wcel D cnq))) (wi (wa (wbr A2 B2 cltq) (wbr C D cltq)) (wbr (co A2 C cmq) (co B2 D cmq) cltq)) $;

--| One is less than two (one plus one). (Contributed by NM, 13-Mar-1996.) (Revised by Mario Carneiro, 10-May-2013.)
theorem _1lt2nq:
  $ wbr c1q (co c1q c1q cplq) cltq $;

--| The sum of two fractions is greater than one of them. (Contributed by NM, 14-Mar-1996.) (Revised by Mario Carneiro, 10-May-2013.)
theorem ltaddnq (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wbr A2 (co A2 B2 cplq) cltq) $;

--| Ordering on positive fractions in terms of existence of sum. Definition in Proposition 9-2.6 of [Gleason] p. 119. (Contributed by Jim Kingdon, 23-Sep-2019.)
theorem ltexnqq {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wb (wbr A2 B2 cltq) (wrex x3 (wceq (co A2 (cv x3) cplq) B2) cnq)) $;

--| Ordering on positive fractions in terms of existence of sum. (Contributed by Jim Kingdon, 30-Apr-2020.)
theorem ltexnqi {x3: setvar} (A2 B2: class):
  $ wi (wbr A2 B2 cltq) (wrex x3 (wceq (co A2 (cv x3) cplq) B2) cnq) $;

--| One-half of any positive fraction is a fraction. (Contributed by Jim Kingdon, 23-Sep-2019.)
theorem halfnqq {x3: setvar} (A2: class):
  $ wi (wcel A2 cnq) (wrex x3 (wceq (co (cv x3) (cv x3) cplq) A2) cnq) $;

--| One-half of any positive fraction exists. Lemma for Proposition 9-2.6(i) of [Gleason] p. 120. (Contributed by NM, 16-Mar-1996.) (Revised by Mario Carneiro, 10-May-2013.)
theorem halfnq {x3: setvar} (A2: class):
  $ wi (wcel A2 cnq) (wex x3 (wceq (co (cv x3) (cv x3) cplq) A2)) $;

--| There is no smallest positive fraction. (Contributed by Jim Kingdon, 24-Sep-2019.)
theorem nsmallnqq {x3: setvar} (A2: class):
  $ wi (wcel A2 cnq) (wrex x3 (wbr (cv x3) A2 cltq) cnq) $;

--| There is no smallest positive fraction. (Contributed by NM, 26-Apr-1996.) (Revised by Mario Carneiro, 10-May-2013.)
theorem nsmallnq {x3: setvar} (A2: class):
  $ wi (wcel A2 cnq) (wex x3 (wbr (cv x3) A2 cltq)) $;

--| There is a number which is less than half of any positive fraction. The case where ` A ` is one is Lemma 11.4 of [BauerTaylor], p. 50, and they use the word "approximate half" for such a number (since there may be constructions, for some structures other than the rationals themselves, which rely on such an approximate half but do not require division by two as seen at ~ halfnqq ). (Contributed by Jim Kingdon, 25-Nov-2019.)
theorem subhalfnqq {x3: setvar} (A2: class):
  $ wi (wcel A2 cnq) (wrex x3 (wbr (co (cv x3) (cv x3) cplq) A2 cltq) cnq) $;

--| There exists a number between any two positive fractions. Proposition 9-2.6(i) of [Gleason] p. 120. (Contributed by Jim Kingdon, 24-Sep-2019.)
theorem ltbtwnnqq {x3: setvar} (A2 B2: class):
  $ wb (wbr A2 B2 cltq) (wrex x3 (wa (wbr A2 (cv x3) cltq) (wbr (cv x3) B2 cltq)) cnq) $;

--| There exists a number between any two positive fractions. Proposition 9-2.6(i) of [Gleason] p. 120. (Contributed by NM, 17-Mar-1996.) (Revised by Mario Carneiro, 10-May-2013.)
theorem ltbtwnnq {x3: setvar} (A2 B2: class):
  $ wb (wbr A2 B2 cltq) (wex x3 (wa (wbr A2 (cv x3) cltq) (wbr (cv x3) B2 cltq))) $;

--| For any fraction, there is an integer that is greater than it. This is also known as the "archimedean property". (Contributed by Jim Kingdon, 1-Dec-2019.)
theorem archnqq {x3: setvar} (A2: class):
  $ wi (wcel A2 cnq) (wrex x3 (wbr A2 (cec (cop (cv x3) c1o) ceq) cltq) cnpi) $;

--| A version of the Archimedean property. This variation is "stronger" than ~ archnqq in the sense that we provide an integer which is larger than a given rational ` A ` even after being multiplied by a second rational ` B ` . (Contributed by Jim Kingdon, 30-Nov-2019.)
theorem prarloclemarch {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wrex x3 (wbr A2 (co (cec (cop (cv x3) c1o) ceq) B2 cmq) cltq) cnpi) $;

--| Like ~ prarloclemarch but the integer must be at least two, and there is also ` B ` added to the right hand side. These details follow straightforwardly but are chosen to be helpful in the proof of ~ prarloc . (Contributed by Jim Kingdon, 25-Nov-2019.)
theorem prarloclemarch2 {x3: setvar} (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnq) (wcel B2 cnq) (wcel C cnq)) (wrex x3 (wa (wbr c1o (cv x3) clti) (wbr A2 (co B2 (co (cec (cop (cv x3) c1o) ceq) C cmq) cplq) cltq)) cnpi) $;

--| Ordering property of reciprocal for positive fractions. For a simplified version of the forward implication, see ~ ltrnqi . (Contributed by Jim Kingdon, 29-Dec-2019.)
theorem ltrnqg (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wb (wbr A2 B2 cltq) (wbr (cfv B2 crq) (cfv A2 crq) cltq)) $;

--| Ordering property of reciprocal for positive fractions. For the converse, see ~ ltrnqg . (Contributed by Jim Kingdon, 24-Sep-2019.)
theorem ltrnqi (A2 B2: class):
  $ wi (wbr A2 B2 cltq) (wbr (cfv B2 crq) (cfv A2 crq) cltq) $;

--| The canonical embedding of positive integers into positive fractions. (Contributed by Jim Kingdon, 26-Apr-2020.)
theorem nnnq (A2: class):
  $ wi (wcel A2 cnpi) (wcel (cec (cop A2 c1o) ceq) cnq) $;

--| Ordering of positive integers via ` <N ` or ` <Q ` is equivalent. (Contributed by Jim Kingdon, 3-Oct-2020.)
theorem ltnnnq (A2 B2: class):
  $ wi (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wb (wbr A2 B2 clti) (wbr (cec (cop A2 c1o) ceq) (cec (cop B2 c1o) ceq) cltq)) $;

--| Define equivalence relation for non-negative fractions. This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. (Contributed by Jim Kingdon, 2-Nov-2019.)
axiom df_enq0 {x3 y1 z w v u: setvar}:
  $ wceq ceq0 (copab x3 y1 (wa (wa (wcel (cv x3) (cxp com cnpi)) (wcel (cv y1) (cxp com cnpi))) (wex z (wex w (wex v (wex u (wa (wa (wceq (cv x3) (cop (cv z) (cv w))) (wceq (cv y1) (cop (cv v) (cv u)))) (wceq (co (cv z) (cv u) comu) (co (cv w) (cv v) comu))))))))) $;

--| Define class of non-negative fractions. This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. (Contributed by Jim Kingdon, 2-Nov-2019.)
axiom df_nq0:
  $ wceq cnq0 (cqs (cxp com cnpi) ceq0) $;

--| Define non-negative fraction constant 0. This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. (Contributed by Jim Kingdon, 5-Nov-2019.)
axiom df_0nq0:
  $ wceq c0q0 (cec (cop c0 c1o) ceq0) $;

--| Define addition on non-negative fractions. This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. (Contributed by Jim Kingdon, 2-Nov-2019.)
axiom df_plq0 {x3 y1 z w v u f2: setvar}:
  $ wceq cplq0 (coprab x3 y1 z (wa (wa (wcel (cv x3) cnq0) (wcel (cv y1) cnq0)) (wex w (wex v (wex u (wex f2 (wa (wa (wceq (cv x3) (cec (cop (cv w) (cv v)) ceq0)) (wceq (cv y1) (cec (cop (cv u) (cv f2)) ceq0))) (wceq (cv z) (cec (cop (co (co (cv w) (cv f2) comu) (co (cv v) (cv u) comu) coa) (co (cv v) (cv f2) comu)) ceq0))))))))) $;

--| Define multiplication on non-negative fractions. This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. (Contributed by Jim Kingdon, 2-Nov-2019.)
axiom df_mq0 {x3 y1 z w v u f2: setvar}:
  $ wceq cmq0 (coprab x3 y1 z (wa (wa (wcel (cv x3) cnq0) (wcel (cv y1) cnq0)) (wex w (wex v (wex u (wex f2 (wa (wa (wceq (cv x3) (cec (cop (cv w) (cv v)) ceq0)) (wceq (cv y1) (cec (cop (cv u) (cv f2)) ceq0))) (wceq (cv z) (cec (cop (co (cv w) (cv u) comu) (co (cv v) (cv f2) comu)) ceq0))))))))) $;

--| Multiplication on non-negative fractions. This definition is similar to ~ df-mq0 but expands ` Q0. ` (Contributed by Jim Kingdon, 22-Nov-2019.)
theorem dfmq0qs {x3 y1 z w v u f2: setvar}:
  $ wceq cmq0 (coprab x3 y1 z (wa (wa (wcel (cv x3) (cqs (cxp com cnpi) ceq0)) (wcel (cv y1) (cqs (cxp com cnpi) ceq0))) (wex w (wex v (wex u (wex f2 (wa (wa (wceq (cv x3) (cec (cop (cv w) (cv v)) ceq0)) (wceq (cv y1) (cec (cop (cv u) (cv f2)) ceq0))) (wceq (cv z) (cec (cop (co (cv w) (cv u) comu) (co (cv v) (cv f2) comu)) ceq0))))))))) $;

--| Addition on non-negative fractions. This definition is similar to ~ df-plq0 but expands ` Q0. ` (Contributed by Jim Kingdon, 24-Nov-2019.)
theorem dfplq0qs {x3 y1 z w v u f2: setvar}:
  $ wceq cplq0 (coprab x3 y1 z (wa (wa (wcel (cv x3) (cqs (cxp com cnpi) ceq0)) (wcel (cv y1) (cqs (cxp com cnpi) ceq0))) (wex w (wex v (wex u (wex f2 (wa (wa (wceq (cv x3) (cec (cop (cv w) (cv v)) ceq0)) (wceq (cv y1) (cec (cop (cv u) (cv f2)) ceq0))) (wceq (cv z) (cec (cop (co (co (cv w) (cv f2) comu) (co (cv v) (cv u) comu) coa) (co (cv v) (cv f2) comu)) ceq0))))))))) $;

--| Equivalence on positive fractions in terms of equivalence on non-negative fractions. (Contributed by Jim Kingdon, 12-Nov-2019.)
theorem enq0enq:
  $ wceq ceq (cin ceq0 (cxp (cxp cnpi cnpi) (cxp cnpi cnpi))) $;

--| The equivalence relation for non-negative fractions is symmetric. Lemma for ~ enq0er . (Contributed by Jim Kingdon, 14-Nov-2019.)
theorem enq0sym {f2 g1: setvar}:
  $ wi (wbr (cv f2) (cv g1) ceq0) (wbr (cv g1) (cv f2) ceq0) $;

--| The equivalence relation for non-negative fractions is reflexive. Lemma for ~ enq0er . (Contributed by Jim Kingdon, 14-Nov-2019.)
theorem enq0ref {f2: setvar}:
  $ wb (wcel (cv f2) (cxp com cnpi)) (wbr (cv f2) (cv f2) ceq0) $;

--| The equivalence relation for non-negative fractions is transitive. Lemma for ~ enq0er . (Contributed by Jim Kingdon, 14-Nov-2019.)
theorem enq0tr {f2 g1 h: setvar}:
  $ wi (wa (wbr (cv f2) (cv g1) ceq0) (wbr (cv g1) (cv h) ceq0)) (wbr (cv f2) (cv h) ceq0) $;

--| The equivalence relation for non-negative fractions is an equivalence relation. (Contributed by Jim Kingdon, 12-Nov-2019.)
theorem enq0er:
  $ wer (cxp com cnpi) ceq0 $;

--| Equivalence relation for non-negative fractions in terms of natural numbers. (Contributed by NM, 27-Aug-1995.)
theorem enq0breq (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 com) (wcel B2 cnpi)) (wa (wcel C com) (wcel D cnpi))) (wb (wbr (cop A2 B2) (cop C D) ceq0) (wceq (co A2 D comu) (co B2 C comu))) $;

--| Equivalence class equality of non-negative fractions in terms of natural numbers. (Contributed by Jim Kingdon, 24-Nov-2019.)
theorem enq0eceq (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 com) (wcel B2 cnpi)) (wa (wcel C com) (wcel D cnpi))) (wb (wceq (cec (cop A2 B2) ceq0) (cec (cop C D) ceq0)) (wceq (co A2 D comu) (co B2 C comu))) $;

--| A non-negative fraction is a positive fraction if its numerator and denominator are positive integers. (Contributed by Jim Kingdon, 10-Nov-2019.)
theorem nqnq0pi (A2 B2: class):
  $ wi (wa (wcel A2 cnpi) (wcel B2 cnpi)) (wceq (cec (cop A2 B2) ceq0) (cec (cop A2 B2) ceq)) $;

--| The equivalence relation for positive fractions exists. (Contributed by Jim Kingdon, 18-Nov-2019.)
theorem enq0ex:
  $ wcel ceq0 cvv $;

--| The class of positive fractions exists. (Contributed by Jim Kingdon, 18-Nov-2019.)
theorem nq0ex:
  $ wcel cnq0 cvv $;

--| A positive fraction is a non-negative fraction. (Contributed by Jim Kingdon, 18-Nov-2019.)
theorem nqnq0:
  $ wss cnq cnq0 $;

--| Decomposition of a non-negative fraction into numerator and denominator. (Contributed by Jim Kingdon, 24-Nov-2019.)
theorem nq0nn {w v: setvar} (A2: class):
  $ wi (wcel A2 cnq0) (wex w (wex v (wa (wa (wcel (cv w) com) (wcel (cv v) cnpi)) (wceq A2 (cec (cop (cv w) (cv v)) ceq0))))) $;

--| Lemma showing compatibility of addition on non-negative fractions. (Contributed by Jim Kingdon, 23-Nov-2019.)
theorem addcmpblnq0 (A2 B2 C D R S F G: class):
  $ wi (wa (wa (wa (wcel A2 com) (wcel B2 cnpi)) (wa (wcel C com) (wcel D cnpi))) (wa (wa (wcel F com) (wcel G cnpi)) (wa (wcel R com) (wcel S cnpi)))) (wi (wa (wceq (co A2 D comu) (co B2 C comu)) (wceq (co F S comu) (co G R comu))) (wbr (cop (co (co A2 G comu) (co B2 F comu) coa) (co B2 G comu)) (cop (co (co C S comu) (co D R comu) coa) (co D S comu)) ceq0)) $;

--| Lemma showing compatibility of multiplication on non-negative fractions. (Contributed by Jim Kingdon, 20-Nov-2019.)
theorem mulcmpblnq0 (A2 B2 C D R S F G: class):
  $ wi (wa (wa (wa (wcel A2 com) (wcel B2 cnpi)) (wa (wcel C com) (wcel D cnpi))) (wa (wa (wcel F com) (wcel G cnpi)) (wa (wcel R com) (wcel S cnpi)))) (wi (wa (wceq (co A2 D comu) (co B2 C comu)) (wceq (co F S comu) (co G R comu))) (wbr (cop (co A2 F comu) (co B2 G comu)) (cop (co C R comu) (co D S comu)) ceq0)) $;

--| Lemma for distributive law: cancellation of common factor. (Contributed by Jim Kingdon, 29-Nov-2019.)
theorem mulcanenq0ec (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnpi) (wcel B2 com) (wcel C cnpi)) (wceq (cec (cop (co A2 B2 comu) (co A2 C comu)) ceq0) (cec (cop B2 C) ceq0)) $;

--| Decomposing non-negative fractions into natural numbers. Lemma for ~ addnnnq0 and ~ mulnnnq0 . (Contributed by Jim Kingdon, 23-Nov-2019.)
theorem nnnq0lem1 (z w v u t: setvar) (A2 B2 C D: class) (f2 g1 h s1 q: setvar):
  $ wi (wa (wa (wcel A2 (cqs (cxp com cnpi) ceq0)) (wcel B2 (cqs (cxp com cnpi) ceq0))) (wa (wa (wa (wceq A2 (cec (cop (cv w) (cv v)) ceq0)) (wceq B2 (cec (cop (cv u) (cv t)) ceq0))) (wceq (cv z) (cec C ceq0))) (wa (wa (wceq A2 (cec (cop (cv s1) (cv f2)) ceq0)) (wceq B2 (cec (cop (cv g1) (cv h)) ceq0))) (wceq (cv q) (cec D ceq0))))) (wa (wa (wa (wa (wcel (cv w) com) (wcel (cv v) cnpi)) (wa (wcel (cv s1) com) (wcel (cv f2) cnpi))) (wa (wa (wcel (cv u) com) (wcel (cv t) cnpi)) (wa (wcel (cv g1) com) (wcel (cv h) cnpi)))) (wa (wceq (co (cv w) (cv f2) comu) (co (cv v) (cv s1) comu)) (wceq (co (cv u) (cv h) comu) (co (cv t) (cv g1) comu)))) $;

--| There is at most one result from adding non-negative fractions. (Contributed by Jim Kingdon, 23-Nov-2019.)
theorem addnq0mo {z w v u t: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 (cqs (cxp com cnpi) ceq0)) (wcel B2 (cqs (cxp com cnpi) ceq0))) (wmo z (wex w (wex v (wex u (wex t (wa (wa (wceq A2 (cec (cop (cv w) (cv v)) ceq0)) (wceq B2 (cec (cop (cv u) (cv t)) ceq0))) (wceq (cv z) (cec (cop (co (co (cv w) (cv t) comu) (co (cv v) (cv u) comu) coa) (co (cv v) (cv t) comu)) ceq0)))))))) $;

--| There is at most one result from multiplying non-negative fractions. (Contributed by Jim Kingdon, 20-Nov-2019.)
theorem mulnq0mo {z w v u t: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 (cqs (cxp com cnpi) ceq0)) (wcel B2 (cqs (cxp com cnpi) ceq0))) (wmo z (wex w (wex v (wex u (wex t (wa (wa (wceq A2 (cec (cop (cv w) (cv v)) ceq0)) (wceq B2 (cec (cop (cv u) (cv t)) ceq0))) (wceq (cv z) (cec (cop (co (cv w) (cv u) comu) (co (cv v) (cv t) comu)) ceq0)))))))) $;

--| Addition of non-negative fractions in terms of natural numbers. (Contributed by Jim Kingdon, 22-Nov-2019.)
theorem addnnnq0 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 com) (wcel B2 cnpi)) (wa (wcel C com) (wcel D cnpi))) (wceq (co (cec (cop A2 B2) ceq0) (cec (cop C D) ceq0) cplq0) (cec (cop (co (co A2 D comu) (co B2 C comu) coa) (co B2 D comu)) ceq0)) $;

--| Multiplication of non-negative fractions in terms of natural numbers. (Contributed by Jim Kingdon, 19-Nov-2019.)
theorem mulnnnq0 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 com) (wcel B2 cnpi)) (wa (wcel C com) (wcel D cnpi))) (wceq (co (cec (cop A2 B2) ceq0) (cec (cop C D) ceq0) cmq0) (cec (cop (co A2 C comu) (co B2 D comu)) ceq0)) $;

--| Closure of addition on non-negative fractions. (Contributed by Jim Kingdon, 29-Nov-2019.)
theorem addclnq0 (A2 B2: class):
  $ wi (wa (wcel A2 cnq0) (wcel B2 cnq0)) (wcel (co A2 B2 cplq0) cnq0) $;

--| Closure of multiplication on non-negative fractions. (Contributed by Jim Kingdon, 30-Nov-2019.)
theorem mulclnq0 (A2 B2: class):
  $ wi (wa (wcel A2 cnq0) (wcel B2 cnq0)) (wcel (co A2 B2 cmq0) cnq0) $;

--| A positive fraction plus a non-negative fraction is a positive fraction. (Contributed by Jim Kingdon, 30-Nov-2019.)
theorem nqpnq0nq (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq0)) (wcel (co A2 B2 cplq0) cnq) $;

--| Addition of positive fractions is equal with ` +Q ` or ` +Q0 ` . (Contributed by Jim Kingdon, 10-Nov-2019.)
theorem nqnq0a (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wceq (co A2 B2 cplq) (co A2 B2 cplq0)) $;

--| Multiplication of positive fractions is equal with ` .Q ` or ` .Q0 ` . (Contributed by Jim Kingdon, 10-Nov-2019.)
theorem nqnq0m (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wceq (co A2 B2 cmq) (co A2 B2 cmq0)) $;

--| Multiplication with zero for non-negative fractions. (Contributed by Jim Kingdon, 5-Nov-2019.)
theorem nq0m0r (A2: class):
  $ wi (wcel A2 cnq0) (wceq (co c0q0 A2 cmq0) c0q0) $;

--| Addition with zero for non-negative fractions. (Contributed by Jim Kingdon, 5-Nov-2019.)
theorem nq0a0 (A2: class):
  $ wi (wcel A2 cnq0) (wceq (co A2 c0q0 cplq0) A2) $;

--| Addition of non-negative fractions with a common denominator. You can add two fractions with the same denominator by adding their numerators and keeping the same denominator. (Contributed by Jim Kingdon, 1-Dec-2019.)
theorem nnanq0 (A2 M N: class):
  $ wi (w3a (wcel N com) (wcel M com) (wcel A2 cnpi)) (wceq (cec (cop (co N M coa) A2) ceq0) (co (cec (cop N A2) ceq0) (cec (cop M A2) ceq0) cplq0)) $;

--| Multiplication of non-negative fractions is distributive. (Contributed by Jim Kingdon, 27-Nov-2019.)
theorem distrnq0 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnq0) (wcel B2 cnq0) (wcel C cnq0)) (wceq (co A2 (co B2 C cplq0) cmq0) (co (co A2 B2 cmq0) (co A2 C cmq0) cplq0)) $;

--| Multiplication of non-negative fractions is commutative. (Contributed by Jim Kingdon, 27-Nov-2019.)
theorem mulcomnq0 (A2 B2: class):
  $ wi (wa (wcel A2 cnq0) (wcel B2 cnq0)) (wceq (co A2 B2 cmq0) (co B2 A2 cmq0)) $;

--| A natural number closure law. Lemma for ~ addassnq0 . (Contributed by Jim Kingdon, 3-Dec-2019.)
theorem addassnq0lemcl (I J K L: class):
  $ wi (wa (wa (wcel I com) (wcel J cnpi)) (wa (wcel K com) (wcel L cnpi))) (wa (wcel (co (co I L comu) (co J K comu) coa) com) (wcel (co J L comu) cnpi)) $;

--| Addition of non-negaative fractions is associative. (Contributed by Jim Kingdon, 29-Nov-2019.)
theorem addassnq0 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnq0) (wcel B2 cnq0) (wcel C cnq0)) (wceq (co (co A2 B2 cplq0) C cplq0) (co A2 (co B2 C cplq0) cplq0)) $;

--| Multiplication of non-negative fractions is distributive. Version of ~ distrnq0 with the multiplications commuted. (Contributed by Jim Kingdon, 29-Nov-2019.)
theorem distnq0r (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnq0) (wcel B2 cnq0) (wcel C cnq0)) (wceq (co (co B2 C cplq0) A2 cmq0) (co (co B2 A2 cmq0) (co C A2 cmq0) cplq0)) $;

--| Addition of one to the numerator of a fraction whose denominator is one. (Contributed by Jim Kingdon, 26-Apr-2020.)
theorem addpinq1 (A2: class):
  $ wi (wcel A2 cnpi) (wceq (cec (cop (co A2 c1o cpli) c1o) ceq) (co (cec (cop A2 c1o) ceq) c1q cplq)) $;

--| Multiply a non-negative fraction by two. (Contributed by Jim Kingdon, 29-Nov-2019.)
theorem nq02m (A2: class):
  $ wi (wcel A2 cnq0) (wceq (co (cec (cop c2o c1o) ceq0) A2 cmq0) (co A2 A2 cplq0)) $;

--| Define the set of positive reals. A "Dedekind cut" is a partition of the positive rational numbers into two classes such that all the numbers of one class are less than all the numbers of the other. Here we follow the definition of a Dedekind cut from Definition 11.2.1 of [HoTT], p. (varies) with the one exception that we define it over positive rational numbers rather than all rational numbers. A Dedekind cut is an ordered pair of a lower set ` l ` and an upper set ` u ` which is inhabited ( ` E. q e. Q. q e. l /\ E. r e. Q. r e. u ` ), rounded ( ` A. q e. Q. ( q e. l <-> E. r e. Q. ( q <Q r /\ r e. l ) ) ` and likewise for ` u ` ), disjoint ( ` A. q e. Q. -. ( q e. l /\ q e. u ) ` ) and located ( ` A. q e. Q. A. r e. Q. ( q <Q r -> ( q e. l \/ r e. u ) ) ` ). See HoTT for more discussion of those terms and different ways of defining Dedekind cuts. (Note: This is a "temporary" definition used in the construction of complex numbers, and is intended to be used only by the construction.) (Contributed by Jim Kingdon, 25-Sep-2019.)
axiom df_inp {u r q l: setvar}:
  $ wceq cnp (copab l u (wa (wa (wa (wss (cv l) cnq) (wss (cv u) cnq)) (wa (wrex q (wcel (cv q) (cv l)) cnq) (wrex r (wcel (cv r) (cv u)) cnq))) (w3a (wa (wral q (wb (wcel (cv q) (cv l)) (wrex r (wa (wbr (cv q) (cv r) cltq) (wcel (cv r) (cv l))) cnq)) cnq) (wral r (wb (wcel (cv r) (cv u)) (wrex q (wa (wbr (cv q) (cv r) cltq) (wcel (cv q) (cv u))) cnq)) cnq)) (wral q (wn (wa (wcel (cv q) (cv l)) (wcel (cv q) (cv u)))) cnq) (wral q (wral r (wi (wbr (cv q) (cv r) cltq) (wo (wcel (cv q) (cv l)) (wcel (cv r) (cv u)))) cnq) cnq)))) $;

--| Define the positive real constant 1. This is a "temporary" set used in the construction of complex numbers and is intended to be used only by the construction. (Contributed by Jim Kingdon, 25-Sep-2019.)
axiom df_i1p {u l: setvar}:
  $ wceq c1p (cop (cab l (wbr (cv l) c1q cltq)) (cab u (wbr c1q (cv u) cltq))) $;

--| Define addition on positive reals. From Section 11.2.1 of [HoTT], p. (varies). We write this definition to closely resemble the definition in HoTT although some of the conditions are redundant (for example, ` r e. ( 1st `` x ) ` implies ` r e. Q. ` ) and can be simplified as shown at ~ genpdf . This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. (Contributed by Jim Kingdon, 26-Sep-2019.)
axiom df_iplp {x3 y1 s1 r q: setvar}:
  $ wceq cpp (cmpt2 x3 y1 cnp cnp (cop (crab q (wrex r (wrex s1 (w3a (wcel (cv r) (cfv (cv x3) c1st)) (wcel (cv s1) (cfv (cv y1) c1st)) (wceq (cv q) (co (cv r) (cv s1) cplq))) cnq) cnq) cnq) (crab q (wrex r (wrex s1 (w3a (wcel (cv r) (cfv (cv x3) c2nd)) (wcel (cv s1) (cfv (cv y1) c2nd)) (wceq (cv q) (co (cv r) (cv s1) cplq))) cnq) cnq) cnq))) $;

--| Define multiplication on positive reals. Here we use a simple definition which is similar to ~ df-iplp or the definition of multiplication on positive reals in Metamath Proof Explorer. This is as opposed to the more complicated definition of multiplication given in Section 11.2.1 of [HoTT], p. (varies), which appears to be motivated by handling negative numbers or handling modified Dedekind cuts in which locatedness is omitted. This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. (Contributed by Jim Kingdon, 29-Sep-2019.)
axiom df_imp {x3 y1 s1 r q: setvar}:
  $ wceq cmp (cmpt2 x3 y1 cnp cnp (cop (crab q (wrex r (wrex s1 (w3a (wcel (cv r) (cfv (cv x3) c1st)) (wcel (cv s1) (cfv (cv y1) c1st)) (wceq (cv q) (co (cv r) (cv s1) cmq))) cnq) cnq) cnq) (crab q (wrex r (wrex s1 (w3a (wcel (cv r) (cfv (cv x3) c2nd)) (wcel (cv s1) (cfv (cv y1) c2nd)) (wceq (cv q) (co (cv r) (cv s1) cmq))) cnq) cnq) cnq))) $;

--| Define ordering on positive reals. We define ` x <P y ` if there is a positive fraction ` q ` which is an element of the upper cut of ` x ` and the lower cut of ` y ` . From the definition of < in Section 11.2.1 of [HoTT], p. (varies). This is a "temporary" set used in the construction of complex numbers, and is intended to be used only by the construction. (Contributed by Jim Kingdon, 29-Sep-2019.)
axiom df_iltp {x3 y1 q: setvar}:
  $ wceq cltp (copab x3 y1 (wa (wa (wcel (cv x3) cnp) (wcel (cv y1) cnp)) (wrex q (wa (wcel (cv q) (cfv (cv x3) c2nd)) (wcel (cv q) (cfv (cv y1) c1st))) cnq))) $;

--| Lemma for proving existence of reals. (Contributed by Jim Kingdon, 27-Sep-2019.)
theorem npsspw:
  $ wss cnp (cxp (cpw cnq) (cpw cnq)) $;

--| Two reals are equal if and only if their lower and upper cuts are. (Contributed by Jim Kingdon, 11-Dec-2019.)
theorem preqlu (A2 B2: class):
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wb (wceq A2 B2) (wa (wceq (cfv A2 c1st) (cfv B2 c1st)) (wceq (cfv A2 c2nd) (cfv B2 c2nd)))) $;

--| The class of positive reals is a set. (Contributed by NM, 31-Oct-1995.)
theorem npex:
  $ wcel cnp cvv $;

--| Membership in positive reals. (Contributed by Jim Kingdon, 27-Sep-2019.)
theorem elinp {r q: setvar} (U L: class):
  $ wb (wcel (cop L U) cnp) (wa (wa (wa (wss L cnq) (wss U cnq)) (wa (wrex q (wcel (cv q) L) cnq) (wrex r (wcel (cv r) U) cnq))) (w3a (wa (wral q (wb (wcel (cv q) L) (wrex r (wa (wbr (cv q) (cv r) cltq) (wcel (cv r) L)) cnq)) cnq) (wral r (wb (wcel (cv r) U) (wrex q (wa (wbr (cv q) (cv r) cltq) (wcel (cv q) U)) cnq)) cnq)) (wral q (wn (wa (wcel (cv q) L) (wcel (cv q) U))) cnq) (wral q (wral r (wi (wbr (cv q) (cv r) cltq) (wo (wcel (cv q) L) (wcel (cv r) U))) cnq) cnq))) $;

--| A positive real is an ordered pair of a lower cut and an upper cut. (Contributed by Jim Kingdon, 27-Sep-2019.)
theorem prop (A2: class):
  $ wi (wcel A2 cnp) (wcel (cop (cfv A2 c1st) (cfv A2 c2nd)) cnp) $;

--| Membership in positive reals, using ` 1st ` and ` 2nd ` to refer to the lower and upper cut. (Contributed by Jim Kingdon, 3-Oct-2019.)
theorem elnp1st2nd {r q: setvar} (A2: class):
  $ wb (wcel A2 cnp) (wa (wa (wcel A2 (cxp (cpw cnq) (cpw cnq))) (wa (wrex q (wcel (cv q) (cfv A2 c1st)) cnq) (wrex r (wcel (cv r) (cfv A2 c2nd)) cnq))) (w3a (wa (wral q (wb (wcel (cv q) (cfv A2 c1st)) (wrex r (wa (wbr (cv q) (cv r) cltq) (wcel (cv r) (cfv A2 c1st))) cnq)) cnq) (wral r (wb (wcel (cv r) (cfv A2 c2nd)) (wrex q (wa (wbr (cv q) (cv r) cltq) (wcel (cv q) (cfv A2 c2nd))) cnq)) cnq)) (wral q (wn (wa (wcel (cv q) (cfv A2 c1st)) (wcel (cv q) (cfv A2 c2nd)))) cnq) (wral q (wral r (wi (wbr (cv q) (cv r) cltq) (wo (wcel (cv q) (cfv A2 c1st)) (wcel (cv r) (cfv A2 c2nd)))) cnq) cnq))) $;

--| A positive real's lower cut is inhabited. (Contributed by Jim Kingdon, 27-Sep-2019.)
theorem prml {x3: setvar} (U L: class):
  $ wi (wcel (cop L U) cnp) (wrex x3 (wcel (cv x3) L) cnq) $;

--| A positive real's upper cut is inhabited. (Contributed by Jim Kingdon, 27-Sep-2019.)
theorem prmu {x3: setvar} (U L: class):
  $ wi (wcel (cop L U) cnp) (wrex x3 (wcel (cv x3) U) cnq) $;

--| A positive real's lower cut is a subset of the positive fractions. It would presumably be possible to also prove ` L C. Q. ` , but we only need ` L C_ Q. ` so far. (Contributed by Jim Kingdon, 28-Sep-2019.)
theorem prssnql (U L: class):
  $ wi (wcel (cop L U) cnp) (wss L cnq) $;

--| A positive real's upper cut is a subset of the positive fractions. It would presumably be possible to also prove ` U C. Q. ` , but we only need ` U C_ Q. ` so far. (Contributed by Jim Kingdon, 28-Sep-2019.)
theorem prssnqu (U L: class):
  $ wi (wcel (cop L U) cnp) (wss U cnq) $;

--| An element of a positive real's lower cut is a positive fraction. (Contributed by Jim Kingdon, 28-Sep-2019.)
theorem elprnql (B2 U L: class):
  $ wi (wa (wcel (cop L U) cnp) (wcel B2 L)) (wcel B2 cnq) $;

--| An element of a positive real's upper cut is a positive fraction. (Contributed by Jim Kingdon, 28-Sep-2019.)
theorem elprnqu (B2 U L: class):
  $ wi (wa (wcel (cop L U) cnp) (wcel B2 U)) (wcel B2 cnq) $;

--| The empty set is not a positive real. (Contributed by NM, 15-Nov-1995.)
theorem _0npr:
  $ wn (wcel c0 cnp) $;

--| A lower cut is closed downwards under the positive fractions. (Contributed by Jim Kingdon, 28-Sep-2019.)
theorem prcdnql (B2 C U L: class):
  $ wi (wa (wcel (cop L U) cnp) (wcel B2 L)) (wi (wbr C B2 cltq) (wcel C L)) $;

--| An upper cut is closed upwards under the positive fractions. (Contributed by Jim Kingdon, 25-Nov-2019.)
theorem prcunqu (B2 C U L: class):
  $ wi (wa (wcel (cop L U) cnp) (wcel C U)) (wi (wbr C B2 cltq) (wcel B2 U)) $;

--| A positive fraction not in a lower cut is an upper bound. (Contributed by Jim Kingdon, 29-Sep-2019.)
theorem prubl (B2 C U L: class):
  $ wi (wa (wa (wcel (cop L U) cnp) (wcel B2 L)) (wcel C cnq)) (wi (wn (wcel C L)) (wbr B2 C cltq)) $;

--| An element of a lower cut is less than an element of the corresponding upper cut. (Contributed by Jim Kingdon, 15-Oct-2019.)
theorem prltlu (B2 C U L: class):
  $ wi (w3a (wcel (cop L U) cnp) (wcel B2 L) (wcel C U)) (wbr B2 C cltq) $;

--| A lower cut has no largest member. (Contributed by Jim Kingdon, 29-Sep-2019.)
theorem prnmaxl {x3: setvar} (B2 U L: class):
  $ wi (wa (wcel (cop L U) cnp) (wcel B2 L)) (wrex x3 (wbr B2 (cv x3) cltq) L) $;

--| An upper cut has no smallest member. (Contributed by Jim Kingdon, 7-Nov-2019.)
theorem prnminu {x3: setvar} (B2 U L: class):
  $ wi (wa (wcel (cop L U) cnp) (wcel B2 U)) (wrex x3 (wbr (cv x3) B2 cltq) U) $;

--| A lower cut has no largest member. Addition version. (Contributed by Jim Kingdon, 29-Sep-2019.)
theorem prnmaddl {x3: setvar} (B2 U L: class):
  $ wi (wa (wcel (cop L U) cnp) (wcel B2 L)) (wrex x3 (wcel (co B2 (cv x3) cplq) L) cnq) $;

--| A Dedekind cut is located. (Contributed by Jim Kingdon, 23-Oct-2019.)
theorem prloc (A2 B2 U L: class):
  $ wi (wa (wcel (cop L U) cnp) (wbr A2 B2 cltq)) (wo (wcel A2 L) (wcel B2 U)) $;

--| A Dedekind cut is disjoint. (Contributed by Jim Kingdon, 15-Dec-2019.)
theorem prdisj (A2 U L: class):
  $ wi (wa (wcel (cop L U) cnp) (wcel A2 cnq)) (wn (wa (wcel A2 L) (wcel A2 U))) $;

--| Two possible ways of contracting an interval which straddles a Dedekind cut. Lemma for ~ prarloc . (Contributed by Jim Kingdon, 10-Nov-2019.)
theorem prarloclemlt (y1: setvar) (A2 P U L X: class):
  $ wi (wa (wa (wcel X com) (w3a (wcel (cop L U) cnp) (wcel A2 L) (wcel P cnq))) (wcel (cv y1) com)) (wbr (co A2 (co (cec (cop (co (cv y1) c1o coa) c1o) ceq) P cmq) cplq) (co A2 (co (cec (cop (co (co (cv y1) c2o coa) X coa) c1o) ceq) P cmq) cplq) cltq) $;

--| Contracting the lower side of an interval which straddles a Dedekind cut. Lemma for ~ prarloc . (Contributed by Jim Kingdon, 10-Nov-2019.)
theorem prarloclemlo {y1: setvar} (A2 P U L X: class):
  $ wi (wa (wa (wcel X com) (w3a (wcel (cop L U) cnp) (wcel A2 L) (wcel P cnq))) (wcel (cv y1) com)) (wi (wcel (co A2 (co (cec (cop (co (cv y1) c1o coa) c1o) ceq) P cmq) cplq) L) (wi (wa (wcel (co A2 (co (cec (cop (cv y1) c1o) ceq0) P cmq0) cplq0) L) (wcel (co A2 (co (cec (cop (co (co (cv y1) c2o coa) (csuc X) coa) c1o) ceq) P cmq) cplq) U)) (wrex y1 (wa (wcel (co A2 (co (cec (cop (cv y1) c1o) ceq0) P cmq0) cplq0) L) (wcel (co A2 (co (cec (cop (co (co (cv y1) c2o coa) X coa) c1o) ceq) P cmq) cplq) U)) com))) $;

--| Contracting the upper side of an interval which straddles a Dedekind cut. Lemma for ~ prarloc . (Contributed by Jim Kingdon, 10-Nov-2019.)
theorem prarloclemup {y1: setvar} (A2 P U L X: class y1):
  $ wi (wa (wa (wcel X com) (w3a (wcel (cop L U) cnp) (wcel A2 L) (wcel P cnq))) (wcel (cv y1) com)) (wi (wcel (co A2 (co (cec (cop (co (co (cv y1) c2o coa) X coa) c1o) ceq) P cmq) cplq) U) (wi (wa (wcel (co A2 (co (cec (cop (cv y1) c1o) ceq0) P cmq0) cplq0) L) (wcel (co A2 (co (cec (cop (co (co (cv y1) c2o coa) (csuc X) coa) c1o) ceq) P cmq) cplq) U)) (wrex y1 (wa (wcel (co A2 (co (cec (cop (cv y1) c1o) ceq0) P cmq0) cplq0) L) (wcel (co A2 (co (cec (cop (co (co (cv y1) c2o coa) X coa) c1o) ceq) P cmq) cplq) U)) com))) $;

--| Induction step for ~ prarloclem3 . (Contributed by Jim Kingdon, 9-Nov-2019.)
theorem prarloclem3step {y1: setvar} (A2 P U L X: class):
  $ wi (wa (wa (wcel X com) (w3a (wcel (cop L U) cnp) (wcel A2 L) (wcel P cnq))) (wrex y1 (wa (wcel (co A2 (co (cec (cop (cv y1) c1o) ceq0) P cmq0) cplq0) L) (wcel (co A2 (co (cec (cop (co (co (cv y1) c2o coa) (csuc X) coa) c1o) ceq) P cmq) cplq) U)) com)) (wrex y1 (wa (wcel (co A2 (co (cec (cop (cv y1) c1o) ceq0) P cmq0) cplq0) L) (wcel (co A2 (co (cec (cop (co (co (cv y1) c2o coa) X coa) c1o) ceq) P cmq) cplq) U)) com) $;

--| Contracting an interval which straddles a Dedekind cut. Lemma for ~ prarloc . (Contributed by Jim Kingdon, 27-Oct-2019.)
theorem prarloclem3 {y1 j: setvar} (A2 P U L: class) (X: class j):
  $ wi (w3a (wa (wcel (cop L U) cnp) (wcel A2 L)) (wa (wcel X com) (wcel P cnq)) (wrex y1 (wa (wcel (co A2 (co (cec (cop (cv y1) c1o) ceq0) P cmq0) cplq0) L) (wcel (co A2 (co (cec (cop (co (co (cv y1) c2o coa) X coa) c1o) ceq) P cmq) cplq) U)) com)) (wrex j (wa (wcel (co A2 (co (cec (cop (cv j) c1o) ceq0) P cmq0) cplq0) L) (wcel (co A2 (co (cec (cop (co (cv j) c2o coa) c1o) ceq) P cmq) cplq) U)) com) $;

--| A slight rearrangement of ~ prarloclem3 . Lemma for ~ prarloc . (Contributed by Jim Kingdon, 4-Nov-2019.)
theorem prarloclem4 {x3 y1 j: setvar} (A2 P U L: class):
  $ wi (wa (wa (wcel (cop L U) cnp) (wcel A2 L)) (wcel P cnq)) (wi (wrex x3 (wrex y1 (wa (wcel (co A2 (co (cec (cop (cv y1) c1o) ceq0) P cmq0) cplq0) L) (wcel (co A2 (co (cec (cop (co (co (cv y1) c2o coa) (cv x3) coa) c1o) ceq) P cmq) cplq) U)) com) com) (wrex j (wa (wcel (co A2 (co (cec (cop (cv j) c1o) ceq0) P cmq0) cplq0) L) (wcel (co A2 (co (cec (cop (co (cv j) c2o coa) c1o) ceq) P cmq) cplq) U)) com)) $;

--| Subtracting two from a positive integer. Lemma for ~ prarloc . (Contributed by Jim Kingdon, 5-Nov-2019.)
theorem prarloclemn {x3: setvar} (N: class):
  $ wi (wa (wcel N cnpi) (wbr c1o N clti)) (wrex x3 (wceq (co c2o (cv x3) coa) N) com) $;

--| A substitution of zero for ` y ` and ` N ` minus two for ` x ` . Lemma for ~ prarloc . (Contributed by Jim Kingdon, 4-Nov-2019.)
theorem prarloclem5 {x3 y1: setvar} (A2 P U L: class) (N: class y1):
  $ wi (w3a (wa (wcel (cop L U) cnp) (wcel A2 L)) (w3a (wcel N cnpi) (wcel P cnq) (wbr c1o N clti)) (wcel (co A2 (co (cec (cop N c1o) ceq) P cmq) cplq) U)) (wrex x3 (wrex y1 (wa (wcel (co A2 (co (cec (cop (cv y1) c1o) ceq0) P cmq0) cplq0) L) (wcel (co A2 (co (cec (cop (co (co (cv y1) c2o coa) (cv x3) coa) c1o) ceq) P cmq) cplq) U)) com) com) $;

--| A special case of Lemma 6.16 from [BauerTaylor], p. 32. Given evenly spaced rational numbers from ` A ` to ` A +Q ( N .Q P ) ` (which are in the lower and upper cuts, respectively, of a real number), there are a pair of numbers, two positions apart in the even spacing, which straddle the cut. (Contributed by Jim Kingdon, 22-Oct-2019.)
theorem prarloclem {j: setvar} (A2 P U L N: class):
  $ wi (w3a (wa (wcel (cop L U) cnp) (wcel A2 L)) (w3a (wcel N cnpi) (wcel P cnq) (wbr c1o N clti)) (wcel (co A2 (co (cec (cop N c1o) ceq) P cmq) cplq) U)) (wrex j (wa (wcel (co A2 (co (cec (cop (cv j) c1o) ceq0) P cmq0) cplq0) L) (wcel (co A2 (co (cec (cop (co (cv j) c2o coa) c1o) ceq) P cmq) cplq) U)) com) $;

--| Some calculations for ~ prarloc . (Contributed by Jim Kingdon, 26-Oct-2019.)
theorem prarloclemcalc (A2 B2 P Q M X: class):
  $ wi (wa (wa (wceq A2 (co X (co (cec (cop M c1o) ceq0) Q cmq0) cplq0)) (wceq B2 (co X (co (cec (cop (co M c2o coa) c1o) ceq) Q cmq) cplq))) (wa (wa (wcel Q cnq) (wbr (co Q Q cplq) P cltq)) (wa (wcel X cnq) (wcel M com)))) (wbr B2 (co A2 P cplq) cltq) $;

--| A Dedekind cut is arithmetically located. Part of Proposition 11.15 of [BauerTaylor], p. 52, slightly modified. It states that given a tolerance ` P ` , there are elements of the lower and upper cut which are within that tolerance of each other. Usually, proofs will be shorter if they use ~ prarloc2 instead. (Contributed by Jim Kingdon, 22-Oct-2019.)
theorem prarloc {a b: setvar} (P U L: class):
  $ wi (wa (wcel (cop L U) cnp) (wcel P cnq)) (wrex a (wrex b (wbr (cv b) (co (cv a) P cplq) cltq) U) L) $;

--| A Dedekind cut is arithmetically located. This is a variation of ~ prarloc which only constructs one (named) point and is therefore often easier to work with. It states that given a tolerance ` P ` , there are elements of the lower and upper cut which are exactly that tolerance from each other. (Contributed by Jim Kingdon, 26-Dec-2019.)
theorem prarloc2 {a: setvar} (P U L: class):
  $ wi (wa (wcel (cop L U) cnp) (wcel P cnq)) (wrex a (wcel (co (cv a) P cplq) U) L) $;

--| Positive real 'less than' is a relation on positive reals. (Contributed by NM, 14-Feb-1996.)
theorem ltrelpr:
  $ wss cltp (cxp cnp cnp) $;

--| More convenient form of ~ df-iltp . (Contributed by Jim Kingdon, 15-Dec-2019.)
theorem ltdfpr {q: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wb (wbr A2 B2 cltp) (wrex q (wa (wcel (cv q) (cfv A2 c2nd)) (wcel (cv q) (cfv B2 c1st))) cnq)) $;

--| Simplification of upper or lower cut expression. Lemma for ~ genpdf . (Contributed by Jim Kingdon, 30-Sep-2019.)
theorem genpdflem {s1 r q: setvar} (ph: wff) (A2: class r q) (B2 G: class s1 r q):
  $ wi (wa ph (wcel (cv r) A2)) (wcel (cv r) cnq) $ >
  $ wi (wa ph (wcel (cv s1) B2)) (wcel (cv s1) cnq) $ >
  $ wi ph (wceq (crab q (wrex r (wrex s1 (w3a (wcel (cv r) A2) (wcel (cv s1) B2) (wceq (cv q) (co (cv r) (cv s1) G))) cnq) cnq) cnq) (crab q (wrex r (wrex s1 (wceq (cv q) (co (cv r) (cv s1) G)) B2) A2) cnq)) $;

--| Simplified definition of addition or multiplication on positive reals. (Contributed by Jim Kingdon, 30-Sep-2019.)
theorem genpdf {w v s1 r q: setvar} (F G: class w v s1 r q):
  $ wceq F (cmpt2 w v cnp cnp (cop (crab q (wrex r (wrex s1 (w3a (wcel (cv r) (cfv (cv w) c1st)) (wcel (cv s1) (cfv (cv v) c1st)) (wceq (cv q) (co (cv r) (cv s1) G))) cnq) cnq) cnq) (crab q (wrex r (wrex s1 (w3a (wcel (cv r) (cfv (cv w) c2nd)) (wcel (cv s1) (cfv (cv v) c2nd)) (wceq (cv q) (co (cv r) (cv s1) G))) cnq) cnq) cnq))) $ >
  $ wceq F (cmpt2 w v cnp cnp (cop (crab q (wrex r (wrex s1 (wceq (cv q) (co (cv r) (cv s1) G)) (cfv (cv v) c1st)) (cfv (cv w) c1st)) cnq) (crab q (wrex r (wrex s1 (wceq (cv q) (co (cv r) (cv s1) G)) (cfv (cv v) c2nd)) (cfv (cv w) c2nd)) cnq))) $;

--| Value of general operation (addition or multiplication) on positive reals. (Contributed by Jim Kingon, 3-Oct-2019.)
theorem genipv {x3 y1 z w v s1 r q: setvar} (A2 B2: class w v) (F: class x3 y1 z w v s1 r q) (G: class):
  $ wceq F (cmpt2 w v cnp cnp (cop (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c1st)) (wcel (cv z) (cfv (cv v) c1st)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq) (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c2nd)) (wcel (cv z) (cfv (cv v) c2nd)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq))) $ >
  $ wi (wa (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wcel (co (cv y1) (cv z) G) cnq) $ >
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wceq (co A2 B2 F) (cop (crab q (wrex r (wrex s1 (wceq (cv q) (co (cv r) (cv s1) G)) (cfv B2 c1st)) (cfv A2 c1st)) cnq) (crab q (wrex r (wrex s1 (wceq (cv q) (co (cv r) (cv s1) G)) (cfv B2 c2nd)) (cfv A2 c2nd)) cnq))) $;

--| Operating on both sides of two inequalities, when the operation is consistent with ` <Q ` . (Contributed by Jim Kingdon, 6-Oct-2019.)
theorem genplt2i {x3 y1 z: setvar} (A2 B2 C D G: class):
  $ wi (w3a (wcel (cv x3) cnq) (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wb (wbr (cv x3) (cv y1) cltq) (wbr (co (cv z) (cv x3) G) (co (cv z) (cv y1) G) cltq)) $ >
  $ wi (wa (wcel (cv x3) cnq) (wcel (cv y1) cnq)) (wceq (co (cv x3) (cv y1) G) (co (cv y1) (cv x3) G)) $ >
  $ wi (wa (wbr A2 B2 cltq) (wbr C D cltq)) (wbr (co A2 C G) (co B2 D G) cltq) $;

--| Set containing the result of adding or multiplying positive reals. (Contributed by Jim Kingdon, 5-Dec-2019.)
theorem genpelxp {x3 y1 z w v: setvar} (A2 B2: class) (F: class x3 y1 z w v) (G: class):
  $ wceq F (cmpt2 w v cnp cnp (cop (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c1st)) (wcel (cv z) (cfv (cv v) c1st)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq) (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c2nd)) (wcel (cv z) (cfv (cv v) c2nd)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq))) $ >
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wcel (co A2 B2 F) (cxp (cpw cnq) (cpw cnq))) $;

--| Membership in lower cut of general operation (addition or multiplication) on positive reals. (Contributed by Jim Kingdon, 2-Oct-2019.)
theorem genpelvl {x3 y1 z w v g1 h: setvar} (A2 B2: class) (C: class x3 y1 z w v) (F: class x3 y1 z w v h) (G: class):
  $ wceq F (cmpt2 w v cnp cnp (cop (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c1st)) (wcel (cv z) (cfv (cv v) c1st)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq) (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c2nd)) (wcel (cv z) (cfv (cv v) c2nd)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq))) $ >
  $ wi (wa (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wcel (co (cv y1) (cv z) G) cnq) $ >
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wb (wcel C (cfv (co A2 B2 F) c1st)) (wrex g1 (wrex h (wceq C (co (cv g1) (cv h) G)) (cfv B2 c1st)) (cfv A2 c1st))) $;

--| Membership in upper cut of general operation (addition or multiplication) on positive reals. (Contributed by Jim Kingdon, 15-Oct-2019.)
theorem genpelvu {x3 y1 z w v g1 h: setvar} (A2 B2: class) (C: class x3 y1 z w v) (F: class x3 y1 z w v h) (G: class):
  $ wceq F (cmpt2 w v cnp cnp (cop (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c1st)) (wcel (cv z) (cfv (cv v) c1st)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq) (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c2nd)) (wcel (cv z) (cfv (cv v) c2nd)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq))) $ >
  $ wi (wa (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wcel (co (cv y1) (cv z) G) cnq) $ >
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wb (wcel C (cfv (co A2 B2 F) c2nd)) (wrex g1 (wrex h (wceq C (co (cv g1) (cv h) G)) (cfv B2 c2nd)) (cfv A2 c2nd))) $;

--| Pre-closure law for general operation on lower cuts. (Contributed by Jim Kingdon, 2-Oct-2019.)
theorem genpprecll {x3 y1 z w v: setvar} (A2 B2: class) (C D F: class x3 y1 z w v) (G: class):
  $ wceq F (cmpt2 w v cnp cnp (cop (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c1st)) (wcel (cv z) (cfv (cv v) c1st)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq) (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c2nd)) (wcel (cv z) (cfv (cv v) c2nd)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq))) $ >
  $ wi (wa (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wcel (co (cv y1) (cv z) G) cnq) $ >
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wi (wa (wcel C (cfv A2 c1st)) (wcel D (cfv B2 c1st))) (wcel (co C D G) (cfv (co A2 B2 F) c1st))) $;

--| Pre-closure law for general operation on upper cuts. (Contributed by Jim Kingdon, 7-Nov-2019.)
theorem genppreclu {x3 y1 z w v: setvar} (A2 B2: class) (C D F: class x3 y1 z w v) (G: class):
  $ wceq F (cmpt2 w v cnp cnp (cop (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c1st)) (wcel (cv z) (cfv (cv v) c1st)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq) (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c2nd)) (wcel (cv z) (cfv (cv v) c2nd)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq))) $ >
  $ wi (wa (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wcel (co (cv y1) (cv z) G) cnq) $ >
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wi (wa (wcel C (cfv A2 c2nd)) (wcel D (cfv B2 c2nd))) (wcel (co C D G) (cfv (co A2 B2 F) c2nd))) $;

--| Domain of general operation on positive reals. (Contributed by Jim Kingdon, 2-Oct-2019.)
theorem genipdm {x3 y1 z w v: setvar} (F: class x3 y1 z w v) (G: class):
  $ wceq F (cmpt2 w v cnp cnp (cop (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c1st)) (wcel (cv z) (cfv (cv v) c1st)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq) (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c2nd)) (wcel (cv z) (cfv (cv v) c2nd)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq))) $ >
  $ wi (wa (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wcel (co (cv y1) (cv z) G) cnq) $ >
  $ wceq (cdm F) (cxp cnp cnp) $;

--| The lower cut produced by addition or multiplication on positive reals is inhabited. (Contributed by Jim Kingdon, 5-Oct-2019.)
theorem genpml {x3 y1 z w v q: setvar} (A2 B2: class) (F: class x3 y1 z w v) (G: class):
  $ wceq F (cmpt2 w v cnp cnp (cop (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c1st)) (wcel (cv z) (cfv (cv v) c1st)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq) (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c2nd)) (wcel (cv z) (cfv (cv v) c2nd)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq))) $ >
  $ wi (wa (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wcel (co (cv y1) (cv z) G) cnq) $ >
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wrex q (wcel (cv q) (cfv (co A2 B2 F) c1st)) cnq) $;

--| The upper cut produced by addition or multiplication on positive reals is inhabited. (Contributed by Jim Kingdon, 5-Dec-2019.)

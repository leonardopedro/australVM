  $ wi ph (wral j (wbr A2 (cfv (cv j) F) cltq) cnpi) $ >
  $ wceq L (cop (crab l (wrex j (wbr (co (cv l) (cfv (cec (cop (cv j) c1o) ceq) crq) cplq) (cfv (cv j) F) cltq) cnpi) cnq) (crab u (wrex j (wbr (co (cfv (cv j) F) (cfv (cec (cop (cv j) c1o) ceq) crq) cplq) (cv u) cltq) cnpi) cnq)) $ >
  $ wi ph (wral x3 (wrex j (wral k (wi (wbr (cv j) (cv k) clti) (wa (wbr (cop (cab l (wbr (cv l) (cfv (cv k) F) cltq)) (cab u (wbr (cfv (cv k) F) (cv u) cltq))) (co L (cop (cab l (wbr (cv l) (cv x3) cltq)) (cab u (wbr (cv x3) (cv u) cltq))) cpp) cltp) (wbr L (cop (cab l (wbr (cv l) (co (cfv (cv k) F) (cv x3) cplq) cltq)) (cab u (wbr (co (cfv (cv k) F) (cv x3) cplq) (cv u) cltq))) cltp))) cnpi) cnpi) cnq) $;

--| A Cauchy sequence of positive fractions with a modulus of convergence converges to a positive real. This is basically Corollary 11.2.13 of [HoTT], p. (varies) (one key difference being that this is for positive reals rather than signed reals). Also, the HoTT book theorem has a modulus of convergence (that is, a rate of convergence) specified by (11.2.9) in HoTT whereas this theorem fixes the rate of convergence to say that all terms after the nth term must be within ` 1 / n ` of the nth term (it should later be able to prove versions of this theorem with a different fixed rate or a modulus of convergence supplied as a hypothesis). We also specify that every term needs to be larger than a fraction ` A ` , to avoid the case where we have positive terms which "converge" to zero (which is not a positive real). (Contributed by Jim Kingdon, 18-Jun-2020.)
theorem caucvgpr {x3 y1 u j k n l: setvar} (ph: wff y1 u n l) (A2: class x3 y1 u k n l) (F: class):
  $ wi ph (wf cnpi cnq F) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) clti) (wa (wbr (cfv (cv n) F) (co (cfv (cv k) F) (cfv (cec (cop (cv n) c1o) ceq) crq) cplq) cltq) (wbr (cfv (cv k) F) (co (cfv (cv n) F) (cfv (cec (cop (cv n) c1o) ceq) crq) cplq) cltq))) cnpi) cnpi) $ >
  $ wi ph (wral j (wbr A2 (cfv (cv j) F) cltq) cnpi) $ >
  $ wi ph (wrex y1 (wral x3 (wrex j (wral k (wi (wbr (cv j) (cv k) clti) (wa (wbr (cop (cab l (wbr (cv l) (cfv (cv k) F) cltq)) (cab u (wbr (cfv (cv k) F) (cv u) cltq))) (co (cv y1) (cop (cab l (wbr (cv l) (cv x3) cltq)) (cab u (wbr (cv x3) (cv u) cltq))) cpp) cltp) (wbr (cv y1) (cop (cab l (wbr (cv l) (co (cfv (cv k) F) (cv x3) cplq) cltq)) (cab u (wbr (co (cfv (cv k) F) (cv x3) cplq) (cv u) cltq))) cltp))) cnpi) cnpi) cnq) cnp) $;

--| Lemma for ~ caucvgprpr . Reciprocals of positive integers decrease as the positive integers increase. (Contributed by Jim Kingdon, 28-Nov-2020.)
theorem caucvgprprlemk {u l: setvar} (ph: wff u l) (Q: class u l) (J K: class):
  $ wi ph (wbr J K clti) $ >
  $ wi ph (wbr (cop (cab l (wbr (cv l) (cfv (cec (cop J c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop J c1o) ceq) crq) (cv u) cltq))) Q cltp) $ >
  $ wi ph (wbr (cop (cab l (wbr (cv l) (cfv (cec (cop K c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop K c1o) ceq) crq) (cv u) cltq))) Q cltp) $;

--| Lemma for ~ caucvgprpr . Rearranging some expressions for ~ caucvgprprlemloc . (Contributed by Jim Kingdon, 8-Feb-2021.)
theorem caucvgprprlemloccalc {u l: setvar} (ph: wff u l) (S T M: class) (X Y: class u l):
  $ wi ph (wbr S T cltq) $ >
  $ wi ph (wcel Y cnq) $ >
  $ wi ph (wceq (co S Y cplq) T) $ >
  $ wi ph (wcel X cnq) $ >
  $ wi ph (wbr (co X X cplq) Y cltq) $ >
  $ wi ph (wcel M cnpi) $ >
  $ wi ph (wbr (cfv (cec (cop M c1o) ceq) crq) X cltq) $ >
  $ wi ph (wbr (co (cop (cab l (wbr (cv l) (co S (cfv (cec (cop M c1o) ceq) crq) cplq) cltq)) (cab u (wbr (co S (cfv (cec (cop M c1o) ceq) crq) cplq) (cv u) cltq))) (cop (cab l (wbr (cv l) (cfv (cec (cop M c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop M c1o) ceq) crq) (cv u) cltq))) cpp) (cop (cab l (wbr (cv l) T cltq)) (cab u (wbr T (cv u) cltq))) cltp) $;

--| Lemma for ~ caucvgprpr . Membership in the lower cut of the putative limit. (Contributed by Jim Kingdon, 21-Jan-2021.)
theorem caucvgprprlemell {u r q p b l: setvar} (F: class q p) (L: class u r q p b l) (X: class):
  $ wceq L (cop (crab l (wrex r (wbr (cop (cab p (wbr (cv p) (co (cv l) (cfv (cec (cop (cv r) c1o) ceq) crq) cplq) cltq)) (cab q (wbr (co (cv l) (cfv (cec (cop (cv r) c1o) ceq) crq) cplq) (cv q) cltq))) (cfv (cv r) F) cltp) cnpi) cnq) (crab u (wrex r (wbr (co (cfv (cv r) F) (cop (cab p (wbr (cv p) (cfv (cec (cop (cv r) c1o) ceq) crq) cltq)) (cab q (wbr (cfv (cec (cop (cv r) c1o) ceq) crq) (cv q) cltq))) cpp) (cop (cab p (wbr (cv p) (cv u) cltq)) (cab q (wbr (cv u) (cv q) cltq))) cltp) cnpi) cnq)) $ >
  $ wb (wcel X (cfv L c1st)) (wa (wcel X cnq) (wrex b (wbr (cop (cab p (wbr (cv p) (co X (cfv (cec (cop (cv b) c1o) ceq) crq) cplq) cltq)) (cab q (wbr (co X (cfv (cec (cop (cv b) c1o) ceq) crq) cplq) (cv q) cltq))) (cfv (cv b) F) cltp) cnpi)) $;


  $ wi (wa (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wcel (co (cv y1) (cv z) G) cnq) $ >
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wrex q (wcel (cv q) (cfv (co A2 B2 F) c2nd)) cnq) $;

--| Downward closure of an operation on positive reals. (Contributed by Jim Kingdon, 14-Oct-2019.)
theorem genpcdl {x3 y1 z w v g1 h: setvar} (A2 B2: class) (f2: setvar) (F: class x3 y1 z w v) (G: class):
  $ wceq F (cmpt2 w v cnp cnp (cop (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c1st)) (wcel (cv z) (cfv (cv v) c1st)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq) (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c2nd)) (wcel (cv z) (cfv (cv v) c2nd)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq))) $ >
  $ wi (wa (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wcel (co (cv y1) (cv z) G) cnq) $ >
  $ wi (wa (wa (wa (wcel A2 cnp) (wcel (cv g1) (cfv A2 c1st))) (wa (wcel B2 cnp) (wcel (cv h) (cfv B2 c1st)))) (wcel (cv x3) cnq)) (wi (wbr (cv x3) (co (cv g1) (cv h) G) cltq) (wcel (cv x3) (cfv (co A2 B2 F) c1st))) $ >
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wi (wcel (cv f2) (cfv (co A2 B2 F) c1st)) (wi (wbr (cv x3) (cv f2) cltq) (wcel (cv x3) (cfv (co A2 B2 F) c1st)))) $;

--| Upward closure of an operation on positive reals. (Contributed by Jim Kingdon, 8-Nov-2019.)
theorem genpcuu {x3 y1 z w v g1 h: setvar} (A2 B2: class) (f2: setvar) (F: class x3 y1 z w v) (G: class):
  $ wceq F (cmpt2 w v cnp cnp (cop (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c1st)) (wcel (cv z) (cfv (cv v) c1st)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq) (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c2nd)) (wcel (cv z) (cfv (cv v) c2nd)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq))) $ >
  $ wi (wa (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wcel (co (cv y1) (cv z) G) cnq) $ >
  $ wi (wa (wa (wa (wcel A2 cnp) (wcel (cv g1) (cfv A2 c2nd))) (wa (wcel B2 cnp) (wcel (cv h) (cfv B2 c2nd)))) (wcel (cv x3) cnq)) (wi (wbr (co (cv g1) (cv h) G) (cv x3) cltq) (wcel (cv x3) (cfv (co A2 B2 F) c2nd))) $ >
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wi (wcel (cv f2) (cfv (co A2 B2 F) c2nd)) (wi (wbr (cv f2) (cv x3) cltq) (wcel (cv x3) (cfv (co A2 B2 F) c2nd)))) $;

--| The lower cut produced by addition or multiplication on positive reals is rounded. (Contributed by Jim Kingdon, 7-Oct-2019.)
theorem genprndl {x3 y1 z w v g1 h r q: setvar} (A2 B2 F G: class):
  $ wceq F (cmpt2 w v cnp cnp (cop (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c1st)) (wcel (cv z) (cfv (cv v) c1st)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq) (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c2nd)) (wcel (cv z) (cfv (cv v) c2nd)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq))) $ >
  $ wi (wa (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wcel (co (cv y1) (cv z) G) cnq) $ >
  $ wi (w3a (wcel (cv x3) cnq) (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wb (wbr (cv x3) (cv y1) cltq) (wbr (co (cv z) (cv x3) G) (co (cv z) (cv y1) G) cltq)) $ >
  $ wi (wa (wcel (cv x3) cnq) (wcel (cv y1) cnq)) (wceq (co (cv x3) (cv y1) G) (co (cv y1) (cv x3) G)) $ >
  $ wi (wa (wa (wa (wcel A2 cnp) (wcel (cv g1) (cfv A2 c1st))) (wa (wcel B2 cnp) (wcel (cv h) (cfv B2 c1st)))) (wcel (cv x3) cnq)) (wi (wbr (cv x3) (co (cv g1) (cv h) G) cltq) (wcel (cv x3) (cfv (co A2 B2 F) c1st))) $ >
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wral q (wb (wcel (cv q) (cfv (co A2 B2 F) c1st)) (wrex r (wa (wbr (cv q) (cv r) cltq) (wcel (cv r) (cfv (co A2 B2 F) c1st))) cnq)) cnq) $;

--| The upper cut produced by addition or multiplication on positive reals is rounded. (Contributed by Jim Kingdon, 7-Oct-2019.)
theorem genprndu {x3 y1 z w v g1 h r q: setvar} (A2 B2 F G: class):
  $ wceq F (cmpt2 w v cnp cnp (cop (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c1st)) (wcel (cv z) (cfv (cv v) c1st)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq) (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c2nd)) (wcel (cv z) (cfv (cv v) c2nd)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq))) $ >
  $ wi (wa (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wcel (co (cv y1) (cv z) G) cnq) $ >
  $ wi (w3a (wcel (cv x3) cnq) (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wb (wbr (cv x3) (cv y1) cltq) (wbr (co (cv z) (cv x3) G) (co (cv z) (cv y1) G) cltq)) $ >
  $ wi (wa (wcel (cv x3) cnq) (wcel (cv y1) cnq)) (wceq (co (cv x3) (cv y1) G) (co (cv y1) (cv x3) G)) $ >
  $ wi (wa (wa (wa (wcel A2 cnp) (wcel (cv g1) (cfv A2 c2nd))) (wa (wcel B2 cnp) (wcel (cv h) (cfv B2 c2nd)))) (wcel (cv x3) cnq)) (wi (wbr (co (cv g1) (cv h) G) (cv x3) cltq) (wcel (cv x3) (cfv (co A2 B2 F) c2nd))) $ >
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wral r (wb (wcel (cv r) (cfv (co A2 B2 F) c2nd)) (wrex q (wa (wbr (cv q) (cv r) cltq) (wcel (cv q) (cfv (co A2 B2 F) c2nd))) cnq)) cnq) $;

--| The lower and upper cuts produced by addition or multiplication on positive reals are disjoint. (Contributed by Jim Kingdon, 15-Oct-2019.)
theorem genpdisj {x3 y1 z w v q: setvar} (A2 B2: class) (F: class x3 y1 z w v) (G: class):
  $ wceq F (cmpt2 w v cnp cnp (cop (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c1st)) (wcel (cv z) (cfv (cv v) c1st)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq) (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c2nd)) (wcel (cv z) (cfv (cv v) c2nd)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq))) $ >
  $ wi (wa (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wcel (co (cv y1) (cv z) G) cnq) $ >
  $ wi (w3a (wcel (cv x3) cnq) (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wb (wbr (cv x3) (cv y1) cltq) (wbr (co (cv z) (cv x3) G) (co (cv z) (cv y1) G) cltq)) $ >
  $ wi (wa (wcel (cv x3) cnq) (wcel (cv y1) cnq)) (wceq (co (cv x3) (cv y1) G) (co (cv y1) (cv x3) G)) $ >
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wral q (wn (wa (wcel (cv q) (cfv (co A2 B2 F) c1st)) (wcel (cv q) (cfv (co A2 B2 F) c2nd)))) cnq) $;

--| Associativity of lower cuts. Lemma for ~ genpassg . (Contributed by Jim Kingdon, 11-Dec-2019.)
theorem genpassl {x3 y1 z w v f2 g1 h: setvar} (A2 B2 C F G: class):
  $ wceq F (cmpt2 w v cnp cnp (cop (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c1st)) (wcel (cv z) (cfv (cv v) c1st)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq) (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c2nd)) (wcel (cv z) (cfv (cv v) c2nd)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq))) $ >
  $ wi (wa (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wcel (co (cv y1) (cv z) G) cnq) $ >
  $ wceq (cdm F) (cxp cnp cnp) $ >
  $ wi (wa (wcel (cv f2) cnp) (wcel (cv g1) cnp)) (wcel (co (cv f2) (cv g1) F) cnp) $ >
  $ wi (w3a (wcel (cv f2) cnq) (wcel (cv g1) cnq) (wcel (cv h) cnq)) (wceq (co (co (cv f2) (cv g1) G) (cv h) G) (co (cv f2) (co (cv g1) (cv h) G) G)) $ >
  $ wi (w3a (wcel A2 cnp) (wcel B2 cnp) (wcel C cnp)) (wceq (cfv (co (co A2 B2 F) C F) c1st) (cfv (co A2 (co B2 C F) F) c1st)) $;

--| Associativity of upper cuts. Lemma for ~ genpassg . (Contributed by Jim Kingdon, 11-Dec-2019.)
theorem genpassu {x3 y1 z w v f2 g1 h: setvar} (A2 B2 C F G: class):
  $ wceq F (cmpt2 w v cnp cnp (cop (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c1st)) (wcel (cv z) (cfv (cv v) c1st)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq) (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c2nd)) (wcel (cv z) (cfv (cv v) c2nd)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq))) $ >
  $ wi (wa (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wcel (co (cv y1) (cv z) G) cnq) $ >
  $ wceq (cdm F) (cxp cnp cnp) $ >
  $ wi (wa (wcel (cv f2) cnp) (wcel (cv g1) cnp)) (wcel (co (cv f2) (cv g1) F) cnp) $ >
  $ wi (w3a (wcel (cv f2) cnq) (wcel (cv g1) cnq) (wcel (cv h) cnq)) (wceq (co (co (cv f2) (cv g1) G) (cv h) G) (co (cv f2) (co (cv g1) (cv h) G) G)) $ >
  $ wi (w3a (wcel A2 cnp) (wcel B2 cnp) (wcel C cnp)) (wceq (cfv (co (co A2 B2 F) C F) c2nd) (cfv (co A2 (co B2 C F) F) c2nd)) $;

--| Associativity of an operation on reals. (Contributed by Jim Kingdon, 11-Dec-2019.)
theorem genpassg {x3 y1 z w v f2 g1 h: setvar} (A2 B2 C F G: class):
  $ wceq F (cmpt2 w v cnp cnp (cop (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c1st)) (wcel (cv z) (cfv (cv v) c1st)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq) (crab x3 (wrex y1 (wrex z (w3a (wcel (cv y1) (cfv (cv w) c2nd)) (wcel (cv z) (cfv (cv v) c2nd)) (wceq (cv x3) (co (cv y1) (cv z) G))) cnq) cnq) cnq))) $ >
  $ wi (wa (wcel (cv y1) cnq) (wcel (cv z) cnq)) (wcel (co (cv y1) (cv z) G) cnq) $ >
  $ wceq (cdm F) (cxp cnp cnp) $ >
  $ wi (wa (wcel (cv f2) cnp) (wcel (cv g1) cnp)) (wcel (co (cv f2) (cv g1) F) cnp) $ >
  $ wi (w3a (wcel (cv f2) cnq) (wcel (cv g1) cnq) (wcel (cv h) cnq)) (wceq (co (co (cv f2) (cv g1) G) (cv h) G) (co (cv f2) (co (cv g1) (cv h) G) G)) $ >
  $ wi (w3a (wcel A2 cnp) (wcel B2 cnp) (wcel C cnp)) (wceq (co (co A2 B2 F) C F) (co A2 (co B2 C F) F)) $;

--| Lemma to prove downward closure in positive real addition. (Contributed by Jim Kingdon, 7-Dec-2019.)
theorem addnqprllem (S U G L X: class):
  $ wi (wa (wa (wcel (cop L U) cnp) (wcel G L)) (wcel X cnq)) (wi (wbr X S cltq) (wcel (co (co X (cfv S crq) cmq) G cmq) L)) $;

--| Lemma to prove upward closure in positive real addition. (Contributed by Jim Kingdon, 7-Dec-2019.)
theorem addnqprulem (S U G L X: class):
  $ wi (wa (wa (wcel (cop L U) cnp) (wcel G U)) (wcel X cnq)) (wi (wbr S X cltq) (wcel (co (co X (cfv S crq) cmq) G cmq) U)) $;

--| Lemma to prove downward closure in positive real addition. (Contributed by Jim Kingdon, 5-Dec-2019.)
theorem addnqprl (A2 B2 G H X: class):
  $ wi (wa (wa (wa (wcel A2 cnp) (wcel G (cfv A2 c1st))) (wa (wcel B2 cnp) (wcel H (cfv B2 c1st)))) (wcel X cnq)) (wi (wbr X (co G H cplq) cltq) (wcel X (cfv (co A2 B2 cpp) c1st))) $;

--| Lemma to prove upward closure in positive real addition. (Contributed by Jim Kingdon, 5-Dec-2019.)
theorem addnqpru (A2 B2 G H X: class):
  $ wi (wa (wa (wa (wcel A2 cnp) (wcel G (cfv A2 c2nd))) (wa (wcel B2 cnp) (wcel H (cfv B2 c2nd)))) (wcel X cnq)) (wi (wbr (co G H cplq) X cltq) (wcel X (cfv (co A2 B2 cpp) c2nd))) $;

--| Lemma for ~ addlocpr . The ` Q <Q ( D +Q E ) ` case. (Contributed by Jim Kingdon, 6-Dec-2019.)
theorem addlocprlemlt (ph: wff) (A2 B2 D P Q R T U E: class):
  $ wi ph (wcel A2 cnp) $ >
  $ wi ph (wcel B2 cnp) $ >
  $ wi ph (wbr Q R cltq) $ >
  $ wi ph (wcel P cnq) $ >
  $ wi ph (wceq (co Q (co P P cplq) cplq) R) $ >
  $ wi ph (wcel D (cfv A2 c1st)) $ >
  $ wi ph (wcel U (cfv A2 c2nd)) $ >
  $ wi ph (wbr U (co D P cplq) cltq) $ >
  $ wi ph (wcel E (cfv B2 c1st)) $ >
  $ wi ph (wcel T (cfv B2 c2nd)) $ >
  $ wi ph (wbr T (co E P cplq) cltq) $ >
  $ wi ph (wi (wbr Q (co D E cplq) cltq) (wcel Q (cfv (co A2 B2 cpp) c1st))) $;

--| Lemma for ~ addlocpr . This is a step used in both the ` Q = ( D +Q E ) ` and ` ( D +Q E ) <Q Q ` cases. (Contributed by Jim Kingdon, 7-Dec-2019.)
theorem addlocprlemeqgt (ph: wff) (A2 B2 D P Q R T U E: class):
  $ wi ph (wcel A2 cnp) $ >
  $ wi ph (wcel B2 cnp) $ >
  $ wi ph (wbr Q R cltq) $ >
  $ wi ph (wcel P cnq) $ >
  $ wi ph (wceq (co Q (co P P cplq) cplq) R) $ >
  $ wi ph (wcel D (cfv A2 c1st)) $ >
  $ wi ph (wcel U (cfv A2 c2nd)) $ >
  $ wi ph (wbr U (co D P cplq) cltq) $ >
  $ wi ph (wcel E (cfv B2 c1st)) $ >
  $ wi ph (wcel T (cfv B2 c2nd)) $ >
  $ wi ph (wbr T (co E P cplq) cltq) $ >
  $ wi ph (wbr (co U T cplq) (co (co D E cplq) (co P P cplq) cplq) cltq) $;

--| Lemma for ~ addlocpr . The ` Q = ( D +Q E ) ` case. (Contributed by Jim Kingdon, 6-Dec-2019.)
theorem addlocprlemeq (ph: wff) (A2 B2 D P Q R T U E: class):
  $ wi ph (wcel A2 cnp) $ >
  $ wi ph (wcel B2 cnp) $ >
  $ wi ph (wbr Q R cltq) $ >
  $ wi ph (wcel P cnq) $ >
  $ wi ph (wceq (co Q (co P P cplq) cplq) R) $ >
  $ wi ph (wcel D (cfv A2 c1st)) $ >
  $ wi ph (wcel U (cfv A2 c2nd)) $ >
  $ wi ph (wbr U (co D P cplq) cltq) $ >
  $ wi ph (wcel E (cfv B2 c1st)) $ >
  $ wi ph (wcel T (cfv B2 c2nd)) $ >
  $ wi ph (wbr T (co E P cplq) cltq) $ >
  $ wi ph (wi (wceq Q (co D E cplq)) (wcel R (cfv (co A2 B2 cpp) c2nd))) $;

--| Lemma for ~ addlocpr . The ` ( D +Q E ) <Q Q ` case. (Contributed by Jim Kingdon, 6-Dec-2019.)
theorem addlocprlemgt (ph: wff) (A2 B2 D P Q R T U E: class):
  $ wi ph (wcel A2 cnp) $ >
  $ wi ph (wcel B2 cnp) $ >
  $ wi ph (wbr Q R cltq) $ >
  $ wi ph (wcel P cnq) $ >
  $ wi ph (wceq (co Q (co P P cplq) cplq) R) $ >
  $ wi ph (wcel D (cfv A2 c1st)) $ >
  $ wi ph (wcel U (cfv A2 c2nd)) $ >
  $ wi ph (wbr U (co D P cplq) cltq) $ >
  $ wi ph (wcel E (cfv B2 c1st)) $ >
  $ wi ph (wcel T (cfv B2 c2nd)) $ >
  $ wi ph (wbr T (co E P cplq) cltq) $ >
  $ wi ph (wi (wbr (co D E cplq) Q cltq) (wcel R (cfv (co A2 B2 cpp) c2nd))) $;

--| Lemma for ~ addlocpr . The result, in deduction form. (Contributed by Jim Kingdon, 6-Dec-2019.)
theorem addlocprlem (ph: wff) (A2 B2 D P Q R T U E: class):
  $ wi ph (wcel A2 cnp) $ >
  $ wi ph (wcel B2 cnp) $ >
  $ wi ph (wbr Q R cltq) $ >
  $ wi ph (wcel P cnq) $ >
  $ wi ph (wceq (co Q (co P P cplq) cplq) R) $ >
  $ wi ph (wcel D (cfv A2 c1st)) $ >
  $ wi ph (wcel U (cfv A2 c2nd)) $ >
  $ wi ph (wbr U (co D P cplq) cltq) $ >
  $ wi ph (wcel E (cfv B2 c1st)) $ >
  $ wi ph (wcel T (cfv B2 c2nd)) $ >
  $ wi ph (wbr T (co E P cplq) cltq) $ >
  $ wi ph (wo (wcel Q (cfv (co A2 B2 cpp) c1st)) (wcel R (cfv (co A2 B2 cpp) c2nd))) $;

--| Locatedness of addition on positive reals. Lemma 11.16 in [BauerTaylor], p. 53. The proof in BauerTaylor relies on signed rationals, so we replace it with another proof which applies ~ prarloc to both ` A ` and ` B ` , and uses ~ nqtri3or rather than ~ prloc to decide whether ` q ` is too big to be in the lower cut of ` A +P. B ` (and deduce that if it is, then ` r ` must be in the upper cut). What the two proofs have in common is that they take the difference between ` q ` and ` r ` to determine how tight a range they need around the real numbers. (Contributed by Jim Kingdon, 5-Dec-2019.)
theorem addlocpr {r q: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wral q (wral r (wi (wbr (cv q) (cv r) cltq) (wo (wcel (cv q) (cfv (co A2 B2 cpp) c1st)) (wcel (cv r) (cfv (co A2 B2 cpp) c2nd)))) cnq) cnq) $;

--| Closure of addition on positive reals. First statement of Proposition 9-3.5 of [Gleason] p. 123. Combination of Lemma 11.13 and Lemma 11.16 in [BauerTaylor], p. 53. (Contributed by NM, 13-Mar-1996.)
theorem addclpr (A2 B2: class):
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wcel (co A2 B2 cpp) cnp) $;

--| Value of addition on positive reals. (Contributed by Jim Kingdon, 8-Dec-2019.)
theorem plpvlu {x3 y1 z: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wceq (co A2 B2 cpp) (cop (crab x3 (wrex y1 (wrex z (wceq (cv x3) (co (cv y1) (cv z) cplq)) (cfv B2 c1st)) (cfv A2 c1st)) cnq) (crab x3 (wrex y1 (wrex z (wceq (cv x3) (co (cv y1) (cv z) cplq)) (cfv B2 c2nd)) (cfv A2 c2nd)) cnq))) $;

--| Value of multiplication on positive reals. (Contributed by Jim Kingdon, 8-Dec-2019.)
theorem mpvlu {x3 y1 z: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wceq (co A2 B2 cmp) (cop (crab x3 (wrex y1 (wrex z (wceq (cv x3) (co (cv y1) (cv z) cmq)) (cfv B2 c1st)) (cfv A2 c1st)) cnq) (crab x3 (wrex y1 (wrex z (wceq (cv x3) (co (cv y1) (cv z) cmq)) (cfv B2 c2nd)) (cfv A2 c2nd)) cnq))) $;

--| Domain of addition on positive reals. (Contributed by NM, 18-Nov-1995.)
theorem dmplp:
  $ wceq (cdm cpp) (cxp cnp cnp) $;

--| Domain of multiplication on positive reals. (Contributed by NM, 18-Nov-1995.)
theorem dmmp:
  $ wceq (cdm cmp) (cxp cnp cnp) $;

--| A cut produced from a rational is inhabited. Lemma for ~ nqprlu . (Contributed by Jim Kingdon, 8-Dec-2019.)
theorem nqprm {x3 r q: setvar} (A2: class):
  $ wi (wcel A2 cnq) (wa (wrex q (wcel (cv q) (cab x3 (wbr (cv x3) A2 cltq))) cnq) (wrex r (wcel (cv r) (cab x3 (wbr A2 (cv x3) cltq))) cnq)) $;

--| A cut produced from a rational is rounded. Lemma for ~ nqprlu . (Contributed by Jim Kingdon, 8-Dec-2019.)
theorem nqprrnd {x3 r q: setvar} (A2: class):
  $ wi (wcel A2 cnq) (wa (wral q (wb (wcel (cv q) (cab x3 (wbr (cv x3) A2 cltq))) (wrex r (wa (wbr (cv q) (cv r) cltq) (wcel (cv r) (cab x3 (wbr (cv x3) A2 cltq)))) cnq)) cnq) (wral r (wb (wcel (cv r) (cab x3 (wbr A2 (cv x3) cltq))) (wrex q (wa (wbr (cv q) (cv r) cltq) (wcel (cv q) (cab x3 (wbr A2 (cv x3) cltq)))) cnq)) cnq)) $;

--| A cut produced from a rational is disjoint. Lemma for ~ nqprlu . (Contributed by Jim Kingdon, 8-Dec-2019.)
theorem nqprdisj {x3 q: setvar} (A2: class):
  $ wi (wcel A2 cnq) (wral q (wn (wa (wcel (cv q) (cab x3 (wbr (cv x3) A2 cltq))) (wcel (cv q) (cab x3 (wbr A2 (cv x3) cltq))))) cnq) $;

--| A cut produced from a rational is located. Lemma for ~ nqprlu . (Contributed by Jim Kingdon, 8-Dec-2019.)
theorem nqprloc {x3 r q: setvar} (A2: class):
  $ wi (wcel A2 cnq) (wral q (wral r (wi (wbr (cv q) (cv r) cltq) (wo (wcel (cv q) (cab x3 (wbr (cv x3) A2 cltq))) (wcel (cv r) (cab x3 (wbr A2 (cv x3) cltq))))) cnq) cnq) $;

--| The canonical embedding of the rationals into the reals, expressed with the same variable for the lower and upper cuts. (Contributed by Jim Kingdon, 8-Dec-2019.)
theorem nqprxx {x3: setvar} (A2: class):
  $ wi (wcel A2 cnq) (wcel (cop (cab x3 (wbr (cv x3) A2 cltq)) (cab x3 (wbr A2 (cv x3) cltq))) cnp) $;

--| The canonical embedding of the rationals into the reals. (Contributed by Jim Kingdon, 24-Jun-2020.)
theorem nqprlu {u l: setvar} (A2: class):
  $ wi (wcel A2 cnq) (wcel (cop (cab l (wbr (cv l) A2 cltq)) (cab u (wbr A2 (cv u) cltq))) cnp) $;

--| The reciprocal of a positive integer, as a positive real. (Contributed by Jim Kingdon, 27-Feb-2021.)
theorem recnnpr {u l: setvar} (A2: class):
  $ wi (wcel A2 cnpi) (wcel (cop (cab l (wbr (cv l) (cfv (cec (cop A2 c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop A2 c1o) ceq) crq) (cv u) cltq))) cnp) $;

--| The class of rationals less than a given rational is a set. (Contributed by Jim Kingdon, 13-Dec-2019.)
theorem ltnqex {x3: setvar} (A2: class x3):
  $ wcel (cab x3 (wbr (cv x3) A2 cltq)) cvv $;

--| The class of rationals greater than a given rational is a set. (Contributed by Jim Kingdon, 13-Dec-2019.)
theorem gtnqex {x3: setvar} (A2: class x3):
  $ wcel (cab x3 (wbr A2 (cv x3) cltq)) cvv $;

--| Comparing a fraction to a real can be done by whether it is an element of the lower cut, or by ` <P ` . (Contributed by Jim Kingdon, 8-Jul-2020.)
theorem nqprl {u l: setvar} (A2: class) (B2: class u l):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnp)) (wb (wcel A2 (cfv B2 c1st)) (wbr (cop (cab l (wbr (cv l) A2 cltq)) (cab u (wbr A2 (cv u) cltq))) B2 cltp)) $;

--| Comparing a fraction to a real can be done by whether it is an element of the upper cut, or by ` <P ` . (Contributed by Jim Kingdon, 29-Nov-2020.)
theorem nqpru {u l: setvar} (A2: class) (B2: class u l):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnp)) (wb (wcel A2 (cfv B2 c2nd)) (wbr B2 (cop (cab l (wbr (cv l) A2 cltq)) (cab u (wbr A2 (cv u) cltq))) cltp)) $;

--| The canonical embedding of positive integers into the positive reals. (Contributed by Jim Kingdon, 23-Apr-2020.)
theorem nnprlu {u l: setvar} (A2: class):
  $ wi (wcel A2 cnpi) (wcel (cop (cab l (wbr (cv l) (cec (cop A2 c1o) ceq) cltq)) (cab u (wbr (cec (cop A2 c1o) ceq) (cv u) cltq))) cnp) $;

--| The positive real number 'one'. (Contributed by NM, 13-Mar-1996.) (Revised by Mario Carneiro, 12-Jun-2013.)
theorem _1pr:
  $ wcel c1p cnp $;

--| The lower cut of the positive real number 'one'. (Contributed by Jim Kingdon, 28-Dec-2019.)
theorem _1prl {x3: setvar}:
  $ wceq (cfv c1p c1st) (cab x3 (wbr (cv x3) c1q cltq)) $;

--| The upper cut of the positive real number 'one'. (Contributed by Jim Kingdon, 28-Dec-2019.)
theorem _1pru {x3: setvar}:
  $ wceq (cfv c1p c2nd) (cab x3 (wbr c1q (cv x3) cltq)) $;

--| Lemma for ~ addnqpr . The reverse subset relationship for the lower cut. (Contributed by Jim Kingdon, 19-Aug-2020.)
theorem addnqprlemrl {u l: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wss (cfv (co (cop (cab l (wbr (cv l) A2 cltq)) (cab u (wbr A2 (cv u) cltq))) (cop (cab l (wbr (cv l) B2 cltq)) (cab u (wbr B2 (cv u) cltq))) cpp) c1st) (cfv (cop (cab l (wbr (cv l) (co A2 B2 cplq) cltq)) (cab u (wbr (co A2 B2 cplq) (cv u) cltq))) c1st)) $;

--| Lemma for ~ addnqpr . The reverse subset relationship for the upper cut. (Contributed by Jim Kingdon, 19-Aug-2020.)
theorem addnqprlemru {u l: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wss (cfv (co (cop (cab l (wbr (cv l) A2 cltq)) (cab u (wbr A2 (cv u) cltq))) (cop (cab l (wbr (cv l) B2 cltq)) (cab u (wbr B2 (cv u) cltq))) cpp) c2nd) (cfv (cop (cab l (wbr (cv l) (co A2 B2 cplq) cltq)) (cab u (wbr (co A2 B2 cplq) (cv u) cltq))) c2nd)) $;

--| Lemma for ~ addnqpr . The forward subset relationship for the lower cut. (Contributed by Jim Kingdon, 19-Aug-2020.)
theorem addnqprlemfl {u l: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wss (cfv (cop (cab l (wbr (cv l) (co A2 B2 cplq) cltq)) (cab u (wbr (co A2 B2 cplq) (cv u) cltq))) c1st) (cfv (co (cop (cab l (wbr (cv l) A2 cltq)) (cab u (wbr A2 (cv u) cltq))) (cop (cab l (wbr (cv l) B2 cltq)) (cab u (wbr B2 (cv u) cltq))) cpp) c1st)) $;

--| Lemma for ~ addnqpr . The forward subset relationship for the upper cut. (Contributed by Jim Kingdon, 19-Aug-2020.)
theorem addnqprlemfu {u l: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wss (cfv (cop (cab l (wbr (cv l) (co A2 B2 cplq) cltq)) (cab u (wbr (co A2 B2 cplq) (cv u) cltq))) c2nd) (cfv (co (cop (cab l (wbr (cv l) A2 cltq)) (cab u (wbr A2 (cv u) cltq))) (cop (cab l (wbr (cv l) B2 cltq)) (cab u (wbr B2 (cv u) cltq))) cpp) c2nd)) $;

--| Addition of fractions embedded into positive reals. One can either add the fractions as fractions, or embed them into positive reals and add them as positive reals, and get the same result. (Contributed by Jim Kingdon, 19-Aug-2020.)
theorem addnqpr {u l: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wceq (cop (cab l (wbr (cv l) (co A2 B2 cplq) cltq)) (cab u (wbr (co A2 B2 cplq) (cv u) cltq))) (co (cop (cab l (wbr (cv l) A2 cltq)) (cab u (wbr A2 (cv u) cltq))) (cop (cab l (wbr (cv l) B2 cltq)) (cab u (wbr B2 (cv u) cltq))) cpp)) $;

--| Addition of one to a fraction embedded into a positive real. One can either add the fraction one to the fraction, or the positive real one to the positive real, and get the same result. Special case of ~ addnqpr . (Contributed by Jim Kingdon, 26-Apr-2020.)
theorem addnqpr1 {u l: setvar} (A2: class):
  $ wi (wcel A2 cnq) (wceq (cop (cab l (wbr (cv l) (co A2 c1q cplq) cltq)) (cab u (wbr (co A2 c1q cplq) (cv u) cltq))) (co (cop (cab l (wbr (cv l) A2 cltq)) (cab u (wbr A2 (cv u) cltq))) c1p cpp)) $;

--| Approximate division for positive rationals. Proposition 12.7 of [BauerTaylor], p. 55 (a special case where ` A ` and ` B ` are positive, as well as ` C ` ). Our proof is simpler than the one in BauerTaylor because we have reciprocals. (Contributed by Jim Kingdon, 8-Dec-2019.)
theorem appdivnq {m: setvar} (A2 B2 C: class):
  $ wi (wa (wbr A2 B2 cltq) (wcel C cnq)) (wrex m (wa (wbr A2 (co (cv m) C cmq) cltq) (wbr (co (cv m) C cmq) B2 cltq)) cnq) $;

--| Approximate division for positive rationals. This can be thought of as a variation of ~ appdivnq in which ` A ` is zero, although it can be stated and proved in terms of positive rationals alone, without zero as such. (Contributed by Jim Kingdon, 9-Dec-2019.)
theorem appdiv0nq {m: setvar} (B2 C: class):
  $ wi (wa (wcel B2 cnq) (wcel C cnq)) (wrex m (wbr (co (cv m) C cmq) B2 cltq) cnq) $;

--| Calculations for ~ prmuloc . (Contributed by Jim Kingdon, 9-Dec-2019.)
theorem prmuloclemcalc (ph: wff) (A2 B2 D P R U X: class):
  $ wi ph (wbr R U cltq) $ >
  $ wi ph (wbr U (co D P cplq) cltq) $ >
  $ wi ph (wceq (co A2 X cplq) B2) $ >
  $ wi ph (wbr (co P B2 cmq) (co R X cmq) cltq) $ >
  $ wi ph (wcel A2 cnq) $ >
  $ wi ph (wcel B2 cnq) $ >
  $ wi ph (wcel D cnq) $ >
  $ wi ph (wcel P cnq) $ >
  $ wi ph (wcel X cnq) $ >
  $ wi ph (wbr (co U A2 cmq) (co D B2 cmq) cltq) $;

--| Positive reals are multiplicatively located. Lemma 12.8 of [BauerTaylor], p. 56. (Contributed by Jim Kingdon, 8-Dec-2019.)
theorem prmuloc {u d: setvar} (A2 B2 U L: class):
  $ wi (wa (wcel (cop L U) cnp) (wbr A2 B2 cltq)) (wrex d (wrex u (w3a (wcel (cv d) L) (wcel (cv u) U) (wbr (co (cv u) A2 cmq) (co (cv d) B2 cmq) cltq)) cnq) cnq) $;

--| Positive reals are multiplicatively located. This is a variation of ~ prmuloc which only constructs one (named) point and is therefore often easier to work with. It states that given a ratio ` B ` , there are elements of the lower and upper cut which have exactly that ratio between them. (Contributed by Jim Kingdon, 28-Dec-2019.)
theorem prmuloc2 {x3: setvar} (B2 U L: class):
  $ wi (wa (wcel (cop L U) cnp) (wbr c1q B2 cltq)) (wrex x3 (wcel (co (cv x3) B2 cmq) U) L) $;

--| Lemma to prove downward closure in positive real multiplication. (Contributed by Jim Kingdon, 10-Dec-2019.)
theorem mulnqprl (A2 B2 G H X: class):
  $ wi (wa (wa (wa (wcel A2 cnp) (wcel G (cfv A2 c1st))) (wa (wcel B2 cnp) (wcel H (cfv B2 c1st)))) (wcel X cnq)) (wi (wbr X (co G H cmq) cltq) (wcel X (cfv (co A2 B2 cmp) c1st))) $;

--| Lemma to prove upward closure in positive real multiplication. (Contributed by Jim Kingdon, 10-Dec-2019.)
theorem mulnqpru (A2 B2 G H X: class):
  $ wi (wa (wa (wa (wcel A2 cnp) (wcel G (cfv A2 c2nd))) (wa (wcel B2 cnp) (wcel H (cfv B2 c2nd)))) (wcel X cnq)) (wi (wbr (co G H cmq) X cltq) (wcel X (cfv (co A2 B2 cmp) c2nd))) $;

--| Calculations for ~ mullocpr . (Contributed by Jim Kingdon, 10-Dec-2019.)
theorem mullocprlem (ph: wff) (A2 B2 D Q R T U E: class):
  $ wi ph (wa (wcel A2 cnp) (wcel B2 cnp)) $ >
  $ wi ph (wbr (co U Q cmq) (co E (co D U cmq) cmq) cltq) $ >
  $ wi ph (wbr (co E (co D U cmq) cmq) (co T (co D U cmq) cmq) cltq) $ >
  $ wi ph (wbr (co T (co D U cmq) cmq) (co D R cmq) cltq) $ >
  $ wi ph (wa (wcel Q cnq) (wcel R cnq)) $ >
  $ wi ph (wa (wcel D cnq) (wcel U cnq)) $ >
  $ wi ph (wa (wcel D (cfv A2 c1st)) (wcel U (cfv A2 c2nd))) $ >
  $ wi ph (wa (wcel E cnq) (wcel T cnq)) $ >
  $ wi ph (wo (wcel Q (cfv (co A2 B2 cmp) c1st)) (wcel R (cfv (co A2 B2 cmp) c2nd))) $;

--| Locatedness of multiplication on positive reals. Lemma 12.9 in [BauerTaylor], p. 56 (but where both ` A ` and ` B ` are positive, not just ` A ` ). (Contributed by Jim Kingdon, 8-Dec-2019.)
theorem mullocpr {r q: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wral q (wral r (wi (wbr (cv q) (cv r) cltq) (wo (wcel (cv q) (cfv (co A2 B2 cmp) c1st)) (wcel (cv r) (cfv (co A2 B2 cmp) c2nd)))) cnq) cnq) $;

--| Closure of multiplication on positive reals. First statement of Proposition 9-3.7 of [Gleason] p. 124. (Contributed by NM, 13-Mar-1996.)
theorem mulclpr (A2 B2: class):
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wcel (co A2 B2 cmp) cnp) $;

--| Lemma for ~ mulnqpr . The reverse subset relationship for the lower cut. (Contributed by Jim Kingdon, 18-Jul-2021.)
theorem mulnqprlemrl {u l: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wss (cfv (co (cop (cab l (wbr (cv l) A2 cltq)) (cab u (wbr A2 (cv u) cltq))) (cop (cab l (wbr (cv l) B2 cltq)) (cab u (wbr B2 (cv u) cltq))) cmp) c1st) (cfv (cop (cab l (wbr (cv l) (co A2 B2 cmq) cltq)) (cab u (wbr (co A2 B2 cmq) (cv u) cltq))) c1st)) $;

--| Lemma for ~ mulnqpr . The reverse subset relationship for the upper cut. (Contributed by Jim Kingdon, 18-Jul-2021.)
theorem mulnqprlemru {u l: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wss (cfv (co (cop (cab l (wbr (cv l) A2 cltq)) (cab u (wbr A2 (cv u) cltq))) (cop (cab l (wbr (cv l) B2 cltq)) (cab u (wbr B2 (cv u) cltq))) cmp) c2nd) (cfv (cop (cab l (wbr (cv l) (co A2 B2 cmq) cltq)) (cab u (wbr (co A2 B2 cmq) (cv u) cltq))) c2nd)) $;

--| Lemma for ~ mulnqpr . The forward subset relationship for the lower cut. (Contributed by Jim Kingdon, 18-Jul-2021.)
theorem mulnqprlemfl {u l: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wss (cfv (cop (cab l (wbr (cv l) (co A2 B2 cmq) cltq)) (cab u (wbr (co A2 B2 cmq) (cv u) cltq))) c1st) (cfv (co (cop (cab l (wbr (cv l) A2 cltq)) (cab u (wbr A2 (cv u) cltq))) (cop (cab l (wbr (cv l) B2 cltq)) (cab u (wbr B2 (cv u) cltq))) cmp) c1st)) $;

--| Lemma for ~ mulnqpr . The forward subset relationship for the upper cut. (Contributed by Jim Kingdon, 18-Jul-2021.)
theorem mulnqprlemfu {u l: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wss (cfv (cop (cab l (wbr (cv l) (co A2 B2 cmq) cltq)) (cab u (wbr (co A2 B2 cmq) (cv u) cltq))) c2nd) (cfv (co (cop (cab l (wbr (cv l) A2 cltq)) (cab u (wbr A2 (cv u) cltq))) (cop (cab l (wbr (cv l) B2 cltq)) (cab u (wbr B2 (cv u) cltq))) cmp) c2nd)) $;

--| Multiplication of fractions embedded into positive reals. One can either multiply the fractions as fractions, or embed them into positive reals and multiply them as positive reals, and get the same result. (Contributed by Jim Kingdon, 18-Jul-2021.)
theorem mulnqpr {u l: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wceq (cop (cab l (wbr (cv l) (co A2 B2 cmq) cltq)) (cab u (wbr (co A2 B2 cmq) (cv u) cltq))) (co (cop (cab l (wbr (cv l) A2 cltq)) (cab u (wbr A2 (cv u) cltq))) (cop (cab l (wbr (cv l) B2 cltq)) (cab u (wbr B2 (cv u) cltq))) cmp)) $;

--| Addition of positive reals is commutative. Proposition 9-3.5(ii) of [Gleason] p. 123. (Contributed by Jim Kingdon, 11-Dec-2019.)
theorem addcomprg (A2 B2: class):
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wceq (co A2 B2 cpp) (co B2 A2 cpp)) $;

--| Addition of positive reals is associative. Proposition 9-3.5(i) of [Gleason] p. 123. (Contributed by Jim Kingdon, 11-Dec-2019.)
theorem addassprg (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnp) (wcel B2 cnp) (wcel C cnp)) (wceq (co (co A2 B2 cpp) C cpp) (co A2 (co B2 C cpp) cpp)) $;

--| Multiplication of positive reals is commutative. Proposition 9-3.7(ii) of [Gleason] p. 124. (Contributed by Jim Kingdon, 11-Dec-2019.)
theorem mulcomprg (A2 B2: class):
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wceq (co A2 B2 cmp) (co B2 A2 cmp)) $;

--| Multiplication of positive reals is associative. Proposition 9-3.7(i) of [Gleason] p. 124. (Contributed by Jim Kingdon, 11-Dec-2019.)
theorem mulassprg (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnp) (wcel B2 cnp) (wcel C cnp)) (wceq (co (co A2 B2 cmp) C cmp) (co A2 (co B2 C cmp) cmp)) $;

--| Lemma for distributive law for positive reals. (Contributed by Jim Kingdon, 12-Dec-2019.)
theorem distrlem1prl (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnp) (wcel B2 cnp) (wcel C cnp)) (wss (cfv (co A2 (co B2 C cpp) cmp) c1st) (cfv (co (co A2 B2 cmp) (co A2 C cmp) cpp) c1st)) $;

--| Lemma for distributive law for positive reals. (Contributed by Jim Kingdon, 12-Dec-2019.)
theorem distrlem1pru (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnp) (wcel B2 cnp) (wcel C cnp)) (wss (cfv (co A2 (co B2 C cpp) cmp) c2nd) (cfv (co (co A2 B2 cmp) (co A2 C cmp) cpp) c2nd)) $;

--| Lemma for distributive law for positive reals. (Contributed by Jim Kingdon, 12-Dec-2019.)
theorem distrlem4prl (x3 y1 z: setvar) (A2 B2 C: class) (f2: setvar):
  $ wi (wa (w3a (wcel A2 cnp) (wcel B2 cnp) (wcel C cnp)) (wa (wa (wcel (cv x3) (cfv A2 c1st)) (wcel (cv y1) (cfv B2 c1st))) (wa (wcel (cv f2) (cfv A2 c1st)) (wcel (cv z) (cfv C c1st))))) (wcel (co (co (cv x3) (cv y1) cmq) (co (cv f2) (cv z) cmq) cplq) (cfv (co A2 (co B2 C cpp) cmp) c1st)) $;

--| Lemma for distributive law for positive reals. (Contributed by Jim Kingdon, 12-Dec-2019.)
theorem distrlem4pru (x3 y1 z: setvar) (A2 B2 C: class) (f2: setvar):
  $ wi (wa (w3a (wcel A2 cnp) (wcel B2 cnp) (wcel C cnp)) (wa (wa (wcel (cv x3) (cfv A2 c2nd)) (wcel (cv y1) (cfv B2 c2nd))) (wa (wcel (cv f2) (cfv A2 c2nd)) (wcel (cv z) (cfv C c2nd))))) (wcel (co (co (cv x3) (cv y1) cmq) (co (cv f2) (cv z) cmq) cplq) (cfv (co A2 (co B2 C cpp) cmp) c2nd)) $;

--| Lemma for distributive law for positive reals. (Contributed by Jim Kingdon, 12-Dec-2019.)
theorem distrlem5prl (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnp) (wcel B2 cnp) (wcel C cnp)) (wss (cfv (co (co A2 B2 cmp) (co A2 C cmp) cpp) c1st) (cfv (co A2 (co B2 C cpp) cmp) c1st)) $;

--| Lemma for distributive law for positive reals. (Contributed by Jim Kingdon, 12-Dec-2019.)
theorem distrlem5pru (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnp) (wcel B2 cnp) (wcel C cnp)) (wss (cfv (co (co A2 B2 cmp) (co A2 C cmp) cpp) c2nd) (cfv (co A2 (co B2 C cpp) cmp) c2nd)) $;

--| Multiplication of positive reals is distributive. Proposition 9-3.7(iii) of [Gleason] p. 124. (Contributed by Jim Kingdon, 12-Dec-2019.)
theorem distrprg (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnp) (wcel B2 cnp) (wcel C cnp)) (wceq (co A2 (co B2 C cpp) cmp) (co (co A2 B2 cmp) (co A2 C cmp) cpp)) $;

--| If a positive real is less than a second positive real, its lower cut is a subset of the second's lower cut. (Contributed by Jim Kingdon, 23-Dec-2019.)
theorem ltprordil (A2 B2: class):
  $ wi (wbr A2 B2 cltp) (wss (cfv A2 c1st) (cfv B2 c1st)) $;

--| Lemma for ~ 1idpr . (Contributed by Jim Kingdon, 13-Dec-2019.)
theorem _1idprl (A2: class):
  $ wi (wcel A2 cnp) (wceq (cfv (co A2 c1p cmp) c1st) (cfv A2 c1st)) $;

--| Lemma for ~ 1idpr . (Contributed by Jim Kingdon, 13-Dec-2019.)
theorem _1idpru (A2: class):
  $ wi (wcel A2 cnp) (wceq (cfv (co A2 c1p cmp) c2nd) (cfv A2 c2nd)) $;

--| 1 is an identity element for positive real multiplication. Theorem 9-3.7(iv) of [Gleason] p. 124. (Contributed by NM, 2-Apr-1996.)
theorem _1idpr (A2: class):
  $ wi (wcel A2 cnp) (wceq (co A2 c1p cmp) A2) $;

--| We can order fractions via ` <Q ` or ` <P ` . (Contributed by Jim Kingdon, 19-Jun-2021.)
theorem ltnqpr {u l: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cnq) (wcel B2 cnq)) (wb (wbr A2 B2 cltq) (wbr (cop (cab l (wbr (cv l) A2 cltq)) (cab u (wbr A2 (cv u) cltq))) (cop (cab l (wbr (cv l) B2 cltq)) (cab u (wbr B2 (cv u) cltq))) cltp)) $;

--| We can order fractions via ` <Q ` or ` <P ` . (Contributed by Jim Kingdon, 8-Jan-2021.)
theorem ltnqpri {u l: setvar} (A2 B2: class):
  $ wi (wbr A2 B2 cltq) (wbr (cop (cab l (wbr (cv l) A2 cltq)) (cab u (wbr A2 (cv u) cltq))) (cop (cab l (wbr (cv l) B2 cltq)) (cab u (wbr B2 (cv u) cltq))) cltp) $;

--| Positive real 'less than' is a partial ordering. Remark ("< is transitive and irreflexive") preceding Proposition 11.2.3 of [HoTT], p. (varies). Lemma for ~ ltsopr . (Contributed by Jim Kingdon, 15-Dec-2019.)
theorem ltpopr:
  $ wpo cnp cltp $;

--| Positive real 'less than' is a weak linear order (in the sense of ~ df-iso ). Proposition 11.2.3 of [HoTT], p. (varies). (Contributed by Jim Kingdon, 16-Dec-2019.)
theorem ltsopr:
  $ wor cnp cltp $;

--| The sum of two positive reals is greater than one of them. Proposition 9-3.5(iii) of [Gleason] p. 123. (Contributed by NM, 26-Mar-1996.) (Revised by Mario Carneiro, 12-Jun-2013.)
theorem ltaddpr (A2 B2: class):
  $ wi (wa (wcel A2 cnp) (wcel B2 cnp)) (wbr A2 (co A2 B2 cpp) cltp) $;

--| Element in lower cut of the constructed difference. Lemma for ~ ltexpri . (Contributed by Jim Kingdon, 21-Dec-2019.)
theorem ltexprlemell {x3 y1: setvar} (A2 B2 C: class) (q: setvar):
  $ wceq C (cop (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c2nd)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c1st)))) cnq) (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c1st)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c2nd)))) cnq)) $ >
  $ wb (wcel (cv q) (cfv C c1st)) (wa (wcel (cv q) cnq) (wex y1 (wa (wcel (cv y1) (cfv A2 c2nd)) (wcel (co (cv y1) (cv q) cplq) (cfv B2 c1st))))) $;

--| Element in upper cut of the constructed difference. Lemma for ~ ltexpri . (Contributed by Jim Kingdon, 21-Dec-2019.)
theorem ltexprlemelu {x3 y1: setvar} (A2 B2 C: class) (r: setvar):
  $ wceq C (cop (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c2nd)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c1st)))) cnq) (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c1st)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c2nd)))) cnq)) $ >
  $ wb (wcel (cv r) (cfv C c2nd)) (wa (wcel (cv r) cnq) (wex y1 (wa (wcel (cv y1) (cfv A2 c1st)) (wcel (co (cv y1) (cv r) cplq) (cfv B2 c2nd))))) $;

--| Our constructed difference is inhabited. Lemma for ~ ltexpri . (Contributed by Jim Kingdon, 17-Dec-2019.)
theorem ltexprlemm {x3 y1 r q: setvar} (A2 B2 C: class):
  $ wceq C (cop (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c2nd)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c1st)))) cnq) (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c1st)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c2nd)))) cnq)) $ >
  $ wi (wbr A2 B2 cltp) (wa (wrex q (wcel (cv q) (cfv C c1st)) cnq) (wrex r (wcel (cv r) (cfv C c2nd)) cnq)) $;

--| The lower cut of our constructed difference is open. Lemma for ~ ltexpri . (Contributed by Jim Kingdon, 21-Dec-2019.)
theorem ltexprlemopl {x3 y1 r: setvar} (A2 B2 C: class) (q: setvar):
  $ wceq C (cop (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c2nd)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c1st)))) cnq) (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c1st)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c2nd)))) cnq)) $ >
  $ wi (w3a (wbr A2 B2 cltp) (wcel (cv q) cnq) (wcel (cv q) (cfv C c1st))) (wrex r (wa (wbr (cv q) (cv r) cltq) (wcel (cv r) (cfv C c1st))) cnq) $;

--| The lower cut of our constructed difference is lower. Lemma for ~ ltexpri . (Contributed by Jim Kingdon, 21-Dec-2019.)
theorem ltexprlemlol {x3 y1 r: setvar} (A2 B2 C: class) (q: setvar):
  $ wceq C (cop (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c2nd)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c1st)))) cnq) (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c1st)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c2nd)))) cnq)) $ >
  $ wi (wa (wbr A2 B2 cltp) (wcel (cv q) cnq)) (wi (wrex r (wa (wbr (cv q) (cv r) cltq) (wcel (cv r) (cfv C c1st))) cnq) (wcel (cv q) (cfv C c1st))) $;

--| The upper cut of our constructed difference is open. Lemma for ~ ltexpri . (Contributed by Jim Kingdon, 21-Dec-2019.)
theorem ltexprlemopu {x3 y1 q: setvar} (A2 B2 C: class) (r: setvar):
  $ wceq C (cop (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c2nd)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c1st)))) cnq) (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c1st)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c2nd)))) cnq)) $ >
  $ wi (w3a (wbr A2 B2 cltp) (wcel (cv r) cnq) (wcel (cv r) (cfv C c2nd))) (wrex q (wa (wbr (cv q) (cv r) cltq) (wcel (cv q) (cfv C c2nd))) cnq) $;

--| The upper cut of our constructed difference is upper. Lemma for ~ ltexpri . (Contributed by Jim Kingdon, 21-Dec-2019.)
theorem ltexprlemupu {x3 y1 q: setvar} (A2 B2 C: class) (r: setvar):
  $ wceq C (cop (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c2nd)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c1st)))) cnq) (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c1st)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c2nd)))) cnq)) $ >
  $ wi (wa (wbr A2 B2 cltp) (wcel (cv r) cnq)) (wi (wrex q (wa (wbr (cv q) (cv r) cltq) (wcel (cv q) (cfv C c2nd))) cnq) (wcel (cv r) (cfv C c2nd))) $;

--| Our constructed difference is rounded. Lemma for ~ ltexpri . (Contributed by Jim Kingdon, 17-Dec-2019.)
theorem ltexprlemrnd {x3 y1 r q: setvar} (A2 B2 C: class):
  $ wceq C (cop (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c2nd)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c1st)))) cnq) (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c1st)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c2nd)))) cnq)) $ >
  $ wi (wbr A2 B2 cltp) (wa (wral q (wb (wcel (cv q) (cfv C c1st)) (wrex r (wa (wbr (cv q) (cv r) cltq) (wcel (cv r) (cfv C c1st))) cnq)) cnq) (wral r (wb (wcel (cv r) (cfv C c2nd)) (wrex q (wa (wbr (cv q) (cv r) cltq) (wcel (cv q) (cfv C c2nd))) cnq)) cnq)) $;

--| Our constructed difference is disjoint. Lemma for ~ ltexpri . (Contributed by Jim Kingdon, 17-Dec-2019.)
theorem ltexprlemdisj {x3 y1 q: setvar} (A2 B2 C: class):
  $ wceq C (cop (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c2nd)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c1st)))) cnq) (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c1st)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c2nd)))) cnq)) $ >
  $ wi (wbr A2 B2 cltp) (wral q (wn (wa (wcel (cv q) (cfv C c1st)) (wcel (cv q) (cfv C c2nd)))) cnq) $;

--| Our constructed difference is located. Lemma for ~ ltexpri . (Contributed by Jim Kingdon, 17-Dec-2019.)
theorem ltexprlemloc {x3 y1 r q: setvar} (A2 B2 C: class):
  $ wceq C (cop (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c2nd)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c1st)))) cnq) (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c1st)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c2nd)))) cnq)) $ >
  $ wi (wbr A2 B2 cltp) (wral q (wral r (wi (wbr (cv q) (cv r) cltq) (wo (wcel (cv q) (cfv C c1st)) (wcel (cv r) (cfv C c2nd)))) cnq) cnq) $;

--| Our constructed difference is a positive real. Lemma for ~ ltexpri . (Contributed by Jim Kingdon, 17-Dec-2019.)
theorem ltexprlempr {x3 y1: setvar} (A2 B2 C: class):
  $ wceq C (cop (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c2nd)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c1st)))) cnq) (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c1st)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c2nd)))) cnq)) $ >
  $ wi (wbr A2 B2 cltp) (wcel C cnp) $;

--| Lemma for ~ ltexpri . One directon of our result for lower cuts. (Contributed by Jim Kingdon, 17-Dec-2019.)
theorem ltexprlemfl {x3 y1: setvar} (A2 B2 C: class):
  $ wceq C (cop (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c2nd)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c1st)))) cnq) (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c1st)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c2nd)))) cnq)) $ >
  $ wi (wbr A2 B2 cltp) (wss (cfv (co A2 C cpp) c1st) (cfv B2 c1st)) $;

--| Lemma for ~ ltexpri . Reverse directon of our result for lower cuts. (Contributed by Jim Kingdon, 17-Dec-2019.)
theorem ltexprlemrl {x3 y1: setvar} (A2 B2 C: class):
  $ wceq C (cop (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c2nd)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c1st)))) cnq) (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c1st)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c2nd)))) cnq)) $ >
  $ wi (wbr A2 B2 cltp) (wss (cfv B2 c1st) (cfv (co A2 C cpp) c1st)) $;

--| Lemma for ~ ltexpri . One direction of our result for upper cuts. (Contributed by Jim Kingdon, 17-Dec-2019.)
theorem ltexprlemfu {x3 y1: setvar} (A2 B2 C: class):
  $ wceq C (cop (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c2nd)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c1st)))) cnq) (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c1st)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c2nd)))) cnq)) $ >
  $ wi (wbr A2 B2 cltp) (wss (cfv (co A2 C cpp) c2nd) (cfv B2 c2nd)) $;

--| Lemma for ~ ltexpri . One direction of our result for upper cuts. (Contributed by Jim Kingdon, 17-Dec-2019.)
theorem ltexprlemru {x3 y1: setvar} (A2 B2 C: class):
  $ wceq C (cop (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c2nd)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c1st)))) cnq) (crab x3 (wex y1 (wa (wcel (cv y1) (cfv A2 c1st)) (wcel (co (cv y1) (cv x3) cplq) (cfv B2 c2nd)))) cnq)) $ >
  $ wi (wbr A2 B2 cltp) (wss (cfv B2 c2nd) (cfv (co A2 C cpp) c2nd)) $;

--| Proposition 9-3.5(iv) of [Gleason] p. 123. (Contributed by NM, 13-May-1996.) (Revised by Mario Carneiro, 14-Jun-2013.)
theorem ltexpri {x3: setvar} (A2 B2: class):
  $ wi (wbr A2 B2 cltp) (wrex x3 (wceq (co A2 (cv x3) cpp) B2) cnp) $;

--| Lemma for ~ addcanprg . (Contributed by Jim Kingdon, 25-Dec-2019.)
theorem addcanprleml (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cnp) (wcel B2 cnp) (wcel C cnp)) (wceq (co A2 B2 cpp) (co A2 C cpp))) (wss (cfv B2 c1st) (cfv C c1st)) $;

--| Lemma for ~ addcanprg . (Contributed by Jim Kingdon, 25-Dec-2019.)
theorem addcanprlemu (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cnp) (wcel B2 cnp) (wcel C cnp)) (wceq (co A2 B2 cpp) (co A2 C cpp))) (wss (cfv B2 c2nd) (cfv C c2nd)) $;

--| Addition cancellation law for positive reals. Proposition 9-3.5(vi) of [Gleason] p. 123. (Contributed by Jim Kingdon, 24-Dec-2019.)
theorem addcanprg (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnp) (wcel B2 cnp) (wcel C cnp)) (wi (wceq (co A2 B2 cpp) (co A2 C cpp)) (wceq B2 C)) $;

--| The difference from ~ ltexpri is unique. (Contributed by Jim Kingdon, 7-Jul-2021.)
theorem lteupri {x3: setvar} (A2 B2: class):
  $ wi (wbr A2 B2 cltp) (wreu x3 (wceq (co A2 (cv x3) cpp) B2) cnp) $;

--| Lemma for Proposition 9-3.5(v) of [Gleason] p. 123. (Contributed by NM, 8-Apr-1996.)
theorem ltaprlem (A2 B2 C: class):
  $ wi (wcel C cnp) (wi (wbr A2 B2 cltp) (wbr (co C A2 cpp) (co C B2 cpp) cltp)) $;

--| Ordering property of addition. Proposition 9-3.5(v) of [Gleason] p. 123. (Contributed by Jim Kingdon, 26-Dec-2019.)
theorem ltaprg (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnp) (wcel B2 cnp) (wcel C cnp)) (wb (wbr A2 B2 cltp) (wbr (co C A2 cpp) (co C B2 cpp) cltp)) $;

--| Membership in the upper cut of a sum of a positive real and a fraction. (Contributed by Jim Kingdon, 16-Jun-2021.)
theorem prplnqu {y1 u l: setvar} (ph: wff y1 u l) (A2 Q: class) (X: class u l):
  $ wi ph (wcel X cnp) $ >
  $ wi ph (wcel Q cnq) $ >
  $ wi ph (wcel A2 (cfv (co X (cop (cab l (wbr (cv l) Q cltq)) (cab u (wbr Q (cv u) cltq))) cpp) c2nd)) $ >
  $ wi ph (wrex y1 (wceq (co (cv y1) Q cplq) A2) (cfv X c2nd)) $;

--| Strong extensionality of addition (ordering version). This is similar to ~ addext but for positive reals and based on less-than rather than apartness. (Contributed by Jim Kingdon, 17-Feb-2020.)
theorem addextpr (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cnp) (wcel B2 cnp)) (wa (wcel C cnp) (wcel D cnp))) (wi (wbr (co A2 B2 cpp) (co C D cpp) cltp) (wo (wbr A2 C cltp) (wbr B2 D cltp))) $;

--| Membership in the lower cut of ` B ` . Lemma for ~ recexpr . (Contributed by Jim Kingdon, 27-Dec-2019.)
theorem recexprlemell {x3 y1: setvar} (A2 B2 C: class):
  $ wceq B2 (cop (cab x3 (wex y1 (wa (wbr (cv x3) (cv y1) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c2nd))))) (cab x3 (wex y1 (wa (wbr (cv y1) (cv x3) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c1st)))))) $ >
  $ wb (wcel C (cfv B2 c1st)) (wex y1 (wa (wbr C (cv y1) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c2nd)))) $;

--| Membership in the upper cut of ` B ` . Lemma for ~ recexpr . (Contributed by Jim Kingdon, 27-Dec-2019.)
theorem recexprlemelu {x3 y1: setvar} (A2 B2 C: class):
  $ wceq B2 (cop (cab x3 (wex y1 (wa (wbr (cv x3) (cv y1) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c2nd))))) (cab x3 (wex y1 (wa (wbr (cv y1) (cv x3) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c1st)))))) $ >
  $ wb (wcel C (cfv B2 c2nd)) (wex y1 (wa (wbr (cv y1) C cltq) (wcel (cfv (cv y1) crq) (cfv A2 c1st)))) $;

--| ` B ` is inhabited. Lemma for ~ recexpr . (Contributed by Jim Kingdon, 27-Dec-2019.)
theorem recexprlemm {x3 y1 r q: setvar} (A2 B2: class):
  $ wceq B2 (cop (cab x3 (wex y1 (wa (wbr (cv x3) (cv y1) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c2nd))))) (cab x3 (wex y1 (wa (wbr (cv y1) (cv x3) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c1st)))))) $ >
  $ wi (wcel A2 cnp) (wa (wrex q (wcel (cv q) (cfv B2 c1st)) cnq) (wrex r (wcel (cv r) (cfv B2 c2nd)) cnq)) $;

--| The lower cut of ` B ` is open. Lemma for ~ recexpr . (Contributed by Jim Kingdon, 28-Dec-2019.)
theorem recexprlemopl {x3 y1 r: setvar} (A2 B2: class) (q: setvar):
  $ wceq B2 (cop (cab x3 (wex y1 (wa (wbr (cv x3) (cv y1) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c2nd))))) (cab x3 (wex y1 (wa (wbr (cv y1) (cv x3) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c1st)))))) $ >
  $ wi (w3a (wcel A2 cnp) (wcel (cv q) cnq) (wcel (cv q) (cfv B2 c1st))) (wrex r (wa (wbr (cv q) (cv r) cltq) (wcel (cv r) (cfv B2 c1st))) cnq) $;

--| The lower cut of ` B ` is lower. Lemma for ~ recexpr . (Contributed by Jim Kingdon, 28-Dec-2019.)
theorem recexprlemlol {x3 y1 r: setvar} (A2 B2: class) (q: setvar):
  $ wceq B2 (cop (cab x3 (wex y1 (wa (wbr (cv x3) (cv y1) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c2nd))))) (cab x3 (wex y1 (wa (wbr (cv y1) (cv x3) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c1st)))))) $ >
  $ wi (wa (wcel A2 cnp) (wcel (cv q) cnq)) (wi (wrex r (wa (wbr (cv q) (cv r) cltq) (wcel (cv r) (cfv B2 c1st))) cnq) (wcel (cv q) (cfv B2 c1st))) $;

--| The upper cut of ` B ` is open. Lemma for ~ recexpr . (Contributed by Jim Kingdon, 28-Dec-2019.)
theorem recexprlemopu {x3 y1 q: setvar} (A2 B2: class) (r: setvar):
  $ wceq B2 (cop (cab x3 (wex y1 (wa (wbr (cv x3) (cv y1) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c2nd))))) (cab x3 (wex y1 (wa (wbr (cv y1) (cv x3) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c1st)))))) $ >
  $ wi (w3a (wcel A2 cnp) (wcel (cv r) cnq) (wcel (cv r) (cfv B2 c2nd))) (wrex q (wa (wbr (cv q) (cv r) cltq) (wcel (cv q) (cfv B2 c2nd))) cnq) $;

--| The upper cut of ` B ` is upper. Lemma for ~ recexpr . (Contributed by Jim Kingdon, 28-Dec-2019.)
theorem recexprlemupu {x3 y1 q: setvar} (A2 B2: class) (r: setvar):
  $ wceq B2 (cop (cab x3 (wex y1 (wa (wbr (cv x3) (cv y1) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c2nd))))) (cab x3 (wex y1 (wa (wbr (cv y1) (cv x3) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c1st)))))) $ >
  $ wi (wa (wcel A2 cnp) (wcel (cv r) cnq)) (wi (wrex q (wa (wbr (cv q) (cv r) cltq) (wcel (cv q) (cfv B2 c2nd))) cnq) (wcel (cv r) (cfv B2 c2nd))) $;

--| ` B ` is rounded. Lemma for ~ recexpr . (Contributed by Jim Kingdon, 27-Dec-2019.)
theorem recexprlemrnd {x3 y1 r q: setvar} (A2 B2: class):
  $ wceq B2 (cop (cab x3 (wex y1 (wa (wbr (cv x3) (cv y1) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c2nd))))) (cab x3 (wex y1 (wa (wbr (cv y1) (cv x3) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c1st)))))) $ >
  $ wi (wcel A2 cnp) (wa (wral q (wb (wcel (cv q) (cfv B2 c1st)) (wrex r (wa (wbr (cv q) (cv r) cltq) (wcel (cv r) (cfv B2 c1st))) cnq)) cnq) (wral r (wb (wcel (cv r) (cfv B2 c2nd)) (wrex q (wa (wbr (cv q) (cv r) cltq) (wcel (cv q) (cfv B2 c2nd))) cnq)) cnq)) $;

--| ` B ` is disjoint. Lemma for ~ recexpr . (Contributed by Jim Kingdon, 27-Dec-2019.)
theorem recexprlemdisj {x3 y1 q: setvar} (A2 B2: class):
  $ wceq B2 (cop (cab x3 (wex y1 (wa (wbr (cv x3) (cv y1) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c2nd))))) (cab x3 (wex y1 (wa (wbr (cv y1) (cv x3) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c1st)))))) $ >
  $ wi (wcel A2 cnp) (wral q (wn (wa (wcel (cv q) (cfv B2 c1st)) (wcel (cv q) (cfv B2 c2nd)))) cnq) $;

--| ` B ` is located. Lemma for ~ recexpr . (Contributed by Jim Kingdon, 27-Dec-2019.)
theorem recexprlemloc {x3 y1 r q: setvar} (A2 B2: class):
  $ wceq B2 (cop (cab x3 (wex y1 (wa (wbr (cv x3) (cv y1) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c2nd))))) (cab x3 (wex y1 (wa (wbr (cv y1) (cv x3) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c1st)))))) $ >
  $ wi (wcel A2 cnp) (wral q (wral r (wi (wbr (cv q) (cv r) cltq) (wo (wcel (cv q) (cfv B2 c1st)) (wcel (cv r) (cfv B2 c2nd)))) cnq) cnq) $;

--| ` B ` is a positive real. Lemma for ~ recexpr . (Contributed by Jim Kingdon, 27-Dec-2019.)
theorem recexprlempr {x3 y1: setvar} (A2 B2: class):
  $ wceq B2 (cop (cab x3 (wex y1 (wa (wbr (cv x3) (cv y1) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c2nd))))) (cab x3 (wex y1 (wa (wbr (cv y1) (cv x3) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c1st)))))) $ >
  $ wi (wcel A2 cnp) (wcel B2 cnp) $;

--| The lower cut of one is a subset of the lower cut of ` A .P. B ` . Lemma for ~ recexpr . (Contributed by Jim Kingdon, 27-Dec-2019.)
theorem recexprlem1ssl {x3 y1: setvar} (A2 B2: class):
  $ wceq B2 (cop (cab x3 (wex y1 (wa (wbr (cv x3) (cv y1) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c2nd))))) (cab x3 (wex y1 (wa (wbr (cv y1) (cv x3) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c1st)))))) $ >
  $ wi (wcel A2 cnp) (wss (cfv c1p c1st) (cfv (co A2 B2 cmp) c1st)) $;

--| The upper cut of one is a subset of the upper cut of ` A .P. B ` . Lemma for ~ recexpr . (Contributed by Jim Kingdon, 27-Dec-2019.)
theorem recexprlem1ssu {x3 y1: setvar} (A2 B2: class):
  $ wceq B2 (cop (cab x3 (wex y1 (wa (wbr (cv x3) (cv y1) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c2nd))))) (cab x3 (wex y1 (wa (wbr (cv y1) (cv x3) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c1st)))))) $ >
  $ wi (wcel A2 cnp) (wss (cfv c1p c2nd) (cfv (co A2 B2 cmp) c2nd)) $;

--| The lower cut of ` A .P. B ` is a subset of the lower cut of one. Lemma for ~ recexpr . (Contributed by Jim Kingdon, 27-Dec-2019.)
theorem recexprlemss1l {x3 y1: setvar} (A2 B2: class):
  $ wceq B2 (cop (cab x3 (wex y1 (wa (wbr (cv x3) (cv y1) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c2nd))))) (cab x3 (wex y1 (wa (wbr (cv y1) (cv x3) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c1st)))))) $ >
  $ wi (wcel A2 cnp) (wss (cfv (co A2 B2 cmp) c1st) (cfv c1p c1st)) $;

--| The upper cut of ` A .P. B ` is a subset of the upper cut of one. Lemma for ~ recexpr . (Contributed by Jim Kingdon, 27-Dec-2019.)
theorem recexprlemss1u {x3 y1: setvar} (A2 B2: class):
  $ wceq B2 (cop (cab x3 (wex y1 (wa (wbr (cv x3) (cv y1) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c2nd))))) (cab x3 (wex y1 (wa (wbr (cv y1) (cv x3) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c1st)))))) $ >
  $ wi (wcel A2 cnp) (wss (cfv (co A2 B2 cmp) c2nd) (cfv c1p c2nd)) $;

--| ` B ` is the reciprocal of ` A ` . Lemma for ~ recexpr . (Contributed by Jim Kingdon, 27-Dec-2019.)
theorem recexprlemex {x3 y1: setvar} (A2 B2: class):
  $ wceq B2 (cop (cab x3 (wex y1 (wa (wbr (cv x3) (cv y1) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c2nd))))) (cab x3 (wex y1 (wa (wbr (cv y1) (cv x3) cltq) (wcel (cfv (cv y1) crq) (cfv A2 c1st)))))) $ >
  $ wi (wcel A2 cnp) (wceq (co A2 B2 cmp) c1p) $;

--| The reciprocal of a positive real exists. Part of Proposition 9-3.7(v) of [Gleason] p. 124. (Contributed by NM, 15-May-1996.) (Revised by Mario Carneiro, 12-Jun-2013.)
theorem recexpr {x3: setvar} (A2: class):
  $ wi (wcel A2 cnp) (wrex x3 (wceq (co A2 (cv x3) cmp) c1p) cnp) $;

--| Lemma for ~ aptipr . (Contributed by Jim Kingdon, 28-Jan-2020.)
theorem aptiprleml (A2 B2: class):
  $ wi (w3a (wcel A2 cnp) (wcel B2 cnp) (wn (wbr B2 A2 cltp))) (wss (cfv A2 c1st) (cfv B2 c1st)) $;

--| Lemma for ~ aptipr . (Contributed by Jim Kingdon, 28-Jan-2020.)
theorem aptiprlemu (A2 B2: class):
  $ wi (w3a (wcel A2 cnp) (wcel B2 cnp) (wn (wbr B2 A2 cltp))) (wss (cfv B2 c2nd) (cfv A2 c2nd)) $;

--| Apartness of positive reals is tight. (Contributed by Jim Kingdon, 28-Jan-2020.)
theorem aptipr (A2 B2: class):
  $ wi (w3a (wcel A2 cnp) (wcel B2 cnp) (wn (wo (wbr A2 B2 cltp) (wbr B2 A2 cltp)))) (wceq A2 B2) $;

--| Ordering property of multiplication. (Contributed by Jim Kingdon, 18-Feb-2020.)
theorem ltmprr (A2 B2 C: class):
  $ wi (w3a (wcel A2 cnp) (wcel B2 cnp) (wcel C cnp)) (wi (wbr (co C A2 cmp) (co C B2 cmp) cltp) (wbr A2 B2 cltp)) $;

--| For any positive real, there is an integer that is greater than it. This is also known as the "archimedean property". The integer ` x ` is embedded into the reals as described at ~ nnprlu . (Contributed by Jim Kingdon, 22-Apr-2020.)
theorem archpr {x3 u l: setvar} (A2: class):
  $ wi (wcel A2 cnp) (wrex x3 (wbr A2 (cop (cab l (wbr (cv l) (cec (cop (cv x3) c1o) ceq) cltq)) (cab u (wbr (cec (cop (cv x3) c1o) ceq) (cv u) cltq))) cltp) cnpi) $;

--| Lemma for ~ cauappcvgprlemladdrl . Cancelling a term from both sides. (Contributed by Jim Kingdon, 15-Aug-2020.)
theorem caucvgprlemcanl {u l: setvar} (ph: wff u l) (Q R S: class) (L: class u l):
  $ wi ph (wcel L cnp) $ >
  $ wi ph (wcel S cnq) $ >
  $ wi ph (wcel R cnq) $ >
  $ wi ph (wcel Q cnq) $ >
  $ wi ph (wb (wcel (co R Q cplq) (cfv (co L (cop (cab l (wbr (cv l) (co S Q cplq) cltq)) (cab u (wbr (co S Q cplq) (cv u) cltq))) cpp) c1st)) (wcel R (cfv (co L (cop (cab l (wbr (cv l) S cltq)) (cab u (wbr S (cv u) cltq))) cpp) c1st))) $;

--| Lemma for ~ cauappcvgpr . The putative limit is inhabited. (Contributed by Jim Kingdon, 18-Jul-2020.)
theorem cauappcvgprlemm {u s1 r q p l: setvar} (ph: wff u l) (A2: class u r q l) (F: class) (L: class u l):
  $ wi ph (wf cnq cnq F) $ >
  $ wi ph (wral p (wral q (wa (wbr (cfv (cv p) F) (co (cfv (cv q) F) (co (cv p) (cv q) cplq) cplq) cltq) (wbr (cfv (cv q) F) (co (cfv (cv p) F) (co (cv p) (cv q) cplq) cplq) cltq)) cnq) cnq) $ >
  $ wi ph (wral p (wbr A2 (cfv (cv p) F) cltq) cnq) $ >
  $ wceq L (cop (crab l (wrex q (wbr (co (cv l) (cv q) cplq) (cfv (cv q) F) cltq) cnq) cnq) (crab u (wrex q (wbr (co (cfv (cv q) F) (cv q) cplq) (cv u) cltq) cnq) cnq)) $ >
  $ wi ph (wa (wrex s1 (wcel (cv s1) (cfv L c1st)) cnq) (wrex r (wcel (cv r) (cfv L c2nd)) cnq)) $;

--| Lemma for ~ cauappcvgpr . The lower cut of the putative limit is open. (Contributed by Jim Kingdon, 4-Aug-2020.)
theorem cauappcvgprlemopl {u r q p l: setvar} (ph: wff u l) (A2: class u r q l) (F: class) (L: class u l) (s1: setvar):
  $ wi ph (wf cnq cnq F) $ >
  $ wi ph (wral p (wral q (wa (wbr (cfv (cv p) F) (co (cfv (cv q) F) (co (cv p) (cv q) cplq) cplq) cltq) (wbr (cfv (cv q) F) (co (cfv (cv p) F) (co (cv p) (cv q) cplq) cplq) cltq)) cnq) cnq) $ >
  $ wi ph (wral p (wbr A2 (cfv (cv p) F) cltq) cnq) $ >
  $ wceq L (cop (crab l (wrex q (wbr (co (cv l) (cv q) cplq) (cfv (cv q) F) cltq) cnq) cnq) (crab u (wrex q (wbr (co (cfv (cv q) F) (cv q) cplq) (cv u) cltq) cnq) cnq)) $ >
  $ wi (wa ph (wcel (cv s1) (cfv L c1st))) (wrex r (wa (wbr (cv s1) (cv r) cltq) (wcel (cv r) (cfv L c1st))) cnq) $;

--| Lemma for ~ cauappcvgpr . The lower cut of the putative limit is lower. (Contributed by Jim Kingdon, 4-Aug-2020.)
theorem cauappcvgprlemlol {u q p l: setvar} (ph: wff u l) (A2: class u q l) (F: class) (L: class u l) (s1 r: setvar):
  $ wi ph (wf cnq cnq F) $ >
  $ wi ph (wral p (wral q (wa (wbr (cfv (cv p) F) (co (cfv (cv q) F) (co (cv p) (cv q) cplq) cplq) cltq) (wbr (cfv (cv q) F) (co (cfv (cv p) F) (co (cv p) (cv q) cplq) cplq) cltq)) cnq) cnq) $ >
  $ wi ph (wral p (wbr A2 (cfv (cv p) F) cltq) cnq) $ >
  $ wceq L (cop (crab l (wrex q (wbr (co (cv l) (cv q) cplq) (cfv (cv q) F) cltq) cnq) cnq) (crab u (wrex q (wbr (co (cfv (cv q) F) (cv q) cplq) (cv u) cltq) cnq) cnq)) $ >
  $ wi (w3a ph (wbr (cv s1) (cv r) cltq) (wcel (cv r) (cfv L c1st))) (wcel (cv s1) (cfv L c1st)) $;

--| Lemma for ~ cauappcvgpr . The upper cut of the putative limit is open. (Contributed by Jim Kingdon, 4-Aug-2020.)

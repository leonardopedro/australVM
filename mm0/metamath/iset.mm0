  $ wi ph (wbr B2 cc0 cap) $ >
  $ wi ph (wceq (co (co A2 B2 cdiv) C cmul) (co A2 (co C B2 cdiv) cmul)) $;

--| A commutative/associative law for division. (Contributed by Jim Kingdon, 8-Mar-2020.)
theorem div13apd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wbr B2 cc0 cap) $ >
  $ wi ph (wceq (co (co A2 B2 cdiv) C cmul) (co (co C B2 cdiv) A2 cmul)) $;

--| Swap denominators in a division. (Contributed by Jim Kingdon, 8-Mar-2020.)
theorem divdiv32apd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wbr B2 cc0 cap) $ >
  $ wi ph (wbr C cc0 cap) $ >
  $ wi ph (wceq (co (co A2 B2 cdiv) C cdiv) (co (co A2 C cdiv) B2 cdiv)) $;

--| Cancellation of common factor in a ratio. (Contributed by Jim Kingdon, 8-Mar-2020.)
theorem divcanap5d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wbr B2 cc0 cap) $ >
  $ wi ph (wbr C cc0 cap) $ >
  $ wi ph (wceq (co (co C A2 cmul) (co C B2 cmul) cdiv) (co A2 B2 cdiv)) $;

--| Cancellation of common factor in a ratio. (Contributed by Jim Kingdon, 8-Mar-2020.)
theorem divcanap5rd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wbr B2 cc0 cap) $ >
  $ wi ph (wbr C cc0 cap) $ >
  $ wi ph (wceq (co (co A2 C cmul) (co B2 C cmul) cdiv) (co A2 B2 cdiv)) $;

--| Cancel equal divisors in a division. (Contributed by Jim Kingdon, 8-Mar-2020.)
theorem divcanap7d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wbr B2 cc0 cap) $ >
  $ wi ph (wbr C cc0 cap) $ >
  $ wi ph (wceq (co (co A2 C cdiv) (co B2 C cdiv) cdiv) (co A2 B2 cdiv)) $;

--| Cancellation law for division and multiplication. (Contributed by Jim Kingdon, 8-Mar-2020.)
theorem dmdcanapd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wbr B2 cc0 cap) $ >
  $ wi ph (wbr C cc0 cap) $ >
  $ wi ph (wceq (co (co B2 C cdiv) (co A2 B2 cdiv) cmul) (co A2 C cdiv)) $;

--| Cancellation law for division and multiplication. (Contributed by Jim Kingdon, 8-Mar-2020.)
theorem dmdcanap2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wbr B2 cc0 cap) $ >
  $ wi ph (wbr C cc0 cap) $ >
  $ wi ph (wceq (co (co A2 B2 cdiv) (co B2 C cdiv) cmul) (co A2 C cdiv)) $;


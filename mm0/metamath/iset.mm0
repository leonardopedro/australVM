--| Lemma for ~ caucvgprpr . Change bound variables in Cauchy condition. (Contributed by Jim Kingdon, 12-Feb-2021.)
theorem caucvgprprlemcbv {u k n a b l: setvar} (ph: wff u k n a b l) (F: class u l):
  $ wi ph (wf cnpi cnp F) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) clti) (wa (wbr (cfv (cv n) F) (co (cfv (cv k) F) (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) cpp) cltp) (wbr (cfv (cv k) F) (co (cfv (cv n) F) (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) cpp) cltp))) cnpi) cnpi) $ >
  $ wi ph (wral a (wral b (wi (wbr (cv a) (cv b) clti) (wa (wbr (cfv (cv a) F) (co (cfv (cv b) F) (cop (cab l (wbr (cv l) (cfv (cec (cop (cv a) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv a) c1o) ceq) crq) (cv u) cltq))) cpp) cltp) (wbr (cfv (cv b) F) (co (cfv (cv a) F) (cop (cab l (wbr (cv l) (cfv (cec (cop (cv a) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv a) c1o) ceq) crq) (cv u) cltq))) cpp) cltp))) cnpi) cnpi) $;

--| Lemma for ~ caucvgprpr . Cauchy condition expressed in terms of classes. (Contributed by Jim Kingdon, 3-Mar-2021.)
theorem caucvgprprlemval {u k n q p l: setvar} (ph: wff u k n q p l) (A2: class k n) (B2: class u k n q p l) (F: class u q p l):
  $ wi ph (wf cnpi cnp F) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) clti) (wa (wbr (cfv (cv n) F) (co (cfv (cv k) F) (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) cpp) cltp) (wbr (cfv (cv k) F) (co (cfv (cv n) F) (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) cpp) cltp))) cnpi) cnpi) $ >
  $ wi (wa ph (wbr A2 B2 clti)) (wa (wbr (cfv A2 F) (co (cfv B2 F) (cop (cab p (wbr (cv p) (cfv (cec (cop A2 c1o) ceq) crq) cltq)) (cab q (wbr (cfv (cec (cop A2 c1o) ceq) crq) (cv q) cltq))) cpp) cltp) (wbr (cfv B2 F) (co (cfv A2 F) (cop (cab p (wbr (cv p) (cfv (cec (cop A2 c1o) ceq) crq) cltq)) (cab q (wbr (cfv (cec (cop A2 c1o) ceq) crq) (cv q) cltq))) cpp) cltp)) $;

--| Lemma for ~ caucvgprpr . Part of disjointness. (Contributed by Jim Kingdon, 12-Feb-2021.)
theorem caucvgprprlemnkltj {u k n q p l: setvar} (ph: wff u k n q p l) (S: class u k n l) (F: class u q p l) (J: class u k n l) (K: class k n):
  $ wi ph (wf cnpi cnp F) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) clti) (wa (wbr (cfv (cv n) F) (co (cfv (cv k) F) (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) cpp) cltp) (wbr (cfv (cv k) F) (co (cfv (cv n) F) (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) cpp) cltp))) cnpi) cnpi) $ >

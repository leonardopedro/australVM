  $ wceq G (cmpt x3 cnpi (crio y1 (wceq (cfv (cv x3) F) (cec (cop (co (cv y1) c1p cpp) c1p) cer)) cnp)) $ >
  $ wi ph (wral m (wbr c1p (cfv (cv m) G) cltp) cnpi) $;

--| Lemma for ~ caucvgsr . A Cauchy sequence whose terms are greater than one converges. (Contributed by Jim Kingdon, 22-Jun-2021.)
theorem caucvgsrlemgt1 {x3 y1 u i j k m n l: setvar} (ph: wff y1 u i m l) (F: class):
  $ wi ph (wf cnpi cnr F) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) clti) (wa (wbr (cfv (cv n) F) (co (cfv (cv k) F) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr) (wbr (cfv (cv k) F) (co (cfv (cv n) F) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr))) cnpi) cnpi) $ >
  $ wi ph (wral m (wbr c1r (cfv (cv m) F) cltr) cnpi) $ >
  $ wi ph (wrex y1 (wral x3 (wi (wbr c0r (cv x3) cltr) (wrex j (wral i (wi (wbr (cv j) (cv i) clti) (wa (wbr (cfv (cv i) F) (co (cv y1) (cv x3) cplr) cltr) (wbr (cv y1) (co (cfv (cv i) F) (cv x3) cplr) cltr))) cnpi) cnpi)) cnr) cnr) $;

--| Lemma for ~ caucvgsr . Offsetting the values of the sequence so they are greater than one. (Contributed by Jim Kingdon, 3-Jul-2021.)
theorem caucvgsrlemoffval {u k m n a l: setvar} (ph: wff u k m n l) (A2: class u k n l) (F: class u k m n l) (G: class u k m n a l) (J: class u k m n l):
  $ wi ph (wf cnpi cnr F) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) clti) (wa (wbr (cfv (cv n) F) (co (cfv (cv k) F) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr) (wbr (cfv (cv k) F) (co (cfv (cv n) F) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr))) cnpi) cnpi) $ >
  $ wi ph (wral m (wbr A2 (cfv (cv m) F) cltr) cnpi) $ >
  $ wceq G (cmpt a cnpi (co (co (cfv (cv a) F) c1r cplr) (co A2 cm1r cmr) cplr)) $ >
  $ wi (wa ph (wcel J cnpi)) (wceq (co (cfv J G) A2 cplr) (co (cfv J F) c1r cplr)) $;

--| Lemma for ~ caucvgsr . Offsetting the values of the sequence so they are greater than one. (Contributed by Jim Kingdon, 3-Jul-2021.)
theorem caucvgsrlemofff {u k m n a l: setvar} (ph: wff u k m n l) (A2: class u k n a l) (F G: class u k m n a l):
  $ wi ph (wf cnpi cnr F) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) clti) (wa (wbr (cfv (cv n) F) (co (cfv (cv k) F) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr) (wbr (cfv (cv k) F) (co (cfv (cv n) F) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr))) cnpi) cnpi) $ >
  $ wi ph (wral m (wbr A2 (cfv (cv m) F) cltr) cnpi) $ >
  $ wceq G (cmpt a cnpi (co (co (cfv (cv a) F) c1r cplr) (co A2 cm1r cmr) cplr)) $ >
  $ wi ph (wf cnpi cnr G) $;

--| Lemma for ~ caucvgsr . Offsetting the values of the sequence so they are greater than one. (Contributed by Jim Kingdon, 3-Jul-2021.)
theorem caucvgsrlemoffcau {u k m n a l: setvar} (ph: wff u m l) (A2: class u k n l) (F: class u k m n l) (G: class u k m n a l):
  $ wi ph (wf cnpi cnr F) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) clti) (wa (wbr (cfv (cv n) F) (co (cfv (cv k) F) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr) (wbr (cfv (cv k) F) (co (cfv (cv n) F) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr))) cnpi) cnpi) $ >
  $ wi ph (wral m (wbr A2 (cfv (cv m) F) cltr) cnpi) $ >
  $ wceq G (cmpt a cnpi (co (co (cfv (cv a) F) c1r cplr) (co A2 cm1r cmr) cplr)) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) clti) (wa (wbr (cfv (cv n) G) (co (cfv (cv k) G) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr) (wbr (cfv (cv k) G) (co (cfv (cv n) G) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr))) cnpi) cnpi) $;

--| Lemma for ~ caucvgsr . Offsetting the values of the sequence so they are greater than one. (Contributed by Jim Kingdon, 3-Jul-2021.)
theorem caucvgsrlemoffgt1 {u k m n a l: setvar} (ph: wff u k n l) (A2: class u k n l) (F: class u k m n l) (G: class u k m n a l):
  $ wi ph (wf cnpi cnr F) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) clti) (wa (wbr (cfv (cv n) F) (co (cfv (cv k) F) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr) (wbr (cfv (cv k) F) (co (cfv (cv n) F) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr))) cnpi) cnpi) $ >
  $ wi ph (wral m (wbr A2 (cfv (cv m) F) cltr) cnpi) $ >
  $ wceq G (cmpt a cnpi (co (co (cfv (cv a) F) c1r cplr) (co A2 cm1r cmr) cplr)) $ >
  $ wi ph (wral m (wbr c1r (cfv (cv m) G) cltr) cnpi) $;

--| Lemma for ~ caucvgsr . Offsetting the values of the sequence so they are greater than one. (Contributed by Jim Kingdon, 3-Jul-2021.)
theorem caucvgsrlemoffres {x3 y1 u j k m n a l: setvar} (ph: wff y1 u l) (A2: class u n l) (F: class x3 u j m n l) (G: class y1 a):
  $ wi ph (wf cnpi cnr F) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) clti) (wa (wbr (cfv (cv n) F) (co (cfv (cv k) F) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr) (wbr (cfv (cv k) F) (co (cfv (cv n) F) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr))) cnpi) cnpi) $ >
  $ wi ph (wral m (wbr A2 (cfv (cv m) F) cltr) cnpi) $ >
  $ wceq G (cmpt a cnpi (co (co (cfv (cv a) F) c1r cplr) (co A2 cm1r cmr) cplr)) $ >
  $ wi ph (wrex y1 (wral x3 (wi (wbr c0r (cv x3) cltr) (wrex j (wral k (wi (wbr (cv j) (cv k) clti) (wa (wbr (cfv (cv k) F) (co (cv y1) (cv x3) cplr) cltr) (wbr (cv y1) (co (cfv (cv k) F) (cv x3) cplr) cltr))) cnpi) cnpi)) cnr) cnr) $;

--| Lemma for ~ caucvgsr . A Cauchy sequence with a lower bound converges. (Contributed by Jim Kingdon, 19-Jun-2021.)
theorem caucvgsrlembnd {x3 y1 u j k m n l: setvar} (ph: wff y1 u l) (A2 F: class):
  $ wi ph (wf cnpi cnr F) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) clti) (wa (wbr (cfv (cv n) F) (co (cfv (cv k) F) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr) (wbr (cfv (cv k) F) (co (cfv (cv n) F) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr))) cnpi) cnpi) $ >
  $ wi ph (wral m (wbr A2 (cfv (cv m) F) cltr) cnpi) $ >
  $ wi ph (wrex y1 (wral x3 (wi (wbr c0r (cv x3) cltr) (wrex j (wral k (wi (wbr (cv j) (cv k) clti) (wa (wbr (cfv (cv k) F) (co (cv y1) (cv x3) cplr) cltr) (wbr (cv y1) (co (cfv (cv k) F) (cv x3) cplr) cltr))) cnpi) cnpi)) cnr) cnr) $;

--| A Cauchy sequence of signed reals with a modulus of convergence converges to a signed real. This is basically Corollary 11.2.13 of [HoTT], p. (varies). The HoTT book theorem has a modulus of convergence (that is, a rate of convergence) specified by (11.2.9) in HoTT whereas this theorem fixes the rate of convergence to say that all terms after the nth term must be within ` 1 / n ` of the nth term (it should later be able to prove versions of this theorem with a different fixed rate or a modulus of convergence supplied as a hypothesis). This is similar to ~ caucvgprpr but is for signed reals rather than positive reals. Here is an outline of how we prove it: 1. Choose a lower bound for the sequence (see ~ caucvgsrlembnd ). 2. Offset each element of the sequence so that each element of the resulting sequence is greater than one (greater than zero would not suffice, because the limit as well as the elements of the sequence need to be positive) (see ~ caucvgsrlemofff ). 3. Since a signed real (element of ` R. ` ) which is greater than zero can be mapped to a positive real (element of ` P. ` ), perform that mapping on each element of the sequence and invoke ~ caucvgprpr to get a limit (see ~ caucvgsrlemgt1 ). 4. Map the resulting limit from positive reals back to signed reals (see ~ caucvgsrlemgt1 ). 5. Offset that limit so that we get the limit of the original sequence rather than the limit of the offsetted sequence (see ~ caucvgsrlemoffres ). (Contributed by Jim Kingdon, 20-Jun-2021.)
theorem caucvgsr {x3 y1 u j k n l: setvar} (ph: wff y1 u l) (F: class):
  $ wi ph (wf cnpi cnr F) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) clti) (wa (wbr (cfv (cv n) F) (co (cfv (cv k) F) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr) (wbr (cfv (cv k) F) (co (cfv (cv n) F) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr))) cnpi) cnpi) $ >
  $ wi ph (wrex y1 (wral x3 (wi (wbr c0r (cv x3) cltr) (wrex j (wral k (wi (wbr (cv j) (cv k) clti) (wa (wbr (cfv (cv k) F) (co (cv y1) (cv x3) cplr) cltr) (wbr (cv y1) (co (cfv (cv k) F) (cv x3) cplr) cltr))) cnpi) cnpi)) cnr) cnr) $;

--| Class of complex numbers.
term cc: class;

--| Class of real numbers.
term cr: class;

--| Extend class notation to include the complex number 0.
term cc0: class;

--| Extend class notation to include the complex number 1.
term c1: class;

--| Extend class notation to include the complex number i.
term ci: class;

--| Addition on complex numbers.
term caddc: class;

--| 'Less than' predicate (defined over real subset of complex numbers).
term cltrr: class;

--| Multiplication on complex numbers. The token ` x. ` is a center dot.
term cmul: class;

--| Define the set of complex numbers. (Contributed by NM, 22-Feb-1996.)
axiom df_c:
  $ wceq cc (cxp cnr cnr) $;

--| Define the complex number 0. (Contributed by NM, 22-Feb-1996.)
axiom df_0:
  $ wceq cc0 (cop c0r c0r) $;

--| Define the complex number 1. (Contributed by NM, 22-Feb-1996.)
axiom df_1:
  $ wceq c1 (cop c1r c0r) $;

--| Define the complex number ` _i ` (the imaginary unit). (Contributed by NM, 22-Feb-1996.)
axiom df_i:
  $ wceq ci (cop c0r c1r) $;

--| Define the set of real numbers. (Contributed by NM, 22-Feb-1996.)
axiom df_r:
  $ wceq cr (cxp cnr (csn c0r)) $;

--| Define addition over complex numbers. (Contributed by NM, 28-May-1995.)
axiom df_add {x3 y1 z w v u f2: setvar}:
  $ wceq caddc (coprab x3 y1 z (wa (wa (wcel (cv x3) cc) (wcel (cv y1) cc)) (wex w (wex v (wex u (wex f2 (wa (wa (wceq (cv x3) (cop (cv w) (cv v))) (wceq (cv y1) (cop (cv u) (cv f2)))) (wceq (cv z) (cop (co (cv w) (cv u) cplr) (co (cv v) (cv f2) cplr)))))))))) $;

--| Define multiplication over complex numbers. (Contributed by NM, 9-Aug-1995.)
axiom df_mul {x3 y1 z w v u f2: setvar}:
  $ wceq cmul (coprab x3 y1 z (wa (wa (wcel (cv x3) cc) (wcel (cv y1) cc)) (wex w (wex v (wex u (wex f2 (wa (wa (wceq (cv x3) (cop (cv w) (cv v))) (wceq (cv y1) (cop (cv u) (cv f2)))) (wceq (cv z) (cop (co (co (cv w) (cv u) cmr) (co cm1r (co (cv v) (cv f2) cmr) cmr) cplr) (co (co (cv v) (cv u) cmr) (co (cv w) (cv f2) cmr) cplr)))))))))) $;

--| Define 'less than' on the real subset of complex numbers. (Contributed by NM, 22-Feb-1996.)
axiom df_lt {x3 y1 z w: setvar}:
  $ wceq cltrr (copab x3 y1 (wa (wa (wcel (cv x3) cr) (wcel (cv y1) cr)) (wex z (wex w (wa (wa (wceq (cv x3) (cop (cv z) c0r)) (wceq (cv y1) (cop (cv w) c0r))) (wbr (cv z) (cv w) cltr)))))) $;

--| Ordered pair membership in the class of complex numbers. (Contributed by NM, 14-May-1996.)
theorem opelcn (A2 B2: class):
  $ wb (wcel (cop A2 B2) cc) (wa (wcel A2 cnr) (wcel B2 cnr)) $;

--| Ordered pair membership in class of real subset of complex numbers. (Contributed by NM, 22-Feb-1996.)
theorem opelreal (A2: class):
  $ wb (wcel (cop A2 c0r) cr) (wcel A2 cnr) $;

--| Membership in class of real numbers. (Contributed by NM, 31-Mar-1996.)
theorem elreal {x3: setvar} (A2: class):
  $ wb (wcel A2 cr) (wrex x3 (wceq (cop (cv x3) c0r) A2) cnr) $;

--| The real number mapping in ~ elreal is unique. (Contributed by Jim Kingdon, 11-Jul-2021.)
theorem elrealeu {x3: setvar} (A2: class):
  $ wb (wcel A2 cr) (wreu x3 (wceq (cop (cv x3) c0r) A2) cnr) $;

--| Ordered pair membership in the class of complex numbers. (Contributed by Mario Carneiro, 15-Jun-2013.)
theorem elreal2 (A2: class):
  $ wb (wcel A2 cr) (wa (wcel (cfv A2 c1st) cnr) (wceq A2 (cop (cfv A2 c1st) c0r))) $;

--| The empty set is not a complex number. Note: do not use this after the real number axioms are developed, since it is a construction-dependent property. (Contributed by NM, 2-May-1996.)
theorem _0ncn:
  $ wn (wcel c0 cc) $;

--| 'Less than' is a relation on real numbers. (Contributed by NM, 22-Feb-1996.)
theorem ltrelre:
  $ wss cltrr (cxp cr cr) $;

--| Addition of complex numbers in terms of signed reals. (Contributed by NM, 28-May-1995.)
theorem addcnsr (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cnr) (wcel B2 cnr)) (wa (wcel C cnr) (wcel D cnr))) (wceq (co (cop A2 B2) (cop C D) caddc) (cop (co A2 C cplr) (co B2 D cplr))) $;

--| Multiplication of complex numbers in terms of signed reals. (Contributed by NM, 9-Aug-1995.)
theorem mulcnsr (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cnr) (wcel B2 cnr)) (wa (wcel C cnr) (wcel D cnr))) (wceq (co (cop A2 B2) (cop C D) cmul) (cop (co (co A2 C cmr) (co cm1r (co B2 D cmr) cmr) cplr) (co (co B2 C cmr) (co A2 D cmr) cplr))) $;

--| Equality of real numbers in terms of intermediate signed reals. (Contributed by NM, 10-May-1996.)
theorem eqresr (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wceq (cop A2 c0r) (cop B2 c0r)) (wceq A2 B2) $;

--| Addition of real numbers in terms of intermediate signed reals. (Contributed by NM, 10-May-1996.)
theorem addresr (A2 B2: class):
  $ wi (wa (wcel A2 cnr) (wcel B2 cnr)) (wceq (co (cop A2 c0r) (cop B2 c0r) caddc) (cop (co A2 B2 cplr) c0r)) $;

--| Multiplication of real numbers in terms of intermediate signed reals. (Contributed by NM, 10-May-1996.)
theorem mulresr (A2 B2: class):
  $ wi (wa (wcel A2 cnr) (wcel B2 cnr)) (wceq (co (cop A2 c0r) (cop B2 c0r) cmul) (cop (co A2 B2 cmr) c0r)) $;

--| Ordering of real subset of complex numbers in terms of signed reals. (Contributed by NM, 22-Feb-1996.)
theorem ltresr (A2 B2: class):
  $ wb (wbr (cop A2 c0r) (cop B2 c0r) cltrr) (wbr A2 B2 cltr) $;

--| Ordering of real subset of complex numbers in terms of signed reals. (Contributed by NM, 22-Feb-1996.)
theorem ltresr2 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr A2 B2 cltrr) (wbr (cfv A2 c1st) (cfv B2 c1st) cltr)) $;

--| Technical trick to permit reuse of previous lemmas to prove arithmetic operation laws in ` CC ` from those in ` R. ` . The trick involves ~ qsid , which shows that the coset of the converse epsilon relation (which is not an equivalence relation) acts as an identity divisor for the quotient set operation. This lets us "pretend" that ` CC ` is a quotient set, even though it is not (compare ~ df-c ), and allows us to reuse some of the equivalence class lemmas we developed for the transition from positive reals to signed reals, etc. (Contributed by NM, 13-Aug-1995.)
theorem dfcnqs:
  $ wceq cc (cqs (cxp cnr cnr) (ccnv cep)) $;

--| Technical trick to permit re-use of some equivalence class lemmas for operation laws. See ~ dfcnqs and ~ mulcnsrec . (Contributed by NM, 13-Aug-1995.)
theorem addcnsrec (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cnr) (wcel B2 cnr)) (wa (wcel C cnr) (wcel D cnr))) (wceq (co (cec (cop A2 B2) (ccnv cep)) (cec (cop C D) (ccnv cep)) caddc) (cec (cop (co A2 C cplr) (co B2 D cplr)) (ccnv cep))) $;

--| Technical trick to permit re-use of some equivalence class lemmas for operation laws. The trick involves ~ ecidg , which shows that the coset of the converse epsilon relation (which is not an equivalence relation) leaves a set unchanged. See also ~ dfcnqs . (Contributed by NM, 13-Aug-1995.)
theorem mulcnsrec (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cnr) (wcel B2 cnr)) (wa (wcel C cnr) (wcel D cnr))) (wceq (co (cec (cop A2 B2) (ccnv cep)) (cec (cop C D) (ccnv cep)) cmul) (cec (cop (co (co A2 C cmr) (co cm1r (co B2 D cmr) cmr) cplr) (co (co B2 C cmr) (co A2 D cmr) cplr)) (ccnv cep))) $;

--| Existence of a sum. This is dependent on how we define ` + ` so once we proceed to real number axioms we will replace it with theorems such as ~ addcl . (Contributed by Jim Kingdon, 14-Jul-2021.)
theorem addvalex (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wcel (co A2 B2 caddc) cvv) $;

--| Lemma for ~ pitonn . Two ways to write the number one. (Contributed by Jim Kingdon, 24-Apr-2020.)
theorem pitonnlem1 {u l: setvar}:
  $ wceq (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop c1o c1o) ceq) cltq)) (cab u (wbr (cec (cop c1o c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) c1 $;

--| Lemma for ~ pitonn . Simplifying an expression involving signed reals. (Contributed by Jim Kingdon, 26-Apr-2020.)
theorem pitonnlem1p1 (A2: class):
  $ wi (wcel A2 cnp) (wceq (cec (cop (co A2 (co c1p c1p cpp) cpp) (co c1p c1p cpp)) cer) (cec (cop (co A2 c1p cpp) c1p) cer)) $;

--| Lemma for ~ pitonn . Two ways to add one to a number. (Contributed by Jim Kingdon, 24-Apr-2020.)
theorem pitonnlem2 {u l: setvar} (K: class):
  $ wi (wcel K cnpi) (wceq (co (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop K c1o) ceq) cltq)) (cab u (wbr (cec (cop K c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) c1 caddc) (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop (co K c1o cpli) c1o) ceq) cltq)) (cab u (wbr (cec (cop (co K c1o cpli) c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r)) $;

--| Mapping from ` N. ` to ` NN ` . (Contributed by Jim Kingdon, 22-Apr-2020.)
theorem pitonn {x3 y1 u l: setvar} (N: class x3 y1):
  $ wi (wcel N cnpi) (wcel (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop N c1o) ceq) cltq)) (cab u (wbr (cec (cop N c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) (cint (cab x3 (wa (wcel c1 (cv x3)) (wral y1 (wcel (co (cv y1) c1 caddc) (cv x3)) (cv x3)))))) $;

--| Embedding from ` N. ` to ` RR ` yields a number greater than zero. (Contributed by Jim Kingdon, 15-Jul-2021.)
theorem pitoregt0 {u l: setvar} (N: class):
  $ wi (wcel N cnpi) (wbr cc0 (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop N c1o) ceq) cltq)) (cab u (wbr (cec (cop N c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) cltrr) $;

--| Embedding from ` N. ` to ` RR ` . Similar to ~ pitonn but separate in the sense that we have not proved ~ nnssre yet. (Contributed by Jim Kingdon, 15-Jul-2021.)
theorem pitore {u l: setvar} (N: class):
  $ wi (wcel N cnpi) (wcel (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop N c1o) ceq) cltq)) (cab u (wbr (cec (cop N c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) cr) $;

--| Embedding the reciprocal of a natural number into ` RR ` . (Contributed by Jim Kingdon, 15-Jul-2021.)
theorem recnnre {u l: setvar} (N: class):
  $ wi (wcel N cnpi) (wcel (cop (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop N c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop N c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) cr) $;

--| One is an element of ` NN ` . This is a counterpart to ~ 1nn designed for real number axioms which involve natural numbers (notably, ~ axcaucvg ). (Contributed by Jim Kingdon, 14-Jul-2021.) (New usage is discouraged.)
theorem peano1nnnn {x3 y1: setvar} (N: class x3 y1):
  $ wceq N (cint (cab x3 (wa (wcel c1 (cv x3)) (wral y1 (wcel (co (cv y1) c1 caddc) (cv x3)) (cv x3))))) $ >
  $ wcel c1 N $;

--| A successor of a positive integer is a positive integer. This is a counterpart to ~ peano2nn designed for real number axioms which involve to natural numbers (notably, ~ axcaucvg ). (Contributed by Jim Kingdon, 14-Jul-2021.) (New usage is discouraged.)
theorem peano2nnnn {x3 y1: setvar} (A2: class x3) (N: class x3 y1):
  $ wceq N (cint (cab x3 (wa (wcel c1 (cv x3)) (wral y1 (wcel (co (cv y1) c1 caddc) (cv x3)) (cv x3))))) $ >
  $ wi (wcel A2 N) (wcel (co A2 c1 caddc) N) $;

--| Ordering of natural numbers with ` <N ` or ` <RR ` . (Contributed by Jim Kingdon, 13-Jul-2021.)
theorem ltrennb {u l: setvar} (J K: class):
  $ wi (wa (wcel J cnpi) (wcel K cnpi)) (wb (wbr J K clti) (wbr (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop J c1o) ceq) cltq)) (cab u (wbr (cec (cop J c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop K c1o) ceq) cltq)) (cab u (wbr (cec (cop K c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) cltrr)) $;

--| Ordering of natural numbers with ` <N ` or ` <RR ` . (Contributed by Jim Kingdon, 12-Jul-2021.)
theorem ltrenn {u l: setvar} (J K: class):
  $ wi (wbr J K clti) (wbr (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop J c1o) ceq) cltq)) (cab u (wbr (cec (cop J c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop K c1o) ceq) cltq)) (cab u (wbr (cec (cop K c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) cltrr) $;

--| Another way of saying that a number times its reciprocal is one. (Contributed by Jim Kingdon, 17-Jul-2021.)
theorem recidpipr {u l: setvar} (N: class):
  $ wi (wcel N cnpi) (wceq (co (cop (cab l (wbr (cv l) (cec (cop N c1o) ceq) cltq)) (cab u (wbr (cec (cop N c1o) ceq) (cv u) cltq))) (cop (cab l (wbr (cv l) (cfv (cec (cop N c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop N c1o) ceq) crq) (cv u) cltq))) cmp) c1p) $;

--| Lemma for ~ recidpirq . Rearranging some of the expressions. (Contributed by Jim Kingdon, 17-Jul-2021.)
theorem recidpirqlemcalc (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cnp) $ >
  $ wi ph (wcel B2 cnp) $ >
  $ wi ph (wceq (co A2 B2 cmp) c1p) $ >
  $ wi ph (wceq (co (co (co (co A2 c1p cpp) (co B2 c1p cpp) cmp) (co c1p c1p cmp) cpp) c1p cpp) (co (co (co (co A2 c1p cpp) c1p cmp) (co c1p (co B2 c1p cpp) cmp) cpp) (co c1p c1p cpp) cpp)) $;

--| A real number times its reciprocal is one, where reciprocal is expressed with ` *Q ` . (Contributed by Jim Kingdon, 15-Jul-2021.)
theorem recidpirq {u l: setvar} (N: class):
  $ wi (wcel N cnpi) (wceq (co (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop N c1o) ceq) cltq)) (cab u (wbr (cec (cop N c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) (cop (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop N c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop N c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) cmul) c1) $;

--| The complex numbers form a set. Use ~ cnex instead. (Contributed by Mario Carneiro, 17-Nov-2014.) (New usage is discouraged.)
theorem axcnex:
  $ wcel cc cvv $;

--| The real numbers are a subset of the complex numbers. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-resscn . (Contributed by NM, 1-Mar-1995.) (Proof shortened by Andrew Salmon, 12-Aug-2011.) (New usage is discouraged.)
theorem axresscn:
  $ wss cr cc $;

--| 1 is a complex number. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-1cn . (Contributed by NM, 12-Apr-2007.) (New usage is discouraged.)
theorem ax1cn:
  $ wcel c1 cc $;

--| 1 is a real number. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-1re . In the Metamath Proof Explorer, this is not a complex number axiom but is proved from ~ ax-1cn and the other axioms. It is not known whether we can do so here, but the Metamath Proof Explorer proof (accessed 13-Jan-2020) uses excluded middle. (Contributed by Jim Kingdon, 13-Jan-2020.) (New usage is discouraged.)
theorem ax1re:
  $ wcel c1 cr $;

--| ` _i ` is a complex number. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-icn . (Contributed by NM, 23-Feb-1996.) (New usage is discouraged.)
theorem axicn:
  $ wcel ci cc $;

--| Closure law for addition of complex numbers. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly, nor should the proven axiom ~ ax-addcl be used later. Instead, in most cases use ~ addcl . (Contributed by NM, 14-Jun-1995.) (New usage is discouraged.)
theorem axaddcl (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wcel (co A2 B2 caddc) cc) $;

--| Closure law for addition in the real subfield of complex numbers. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly, nor should the proven axiom ~ ax-addrcl be used later. Instead, in most cases use ~ readdcl . (Contributed by NM, 31-Mar-1996.) (New usage is discouraged.)
theorem axaddrcl (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wcel (co A2 B2 caddc) cr) $;

--| Closure law for multiplication of complex numbers. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly, nor should the proven axiom ~ ax-mulcl be used later. Instead, in most cases use ~ mulcl . (Contributed by NM, 10-Aug-1995.) (New usage is discouraged.)
theorem axmulcl (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wcel (co A2 B2 cmul) cc) $;

--| Closure law for multiplication in the real subfield of complex numbers. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly, nor should the proven axiom ~ ax-mulrcl be used later. Instead, in most cases use ~ remulcl . (New usage is discouraged.) (Contributed by NM, 31-Mar-1996.)
theorem axmulrcl (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wcel (co A2 B2 cmul) cr) $;

--| Addition commutes. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly, nor should the proven axiom ~ ax-addcom be used later. Instead, use ~ addcom . In the Metamath Proof Explorer this is not a complex number axiom but is instead proved from other axioms. That proof relies on real number trichotomy and it is not known whether it is possible to prove this from the other axioms without it. (Contributed by Jim Kingdon, 17-Jan-2020.) (New usage is discouraged.)
theorem axaddcom (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co A2 B2 caddc) (co B2 A2 caddc)) $;

--| Multiplication of complex numbers is commutative. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly, nor should the proven axiom ~ ax-mulcom be used later. Instead, use ~ mulcom . (Contributed by NM, 31-Aug-1995.) (New usage is discouraged.)
theorem axmulcom (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co A2 B2 cmul) (co B2 A2 cmul)) $;

--| Addition of complex numbers is associative. This theorem transfers the associative laws for the real and imaginary signed real components of complex number pairs, to complex number addition itself. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly, nor should the proven axiom ~ ax-addass be used later. Instead, use ~ addass . (Contributed by NM, 2-Sep-1995.) (New usage is discouraged.)
theorem axaddass (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 caddc) C caddc) (co A2 (co B2 C caddc) caddc)) $;

--| Multiplication of complex numbers is associative. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-mulass . (Contributed by NM, 3-Sep-1995.) (New usage is discouraged.)
theorem axmulass (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 cmul) C cmul) (co A2 (co B2 C cmul) cmul)) $;

--| Distributive law for complex numbers (left-distributivity). Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly, nor should the proven axiom ~ ax-distr be used later. Instead, use ~ adddi . (Contributed by NM, 2-Sep-1995.) (New usage is discouraged.)
theorem axdistr (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co A2 (co B2 C caddc) cmul) (co (co A2 B2 cmul) (co A2 C cmul) caddc)) $;

--| i-squared equals -1 (expressed as i-squared plus 1 is 0). Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-i2m1 . (Contributed by NM, 5-May-1996.) (New usage is discouraged.)
theorem axi2m1:
  $ wceq (co (co ci ci cmul) c1 caddc) cc0 $;

--| 0 is less than 1. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-0lt1 . The version of this axiom in the Metamath Proof Explorer reads ` 1 =/= 0 ` ; here we change it to ` 0 <RR 1 ` . The proof of ` 0 <RR 1 ` from ` 1 =/= 0 ` in the Metamath Proof Explorer (accessed 12-Jan-2020) relies on real number trichotomy. (Contributed by Jim Kingdon, 12-Jan-2020.) (New usage is discouraged.)
theorem ax0lt1:
  $ wbr cc0 c1 cltrr $;

--| ` 1 ` is an identity element for real multiplication. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-1rid . (Contributed by Scott Fenton, 3-Jan-2013.) (New usage is discouraged.)
theorem ax1rid (A2: class):
  $ wi (wcel A2 cr) (wceq (co A2 c1 cmul) A2) $;

--| ` 0 ` is an identity element for real addition. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-0id . In the Metamath Proof Explorer this is not a complex number axiom but is instead proved from other axioms. That proof relies on excluded middle and it is not known whether it is possible to prove this from the other axioms without excluded middle. (Contributed by Jim Kingdon, 16-Jan-2020.) (New usage is discouraged.)
theorem ax0id (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 cc0 caddc) A2) $;

--| Existence of negative of real number. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-rnegex . (Contributed by NM, 15-May-1996.) (New usage is discouraged.)
theorem axrnegex {x3: setvar} (A2: class):
  $ wi (wcel A2 cr) (wrex x3 (wceq (co A2 (cv x3) caddc) cc0) cr) $;

--| Existence of positive reciprocal of positive real number. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-precex . In treatments which assume excluded middle, the ` 0 <RR A ` condition is generally replaced by ` A =/= 0 ` , and it may not be necessary to state that the reciproacal is positive. (Contributed by Jim Kingdon, 6-Feb-2020.) (New usage is discouraged.)
theorem axprecex {x3: setvar} (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 cltrr)) (wrex x3 (wa (wbr cc0 (cv x3) cltrr) (wceq (co A2 (cv x3) cmul) c1)) cr) $;

--| A complex number can be expressed in terms of two reals. Definition 10-1.1(v) of [Gleason] p. 130. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-cnre . (Contributed by NM, 13-May-1996.) (New usage is discouraged.)
theorem axcnre {x3 y1: setvar} (A2: class):
  $ wi (wcel A2 cc) (wrex x3 (wrex y1 (wceq A2 (co (cv x3) (co ci (cv y1) cmul) caddc)) cr) cr) $;

--| Real number less-than is irreflexive. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-pre-ltirr . (Contributed by Jim Kingdon, 12-Jan-2020.) (New usage is discouraged.)
theorem axpre_ltirr (A2: class):
  $ wi (wcel A2 cr) (wn (wbr A2 A2 cltrr)) $;

--| Real number less-than is weakly linear. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-pre-ltwlin . (Contributed by Jim Kingdon, 12-Jan-2020.) (New usage is discouraged.)
theorem axpre_ltwlin (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wi (wbr A2 B2 cltrr) (wo (wbr A2 C cltrr) (wbr C B2 cltrr))) $;

--| Ordering on reals is transitive. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-pre-lttrn . (Contributed by NM, 19-May-1996.) (Revised by Mario Carneiro, 16-Jun-2013.) (New usage is discouraged.)
theorem axpre_lttrn (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wi (wa (wbr A2 B2 cltrr) (wbr B2 C cltrr)) (wbr A2 C cltrr)) $;

--| Apartness of reals is tight. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-pre-apti . (Contributed by Jim Kingdon, 29-Jan-2020.) (New usage is discouraged.)
theorem axpre_apti (A2 B2: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wn (wo (wbr A2 B2 cltrr) (wbr B2 A2 cltrr)))) (wceq A2 B2) $;

--| Ordering property of addition on reals. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-pre-ltadd . (Contributed by NM, 11-May-1996.) (New usage is discouraged.)
theorem axpre_ltadd (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wi (wbr A2 B2 cltrr) (wbr (co C A2 caddc) (co C B2 caddc) cltrr)) $;

--| The product of two positive reals is positive. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-pre-mulgt0 . (Contributed by NM, 13-May-1996.) (New usage is discouraged.)
theorem axpre_mulgt0 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wi (wa (wbr cc0 A2 cltrr) (wbr cc0 B2 cltrr)) (wbr cc0 (co A2 B2 cmul) cltrr)) $;

--| Strong extensionality of multiplication (expressed in terms of ` <RR ` ). Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-pre-mulext . (Contributed by Jim Kingdon, 18-Feb-2020.) (New usage is discouraged.)
theorem axpre_mulext (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wi (wbr (co A2 C cmul) (co B2 C cmul) cltrr) (wo (wbr A2 B2 cltrr) (wbr B2 A2 cltrr))) $;

--| The reciprocal from ~ axprecex is unique. (Contributed by Jim Kingdon, 15-Jul-2021.)
theorem rereceu {x3: setvar} (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 cltrr)) (wreu x3 (wceq (co A2 (cv x3) cmul) c1) cr) $;

--| Two ways to express the reciprocal of a natural number. (Contributed by Jim Kingdon, 11-Jul-2021.)
theorem recriota {u r l: setvar} (N: class):
  $ wi (wcel N cnpi) (wceq (crio r (wceq (co (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop N c1o) ceq) cltq)) (cab u (wbr (cec (cop N c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) (cv r) cmul) c1) cr) (cop (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop N c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop N c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) c0r)) $;

--| Archimedean axiom. The Archimedean property is more naturally stated once we have defined ` NN ` . Unless we find another way to state it, we'll just use the right hand side of ~ dfnn2 in stating what we mean by "natural number" in the context of this axiom. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-arch . (Contributed by Jim Kingdon, 22-Apr-2020.) (New usage is discouraged.)
theorem axarch {x3 y1 n: setvar} (A2: class):
  $ wi (wcel A2 cr) (wrex n (wbr A2 (cv n) cltrr) (cint (cab x3 (wa (wcel c1 (cv x3)) (wral y1 (wcel (co (cv y1) c1 caddc) (cv x3)) (cv x3)))))) $;

--| Peano's inductive postulate. This is a counterpart to ~ peano5nni designed for real number axioms which involve natural numbers (notably, ~ axcaucvg ). (Contributed by Jim Kingdon, 14-Jul-2021.) (New usage is discouraged.)
theorem peano5nnnn {x3 y1 z: setvar} (A2: class) (N: class x3 y1 z):
  $ wceq N (cint (cab x3 (wa (wcel c1 (cv x3)) (wral y1 (wcel (co (cv y1) c1 caddc) (cv x3)) (cv x3))))) $ >
  $ wi (wa (wcel c1 A2) (wral z (wcel (co (cv z) c1 caddc) A2) A2)) (wss N A2) $;

--| Principle of Mathematical Induction (inference schema). This is a counterpart to ~ nnind designed for real number axioms which involve natural numbers (notably, ~ axcaucvg ). (Contributed by Jim Kingdon, 14-Jul-2021.) (New usage is discouraged.)
theorem nnindnn {x3 y1 z k: setvar} (ph: wff z) (ps ch th ta: wff x3 y1 k) (A2: class x3 y1 k) (N: class):
  $ wceq N (cint (cab x3 (wa (wcel c1 (cv x3)) (wral y1 (wcel (co (cv y1) c1 caddc) (cv x3)) (cv x3))))) $ >
  $ wi (wceq (cv z) c1) (wb ph ps) $ >
  $ wi (wceq (cv z) (cv k)) (wb ph ch) $ >
  $ wi (wceq (cv z) (co (cv k) c1 caddc)) (wb ph th) $ >
  $ wi (wceq (cv z) A2) (wb ph ta) $ >
  $ ps $ >
  $ wi (wcel (cv k) N) (wi ch th) $ >
  $ wi (wcel A2 N) ta $;

--| Mapping from ` NN ` to ` N. ` . (Contributed by Jim Kingdon, 13-Jul-2021.)
theorem nntopi {x3 y1 z u l: setvar} (A2: class x3 y1 u l) (N: class u l):
  $ wceq N (cint (cab x3 (wa (wcel c1 (cv x3)) (wral y1 (wcel (co (cv y1) c1 caddc) (cv x3)) (cv x3))))) $ >
  $ wi (wcel A2 N) (wrex z (wceq (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop (cv z) c1o) ceq) cltq)) (cab u (wbr (cec (cop (cv z) c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) A2) cnpi) $;

--| Lemma for ~ axcaucvg . Mapping to ` N. ` and ` R. ` . (Contributed by Jim Kingdon, 10-Jul-2021.)
theorem axcaucvglemcl {x3 y1 z u l: setvar} (ph: wff x3 y1 z u l) (F: class x3 y1 u l) (J: class x3 y1) (N: class x3 y1 z u l):
  $ wceq N (cint (cab x3 (wa (wcel c1 (cv x3)) (wral y1 (wcel (co (cv y1) c1 caddc) (cv x3)) (cv x3))))) $ >
  $ wi ph (wf N cr F) $ >
  $ wi (wa ph (wcel J cnpi)) (wcel (crio z (wceq (cfv (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop J c1o) ceq) cltq)) (cab u (wbr (cec (cop J c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) F) (cop (cv z) c0r)) cnr) cnr) $;

--| Lemma for ~ axcaucvg . Mapping to ` N. ` and ` R. ` yields a sequence. (Contributed by Jim Kingdon, 9-Jul-2021.)
theorem axcaucvglemf {x3 y1 z u j k n r l: setvar} (ph: wff x3 y1 z u k n r l) (F: class x3 y1 u j k n r l) (G N: class x3 y1 z u j k n r l):
  $ wceq N (cint (cab x3 (wa (wcel c1 (cv x3)) (wral y1 (wcel (co (cv y1) c1 caddc) (cv x3)) (cv x3))))) $ >
  $ wi ph (wf N cr F) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) cltrr) (wa (wbr (cfv (cv n) F) (co (cfv (cv k) F) (crio r (wceq (co (cv n) (cv r) cmul) c1) cr) caddc) cltrr) (wbr (cfv (cv k) F) (co (cfv (cv n) F) (crio r (wceq (co (cv n) (cv r) cmul) c1) cr) caddc) cltrr))) N) N) $ >
  $ wceq G (cmpt j cnpi (crio z (wceq (cfv (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop (cv j) c1o) ceq) cltq)) (cab u (wbr (cec (cop (cv j) c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) F) (cop (cv z) c0r)) cnr)) $ >
  $ wi ph (wf cnpi cnr G) $;

--| Lemma for ~ axcaucvg . Value of sequence when mapping to ` N. ` and ` R. ` . (Contributed by Jim Kingdon, 10-Jul-2021.)
theorem axcaucvglemval {x3 y1 z u j k n r l: setvar} (ph: wff x3 y1 z u k n r l) (F: class x3 y1 u k n r l) (G: class x3 y1 u j k n r l) (J: class x3 y1 k n r) (N: class x3 y1 z u j k n r l):
  $ wceq N (cint (cab x3 (wa (wcel c1 (cv x3)) (wral y1 (wcel (co (cv y1) c1 caddc) (cv x3)) (cv x3))))) $ >
  $ wi ph (wf N cr F) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) cltrr) (wa (wbr (cfv (cv n) F) (co (cfv (cv k) F) (crio r (wceq (co (cv n) (cv r) cmul) c1) cr) caddc) cltrr) (wbr (cfv (cv k) F) (co (cfv (cv n) F) (crio r (wceq (co (cv n) (cv r) cmul) c1) cr) caddc) cltrr))) N) N) $ >
  $ wceq G (cmpt j cnpi (crio z (wceq (cfv (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop (cv j) c1o) ceq) cltq)) (cab u (wbr (cec (cop (cv j) c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) F) (cop (cv z) c0r)) cnr)) $ >
  $ wi (wa ph (wcel J cnpi)) (wceq (cfv (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop J c1o) ceq) cltq)) (cab u (wbr (cec (cop J c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) F) (cop (cfv J G) c0r)) $;

--| Lemma for ~ axcaucvg . The result of mapping to ` N. ` and ` R. ` satisfies the Cauchy condition. (Contributed by Jim Kingdon, 9-Jul-2021.)
theorem axcaucvglemcau {x3 y1 z u j k n r l: setvar} (ph: wff x3 y1 z u r l) (F: class x3 y1 u r l) (G: class x3 y1 u j k n r l) (N: class x3 y1 z u j r l):
  $ wceq N (cint (cab x3 (wa (wcel c1 (cv x3)) (wral y1 (wcel (co (cv y1) c1 caddc) (cv x3)) (cv x3))))) $ >
  $ wi ph (wf N cr F) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) cltrr) (wa (wbr (cfv (cv n) F) (co (cfv (cv k) F) (crio r (wceq (co (cv n) (cv r) cmul) c1) cr) caddc) cltrr) (wbr (cfv (cv k) F) (co (cfv (cv n) F) (crio r (wceq (co (cv n) (cv r) cmul) c1) cr) caddc) cltrr))) N) N) $ >
  $ wceq G (cmpt j cnpi (crio z (wceq (cfv (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop (cv j) c1o) ceq) cltq)) (cab u (wbr (cec (cop (cv j) c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) F) (cop (cv z) c0r)) cnr)) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) clti) (wa (wbr (cfv (cv n) G) (co (cfv (cv k) G) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr) (wbr (cfv (cv k) G) (co (cfv (cv n) G) (cec (cop (co (cop (cab l (wbr (cv l) (cfv (cec (cop (cv n) c1o) ceq) crq) cltq)) (cab u (wbr (cfv (cec (cop (cv n) c1o) ceq) crq) (cv u) cltq))) c1p cpp) c1p) cer) cplr) cltr))) cnpi) cnpi) $;

--| Lemma for ~ axcaucvg . Mapping the limit from ` N. ` and ` R. ` . (Contributed by Jim Kingdon, 10-Jul-2021.)
theorem axcaucvglemres {x3 y1 z u j k n r l: setvar} (ph: wff y1 z u r l) (F: class x3 u r l) (G: class y1 j r) (N: class z u r l):
  $ wceq N (cint (cab x3 (wa (wcel c1 (cv x3)) (wral y1 (wcel (co (cv y1) c1 caddc) (cv x3)) (cv x3))))) $ >
  $ wi ph (wf N cr F) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) cltrr) (wa (wbr (cfv (cv n) F) (co (cfv (cv k) F) (crio r (wceq (co (cv n) (cv r) cmul) c1) cr) caddc) cltrr) (wbr (cfv (cv k) F) (co (cfv (cv n) F) (crio r (wceq (co (cv n) (cv r) cmul) c1) cr) caddc) cltrr))) N) N) $ >
  $ wceq G (cmpt j cnpi (crio z (wceq (cfv (cop (cec (cop (co (cop (cab l (wbr (cv l) (cec (cop (cv j) c1o) ceq) cltq)) (cab u (wbr (cec (cop (cv j) c1o) ceq) (cv u) cltq))) c1p cpp) c1p) cer) c0r) F) (cop (cv z) c0r)) cnr)) $ >
  $ wi ph (wrex y1 (wral x3 (wi (wbr cc0 (cv x3) cltrr) (wrex j (wral k (wi (wbr (cv j) (cv k) cltrr) (wa (wbr (cfv (cv k) F) (co (cv y1) (cv x3) caddc) cltrr) (wbr (cv y1) (co (cfv (cv k) F) (cv x3) caddc) cltrr))) N) N)) cr) cr) $;

--| Real number completeness axiom. A Cauchy sequence with a modulus of convergence converges. This is basically Corollary 11.2.13 of [HoTT], p. (varies). The HoTT book theorem has a modulus of convergence (that is, a rate of convergence) specified by (11.2.9) in HoTT whereas this theorem fixes the rate of convergence to say that all terms after the nth term must be within ` 1 / n ` of the nth term (it should later be able to prove versions of this theorem with a different fixed rate or a modulus of convergence supplied as a hypothesis). Because we are stating this axiom before we have introduced notations for ` NN ` or division, we use ` N ` for the natural numbers and express a reciprocal in terms of ` iota_ ` . This construction-dependent theorem should not be referenced directly; instead, use ~ ax-caucvg . (Contributed by Jim Kingdon, 8-Jul-2021.) (New usage is discouraged.)
theorem axcaucvg {x3 y1 j k n r: setvar} (ph: wff y1 r) (F N: class r):
  $ wceq N (cint (cab x3 (wa (wcel c1 (cv x3)) (wral y1 (wcel (co (cv y1) c1 caddc) (cv x3)) (cv x3))))) $ >
  $ wi ph (wf N cr F) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) cltrr) (wa (wbr (cfv (cv n) F) (co (cfv (cv k) F) (crio r (wceq (co (cv n) (cv r) cmul) c1) cr) caddc) cltrr) (wbr (cfv (cv k) F) (co (cfv (cv n) F) (crio r (wceq (co (cv n) (cv r) cmul) c1) cr) caddc) cltrr))) N) N) $ >
  $ wi ph (wrex y1 (wral x3 (wi (wbr cc0 (cv x3) cltrr) (wrex j (wral k (wi (wbr (cv j) (cv k) cltrr) (wa (wbr (cfv (cv k) F) (co (cv y1) (cv x3) caddc) cltrr) (wbr (cv y1) (co (cfv (cv k) F) (cv x3) caddc) cltrr))) N) N)) cr) cr) $;

--| The complex numbers form a set. Use ~ cnex instead. (Contributed by Mario Carneiro, 17-Nov-2014.) (New usage is discouraged.)
theorem ax_cnex:
  $ wcel cc cvv $;

--| The real numbers are a subset of the complex numbers. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-resscn . (Contributed by NM, 1-Mar-1995.) (Proof shortened by Andrew Salmon, 12-Aug-2011.) (New usage is discouraged.)
theorem ax_resscn:
  $ wss cr cc $;

--| 1 is a complex number. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-1cn . (Contributed by NM, 12-Apr-2007.) (New usage is discouraged.)
theorem ax_1cn:
  $ wcel c1 cc $;

--| 1 is a real number. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-1re . In the Metamath Proof Explorer, this is not a complex number axiom but is proved from ~ ax-1cn and the other axioms. It is not known whether we can do so here, but the Metamath Proof Explorer proof (accessed 13-Jan-2020) uses excluded middle. (Contributed by Jim Kingdon, 13-Jan-2020.) (New usage is discouraged.)
theorem ax_1re:
  $ wcel c1 cr $;

--| ` _i ` is a complex number. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-icn . (Contributed by NM, 23-Feb-1996.) (New usage is discouraged.)
theorem ax_icn:
  $ wcel ci cc $;

--| Closure law for addition of complex numbers. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly, nor should the proven axiom ~ ax-addcl be used later. Instead, in most cases use ~ addcl . (Contributed by NM, 14-Jun-1995.) (New usage is discouraged.)
theorem ax_addcl (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wcel (co A2 B2 caddc) cc) $;

--| Closure law for addition in the real subfield of complex numbers. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly, nor should the proven axiom ~ ax-addrcl be used later. Instead, in most cases use ~ readdcl . (Contributed by NM, 31-Mar-1996.) (New usage is discouraged.)
theorem ax_addrcl (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wcel (co A2 B2 caddc) cr) $;

--| Closure law for multiplication of complex numbers. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly, nor should the proven axiom ~ ax-mulcl be used later. Instead, in most cases use ~ mulcl . (Contributed by NM, 10-Aug-1995.) (New usage is discouraged.)
theorem ax_mulcl (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wcel (co A2 B2 cmul) cc) $;

--| Closure law for multiplication in the real subfield of complex numbers. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly, nor should the proven axiom ~ ax-mulrcl be used later. Instead, in most cases use ~ remulcl . (New usage is discouraged.) (Contributed by NM, 31-Mar-1996.)
theorem ax_mulrcl (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wcel (co A2 B2 cmul) cr) $;

--| Addition commutes. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly, nor should the proven axiom ~ ax-addcom be used later. Instead, use ~ addcom . In the Metamath Proof Explorer this is not a complex number axiom but is instead proved from other axioms. That proof relies on real number trichotomy and it is not known whether it is possible to prove this from the other axioms without it. (Contributed by Jim Kingdon, 17-Jan-2020.) (New usage is discouraged.)
theorem ax_addcom (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co A2 B2 caddc) (co B2 A2 caddc)) $;

--| Multiplication of complex numbers is commutative. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly, nor should the proven axiom ~ ax-mulcom be used later. Instead, use ~ mulcom . (Contributed by NM, 31-Aug-1995.) (New usage is discouraged.)
theorem ax_mulcom (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co A2 B2 cmul) (co B2 A2 cmul)) $;

--| Addition of complex numbers is associative. This theorem transfers the associative laws for the real and imaginary signed real components of complex number pairs, to complex number addition itself. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly, nor should the proven axiom ~ ax-addass be used later. Instead, use ~ addass . (Contributed by NM, 2-Sep-1995.) (New usage is discouraged.)
theorem ax_addass (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 caddc) C caddc) (co A2 (co B2 C caddc) caddc)) $;

--| Multiplication of complex numbers is associative. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-mulass . (Contributed by NM, 3-Sep-1995.) (New usage is discouraged.)
theorem ax_mulass (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 cmul) C cmul) (co A2 (co B2 C cmul) cmul)) $;

--| Distributive law for complex numbers (left-distributivity). Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly, nor should the proven axiom ~ ax-distr be used later. Instead, use ~ adddi . (Contributed by NM, 2-Sep-1995.) (New usage is discouraged.)
theorem ax_distr (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co A2 (co B2 C caddc) cmul) (co (co A2 B2 cmul) (co A2 C cmul) caddc)) $;

--| i-squared equals -1 (expressed as i-squared plus 1 is 0). Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-i2m1 . (Contributed by NM, 5-May-1996.) (New usage is discouraged.)
theorem ax_i2m1:
  $ wceq (co (co ci ci cmul) c1 caddc) cc0 $;

--| 0 is less than 1. Axiom for real and complex numbers, justified by theorem ~ ax0lt1 . Proofs should normally use ~ 0lt1 instead. (New usage is discouraged.) (Contributed by Jim Kingdon, 12-Jan-2020.)
theorem ax_0lt1:
  $ wbr cc0 c1 cltrr $;

--| ` 1 ` is an identity element for real multiplication. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-1rid . (Contributed by Scott Fenton, 3-Jan-2013.) (New usage is discouraged.)
theorem ax_1rid (A2: class):
  $ wi (wcel A2 cr) (wceq (co A2 c1 cmul) A2) $;

--| ` 0 ` is an identity element for real addition. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-0id . In the Metamath Proof Explorer this is not a complex number axiom but is instead proved from other axioms. That proof relies on excluded middle and it is not known whether it is possible to prove this from the other axioms without excluded middle. (Contributed by Jim Kingdon, 16-Jan-2020.) (New usage is discouraged.)
theorem ax_0id (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 cc0 caddc) A2) $;

--| Existence of negative of real number. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-rnegex . (Contributed by NM, 15-May-1996.) (New usage is discouraged.)
theorem ax_rnegex {x3: setvar} (A2: class):
  $ wi (wcel A2 cr) (wrex x3 (wceq (co A2 (cv x3) caddc) cc0) cr) $;

--| Existence of positive reciprocal of positive real number. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-precex . In treatments which assume excluded middle, the ` 0 <RR A ` condition is generally replaced by ` A =/= 0 ` , and it may not be necessary to state that the reciproacal is positive. (Contributed by Jim Kingdon, 6-Feb-2020.) (New usage is discouraged.)
theorem ax_precex {x3: setvar} (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 cltrr)) (wrex x3 (wa (wbr cc0 (cv x3) cltrr) (wceq (co A2 (cv x3) cmul) c1)) cr) $;

--| A complex number can be expressed in terms of two reals. Definition 10-1.1(v) of [Gleason] p. 130. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-cnre . (Contributed by NM, 13-May-1996.) (New usage is discouraged.)
theorem ax_cnre {x3 y1: setvar} (A2: class):
  $ wi (wcel A2 cc) (wrex x3 (wrex y1 (wceq A2 (co (cv x3) (co ci (cv y1) cmul) caddc)) cr) cr) $;

--| Real number less-than is irreflexive. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-pre-ltirr . (Contributed by Jim Kingdon, 12-Jan-2020.) (New usage is discouraged.)
theorem ax_pre_ltirr (A2: class):
  $ wi (wcel A2 cr) (wn (wbr A2 A2 cltrr)) $;

--| Real number less-than is weakly linear. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-pre-ltwlin . (Contributed by Jim Kingdon, 12-Jan-2020.) (New usage is discouraged.)
theorem ax_pre_ltwlin (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wi (wbr A2 B2 cltrr) (wo (wbr A2 C cltrr) (wbr C B2 cltrr))) $;

--| Ordering on reals is transitive. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-pre-lttrn . (Contributed by NM, 19-May-1996.) (Revised by Mario Carneiro, 16-Jun-2013.) (New usage is discouraged.)
theorem ax_pre_lttrn (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wi (wa (wbr A2 B2 cltrr) (wbr B2 C cltrr)) (wbr A2 C cltrr)) $;

--| Apartness of reals is tight. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-pre-apti . (Contributed by Jim Kingdon, 29-Jan-2020.) (New usage is discouraged.)
theorem ax_pre_apti (A2 B2: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wn (wo (wbr A2 B2 cltrr) (wbr B2 A2 cltrr)))) (wceq A2 B2) $;

--| Ordering property of addition on reals. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-pre-ltadd . (Contributed by NM, 11-May-1996.) (New usage is discouraged.)
theorem ax_pre_ltadd (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wi (wbr A2 B2 cltrr) (wbr (co C A2 caddc) (co C B2 caddc) cltrr)) $;

--| The product of two positive reals is positive. Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-pre-mulgt0 . (Contributed by NM, 13-May-1996.) (New usage is discouraged.)
theorem ax_pre_mulgt0 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wi (wa (wbr cc0 A2 cltrr) (wbr cc0 B2 cltrr)) (wbr cc0 (co A2 B2 cmul) cltrr)) $;

--| Strong extensionality of multiplication (expressed in terms of ` <RR ` ). Axiom for real and complex numbers, derived from set theory. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-pre-mulext . (Contributed by Jim Kingdon, 18-Feb-2020.) (New usage is discouraged.)
theorem ax_pre_mulext (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wi (wbr (co A2 C cmul) (co B2 C cmul) cltrr) (wo (wbr A2 B2 cltrr) (wbr B2 A2 cltrr))) $;

--| Archimedean axiom. The Archimedean property is more naturally stated once we have defined ` NN ` . Unless we find another way to state it, we'll just use the right hand side of ~ dfnn2 in stating what we mean by "natural number" in the context of this axiom. This construction-dependent theorem should not be referenced directly; instead, use ~ ax-arch . (Contributed by Jim Kingdon, 22-Apr-2020.) (New usage is discouraged.)
theorem ax_arch {x3 y1 n: setvar} (A2: class):
  $ wi (wcel A2 cr) (wrex n (wbr A2 (cv n) cltrr) (cint (cab x3 (wa (wcel c1 (cv x3)) (wral y1 (wcel (co (cv y1) c1 caddc) (cv x3)) (cv x3)))))) $;

--| Completeness. Axiom for real and complex numbers, justified by theorem ~ axcaucvg . A Cauchy sequence (as defined here, which has a rate convergence built in) of real numbers converges to a real number. Specifically on rate of convergence, all terms after the nth term must be within ` 1 / n ` of the nth term. This axiom should not be used directly; instead use ~ caucvgre (which is the same, but stated in terms of the ` NN ` and ` 1 / n ` notations). (Contributed by Jim Kingdon, 19-Jul-2021.) (New usage is discouraged.)
axiom ax_caucvg {x3 y1 j k n r: setvar} (ph: wff y1 r) (F N: class r):
  $ wceq N (cint (cab x3 (wa (wcel c1 (cv x3)) (wral y1 (wcel (co (cv y1) c1 caddc) (cv x3)) (cv x3))))) $ >
  $ wi ph (wf N cr F) $ >
  $ wi ph (wral n (wral k (wi (wbr (cv n) (cv k) cltrr) (wa (wbr (cfv (cv n) F) (co (cfv (cv k) F) (crio r (wceq (co (cv n) (cv r) cmul) c1) cr) caddc) cltrr) (wbr (cfv (cv k) F) (co (cfv (cv n) F) (crio r (wceq (co (cv n) (cv r) cmul) c1) cr) caddc) cltrr))) N) N) $ >
  $ wi ph (wrex y1 (wral x3 (wi (wbr cc0 (cv x3) cltrr) (wrex j (wral k (wi (wbr (cv j) (cv k) cltrr) (wa (wbr (cfv (cv k) F) (co (cv y1) (cv x3) caddc) cltrr) (wbr (cv y1) (co (cfv (cv k) F) (cv x3) caddc) cltrr))) N) N)) cr) cr) $;

--| Alias for ~ ax-cnex . (Contributed by Mario Carneiro, 17-Nov-2014.)
theorem cnex:
  $ wcel cc cvv $;

--| Alias for ~ ax-addcl , for naming consistency with ~ addcli . Use this theorem instead of ~ ax-addcl or ~ axaddcl . (Contributed by NM, 10-Mar-2008.)
theorem addcl (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wcel (co A2 B2 caddc) cc) $;

--| Alias for ~ ax-addrcl , for naming consistency with ~ readdcli . (Contributed by NM, 10-Mar-2008.)
theorem readdcl (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wcel (co A2 B2 caddc) cr) $;

--| Alias for ~ ax-mulcl , for naming consistency with ~ mulcli . (Contributed by NM, 10-Mar-2008.)
theorem mulcl (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wcel (co A2 B2 cmul) cc) $;

--| Alias for ~ ax-mulrcl , for naming consistency with ~ remulcli . (Contributed by NM, 10-Mar-2008.)
theorem remulcl (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wcel (co A2 B2 cmul) cr) $;

--| Alias for ~ ax-mulcom , for naming consistency with ~ mulcomi . (Contributed by NM, 10-Mar-2008.)
theorem mulcom (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co A2 B2 cmul) (co B2 A2 cmul)) $;

--| Alias for ~ ax-addass , for naming consistency with ~ addassi . (Contributed by NM, 10-Mar-2008.)
theorem addass (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 caddc) C caddc) (co A2 (co B2 C caddc) caddc)) $;

--| Alias for ~ ax-mulass , for naming consistency with ~ mulassi . (Contributed by NM, 10-Mar-2008.)
theorem mulass (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 cmul) C cmul) (co A2 (co B2 C cmul) cmul)) $;

--| Alias for ~ ax-distr , for naming consistency with ~ adddii . (Contributed by NM, 10-Mar-2008.)
theorem adddi (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co A2 (co B2 C caddc) cmul) (co (co A2 B2 cmul) (co A2 C cmul) caddc)) $;

--| A real number is a complex number. (Contributed by NM, 10-Aug-1999.)
theorem recn (A2: class):
  $ wi (wcel A2 cr) (wcel A2 cc) $;

--| The real numbers form a set. (Contributed by Mario Carneiro, 17-Nov-2014.)
theorem reex:
  $ wcel cr cvv $;

--| Reals are a subset of the pair of real and complex numbers (common case). (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem reelprrecn:
  $ wcel cr (cpr cr cc) $;

--| Complex numbers are a subset of the pair of real and complex numbers (common case). (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem cnelprrecn:
  $ wcel cc (cpr cr cc) $;

--| Distributive law for complex numbers (right-distributivity). (Contributed by NM, 10-Oct-2004.)
theorem adddir (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 caddc) C cmul) (co (co A2 C cmul) (co B2 C cmul) caddc)) $;

--| 0 is a complex number. (Contributed by NM, 19-Feb-2005.)
theorem _0cn:
  $ wcel cc0 cc $;

--| 0 is a complex number, deductive form. (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem _0cnd (ph: wff):
  $ wi ph (wcel cc0 cc) $;

--| 0 is a set (common case). (Contributed by David A. Wheeler, 7-Jul-2016.)
theorem c0ex:
  $ wcel cc0 cvv $;

--| 1 is a set. Common special case. (Contributed by David A. Wheeler, 7-Jul-2016.)
theorem _1ex:
  $ wcel c1 cvv $;

--| Alias for ~ ax-cnre , for naming consistency. (Contributed by NM, 3-Jan-2013.)
theorem cnre {x3 y1: setvar} (A2: class):
  $ wi (wcel A2 cc) (wrex x3 (wrex y1 (wceq A2 (co (cv x3) (co ci (cv y1) cmul) caddc)) cr) cr) $;

--| ` 1 ` is an identity element for multiplication. Based on ideas by Eric Schmidt. (Contributed by Scott Fenton, 3-Jan-2013.)
theorem mulid1 (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 c1 cmul) A2) $;

--| Identity law for multiplication. Note: see ~ mulid1 for commuted version. (Contributed by NM, 8-Oct-1999.)
theorem mulid2 (A2: class):
  $ wi (wcel A2 cc) (wceq (co c1 A2 cmul) A2) $;

--| ` 1 ` is a real number. (Contributed by Jim Kingdon, 13-Jan-2020.)
theorem _1re:
  $ wcel c1 cr $;

--| ` 0 ` is a real number. (Contributed by Eric Schmidt, 21-May-2007.) (Revised by Scott Fenton, 3-Jan-2013.)
theorem _0re:
  $ wcel cc0 cr $;

--| ` 0 ` is a real number, deductive form. (Contributed by David A. Wheeler, 6-Dec-2018.)
theorem _0red (ph: wff):
  $ wi ph (wcel cc0 cr) $;

--| Identity law for multiplication. (Contributed by NM, 14-Feb-1995.)
theorem mulid1i (A2: class):
  $ wcel A2 cc $ >
  $ wceq (co A2 c1 cmul) A2 $;

--| Identity law for multiplication. (Contributed by NM, 14-Feb-1995.)
theorem mulid2i (A2: class):
  $ wcel A2 cc $ >
  $ wceq (co c1 A2 cmul) A2 $;

--| Closure law for addition. (Contributed by NM, 23-Nov-1994.)
theorem addcli (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel (co A2 B2 caddc) cc $;

--| Closure law for multiplication. (Contributed by NM, 23-Nov-1994.)
theorem mulcli (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel (co A2 B2 cmul) cc $;

--| Commutative law for multiplication. (Contributed by NM, 23-Nov-1994.)
theorem mulcomi (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (co A2 B2 cmul) (co B2 A2 cmul) $;

--| Commutative law for multiplication. (Contributed by NM, 23-Nov-1994.)
theorem mulcomli (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (co A2 B2 cmul) C $ >
  $ wceq (co B2 A2 cmul) C $;

--| Associative law for addition. (Contributed by NM, 23-Nov-1994.)
theorem addassi (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wceq (co (co A2 B2 caddc) C caddc) (co A2 (co B2 C caddc) caddc) $;

--| Associative law for multiplication. (Contributed by NM, 23-Nov-1994.)
theorem mulassi (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wceq (co (co A2 B2 cmul) C cmul) (co A2 (co B2 C cmul) cmul) $;

--| Distributive law (left-distributivity). (Contributed by NM, 23-Nov-1994.)
theorem adddii (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wceq (co A2 (co B2 C caddc) cmul) (co (co A2 B2 cmul) (co A2 C cmul) caddc) $;

--| Distributive law (right-distributivity). (Contributed by NM, 16-Feb-1995.)
theorem adddiri (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wceq (co (co A2 B2 caddc) C cmul) (co (co A2 C cmul) (co B2 C cmul) caddc) $;

--| A real number is a complex number. (Contributed by NM, 1-Mar-1995.)
theorem recni (A2: class):
  $ wcel A2 cr $ >
  $ wcel A2 cc $;

--| Closure law for addition of reals. (Contributed by NM, 17-Jan-1997.)
theorem readdcli (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wcel (co A2 B2 caddc) cr $;

--| Closure law for multiplication of reals. (Contributed by NM, 17-Jan-1997.)
theorem remulcli (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wcel (co A2 B2 cmul) cr $;

--| 1 is an real number, deductive form (common case). (Contributed by David A. Wheeler, 6-Dec-2018.)
theorem _1red (ph: wff):
  $ wi ph (wcel c1 cr) $;

--| 1 is a complex number, deductive form (common case). (Contributed by David A. Wheeler, 6-Dec-2018.)
theorem _1cnd (ph: wff):
  $ wi ph (wcel c1 cc) $;

--| Identity law for multiplication. (Contributed by Mario Carneiro, 27-May-2016.)
theorem mulid1d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co A2 c1 cmul) A2) $;

--| Identity law for multiplication. (Contributed by Mario Carneiro, 27-May-2016.)
theorem mulid2d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co c1 A2 cmul) A2) $;

--| Closure law for addition. (Contributed by Mario Carneiro, 27-May-2016.)
theorem addcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel (co A2 B2 caddc) cc) $;

--| Closure law for multiplication. (Contributed by Mario Carneiro, 27-May-2016.)
theorem mulcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel (co A2 B2 cmul) cc) $;

--| Commutative law for multiplication. (Contributed by Mario Carneiro, 27-May-2016.)
theorem mulcomd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (co A2 B2 cmul) (co B2 A2 cmul)) $;

--| Associative law for addition. (Contributed by Mario Carneiro, 27-May-2016.)
theorem addassd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wceq (co (co A2 B2 caddc) C caddc) (co A2 (co B2 C caddc) caddc)) $;

--| Associative law for multiplication. (Contributed by Mario Carneiro, 27-May-2016.)
theorem mulassd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wceq (co (co A2 B2 cmul) C cmul) (co A2 (co B2 C cmul) cmul)) $;

--| Distributive law (left-distributivity). (Contributed by Mario Carneiro, 27-May-2016.)
theorem adddid (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wceq (co A2 (co B2 C caddc) cmul) (co (co A2 B2 cmul) (co A2 C cmul) caddc)) $;

--| Distributive law (right-distributivity). (Contributed by Mario Carneiro, 27-May-2016.)
theorem adddird (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wceq (co (co A2 B2 caddc) C cmul) (co (co A2 C cmul) (co B2 C cmul) caddc)) $;

--| Join AB+CB into (A+C) on LHS. (Contributed by David A. Wheeler, 26-Oct-2019.)
theorem joinlmuladdmuld (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wceq (co (co A2 B2 cmul) (co C B2 cmul) caddc) D) $ >
  $ wi ph (wceq (co (co A2 C caddc) B2 cmul) D) $;

--| Deduction from real number to complex number. (Contributed by NM, 26-Oct-1999.)
theorem recnd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel A2 cc) $;

--| Closure law for addition of reals. (Contributed by Mario Carneiro, 27-May-2016.)
theorem readdcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel (co A2 B2 caddc) cr) $;

--| Closure law for multiplication of reals. (Contributed by Mario Carneiro, 27-May-2016.)
theorem remulcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel (co A2 B2 cmul) cr) $;

--| Plus infinity.
term cpnf: class;

--| Minus infinity.
term cmnf: class;

--| The set of extended reals (includes plus and minus infinity).
term cxr: class;

--| 'Less than' predicate (extended to include the extended reals).
term clt: class;

--| Extend wff notation to include the 'less than or equal to' relation.
term cle: class;

--| Define plus infinity. Note that the definition is arbitrary, requiring only that ` +oo ` be a set not in ` RR ` and different from ` -oo ` ( ~ df-mnf ). We use ` ~P U. CC ` to make it independent of the construction of ` CC ` , and Cantor's Theorem will show that it is different from any member of ` CC ` and therefore ` RR ` . See ~ pnfnre and ~ mnfnre , and we'll also be able to prove ` +oo =/= -oo ` . A simpler possibility is to define ` +oo ` as ` CC ` and ` -oo ` as ` { CC } ` , but that approach requires the Axiom of Regularity to show that ` +oo ` and ` -oo ` are different from each other and from all members of ` RR ` . (Contributed by NM, 13-Oct-2005.) (New usage is discouraged.)
axiom df_pnf:
  $ wceq cpnf (cpw (cuni cc)) $;

--| Define minus infinity as the power set of plus infinity. Note that the definition is arbitrary, requiring only that ` -oo ` be a set not in ` RR ` and different from ` +oo ` (see ~ mnfnre ). (Contributed by NM, 13-Oct-2005.) (New usage is discouraged.)
axiom df_mnf:
  $ wceq cmnf (cpw cpnf) $;

--| Define the set of extended reals that includes plus and minus infinity. Definition 12-3.1 of [Gleason] p. 173. (Contributed by NM, 13-Oct-2005.)
axiom df_xr:
  $ wceq cxr (cun cr (cpr cpnf cmnf)) $;

--| Define 'less than' on the set of extended reals. Definition 12-3.1 of [Gleason] p. 173. Note that in our postulates for complex numbers, ` <RR ` is primitive and not necessarily a relation on ` RR ` . (Contributed by NM, 13-Oct-2005.)
axiom df_ltxr {x3 y1: setvar}:
  $ wceq clt (cun (copab x3 y1 (w3a (wcel (cv x3) cr) (wcel (cv y1) cr) (wbr (cv x3) (cv y1) cltrr))) (cun (cxp (cun cr (csn cmnf)) (csn cpnf)) (cxp (csn cmnf) cr))) $;

--| Define 'less than or equal to' on the extended real subset of complex numbers. (Contributed by NM, 13-Oct-2005.)
axiom df_le:
  $ wceq cle (cdif (cxp cxr cxr) (ccnv clt)) $;

--| Plus infinity is not a real number. (Contributed by NM, 13-Oct-2005.)
theorem pnfnre:
  $ wnel cpnf cr $;

--| Minus infinity is not a real number. (Contributed by NM, 13-Oct-2005.)
theorem mnfnre:
  $ wnel cmnf cr $;

--| The standard reals are a subset of the extended reals. (Contributed by NM, 14-Oct-2005.)
theorem ressxr:
  $ wss cr cxr $;

--| The Cartesian product of standard reals are a subset of the Cartesian product of extended reals (common case). (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem rexpssxrxp:
  $ wss (cxp cr cr) (cxp cxr cxr) $;

--| A standard real is an extended real. (Contributed by NM, 14-Oct-2005.)
theorem rexr (A2: class):
  $ wi (wcel A2 cr) (wcel A2 cxr) $;

--| Zero is an extended real. (Contributed by Mario Carneiro, 15-Jun-2014.)
theorem _0xr:
  $ wcel cc0 cxr $;

--| No (finite) real equals plus infinity. (Contributed by NM, 14-Oct-2005.) (Proof shortened by Andrew Salmon, 19-Nov-2011.)
theorem renepnf (A2: class):
  $ wi (wcel A2 cr) (wne A2 cpnf) $;

--| No real equals minus infinity. (Contributed by NM, 14-Oct-2005.) (Proof shortened by Andrew Salmon, 19-Nov-2011.)
theorem renemnf (A2: class):
  $ wi (wcel A2 cr) (wne A2 cmnf) $;

--| A standard real is an extended real. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rexrd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel A2 cxr) $;

--| No (finite) real equals plus infinity. (Contributed by Mario Carneiro, 28-May-2016.)
theorem renepnfd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wne A2 cpnf) $;

--| No real equals minus infinity. (Contributed by Mario Carneiro, 28-May-2016.)
theorem renemnfd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wne A2 cmnf) $;

--| A standard real is an extended real (inference form.) (Contributed by David Moews, 28-Feb-2017.)
theorem rexri (A2: class):
  $ wcel A2 cr $ >
  $ wcel A2 cxr $;

--| The reals and the infinities are disjoint. (Contributed by NM, 25-Oct-2005.) (Proof shortened by Andrew Salmon, 19-Nov-2011.)
theorem renfdisj:
  $ wceq (cin cr (cpr cpnf cmnf)) c0 $;

--| 'Less than' is a relation on extended reals. (Contributed by Mario Carneiro, 28-Apr-2015.)
theorem ltrelxr:
  $ wss clt (cxp cxr cxr) $;

--| 'Less than' is a relation. (Contributed by NM, 14-Oct-2005.)
theorem ltrel:
  $ wrel clt $;

--| 'Less than or equal' is a relation on extended reals. (Contributed by Mario Carneiro, 28-Apr-2015.)
theorem lerelxr:
  $ wss cle (cxp cxr cxr) $;

--| 'Less or equal to' is a relation. (Contributed by FL, 2-Aug-2009.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem lerel:
  $ wrel cle $;

--| 'Less than or equal to' expressed in terms of 'less than', for extended reals. (Contributed by NM, 14-Oct-2005.)
theorem xrlenlt (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wbr A2 B2 cle) (wn (wbr B2 A2 clt))) $;

--| The standard less-than ` <RR ` and the extended real less-than ` < ` are identical when restricted to the non-extended reals ` RR ` . (Contributed by NM, 13-Oct-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem ltxrlt (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr A2 B2 clt) (wbr A2 B2 cltrr)) $;

--| Real number less-than is irreflexive. Axiom for real and complex numbers, derived from set theory. This restates ~ ax-pre-ltirr with ordering on the extended reals. New proofs should use ~ ltnr instead for naming consistency. (New usage is discouraged.) (Contributed by Jim Kingdon, 15-Jan-2020.)
theorem axltirr (A2: class):
  $ wi (wcel A2 cr) (wn (wbr A2 A2 clt)) $;

--| Real number less-than is weakly linear. Axiom for real and complex numbers, derived from set theory. This restates ~ ax-pre-ltwlin with ordering on the extended reals. (Contributed by Jim Kingdon, 15-Jan-2020.)
theorem axltwlin (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wi (wbr A2 B2 clt) (wo (wbr A2 C clt) (wbr C B2 clt))) $;

--| Ordering on reals is transitive. Axiom for real and complex numbers, derived from set theory. This restates ~ ax-pre-lttrn with ordering on the extended reals. New proofs should use ~ lttr instead for naming consistency. (New usage is discouraged.) (Contributed by NM, 13-Oct-2005.)
theorem axlttrn (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wi (wa (wbr A2 B2 clt) (wbr B2 C clt)) (wbr A2 C clt)) $;

--| Ordering property of addition on reals. Axiom for real and complex numbers, derived from set theory. (This restates ~ ax-pre-ltadd with ordering on the extended reals.) (Contributed by NM, 13-Oct-2005.)
theorem axltadd (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wi (wbr A2 B2 clt) (wbr (co C A2 caddc) (co C B2 caddc) clt)) $;

--| Apartness of reals is tight. Axiom for real and complex numbers, derived from set theory. (This restates ~ ax-pre-apti with ordering on the extended reals.) (Contributed by Jim Kingdon, 29-Jan-2020.)
theorem axapti (A2 B2: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wn (wo (wbr A2 B2 clt) (wbr B2 A2 clt)))) (wceq A2 B2) $;

--| The product of two positive reals is positive. Axiom for real and complex numbers, derived from set theory. (This restates ~ ax-pre-mulgt0 with ordering on the extended reals.) (Contributed by NM, 13-Oct-2005.)
theorem axmulgt0 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wi (wa (wbr cc0 A2 clt) (wbr cc0 B2 clt)) (wbr cc0 (co A2 B2 cmul) clt)) $;

--| Alias for ~ axlttrn , for naming consistency with ~ lttri . New proofs should generally use this instead of ~ ax-pre-lttrn . (Contributed by NM, 10-Mar-2008.)
theorem lttr (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wi (wa (wbr A2 B2 clt) (wbr B2 C clt)) (wbr A2 C clt)) $;

--| The product of two positive numbers is positive. (Contributed by NM, 10-Mar-2008.)
theorem mulgt0 (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wbr cc0 A2 clt)) (wa (wcel B2 cr) (wbr cc0 B2 clt))) (wbr cc0 (co A2 B2 cmul) clt) $;

--| 'Less than or equal to' expressed in terms of 'less than'. Part of definition 11.2.7(vi) of [HoTT], p. (varies). (Contributed by NM, 13-May-1999.)
theorem lenlt (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr A2 B2 cle) (wn (wbr B2 A2 clt))) $;

--| 'Less than' is irreflexive. (Contributed by NM, 18-Aug-1999.)
theorem ltnr (A2: class):
  $ wi (wcel A2 cr) (wn (wbr A2 A2 clt)) $;

--| 'Less than' is a strict ordering. (Contributed by NM, 19-Jan-1997.)
theorem ltso:
  $ wor cr clt $;

--| 'Greater than' is a strict ordering. (Contributed by JJ, 11-Oct-2018.)
theorem gtso:
  $ wor cr (ccnv clt) $;

--| Tightness of real apartness. (Contributed by NM, 5-May-1999.)
theorem lttri3 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wceq A2 B2) (wa (wn (wbr A2 B2 clt)) (wn (wbr B2 A2 clt)))) $;

--| Tightness of real apartness. (Contributed by NM, 14-May-1999.)
theorem letri3 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wceq A2 B2) (wa (wbr A2 B2 cle) (wbr B2 A2 cle))) $;

--| Transitive law, weaker form of ` ( A < B /\ B <_ C ) -> A < C ` . (Contributed by AV, 14-Oct-2018.)
theorem ltleletr (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wi (wa (wbr A2 B2 clt) (wbr B2 C cle)) (wbr A2 C cle)) $;

--| Transitive law. (Contributed by NM, 12-Nov-1999.)
theorem letr (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wi (wa (wbr A2 B2 cle) (wbr B2 C cle)) (wbr A2 C cle)) $;

--| 'Less than or equal to' is reflexive. (Contributed by NM, 18-Aug-1999.)
theorem leid (A2: class):
  $ wi (wcel A2 cr) (wbr A2 A2 cle) $;

--| 'Less than' implies not equal. See also ~ ltap which is the same but for apartness. (Contributed by NM, 9-Oct-1999.) (Revised by Mario Carneiro, 16-Sep-2015.)
theorem ltne (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wbr A2 B2 clt)) (wne B2 A2) $;

--| 'Less than' is not symmetric. (Contributed by NM, 8-Jan-2002.)
theorem ltnsym (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wi (wbr A2 B2 clt) (wn (wbr B2 A2 clt))) $;

--| 'Less than' implies 'less than or equal to'. (Contributed by NM, 25-Aug-1999.)
theorem ltle (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wi (wbr A2 B2 clt) (wbr A2 B2 cle)) $;

--| Transitive law. Part of Definition 11.2.7(vi) of [HoTT], p. (varies). (Contributed by NM, 23-May-1999.)
theorem lelttr (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wi (wa (wbr A2 B2 cle) (wbr B2 C clt)) (wbr A2 C clt)) $;

--| Transitive law. Part of Definition 11.2.7(vi) of [HoTT], p. (varies). (Contributed by NM, 25-Aug-1999.)
theorem ltletr (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wi (wa (wbr A2 B2 clt) (wbr B2 C cle)) (wbr A2 C clt)) $;

--| 'Less than' is antisymmetric and irreflexive. (Contributed by NM, 13-Aug-2005.) (Proof shortened by Andrew Salmon, 19-Nov-2011.)
theorem ltnsym2 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wn (wa (wbr A2 B2 clt) (wbr B2 A2 clt))) $;

--| Equality implies 'less than or equal to'. (Contributed by NM, 4-Apr-2005.)
theorem eqle (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wceq A2 B2)) (wbr A2 B2 cle) $;

--| 'Less than' is irreflexive. (Contributed by NM, 18-Aug-1999.)
theorem ltnri (A2: class):
  $ wcel A2 cr $ >
  $ wn (wbr A2 A2 clt) $;

--| Equality implies 'less than or equal to'. (Contributed by NM, 23-May-1999.) (Revised by Alexander van der Vekens, 20-Mar-2018.)
theorem eqlei (A2 B2: class):
  $ wcel A2 cr $ >
  $ wi (wceq A2 B2) (wbr A2 B2 cle) $;

--| Equality implies 'less than or equal to'. (Contributed by Alexander van der Vekens, 20-Mar-2018.)
theorem eqlei2 (A2 B2: class):
  $ wcel A2 cr $ >
  $ wi (wceq B2 A2) (wbr B2 A2 cle) $;

--| 'Less than' implies not equal. See also ~ gtapii which is the same for apartness. (Contributed by Mario Carneiro, 30-Sep-2013.)
theorem gtneii (A2 B2: class):
  $ wcel A2 cr $ >
  $ wbr A2 B2 clt $ >
  $ wne B2 A2 $;

--| 'Greater than' implies not equal. (Contributed by Mario Carneiro, 16-Sep-2015.)
theorem ltneii (A2 B2: class):
  $ wcel A2 cr $ >
  $ wbr A2 B2 clt $ >
  $ wne A2 B2 $;

--| Tightness of real apartness. (Contributed by NM, 14-May-1999.)
theorem lttri3i (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wb (wceq A2 B2) (wa (wn (wbr A2 B2 clt)) (wn (wbr B2 A2 clt))) $;

--| Tightness of real apartness. (Contributed by NM, 14-May-1999.)
theorem letri3i (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wb (wceq A2 B2) (wa (wbr A2 B2 cle) (wbr B2 A2 cle)) $;

--| 'Less than' is not symmetric. (Contributed by NM, 6-May-1999.)
theorem ltnsymi (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wi (wbr A2 B2 clt) (wn (wbr B2 A2 clt)) $;

--| 'Less than or equal to' in terms of 'less than'. (Contributed by NM, 24-May-1999.)
theorem lenlti (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wb (wbr A2 B2 cle) (wn (wbr B2 A2 clt)) $;

--| 'Less than' implies 'less than or equal to'. (Contributed by NM, 14-May-1999.)
theorem ltlei (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wi (wbr A2 B2 clt) (wbr A2 B2 cle) $;

--| 'Less than' implies 'less than or equal to' (inference). (Contributed by NM, 22-Aug-1999.)
theorem ltleii (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wbr A2 B2 clt $ >
  $ wbr A2 B2 cle $;

--| 'Less than' implies not equal. (Contributed by NM, 28-Jul-1999.)
theorem ltnei (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wi (wbr A2 B2 clt) (wne B2 A2) $;

--| 'Less than' is transitive. Theorem I.17 of [Apostol] p. 20. (Contributed by NM, 14-May-1999.)
theorem lttri (A2 B2 C: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wcel C cr $ >
  $ wi (wa (wbr A2 B2 clt) (wbr B2 C clt)) (wbr A2 C clt) $;

--| 'Less than or equal to', 'less than' transitive law. (Contributed by NM, 14-May-1999.)
theorem lelttri (A2 B2 C: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wcel C cr $ >
  $ wi (wa (wbr A2 B2 cle) (wbr B2 C clt)) (wbr A2 C clt) $;

--| 'Less than', 'less than or equal to' transitive law. (Contributed by NM, 14-May-1999.)
theorem ltletri (A2 B2 C: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wcel C cr $ >
  $ wi (wa (wbr A2 B2 clt) (wbr B2 C cle)) (wbr A2 C clt) $;

--| 'Less than or equal to' is transitive. (Contributed by NM, 14-May-1999.)
theorem letri (A2 B2 C: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wcel C cr $ >
  $ wi (wa (wbr A2 B2 cle) (wbr B2 C cle)) (wbr A2 C cle) $;

--| Extended trichotomy law for 'less than or equal to'. (Contributed by NM, 14-Aug-2000.)
theorem le2tri3i (A2 B2 C: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wcel C cr $ >
  $ wb (w3a (wbr A2 B2 cle) (wbr B2 C cle) (wbr C A2 cle)) (w3a (wceq A2 B2) (wceq B2 C) (wceq C A2)) $;

--| The product of two positive numbers is positive. (Contributed by NM, 16-May-1999.)
theorem mulgt0i (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wi (wa (wbr cc0 A2 clt) (wbr cc0 B2 clt)) (wbr cc0 (co A2 B2 cmul) clt) $;

--| The product of two positive numbers is positive. (Contributed by NM, 18-May-1999.)
theorem mulgt0ii (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wbr cc0 A2 clt $ >
  $ wbr cc0 B2 clt $ >
  $ wbr cc0 (co A2 B2 cmul) clt $;

--| 'Less than' is irreflexive. (Contributed by Mario Carneiro, 27-May-2016.)
theorem ltnrd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wn (wbr A2 A2 clt)) $;

--| 'Less than' implies not equal. See also ~ gtapd which is the same but for apartness. (Contributed by Mario Carneiro, 27-May-2016.)
theorem gtned (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wne B2 A2) $;

--| 'Greater than' implies not equal. (Contributed by Mario Carneiro, 27-May-2016.)
theorem ltned (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wne A2 B2) $;

--| Tightness of real apartness. (Contributed by Mario Carneiro, 27-May-2016.)
theorem lttri3d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wb (wceq A2 B2) (wa (wn (wbr A2 B2 clt)) (wn (wbr B2 A2 clt)))) $;

--| Tightness of real apartness. (Contributed by Mario Carneiro, 27-May-2016.)
theorem letri3d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wb (wceq A2 B2) (wa (wbr A2 B2 cle) (wbr B2 A2 cle))) $;

--| 'Less than or equal to' in terms of 'less than'. (Contributed by Mario Carneiro, 27-May-2016.)
theorem lenltd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wb (wbr A2 B2 cle) (wn (wbr B2 A2 clt))) $;

--| 'Less than' implies 'less than or equal to'. (Contributed by Mario Carneiro, 27-May-2016.)
theorem ltled (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wbr A2 B2 cle) $;

--| 'Less than' implies 'less than or equal to'. (Contributed by Mario Carneiro, 27-May-2016.)
theorem ltnsymd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wn (wbr B2 A2 clt)) $;

--| The product of two positive numbers is positive. (Contributed by Mario Carneiro, 27-May-2016.)
theorem mulgt0d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 A2 clt) $ >
  $ wi ph (wbr cc0 B2 clt) $ >
  $ wi ph (wbr cc0 (co A2 B2 cmul) clt) $;

--| Transitive law deduction for 'less than or equal to'. (Contributed by NM, 20-May-2005.)
theorem letrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wbr B2 C cle) $ >
  $ wi ph (wbr A2 C cle) $;

--| Transitive law deduction for 'less than or equal to', 'less than'. (Contributed by NM, 8-Jan-2006.)
theorem lelttrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wbr B2 C clt) $ >
  $ wi ph (wbr A2 C clt) $;

--| Transitive law deduction for 'less than'. (Contributed by NM, 9-Jan-2006.)
theorem lttrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wbr B2 C clt) $ >
  $ wi ph (wbr A2 C clt) $;

--| 0 is less than 1. Theorem I.21 of [Apostol] p. 20. Part of definition 11.2.7(vi) of [HoTT], p. (varies). (Contributed by NM, 17-Jan-1997.)
theorem _0lt1:
  $ wbr cc0 c1 clt $;

--| Commutative/associative law for multiplication. (Contributed by NM, 30-Apr-2005.)
theorem mul12 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co A2 (co B2 C cmul) cmul) (co B2 (co A2 C cmul) cmul)) $;

--| Commutative/associative law. (Contributed by NM, 8-Oct-1999.)
theorem mul32 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 cmul) C cmul) (co (co A2 C cmul) B2 cmul)) $;

--| Commutative/associative law. (Contributed by Scott Fenton, 3-Jan-2013.)
theorem mul31 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 cmul) C cmul) (co (co C B2 cmul) A2 cmul)) $;

--| Rearrangement of 4 factors. (Contributed by NM, 8-Oct-1999.)
theorem mul4 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cc) (wcel B2 cc)) (wa (wcel C cc) (wcel D cc))) (wceq (co (co A2 B2 cmul) (co C D cmul) cmul) (co (co A2 C cmul) (co B2 D cmul) cmul)) $;

--| A simple product of sums expansion. (Contributed by NM, 21-Feb-2005.)
theorem muladd11 (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (co c1 A2 caddc) (co c1 B2 caddc) cmul) (co (co c1 A2 caddc) (co B2 (co A2 B2 cmul) caddc) caddc)) $;

--| Two times a number. (Contributed by NM, 18-May-1999.) (Revised by Mario Carneiro, 27-May-2016.)
theorem _1p1times (A2: class):
  $ wi (wcel A2 cc) (wceq (co (co c1 c1 caddc) A2 cmul) (co A2 A2 caddc)) $;

--| A theorem for complex numbers analogous the second Peano postulate ~ peano2 . (Contributed by NM, 17-Aug-2005.)
theorem peano2cn (A2: class):
  $ wi (wcel A2 cc) (wcel (co A2 c1 caddc) cc) $;

--| A theorem for reals analogous the second Peano postulate ~ peano2 . (Contributed by NM, 5-Jul-2005.)
theorem peano2re (A2: class):
  $ wi (wcel A2 cr) (wcel (co A2 c1 caddc) cr) $;

--| Addition commutes. (Contributed by Jim Kingdon, 17-Jan-2020.)
theorem addcom (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co A2 B2 caddc) (co B2 A2 caddc)) $;

--| ` 0 ` is an additive identity. (Contributed by Jim Kingdon, 16-Jan-2020.)
theorem addid1 (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 cc0 caddc) A2) $;

--| ` 0 ` is a left identity for addition. (Contributed by Scott Fenton, 3-Jan-2013.)
theorem addid2 (A2: class):
  $ wi (wcel A2 cc) (wceq (co cc0 A2 caddc) A2) $;

--| Cancellation law for addition over the reals. (Contributed by Scott Fenton, 3-Jan-2013.)
theorem readdcan (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wb (wceq (co C A2 caddc) (co C B2 caddc)) (wceq A2 B2)) $;

--| ` 0 ` is its own additive identity. (Contributed by Scott Fenton, 3-Jan-2013.)
theorem _00id:
  $ wceq (co cc0 cc0 caddc) cc0 $;

--| ` 0 ` is an additive identity. (Contributed by NM, 23-Nov-1994.) (Revised by Scott Fenton, 3-Jan-2013.)
theorem addid1i (A2: class):
  $ wcel A2 cc $ >
  $ wceq (co A2 cc0 caddc) A2 $;

--| ` 0 ` is a left identity for addition. (Contributed by NM, 3-Jan-2013.)
theorem addid2i (A2: class):
  $ wcel A2 cc $ >
  $ wceq (co cc0 A2 caddc) A2 $;

--| Addition commutes. Based on ideas by Eric Schmidt. (Contributed by Scott Fenton, 3-Jan-2013.)
theorem addcomi (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (co A2 B2 caddc) (co B2 A2 caddc) $;

--| Addition commutes. (Contributed by Mario Carneiro, 19-Apr-2015.)
theorem addcomli (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (co A2 B2 caddc) C $ >
  $ wceq (co B2 A2 caddc) C $;

--| Commutative/associative law that swaps the first two factors in a triple product. (Contributed by NM, 11-May-1999.) (Proof shortened by Andrew Salmon, 19-Nov-2011.)
theorem mul12i (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wceq (co A2 (co B2 C cmul) cmul) (co B2 (co A2 C cmul) cmul) $;

--| Commutative/associative law that swaps the last two factors in a triple product. (Contributed by NM, 11-May-1999.)
theorem mul32i (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wceq (co (co A2 B2 cmul) C cmul) (co (co A2 C cmul) B2 cmul) $;

--| Rearrangement of 4 factors. (Contributed by NM, 16-Feb-1995.)
theorem mul4i (A2 B2 C D: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wcel D cc $ >
  $ wceq (co (co A2 B2 cmul) (co C D cmul) cmul) (co (co A2 C cmul) (co B2 D cmul) cmul) $;

--| ` 0 ` is an additive identity. (Contributed by Mario Carneiro, 27-May-2016.)
theorem addid1d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co A2 cc0 caddc) A2) $;

--| ` 0 ` is a left identity for addition. (Contributed by Mario Carneiro, 27-May-2016.)
theorem addid2d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co cc0 A2 caddc) A2) $;

--| Addition commutes. Based on ideas by Eric Schmidt. (Contributed by Scott Fenton, 3-Jan-2013.) (Revised by Mario Carneiro, 27-May-2016.)
theorem addcomd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (co A2 B2 caddc) (co B2 A2 caddc)) $;

--| Commutative/associative law that swaps the first two factors in a triple product. (Contributed by Mario Carneiro, 27-May-2016.)
theorem mul12d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wceq (co A2 (co B2 C cmul) cmul) (co B2 (co A2 C cmul) cmul)) $;

--| Commutative/associative law that swaps the last two factors in a triple product. (Contributed by Mario Carneiro, 27-May-2016.)
theorem mul32d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wceq (co (co A2 B2 cmul) C cmul) (co (co A2 C cmul) B2 cmul)) $;

--| Commutative/associative law. (Contributed by Mario Carneiro, 27-May-2016.)
theorem mul31d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wceq (co (co A2 B2 cmul) C cmul) (co (co C B2 cmul) A2 cmul)) $;

--| Rearrangement of 4 factors. (Contributed by Mario Carneiro, 27-May-2016.)
theorem mul4d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel D cc) $ >
  $ wi ph (wceq (co (co A2 B2 cmul) (co C D cmul) cmul) (co (co A2 C cmul) (co B2 D cmul) cmul)) $;

--| Commutative/associative law that swaps the first two terms in a triple sum. (Contributed by NM, 11-May-2004.)
theorem add12 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co A2 (co B2 C caddc) caddc) (co B2 (co A2 C caddc) caddc)) $;

--| Commutative/associative law that swaps the last two terms in a triple sum. (Contributed by NM, 13-Nov-1999.)
theorem add32 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 caddc) C caddc) (co (co A2 C caddc) B2 caddc)) $;

--| Commutative/associative law that swaps the last two terms in a triple sum, rearranging the parentheses. (Contributed by Paul Chapman, 18-May-2007.)
theorem add32r (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co A2 (co B2 C caddc) caddc) (co (co A2 C caddc) B2 caddc)) $;

--| Rearrangement of 4 terms in a sum. (Contributed by NM, 13-Nov-1999.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem add4 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cc) (wcel B2 cc)) (wa (wcel C cc) (wcel D cc))) (wceq (co (co A2 B2 caddc) (co C D caddc) caddc) (co (co A2 C caddc) (co B2 D caddc) caddc)) $;

--| Rearrangement of 4 terms in a sum. (Contributed by NM, 12-May-2005.)
theorem add42 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cc) (wcel B2 cc)) (wa (wcel C cc) (wcel D cc))) (wceq (co (co A2 B2 caddc) (co C D caddc) caddc) (co (co A2 C caddc) (co D B2 caddc) caddc)) $;

--| Commutative/associative law that swaps the first two terms in a triple sum. (Contributed by NM, 21-Jan-1997.)
theorem add12i (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wceq (co A2 (co B2 C caddc) caddc) (co B2 (co A2 C caddc) caddc) $;

--| Commutative/associative law that swaps the last two terms in a triple sum. (Contributed by NM, 21-Jan-1997.)
theorem add32i (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wceq (co (co A2 B2 caddc) C caddc) (co (co A2 C caddc) B2 caddc) $;

--| Rearrangement of 4 terms in a sum. (Contributed by NM, 9-May-1999.)
theorem add4i (A2 B2 C D: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wcel D cc $ >
  $ wceq (co (co A2 B2 caddc) (co C D caddc) caddc) (co (co A2 C caddc) (co B2 D caddc) caddc) $;

--| Rearrangement of 4 terms in a sum. (Contributed by NM, 22-Aug-1999.)
theorem add42i (A2 B2 C D: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wcel D cc $ >
  $ wceq (co (co A2 B2 caddc) (co C D caddc) caddc) (co (co A2 C caddc) (co D B2 caddc) caddc) $;

--| Commutative/associative law that swaps the first two terms in a triple sum. (Contributed by Mario Carneiro, 27-May-2016.)
theorem add12d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wceq (co A2 (co B2 C caddc) caddc) (co B2 (co A2 C caddc) caddc)) $;

--| Commutative/associative law that swaps the last two terms in a triple sum. (Contributed by Mario Carneiro, 27-May-2016.)
theorem add32d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wceq (co (co A2 B2 caddc) C caddc) (co (co A2 C caddc) B2 caddc)) $;

--| Rearrangement of 4 terms in a sum. (Contributed by Mario Carneiro, 27-May-2016.)
theorem add4d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel D cc) $ >
  $ wi ph (wceq (co (co A2 B2 caddc) (co C D caddc) caddc) (co (co A2 C caddc) (co B2 D caddc) caddc)) $;

--| Rearrangement of 4 terms in a sum. (Contributed by Mario Carneiro, 27-May-2016.)
theorem add42d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel D cc) $ >
  $ wi ph (wceq (co (co A2 B2 caddc) (co C D caddc) caddc) (co (co A2 C caddc) (co D B2 caddc) caddc)) $;

--| Extend class notation to include subtraction.
term cmin: class;

--| Extend class notation to include unary minus. The symbol ` -u ` is not a class by itself but part of a compound class definition. We do this rather than making it a formal function since it is so commonly used. Note: We use different symbols for unary minus ( ` -u ` ) and subtraction ~ cmin ( ` - ` ) to prevent syntax ambiguity. For example, looking at the syntax definition ~ co , if we used the same symbol then " ` ( - A - B ) ` " could mean either " ` - A ` " minus " ` B ` ", or it could represent the (meaningless) operation of classes " ` - ` " and " ` - B ` " connected with "operation" " ` A ` ". On the other hand, " ` ( -u A - B ) ` " is unambiguous.
term cneg (A2: class): class;

--| Define subtraction. Theorem ~ subval shows its value (and describes how this definition works), theorem ~ subaddi relates it to addition, and theorems ~ subcli and ~ resubcli prove its closure laws. (Contributed by NM, 26-Nov-1994.)
axiom df_sub {x3 y1 z: setvar}:
  $ wceq cmin (cmpt2 x3 y1 cc cc (crio z (wceq (co (cv y1) (cv z) caddc) (cv x3)) cc)) $;

--| Define the negative of a number (unary minus). We use different symbols for unary minus ( ` -u ` ) and subtraction ( ` - ` ) to prevent syntax ambiguity. See ~ cneg for a discussion of this. (Contributed by NM, 10-Feb-1995.)
axiom df_neg (A2: class):
  $ wceq (cneg A2) (co cc0 A2 cmin) $;

--| Addition cancellation of a real number from two complex numbers. Lemma for ~ cnegex . (Contributed by Eric Schmidt, 22-May-2007.)
theorem cnegexlem1 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cc) (wcel C cc)) (wb (wceq (co A2 B2 caddc) (co A2 C caddc)) (wceq B2 C)) $;

--| Existence of a real number which produces a real number when multiplied by ` _i ` . (Hint: zero is such a number, although we don't need to prove that yet). Lemma for ~ cnegex . (Contributed by Eric Schmidt, 22-May-2007.)
theorem cnegexlem2 {y1: setvar}:
  $ wrex y1 (wcel (co ci (cv y1) cmul) cr) cr $;

--| Existence of real number difference. Lemma for ~ cnegex . (Contributed by Eric Schmidt, 22-May-2007.)
theorem cnegexlem3 {c: setvar} (y1 b: setvar):
  $ wi (wa (wcel (cv b) cr) (wcel (cv y1) cr)) (wrex c (wceq (co (cv b) (cv c) caddc) (cv y1)) cr) $;

--| Existence of the negative of a complex number. (Contributed by Eric Schmidt, 21-May-2007.)
theorem cnegex {x3: setvar} (A2: class):
  $ wi (wcel A2 cc) (wrex x3 (wceq (co A2 (cv x3) caddc) cc0) cc) $;

--| Existence of a left inverse for addition. (Contributed by Scott Fenton, 3-Jan-2013.)
theorem cnegex2 {x3: setvar} (A2: class):
  $ wi (wcel A2 cc) (wrex x3 (wceq (co (cv x3) A2 caddc) cc0) cc) $;

--| Cancellation law for addition. Theorem I.1 of [Apostol] p. 18. (Contributed by NM, 22-Nov-1994.) (Proof shortened by Mario Carneiro, 27-May-2016.)
theorem addcan (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wb (wceq (co A2 B2 caddc) (co A2 C caddc)) (wceq B2 C)) $;

--| Cancellation law for addition. (Contributed by NM, 30-Jul-2004.) (Revised by Scott Fenton, 3-Jan-2013.)
theorem addcan2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wb (wceq (co A2 C caddc) (co B2 C caddc)) (wceq A2 B2)) $;

--| Cancellation law for addition. Theorem I.1 of [Apostol] p. 18. (Contributed by NM, 27-Oct-1999.) (Revised by Scott Fenton, 3-Jan-2013.)
theorem addcani (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wb (wceq (co A2 B2 caddc) (co A2 C caddc)) (wceq B2 C) $;

--| Cancellation law for addition. Theorem I.1 of [Apostol] p. 18. (Contributed by NM, 14-May-2003.) (Revised by Scott Fenton, 3-Jan-2013.)
theorem addcan2i (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wb (wceq (co A2 C caddc) (co B2 C caddc)) (wceq A2 B2) $;

--| Cancellation law for addition. Theorem I.1 of [Apostol] p. 18. (Contributed by Mario Carneiro, 27-May-2016.)
theorem addcand (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wb (wceq (co A2 B2 caddc) (co A2 C caddc)) (wceq B2 C)) $;

--| Cancellation law for addition. Theorem I.1 of [Apostol] p. 18. (Contributed by Mario Carneiro, 27-May-2016.)
theorem addcan2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wb (wceq (co A2 C caddc) (co B2 C caddc)) (wceq A2 B2)) $;

--| Cancelling a term on the left-hand side of a sum in an equality. Consequence of ~ addcand . (Contributed by David Moews, 28-Feb-2017.)
theorem addcanad (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wceq (co A2 B2 caddc) (co A2 C caddc)) $ >
  $ wi ph (wceq B2 C) $;

--| Cancelling a term on the right-hand side of a sum in an equality. Consequence of ~ addcan2d . (Contributed by David Moews, 28-Feb-2017.)
theorem addcan2ad (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wceq (co A2 C caddc) (co B2 C caddc)) $ >
  $ wi ph (wceq A2 B2) $;

--| Introducing a term on the left-hand side of a sum in a negated equality. Contrapositive of ~ addcanad . Consequence of ~ addcand . (Contributed by David Moews, 28-Feb-2017.)
theorem addneintrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wne (co A2 B2 caddc) (co A2 C caddc)) $;

--| Introducing a term on the right-hand side of a sum in a negated equality. Contrapositive of ~ addcan2ad . Consequence of ~ addcan2d . (Contributed by David Moews, 28-Feb-2017.)
theorem addneintr2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne (co A2 C caddc) (co B2 C caddc)) $;

--| Alternate proof of ~ 0cn . (Contributed by NM, 19-Feb-2005.) (Revised by Mario Carneiro, 27-May-2016.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem _0cnALT:
  $ wcel cc0 cc $;

--| Existential uniqueness of negatives. Theorem I.2 of [Apostol] p. 18. (Contributed by NM, 22-Nov-1994.) (Proof shortened by Mario Carneiro, 27-May-2016.)
theorem negeu {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wreu x3 (wceq (co A2 (cv x3) caddc) B2) cc) $;

--| Value of subtraction, which is the (unique) element ` x ` such that ` B + x = A ` . (Contributed by NM, 4-Aug-2007.) (Revised by Mario Carneiro, 2-Nov-2013.)
theorem subval {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co A2 B2 cmin) (crio x3 (wceq (co B2 (cv x3) caddc) A2) cc)) $;

--| Equality theorem for negatives. (Contributed by NM, 10-Feb-1995.)
theorem negeq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (cneg A2) (cneg B2)) $;

--| Equality inference for negatives. (Contributed by NM, 14-Feb-1995.)
theorem negeqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq (cneg A2) (cneg B2) $;

--| Equality deduction for negatives. (Contributed by NM, 14-May-1999.)
theorem negeqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cneg A2) (cneg B2)) $;

--| Deduction version of ~ nfneg . (Contributed by NM, 29-Feb-2008.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfnegd {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 (cneg A2)) $;

--| Bound-variable hypothesis builder for the negative of a complex number. (Contributed by NM, 12-Jun-2005.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfneg {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (cneg A2) $;

--| Move class substitution in and out of the negative of a number. (Contributed by NM, 1-Mar-2008.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem csbnegg {x3: setvar} (A2 B2 V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (cneg B2)) (cneg (csb x3 A2 B2))) $;

--| Closure law for subtraction. (Contributed by NM, 10-May-1999.) (Revised by Mario Carneiro, 21-Dec-2013.)
theorem subcl (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wcel (co A2 B2 cmin) cc) $;

--| Closure law for negative. (Contributed by NM, 6-Aug-2003.)
theorem negcl (A2: class):
  $ wi (wcel A2 cc) (wcel (cneg A2) cc) $;

--| ` -u _i ` is a complex number (common case). (Contributed by David A. Wheeler, 7-Dec-2018.)
theorem negicn:
  $ wcel (cneg ci) cc $;

--| Subtraction is an operation on the complex numbers. (Contributed by NM, 4-Aug-2007.) (Revised by Mario Carneiro, 16-Nov-2013.)
theorem subf:
  $ wf (cxp cc cc) cc cmin $;

--| Relationship between subtraction and addition. (Contributed by NM, 20-Jan-1997.) (Revised by Mario Carneiro, 21-Dec-2013.)
theorem subadd (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wb (wceq (co A2 B2 cmin) C) (wceq (co B2 C caddc) A2)) $;

--| Relationship between subtraction and addition. (Contributed by Scott Fenton, 5-Jul-2013.) (Proof shortened by Mario Carneiro, 27-May-2016.)
theorem subadd2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wb (wceq (co A2 B2 cmin) C) (wceq (co C B2 caddc) A2)) $;

--| Swap subtrahend and result of subtraction. (Contributed by NM, 14-Dec-2007.)
theorem subsub23 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wb (wceq (co A2 B2 cmin) C) (wceq (co A2 C cmin) B2)) $;

--| Cancellation law for subtraction. (Contributed by NM, 10-May-2004.) (Revised by Mario Carneiro, 27-May-2016.)
theorem pncan (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (co A2 B2 caddc) B2 cmin) A2) $;

--| Cancellation law for subtraction. (Contributed by NM, 17-Apr-2005.)
theorem pncan2 (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (co A2 B2 caddc) A2 cmin) B2) $;

--| Subtraction and addition of equals. (Contributed by NM, 14-Mar-2005.)
theorem pncan3 (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co A2 (co B2 A2 cmin) caddc) B2) $;

--| Cancellation law for subtraction. (Contributed by NM, 10-May-2004.) (Revised by Mario Carneiro, 27-May-2016.)
theorem npcan (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (co A2 B2 cmin) B2 caddc) A2) $;

--| Associative-type law for addition and subtraction. (Contributed by NM, 6-Aug-2003.) (Revised by Mario Carneiro, 27-May-2016.)
theorem addsubass (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 caddc) C cmin) (co A2 (co B2 C cmin) caddc)) $;

--| Law for addition and subtraction. (Contributed by NM, 19-Aug-2001.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem addsub (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 caddc) C cmin) (co (co A2 C cmin) B2 caddc)) $;

--| Commutative/associative law for addition and subtraction. (Contributed by NM, 1-Feb-2007.)
theorem subadd23 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 cmin) C caddc) (co A2 (co C B2 cmin) caddc)) $;

--| Commutative/associative law for addition and subtraction. (Contributed by NM, 8-Feb-2005.)
theorem addsub12 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co A2 (co B2 C cmin) caddc) (co B2 (co A2 C cmin) caddc)) $;

--| Law for subtraction and addition. (Contributed by NM, 20-Nov-2005.)
theorem _2addsub (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cc) (wcel B2 cc)) (wa (wcel C cc) (wcel D cc))) (wceq (co (co (co A2 B2 caddc) C caddc) D cmin) (co (co (co A2 C caddc) D cmin) B2 caddc)) $;

--| Relation between sums and differences. (Contributed by Jeff Madsen, 17-Jun-2010.)
theorem addsubeq4 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cc) (wcel B2 cc)) (wa (wcel C cc) (wcel D cc))) (wb (wceq (co A2 B2 caddc) (co C D caddc)) (wceq (co C A2 cmin) (co B2 D cmin))) $;

--| Subtraction and addition of equals. Almost but not exactly the same as ~ pncan3i and ~ pncan , this order happens often when applying "operations to both sides" so create a theorem specifically for it. A deduction version of this is available as ~ pncand . (Contributed by David A. Wheeler, 11-Oct-2018.)
theorem pncan3oi (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (co (co A2 B2 caddc) B2 cmin) A2 $;

--| Move RHS right addition to LHS. (Contributed by David A. Wheeler, 11-Oct-2018.)
theorem mvrraddi (A2 B2 C: class):
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wceq A2 (co B2 C caddc) $ >
  $ wceq (co A2 C cmin) B2 $;

--| Move LHS left addition to RHS. (Contributed by David A. Wheeler, 11-Oct-2018.)
theorem mvlladdi (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (co A2 B2 caddc) C $ >
  $ wceq B2 (co C A2 cmin) $;

--| Subtraction of a number from itself. (Contributed by NM, 8-Oct-1999.) (Revised by Mario Carneiro, 27-May-2016.)
theorem subid (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 A2 cmin) cc0) $;

--| Identity law for subtraction. (Contributed by NM, 9-May-2004.) (Revised by Mario Carneiro, 27-May-2016.)
theorem subid1 (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 cc0 cmin) A2) $;

--| Cancellation law for subtraction. (Contributed by NM, 8-Feb-2005.)
theorem npncan (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 cmin) (co B2 C cmin) caddc) (co A2 C cmin)) $;

--| Cancellation law for subtraction. (Contributed by NM, 1-Sep-2005.)
theorem nppcan (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co (co A2 B2 cmin) C caddc) B2 caddc) (co A2 C caddc)) $;

--| Cancellation law for subtraction: ((a-b)-c)+b = a-c holds for complex numbers a,b,c. (Contributed by Alexander van der Vekens, 24-Mar-2018.)
theorem nnpcan (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co (co A2 B2 cmin) C cmin) B2 caddc) (co A2 C cmin)) $;

--| Cancellation law for subtraction. (Contributed by Mario Carneiro, 14-Sep-2015.)
theorem nppcan3 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 cmin) (co C B2 caddc) caddc) (co A2 C caddc)) $;

--| Cancellation law for subtraction. (Contributed by NM, 8-Feb-2005.)
theorem subcan2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wb (wceq (co A2 C cmin) (co B2 C cmin)) (wceq A2 B2)) $;

--| If the difference between two numbers is zero, they are equal. (Contributed by NM, 16-Nov-1999.)
theorem subeq0 (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wb (wceq (co A2 B2 cmin) cc0) (wceq A2 B2)) $;

--| Cancellation law for subtraction. (Contributed by Scott Fenton, 21-Jun-2013.)
theorem npncan2 (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (co A2 B2 cmin) (co B2 A2 cmin) caddc) cc0) $;

--| Law for double subtraction. (Contributed by NM, 30-Jun-2005.) (Revised by Mario Carneiro, 27-May-2016.)
theorem subsub2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co A2 (co B2 C cmin) cmin) (co A2 (co C B2 cmin) caddc)) $;

--| Cancellation law for subtraction. (Contributed by NM, 21-Jun-2005.) (Proof shortened by Andrew Salmon, 19-Nov-2011.)
theorem nncan (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co A2 (co A2 B2 cmin) cmin) B2) $;

--| Law for double subtraction. (Contributed by NM, 13-May-2004.)
theorem subsub (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co A2 (co B2 C cmin) cmin) (co (co A2 B2 cmin) C caddc)) $;

--| Cancellation law for subtraction. (Contributed by NM, 29-Sep-2005.)
theorem nppcan2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 (co B2 C caddc) cmin) C caddc) (co A2 B2 cmin)) $;

--| Law for double subtraction. (Contributed by NM, 27-Jul-2005.)
theorem subsub3 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co A2 (co B2 C cmin) cmin) (co (co A2 C caddc) B2 cmin)) $;

--| Law for double subtraction. (Contributed by NM, 19-Aug-2005.) (Revised by Mario Carneiro, 27-May-2016.)
theorem subsub4 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 cmin) C cmin) (co A2 (co B2 C caddc) cmin)) $;

--| Swap the second and third terms in a double subtraction. (Contributed by NM, 19-Aug-2005.)
theorem sub32 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 cmin) C cmin) (co (co A2 C cmin) B2 cmin)) $;

--| Cancellation law for subtraction. (Contributed by NM, 4-Sep-2005.)
theorem nnncan (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 (co B2 C cmin) cmin) C cmin) (co A2 B2 cmin)) $;

--| Cancellation law for subtraction. (Contributed by NM, 8-Feb-2005.) (Proof shortened by Andrew Salmon, 19-Nov-2011.)
theorem nnncan1 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 cmin) (co A2 C cmin) cmin) (co C B2 cmin)) $;

--| Cancellation law for subtraction. (Contributed by NM, 1-Oct-2005.)
theorem nnncan2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 C cmin) (co B2 C cmin) cmin) (co A2 B2 cmin)) $;

--| Cancellation law for subtraction. (Contributed by Scott Fenton, 23-Jun-2013.) (Proof shortened by Mario Carneiro, 27-May-2016.)
theorem npncan3 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 cmin) (co C A2 cmin) caddc) (co C B2 cmin)) $;

--| Cancellation law for mixed addition and subtraction. (Contributed by NM, 4-Mar-2005.) (Revised by Mario Carneiro, 27-May-2016.)
theorem pnpcan (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 caddc) (co A2 C caddc) cmin) (co B2 C cmin)) $;

--| Cancellation law for mixed addition and subtraction. (Contributed by Scott Fenton, 9-Jun-2006.)
theorem pnpcan2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 C caddc) (co B2 C caddc) cmin) (co A2 B2 cmin)) $;

--| Cancellation law for mixed addition and subtraction. (Contributed by NM, 30-Jun-2005.) (Revised by Mario Carneiro, 27-May-2016.)
theorem pnncan (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 caddc) (co A2 C cmin) cmin) (co B2 C caddc)) $;

--| Cancellation law for mixed addition and subtraction. (Contributed by NM, 30-Jun-2005.)
theorem ppncan (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 B2 caddc) (co C B2 cmin) caddc) (co A2 C caddc)) $;

--| Rearrangement of 4 terms in a mixed addition and subtraction. (Contributed by NM, 4-Mar-2005.)
theorem addsub4 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cc) (wcel B2 cc)) (wa (wcel C cc) (wcel D cc))) (wceq (co (co A2 B2 caddc) (co C D caddc) cmin) (co (co A2 C cmin) (co B2 D cmin) caddc)) $;

--| Rearrangement of 4 terms in a mixed addition and subtraction. (Contributed by NM, 24-Aug-2006.)
theorem subadd4 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cc) (wcel B2 cc)) (wa (wcel C cc) (wcel D cc))) (wceq (co (co A2 B2 cmin) (co C D cmin) cmin) (co (co A2 D caddc) (co B2 C caddc) cmin)) $;

--| Rearrangement of 4 terms in a subtraction. (Contributed by NM, 23-Nov-2007.)
theorem sub4 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cc) (wcel B2 cc)) (wa (wcel C cc) (wcel D cc))) (wceq (co (co A2 B2 cmin) (co C D cmin) cmin) (co (co A2 C cmin) (co B2 D cmin) cmin)) $;

--| Minus 0 equals 0. (Contributed by NM, 17-Jan-1997.)
theorem neg0:
  $ wceq (cneg cc0) cc0 $;

--| Addition of a number and its negative. (Contributed by NM, 14-Mar-2005.)
theorem negid (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 (cneg A2) caddc) cc0) $;

--| Relationship between subtraction and negative. Theorem I.3 of [Apostol] p. 18. (Contributed by NM, 21-Jan-1997.) (Proof shortened by Mario Carneiro, 27-May-2016.)
theorem negsub (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co A2 (cneg B2) caddc) (co A2 B2 cmin)) $;

--| Relationship between subtraction and negative. (Contributed by NM, 10-May-2004.) (Revised by Mario Carneiro, 27-May-2016.)
theorem subneg (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co A2 (cneg B2) cmin) (co A2 B2 caddc)) $;

--| A number is equal to the negative of its negative. Theorem I.4 of [Apostol] p. 18. (Contributed by NM, 12-Jan-2002.) (Revised by Mario Carneiro, 27-May-2016.)
theorem negneg (A2: class):
  $ wi (wcel A2 cc) (wceq (cneg (cneg A2)) A2) $;

--| Negative is one-to-one. (Contributed by NM, 8-Feb-2005.) (Revised by Mario Carneiro, 27-May-2016.)
theorem neg11 (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wb (wceq (cneg A2) (cneg B2)) (wceq A2 B2)) $;

--| Negative contraposition law. (Contributed by NM, 9-May-2004.)
theorem negcon1 (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wb (wceq (cneg A2) B2) (wceq (cneg B2) A2)) $;

--| Negative contraposition law. (Contributed by NM, 14-Nov-2004.)
theorem negcon2 (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wb (wceq A2 (cneg B2)) (wceq B2 (cneg A2))) $;

--| A number is zero iff its negative is zero. (Contributed by NM, 12-Jul-2005.) (Revised by Mario Carneiro, 27-May-2016.)
theorem negeq0 (A2: class):
  $ wi (wcel A2 cc) (wb (wceq A2 cc0) (wceq (cneg A2) cc0)) $;

--| Cancellation law for subtraction. (Contributed by NM, 8-Feb-2005.) (Revised by Mario Carneiro, 27-May-2016.)
theorem subcan (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wb (wceq (co A2 B2 cmin) (co A2 C cmin)) (wceq B2 C)) $;

--| Distribution of negative over subtraction. (Contributed by NM, 15-Nov-2004.) (Proof shortened by Mario Carneiro, 27-May-2016.)
theorem negsubdi (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cneg (co A2 B2 cmin)) (co (cneg A2) B2 caddc)) $;

--| Distribution of negative over addition. (Contributed by NM, 10-May-2004.) (Proof shortened by Mario Carneiro, 27-May-2016.)
theorem negdi (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cneg (co A2 B2 caddc)) (co (cneg A2) (cneg B2) caddc)) $;

--| Distribution of negative over addition. (Contributed by NM, 1-Jan-2006.)
theorem negdi2 (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cneg (co A2 B2 caddc)) (co (cneg A2) B2 cmin)) $;

--| Distribution of negative over subtraction. (Contributed by NM, 4-Oct-1999.)
theorem negsubdi2 (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cneg (co A2 B2 cmin)) (co B2 A2 cmin)) $;

--| Relationship between subtraction and negative. (Contributed by Paul Chapman, 8-Oct-2007.)
theorem neg2sub (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (cneg A2) (cneg B2) cmin) (co B2 A2 cmin)) $;

--| Closure law for negative of reals. (Contributed by NM, 20-Jan-1997.)
theorem renegcl (A2: class):
  $ wi (wcel A2 cr) (wcel (cneg A2) cr) $;

--| Closure law for negative of reals. (Note: this inference proof style and the deduction theorem usage in ~ renegcl is deprecated, but is retained for its demonstration value.) (Contributed by NM, 17-Jan-1997.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem renegcli (A2: class):
  $ wcel A2 cr $ >
  $ wcel (cneg A2) cr $;

--| Closure law for subtraction of reals. (Contributed by NM, 17-Jan-1997.) (Revised by Mario Carneiro, 27-May-2016.)
theorem resubcli (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wcel (co A2 B2 cmin) cr $;

--| Closure law for subtraction of reals. (Contributed by NM, 20-Jan-1997.)
theorem resubcl (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wcel (co A2 B2 cmin) cr) $;

--| The negative of a real is real. (Contributed by NM, 11-Aug-1999.) (Revised by Mario Carneiro, 14-Jul-2014.)
theorem negreb (A2: class):
  $ wi (wcel A2 cc) (wb (wcel (cneg A2) cr) (wcel A2 cr)) $;

--| "Reverse" second Peano postulate analog for complex numbers: A complex number minus 1 is a complex number. (Contributed by Alexander van der Vekens, 18-Mar-2018.)
theorem peano2cnm (N: class):
  $ wi (wcel N cc) (wcel (co N c1 cmin) cc) $;

--| "Reverse" second Peano postulate analog for reals. (Contributed by NM, 6-Feb-2007.)
theorem peano2rem (N: class):
  $ wi (wcel N cr) (wcel (co N c1 cmin) cr) $;

--| Closure law for negative. (Contributed by NM, 26-Nov-1994.)
theorem negcli (A2: class):
  $ wcel A2 cc $ >
  $ wcel (cneg A2) cc $;


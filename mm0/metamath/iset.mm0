theorem simp2l (ph ps ch th: wff):
  $ wi (w3a ph (wa ps ch) th) ps $;

--| Simplification of triple conjunction. (Contributed by NM, 9-Nov-2011.)
theorem simp2r (ph ps ch th: wff):
  $ wi (w3a ph (wa ps ch) th) ch $;


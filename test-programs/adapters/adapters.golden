# U11 adapter descriptors, emitted by the compiler's CPS lowering.
# Canonical form: fixed field order, one fact per line, descriptors
# sorted by symbol. `umbrella/src/interface.rs` parses this text.

schema 1
abi scalar 1
symbol rs_narrow__adapter
target rs_narrow
params Int32
returns Int64

schema 1
abi scalar 1
symbol rs_scale__adapter
target rs_scale
params Float64,Int64
returns Float64

schema 1
abi scalar 1
symbol rs_toggle__adapter
target rs_toggle
params Bool
returns Bool

pragma Unsafe_Module;

import Distributed (
    PendingRequest,
    SubmitOutcome,
    Submitted,
    SubmitRefused,
    submit,
    disposeRequest
);

module body Test is
    -- `submit` consumes the request. Using the original binding afterwards
    -- must be rejected even though the returned value carries the same wire
    -- identity: identity equality is not a second local owner.
    function submitTwice(request: PendingRequest): Int64 is
        case submit(request) of
            when Submitted(sent: PendingRequest) do
                let ignored: Int64 := disposeRequest(sent);
                return disposeRequest(request);
            when SubmitRefused(refused: PendingRequest, status: Int64) do
                return disposeRequest(refused);
        end case;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.

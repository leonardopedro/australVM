module body Test is
    record Foo: Linear is end;

    function main(): ExitCode is
        let foo: Foo := Foo();
        let bar: Foo := Foo();
        borrow group (wa, wb) := &!(foo, bar) do
            skip;
        end borrow;
        let {} := foo;
        let {} := bar;
        return ExitSuccess();
    end;
end module body.

-- G15: a receipt token is consumed by `read`; a second receipt would need
-- the same `CompletedResult` twice.
pragma Unsafe_Module;

import Austral.Memory (
    Address
);
import Jobs (
    read,
    free_buffer,
    Context,
    CompletedResult,
    OwnedBuffer,
    ReadOutcome
);

module body Test is
    generic [R: Region]
    function consume(
        context: &[Context, R],
        result: CompletedResult,
        address: Address[Nat8]
    ): Int64 is
        case read(result, address, 64) of
            when Read(buffer: OwnedBuffer, status: Int64) do
                let freed: Int64 := free_buffer(context, buffer);
                return status;
        end case;
    end;

    generic [R: Region]
    function double_receipt(
        context: &[Context, R],
        result: CompletedResult,
        address: Address[Nat8]
    ): Int64 is
        let first: Int64 := consume(context, result, address);
        -- `result` was consumed by the first receipt.
        let second: Int64 := consume(context, result, address);
        return second;
    end;
end module body.

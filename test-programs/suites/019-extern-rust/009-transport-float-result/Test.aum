-- U04: a Float64 result comes back in a vector register, not in the word the
-- caller reads as `fn() -> i64`, so a float-returning import is rejected
-- until a typed adapter says how the bits are encoded.
pragma Unsafe_Module;

module body Test is
    pragma Foreign_Import(External_Name => "rs_gain");
    pragma Rust_Ownership(Params => "owned", Return => "owned");
    function rs_gain(scale: Int64): Float64 is
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.

-- A byte buffer in a signature that needs a generated adapter must state the
-- buffer's length as the parameter directly after it: buffer transport version
-- 1 is `abi buffer 1`, whose `buffers` line names the buffer and length
-- parameters. `width: Int32` promises no extent, so no wrapper can build the
-- slice and the signature is refused at typechecking.
--
-- The describable shape (`Pointer[Nat8]`/`Address[Nat8]` + Nat64/Int64 length
-- with a scalar result) is admitted and emitted; `test-programs/adapters`
-- pins that emission as a golden.
pragma Unsafe_Module;

import Austral.Memory (Address, allocateBuffer);

module body Test is
    pragma Foreign_Import(External_Name => "rs_copy_bytes");
    pragma Rust_Ownership(Params => "borrowed, borrowed", Return => "owned");
    function rs_copy_bytes(buf: Address[Nat8], width: Int32): Int64 is
    end;

    function main(): ExitCode is
        let buf: Address[Nat8] := allocateBuffer(8);
        if rs_copy_bytes(buf, 4) = 4 then
            return ExitSuccess();
        else
            return ExitFailure();
        end if;
    end;
end module body.

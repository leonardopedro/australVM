# ~/.config/refi/refi.env — consumed by refi.service.
# Keep this file 0600: the secrets themselves live in the state directory
# (treasury.key, admin.token), not here.

RUST_LOG=info

REFI_LISTEN=127.0.0.1:8080
REFI_STATE_DIR=/home/leo/.local/share/refi
REFI_BASE_URL=https://example.invalid
REFI_MANIFEST=/home/leo/Projects/australVM/refi/module.toml
REFI_MODULE=/home/leo/Projects/australVM/refi/modules/RefiPolicy.aum
REFI_CPS=/home/leo/.local/share/refi/RefiPolicy.cps
REFI_AUSTRAL_BIN=/home/leo/Projects/australVM/austral

# mm0web proof service on loopback (`unfer/mm0web/deploy/README.md`). Empty
# runs the exchange without proof publishing; submissions are then refused.
REFI_MM0WEB=http://127.0.0.1:8081

REFI_MAX_WIRE=100000
REFI_DAILY_CAP=500000
REFI_DENOM_HORIZON=100000

# Empty (invite-only) or --open-registration (self-service customer accounts).
REFI_OPEN_REGISTRATION=

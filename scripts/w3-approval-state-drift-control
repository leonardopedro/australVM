#!/usr/bin/env bash
# w3-approval-state-drift-control — does the *whole gate* fail when a §W3 row's
# state cell claims an approval that `mm0/approved/` does not hold?
#
# The state cell is the one edit an approval is: commit `mm0/approved/<stem>.stmts`
# and flip `[gap]`, awaiting owner commit → `[pass]`, approved in `mm0/approved/`.
# The in-gate check on that column validates the *shape* of the cell (`W3: every
# §W3 state cell …`), and the `stmts`/`digest` checks read the file the cell
# points at. The shape check has been drifted on copies of the table before, but
# only as a hand experiment; what was never measured end to end is the claim that
# matters — a row saying "approved" with nothing under `mm0/approved/` behind it
# turns the gate red, rather than quietly re-deriving from today's artifact as if
# the owner had signed it. So, the way `scripts/w93-certification-drift-control`
# measures the certificate line:
#
#   1. copy the plan and rewrite `mm0/isa.mm0`'s state cell to
#      ``[pass]`, approved in `mm0/approved/` ``, leaving its stmts, emitter and
#      digest cells alone. Refuses to run if `mm0/approved/isa.stmts` exists,
#      because then the row would be telling the truth;
#   2. run `scripts/verify-invariants` against that copy through `AUSTRALVM_PLAN`
#      and require exit 1;
#   3. require `[FAIL] W3: the plan's §W3 stmts column matches what each artifact
#      holds` and the detail `isa(says approved, but …/isa.stmts does not exist)`
#      — the row naming the missing copy is the whole point of the control;
#   4. require the shape check, which owns the cell and cannot see the approval,
#      to still pass: the perturbation is a cell that parses, not a broken cell.
#      Three derived checks do move with it, and the run names them rather than
#      pretending isolation: the digest column and the approved-row emitter check
#      read the same approved copy the cell points at, and `scripts/stage-approvals`
#      stops counting `isa` as pending. Exactly those four lines are allowed to
#      turn red; a fifth would mean the perturbation reached past one cell.
#
# Nothing is written into the repository and `mm0/approved/` is only read, so this
# script cannot approve anything.
#
# Usage: scripts/w3-approval-state-drift-control   (under `nix develop`: the gate
#                                                  needs python3)
# Exit: 0 the control holds, 1 it does not, 2 could not run.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PLAN="$ROOT/PLAN_sota_kernel_verification.md"
GATE="$ROOT/scripts/verify-invariants"
APPROVAL="$ROOT/mm0/approved/isa.stmts"

say()  { printf '%s\n' "$*"; }
fail() { printf 'w3-approval-state-drift-control: FAIL %s\n' "$*" >&2; }

command -v python3 >/dev/null 2>&1 || {
    say "w3-approval-state-drift-control: [gap] python3 not on PATH — run this under 'nix develop'"
    exit 2
}
[ -f "$PLAN" ] || { fail "no plan at $PLAN"; exit 2; }
[ -f "$GATE" ] || { fail "no gate at $GATE"; exit 2; }
if [ -e "$APPROVAL" ]; then
    fail "mm0/approved/isa.stmts exists, so a claimed approval would not be false"
    exit 2
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT INT TERM
perturbed="$work/PLAN.md"

# ── 1. the perturbation: one cell, one row ─────────────────────────────────
python3 - "$PLAN" "$perturbed" <<'PY' || exit 2
import pathlib, sys
src, dst = (pathlib.Path(p) for p in sys.argv[1:3])
lines = src.read_text().splitlines(keepends=True)
pending = "`[gap]`, awaiting owner commit"
approved = "`[pass]`, approved in `mm0/approved/`"
hits = 0
for i, line in enumerate(lines):
    if not line.lstrip().startswith("| `mm0/isa.mm0`"):
        continue
    # Only the §W3 row carries a state cell; other tables quote the same path.
    if pending not in line:
        continue
    lines[i] = line.replace(pending, approved)
    hits += 1
if hits != 1:
    raise SystemExit(f"expected one pending `mm0/isa.mm0` row, found {hits}")
dst.write_text("".join(lines))
PY
grep -q '| `mm0/isa.mm0` |.*| `\[pass\]`, approved in `mm0/approved/` |' "$perturbed" || {
    fail "the copy does not carry the drifted state cell"
    exit 2
}
say "perturbed: isa's state cell now says approved, with no mm0/approved/isa.stmts"

# ── 2. the whole gate, pointed at the copy ─────────────────────────────────
rc=0
( cd "$ROOT" && AUSTRALVM_PLAN="$perturbed" bash scripts/verify-invariants ) \
    >"$work/gate.log" 2>&1 || rc=$?
say "gate:      exit $rc"
tail -1 "$work/gate.log"

if [ "$rc" -eq 0 ]; then
    fail "the gate accepted an approval claim with no approved copy behind it"
    exit 1
fi

# ── 3. it failed for the right reason ──────────────────────────────────────
line='[FAIL] W3: the plan'"'"'s §W3 stmts column matches what each artifact holds'
if ! grep -qF "$line" "$work/gate.log"; then
    fail "no '$line' in the run"
    exit 1
fi
detail='isa(says approved, but'
if ! grep -F '§W3 table vs measured:' "$work/gate.log" | grep -qF "$detail"; then
    grep -F '§W3 table vs measured:' "$work/gate.log" | sed 's/^/  /' >&2
    fail "the detail does not name isa's missing approved copy"
    exit 1
fi
if ! grep -F '§W3 table vs measured:' "$work/gate.log" | grep -qF 'isa.stmts does not exist)'; then
    fail "the detail does not say which file is missing"
    exit 1
fi
say "detail:    isa(says approved, but …/isa.stmts does not exist)"

# ── 4. the shape check still passes, and exactly four lines moved ──────────
missing=""
while IFS= read -r want; do
    grep -qF "[pass] $want" "$work/gate.log" || missing="$missing
  $want"
done <<'WANT'
W3: every §W3 state cell says whether the row is approved or still waiting on the owner (4 row(s))
W3: every §W3 emitter cell names a real command
W3: every pending §W3 row's artifact re-derives into a staging
W3: stage-approvals' artifact list is the §W3 table's rows
WANT
if [ -n "$missing" ]; then
    fail "the perturbation took other lines with it:$missing"
    exit 1
fi

# The cell is what the numbers come from, so the checks that read the file it
# names are expected to follow it. Spelled out so a run that moves *more* fails.
grep '^\[FAIL\] ' "$work/gate.log" | sed 's/^\[FAIL\] //' > "$work/fails.txt"
cat > "$work/expected.txt" <<'EXPECTED'
W3: the plan's §W3 stmts column matches what each artifact holds
W3: the plan's §W3 digest column matches the file it describes
W3: every approved §W3 row's emitter still produces its approved copy
W3: stage-approvals stages exactly §W3's pending rows (exit 0)
EXPECTED
if ! diff -u "$work/expected.txt" "$work/fails.txt" > "$work/fails.diff"; then
    sed 's/^/  /' "$work/fails.diff" >&2
    fail "the run did not fail exactly the four checks the state cell feeds"
    exit 1
fi
say "moved:     the four lines the cell feeds, and nothing else —"
sed 's/^/             [FAIL] /' "$work/fails.txt"
say "control:   holds — one false approval, the stmts [FAIL] naming the missing copy,"
say "           the shape check and the emitter column still green"
exit 0

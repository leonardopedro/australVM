#!/usr/bin/env bash
# w3-approval-state-drift-control — does the *whole gate* fail when a §W3 row's
# state cell claims an approval that `mm0/approved/` does not hold?
#
# The state cell is the one edit an approval is: commit `mm0/approved/<stem>.stmts`
# and flip `[gap]`, awaiting owner commit → `[pass]`, approved in `mm0/approved/`.
# The in-gate check on that column validates the *shape* of the cell (`W3: every
# §W3 state cell …`), and the `stmts`/`digest` checks read the file the cell
# points at. The claim that matters is the one this proves — a row saying
# "approved" with nothing under `mm0/approved/` behind it turns the gate red,
# rather than quietly re-deriving from today's artifact as if the owner had
# signed it. So, the way `scripts/w93-certification-drift-control` measures the
# certificate line:
#
#   1. copy `mm0/approved/` into scratch and delete `isa.stmts` from the copy,
#      which is exactly the tree the row would be lying about. The plan is not
#      touched: `mm0/isa.mm0`'s cell already says
#      ``[pass]`, approved in `mm0/approved/` ``, and the copy is what makes
#      that false. The control refuses to run when `mm0/approved/isa.stmts` is
#      absent, because then there is no approval to take away;
#   2. run `scripts/verify-invariants` against that root through
#      `AUSTRALVM_APPROVED_ROOT` and require exit 1;
#   3. require `[FAIL] W3: the plan's §W3 stmts column matches what each artifact
#      holds` and the detail `isa(says approved, but …/isa.stmts does not exist)`
#      — the row naming the missing copy is the whole point of the control;
#   4. require the shape check, which owns the cell and cannot see the approval,
#      to still pass: the perturbation removes a file, not a cell. Two derived
#      checks do move with it, and the run names them rather than pretending
#      isolation: the digest column and the approved-row emitter check read the
#      same approved copy the row points at. Exactly those three lines are
#      allowed to turn red; a fourth would mean the perturbation reached past one
#      approval.
#
# This control used to flip a *pending* cell to approved, which needed isa to be
# pending. Once the owner committed all four §W3 approvals there was no pending
# row left to flip, so the drift is now the other half of the same lie: the cell
# says approved and the approved root has lost the copy. The tree in
# `mm0/approved/` is read, never written, so this script cannot approve anything.
#
# Usage: scripts/w3-approval-state-drift-control   (under `nix develop`: the gate
#                                                  needs python3)
# Exit: 0 the control holds, 1 it does not, 2 could not run.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PLAN="$ROOT/PLAN_sota_kernel_verification.md"
GATE="$ROOT/scripts/verify-invariants"
APPROVED="$ROOT/mm0/approved"

say()  { printf '%s\n' "$*"; }
fail() { printf 'w3-approval-state-drift-control: FAIL %s\n' "$*" >&2; }

command -v python3 >/dev/null 2>&1 || {
    say "w3-approval-state-drift-control: [gap] python3 not on PATH — run this under 'nix develop'"
    exit 2
}
[ -f "$PLAN" ] || { fail "no plan at $PLAN"; exit 2; }
[ -f "$GATE" ] || { fail "no gate at $GATE"; exit 2; }
if [ ! -e "$APPROVED/isa.stmts" ]; then
    fail "mm0/approved/isa.stmts does not exist, so there is no approval to take away"
    exit 2
fi
grep -q '| `mm0/isa.mm0` |.*| `\[pass\]`, approved in `mm0/approved/` |' "$PLAN" || {
    fail "the plan's isa row does not claim an approval for the copy to contradict"
    exit 2
}

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT INT TERM
appr_root="$work/approved"

# ── 1. the perturbation: the approved root loses one copy ──────────────────
cp -R "$APPROVED" "$appr_root" || exit 2
rm -f "$appr_root/isa.stmts" || exit 2
[ -e "$appr_root/isa.stmts" ] && { fail "the copy still holds isa.stmts"; exit 2; }
[ -e "$appr_root/slot_layout.stmts" ] || { fail "the copy is not an approved root"; exit 2; }
say "perturbed: the approved root is missing isa.stmts, and the plan's cell still says approved"

# ── 2. the whole gate, pointed at the copy ─────────────────────────────────
rc=0
( cd "$ROOT" && AUSTRALVM_APPROVED_ROOT="$appr_root" bash scripts/verify-invariants ) \
    >"$work/gate.log" 2>&1 || rc=$?
say "gate:      exit $rc"
tail -1 "$work/gate.log"

if [ "$rc" -eq 0 ]; then
    fail "the gate accepted an approval claim with no approved copy behind it"
    exit 1
fi

# ── 3. it failed for the right reason ──────────────────────────────────────
line='[FAIL] W3: the plan'"'"'s §W3 stmts column matches what each artifact holds'
if ! grep -qF "$line" "$work/gate.log"; then
    fail "no '$line' in the run"
    exit 1
fi
detail='isa(says approved, but'
if ! grep -F '§W3 table vs measured:' "$work/gate.log" | grep -qF "$detail"; then
    grep -F '§W3 table vs measured:' "$work/gate.log" | sed 's/^/  /' >&2
    fail "the detail does not name isa's missing approved copy"
    exit 1
fi
if ! grep -F '§W3 table vs measured:' "$work/gate.log" | grep -qF 'isa.stmts does not exist)'; then
    fail "the detail does not say which file is missing"
    exit 1
fi
say "detail:    isa(says approved, but …/isa.stmts does not exist)"

# ── 4. exactly the lines the missing copy feeds moved ──────────────────────
# The row is what the numbers come from, so the checks that read the copy it
# names are expected to follow it. Spelled out so a run that moves *more* fails.
grep '^\[FAIL\] ' "$work/gate.log" | sed 's/^\[FAIL\] //' > "$work/fails.txt"
cat > "$work/expected.txt" <<'EXPECTED'
W9.3: certification state matches mm0/approved/
W3: the plan's §W3 stmts column matches what each artifact holds
W3: the plan's §W3 digest column matches the file it describes
W3: every approved §W3 row's emitter still produces its approved copy
W3: stage-approvals stages exactly §W3's pending rows (exit 0)
EXPECTED
if ! diff -u "$work/expected.txt" "$work/fails.txt" > "$work/fails.diff"; then
    sed 's/^/  /' "$work/fails.diff" >&2
    fail "the run did not fail exactly the checks the missing copy feeds"
    exit 1
fi
say "moved:     the lines the copy feeds, and nothing else —"
sed 's/^/             [FAIL] /' "$work/fails.txt"

# ── 5. what the cell owns still passes ─────────────────────────────────────
missing=""
while IFS= read -r want; do
    grep -qF "[pass] $want" "$work/gate.log" || missing="$missing
  $want"
done <<'WANT'
W3: every §W3 state cell says whether the row is approved or still waiting on the owner (4 row(s))
W3: every §W3 emitter cell names a real command
W3: every pending §W3 row's artifact re-derives into a staging
W3: stage-approvals' artifact list is the §W3 table's rows
WANT
if [ -n "$missing" ]; then
    fail "the perturbation took other lines with it:$missing"
    exit 1
fi
say "control:   holds — one false approval, the stmts [FAIL] naming the missing copy,"
say "           the shape check, the emitter column and the staging list still green"
exit 0

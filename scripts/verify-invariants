#!/usr/bin/env bash
# H1 verify-invariants gate (australVM).
#
# Turns the AGENTS.md maintenance checklist into machine-checkable invariants
# owned by THIS repo: the UNFER_SYMBOLS census, the symbol-sync test, the
# AuthorizationEngine default, and the archetype surface. Output lists every
# executed item; exit code is non-zero if any gate FAILS.

set -u
FAILED=0
PASSED=0
GAPS=0

check() {
    local name="$1"
    shift
    if "$@"; then
        echo "[pass] $name"
        PASSED=$((PASSED + 1))
    else
        echo "[FAIL] $name"
        FAILED=$((FAILED + 1))
    fi
}

gap() {
    echo "[gap]  $1"
    GAPS=$((GAPS + 1))
}

# A gate whose tool is absent must say so, not report a failure: otherwise a
# genuine census failure is indistinguishable from "no interpreter here", and
# the gate is red on every machine that lacks python3 (it was). This mirrors
# `unfer/scripts/verify-invariants`'s check_py.
check_py() {
    local name="$1"
    shift
    if ! command -v python3 >/dev/null 2>&1; then
        gap "$name (tooling absent: python3 not on PATH)"
        return 0
    fi
    check "$name" "$@"
}

repo_root="$(cd "$(dirname "$0")/.." && pwd)"

# --- H1.12a UNFER_SYMBOLS census is the single uk_* registration point ---
check "S29: UNFER_SYMBOLS table present" \
    grep -q "pub(crate) const UNFER_SYMBOLS" "$repo_root/safestos/cranelift/src/lib.rs"
check "S29: UNFER_SYMBOLS registers into the Cranelift JIT" \
    grep -q "fn register_unfer_symbols" "$repo_root/safestos/cranelift/src/lib.rs"
check "S29: per-module CPS compile consumes the same census" \
    grep -q "UNFER_SYMBOLS" "$repo_root/safestos/cranelift/src/module.rs"
check "S29: symbol_sync test cross-checks EXPECTED_SYMBOLS.txt" \
    test -f "$repo_root/safestos/cranelift/tests/symbol_sync.rs"

# H2: the unfer census is generated from the one registry; run its check mode
# (sibling repo) so this gate also fails on drift there.
if [ -f "$repo_root/../unfer/scripts/gen_symbol_artifacts" ]; then
    check_py "H2: unfer symbol census in sync with SYMBOL_REGISTRY (generated)" \
        python3 "$repo_root/../unfer/scripts/gen_symbol_artifacts" check
else
    gap "H2: sibling unfer repo not present at ../unfer — skipping generator check"
fi

# --- Phase D: the Lean4 -> DeltaNets -> MM0 certificate (docs/lean4mm0.md §5) ---
#
# gap_certificate.{mm0,mm1} and layout_certificate.{mm0,mm1} are generated
# from the *pinned* nanoda-verified lean4export fixtures in unfer (sha256 in
# each file header) — the Lean sources of record timepiece/GapCertificate.lean
# and timepiece/Layout.lean — over the target theory docs/cic.mm0. Two
# failure modes this gate exists to catch: the emitter drifting from the
# pinned exports (`check` regenerates and compares against the committed
# artifacts), and the proofs rotting against the theory (`verify` re-runs
# mm0-rs and the mm0-c root of trust — a warning from mm0-rs is a proof
# hole and fails the gate).
check "Phase D: lean2mm0 emitter present" \
    test -f "$repo_root/scripts/lean2mm0"
check "Phase D: generated certificate artifacts present" \
    bash -c "test -f '$repo_root/mm0/gap_certificate.mm0' && test -f '$repo_root/mm0/gap_certificate.mm1' && test -f '$repo_root/mm0/layout_certificate.mm0' && test -f '$repo_root/mm0/layout_certificate.mm1'"
check_py "Phase D: generated MM0/MM1 in sync with the pinned lean4export" \
    python3 "$repo_root/scripts/lean2mm0" check
# The trust split is a pinned contract, not a statistic: generation fails when
# the grounded set widens (`check` above would catch it), and this asserts the
# *artifact* states its split, so a reader of the certificate cannot mistake an
# emitter-evaluated definition for one mm0-c checked. Widening is allowed — by
# editing BUDGETS in scripts/lean2mm0 in the same commit.
check "Phase D: gap_certificate pins its trust split (9 structural / 0 grounded)" \
    grep -q -- '-- trust-split: structural=9 grounded=0 certificates=9' \
    "$repo_root/mm0/gap_certificate.mm0"
check "Phase D: layout_certificate pins its trust split (3 structural / 5 grounded)" \
    grep -q -- '-- trust-split: structural=3 grounded=5 certificates=8' \
    "$repo_root/mm0/layout_certificate.mm0"
# `scripts/lean2mm0` also writes a `-- theory coverage:` line into each artifact
# (docs/lean4mm0.md §9.4) so a reader can tell a checked rule from a reserved
# one. The line is generated, so `check` above already pins it against the
# pinned exports; what that cannot notice is the generator *inventing* a name --
# a source construct encoded as `tfoo` for a rule the interface never declared
# would give a coverage line that reads complete and a certificate mm0-rs later
# rejects. So every `used=` name must be a declared term of the theory.
#
# A declaration is `term name: ...` or `term name (args: ...): ...`, hence the
# bracketed continuation class rather than a bare colon.
for artifact in "$repo_root"/mm0/*.mm0; do
    [ -e "$artifact" ] || continue
    name="$(basename "$artifact")"
    # A measurement artifact states its coverage in its own unit: `clif.mm0` is
    # generated by `scripts/clif2mm0` from the bridge's CLIF, so its rules are
    # measured instruction *forms*, each declared exactly once. That is a
    # stronger statement than the lean2mm0 line (which is about names a
    # certificate used), and it is generated, so it is compared to the file
    # itself rather than to a pinned export.
    if grep -q '^-- measured-by: scripts/clif2mm0' "$artifact"; then
        forms="$(sed -n 's/^-- clif-forms: //p' "$artifact")"
        declared="$(grep -cE '^term .*: op;' "$artifact")"
        if [ -n "$forms" ] && [ "$forms" = "$declared" ]; then
            check "Phase D: $name states its measured coverage ($forms form(s))" true
        else
            echo "  [detail] $name: -- clif-forms: '${forms}' vs $declared declared form(s)" >&2
            check "Phase D: $name states its measured coverage" false
        fi
        continue
    fi
    used="$(sed -n 's/^-- theory coverage: used=\([^ ]*\) unused=.*/\1/p' "$artifact")"
    if [ -z "$used" ]; then
        check "Phase D: $name states its theory coverage" false
        continue
    fi
    # An artifact whose declarations are *imported* (the set.mm statement
    # layer) names its theory in a `-- theory source:` line instead of
    # embedding it, so the `used=` names must be grounded there — and that
    # theory is untracked toolchain state (metamath/set.mm0 + a 548 MB
    # set.mmu cannot be committed), hence a gap rather than a failure when
    # it is not provisioned: same idiom as the missing-toolchain gaps.
    theory="$artifact"
    theory_src="$(sed -n 's/^-- theory source: //p' "$artifact")"
    if [ -n "$theory_src" ]; then
        theory="$repo_root/$theory_src"
        if [ ! -f "$theory" ]; then
            gap "Phase D: $name grounded against $theory_src (imported theory not provisioned)"
            continue
        fi
    fi
    missing=""
    for rule in $(printf '%s' "$used" | tr ',' ' '); do
        grep -qE "^term $rule[ (:;]" "$theory" || missing="$missing $rule"
    done
    if [ -n "$missing" ]; then
        echo "  [detail] $name claims used rules the theory does not declare:$missing" >&2
        check "Phase D: $name only claims rules its theory declares" false
    else
        check "Phase D: $name only claims rules its theory declares" true
    fi
done
# Both anchors of the trust story must refuse tampered input. This needs no mm0
# toolchain: the mutation is caught before any .mmb exists, which is exactly the
# point — it tests the emitter's cross-checks, not the verifier.
check_py "Phase D: emitter self-test (both trust anchors refuse tampered input)" \
    python3 "$repo_root/scripts/lean2mm0" selftest
if command -v mm0-rs >/dev/null 2>&1 && command -v mm0-c >/dev/null 2>&1; then
    check_py "Phase D: mm0-rs elaborates and mm0-c re-verifies the certificate" \
        python3 "$repo_root/scripts/lean2mm0" verify
else
    gap "Phase D: mm0 toolchain absent (mm0-rs/mm0-c not on PATH; see docs/lean4mm0.md §5)"
fi

# `docs/kernel_alg.mm0` is the theory W2's symbolic certificates will rest on
# (the single `int_ring_transfer` bridge). It is gated from the day it exists,
# not from the day the first artifact cites it: an ungated theory file rots
# silently, and this one carries the trust budget.
if command -v mm0-rs >/dev/null 2>&1 && command -v mm0-c >/dev/null 2>&1; then
    _alg_tmp="$(mktemp -d)"
    _alg_out="$(mm0-rs compile "$repo_root/docs/kernel_alg.mm0" \
        "$_alg_tmp/kernel_alg.mmb" 2>&1)"
    if [ $? -eq 0 ] && mm0-c "$_alg_tmp/kernel_alg.mmb" \
            < "$repo_root/docs/kernel_alg.mm0"; then
        echo "  [detail] ${_alg_out##*$'\n'}"
        check "W2: docs/kernel_alg.mm0 accepted by mm0-rs + mm0-c" true
    else
        printf '%s\n' "$_alg_out" | tail -3 >&2
        check "W2: docs/kernel_alg.mm0 accepted by mm0-rs + mm0-c" false
    fi
    rm -rf "$_alg_tmp"
fi

# --- W2/W5/W6: the symbolic certificate, its code fingerprint and its probe ---
# Regenerated into a scratch directory and compared with the committed artifacts:
# drift means the prover, the theory, the obligation file or the compiled kernel
# moved and the certificate was not refreshed. `emit` re-checks the proof with
# mm0-rs + mm0-c itself, so a green run means the `peq` chain is still accepted by
# the root of trust, not merely that a file exists. The `--code` bytes come from
# the compiler's own `--emit-cps`, which is why the CPS digest in the header is a
# claim about the code that runs rather than about this JSON.
_flux_obl="$repo_root/examples/verified-kernel/flux1d/flux1d.obligations.json"
if [ -f "$_flux_obl" ] && command -v python3 >/dev/null 2>&1; then
    _cert_tmp="$(mktemp -d)"
    _cert_code=""
    _obj=""
    _obj_arch=""
    _cert_obj_arch=""
    if [ -x "$repo_root/austral" ] \
        && [ -f "$repo_root/libaustral_cranelift_bridge.so" ]; then
        ( cd "$repo_root/examples/verified-kernel/flux1d" \
            && LD_LIBRARY_PATH="$repo_root" "$repo_root/austral" compile \
                Flux1d.aui,Flux1d.aum --entrypoint=Flux1d:main \
                --use-cps-jit --emit-cps="$_cert_tmp/flux1d.cps" \
                --output="$_cert_tmp/flux1d.bin" ) \
            >"$_cert_tmp/cps.log" 2>&1
        if [ -f "$_cert_tmp/flux1d.cps" ]; then
            # The object digest comes from the bridge compiling the same bytes
            # into its AVCE capture. It is host-native, so the arch is part of
            # the record and the comparison below only holds byte-identity when
            # the committed arch is this host's — otherwise the certificate is
            # still compared, with the two code lines normalised, and the
            # incomparable object digest is reported rather than faked.
            _obj=""
            _obj_arch=""
            _obj_line="$(python3 "$repo_root/scripts/cps-fingerprint" --object \
                "$_cert_tmp/flux1d.cps" 2>"$_cert_tmp/obj.log")" || _obj_line=""
            if [ -n "$_obj_line" ]; then
                _obj="${_obj_line%% *}"
                _obj_arch="${_obj_line##*arch=}"
            else
                gap "W5: object digest not re-derivable (see $_cert_tmp/obj.log)"
            fi
            _cert_code="--code $_cert_tmp/flux1d.cps"
            [ -n "$_obj" ] && _cert_code="$_cert_code --obj $_obj --obj-arch $_obj_arch"
        else
            gap "W5: CPS bytes not emitted (--emit-cps wrote no file)"
        fi
    else
        gap "W5: code fingerprint not re-derivable (no ./austral + bridge here)"
    fi
    # shellcheck disable=SC2086  # _cert_code is a flag pair, empty when absent
    # Without `--code` the artifact's two header lines record `cps=unrecorded`,
    # so a straight `cmp` against an artifact emitted with the fingerprint would
    # fail on the one field this environment cannot re-derive. The comparison
    # below normalises exactly those two lines and holds everything else to
    # byte-identity, so the missing fingerprint stays a gap (recorded above, W5)
    # while a drifted proof, statement or probe still fails.
    _norm_code() {
        sed 's/^-- code: .*/-- code: <cps>/; s/^-- code-status: .*/-- code-status: <cps>/' "$1"
    }
    # The committed artifact records the arch its object digest was taken on; a
    # different host cannot reproduce that number, so it normalises instead of
    # failing and the mismatch is reported as a gap by the W5 (checked) block.
    _cert_obj_arch="$(sed -n 's/.*arch=\([a-z0-9_]*\).*/\1/p' \
        "$repo_root/mm0/flux1d_certificate.mm0" 2>/dev/null | head -1)"
    _cert_same() {
        case "$1" in
            _probe.c) cmp -s "$_cert_tmp/flux1d$1" "$repo_root/mm0/flux1d$1" ;;
            *)
                if [ -n "$_cert_code" ] \
                    && { [ -z "$_obj" ] || [ "$_cert_obj_arch" = "$_obj_arch" ]; }; then
                    cmp -s "$_cert_tmp/flux1d$1" "$repo_root/mm0/flux1d$1"
                else
                    diff -q <(_norm_code "$_cert_tmp/flux1d$1") \
                            <(_norm_code "$repo_root/mm0/flux1d$1") >/dev/null
                fi
                ;;
        esac
    }
    if python3 "$repo_root/scripts/au2mm0" emit "$_flux_obl" \
            --out "$_cert_tmp" $_cert_code >"$_cert_tmp/emit.log" 2>&1; then
        _cert_ok=true
        for _suffix in _certificate.mm0 _certificate.mm1 _probe.c; do
            _cert_same "$_suffix" || _cert_ok=false
        done
        if [ -n "$_cert_code" ]; then
            _cert_claim="W2/W5/W6: flux1d certificate and probe re-emit byte-identically and mm0 re-accepts it"
        else
            _cert_claim="W2/W6: flux1d certificate and probe re-emit byte-identically apart from the code fingerprint, and mm0 re-accepts it"
        fi
        if [ "$_cert_ok" = true ]; then
            check "$_cert_claim" true
        else
            echo "      committed artifact is stale — run: python3 scripts/au2mm0 emit examples/verified-kernel/flux1d/flux1d.obligations.json --code <cps>" >&2
            check "$_cert_claim" false
        fi
        # W5 (checked): the `cps=` digest in the certificate header must be the
        # *bridge's* digest of the bytes `--emit-cps` just wrote, not a number
        # only the emitter's own hashlib ever computed. Two implementations
        # (Rust `sha2` behind `austral_cps_fingerprint`, Python `hashlib` in
        # `au2mm0`) plus one negative control: a mutated copy of the same bytes
        # has to fingerprint differently, or the comparison is true of nothing.
        if [ -n "$_cert_code" ]; then
            _fp_bridge="$(python3 "$repo_root/scripts/cps-fingerprint" \
                "$_cert_tmp/flux1d.cps" 2>"$_cert_tmp/fp.log")"
            _fp_rc=$?
            _fp_recorded="$(sed -n 's/^-- code: cps=\([0-9a-f]\{64\}\).*/\1/p' \
                "$repo_root/mm0/flux1d_certificate.mm0" | head -1)"
            _fp_mut=""
            if [ "$_fp_rc" -eq 0 ] && [ -n "$_fp_recorded" ]; then
                python3 - "$_cert_tmp/flux1d.cps" "$_cert_tmp/flux1d-mut.cps" <<'PY'
import sys
blob = bytearray(open(sys.argv[1], 'rb').read())
if not blob:
    sys.exit(1)
blob[0] ^= 0xFF
open(sys.argv[2], 'wb').write(blob)
PY
                _fp_mut="$(python3 "$repo_root/scripts/cps-fingerprint" \
                    "$_cert_tmp/flux1d-mut.cps" 2>>"$_cert_tmp/fp.log")"
            fi
            if [ "$_fp_rc" -ne 0 ]; then
                gap "W5: code fingerprint not checked through the bridge (see $_cert_tmp/fp.log)"
            elif [ "$_fp_bridge" = "$_fp_recorded" ] \
                && [ -n "$_fp_mut" ] && [ "$_fp_mut" != "$_fp_recorded" ]; then
                check "W5 (checked): the certificate's cps digest is the bridge's digest of the emitted bytes" true
            else
                echo "      recorded=$_fp_recorded bridge=$_fp_bridge mutated=$_fp_mut" >&2
                check "W5 (checked): the certificate's cps digest is the bridge's digest of the emitted bytes" false
            fi
            # The object half: recorded only when the bridge produced an object
            # for these bytes, and compared only on the architecture it was
            # taken on. An artifact from another arch is a stated gap, never a
            # silent pass and never a false failure.
            _obj_recorded="$(sed -n 's/^-- code: .*obj=\([0-9a-f]\{64\}\).*/\1/p' \
                "$repo_root/mm0/flux1d_certificate.mm0" | head -1)"
            if [ -z "$_obj_recorded" ]; then
                gap "W5: object digest unrecorded in the committed certificate"
            elif [ -z "$_obj" ]; then
                gap "W5: object digest not re-derived (bridge could not compile the bytes)"
            elif [ "$_cert_obj_arch" != "$_obj_arch" ]; then
                gap "W5: object digest not comparable (recorded arch=$_cert_obj_arch, this host $_obj_arch)"
            elif [ "$_obj" = "$_obj_recorded" ]; then
                check "W5 (checked): the certificate's obj digest is the bridge's digest of the emitted object ($_obj_arch)" true
            else
                echo "      recorded=$_obj_recorded bridge=$_obj" >&2
                check "W5 (checked): the certificate's obj digest is the bridge's digest of the emitted object ($_obj_arch)" false
            fi
        fi

        # W7 anchor: the statements a CNL citation points at must be what the
        # proof proves. Flip one coefficient in the `consistency` statement and
        # leave the proofs alone: mm0 has to refuse it, or "this sentence cites
        # theorem X" would be evidence about nothing.
        if command -v mm0-rs >/dev/null 2>&1 && command -v mm0-c >/dev/null 2>&1; then
            mkdir -p "$_cert_tmp/tamper"
            awk '/^theorem consistency/ && !done {
                     gsub(/\(tint n2\)/, "(tint n5)"); done = 1
                 }
                 { print }' "$_cert_tmp/flux1d_certificate.mm0" \
                > "$_cert_tmp/tamper/flux1d_certificate.mm0"
            cp "$_cert_tmp/flux1d_certificate.mm1" "$_cert_tmp/tamper/"
            if mm0-rs compile "$_cert_tmp/tamper/flux1d_certificate.mm0" \
                    "$_cert_tmp/tamper/tampered.mmb" >/dev/null 2>&1 \
                && mm0-c "$_cert_tmp/tamper/tampered.mmb" \
                    < "$_cert_tmp/tamper/flux1d_certificate.mm0" >/dev/null 2>&1; then
                check "W7: a certificate with a flipped coefficient is refused" false
            else
                check "W7: a certificate with a flipped coefficient is refused" true
            fi
        else
            gap "W7: flipped-coefficient certificate not re-checked (no mm0 toolchain)"
        fi

        # W8: the ISA layer. Three separate things are checked, because the
        # artifact, the citations and the instruction subset fail differently:
        # (a) mm0-c accepts the theory (it refuses unproved theorems, so a
        #     `theorem` line without a proof is a gate failure, not a footnote);
        # (b) every gap-hypothesis is cited and pinned, and a stale pin is
        #     refused — the W7 discipline applied to layer-1 certificates;
        # (c) scripts/isa-census measures the opcodes the decoder actually
        #     consumes against ISA_REGISTRY and against the artifact's table,
        #     with a negative control proving the diff can fail.
        # MM0 splits specification from proof: mm0-rs compiles `isa.mm1` (the
        # same statements, each theorem carrying its proof) and mm0-c re-checks
        # that proof against `isa.mm0`, the specification it also reads. So the
        # pair is what is accepted — compiling the specification alone would
        # only prove it parses, and would pass with every proof missing.
        if command -v mm0-rs >/dev/null 2>&1 && command -v mm0-c >/dev/null 2>&1; then
            if mm0-rs compile "$repo_root/mm0/isa.mm1" "$_cert_tmp/isa.mmb" \
                    >"$_cert_tmp/isa.log" 2>&1 \
                && ! grep -q 'sorry' "$_cert_tmp/isa.log" \
                && mm0-c "$_cert_tmp/isa.mmb" < "$repo_root/mm0/isa.mm0" \
                    >/dev/null 2>&1; then
                echo "  [detail] $(grep -E 'sorts,' "$_cert_tmp/isa.log" | tail -1)"
                check "W8: mm0/isa.mm0 + isa.mm1 accepted by mm0-rs + mm0-c, no sorry" true
            else
                tail -3 "$_cert_tmp/isa.log" >&2
                check "W8: mm0/isa.mm0 + isa.mm1 accepted by mm0-rs + mm0-c, no sorry" false
            fi

            # The layout model the memory hypothesis cites: `in_bounds` is a
            # definition there and `in_bounds_alloc` is proved about it, which
            # is what makes `bounds_from_layout`'s citation checkable rather
            # than decorative. Control: the monotonicity proof must depend on
            # its step — replacing the symm step with the raw allocation
            # equation reverses the equality and must be refused.
            if mm0-rs compile "$repo_root/mm0/slot_layout.mm1" "$_cert_tmp/slot.mmb" \
                    >"$_cert_tmp/slot.log" 2>&1 \
                && ! grep -q 'sorry' "$_cert_tmp/slot.log" \
                && mm0-c "$_cert_tmp/slot.mmb" < "$repo_root/mm0/slot_layout.mm0" \
                    >/dev/null 2>&1; then
                echo "  [detail] $(grep -E 'sorts,' "$_cert_tmp/slot.log" | tail -1)"
                check "W8: mm0/slot_layout.mm0 + .mm1 accepted, in_bounds_alloc proved" true
            else
                tail -3 "$_cert_tmp/slot.log" >&2
                check "W8: mm0/slot_layout.mm0 + .mm1 accepted, in_bounds_alloc proved" false
            fi
            sed 's/(seq_symm slots_alloc)/(slots_alloc)/' \
                "$repo_root/mm0/slot_layout.mm1" > "$_cert_tmp/slot-bad.mm1"
            if mm0-rs compile "$_cert_tmp/slot-bad.mm1" "$_cert_tmp/slot-bad.mmb" \
                    >"$_cert_tmp/slot-bad.log" 2>&1 \
                && ! grep -q 'sorry' "$_cert_tmp/slot-bad.log"; then
                check "W8: the allocation-monotonicity proof depends on its direction" false
            else
                check "W8: the allocation-monotonicity proof depends on its direction" true
            fi
        else
            gap "W8: mm0/isa.mm0 not re-checked (no mm0 toolchain)"
        fi

        # The encdec block is generated from ISA_REGISTRY and its 23 proofs are
        # checked above; what this adds is that the committed artifacts are the
        # ones the generator produces *now* (a table edit without a regenerate),
        # that the count is 23/23, and the negative control: dropping one table
        # line must leave a theorem unprovable rather than silently accepted, so
        # a `theorem` cannot outlive the equation it was proved from.
        if [ -x "$repo_root/scripts/isa-encdec" ] && command -v mm0-rs >/dev/null 2>&1 \
                && command -v mm0-c >/dev/null 2>&1; then
            if "$repo_root/scripts/isa-encdec" >"$_cert_tmp/encdec.log" 2>&1; then
                echo "  [detail] $(cat "$_cert_tmp/encdec.log")"
                check "W8: encdec table and its proofs are current" true
            else
                cat "$_cert_tmp/encdec.log" >&2
                check "W8: encdec table and its proofs are current" false
            fi
            # Control: move one table entry off its byte (0x05 -> 0x06 in
            # `enc_add`). The proof file is unchanged, so if `encdec_add` still
            # checked, the theorem would not be *about* the byte it names — the
            # exact vacuity this section replaced. mm0-rs must refuse.
            if python3 - "$repo_root/mm0/isa.mm1" "$_cert_tmp/isa-moved.mm1" <<'PY'
import sys
src, dst = sys.argv[1], sys.argv[2]
text = open(src).read()
old = 'axiom enc_add: $ beq (ienc ins_add) n5 $;'
if old not in text:
    sys.exit('no `axiom enc_add ... n5` line to move')
open(dst, 'w').write(text.replace(old, old.replace('n5 $;', 'n6 $;'), 1))
PY
            then
                if mm0-rs compile "$_cert_tmp/isa-moved.mm1" \
                        "$_cert_tmp/isa-moved.mmb" >/dev/null 2>&1; then
                    check "W8: a table entry moved off its byte breaks its proof" false
                else
                    check "W8: a table entry moved off its byte breaks its proof" true
                fi
            else
                check "W8: a table entry moved off its byte breaks its proof" false
            fi
        else
            gap "W8: encdec proofs not re-checked (no mm0 toolchain or script)"
        fi

        if [ -x "$repo_root/scripts/isa-hypotheses" ] || [ -f "$repo_root/scripts/isa-hypotheses" ]; then
            if python3 "$repo_root/scripts/isa-hypotheses" "$repo_root/mm0/isa.mm0" \
                    >"$_cert_tmp/hyp.log" 2>&1; then
                sed '0,/sha256=[0-9a-f]/s//sha256=0/' "$repo_root/mm0/isa.mm0" \
                    > "$_cert_tmp/isa-tampered.mm0"
                if python3 "$repo_root/scripts/isa-hypotheses" \
                        "$_cert_tmp/isa-tampered.mm0" >/dev/null 2>&1; then
                    check "W8: an uncited or stale hypothesis is refused" false
                else
                    echo "  [detail] $(cat "$_cert_tmp/hyp.log")"
                    check "W8: an uncited or stale hypothesis is refused" true
                fi
                # The unchecked count is pinned, so an unchecked citation cannot
                # be added — or a real one quietly re-labelled as checked.
                # (The model pins 0 now that `bounds_from_layout` cites the
                # layout model, so the control *adds* a phantom one.)
                sed 's/^-- unchecked-citations: 0$/-- unchecked-citations: 1/' \
                    "$repo_root/mm0/isa.mm0" > "$_cert_tmp/isa-relabelled.mm0"
                if python3 "$repo_root/scripts/isa-hypotheses" \
                        "$_cert_tmp/isa-relabelled.mm0" >/dev/null 2>&1; then
                    check "W8: an unchecked citation cannot be re-labelled as checked" false
                else
                    check "W8: an unchecked citation cannot be re-labelled as checked" true
                fi
            else
                cat "$_cert_tmp/hyp.log" >&2
                check "W8: hypotheses are cited, pinned, and the unchecked count matches its pin" false
            fi
        else
            gap "W8: hypothesis citations not checked (scripts/isa-hypotheses missing)"
        fi

        _census="$repo_root/safestos/cranelift/target/release/isa_census"
        if [ -n "$_cert_code" ] && [ -x "$_census" ]; then
            if "$_census" "$_cert_tmp/flux1d.cps" "$repo_root/mm0/isa.mm0" \
                    >"$_cert_tmp/census.log" 2>&1; then
                check "W8: scripts/isa-census covers the emitted opcodes" true
                grep -E '^  used:' "$_cert_tmp/census.log" | sed 's/^/      /' >&2
            else
                cat "$_cert_tmp/census.log" >&2
                check "W8: scripts/isa-census covers the emitted opcodes" false
            fi
            # One module does not measure "the emitted subset": flux1d reads 8
            # of the 23 opcodes. The corpus check compiles every example whose
            # CPS path produces a function and censuses the union, so an opcode
            # added to the decoder is caught even if flux1d never emits it.
            if "$repo_root/scripts/isa-census" --corpus >"$_cert_tmp/corpus.log" 2>&1; then
                grep -E '^isa-census: ' "$_cert_tmp/corpus.log" | sed 's/^/      /' >&2
                check "W8: the corpus census covers every opcode the examples emit" true
            else
                tail -3 "$_cert_tmp/corpus.log" >&2
                check "W8: the corpus census covers every opcode the examples emit" false
            fi
            # Negative control: an opcode the decoder does not accept, declared
            # in a copy of the model, must be reported — otherwise the census
            # would be measuring agreement between a table and itself.
            cp "$repo_root/mm0/isa.mm0" "$_cert_tmp/isa-bogus.mm0"
            printf '%s\n' '-- op 0x7f bogus' >> "$_cert_tmp/isa-bogus.mm0"
            if "$_census" "$_cert_tmp/flux1d.cps" "$_cert_tmp/isa-bogus.mm0" \
                    >/dev/null 2>&1; then
                check "W8: isa-census refuses a model opcode the decoder rejects" false
            else
                check "W8: isa-census refuses a model opcode the decoder rejects" true
            fi
        else
            gap "W8: opcode census not run (no emitted CPS or no isa_census binary)"
        fi

        # W9.2: the Cranelift-IR layer. The CPS→CLIF lowering is Rust code mm0-c
        # cannot see, so until now the chain stopped at the CPS IR and resumed
        # at the object digest — which says "unchanged", not "what". Now the
        # lowering's *output shape* is an artifact: `clif_dump` measures every
        # instruction the bridge's own compile produces, `scripts/clif2mm0`
        # turns the corpus measurement into `mm0/clif.mm0`, and mm0-c checks the
        # committed declarations against that compiled model. The file proves
        # nothing — `clif_step` and the refinement are W9.3 — and it says so in a
        # line pinned here, so a theorem cannot be added without a proof.
        if command -v mm0-rs >/dev/null 2>&1 && command -v mm0-c >/dev/null 2>&1; then
            if mm0-rs compile "$repo_root/mm0/clif.mm1" "$_cert_tmp/clif.mmb" \
                    >"$_cert_tmp/clif.log" 2>&1 \
                && ! grep -q 'sorry' "$_cert_tmp/clif.log" \
                && mm0-c "$_cert_tmp/clif.mmb" < "$repo_root/mm0/clif.mm0" \
                    >/dev/null 2>&1; then
                echo "  [detail] $(grep -E 'sorts,' "$_cert_tmp/clif.log" | tail -1)"
                check "W9: mm0/clif.mm0 + .mm1 accepted by mm0-rs + mm0-c" true
            else
                tail -3 "$_cert_tmp/clif.log" >&2
                check "W9: mm0/clif.mm0 + .mm1 accepted by mm0-rs + mm0-c" false
            fi
            # The layer's own claim about itself: declarations, no theorem. If a
            # theorem is ever added here, it needs its proof in the .mm1 (mm0-c
            # refuses one without), and this pin must be updated deliberately.
            if grep -q '^-- proves: 0 theorems$' "$repo_root/mm0/clif.mm0"; then
                check "W9: the CLIF model still claims no theorem" true
            else
                check "W9: the CLIF model still claims no theorem" false
            fi
        else
            gap "W9: mm0/clif.mm0 not re-checked (no mm0 toolchain)"
        fi

        _clif_dump="$repo_root/safestos/cranelift/target/release/clif_dump"
        if [ -x "$_clif_dump" ] && command -v python3 >/dev/null 2>&1; then
            if python3 "$repo_root/scripts/clif2mm0" >"$_cert_tmp/clif2mm0.log" 2>&1; then
                echo "  [detail] $(tail -1 "$_cert_tmp/clif2mm0.log")"
                check "W9: mm0/clif.mm0 is what the corpus lowering measures" true
            else
                tail -5 "$_cert_tmp/clif2mm0.log" >&2
                check "W9: mm0/clif.mm0 is what the corpus lowering measures" false
            fi
            # Negative control: the drift comparison has to be able to fail. A
            # form the lowering does not emit, appended to a copy of the model,
            # must be reported — otherwise "current" would mean the file agrees
            # with itself rather than with the measurement.
            cp "$repo_root/mm0/clif.mm0" "$_cert_tmp/clif-bogus.mm0"
            printf '\nterm bogus__none__r_i64: op;\n' >> "$_cert_tmp/clif-bogus.mm0"
            if python3 "$repo_root/scripts/clif2mm0" \
                    --model "$_cert_tmp/clif-bogus.mm0" >/dev/null 2>&1; then
                check "W9: a form the lowering does not emit is refused" false
            else
                check "W9: a form the lowering does not emit is refused" true
            fi
        else
            gap "W9: CLIF measurement not run (no clif_dump binary or no python3)"
        fi

        # W6: the generated probe is a test, and it has to actually run.
        if command -v cc >/dev/null 2>&1; then
            if cc -O2 -o "$_cert_tmp/probe" "$_cert_tmp/flux1d_probe.c" -lm \
                >"$_cert_tmp/cc.log" 2>&1 \
                && "$_cert_tmp/probe" >"$_cert_tmp/probe.log" 2>&1; then
                echo "  [detail] $(tail -1 "$_cert_tmp/probe.log")"
                check "W6: generated C probe compiles and passes at tolerance 1e-8" true
            else
                tail -3 "$_cert_tmp/cc.log" "$_cert_tmp/probe.log" 2>/dev/null >&2
                check "W6: generated C probe compiles and passes at tolerance 1e-8" false
            fi
        else
            gap "W6: generated C probe not run (no cc on PATH)"
        fi
    else
        tail -4 "$_cert_tmp/emit.log" >&2
        check "W2/W5/W6: flux1d certificate and probe re-emit byte-identically and mm0 re-accepts it" false
    fi
    rm -rf "$_cert_tmp"
fi

# W6: no artifact may upgrade a float path to a proof. A certificate that said
# "proved" next to a float line would be claiming more than mm0-c checked.
_bad_claims=""
for _art in "$repo_root"/mm0/*_certificate.mm0; do
    [ -e "$_art" ] || continue
    _hit="$(grep -i "float" "$_art" \
        | grep -i "proved" \
        | grep -vi "not proved\|unproved\|tested-not-proved" || true)"
    [ -n "$_hit" ] && _bad_claims="$_bad_claims$_art: $_hit"$'\n'
done
if [ -n "$_bad_claims" ]; then
    printf '%s' "$_bad_claims" >&2
    check "W6: no certificate claims a float path is proved" false
else
    check "W6: no certificate claims a float path is proved" true
fi
check_py "W2/W4: au2mm0 self-test (weakened scheme, division, false obligation and unpinned assumption all refused)" \
    python3 "$repo_root/scripts/au2mm0" selftest

# --- W1: the flux1d spec surface compiles and its obligations hold at a point ---
# The point test is not the proof; the certificate is. It is gated anyway because
# it is the only check that the *execution* side of the spec surface is still the
# module the obligations talk about. Built through `--use-cps-jit` on purpose:
# that is the path whose CPS bytes the certificate fingerprint records, so the
# gate fails if the kernel stops lowering or the JIT stops executing it.
_flux_dir="$repo_root/examples/verified-kernel/flux1d"
if [ -x "$repo_root/austral" ] && [ -f "$repo_root/libaustral_cranelift_bridge.so" ]; then
    _flux_tmp="$(mktemp -d)"
    if LD_LIBRARY_PATH="$repo_root" "$repo_root/austral" compile \
            "$_flux_dir/Flux1d.aui,$_flux_dir/Flux1d.aum" \
            --entrypoint=Flux1d:main --use-cps-jit \
            --output="$_flux_tmp/flux1d" \
            >"$_flux_tmp/log" 2>&1 \
       && "$_flux_tmp/flux1d"; then
        check "W1: Flux1d compiles through the CPS JIT and its four obligations hold at the example state" true
    else
        tail -5 "$_flux_tmp/log" >&2
        check "W1: Flux1d compiles through the CPS JIT and its four obligations hold at the example state" false
    fi
    rm -rf "$_flux_tmp"
else
    gap "W1: Flux1d not built here (repo-root austral binary or the cranelift bridge .so is absent)"
fi

# The obligations are decided twice (symbolic expansion + exact sampling) and
# the tool refuses a weakened scheme or a division; `emit` refuses until the
# ring-normalization prover exists, which is what keeps it from writing an
# unchecked statement.
check_py "W2: au2mm0 decides Flux1d's four obligations (both routes agree, hypothesis eliminated by substitution)" \
    python3 "$repo_root/scripts/au2mm0" check \
    "$repo_root/examples/verified-kernel/flux1d/flux1d.obligations.json"


# --- W3: approved statements, held out ---
#
# `verify` above regenerates each statement from the same export it verifies, so
# a weakened definition is reproduced faithfully and the drift gate cannot see
# it. The comparator closes that hole by diffing the regenerated statement
# stream against a file a human approved in a commit that touched only
# mm0/approved/, and by pinning the dependency closure and the theory hashes.
#
# An artifact with no approval is a [gap], never a silent pass: the point is to
# make "nobody has looked at this statement yet" visible in the gate's output
# rather than indistinguishable from "it was checked".
if [ -f "$repo_root/scripts/mm0-comparator" ]; then
    for _art in "$repo_root"/mm0/*.mm0; do
        [ -e "$_art" ] || continue
        _stem="$(basename "$_art" .mm0)"
        [ -f "$repo_root/mm0/$_stem.mm1" ] || continue
        # Nothing to approve in a declaration-only measurement artifact: it has
        # no statements, and the `proves: 0 theorems` pin plus `clif2mm0 check`
        # are the gates that belong to it. Any artifact that grows a theorem
        # loses this exemption, because the line it keys on no longer holds.
        if grep -q '^-- measured-by: scripts/clif2mm0' "$_art" \
                && grep -q '^-- proves: 0 theorems$' "$_art"; then
            continue
        fi
        if [ -f "$repo_root/mm0/approved/$_stem.stmts" ]; then
            # Exit 2 is "cannot verify here" (a pinned theory file such as
            # set.mm0 is untracked toolchain state), which is a gap by the same
            # convention as a missing interpreter — not a refusal.
            _rc=0
            if command -v python3 >/dev/null 2>&1; then
                python3 "$repo_root/scripts/mm0-comparator" check "$_stem" \
                    || _rc=$?
            else
                _rc=2
            fi
            if [ "$_rc" -eq 0 ]; then
                check "W3: $_stem matches its approved statements" true
            elif [ "$_rc" -eq 2 ]; then
                gap "W3: $_stem could not be checked here (see the comparator's message above)"
            else
                check "W3: $_stem matches its approved statements" false
            fi
        else
            gap "W3: $_stem has no approved statements (run scripts/mm0-comparator approve $_stem, then commit mm0/approved/)"
        fi
    done
    check_py "W3: comparator self-test (all three negative controls refuse)" \
        python3 "$repo_root/scripts/mm0-comparator" selftest
else
    gap "W3: scripts/mm0-comparator absent — approved statements are not gated"
fi

# --- logos: the CNL → DeltaNet → MM0 math fragment (unfer/docs/LOGOS_MM0.md) ---
#
# A sentence of the math fragment is compiled by unfer/logos's own pipeline
# (CNL → CoreIR → DeltaNet net), encoded as an MM0 theorem whose bridge axioms
# name the net's agents, and answered by mm0's verdict: proved `teq L R` is yes,
# `teq L R ⟹ tfals` is no, no certificate is "do not know". The gate owns the
# end-to-end chain *and* its anchor — a tampered certificate must be rejected,
# or "verified" means nothing.
if [ -f "$repo_root/scripts/logos2mm0" ] && [ -f "$repo_root/../unfer/logos/mm0/claims.txt" ]; then
    check "logos mm0: CNL → DeltaNet → MM0 corpus verifies (and its anchor fires)" \
        bash "$repo_root/scripts/logos2mm0"
else
    gap "logos mm0: sibling unfer repo absent at ../unfer — skipping the fragment gate"
fi

# --- memsafe: the linearity ledger + its MM0 certificates (docs/memsafe.md) ---
#
# The chain this gate owns, once per source: a fixture .aum is compiled with
# `--emit-linearity-ledger` into a pinned ledger, and scripts/ledger2mm0 turns
# that ledger into mm0/<stem>.{mm0,mm1} over docs/memsafe.mm0. Two sources,
# because neither reaches the other's shapes (docs/memsafe.md §3.2):
#
#   linearity_certificate        every *event* (acquire/consume/reacquire/
#                                borrow/unborrow/reborrow/drop)
#   linearity_certificate_spans  reborrow chains across frames, group borrows,
#                                mutable vs free spans
#
# Three distinct failure modes, three checks:
#
#   * the ledger drifting from the fixture or from the checker (regenerating
#     needs the compiler binary, so it is a gap when dune has not run);
#   * the certificate drifting from the ledger or the theory (`check`, needs
#     only python3);
#   * a certificate that would verify *anything* — the mutation anchors:
#     `selftest` (no toolchain) makes the emitter's audit refuse a trace whose
#     resource is never released, and `verify` additionally requires mm0-rs to
#     reject a proof paired with a mutated timeline. A certificate that
#     survives its own mutation is a tautology, not a check.
#
# `stem:ledger-stem:certificates` — the count mirrors scripts/ledger2mm0's
# BUDGETS, deliberately in two places: the emitter refuses to *generate* when
# they disagree with its own count, and this gate refuses to *ship* an artifact
# whose trust-split line disagrees with this table.
MEMSAFE_SOURCES="linearity_certificate:linearity_ledger:17 linearity_certificate_spans:linearity_ledger_spans:19"

memsafe_present=1
for src in $MEMSAFE_SOURCES; do
    stem="${src%%:*}"
    rest="${src#*:}"
    ledger_stem="${rest%%:*}"
    for f in "$repo_root/mm0/fixtures/${ledger_stem}.aum" \
             "$repo_root/mm0/ledgers/${ledger_stem}.json" \
             "$repo_root/mm0/${stem}.mm0" "$repo_root/mm0/${stem}.mm1"; do
        [ -f "$f" ] || memsafe_present=0
    done
done
if [ "$memsafe_present" = 1 ]; then
    check "memsafe: theory, emitter, both fixtures, ledgers and certificates present" true
else
    echo "  [detail] a memsafe fixture/ledger/certificate file is missing" >&2
    check "memsafe: theory, emitter, both fixtures, ledgers and certificates present" false
fi
check "memsafe: certificate + ledger emitter present and executable" \
    test -x "$repo_root/scripts/ledger2mm0"
check_py "memsafe: certificates in sync with the pinned ledgers and theory" \
    python3 "$repo_root/scripts/ledger2mm0" check
# The trust split of a memsafe certificate is 100% derived: every theorem is a
# run_cons chain, so `grounded` must be 0 and `structural` must equal the
# certificate count. If a line ever reads otherwise, the emitter stopped
# deriving and started asserting.
for src in $MEMSAFE_SOURCES; do
    stem="${src%%:*}"
    count="${src##*:}"
    if grep -q -- "-- trust-split: structural=$count grounded=0 certificates=$count" \
        "$repo_root/mm0/${stem}.mm0"; then
        check "memsafe: $stem pins its trust split ($count derived / 0 grounded)" true
    else
        echo "  [detail] expected: -- trust-split: structural=$count grounded=0 certificates=$count" >&2
        sed -n '/-- trust-split/p' "$repo_root/mm0/${stem}.mm0" >&2 || true
        check "memsafe: $stem pins its trust split ($count derived / 0 grounded)" false
    fi
done
# A rule no timeline exercises is a rule this certificate set does not test.
# The theory declares the automaton; the artifacts list the edges they fired;
# every declared edge must appear across them, so adding a transition without
# a fixture that reaches it fails here rather than passing silently.
exercised=""
for stem in linearity_certificate linearity_certificate_spans; do
    line="$(sed -n 's/^-- transitions exercised: //p' "$repo_root/mm0/${stem}.mm0")"
    exercised="$exercised,$line"
done
missing_edges=""
for edge in $(sed -n 's/^axiom \(t_[a-z_]*\).*/\1/p' "$repo_root/docs/memsafe.mm0"); do
    case ",$exercised," in
        *",$edge,"*) ;;
        *) missing_edges="$missing_edges $edge" ;;
    esac
done
if [ -n "$missing_edges" ]; then
    echo "  [detail] neither fixture reaches:$missing_edges" >&2
    check "memsafe: fixtures exercise every automaton edge" false
else
    check "memsafe: fixtures exercise every automaton edge" true
fi
check_py "memsafe: emitter self-test (audit refuses an unreleased resource)" \
    python3 "$repo_root/scripts/ledger2mm0" selftest

# Regenerate each ledger from its fixture. This is the only check that can
# notice the *checker* changing what it records: `check` compares artifacts to
# the pinned ledger, so a checker that quietly stops recording a consumption
# would still produce a consistent (and weaker) certificate. Needs the
# compiler binary and its bridge .so, hence the gap when dune has not run.
ledger_drift() {
    local fixture="$1"
    local pinned="$2"
    local tmp
    tmp="$(mktemp -d)"
    if ! ( cd "$tmp" && LD_LIBRARY_PATH="$repo_root/safestos/cranelift/target/release:$repo_root" \
             "$repo_root/_build/default/bin/austral.exe" compile \
             "$fixture" \
             --target-type=c --no-entrypoint \
             --output="$tmp/out.c" \
             --emit-linearity-ledger="$tmp/ledger.json" ) >"$tmp/log" 2>&1; then
        echo "  [detail] compiling $(basename "$fixture") failed:" >&2
        head -8 "$tmp/log" >&2
        rm -rf "$tmp"
        return 1
    fi
    if [ ! -f "$tmp/ledger.json" ]; then
        echo "  [detail] the compiler produced no ledger for $(basename "$fixture")" >&2
        rm -rf "$tmp"
        return 1
    fi
    if ! diff -u "$pinned" "$tmp/ledger.json" >"$tmp/diff"; then
        echo "  [detail] the pinned ledger drifted from the fixture:" >&2
        head -24 "$tmp/diff" >&2
        rm -rf "$tmp"
        return 1
    fi
    rm -rf "$tmp"
    return 0
}
if [ -x "$repo_root/_build/default/bin/austral.exe" ]; then
    for src in $MEMSAFE_SOURCES; do
        stem="${src%%:*}"
        rest="${src#*:}"
        ledger_stem="${rest%%:*}"
        check "memsafe: $ledger_stem in sync with its fixture and the checker" \
            ledger_drift "$repo_root/mm0/fixtures/${ledger_stem}.aum" \
                         "$repo_root/mm0/ledgers/${ledger_stem}.json"
    done
else
    gap "memsafe: pinned ledgers in sync with the fixtures (austral.exe not built; run dune build)"
fi

if command -v mm0-rs >/dev/null 2>&1 && command -v mm0-c >/dev/null 2>&1; then
    check_py "memsafe: mm0-rs + mm0-c verify both certificates, and reject mutated ones" \
        python3 "$repo_root/scripts/ledger2mm0" verify
else
    gap "memsafe: mm0 toolchain absent (mm0-rs/mm0-c not on PATH; see docs/memsafe.md §6)"
fi

# --- service isolation: the three-service certificate (docs/service_isolation.mm0) ---
#
# Same root of trust as memsafe, different subject: svcmux's cross-checked
# measurements (verifieduniquealiases/scripts/e2e-three-svcs.sh writes
# mm0/service_pins.json) become one `isolated` theorem per ordered pair,
# derived by iso_intro over the pinned facts. The invariants this gate owns:
#
#   * the artifacts are in sync with the pins and the theory (`check`);
#   * the trust split is structural-only — a `grounded=` line other than 0
#     means the emitter stopped deriving separations and started asserting
#     them, which is the exact failure the certificate exists to catch;
#   * the emitter's own audit refuses a pair measured equal on any axis
#     (`selftest`, no toolchain);
#   * mm0-rs + mm0-c accept the proofs and refuse a proof mutated to cite
#     the wrong axis's pinned constant (`verify`, needs the toolchain).
iso_files="$repo_root/mm0/service_pins.json $repo_root/docs/service_isolation.mm0 $repo_root/mm0/service_isolation_certificate.mm0 $repo_root/mm0/service_isolation_certificate.mm1"
iso_present=1
for f in $iso_files; do
    [ -f "$f" ] || iso_present=0
done
if [ "$iso_present" = 1 ]; then
    check "service-isolation: pins, theory and both certificate halves present" true
else
    echo "  [detail] missing one of: $iso_files" >&2
    check "service-isolation: pins, theory and both certificate halves present" false
fi
check "service-isolation: emitter present and executable" \
    test -x "$repo_root/scripts/service_iso2mm0"
check_py "service-isolation: certificate in sync with the pinned measurements and theory" \
    python3 "$repo_root/scripts/service_iso2mm0" check
iso_line="$(sed -n 's/^-- trust-split: //p' "$repo_root/mm0/service_isolation_certificate.mm0")"
iso_struct="$(sed -n 's/^structural=\([0-9]*\).*/\1/p' <<<"$iso_line")"
iso_ground="$(sed -n 's/.*grounded=\([0-9]*\).*/\1/p' <<<"$iso_line")"
iso_certs="$(sed -n 's/.*certificates=\([0-9]*\).*/\1/p' <<<"$iso_line")"
if [ -n "$iso_struct" ] && [ "$iso_ground" = 0 ] && [ "$iso_struct" = "$iso_certs" ]; then
    check "service-isolation: trust split is structural-only ($iso_struct derived / 0 grounded)" true
else
    echo "  [detail] trust-split line: $iso_line (want grounded=0, structural=certificates)" >&2
    check "service-isolation: trust split is structural-only ($iso_struct derived / 0 grounded)" false
fi
check_py "service-isolation: emitter self-test (an equal pair is refused, never axiomatized)" \
    python3 "$repo_root/scripts/service_iso2mm0" selftest
if command -v mm0-rs >/dev/null 2>&1 && command -v mm0-c >/dev/null 2>&1; then
    check_py "service-isolation: mm0-rs + mm0-c verify the theorems, and reject a mutated proof" \
        python3 "$repo_root/scripts/service_iso2mm0" verify
else
    gap "service-isolation: mm0 toolchain absent (mm0-rs/mm0-c not on PATH; see docs/service_isolation.mm0)"
fi

# --- H1.13 AuthorizationEngine: secure default, kernel denies without it ---
check "S28: AuthorizationEngine trait present" \
    grep -q "trait AuthorizationEngine" "$repo_root/safestos/cranelift/src/auth.rs"
check "S28: DenyAll is the default (fail-closed)" \
    grep -q "pub struct DenyAll" "$repo_root/safestos/cranelift/src/auth.rs"
check "S28: check() refuses without an installed engine" \
    grep -q "DenyAll" "$repo_root/safestos/cranelift/src/auth.rs"

# --- H1.14 Archetype surface: the three module archetypes are declared ---
check "H8: austral_cps default archetype declared" \
    grep -q 'austral_cps' "$repo_root/safestos/cranelift/src/module.rs"
check "H8: ecmascript archetype runtime branch present" \
    grep -q 'archetype == "ecmascript"' "$repo_root/safestos/cranelift/src/module.rs"
check "H8: manifest parser reads the archetype key" \
    grep -q 'get("archetype")' "$repo_root/safestos/cranelift/src/module.rs"

#!/usr/bin/env bash
# H1 verify-invariants gate (australVM).
#
# Turns the AGENTS.md maintenance checklist into machine-checkable invariants
# owned by THIS repo: the UNFER_SYMBOLS census, the symbol-sync test, the
# AuthorizationEngine default, and the archetype surface. Output lists every
# executed item; exit code is non-zero if any gate FAILS.

set -u
FAILED=0
PASSED=0
GAPS=0

check() {
    local name="$1"
    shift
    if "$@"; then
        echo "[pass] $name"
        PASSED=$((PASSED + 1))
    else
        echo "[FAIL] $name"
        FAILED=$((FAILED + 1))
    fi
}

gap() {
    echo "[gap]  $1"
    GAPS=$((GAPS + 1))
}

# A gate whose tool is absent must say so, not report a failure: otherwise a
# genuine census failure is indistinguishable from "no interpreter here", and
# the gate is red on every machine that lacks python3 (it was). This mirrors
# `unfer/scripts/verify-invariants`'s check_py.
check_py() {
    local name="$1"
    shift
    if ! command -v python3 >/dev/null 2>&1; then
        gap "$name (tooling absent: python3 not on PATH)"
        return 0
    fi
    check "$name" "$@"
}

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
# `. "$repo_root/scripts/lib/arch.sh"` holds the recorded-vs-host arch check
# shared with `scripts/obj-drift-control`.
. "$repo_root/scripts/lib/arch.sh"

# The compiler loads the bridge from `LD_LIBRARY_PATH`. A developer tree keeps a
# copy at the repo root; a clean `make bridge` (and CI) leaves it only under
# `target/release`, so resolve it once here instead of at each call site.
_bridge_so="$repo_root/libaustral_cranelift_bridge.so"
[ -f "$_bridge_so" ] || _bridge_so="$repo_root/safestos/cranelift/target/release/libaustral_cranelift_bridge.so"
_bridge_dir="$(dirname "$_bridge_so")"

# ── which compiler build the certificate's digests describe ──────────────────
# A certificate records digests taken by one `austral` and one bridge build. A
# binary newer than the artifact may describe different bytes, so when a digest
# comparison fails the mtimes decide whether to read it as drift or as an
# artifact that predates the compiler — the mid-rebuild case, where the failure
# used to arrive as a bare "digests differ".
#
# It is a diagnosis, never a skip: mtime alone cannot refuse the comparison,
# because a rebuild of identical sources leaves the digests equal and the tree
# green (measured 2026-11-19: `austral` 14:08:25, certificate recorded 13:57:34,
# gate exit 0). In CI the checkout writes the artifact before `make bridge`
# writes the binary, so an mtime-only refusal would be red on every run.
#
#   avm_stale_note <artifact> <candidate>…   -> note, or nothing
# The note names the newest candidate newer than the artifact; nothing when no
# candidate is. The self-test below is what keeps "nothing" reachable.
avm_stale_note() {
    local art="$1" cand art_epoch cand_epoch newest=0 newest_name=""
    shift
    art_epoch="$(stat -c %Y "$art" 2>/dev/null || echo 0)"
    for cand in "$@"; do
        [ -e "$cand" ] || continue
        cand_epoch="$(stat -c %Y "$cand" 2>/dev/null || echo 0)"
        if [ "$cand_epoch" -gt "$newest" ]; then
            newest="$cand_epoch"
            newest_name="$cand"
        fi
    done
    [ "$newest" -gt "$art_epoch" ] || return 0
    printf ' — %s is newer (%s) than %s (%s), so the recorded digests may describe an older compiler build; re-emit it: python3 scripts/au2mm0 emit examples/verified-kernel/flux1d/flux1d.obligations.json --code <cps>' \
        "${newest_name#"$repo_root"/}" "$(date -d "@$newest" +%Y-%m-%dT%H:%M:%S 2>/dev/null || echo "epoch $newest")" \
        "${art#"$repo_root"/}" "$(date -d "@$art_epoch" +%Y-%m-%dT%H:%M:%S 2>/dev/null || echo "epoch $art_epoch")"
}

# ── whether the loaded `austral` is the build of this tree ───────────────────
# The artifact note above answers "is the certificate older than the binary?".
# The mirror-image question has no answer from mtimes in a checked-out tree —
# a checkout rewrites every artifact's mtime, so a *stale binary* (built before
# a serializer change, then left in place while the sources were re-checked out)
# makes the certificate look newest and the note stay silent. Measured
# 2026-11-21: `./austral` 09:02 against `lib/CpsGen.ml` 14:12 made W5 fail with
# `recorded=c10ca9a9… bridge=fa4e9b29…` and no explanation; `make all` alone
# restored `recorded == bridge`, because the binary had been built before
# `d11050fe Restore the natural function order in the CPS serializer`.
#
# The signal that does exist is the compiler's own: a source file or a dune
# build output newer than the binary means the binary does not describe the
# tree. Like the artifact note this is a diagnosis of a failure already seen,
# never a skip, and it is controls-tested below.
#
#   avm_binary_stale_note <binary> <candidate>…   -> note, or nothing
avm_binary_stale_note() {
    local bin="$1" cand bin_epoch cand_epoch newest=0 newest_name=""
    shift
    bin_epoch="$(stat -c %Y "$bin" 2>/dev/null || echo 0)"
    for cand in "$@"; do
        [ -e "$cand" ] || continue
        cand_epoch="$(stat -c %Y "$cand" 2>/dev/null || echo 0)"
        if [ "$cand_epoch" -gt "$newest" ]; then
            newest="$cand_epoch"
            newest_name="$cand"
        fi
    done
    [ "$newest" -gt "$bin_epoch" ] || return 0
    printf ' — %s is newer (%s) than %s (%s): the binary predates this tree, so its digests describe an older compiler build; run: make all' \
        "${newest_name#"$repo_root"/}" "$(date -d "@$newest" +%Y-%m-%dT%H:%M:%S 2>/dev/null || echo "epoch $newest")" \
        "${bin#"$repo_root"/}" "$(date -d "@$bin_epoch" +%Y-%m-%dT%H:%M:%S 2>/dev/null || echo "epoch $bin_epoch")"
}

# Read-only relocation hooks, for drift controls only. Each names a *file or
# directory to read* — never something to write, and never something that grants
# an approval — so a control can drift one claim in a scratch copy and watch the
# gate refuse it without touching the tree. Same idiom as `AUSTRALVM_PLAN`,
# `AUSTRALVM_CLIF` and `AUSTRALVM_APPROVED_ROOT`.
#
#   AUSTRALVM_MM0_DIR      the model directory the Phase D, W8 hypothesis-pin,
#                          W9.3 witness and memsafe edge checks read
#   AUSTRALVM_LIQUID_GOLDEN the extracted OCaml the Liquid subset check diffs
#   AUSTRALVM_LIQUID_CHECK  the Liquid pass source the L11a ordering pin reads
_mm0="${AUSTRALVM_MM0_DIR:-$repo_root/mm0}"
_liquid_golden="${AUSTRALVM_LIQUID_GOLDEN:-$repo_root/lib/liquid/LiquidMeasure.ml}"
_liquid_check="${AUSTRALVM_LIQUID_CHECK:-$repo_root/lib/liquid/LiquidCheck.ml}"
# The approved copies the per-artifact lines and the table's approved rows are
# compared with. Overridable only so the controls can point at a scratch copy — it
# is the same `--approved-root` the comparator already takes, and it grants
# nothing: it moves which directory is read, not which artifact is approved. Both
# sides read it, including the `check` below, so an override cannot make the
# comparator answer about one root while the table is judged against another.
# (Defined here because the refinement's certificate line, far above the §W3
# table, asks the same question about `isa`.)
_appr_root="${AUSTRALVM_APPROVED_ROOT:-$repo_root/mm0/approved}"

# --- H1.12a UNFER_SYMBOLS census is the single uk_* registration point ---
check "S29: UNFER_SYMBOLS table present" \
    grep -q "pub(crate) const UNFER_SYMBOLS" "$repo_root/safestos/cranelift/src/lib.rs"
check "S29: UNFER_SYMBOLS registers into the Cranelift JIT" \
    grep -q "fn register_unfer_symbols" "$repo_root/safestos/cranelift/src/lib.rs"
check "S29: per-module CPS compile consumes the same census" \
    grep -q "UNFER_SYMBOLS" "$repo_root/safestos/cranelift/src/module.rs"
check "S29: symbol_sync test cross-checks EXPECTED_SYMBOLS.txt" \
    test -f "$repo_root/safestos/cranelift/tests/symbol_sync.rs"

# H2: the unfer census is generated from the one registry; run its check mode
# (sibling repo) so this gate also fails on drift there.
if [ -f "$repo_root/../unfer/scripts/gen_symbol_artifacts" ]; then
    check_py "H2: unfer symbol census in sync with SYMBOL_REGISTRY (generated)" \
        python3 "$repo_root/../unfer/scripts/gen_symbol_artifacts" check
else
    gap "H2: sibling unfer repo not present at ../unfer — skipping generator check"
fi

# --- D00: the distributed execution record and contract inventory ---
# `scripts/check-distributed-contracts` validates docs/distributed/EXECUTION.md's
# baseline block and docs/distributed/contracts.tsv: the exact headers, unique
# ids, a known class/repo/status, and every referenced path and evidence file
# (repo `U` paths resolve against ../unfer). `--selftest` mutates each rule and
# requires the refusal, so the checker cannot pass by being unable to fail.
# Structure only, by construction: a valid row says the record is well-formed,
# never that a guarantee holds. The `U` rows need the sibling checkout, so its
# absence is an explained gap here (as H2 above), not a failure of the record.
if [ ! -f "$repo_root/scripts/check-distributed-contracts" ]; then
    check "D00: distributed contract checker present" false
elif [ ! -d "$repo_root/../unfer" ]; then
    gap "D00: distributed contract inventory (sibling unfer repo not present at ../unfer, so its rows cannot be resolved)"
else
    check_py "D00: distributed execution record and contract inventory are well-formed" \
        python3 "$repo_root/scripts/check-distributed-contracts"
    check_py "D00: the distributed contract checker refuses every mutated record" \
        python3 "$repo_root/scripts/check-distributed-contracts" --selftest
fi

# --- Phase D: the Lean4 -> DeltaNets -> MM0 certificate (docs/lean4mm0.md §5) ---
#
# gap_certificate.{mm0,mm1} and layout_certificate.{mm0,mm1} are generated
# from the *pinned* nanoda-verified lean4export fixtures in unfer (sha256 in
# each file header) — the Lean sources of record timepiece/GapCertificate.lean
# and timepiece/Layout.lean — over the target theory docs/cic.mm0. Two
# failure modes this gate exists to catch: the emitter drifting from the
# pinned exports (`check` regenerates and compares against the committed
# artifacts), and the proofs rotting against the theory (`verify` re-runs
# mm0-rs and the mm0-c root of trust — a warning from mm0-rs is a proof
# hole and fails the gate).
check "Phase D: lean2mm0 emitter present" \
    test -f "$repo_root/scripts/lean2mm0"
check "Phase D: generated certificate artifacts present" \
    bash -c "test -f '$repo_root/mm0/gap_certificate.mm0' && test -f '$repo_root/mm0/gap_certificate.mm1' && test -f '$repo_root/mm0/layout_certificate.mm0' && test -f '$repo_root/mm0/layout_certificate.mm1'"
check_py "Phase D: generated MM0/MM1 in sync with the pinned lean4export" \
    python3 "$repo_root/scripts/lean2mm0" check
# The trust split is a pinned contract, not a statistic: generation fails when
# the grounded set widens (`check` above would catch it), and this asserts the
# *artifact* states its split, so a reader of the certificate cannot mistake an
# emitter-evaluated definition for one mm0-c checked. Widening is allowed — by
# editing BUDGETS in scripts/lean2mm0 in the same commit.
check "Phase D: gap_certificate pins its trust split (9 structural / 0 grounded)" \
    grep -q -- '-- trust-split: structural=9 grounded=0 certificates=9' \
    "$_mm0/gap_certificate.mm0"
check "Phase D: layout_certificate pins its trust split (3 structural / 5 grounded)" \
    grep -q -- '-- trust-split: structural=3 grounded=5 certificates=8' \
    "$_mm0/layout_certificate.mm0"
# `scripts/lean2mm0` also writes a `-- theory coverage:` line into each artifact
# (docs/lean4mm0.md §9.4) so a reader can tell a checked rule from a reserved
# one. The line is generated, so `check` above already pins it against the
# pinned exports; what that cannot notice is the generator *inventing* a name --
# a source construct encoded as `tfoo` for a rule the interface never declared
# would give a coverage line that reads complete and a certificate mm0-rs later
# rejects. So every `used=` name must be a declared term of the theory.
#
# A declaration is `term name: ...` or `term name (args: ...): ...`, hence the
# bracketed continuation class rather than a bare colon.
for artifact in "$_mm0"/*.mm0; do
    [ -e "$artifact" ] || continue
    name="$(basename "$artifact")"
    # A measurement artifact states its coverage in its own unit: `clif.mm0` is
    # generated by `scripts/clif2mm0` from the bridge's CLIF, so its rules are
    # measured instruction *forms*, each declared exactly once. That is a
    # stronger statement than the lean2mm0 line (which is about names a
    # certificate used), and it is generated, so it is compared to the file
    # itself rather than to a pinned export.
    if grep -q '^-- measured-by: scripts/clif2mm0' "$artifact"; then
        forms="$(sed -n 's/^-- clif-forms: //p' "$artifact")"
        declared="$(grep -cE '^term .*: op;' "$artifact")"
        if [ -n "$forms" ] && [ "$forms" = "$declared" ]; then
            check "Phase D: $name states its measured coverage ($forms form(s))" true
        else
            echo "  [detail] $name: -- clif-forms: '${forms}' vs $declared declared form(s)" >&2
            check "Phase D: $name states its measured coverage" false
        fi
        continue
    fi
    # An obligation artifact that imports no shared theory says so instead: its
    # vocabulary is the sorts and terms it declares itself (W9.3's
    # `store_projection.mm0`), so there is no `used=` rule list to ground and
    # nothing to compare against. Claiming an imported theory without the line
    # still falls through to the check below, so this is not an escape hatch.
    if grep -q '^-- theory: self-declared vocabulary' "$artifact"; then
        check "Phase D: $name declares its own vocabulary (no imported theory)" true
        continue
    fi
    used="$(sed -n 's/^-- theory coverage: used=\([^ ]*\) unused=.*/\1/p' "$artifact")"
    if [ -z "$used" ]; then
        check "Phase D: $name states its theory coverage" false
        continue
    fi
    # An artifact whose declarations are *imported* (the set.mm statement
    # layer) names its theory in a `-- theory source:` line instead of
    # embedding it, so the `used=` names must be grounded there — and that
    # theory is untracked toolchain state (metamath/set.mm0 + a 548 MB
    # set.mmu cannot be committed), hence a gap rather than a failure when
    # it is not provisioned: same idiom as the missing-toolchain gaps.
    theory="$artifact"
    theory_src="$(sed -n 's/^-- theory source: //p' "$artifact")"
    if [ -n "$theory_src" ]; then
        theory="$repo_root/$theory_src"
        if [ ! -f "$theory" ]; then
            gap "Phase D: $name grounded against $theory_src (imported theory not provisioned)"
            continue
        fi
    fi
    missing=""
    for rule in $(printf '%s' "$used" | tr ',' ' '); do
        grep -qE "^term $rule[ (:;]" "$theory" || missing="$missing $rule"
    done
    if [ -n "$missing" ]; then
        echo "  [detail] $name claims used rules the theory does not declare:$missing" >&2
        check "Phase D: $name only claims rules its theory declares" false
    else
        check "Phase D: $name only claims rules its theory declares" true
    fi
done
# Both anchors of the trust story must refuse tampered input. This needs no mm0
# toolchain: the mutation is caught before any .mmb exists, which is exactly the
# point — it tests the emitter's cross-checks, not the verifier.
check_py "Phase D: emitter self-test (both trust anchors refuse tampered input)" \
    python3 "$repo_root/scripts/lean2mm0" selftest
if command -v mm0-rs >/dev/null 2>&1 && command -v mm0-c >/dev/null 2>&1; then
    check_py "Phase D: mm0-rs elaborates and mm0-c re-verifies the certificate" \
        python3 "$repo_root/scripts/lean2mm0" verify
else
    gap "Phase D: mm0 toolchain absent (mm0-rs/mm0-c not on PATH; see docs/lean4mm0.md §5)"
fi

# `docs/kernel_alg.mm0` is the theory W2's symbolic certificates will rest on
# (the single `int_ring_transfer` bridge). It is gated from the day it exists,
# not from the day the first artifact cites it: an ungated theory file rots
# silently, and this one carries the trust budget.
if command -v mm0-rs >/dev/null 2>&1 && command -v mm0-c >/dev/null 2>&1; then
    _alg_tmp="$(mktemp -d)"
    _alg_out="$(mm0-rs compile "$repo_root/docs/kernel_alg.mm0" \
        "$_alg_tmp/kernel_alg.mmb" 2>&1)"
    if [ $? -eq 0 ] && mm0-c "$_alg_tmp/kernel_alg.mmb" \
            < "$repo_root/docs/kernel_alg.mm0"; then
        echo "  [detail] ${_alg_out##*$'\n'}"
        check "W2: docs/kernel_alg.mm0 accepted by mm0-rs + mm0-c" true
    else
        printf '%s\n' "$_alg_out" | tail -3 >&2
        check "W2: docs/kernel_alg.mm0 accepted by mm0-rs + mm0-c" false
    fi
    rm -rf "$_alg_tmp"
fi

# --- W2/W5/W6: the symbolic certificate, its code fingerprint and its probe ---
# Regenerated into a scratch directory and compared with the committed artifacts:
# drift means the prover, the theory, the obligation file or the compiled kernel
# moved and the certificate was not refreshed. `emit` re-checks the proof with
# mm0-rs + mm0-c itself, so a green run means the `peq` chain is still accepted by
# the root of trust, not merely that a file exists. The `--code` bytes come from
# the compiler's own `--emit-cps`, which is why the CPS digest in the header is a
# claim about the code that runs rather than about this JSON.
# The obj digest below is taken by whichever bridge the loader finds, and
# LD_LIBRARY_PATH=$repo_root puts the repo-root copy first while `make bridge`
# writes only target/release/. A stale root copy measures the kernel with an old
# bridge and is then compared against a pin written with that same old bridge —
# a silent pass, found once by scripts/obj-drift-control. Byte-identity between
# the two copies is the condition that rules it out; an absent copy is a gap.
_cl_built="$repo_root/safestos/cranelift/target/release/libaustral_cranelift_bridge.so"
_cl_loaded="$repo_root/libaustral_cranelift_bridge.so"
if [ -f "$_cl_built" ] && [ -f "$_cl_loaded" ]; then
    if cmp -s "$_cl_loaded" "$_cl_built"; then
        check "W5 (checked): the bridge the gate loads is the release artifact it was built from" true
    else
        echo "      refresh it: cp safestos/cranelift/target/release/libaustral_cranelift_bridge.so ." >&2
        check "W5 (checked): the bridge the gate loads is the release artifact it was built from" false
    fi
else
    gap "W5: loaded bridge is the release artifact (one of the two copies is absent)"
fi

_flux_obl="$repo_root/examples/verified-kernel/flux1d/flux1d.obligations.json"

# The staleness note is a comparison, so it is held to the same rule as every
# other one here: a scratch pair where the artifact is newest must produce no
# note, and the same pair with a newer binary must name it. A note that could
# only ever be non-empty would look right on the tree that produced it.
_stale_probe="$(mktemp -d)"
: > "$_stale_probe/artifact"
: > "$_stale_probe/binary"
touch -d '2026-01-01 00:01:00' "$_stale_probe/artifact"
touch -d '2026-01-01 00:00:00' "$_stale_probe/binary"
_stale_quiet="$(avm_stale_note "$_stale_probe/artifact" "$_stale_probe/binary")"
touch -d '2026-01-01 00:02:00' "$_stale_probe/binary"
_stale_loud="$(avm_stale_note "$_stale_probe/artifact" "$_stale_probe/binary")"
rm -rf "$_stale_probe"
check "W5: the staleness note is silent when the artifact is newest, and names the newer binary" \
    test -n "$_stale_loud" -a -z "$_stale_quiet" -a "${_stale_loud#*binary}" != "$_stale_loud"

# Same rule for the mirror question: a binary newest than every compiler source
# says nothing; a binary older than one names that source. Without the quiet
# half the note would be a constant, and a constant is not a diagnosis.
_bin_probe="$(mktemp -d)"
: > "$_bin_probe/austral"
: > "$_bin_probe/CpsGen.ml"
touch -d '2026-01-01 00:01:00' "$_bin_probe/CpsGen.ml"
touch -d '2026-01-01 00:02:00' "$_bin_probe/austral"
_bin_quiet="$(avm_binary_stale_note "$_bin_probe/austral" "$_bin_probe/CpsGen.ml")"
touch -d '2026-01-01 00:03:00' "$_bin_probe/CpsGen.ml"
_bin_loud="$(avm_binary_stale_note "$_bin_probe/austral" "$_bin_probe/CpsGen.ml")"
rm -rf "$_bin_probe"
check "W5: the binary note is silent when the binary is newest, and names the newer source" \
    test -n "$_bin_loud" -a -z "$_bin_quiet" -a "${_bin_loud#*CpsGen.ml}" != "$_bin_loud"

if [ -f "$_flux_obl" ] && command -v python3 >/dev/null 2>&1; then
    _cert_tmp="$(mktemp -d)"
    _cert_code=""
    _obj=""
    _obj_arch=""
    _cert_obj_arch=""
    # Where the bridge may sit: `make bridge` leaves it in the release dir, and
    # a developer tree often also has a copy at the root. Either is enough for
    # the compiler to load, so a fresh checkout (no root copy) is not a gap.
    _bridge_lib="$_bridge_so"
    if [ -x "$repo_root/austral" ] && [ -f "$_bridge_lib" ]; then
        ( cd "$repo_root/examples/verified-kernel/flux1d" \
            && LD_LIBRARY_PATH="$_bridge_dir:$repo_root" \
                "$repo_root/austral" compile \
                Flux1d.aui,Flux1d.aum --entrypoint=Flux1d:main \
                --use-cps-jit --emit-cps="$_cert_tmp/flux1d.cps" \
                --output="$_cert_tmp/flux1d.bin" ) \
            >"$_cert_tmp/cps.log" 2>&1
        if [ -f "$_cert_tmp/flux1d.cps" ]; then
            # The object digest comes from the bridge compiling the same bytes
            # into its AVCE capture. It is host-native, so the arch is part of
            # the record and the comparison below only holds byte-identity when
            # the committed arch is this host's — otherwise the certificate is
            # still compared, with the two code lines normalised, and the
            # incomparable object digest is reported rather than faked.
            _obj=""
            _obj_arch=""
            _obj_line="$(python3 "$repo_root/scripts/cps-fingerprint" --object \
                "$_cert_tmp/flux1d.cps" 2>"$_cert_tmp/obj.log")" || _obj_line=""
            if [ -n "$_obj_line" ]; then
                _obj="${_obj_line%% *}"
                _obj_arch="${_obj_line##*arch=}"
            else
                gap "W5: object digest not re-derivable (see $_cert_tmp/obj.log)"
            fi
            _cert_code="--code $_cert_tmp/flux1d.cps"
            [ -n "$_obj" ] && _cert_code="$_cert_code --obj $_obj --obj-arch $_obj_arch"
        else
            gap "W5: CPS bytes not emitted (--emit-cps wrote no file)"
        fi
    else
        gap "W5: code fingerprint not re-derivable (no ./austral + bridge here)"
    fi
    # shellcheck disable=SC2086  # _cert_code is a flag pair, empty when absent
    # Without `--code` the artifact's two header lines record `cps=unrecorded`,
    # so a straight `cmp` against an artifact emitted with the fingerprint would
    # fail on the one field this environment cannot re-derive. The comparison
    # below normalises exactly those two lines and holds everything else to
    # byte-identity, so the missing fingerprint stays a gap (recorded above, W5)
    # while a drifted proof, statement or probe still fails.
    _norm_code() {
        sed 's/^-- code: .*/-- code: <cps>/; s/^-- code-status: .*/-- code-status: <cps>/' "$1"
    }
    # The committed artifact records the arch its object digest was taken on; a
    # different host cannot reproduce that number, so it normalises instead of
    # failing and the mismatch is reported as a gap by the W5 (checked) block.
    _cert_obj_arch="$(avm_recorded_arch "$repo_root/mm0/flux1d_certificate.mm0")"
    # A control can name the host it wants compared against
    # (`AUSTRALVM_HOST_ARCH`, used by `scripts/w5-arch-gap-control`); a normal
    # run uses the architecture the bridge actually reported.
    _obj_host_arch="${AUSTRALVM_HOST_ARCH:-$_obj_arch}"
    # Attached to a failed comparison below, never used to skip one: a binary
    # newer than the artifact turns "the digests differ" into "these digests
    # may describe an older compiler build", which is the mid-rebuild case.
    _stale_note="$(avm_stale_note "$repo_root/mm0/flux1d_certificate.mm0" \
        "$repo_root/austral" "$_bridge_so")"
    # The other half of the same question, consulted only after a digest
    # comparison has failed: the loaded binary may predate the tree itself (a
    # serialiser change landed, the tree was re-checked out, `make all` was not
    # re-run). `_build`'s executable is included because a `dune build` without
    # the `cp` that `make all` does leaves exactly that gap.
    _bin_note="$(avm_binary_stale_note "$repo_root/austral" \
        "$repo_root"/lib/*.ml "$repo_root"/lib/*.mli "$repo_root"/bin/*.ml \
        "$repo_root/_build/default/bin/austral.exe")"
    _cert_same() {
        case "$1" in
            _probe.c) cmp -s "$_cert_tmp/flux1d$1" "$repo_root/mm0/flux1d$1" ;;
            *)
                if [ -n "$_cert_code" ] \
                    && { [ -z "$_obj" ] || [ "$_cert_obj_arch" = "$_obj_arch" ]; }; then
                    cmp -s "$_cert_tmp/flux1d$1" "$repo_root/mm0/flux1d$1"
                else
                    diff -q <(_norm_code "$_cert_tmp/flux1d$1") \
                            <(_norm_code "$repo_root/mm0/flux1d$1") >/dev/null
                fi
                ;;
        esac
    }
    if python3 "$repo_root/scripts/au2mm0" emit "$_flux_obl" \
            --out "$_cert_tmp" $_cert_code >"$_cert_tmp/emit.log" 2>&1; then
        _cert_ok=true
        for _suffix in _certificate.mm0 _certificate.mm1 _probe.c; do
            _cert_same "$_suffix" || _cert_ok=false
        done
        if [ -n "$_cert_code" ]; then
            _cert_claim="W2/W5/W6: flux1d certificate and probe re-emit byte-identically and mm0 re-accepts it"
        else
            _cert_claim="W2/W6: flux1d certificate and probe re-emit byte-identically apart from the code fingerprint, and mm0 re-accepts it"
        fi
        if [ "$_cert_ok" = true ]; then
            check "$_cert_claim" true
        else
            echo "      committed artifact is stale — run: python3 scripts/au2mm0 emit examples/verified-kernel/flux1d/flux1d.obligations.json --code <cps>" >&2
            [ -n "$_stale_note" ] && echo "      staleness:$_stale_note" >&2
            check "$_cert_claim" false
        fi
        # W5 (checked): the `cps=` digest in the certificate header must be the
        # *bridge's* digest of the bytes `--emit-cps` just wrote, not a number
        # only the emitter's own hashlib ever computed. Two implementations
        # (Rust `sha2` behind `austral_cps_fingerprint`, Python `hashlib` in
        # `au2mm0`) plus one negative control: a mutated copy of the same bytes
        # has to fingerprint differently, or the comparison is true of nothing.
        if [ -n "$_cert_code" ]; then
            _fp_bridge="$(python3 "$repo_root/scripts/cps-fingerprint" \
                "$_cert_tmp/flux1d.cps" 2>"$_cert_tmp/fp.log")"
            _fp_rc=$?
            _fp_recorded="$(sed -n 's/^-- code: cps=\([0-9a-f]\{64\}\).*/\1/p' \
                "$repo_root/mm0/flux1d_certificate.mm0" | head -1)"
            _fp_mut=""
            if [ "$_fp_rc" -eq 0 ] && [ -n "$_fp_recorded" ]; then
                python3 - "$_cert_tmp/flux1d.cps" "$_cert_tmp/flux1d-mut.cps" <<'PY'
import sys
blob = bytearray(open(sys.argv[1], 'rb').read())
if not blob:
    sys.exit(1)
blob[0] ^= 0xFF
open(sys.argv[2], 'wb').write(blob)
PY
                _fp_mut="$(python3 "$repo_root/scripts/cps-fingerprint" \
                    "$_cert_tmp/flux1d-mut.cps" 2>>"$_cert_tmp/fp.log")"
            fi
            if [ "$_fp_rc" -ne 0 ]; then
                gap "W5: code fingerprint not checked through the bridge (see $_cert_tmp/fp.log)"
            elif [ "$_fp_bridge" = "$_fp_recorded" ] \
                && [ -n "$_fp_mut" ] && [ "$_fp_mut" != "$_fp_recorded" ]; then
                check "W5 (checked): the certificate's cps digest is the bridge's digest of the emitted bytes" true
            else
                echo "      recorded=$_fp_recorded bridge=$_fp_bridge mutated=$_fp_mut" >&2
                [ -n "$_stale_note" ] && echo "      staleness:$_stale_note" >&2
                [ -n "$_bin_note" ] && echo "      staleness:$_bin_note" >&2
                check "W5 (checked): the certificate's cps digest is the bridge's digest of the emitted bytes" false
            fi
            # The object half: recorded only when the bridge produced an object
            # for these bytes, and compared only on the architecture it was
            # taken on. An artifact from another arch is a stated gap, never a
            # silent pass and never a false failure.
            _obj_recorded="$(sed -n 's/^-- code: .*obj=\([0-9a-f]\{64\}\).*/\1/p' \
                "$repo_root/mm0/flux1d_certificate.mm0" | head -1)"
            if [ -z "$_obj_recorded" ]; then
                gap "W5: object digest unrecorded in the committed certificate"
            elif [ -z "$_obj" ]; then
                gap "W5: object digest not re-derived (bridge could not compile the bytes)"
            elif [ "$_cert_obj_arch" != "$_obj_host_arch" ]; then
                _arch_gap="$(avm_arch_gap "$repo_root/mm0/flux1d_certificate.mm0" "$_obj_host_arch" || true)"
                gap "W5: object digest not comparable (${_arch_gap:-recorded arch=$_cert_obj_arch, this host $_obj_host_arch})"
            elif [ "$_obj" = "$_obj_recorded" ]; then
                check "W5 (checked): the certificate's obj digest is the bridge's digest of the emitted object ($_obj_arch)" true
            else
                echo "      recorded=$_obj_recorded bridge=$_obj" >&2
                [ -n "$_stale_note" ] && echo "      staleness:$_stale_note" >&2
                [ -n "$_bin_note" ] && echo "      staleness:$_bin_note" >&2
                check "W5 (checked): the certificate's obj digest is the bridge's digest of the emitted object ($_obj_arch)" false
            fi
        fi

        # W7 anchor: the statements a CNL citation points at must be what the
        # proof proves. Flip one coefficient in the `consistency` statement and
        # leave the proofs alone: mm0 has to refuse it, or "this sentence cites
        # theorem X" would be evidence about nothing.
        if command -v mm0-rs >/dev/null 2>&1 && command -v mm0-c >/dev/null 2>&1; then
            mkdir -p "$_cert_tmp/tamper"
            awk '/^theorem consistency/ && !done {
                     gsub(/\(tint n2\)/, "(tint n5)"); done = 1
                 }
                 { print }' "$_cert_tmp/flux1d_certificate.mm0" \
                > "$_cert_tmp/tamper/flux1d_certificate.mm0"
            cp "$_cert_tmp/flux1d_certificate.mm1" "$_cert_tmp/tamper/"
            if mm0-rs compile "$_cert_tmp/tamper/flux1d_certificate.mm0" \
                    "$_cert_tmp/tamper/tampered.mmb" >/dev/null 2>&1 \
                && mm0-c "$_cert_tmp/tamper/tampered.mmb" \
                    < "$_cert_tmp/tamper/flux1d_certificate.mm0" >/dev/null 2>&1; then
                check "W7: a certificate with a flipped coefficient is refused" false
            else
                check "W7: a certificate with a flipped coefficient is refused" true
            fi
        else
            gap "W7: flipped-coefficient certificate not re-checked (no mm0 toolchain)"
        fi

        # W8: the ISA layer. Three separate things are checked, because the
        # artifact, the citations and the instruction subset fail differently:
        # (a) mm0-c accepts the theory (it refuses unproved theorems, so a
        #     `theorem` line without a proof is a gate failure, not a footnote);
        # (b) every gap-hypothesis is cited and pinned, and a stale pin is
        #     refused — the W7 discipline applied to layer-1 certificates;
        # (c) scripts/isa-census measures the opcodes the decoder actually
        #     consumes against ISA_REGISTRY and against the artifact's table,
        #     with a negative control proving the diff can fail.
        # MM0 splits specification from proof: mm0-rs compiles `isa.mm1` (the
        # same statements, each theorem carrying its proof) and mm0-c re-checks
        # that proof against `isa.mm0`, the specification it also reads. So the
        # pair is what is accepted — compiling the specification alone would
        # only prove it parses, and would pass with every proof missing.
        if command -v mm0-rs >/dev/null 2>&1 && command -v mm0-c >/dev/null 2>&1; then
            if mm0-rs compile "$repo_root/mm0/isa.mm1" "$_cert_tmp/isa.mmb" \
                    >"$_cert_tmp/isa.log" 2>&1 \
                && ! grep -q 'sorry' "$_cert_tmp/isa.log" \
                && mm0-c "$_cert_tmp/isa.mmb" < "$repo_root/mm0/isa.mm0" \
                    >/dev/null 2>&1; then
                echo "  [detail] $(grep -E 'sorts,' "$_cert_tmp/isa.log" | tail -1)"
                check "W8: mm0/isa.mm0 + isa.mm1 accepted by mm0-rs + mm0-c, no sorry" true
            else
                tail -3 "$_cert_tmp/isa.log" >&2
                check "W8: mm0/isa.mm0 + isa.mm1 accepted by mm0-rs + mm0-c, no sorry" false
            fi

            # The layout model the memory hypothesis cites: `in_bounds` is a
            # definition there and `in_bounds_alloc` is proved about it, which
            # is what makes `bounds_from_layout`'s citation checkable rather
            # than decorative. Control: the monotonicity proof must depend on
            # its step — replacing the symm step with the raw allocation
            # equation reverses the equality and must be refused.
            if mm0-rs compile "$repo_root/mm0/slot_layout.mm1" "$_cert_tmp/slot.mmb" \
                    >"$_cert_tmp/slot.log" 2>&1 \
                && ! grep -q 'sorry' "$_cert_tmp/slot.log" \
                && mm0-c "$_cert_tmp/slot.mmb" < "$repo_root/mm0/slot_layout.mm0" \
                    >/dev/null 2>&1; then
                echo "  [detail] $(grep -E 'sorts,' "$_cert_tmp/slot.log" | tail -1)"
                check "W8: mm0/slot_layout.mm0 + .mm1 accepted, in_bounds_alloc proved" true
            else
                tail -3 "$_cert_tmp/slot.log" >&2
                check "W8: mm0/slot_layout.mm0 + .mm1 accepted, in_bounds_alloc proved" false
            fi
            sed 's/(seq_symm slots_alloc)/(slots_alloc)/' \
                "$repo_root/mm0/slot_layout.mm1" > "$_cert_tmp/slot-bad.mm1"
            if mm0-rs compile "$_cert_tmp/slot-bad.mm1" "$_cert_tmp/slot-bad.mmb" \
                    >"$_cert_tmp/slot-bad.log" 2>&1 \
                && ! grep -q 'sorry' "$_cert_tmp/slot-bad.log"; then
                check "W8: the allocation-monotonicity proof depends on its direction" false
            else
                check "W8: the allocation-monotonicity proof depends on its direction" true
            fi
        else
            gap "W8: mm0/isa.mm0 not re-checked (no mm0 toolchain)"
        fi

        # The encdec block is generated from ISA_REGISTRY and its 23 proofs are
        # checked above; what this adds is that the committed artifacts are the
        # ones the generator produces *now* (a table edit without a regenerate),
        # that the count is 23/23, and the negative control: dropping one table
        # line must leave a theorem unprovable rather than silently accepted, so
        # a `theorem` cannot outlive the equation it was proved from.
        if [ -x "$repo_root/scripts/isa-encdec" ] && command -v mm0-rs >/dev/null 2>&1 \
                && command -v mm0-c >/dev/null 2>&1; then
            if "$repo_root/scripts/isa-encdec" >"$_cert_tmp/encdec.log" 2>&1; then
                echo "  [detail] $(cat "$_cert_tmp/encdec.log")"
                check "W8: encdec table and its proofs are current" true
            else
                cat "$_cert_tmp/encdec.log" >&2
                check "W8: encdec table and its proofs are current" false
            fi
            # Control: move one table entry off its byte (0x05 -> 0x06 in
            # `enc_add`). The proof file is unchanged, so if `encdec_add` still
            # checked, the theorem would not be *about* the byte it names — the
            # exact vacuity this section replaced. mm0-rs must refuse.
            if python3 - "$repo_root/mm0/isa.mm1" "$_cert_tmp/isa-moved.mm1" <<'PY'
import sys
src, dst = sys.argv[1], sys.argv[2]
text = open(src).read()
old = 'axiom enc_add: $ beq (ienc ins_add) n5 $;'
if old not in text:
    sys.exit('no `axiom enc_add ... n5` line to move')
open(dst, 'w').write(text.replace(old, old.replace('n5 $;', 'n6 $;'), 1))
PY
            then
                if mm0-rs compile "$_cert_tmp/isa-moved.mm1" \
                        "$_cert_tmp/isa-moved.mmb" >/dev/null 2>&1; then
                    check "W8: a table entry moved off its byte breaks its proof" false
                else
                    check "W8: a table entry moved off its byte breaks its proof" true
                fi
            else
                check "W8: a table entry moved off its byte breaks its proof" false
            fi
        else
            gap "W8: encdec proofs not re-checked (no mm0 toolchain or script)"
        fi

        # --- PC02: the shared word/map semantics and the first clamp bound ---
        # The proof is checked against its own specification, and a mutated
        # conclusion must be refused: a proof that still checked after the
        # theorem changed would be proving something else. The finite control
        # is separate and never counted as the general proof.
        mkdir -p "$_cert_tmp/pc02"
        if command -v mm0-rs >/dev/null 2>&1 && command -v mm0-c >/dev/null 2>&1; then
            if mm0-rs compile "$repo_root/mm0/proof_chain/word.mm1" \
                    "$_cert_tmp/pc02/word.mmb" >"$_cert_tmp/pc02/word.log" 2>&1 \
                && ! grep -q 'sorry' "$_cert_tmp/pc02/word.log" \
                && mm0-c "$_cert_tmp/pc02/word.mmb" \
                    < "$repo_root/mm0/proof_chain/word.mm0" >/dev/null 2>&1; then
                echo "  [detail] $(grep -E 'sorts,' "$_cert_tmp/pc02/word.log" | tail -1) — PC02 word.mm0"
                check "PC02: word.mm0 + word.mm1 accepted, clamp bounds and map laws proved" true
            else
                tail -5 "$_cert_tmp/pc02/word.log" >&2
                check "PC02: word.mm0 + word.mm1 accepted, clamp bounds and map laws proved" false
            fi
            sed 's/ule (source_clamp x) u100/ule u100 (source_clamp x)/' \
                "$repo_root/mm0/proof_chain/word.mm1" > "$_cert_tmp/pc02/word-bad.mm1"
            if mm0-rs compile "$_cert_tmp/pc02/word-bad.mm1" \
                    "$_cert_tmp/pc02/word-bad.mmb" >/dev/null 2>&1; then
                check "PC02: flipping clamp_upper's conclusion is refused" false
            else
                check "PC02: flipping clamp_upper's conclusion is refused" true
            fi
        else
            gap "PC02: mm0/proof_chain/word.mm0 not re-checked (no mm0 toolchain)"
        fi
        check_py "PC02: finite word/map interpretation controls" \
            python3 "$repo_root/scripts/pc02-controls"

        # --- PC03: relation/composition and exact premise discharge ---
        # The relation layer is a fragment assembled after word.mm0, so the
        # check is on the assembled specification. The script also requires
        # the conditional/discharged premise counts, the imported `clamp_upper`
        # in the discharge, and three refusing mutations.
        if command -v mm0-rs >/dev/null 2>&1 && command -v mm0-c >/dev/null 2>&1; then
            check_py "PC03: composition, discharge and premise controls" \
                python3 "$repo_root/scripts/pc03-compose"
            # PC06 applies that composition to G13's memory plan. It checks the
            # plan theorem, the shared-theorem reuse, the residual table against
            # the docs and the generator's obligation slots, and refuses forged
            # proof records. It also recomputes the statement/application/closure
            # rows of `gpu_plan.closure` and refuses a stale or hand-edited cache
            # row (`--write` regenerates it). It never turns the plan artifact
            # into a certificate.
            check_py "PC06: GPU plan composition and residual obligations" \
                python3 "$repo_root/scripts/pc06-obligations"
            # PC04's committed artifact is generated by `bin/gpu_proof` from the
            # actual fixture and its KernelIR; the script re-checks the MM0 and
            # pins the recorded source digest to the fixture bytes. The OCaml
            # test performs the reflection itself.
            check_py "PC04: source→KernelIR reflection of the clamp fixture" \
                python3 "$repo_root/scripts/pc04-reflect"
        else
            gap "PC03: mm0/proof_chain/relation.mm0 not re-checked (no mm0 toolchain)"
            gap "PC06: mm0/proof_chain/gpu_plan.mm0 not re-checked (no mm0 toolchain)"
            gap "PC04: mm0/proof_chain/clamp_source.mm0 not re-checked (no mm0 toolchain)"
        fi

        # PC05a reflects the *parsed* WGSL the runtime validates. Only its MM0
        # replay needs the toolchain, so the reflection, the byte-identity check
        # and the three parsed-shader refusals run even here; exit 3 means
        # "reflection checked, replay skipped" and is a gap, never a pass.
        if command -v python3 >/dev/null 2>&1; then
            _pc05=0
            python3 "$repo_root/scripts/pc05-reflect" \
                >"$_cert_tmp/pc05.log" 2>&1 || _pc05=$?
            case $_pc05 in
                0)
                    grep -E '^  \[detail\]' "$_cert_tmp/pc05.log" >&2
                    check "PC05a: parsed-WGSL reflection of the clamp fixture" true
                    ;;
                3)
                    grep -E '^  \[detail\]' "$_cert_tmp/pc05.log" >&2
                    gap "PC05a: clamp_wgsl.mm0 not replayed (no mm0-rs/mm0-c on PATH)"
                    check "PC05a: parsed-WGSL reflection of the clamp fixture" true
                    ;;
                *)
                    cat "$_cert_tmp/pc05.log" >&2
                    check "PC05a: parsed-WGSL reflection of the clamp fixture" false
                    ;;
            esac
        else
            gap "PC05a: parsed-WGSL reflection not checked (tooling absent: python3)"
        fi

        # PC05b transports the clamp bound through that reflected edge. The
        # premise register, the byte-identity check and the refusals it owns run
        # without the toolchain; exit 3 means "transport checked, replay
        # skipped" and is a gap, never a pass.
        if command -v python3 >/dev/null 2>&1; then
            _pc05b=0
            python3 "$repo_root/scripts/pc05b-transport" \
                >"$_cert_tmp/pc05b.log" 2>&1 || _pc05b=$?
            case $_pc05b in
                0)
                    grep -E '^  \[detail\]' "$_cert_tmp/pc05b.log" >&2
                    check "PC05b: transported bound through the reflected edge" true
                    ;;
                3)
                    grep -E '^  \[detail\]' "$_cert_tmp/pc05b.log" >&2
                    gap "PC05b: clamp_transport.mm0 not replayed (no mm0-rs/mm0-c on PATH)"
                    check "PC05b: transported bound through the reflected edge" true
                    ;;
                *)
                    cat "$_cert_tmp/pc05b.log" >&2
                    check "PC05b: transported bound through the reflected edge" false
                    ;;
            esac
        else
            gap "PC05b: transport of the clamp bound not checked (tooling absent: python3)"
        fi

        # PC07 replays the whole frozen chain (`mm0/proof_chain/chain.toml`) and
        # holds the declared proof graph, the subject cut with its shared
        # digests and the exact residual closure to what the replay establishes.
        # Its selftest is the card's negative controls. Exit 3 means "not
        # replayed here" and is a gap, never a pass.
        if command -v python3 >/dev/null 2>&1; then
            _pc07=0
            python3 "$repo_root/scripts/proof-chain" check \
                >"$_cert_tmp/pc07.log" 2>&1 || _pc07=$?
            case $_pc07 in
                0)
                    grep -E '^  \[detail\]' "$_cert_tmp/pc07.log" >&2
                    check "PC07: the frozen chain replays and its declaration matches" true
                    ;;
                3)
                    grep -E '^  \[detail\]' "$_cert_tmp/pc07.log" >&2
                    gap "PC07: mm0/proof_chain/chain.toml not replayed (no mm0-rs/mm0-c on PATH)"
                    check "PC07: the frozen chain replays and its declaration matches" true
                    ;;
                *)
                    cat "$_cert_tmp/pc07.log" >&2
                    check "PC07: the frozen chain replays and its declaration matches" false
                    ;;
            esac
            _pc07s=0
            python3 "$repo_root/scripts/proof-chain" selftest \
                >"$_cert_tmp/pc07-selftest.log" 2>&1 || _pc07s=$?
            case $_pc07s in
                0)
                    check "PC07: the chain checker's controls refuse and report separates" true
                    ;;
                3)
                    gap "PC07: the chain controls not run (no mm0-rs/mm0-c on PATH)"
                    check "PC07: the chain checker's controls refuse and report separates" true
                    ;;
                *)
                    cat "$_cert_tmp/pc07-selftest.log" >&2
                    check "PC07: the chain checker's controls refuse and report separates" false
                    ;;
            esac
        else
            gap "PC07: the frozen chain not checked (tooling absent: python3)"
        fi

        # PC08 captures one real host fragment (the bridge's own `cps2cell`
        # output for `examples/native-fragment`), re-decodes its bytes with a
        # closed table, and holds the stated edge to that capture byte-for-byte.
        # The edge itself is `[gap]`: there is no x86_64 model here, so it is
        # stated and pinned, never a native profile. Its selftest flips an
        # immediate, a relocation target, an instruction byte, truncates a body,
        # changes the arch, edits the statement, relabels it a certificate and
        # adds an axiom — each must be refused by the check that owns it.
        if command -v python3 >/dev/null 2>&1; then
            _pc08=0
            python3 "$repo_root/scripts/native-edge" check \
                >"$_cert_tmp/pc08.log" 2>&1 || _pc08=$?
            case $_pc08 in
                0)
                    grep -E '^  \[detail\]' "$_cert_tmp/pc08.log" >&2
                    check "PC08: the captured host fragment decodes and is pinned" true
                    ;;
                *)
                    cat "$_cert_tmp/pc08.log" >&2
                    check "PC08: the captured host fragment decodes and is pinned" false
                    ;;
            esac
            _pc08s=0
            python3 "$repo_root/scripts/native-edge" selftest \
                >"$_cert_tmp/pc08-selftest.log" 2>&1 || _pc08s=$?
            if [ $_pc08s -eq 0 ]; then
                check "PC08: the native edge's controls refuse" true
            else
                cat "$_cert_tmp/pc08-selftest.log" >&2
                check "PC08: the native edge's controls refuse" false
            fi
        else
            gap "PC08: the captured host fragment not checked (tooling absent: python3)"
        fi

        if [ -x "$repo_root/scripts/isa-hypotheses" ] || [ -f "$repo_root/scripts/isa-hypotheses" ]; then
            if python3 "$repo_root/scripts/isa-hypotheses" "$_mm0/isa.mm0" \
                    >"$_cert_tmp/hyp.log" 2>&1; then
                sed '0,/sha256=[0-9a-f]/s//sha256=0/' "$_mm0/isa.mm0" \
                    > "$_cert_tmp/isa-tampered.mm0"
                if python3 "$repo_root/scripts/isa-hypotheses" \
                        "$_cert_tmp/isa-tampered.mm0" >/dev/null 2>&1; then
                    check "W8: an uncited or stale hypothesis is refused" false
                else
                    echo "  [detail] $(cat "$_cert_tmp/hyp.log")"
                    check "W8: an uncited or stale hypothesis is refused" true
                fi
                # The unchecked count is pinned, so an unchecked citation cannot
                # be added — or a real one quietly re-labelled as checked.
                # (The model pins 0 now that `bounds_from_layout` cites the
                # layout model, so the control *adds* a phantom one.)
                sed 's/^-- unchecked-citations: 0$/-- unchecked-citations: 1/' \
                    "$repo_root/mm0/isa.mm0" > "$_cert_tmp/isa-relabelled.mm0"
                if python3 "$repo_root/scripts/isa-hypotheses" \
                        "$_cert_tmp/isa-relabelled.mm0" >/dev/null 2>&1; then
                    check "W8: an unchecked citation cannot be re-labelled as checked" false
                else
                    check "W8: an unchecked citation cannot be re-labelled as checked" true
                fi
            else
                cat "$_cert_tmp/hyp.log" >&2
                check "W8: hypotheses are cited, pinned, and the unchecked count matches its pin" false
            fi
        else
            gap "W8: hypothesis citations not checked (scripts/isa-hypotheses missing)"
        fi

        _census="$repo_root/safestos/cranelift/target/release/isa_census"
        if [ -n "$_cert_code" ] && [ -x "$_census" ]; then
            if "$_census" "$_cert_tmp/flux1d.cps" "$repo_root/mm0/isa.mm0" \
                    >"$_cert_tmp/census.log" 2>&1; then
                check "W8: scripts/isa-census covers the emitted opcodes" true
                grep -E '^  used:' "$_cert_tmp/census.log" | sed 's/^/      /' >&2
            else
                cat "$_cert_tmp/census.log" >&2
                check "W8: scripts/isa-census covers the emitted opcodes" false
            fi
            # One module does not measure "the emitted subset": flux1d reads 8
            # of the 23 opcodes. The corpus check compiles every example whose
            # CPS path produces a function and censuses the union, so an opcode
            # added to the decoder is caught even if flux1d never emits it.
            if "$repo_root/scripts/isa-census" --corpus >"$_cert_tmp/corpus.log" 2>&1; then
                grep -E '^isa-census: ' "$_cert_tmp/corpus.log" | sed 's/^/      /' >&2
                check "W8: the corpus census covers every opcode the examples emit" true
            else
                tail -3 "$_cert_tmp/corpus.log" >&2
                check "W8: the corpus census covers every opcode the examples emit" false
            fi
            # Negative control: an opcode the decoder does not accept, declared
            # in a copy of the model, must be reported — otherwise the census
            # would be measuring agreement between a table and itself.
            cp "$repo_root/mm0/isa.mm0" "$_cert_tmp/isa-bogus.mm0"
            printf '%s\n' '-- op 0x7f bogus' >> "$_cert_tmp/isa-bogus.mm0"
            if "$_census" "$_cert_tmp/flux1d.cps" "$_cert_tmp/isa-bogus.mm0" \
                    >/dev/null 2>&1; then
                check "W8: isa-census refuses a model opcode the decoder rejects" false
            else
                check "W8: isa-census refuses a model opcode the decoder rejects" true
            fi
        else
            gap "W8: opcode census not run (no emitted CPS or no isa_census binary)"
        fi

        # `AUSTRALVM_CLIF` moves which file the W9/W9.3 checks that read the model
        # read — the `proves: 0 theorems` pin, the vocabulary test, the pinned
        # citations and the certificate line — so a control can drift one claim in
        # a copy without touching the tree or the checks that must keep seeing the
        # real file (the corpus re-derivation compares generated bytes with the
        # committed path, and mm0-c accepts the committed `.mm0` against the
        # committed `.mm1`). It grants nothing: it names a file to read, like
        # `AUSTRALVM_APPROVED_ROOT` names a root.
        _clif="${AUSTRALVM_CLIF:-$repo_root/mm0/clif.mm0}"
        # W9.2: the Cranelift-IR layer. The CPS→CLIF lowering is Rust code mm0-c
        # cannot see, so until now the chain stopped at the CPS IR and resumed
        # at the object digest — which says "unchanged", not "what". Now the
        # lowering's *output shape* is an artifact: `clif_dump` measures every
        # instruction the bridge's own compile produces, `scripts/clif2mm0`
        # turns the corpus measurement into `mm0/clif.mm0`, and mm0-c checks the
        # committed declarations against that compiled model. The file proves
        # nothing — `clif_step` and the refinement are W9.3 — and it says so in a
        # line pinned here, so a theorem cannot be added without a proof.
        if command -v mm0-rs >/dev/null 2>&1 && command -v mm0-c >/dev/null 2>&1; then
            if mm0-rs compile "$repo_root/mm0/clif.mm1" "$_cert_tmp/clif.mmb" \
                    >"$_cert_tmp/clif.log" 2>&1 \
                && ! grep -q 'sorry' "$_cert_tmp/clif.log" \
                && mm0-c "$_cert_tmp/clif.mmb" < "$repo_root/mm0/clif.mm0" \
                    >/dev/null 2>&1; then
                echo "  [detail] $(grep -E 'sorts,' "$_cert_tmp/clif.log" | tail -1)"
                check "W9: mm0/clif.mm0 + .mm1 accepted by mm0-rs + mm0-c" true
            else
                tail -3 "$_cert_tmp/clif.log" >&2
                check "W9: mm0/clif.mm0 + .mm1 accepted by mm0-rs + mm0-c" false
            fi
            # The layer's own claim about itself: declarations, no theorem. If a
            # theorem is ever added here, it needs its proof in the .mm1 (mm0-c
            # refuses one without), and this pin must be updated deliberately.
            if grep -q '^-- proves: 0 theorems$' "$_clif"; then
                check "W9: the CLIF model still claims no theorem" true
            else
                check "W9: the CLIF model still claims no theorem" false
            fi
        else
            gap "W9: mm0/clif.mm0 not re-checked (no mm0 toolchain)"
        fi

        # W9.3: the obligation is *stated*, and certification is refused
        # mechanically. `mm0/clif.mm0` names the relation (`term clif_step …:
        # Prop`) and must not assert it — an `axiom` there would be an
        # unproved claim dressed as vocabulary, and a `theorem` cannot exist
        # without its proof in the .mm1 anyway. The certificate line is the
        # owner's decision to make, so the file may say `[gap]` only while
        # `mm0/approved/` has no `isa` approval; once the approval lands, the
        # gap line must be replaced by a citation and a proof, and this fails
        # until it is. That is the difference between stating an obligation and
        # certifying it, enforced rather than described.
        # (`_clif` above is the file these four checks read.)
        if grep -q '^term clif_step ' "$_clif" \
                && grep -q 'clif_step s o' "$_clif" \
                && ! grep -qE '^(axiom|theorem) ' "$_clif"; then
            check "W9.3: clif_step is vocabulary — declared, stated, never axiomatized" true
        else
            check "W9.3: clif_step is vocabulary — declared, stated, never axiomatized" false
        fi
        # Every pinned citation must still describe the file it names. A digest
        # is not a proof of relevance, but a stale one means the obligation is
        # citing content that has since been rewritten.
        sed -n 's/^-- cites: \([^ ]*\) sha256=\([0-9a-f]\{64\}\)$/\1 \2/p' \
            "$_clif" > "$_cert_tmp/clif-cites.txt"
        _cite_bad=""
        _cite_n=0
        while read -r _cite_path _cite_pin; do
            [ -n "$_cite_path" ] || continue
            _cite_n=$((_cite_n + 1))
            _cite_actual="$(sha256sum "$repo_root/$_cite_path" 2>/dev/null | cut -d' ' -f1)"
            [ "$_cite_actual" = "$_cite_pin" ] || _cite_bad="$_cite_bad $_cite_path"
        done < "$_cert_tmp/clif-cites.txt"
        if [ "$_cite_n" -ge 5 ] && [ -z "$_cite_bad" ]; then
            check "W9.3: the refinement's citations still match their artifacts ($_cite_n pinned)" true
        else
            echo "  [detail] stale citations:${_cite_bad:- none} of $_cite_n (expected >= 5)" >&2
            check "W9.3: the refinement's citations still match their artifacts" false
        fi
        if [ -e "$_appr_root/isa.stmts" ]; then
            if grep -q '^-- certificate: \[gap\]' "$_clif"; then
                echo "  [detail] $_appr_root/isa.stmts exists — clif.mm0 must cite it, not a gap" >&2
                check "W9.3: certification state matches mm0/approved/" false
            else
                check "W9.3: certification state matches mm0/approved/" true
            fi
        else
            if grep -q '^-- certificate: \[gap\]' "$_clif"; then
                check "W9.3: certification state matches mm0/approved/" true
            else
                echo "  [detail] no isa approval, yet clif.mm0 does not say [gap]" >&2
                check "W9.3: certification state matches mm0/approved/" false
            fi
        fi

        _clif_dump="$repo_root/safestos/cranelift/target/release/clif_dump"
        if [ -x "$_clif_dump" ] && command -v python3 >/dev/null 2>&1; then
            if python3 "$repo_root/scripts/clif2mm0" >"$_cert_tmp/clif2mm0.log" 2>&1; then
                echo "  [detail] $(tail -1 "$_cert_tmp/clif2mm0.log")"
                check "W9: mm0/clif.mm0 is what the corpus lowering measures" true
            else
                tail -5 "$_cert_tmp/clif2mm0.log" >&2
                check "W9: mm0/clif.mm0 is what the corpus lowering measures" false
            fi
            # Negative control: the drift comparison has to be able to fail. A
            # form the lowering does not emit, appended to a copy of the model,
            # must be reported — otherwise "current" would mean the file agrees
            # with itself rather than with the measurement.
            cp "$repo_root/mm0/clif.mm0" "$_cert_tmp/clif-bogus.mm0"
            printf '\nterm bogus__none__r_i64: op;\n' >> "$_cert_tmp/clif-bogus.mm0"
            if python3 "$repo_root/scripts/clif2mm0" \
                    --model "$_cert_tmp/clif-bogus.mm0" >/dev/null 2>&1; then
                check "W9: a form the lowering does not emit is refused" false
            else
                check "W9: a form the lowering does not emit is refused" true
            fi
        else
            gap "W9: CLIF measurement not run (no clif_dump binary or no python3)"
        fi

        # W9.1: the converted external ISA model. Re-converting the pinned model
        # needs the `lean` shell (lean, lean4export, mm0, python3 on one PATH),
        # so a run outside it explains the gap instead of failing — the same
        # discipline as the other tool-absent gates. With $RISCV_MODEL set, the
        # committed statements have to be what the pinned model converts to, and
        # the diff table has to still close over `ISA_REGISTRY`.
        _rv64="$repo_root/scripts/rv64-model-mm0"
        if [ -n "${RISCV_MODEL:-}" ] && [ -x "$_rv64" ] \
            && command -v lean >/dev/null 2>&1 \
            && command -v lean4export >/dev/null 2>&1; then
            if "$_rv64" check >"$_cert_tmp/rv64.log" 2>&1; then
                echo "  [detail] $(grep -E '^[0-9]+ opcodes:' "$_cert_tmp/rv64.log" | tail -1)"
                check "W9.1: the pinned RV64 model converts and mm0-c accepts it" true
            else
                tail -6 "$_cert_tmp/rv64.log" >&2
                check "W9.1: the pinned RV64 model converts and mm0-c accepts it" false
            fi
        else
            gap "W9.1: RV64 model not re-converted (needs the lean shell: run make w9)"
        fi

        # W9.3, refutation half: `load`/`store` do NOT lower to the model's
        # `execute_LOAD`/`execute_STORE`. The emitted forms take an address
        # (and, for store, a value) and return a value or nothing; the model's
        # functions take the architectural operands, read the register file and
        # can return a fault. The check reads the committed `mm0/clif.mm0` and
        # `mm0/statements/rv64_memory.mm0` plus the pinned model source, so the
        # verdict is measured, not retyped. Exit 1 is the interesting case: it
        # means the shapes *agree* now, and the stronger correspondence must be
        # re-argued instead of silently kept.
        # Exit 2 is "the evidence is unavailable": `mem-refines` reads the
        # pinned sail-riscv-lean checkout, which a Nix GC can evict or a fresh
        # clone may never have fetched. That is a missing input, not a verdict
        # about the lowering, so it is reported as an explained gap — an
        # evicted store path must not read as "the shapes now agree".
        if [[ -x "$repo_root/scripts/mem-refines" ]] \
            && command -v nix >/dev/null 2>&1; then
            "$repo_root/scripts/mem-refines" >"$_cert_tmp/mem.log" 2>&1
            _mem_status=$?
            case "$_mem_status" in
                0)
                    echo "  [detail] $(grep -m1 'REFUTED as stated' "$_cert_tmp/mem.log" \
                        | sed 's/^ *//')"
                    check "W9.3: load/store are refuted as the model's execute_LOAD/execute_STORE" true ;;
                2)
                    gap "W9.3: memory correspondence not measured ($(grep -m1 . "$_cert_tmp/mem.log" \
                        | sed 's/^ *//'))" ;;
                *)
                    tail -6 "$_cert_tmp/mem.log" >&2
                    check "W9.3: load/store are refuted as the model's execute_LOAD/execute_STORE" false ;;
            esac
        else
            gap "W9.3: memory correspondence not checked (needs the lean shell and scripts/mem-refines: run make w9)"
        fi

        # U11: the compiler's CPS lowering decides which foreign calls need a
        # generated adapter, and emits the descriptor that drives generation.
        # The golden pins that decision and its canonical text; the umbrella
        # test `the_compilers_emitted_descriptors_parse_here` pins that the
        # generator can read it. Exit 2 means the check could not measure (no
        # `austral` binary), which is a gap, never a pass.
        if [[ -x "$repo_root/scripts/check-adapter-descriptors" ]]; then
            "$repo_root/scripts/check-adapter-descriptors" \
                >"$_cert_tmp/adapters.log" 2>&1
            _adapters_status=$?
            case "$_adapters_status" in
                0) check "U11: the CPS lowering's adapter descriptors match the golden" true ;;
                2) gap "U11: adapter descriptors not measured ($(tail -1 "$_cert_tmp/adapters.log" | sed 's/^ *//'))" ;;
                *) tail -6 "$_cert_tmp/adapters.log" >&2
                   check "U11: the CPS lowering's adapter descriptors match the golden" false ;;
            esac
        else
            gap "U11: adapter descriptors not checked (scripts/check-adapter-descriptors missing)"
        fi

        # The W9.3 statements and their toy model are checked only where the mm0
        # toolchain exists. A host without it must read them as a measurement
        # gap, not as a failure of the artifact — otherwise the baseline gate is
        # red on every machine that lacks mm0-rs, which also makes every drift
        # control that requires a green unmutated baseline unrunnable there.
        if command -v mm0-rs >/dev/null 2>&1 && command -v mm0-c >/dev/null 2>&1; then
            _have_mm0=true
        else
            _have_mm0=false
        fi

        # W9.3, statement half: `mm0/store_projection.mm0` names the claim that
        # survives the refutation, with pinned citations and no assertion. Same
        # discipline as `clif.mm0`: sorts and terms only, so `mm0-c` accepting
        # it means "the obligation is well-formed", never "the obligation
        # holds".
        _proj="$repo_root/mm0/store_projection.mm0"
        if [[ ! -f $_proj ]]; then
            check "W9.3: the memory projection is stated as vocabulary, accepted by mm0-c" false
        elif ! $_have_mm0; then
            gap "W9.3: the memory projection not checked (mm0-rs/mm0-c absent; see docs/lean4mm0.md §5)"
        elif mm0-rs compile "$repo_root/mm0/store_projection.mm1" \
                "$_cert_tmp/store_projection.mmb" >"$_cert_tmp/proj.log" 2>&1 \
            && mm0-c "$_cert_tmp/store_projection.mmb" < "$_proj" \
                >>"$_cert_tmp/proj.log" 2>&1; then
            echo "  [detail] $(grep -m1 'term/def' "$_cert_tmp/proj.log" | sed 's/^ *//')"
            if grep -qE '^(axiom|theorem) ' "$_proj"; then
                echo "  [detail] store_projection.mm0 asserts what it has not proved" >&2
                check "W9.3: the memory projection is stated as vocabulary, accepted by mm0-c" false
            elif ! grep -q '^term store_projects ' "$_proj" \
                || ! grep -q '^term load_projects ' "$_proj"; then
                echo "  [detail] missing a relation symbol" >&2
                check "W9.3: the memory projection is stated as vocabulary, accepted by mm0-c" false
            # The certificate line follows the approval, exactly as `clif.mm0`'s
            # does: `[gap]` while `mm0/approved/` holds no copy, and the copy's
            # name once it does. An approval fixes the statement of record and
            # never the claim, so "cites the approval" here may not replace the
            # vocabulary — the two `term` lines above are what make the artifact
            # a statement at all.
            elif [ -e "$_appr_root/store_projection.stmts" ]; then
                if grep -q '^-- certificate: \[gap\]' "$_proj" \
                        || ! grep -q 'mm0/approved/store_projection.stmts' "$_proj"; then
                    echo "  [detail] $_appr_root/store_projection.stmts exists — its certificate must name it, not a gap" >&2
                    check "W9.3: the memory projection is stated as vocabulary, accepted by mm0-c" false
                else
                    check "W9.3: the memory projection is stated as vocabulary, accepted by mm0-c" true
                fi
            elif grep -q '^-- certificate: \[gap\]' "$_proj"; then
                check "W9.3: the memory projection is stated as vocabulary, accepted by mm0-c" true
            else
                echo "  [detail] no store_projection approval, yet the certificate does not say [gap]" >&2
                check "W9.3: the memory projection is stated as vocabulary, accepted by mm0-c" false
            fi
        else
            sed -n '1,8p' "$_cert_tmp/proj.log" >&2
            check "W9.3: the memory projection is stated as vocabulary, accepted by mm0-c" false
        fi
        # … and its citations must still describe the files they name.
        _proj_cites=$(sed -n 's/^-- cites: \([^ ]*\) sha256=\([0-9a-f]\{64\}\)$/\1 \2/p' "$_proj")
        _proj_n=0
        _proj_bad=""
        while read -r _cpath _cpin; do
            [ -n "$_cpath" ] || continue
            _proj_n=$((_proj_n + 1))
            _cactual="$(sha256sum "$repo_root/$_cpath" 2>/dev/null | cut -d' ' -f1)"
            [ "$_cactual" = "$_cpin" ] || _proj_bad="$_proj_bad $_cpath"
        done <<< "$_proj_cites"
        if [ "$_proj_n" -ge 3 ] && [ -z "$_proj_bad" ]; then
            check "W9.3: the projection's citations still match their artifacts ($_proj_n pinned)" true
        else
            echo "  [detail] stale citations:${_proj_bad:- none} of $_proj_n (expected >= 3)" >&2
            check "W9.3: the projection's citations still match their artifacts" false
        fi
        # … and the toy model must be a model *of this claim*: same four state
        # transformers, and its cite of the claim still current. Otherwise the
        # proof could drift to a different (easier) statement than the one the
        # repository states, which is the failure mode a prover-only gate has.
        _toy="$_mm0/store_projection_toy.mm0"
        _toy_names_ok=true
        for _fn in jit_store_i64 isa_store_w8 jit_load_i64 isa_load_w8; do
            grep -q "^term $_fn " "$_proj" && grep -q "^def $_fn " "$_toy" \
                || _toy_names_ok=false
        done
        _toy_pin="$(sed -n 's/^-- cites: mm0\/store_projection.mm0 sha256=\([0-9a-f]\{64\}\)$/\1/p' "$_toy")"
        # One comparison, two callers: the committed claim below and the drift
        # control after it. Extracting it is what makes the control test *this*
        # rule rather than a paraphrase of it.
        _toy_cite_ok() {   # $1 = the claim file to compare the toy's pin against
            [ -n "$_toy_pin" ] || return 1
            [ "$_toy_pin" = "$(sha256sum "$1" | cut -d' ' -f1)" ]
        }
        if _toy_cite_ok "$_proj" && $_toy_names_ok; then
            check "W9.3: the toy model proves the stated projection, not a neighbour" true
        else
            echo "  [detail] toy/model mismatch: pin ${_toy_pin:-none}, names ok=$_toy_names_ok" >&2
            check "W9.3: the toy model proves the stated projection, not a neighbour" false
        fi
        # … and the pin has to *move*, or it is decoration. The failure it exists
        # for is specific: the claim is edited, nobody re-reads the toy, and the
        # proof goes on certifying a statement the repository no longer makes. So
        # the same comparison is re-run against a copy of the claim with one
        # relation renamed — the toy is untouched in that run — and it must report
        # the pin as stale. A control whose edit failed to apply is itself a
        # failure: it would be comparing the pinned file with itself and passing
        # for the wrong reason.
        _drift_claim="$_cert_tmp/store_projection.drift.mm0"
        sed 's/^term store_projects /term store_projects_drifted /' "$_proj" \
            >"$_drift_claim"
        if cmp -s "$_proj" "$_drift_claim"; then
            echo "  [detail] the drift edit did not apply, so it controls nothing" >&2
            check "W9.3: the toy's citation digest refuses a changed claim" false
        elif _toy_cite_ok "$_drift_claim"; then
            echo "  [detail] a renamed claim still matches the toy's pin" >&2
            check "W9.3: the toy's citation digest refuses a changed claim" false
        else
            check "W9.3: the toy's citation digest refuses a changed claim" true
        fi
        _toy_shape=""
        if ! $_have_mm0; then
            gap "W9.3: the toy projection's theorems not checked (mm0-rs/mm0-c absent; see docs/lean4mm0.md §5)"
        elif mm0-rs compile "$repo_root/mm0/store_projection_toy.mm1" \
                "$_cert_tmp/toy.mmb" >"$_cert_tmp/toy.log" 2>&1 \
            && mm0-c "$_cert_tmp/toy.mmb" < "$_toy" >>"$_cert_tmp/toy.log" 2>&1; then
            _toy_shape="$(grep -m1 'ax/thm' "$_cert_tmp/toy.log" | sed 's/^ *//')"
            echo "  [detail] $_toy_shape"
            if grep -q 'sorry' "$_cert_tmp/toy.log"; then
                check "W9.3: the toy projection's theorems check without sorry" false
            else
                check "W9.3: the toy projection's theorems check without sorry" true
            fi
        else
            sed -n '1,10p' "$_cert_tmp/toy.log" >&2
            check "W9.3: the toy projection's theorems check without sorry" false
        fi
        # A count in prose is a claim like any other, and the one that goes stale
        # first: add a theorem or an axiom and the paragraph describing the file
        # quietly overstates what it used to say. So both counts are pinned in two
        # places that must agree with the files — how many `theorem`/`axiom`
        # declarations the spec carries, how many the proofs carry, and the single
        # `toy theorem count: N` / `toy axiom count: N` line in the plan and in
        # AGENTS.md. Any disagreement is a failure, because either the prose
        # describes an older file or a proof went missing.
        _toy_proofs="$repo_root/mm0/store_projection_toy.mm1"
        _toy_counts=""
        _toy_counts_bad=""
        for _kind in theorem axiom; do
            case "$_kind" in
                theorem)
                    _spec="$(grep -c '^theorem ' "$_toy")"
                    _proof="$(grep -c '^pub theorem ' "$_toy_proofs")" ;;
                axiom)
                    _spec="$(grep -c '^axiom ' "$_toy")"
                    _proof="$(grep -c '^axiom ' "$_toy_proofs")" ;;
            esac
            _toy_counts="$_toy_counts $_kind=$_spec"
            if [ "$_spec" -le 0 ] || [ "$_spec" != "$_proof" ]; then
                _toy_counts_bad="$_toy_counts_bad file/$_kind(declares $_spec, proves $_proof)"
            fi
            for _doc in "$repo_root/PLAN_sota_kernel_verification.md" "$repo_root/AGENTS.md"; do
                _doc_n="$(grep -i "toy $_kind count:" "$_doc" \
                    | sed "s/.*[Tt]oy $_kind count: *\([0-9][0-9]*\).*/\1/" \
                    | sort -u | tr '\n' ' ')"
                if [ "$_doc_n" != "$_spec " ]; then
                    _toy_counts_bad="$_toy_counts_bad $(basename "$_doc")/$_kind(says $(printf '%s' "${_doc_n:-nothing}" | sed 's/ *$//;s/ /+/g')|file says $_spec)"
                fi
            done
        done
        if [ -z "$_toy_counts_bad" ]; then
            _thm_n="$(grep -c '^theorem ' "$_toy")"
            _ax_n="$(grep -c '^axiom ' "$_toy")"
            check "W9.3: the toy's theorem and axiom counts agree with the plan and AGENTS ($_thm_n theorem(s), $_ax_n axiom(s))" true
        else
            echo "  [detail] counts:$_toy_counts disagree:$_toy_counts_bad" >&2
            check "W9.3: the toy's theorem and axiom counts agree with the plan and AGENTS" false
        fi
        # The figures the plan quotes for the toy's *shape* are pinned to the
        # compiler's own count rather than to a recount by hand, because the two
        # disagree in a way that is easy to miss: `mm0-rs` counts
        # `provable sort Prop` as a sort and `grep '^sort '` does not, so a hand
        # count pins 2 sorts and is wrong from the first line. Whatever `mm0-rs`
        # prints is the authority — and it is pinned at *every* site that quotes
        # it: the §3.5 transcript's `[detail]` line and its `[pass]` line, the
        # bullet in the plan and in AGENTS, and the prose that summarises what
        # the theorems are. One anchor is how a retired figure survives — the
        # toy's term/def count already grew once when the width-4 definitions
        # landed, and repairing the bullet while leaving the transcript alone
        # keeps the gate green while the measurement line quotes an older file.
        if [ -n "$_toy_shape" ]; then
            _shape_bad=""
            while IFS='|' read -r _doc _site; do
                [ -n "$_site" ] || continue
                case "$_doc" in
                    PLAN) _path="$repo_root/PLAN_sota_kernel_verification.md" ;;
                    AGENTS) _path="$repo_root/AGENTS.md" ;;
                esac
                grep -qF -- "$_site" "$_path" \
                    || _shape_bad="$_shape_bad $(basename "$_path")[$(printf '%s' "$_site" | cut -c1-28)]"
            done <<EOF
PLAN|  [detail] $_toy_shape
PLAN|counts ($_toy_shape)
PLAN|Toy shape: $_toy_shape
PLAN|\`$_toy_shape\`
AGENTS|Toy shape: $_toy_shape
AGENTS|\`$_toy_shape\`
EOF
            if [ -z "$_shape_bad" ]; then
                check "W9.3: the toy's shape figures match what mm0-rs counts ($_toy_shape)" true
            else
                echo "  [detail] shape: mm0-rs says '$_toy_shape'; stale in:$_shape_bad" >&2
                check "W9.3: the toy's shape figures match what mm0-rs counts" false
            fi
        else
            gap "W9.3: the toy's shape figures not compared (no mm0-rs measurement here)"
        fi
        # Negative control: the proofs must depend on the axioms they cite.
        # A theorem that checks after its axiom has been falsified is provable
        # from something else, which would make the file prove less than its
        # header says — so mutate each axiom's conclusion and require `mm0-rs`
        # to refuse, naming the theorem that used to rely on it. This is the
        # mutation a prover-only check cannot do for itself: `mm0-c` compares
        # statements against the artifacts, and by construction the mutated
        # file is *not* the artifact.
        _toy_src="$(cat "$repo_root/mm0/store_projection_toy.mm1")"
        _mut_ok=true
        _mut_seen=""
        _mut_n=0
        # "<old conclusion>|<new conclusion>|<theorem that must now fail>"
        while IFS='|' read -r _mut_from _mut_to _mut_victim; do
            [ -n "$_mut_from" ] || continue
            # No mm0-rs means no mutation run; the gap is reported below rather
            # than letting an absent tool look like a surviving mutation.
            $_have_mm0 || continue
            _mut_n=$((_mut_n + 1))
            _mut_file="$_cert_tmp/toy-mut$_mut_n.mm1"
            _mut_text="${_toy_src/$_mut_from/$_mut_to}"
            if [ "$_mut_text" = "$_toy_src" ]; then
                # The mutation not applying is itself a finding: the axiom the
                # control assumes is gone, so the control proves nothing.
                _mut_ok=false
                _mut_seen="$_mut_seen $_mut_victim(mutation did not apply)"
                continue
            fi
            printf '%s\n' "$_mut_text" > "$_mut_file"
            if mm0-rs compile "$_mut_file" "$_cert_tmp/toy-mut$_mut_n.mmb" \
                    >"$_cert_tmp/toy-mut$_mut_n.log" 2>&1; then
                _mut_ok=false
                _mut_seen="$_mut_seen $_mut_victim(still-checks)"
            elif grep -q "$_mut_victim" "$_cert_tmp/toy-mut$_mut_n.log"; then
                _mut_seen="$_mut_seen $_mut_victim(refused)"
            else
                _mut_ok=false
                _mut_seen="$_mut_seen $_mut_victim(refused, but not at that theorem)"
            fi
        done <<'MUTATIONS'
$ veq (get (put m a v) a) v $|$ veq (get (put m a v) a) (get m a) $|toy_jit_store_visible
$ veq (get (put m a v) b) (get m b) $|$ veq (get (put m a v) b) unset $|toy_jit_store_load_other
$ veq x z $|$ veq x x $|toy_jit_two_cells_preserved
$ veq (get (put (put (put (put m x vx) y vy) z vz) w vw) x) unset $|$ veq (get (put (put (put (put m x vx) y vy) z vz) w vw) x) vx $|toy_jit_fourth_store_drops_oldest
$ veq (get (put (put (put (put m x vx) y vy) z vz) w vw) y) vy $|$ veq (get (put (put (put (put m x vx) y vy) z vz) w vw) y) vx $|toy_jit_recent_cells_readable
$ notfull (put (put init a va) b vb) $|$ notfull init $|toy_jit_third_store_kept
$ veq (get (put m x w) y) (get m y) $|$ veq (get (put m x w) y) unset $|toy_jit_refresh_keeps_other_cell
$ held (put m a v) a $|$ held (put m a v) v $|toy_jit_refresh_keeps_other_cell
$ notfull (put init a v) $|$ notfull init $|toy_jit_two_cells_preserved
$ held (put m x w) y $;|$ held (put m x w) x $;|toy_jit_refresh_keeps_held_cells
$ held m y $;|$ held init y $;|toy_jit_refresh_no_new_held
$ veq (narrow4 x) (narrow4 y) $|$ veq (narrow4 x) x $|toy_width4_load_after_wide_store
$ veq (narrow4 (narrow4 x)) (narrow4 x) $|$ veq (narrow4 (narrow4 x)) x $|toy_width4_store_load_roundtrip
MUTATIONS
        if ! $_have_mm0; then
            gap "W9.3: the toy's proofs not mutation-tested (mm0-rs absent; see docs/lean4mm0.md §5)"
        elif $_mut_ok && [ "$_mut_n" -eq 13 ]; then
            echo "  [detail] mutations refused:$(echo "$_mut_seen" | tr ' ' '\n' | sed '/^$/d' | sed 's/^/ /' | paste -sd, -)" >&2
            check "W9.3: the toy's proofs depend on its axioms (mutating one refuses them)" true
        else
            echo "  [detail] mutations:${_mut_seen:- none applied} ($_mut_n of 13)" >&2
            check "W9.3: the toy's proofs depend on its axioms (mutating one refuses them)" false
        fi

        # The axioms are consistent because a concrete model satisfies them, and
        # that model lives in the toy's header as prose. `scripts/toy-witness`
        # runs it instead: every axiom, universally quantified, over all memories
        # of at most two cells and a small atom domain, plus the three candidates
        # the toy rejected — each of which must fail there, or the guard it was
        # given was unnecessary and the rejection was wrong. This is exhaustive
        # over a finite domain, not a proof over an arbitrary `Val` (the file's
        # header says so); what it buys is that the witness is executed rather
        # than asserted, which is how `put_notfull` would have been caught.
        _wit_rc=-1
        if command -v rustc >/dev/null 2>&1; then
            _wit_rc=0
            "$repo_root/scripts/toy-witness" >"$_cert_tmp/witness.log" 2>&1 || _wit_rc=$?
        fi
        if [ "$_wit_rc" -eq 0 ]; then
            echo "  [detail] $(tail -1 "$_cert_tmp/witness.log")"
            check "W9.3: the toy's axioms hold in a concrete model (no counterexample)" true
        elif [ "$_wit_rc" -ge 0 ] && [ "$_wit_rc" -ne 2 ]; then
            grep -E '^\[FAIL\]' "$_cert_tmp/witness.log" >&2 \
                || tail -5 "$_cert_tmp/witness.log" >&2
            check "W9.3: the toy's axioms hold in a concrete model (no counterexample)" false
        else
            gap "W9.3: toy axioms not run against a concrete model (the witness could not be built here)"
        fi
        # A new axiom must be *checked*, not just declared: the names the witness
        # proves are compared with the names the artifact carries, so adding an
        # axiom to the `.mm0` without teaching the model about it is red.
        # `_wit_rc -eq 0`, not a non-empty log: a witness that could not be built
        # leaves a linker error there, and comparing against it would read as
        # "the witness holds no axioms" — a content failure where none was
        # measured (the `lean` shell, 2026-11-21).
        _ax_file=""
        if [ "$_wit_rc" -eq 0 ] && [ -s "$_cert_tmp/witness.log" ]; then
            _ax_file="$(sed -n 's/^axiom \([a-z0-9_]*\).*/\1/p' "$_toy" | sort)"
            _ax_wit="$(sed -n 's/^\[hold\]  *\([a-z0-9_]*\).*/\1/p' \
                "$_cert_tmp/witness.log" | sort)"
            _ax_n="$(printf '%s\n' "$_ax_file" | grep -c . || true)"
            if [ "$_ax_n" -gt 0 ] && [ "$_ax_file" = "$_ax_wit" ]; then
                check "W9.3: the witness exercises all $_ax_n axioms the toy declares" true
            else
                echo "  [detail] axioms: artifact=[$(echo "$_ax_file" | tr '\n' ' ')]" \
                     "witness=[$(echo "$_ax_wit" | tr '\n' ' ')]" >&2
                check "W9.3: the witness exercises every axiom the toy declares" false
            fi
        else
            gap "W9.3: the witness's axiom list not compared (the witness could not be built here)"
        fi

        # The enumeration's own regression: the same verdicts at a larger domain.
        # This used to be a remembered measurement ("`--domain 5` gives the
        # identical verdict"), which is a claim about the *enumeration* rather than
        # about the model — the model rows and all six refutations must not change
        # verdict when the domain grows, or the instance set is what produced them.
        # One extra domain, not a sweep: ~72 s here, and a sweep would prove
        # nothing the Lean proof does not already cover.
        _w5_rc=-1
        if command -v rustc >/dev/null 2>&1; then
            _w5_rc=0
            "$repo_root/scripts/toy-witness" --domain 5 >"$_cert_tmp/witness-d5.log" 2>&1 \
                || _w5_rc=$?
        fi
        if [ "$_w5_rc" -eq 2 ] || [ "$_w5_rc" -lt 0 ]; then
            gap "W9.3: the domain-5 regression not run (the witness could not be built here)"
        elif [ "$_w5_rc" -eq 0 ] && [ "$_wit_rc" -eq 0 ] \
                && grep -q '20/20 axioms hold in the witness; 6/6 rejected candidates fail as they must' \
                    "$_cert_tmp/witness-d5.log" \
                && [ "$(sed -n 's/^\[\(hold\|reject\|model\)\]  *\([a-z0-9_]*\).*/\1 \2/p' \
                        "$_cert_tmp/witness-d5.log" | sort)" \
                   = "$(sed -n 's/^\[\(hold\|reject\|model\)\]  *\([a-z0-9_]*\).*/\1 \2/p' \
                        "$_cert_tmp/witness.log" | sort)" ]; then
            echo "  [detail] $(head -1 "$_cert_tmp/witness-d5.log")"
            check "W9.3: the witness's verdicts do not change when the domain grows (27 rows at 4 and 5 atoms)" true
        else
            diff <(sed -n 's/^\[\(hold\|reject\|model\)\]  *\([a-z0-9_]*\).*/\1 \2/p' \
                    "$_cert_tmp/witness.log" | sort) \
                 <(sed -n 's/^\[\(hold\|reject\|model\)\]  *\([a-z0-9_]*\).*/\1 \2/p' \
                    "$_cert_tmp/witness-d5.log" | sort) >&2 || true
            tail -3 "$_cert_tmp/witness-d5.log" >&2 || true
            check "W9.3: the witness's verdicts do not change when the domain grows" false
        fi

        # The same axioms once more, in Lean (`mm0/toy_witness/ToyWitness.lean`):
        # same model, but there a *proof* over an arbitrary atom type rather than
        # an enumeration over a fixed one, and the candidates the toy rejected are
        # *theorems about their negations* rather than counterexample strings
        # printed by a program I wrote. Two checkers on one model is the point —
        # they fail differently, and a wrong reading of an `if` in one does not
        # reproduce in the other.
        if command -v lean >/dev/null 2>&1; then
            _lean_rc=0
            lean "$repo_root/mm0/toy_witness/ToyWitness.lean" \
                >"$_cert_tmp/leanwit.log" 2>&1 || _lean_rc=$?
            _lean_ax="$(sed -n 's/^lean-witness-axioms: //p' "$_cert_tmp/leanwit.log" | tr ',' '\n' | sort)"
            _lean_br="$(sed -n 's/^lean-witness-broken: //p' "$_cert_tmp/leanwit.log" | tr ',' '\n' | sort)"
            if [ -z "$_ax_file" ]; then
                gap "W9.3: the Lean axiom list not compared (the witness could not be built here)"
            elif [ "$_lean_rc" -eq 0 ] && [ -n "$_lean_ax" ] && [ "$_lean_ax" = "$_ax_file" ]; then
                echo "  [detail] $(grep -m1 '^lean-witness: ' "$_cert_tmp/leanwit.log")"
                check "W9.3: a Lean development proves the same $(printf '%s\n' "$_lean_ax" | grep -c .) axioms" true
            else
                grep -E 'error' "$_cert_tmp/leanwit.log" | head -5 >&2
                echo "  [detail] lean axioms vs artifact: [$(echo "$_lean_ax" | tr '\n' ' ')]" >&2
                check "W9.3: a Lean development proves the same axioms" false
            fi
            # The artifact's *theorems*, not just its axioms: the Lean file proves
            # each of the toy's 28 too, from the same axioms, so the same drift
            # control applies in this direction. Both lists must be equal as sets
            # (a theorem added to the artifact and not proved here is red, and so
            # is a name here that the artifact does not declare), and the number
            # of `theorem toy_…` declarations in the file must equal the length of
            # the printed list — otherwise a theorem could be missing while the
            # list, which is a literal, still claimed it.
            _lean_thm="$(sed -n 's/^lean-witness-theorems: //p' "$_cert_tmp/leanwit.log" | tr ',' '\n' | sort)"
            _thm_file="$(grep -oE '^theorem toy_[a-z0-9_]*' "$_toy" | sed 's/^theorem //' | sort)"
            _lean_decl_n="$(grep -c '^theorem toy_' "$repo_root/mm0/toy_witness/ToyWitness.lean")"
            if [ -n "$_lean_thm" ] && [ "$_lean_thm" = "$_thm_file" ] \
                    && [ "$_lean_decl_n" -eq "$(printf '%s\n' "$_lean_thm" | grep -c .)" ]; then
                check "W9.3: the Lean development proves the toy's $(printf '%s\n' "$_lean_thm" | grep -c .) theorems too" true
            else
                echo "  [detail] theorems: artifact=[$(echo "$_thm_file" | tr '\n' ' ')]" \
                     "lean=[$(echo "$_lean_thm" | tr '\n' ' ')] declarations=$_lean_decl_n" >&2
                check "W9.3: the Lean development proves the toy's theorems too" false
            fi

            # The *trust base*, printed: `#print axioms` for all 48 audited
            # declarations (the toy's 28 theorems and the 20 axiom-statement
            # theorems). Nothing here may name an axiom outside Lean's standard
            # foundation — `sorryAx` would show up in this list, and so would any
            # principle a later edit introduced — and all 48 must be audited, so a
            # declaration dropped from the audit is red rather than silently
            # unaudited. Same shape as hydro's `Hydro/AxCheck.lean`, same allowed
            # set; the difference is that there the axioms are declared, and here
            # every artifact axiom is a theorem.
            _lean_audited_n="$(grep -cE "depends on axioms:|does not depend on any axioms" \
                "$_cert_tmp/leanwit.log" || true)"
            _lean_audit_decl_n="$(grep -c '^#print axioms ' \
                "$repo_root/mm0/toy_witness/ToyWitness.lean" || true)"
            _lean_axnames="$(grep -oE '\[[^]]*\]' "$_cert_tmp/leanwit.log" \
                | tr -d '[]' | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep -v '^$' \
                | sort -u | grep -vxE 'propext|Classical.choice|Quot.sound' || true)"
            if [ "${_lean_audited_n:-0}" -eq "${_lean_audit_decl_n:-0}" ] \
                    && [ -n "$_lean_audit_decl_n" ] && [ -z "$_lean_axnames" ]; then
                check "W9.3: every Lean declaration rests on Lean's standard foundation only ($_lean_audited_n audited)" true
            else
                echo "  [detail] trust base: audited=$_lean_audited_n of $_lean_audit_decl_n," \
                     "outside {propext, Classical.choice, Quot.sound}: [$(echo "$_lean_axnames" | tr '\n' ' ')]" >&2
                check "W9.3: every Lean declaration rests on Lean's standard foundation only" false
            fi

            # A textual rule the kernel audit cannot cover: `#print axioms` only
            # reports on the 48 declarations named in the audit, so a `sorry` in a
            # lemma nobody prints — dead code, a helper that a later edit stops
            # using — would elaborate and be invisible. So the *code* is scanned
            # too, after stripping comments, for `sorry`, `admit`, `native_decide`
            # and `ofReduceBool`. Comments have to be stripped or the audit's own
            # paragraph (which names `sorryAx` to explain itself) would trip it;
            # Lean block comments nest, so this is a small lexer rather than a
            # `sed` one-liner, and a missing interpreter is a gap rather than a
            # pass. Newlines inside comments are kept so a hit's line number is
            # the file's, which makes `refused@N` readable in the detail.
            _lean_scan() {
                # $1 = file; prints "<line>:<code line>" for banned tokens in code
                python3 - "$1" <<'PYSTRIP' \
                    | grep -nE '\b(sorry|admit|native_decide|ofReduceBool)\b' || true
import sys
src = open(sys.argv[1]).read()
out = []
i = 0
depth = 0
while i < len(src):
    if src.startswith("/-", i):
        depth += 1
        i += 2
        continue
    if depth and src.startswith("-/", i):
        depth -= 1
        i += 2
        continue
    if depth:
        if src[i] == "\n":
            out.append("\n")
        i += 1
        continue
    if src.startswith("--", i):
        nl = src.find("\n", i)
        i = len(src) if nl < 0 else nl
        continue
    out.append(src[i])
    i += 1
sys.stdout.write("".join(out))
PYSTRIP
            }
            if ! command -v python3 >/dev/null 2>&1; then
                gap "W9.3: the Lean file's code not scanned for sorry/native_decide (no python3 here)"
            else
                _lean_banned="$(_lean_scan "$repo_root/mm0/toy_witness/ToyWitness.lean")"
                if [ -z "$_lean_banned" ]; then
                    check "W9.3: the Lean file's code carries no sorry/admit/native_decide/ofReduceBool" true
                else
                    printf '%s\n' "$_lean_banned" | head -5 >&2
                    check "W9.3: the Lean file's code carries no sorry/admit/native_decide/ofReduceBool" false
                fi

                # Mutation controls, both directions. A scan that never fires is
                # indistinguishable from a clean file, so a `sorry` is injected
                # into a scratch copy — and Lean is asked to accept that copy, to
                # show the textual scan is load-bearing rather than a second way
                # of saying what elaboration already said. The reverse control
                # injects the same words inside comments only: any hit there is a
                # false positive and fails too.
                _lean_ctrl="$_cert_tmp/lean-scan-control"
                mkdir -p "$_lean_ctrl"
                _lean_lines="$(grep -c '' "$repo_root/mm0/toy_witness/ToyWitness.lean")"
                { cat "$repo_root/mm0/toy_witness/ToyWitness.lean"
                  printf 'theorem scan_control_injected : True := by sorry\n'
                } >"$_lean_ctrl/injected.lean"
                { cat "$repo_root/mm0/toy_witness/ToyWitness.lean"
                  printf -- '-- sorry admit native_decide ofReduceBool\n'
                  printf -- '/- sorry /- admit -/ native_decide ofReduceBool -/\n'
                } >"$_lean_ctrl/commented.lean"
                _inj_hits="$(_lean_scan "$_lean_ctrl/injected.lean")"
                _com_hits="$(_lean_scan "$_lean_ctrl/commented.lean")"
                _inj_rc=0
                lean "$_lean_ctrl/injected.lean" >"$_lean_ctrl/injected.log" 2>&1 || _inj_rc=$?
                _com_rc=0
                lean "$_lean_ctrl/commented.lean" >"$_lean_ctrl/commented.log" 2>&1 || _com_rc=$?
                _inj_line="$((_lean_lines + 1))"
                if [ "$_inj_rc" -eq 0 ] && [ "$(printf '%s\n' "$_inj_hits" | grep -c '^[0-9]*:')" -eq 1 ] \
                        && printf '%s\n' "$_inj_hits" | grep -q "^${_inj_line}:.*scan_control_injected"; then
                    echo "  [detail] injected sorry at line $_inj_line: lean accepted the file (exit 0)," \
                         "the scan refused it" >&2
                    check "W9.3: the no-sorry scan refuses an injected sorry that Lean itself accepts" true
                else
                    echo "  [detail] lean exit=$_inj_rc, hits=[$(printf '%s' "$_inj_hits" | tr '\n' ';')]" \
                         "expected one hit at line $_inj_line" >&2
                    check "W9.3: the no-sorry scan refuses an injected sorry that Lean itself accepts" false
                fi
                if [ "$_com_rc" -eq 0 ] && [ -z "$_com_hits" ]; then
                    check "W9.3: the no-sorry scan does not count banned words inside comments" true
                else
                    echo "  [detail] lean exit=$_com_rc, hits=[$(printf '%s' "$_com_hits" | tr '\n' ';')]" >&2
                    check "W9.3: the no-sorry scan does not count banned words inside comments" false
                fi
            fi
            if [ "$_wit_rc" -ne 0 ] || [ ! -s "$_cert_tmp/witness.log" ]; then
                gap "W9.3: rejected-candidate cross-check not run (the witness could not be built here)"
            else
                _rust_br="$(sed -n 's/^\[reject\]  *\([a-z0-9_]*\).*/\1/p' "$_cert_tmp/witness.log" | sort)"
                if [ -n "$_lean_br" ] && [ "$_lean_br" = "$_rust_br" ]; then
                    check "W9.3: both witnesses reject the same candidates" true
                else
                    echo "  [detail] rejected: lean=[$(echo "$_lean_br" | tr '\n' ' ')]" \
                         "rust=[$(echo "$_rust_br" | tr '\n' ' ')]" >&2
                    check "W9.3: both witnesses reject the same candidates" false
                fi
            fi
        else
            gap "W9.3: the Lean witness proofs not checked (lean not on PATH)"
        fi

            # Negative control on the Lean side, the analogue of the mm0 one
            # above: the same *model* edits that make the artifact's proofs fail
            # must make this file fail. A file that still elaborates after
            # `take 3` becomes `take 4` is not proving the capacity it says it
            # is, however many theorems it prints. Attribution is by line: the
            # mutation must apply, the file must be refused, and the first error
            # must be *below* the mutated definition — an error on the edited
            # line itself would mean the edit broke the syntax rather than the
            # proof, which is a defect in the control, not evidence about the
            # model.
            if command -v lean >/dev/null 2>&1 \
                    && [ -f "$repo_root/mm0/toy_witness/ToyWitness.lean" ]; then
                _lean_src="$(cat "$repo_root/mm0/toy_witness/ToyWitness.lean")"
                _lmut_ok=true
                _lmut_seen=""
                _lmut_n=0
                while IFS='|' read -r _lmut_from _lmut_to _lmut_note; do
                    [ -n "$_lmut_from" ] || continue
                    _lmut_n=$((_lmut_n + 1))
                    _lmut_file="$_cert_tmp/lean-mut$_lmut_n.lean"
                    _lmut_text="${_lean_src/$_lmut_from/$_lmut_to}"
                    if [ "$_lmut_text" = "$_lean_src" ]; then
                        _lmut_ok=false
                        _lmut_seen="$_lmut_seen $_lmut_note(edit-did-not-apply)"
                        continue
                    fi
                    printf '%s\n' "$_lmut_text" >"$_lmut_file"
                    _lmut_line="$(printf '%s\n' "$_lean_src" | grep -nF -- "$_lmut_from" \
                        | head -1 | cut -d: -f1)"
                    if lean "$_lmut_file" >"$_cert_tmp/lean-mut$_lmut_n.log" 2>&1; then
                        _lmut_ok=false
                        _lmut_seen="$_lmut_seen $_lmut_note(still-checks)"
                        continue
                    fi
                    _lmut_err="$(grep -oE ':[0-9]+:[0-9]+: error' "$_cert_tmp/lean-mut$_lmut_n.log" \
                        | head -1 | cut -d: -f2)"
                    if [ -z "$_lmut_err" ]; then
                        _lmut_ok=false
                        _lmut_seen="$_lmut_seen $_lmut_note(refused-without-error-line)"
                    elif [ "$_lmut_err" -le "$_lmut_line" ]; then
                        _lmut_ok=false
                        _lmut_seen="$_lmut_seen $_lmut_note(refused-at-edited-line)"
                    else
                        _lmut_seen="$_lmut_seen $_lmut_note(refused@$_lmut_err)"
                    fi
                done <<'LEANMUT'
((a, v) :: drop a m).take 3|((a, v) :: drop a m).take 4|put-no-truncation
if c.1 = a then drop a t else c :: drop a t|if c.1 = a then c :: drop a t else c :: drop a t|drop-keeps-written-address
abbrev notfullL {α : Type} (m : Mem α) : Prop := m.length < 3|abbrev notfullL {α : Type} (m : Mem α) : Prop := m.length < 4|notfull-weakened-to-four
⟨x.val % 2, Nat.lt_of_lt_of_le (Nat.mod_lt _ (by omega)) hn⟩|⟨x.val, x.isLt⟩|narrow4-becomes-identity
def keep (m : Cap α) (_a _v : α) : Cap α := m|def keep (m : Cap α) (a v : α) : Cap α := put m a v|keep-order-becomes-put
LEANMUT
                if $_lmut_ok && [ "$_lmut_n" -eq 5 ]; then
                    echo "  [detail] lean mutations refused:$(echo "$_lmut_seen" | tr ' ' '\n' | sed '/^$/d' | sed 's/^/ /' | paste -sd, -)" >&2
                    check "W9.3: the Lean model's proofs depend on its definitions (mutating one refuses them)" true
                else
                    echo "  [detail] lean mutations:${_lmut_seen:- none applied} ($_lmut_n of 5)" >&2
                    check "W9.3: the Lean model's proofs depend on its definitions (mutating one refuses them)" false
                fi
            fi

        # W6: the generated probe is a test, and it has to actually run.
        if command -v cc >/dev/null 2>&1; then
            if cc -O2 -o "$_cert_tmp/probe" "$_cert_tmp/flux1d_probe.c" -lm \
                >"$_cert_tmp/cc.log" 2>&1 \
                && "$_cert_tmp/probe" >"$_cert_tmp/probe.log" 2>&1; then
                echo "  [detail] $(tail -1 "$_cert_tmp/probe.log")"
                check "W6: generated C probe compiles and passes at tolerance 1e-8" true
            else
                tail -3 "$_cert_tmp/cc.log" "$_cert_tmp/probe.log" 2>/dev/null >&2
                check "W6: generated C probe compiles and passes at tolerance 1e-8" false
            fi
        else
            gap "W6: generated C probe not run (no cc on PATH)"
        fi
    else
        tail -4 "$_cert_tmp/emit.log" >&2
        check "W2/W5/W6: flux1d certificate and probe re-emit byte-identically and mm0 re-accepts it" false
    fi
    rm -rf "$_cert_tmp"
fi

# W6: no artifact may upgrade a float path to a proof. A certificate that said
# "proved" next to a float line would be claiming more than mm0-c checked.
_bad_claims=""
for _art in "$repo_root"/mm0/*_certificate.mm0; do
    [ -e "$_art" ] || continue
    _hit="$(grep -i "float" "$_art" \
        | grep -i "proved" \
        | grep -vi "not proved\|unproved\|tested-not-proved" || true)"
    [ -n "$_hit" ] && _bad_claims="$_bad_claims$_art: $_hit"$'\n'
done
if [ -n "$_bad_claims" ]; then
    printf '%s' "$_bad_claims" >&2
    check "W6: no certificate claims a float path is proved" false
else
    check "W6: no certificate claims a float path is proved" true
fi
check_py "W2/W4: au2mm0 self-test (weakened scheme, division, false obligation and unpinned assumption all refused)" \
    python3 "$repo_root/scripts/au2mm0" selftest

# --- W1: the flux1d spec surface compiles and its obligations hold at a point ---
# The point test is not the proof; the certificate is. It is gated anyway because
# it is the only check that the *execution* side of the spec surface is still the
# module the obligations talk about. Built through `--use-cps-jit` on purpose:
# that is the path whose CPS bytes the certificate fingerprint records, so the
# gate fails if the kernel stops lowering or the JIT stops executing it.
_flux_dir="$repo_root/examples/verified-kernel/flux1d"
if [ -x "$repo_root/austral" ] && [ -f "$_bridge_so" ]; then
    _flux_tmp="$(mktemp -d)"
    if LD_LIBRARY_PATH="$_bridge_dir:$repo_root" "$repo_root/austral" compile \
            "$_flux_dir/Flux1d.aui,$_flux_dir/Flux1d.aum" \
            --entrypoint=Flux1d:main --use-cps-jit \
            --output="$_flux_tmp/flux1d" \
            >"$_flux_tmp/log" 2>&1 \
       && "$_flux_tmp/flux1d"; then
        check "W1: Flux1d compiles through the CPS JIT and its four obligations hold at the example state" true
    else
        tail -5 "$_flux_tmp/log" >&2
        check "W1: Flux1d compiles through the CPS JIT and its four obligations hold at the example state" false
    fi
    rm -rf "$_flux_tmp"
else
    gap "W1: Flux1d not built here (repo-root austral binary or the cranelift bridge .so is absent)"
fi

# The obligations are decided twice (symbolic expansion + exact sampling) and
# the tool refuses a weakened scheme or a division; `emit` refuses until the
# ring-normalization prover exists, which is what keeps it from writing an
# unchecked statement.
check_py "W2: au2mm0 decides Flux1d's four obligations (both routes agree, hypothesis eliminated by substitution)" \
    python3 "$repo_root/scripts/au2mm0" check \
    "$repo_root/examples/verified-kernel/flux1d/flux1d.obligations.json"


# --- W3: approved statements, held out ---
#
# `verify` above regenerates each statement from the same export it verifies, so
# a weakened definition is reproduced faithfully and the drift gate cannot see
# it. The comparator closes that hole by diffing the regenerated statement
# stream against a file a human approved in a commit that touched only
# mm0/approved/, and by pinning the dependency closure and the theory hashes.
#
# An artifact with no approval is a [gap], never a silent pass: the point is to
# make "nobody has looked at this statement yet" visible in the gate's output
# rather than indistinguishable from "it was checked".
# How many statements an artifact holds out right now, measured by the
# comparator's own `--dry-run` — the output an owner reviews before approving.
# Empty (not 0) when it cannot be measured here, so a caller prints `?` rather
# than a number that would read as "nothing to approve".
w3_measure() {
    local stem="$1" out n
    command -v python3 >/dev/null 2>&1 || return 0
    out="$( cd "$repo_root" && python3 scripts/mm0-comparator approve --dry-run "$stem" 2>&1 )"
    n="$(printf '%s\n' "$out" \
        | sed -n "s/.*would approve $stem — \([0-9][0-9]*\) statement.*/\1/p" | head -1)"
    if [ -z "$n" ]; then
        # *Why* an artifact does not re-derive is the difference between "the tool
        # is missing here" and "its emitter refuses", and only the second is a
        # finding about the artifact. Keep the first line the comparator printed
        # so the check below can quote it instead of reporting a bare absence.
        # A file, not a variable: the caller reads this through a command
        # substitution, so anything assigned here would die with the subshell.
        printf '%s\n' "$stem($(printf '%s\n' "$out" \
            | grep -v '^mm0-comparator: would approve' | sed -n '1p' | cut -c1-110))" \
            >>"$_w3_why_file"
    fi
    printf '%s' "$n"
}

_plan_file="${AUSTRALVM_PLAN:-$repo_root/PLAN_sota_kernel_verification.md}"

if [ -f "$repo_root/scripts/mm0-comparator" ]; then
    # The emitter cell is checked *before* the state cell is read. `liquid_split`
    # (2026-11-21) is why: it reached this gate as a row naming
    # `scripts/liquid-split-mm0 check` while that script existed in no commit, and
    # the failure that named the absent file arrived only after the checks that
    # read the row's `state` — so the first line a reader met was "its artifact
    # does not re-derive here", which reads like a broken generator rather than
    # "the command it names is not in the tree". The table is the owner's next
    # decision, so the command that would make it is what the row must be able
    # to name. The full comparison against `EMITTERS` is below and unchanged;
    # this is the existence half, and it runs first.
    _w3_early="$(awk -F'|' '
        /^[ \t]*\|[ \t]*`mm0\/[A-Za-z0-9_]+\.mm0`[ \t]*\|/ {
            path = $2; cell = $5
            gsub(/^[ \t]+|[ \t]+$/, "", path)
            gsub(/^[ \t]+|[ \t]+$/, "", cell)
            sub(/^`mm0\//, "", path); sub(/\.mm0`$/, "", path)
            print path "\t" cell
        }' "$_plan_file")"
    _w3_early_bad=""
    _w3_early_n=0
    while IFS="$(printf '\t')" read -r _s_stem _s_cell; do
        [ -n "$_s_stem" ] || continue
        _w3_early_n=$((_w3_early_n + 1))
        case "$_s_cell" in
            none*) ;;
            '`'*'`'*)
                _s_cmd="$(printf '%s' "$_s_cell" | sed -n 's/^`\([^`]*\)`.*/\1/p')"
                _s_script="${_s_cmd%% *}"
                if [ -z "$_s_script" ]; then
                    _w3_early_bad="$_w3_early_bad $_s_stem(emitter cell has an empty command)"
                elif [ ! -f "$repo_root/$_s_script" ]; then
                    _w3_early_bad="$_w3_early_bad $_s_stem(names '$_s_script', which does not exist)"
                elif [ ! -x "$repo_root/$_s_script" ]; then
                    _w3_early_bad="$_w3_early_bad $_s_stem(names '$_s_script', which is not executable)"
                fi
                ;;
            *)
                _w3_early_bad="$_w3_early_bad $_s_stem(emitter cell names no command and does not say none)"
                ;;
        esac
    done <<EOF
$_w3_early
EOF
    if [ "$_w3_early_n" -eq 0 ]; then
        check "W3: §W3 emitter cells not checked before their state (no row carries one)" false
    elif [ -z "$_w3_early_bad" ]; then
        check "W3: every §W3 row's emitter script exists before its state cell is read ($_w3_early_n row(s))" true
    else
        echo "  [detail] §W3 emitter scripts:${_w3_early_bad}" >&2
        check "W3: every §W3 row's emitter script exists before its state cell is read" false
    fi
    _w3_line=""
    _w3_pairs=""
    _w3_ok=""
    # `_cert_tmp` is deleted once the W6 certificate probes are done with it, so
    # the directory is recreated for the reasons collected below.
    _w3_why_file="$_cert_tmp/w3-unmeasurable.log"
    mkdir -p "$_cert_tmp"
    : >"$_w3_why_file"
    for _art in "$repo_root"/mm0/*.mm0; do
        [ -e "$_art" ] || continue
        _stem="$(basename "$_art" .mm0)"
        [ -f "$repo_root/mm0/$_stem.mm1" ] || continue
        # Nothing to approve in a declaration-only measurement artifact: it has
        # no statements, and the `proves: 0 theorems` pin plus `clif2mm0 check`
        # are the gates that belong to it. Any artifact that grows a theorem
        # loses this exemption, because the line it keys on no longer holds.
        if grep -q '^-- measured-by: scripts/clif2mm0' "$_art" \
                && grep -q '^-- proves: 0 theorems$' "$_art"; then
            continue
        fi
        if [ -f "$_appr_root/$_stem.stmts" ]; then
            # Exit 2 is "cannot verify here" (a pinned theory file such as
            # set.mm0 is untracked toolchain state), which is a gap by the same
            # convention as a missing interpreter — not a refusal.
            _rc=0
            if command -v python3 >/dev/null 2>&1; then
                python3 "$repo_root/scripts/mm0-comparator" check \
                    --approved-root "$_appr_root" "$_stem" || _rc=$?
            else
                _rc=2
            fi
            if [ "$_rc" -eq 0 ]; then
                check "W3: $_stem matches its approved statements" true
            elif [ "$_rc" -eq 2 ]; then
                gap "W3: $_stem could not be checked here (see the comparator's message above)"
            else
                check "W3: $_stem matches its approved statements" false
            fi
            # Approved artifacts are counted too: the statement diff is what
            # *enforces* their contents, but a size printed next to the one that
            # was approved is what makes a shrunk artifact visible to a reader,
            # and an artifact that stops producing statements is how a weakened
            # emitter shows up first.
            _w3_a_n="$(w3_measure "$_stem")"
            _w3_ok="$_w3_ok $_stem(${_w3_a_n:-?} stmt)"
        else
            gap "W3: $_stem has no approved statements (run scripts/mm0-comparator approve $_stem, then commit mm0/approved/)"
            # How much each approval would hold out is a fact the plan's §W3
            # table states per row, and a hand-copied number drifts the moment
            # an artifact grows a statement. So the count is measured here, from
            # the same `--dry-run` output the owner reviews, and printed once at
            # the end as `w3-pending:` — one entry per artifact, in the table's
            # column order, so the table can be diffed against a command instead
            # of trusted.
            _w3_n="$(w3_measure "$_stem")"
            [ -n "$_w3_n" ] || _w3_n="unmeasurable"
            _w3_line="$_w3_line $_stem($_w3_n stmt)"
            case "$_w3_n" in
                ''|*[!0-9]*) ;;  # unmeasurable here: no number to compare
                *) _w3_pairs="$_w3_pairs $_stem=$_w3_n" ;;
            esac
        fi
    done
    if [ -n "$_w3_line" ]; then
        echo "w3-pending:$_w3_line"
    fi
    if [ -n "$_w3_ok" ]; then
        echo "w3-approved:$_w3_ok"
    fi
    # … and the plan's §W3 table states the same numbers in its `stmts` column,
    # which is where a reader gets them. Compare, don't trust: every row for an
    # artifact still unapproved must carry the measured count, and a row left
    # behind for an approved artifact is stale the other way (its approval is
    # checked by the statement diff, so the row no longer has a job). A table
    # cell is the kind of copied number that is right the day it is written.
    # Every §W3 row's artifact and its *state* cell. The state cell is what says
    # whether an artifact is approved yet, so it decides which file the row's
    # numbers must come from, and it is the one edit an approval needs: commit the
    # bytes into `mm0/approved/` and flip this cell (`[gap]`, awaiting owner
    # commit → `[pass]`, approved in `mm0/approved/`). Everything downstream —
    # the counts, the digest, and what `scripts/stage-approvals` stages — is then
    # derived from that one edit and checked here, instead of being a second list
    # somebody has to remember to shorten.
    _w3_tab="$(awk -F'|' '
        /^[ \t]*\|[ \t]*`mm0\/[A-Za-z0-9_]+\.mm0`[ \t]*\|/ {
            path = $2; state = $6
            gsub(/^[ \t]+|[ \t]+$/, "", path)
            gsub(/^[ \t]+|[ \t]+$/, "", state)
            sub(/^`mm0\//, "", path); sub(/\.mm0`$/, "", path)
            print path "\t" state
        }' "$_plan_file")"
    # The two shapes a state cell may have. They live in variables because a case
    # pattern written inline is a *glob*: `[gap]` there is a bracket expression
    # matching one of g/a/p, so the literal text has to be quoted by expansion.
    _w3_state_prefix='`[gap]`, awaiting owner commit'
    _w3_state_appr='`[pass]`, approved in `mm0/approved/`'
    _w3_tab_pending=""; _w3_tab_appr=""
    while IFS="$(printf '\t')" read -r _t_stem _t_state; do
        [ -n "$_t_stem" ] || continue
        case "$_t_state" in
            "$_w3_state_prefix"*) _w3_tab_pending="$_w3_tab_pending $_t_stem" ;;
            "$_w3_state_appr"*) _w3_tab_appr="$_w3_tab_appr $_t_stem" ;;
        esac
    done <<EOF
$_w3_tab
EOF
    # What one row gets wrong about the file it describes, or nothing. A pending
    # row must match the artifact as it reads today; an approved row must match
    # the owner's copy under `_appr_root`; and a pending row for an artifact that
    # already has an approved copy is a state cell left behind — the edit the
    # approval was supposed to be, reported instead of half-made.
    _w3_row_bad() {  # stem, stmts cell
        local stem="$1" n="$2" meas act
        case " $_w3_tab_appr " in
            *" $stem "*)
                if [ ! -f "$_appr_root/$stem.stmts" ]; then
                    printf '%s' "$stem(says approved, but $_appr_root/$stem.stmts does not exist)"
                    return 0
                fi
                act="$(grep -cE '^(provable sort|sort|delimiter|prefix|term|def|axiom|theorem) ' \
                    "$_appr_root/$stem.stmts" || true)"
                [ "$act" = "$n" ] \
                    || printf '%s' "$stem(table says $n statements, the approved copy holds $act)"
                ;;
            *)
                if [ -f "$_appr_root/$stem.stmts" ]; then
                    printf '%s' "$stem(says unapproved, but $_appr_root/$stem.stmts exists — flip this row's state cell)"
                    return 0
                fi
                meas="$(printf '%s\n' "$_w3_pairs" | tr ' ' '\n' | grep -x "$stem=[0-9]*" | head -1)"
                if [ -z "$meas" ]; then
                    printf '%s' "$stem(row gives $n statements, but its artifact does not re-derive here — see the re-derivation check)"
                elif [ "${meas##*=}" != "$n" ]; then
                    printf '%s' "$stem(table says $n, file says ${meas##*=})"
                fi
                ;;
        esac
    }
    _w3_plan="$(awk -F'|' '
        /^[ \t]*\|[ \t]*`mm0\/[A-Za-z0-9_]+\.mm0`[ \t]*\|/ {
            path = $2; cell = $4
            gsub(/^[ \t]+|[ \t]+$/, "", path)
            gsub(/^[ \t]+|[ \t]+$/, "", cell)
            sub(/^`mm0\//, "", path); sub(/\.mm0`$/, "", path)
            if (cell ~ /^[0-9]+$/) print path "=" cell
        }' "$_plan_file")"
    _w3_bad=""
    _w3_rows=0
    _w3_appr_rows=0
    for _row in $_w3_plan; do
        _p_stem="${_row%%=*}"
        _w3_rows=$((_w3_rows + 1))
        _w3_bad="$_w3_bad$(_w3_row_bad "$_p_stem" "${_row##*=}")"
        case " $_w3_tab_appr " in
            *" $_p_stem "*) _w3_appr_rows=$((_w3_appr_rows + 1)) ;;
        esac
    done
    # … and the other direction: an artifact still pending here must have a row,
    # so an approval cannot be "recorded" by dropping the row instead.
    for _pair in $_w3_pairs; do
        _q_stem="${_pair%%=*}"
        printf '%s\n' "$_w3_plan" | grep -qx "$_q_stem=[0-9]*" \
            || _w3_bad="$_w3_bad $_q_stem(no §W3 row, file says ${_pair##*=})"
    done
    if [ "$_w3_rows" -gt 0 ] && [ -z "$_w3_bad" ]; then
        check "W3: the plan's §W3 stmts column matches what each artifact holds ($_w3_rows row(s), $_w3_appr_rows approved)" true
    elif [ "$_w3_rows" -eq 0 ]; then
        check "W3: the plan's §W3 stmts column not compared (no table row carries a count)" false
    else
        echo "  [detail] §W3 table vs measured:${_w3_bad}" >&2
        check "W3: the plan's §W3 stmts column matches what each artifact holds" false
    fi
    # A pending row is the owner's next decision, so its artifact has to re-derive
    # *now*. The `stmts` check above can only compare a number it measured, so an
    # artifact the comparator cannot stage — a stale `.mm1` its emitter refuses, a
    # generator that broke, a registry entry that went away — used to surface as
    # "no pending artifact of that name is measurable here", which reads like a
    # missing tool rather than something wrong with the artifact, and the owner met
    # the refusal only when they tried to approve it. Every §W3 pending row must
    # therefore have produced its `w3-pending:` number, and the comparator's reason
    # is quoted when it did not.
    # The row's own emitter cell is what an owner follows when a pending artifact
    # does not stage, so the failure names it: `isa` alone leaves the reader to work
    # out which command refused the `.mm1`, and the answer is in the table.
    _w3_row_cell() {  # stem -> the `emitter that owns it` cell, verbatim
        awk -F'|' -v s="$1" '
            /^[ \t]*\|[ \t]*`mm0\/[A-Za-z0-9_]+\.mm0`[ \t]*\|/ {
                path = $2; cell = $5
                gsub(/^[ \t]+|[ \t]+$/, "", path)
                gsub(/^[ \t]+|[ \t]+$/, "", cell)
                sub(/^`mm0\//, "", path); sub(/\.mm0`$/, "", path)
                if (path == s) { print cell; exit }
            }' "$_plan_file"
    }
    # Just the command of that cell (`none — hand-written spec` stays as it is,
    # since there is no command to quote).
    _w3_producer() {
        local _pc _cmd
        _pc="$(_w3_row_cell "$1")"
        _cmd="$(printf '%s' "$_pc" | sed -n 's/^`\([^`]*\)`.*/\1/p')"
        printf '%s' "${_cmd:-$_pc}"
    }
    _w3_rederive_bad=""
    _w3_rederive_n=0
    for _p_stem in $_w3_tab_pending; do
        _w3_rederive_n=$((_w3_rederive_n + 1))
        printf '%s\n' "$_w3_pairs" | tr ' ' '\n' | grep -qx "$_p_stem=[0-9]*" \
            || _w3_rederive_bad="$_w3_rederive_bad $_p_stem(emitter: $(_w3_producer "$_p_stem"))"
    done
    if ! command -v python3 >/dev/null 2>&1; then
        gap "W3: pending rows not re-derived (no python3 for the comparator)"
    elif [ -z "$_w3_rederive_bad" ]; then
        check "W3: every pending §W3 row's artifact re-derives into a staging ($_w3_rederive_n row(s))" true
    else
        echo "  [detail] §W3 pending re-derivation:${_w3_rederive_bad} did not stage; what the comparator said: $(tr '\n' ' ' <"$_w3_why_file" | cut -c1-300)" >&2
        check "W3: every pending §W3 row's artifact re-derives into a staging" false
    fi
    # Both halves of that check are exercised, because the approved half only runs
    # once an approval exists and the stale-state half only runs when someone has
    # an approved copy the table does not know about. With a scratch approved copy
    # in place the approved row must pass, with the copy deleted it must name the
    # missing file, and the same artifact back in its pending state must be told
    # to flip the cell. The scratch copy is a staging; `mm0/approved/` is never
    # read into it or written.
    _w3r_ctl="$_cert_tmp/w3-row-control"
    # A row the table still marks pending: the third probe below puts a staged
    # copy behind it and requires the table to be told to flip its cell, which
    # only means anything while the row is not approved. Derived, so approving
    # an artifact moves the probe to the next pending row instead of breaking it.
    # Once *every* row is approved there is no pending one left, and that used to
    # turn this control into a `[gap]` — its coverage disappearing exactly when
    # the approvals all landed. An approved row is a valid subject: the stale-state
    # half already models the owner's mistake against one, so fall back to it and
    # the probes keep running instead of needing a pending row to exist.
    _w3r_stem="$(printf '%s\n' $_w3_tab_pending | head -1)"
    [ -n "$_w3r_stem" ] || _w3r_stem="$(printf '%s\n' $_w3_tab_appr | head -1)"
    _w3r_row="$(printf '%s\n' "$_w3_plan" | grep -x "$_w3r_stem=[0-9]*" | head -1)"
    if ! command -v python3 >/dev/null 2>&1; then
        gap "W3: the §W3 row check's approved-row control not run (no python3 here)"
    elif [ -z "$_w3r_row" ]; then
        check "W3: the §W3 row check's approved-row control not run (no §W3 row carries a count)" false
    else
        rm -rf "$_w3r_ctl"; mkdir -p "$_w3r_ctl"
        _w3r_staged="$_cert_tmp/approvals/$_w3r_stem.stmts"
        if [ ! -f "$_w3r_staged" ]; then
            python3 "$repo_root/scripts/mm0-comparator" approve \
                --approved-root "$_cert_tmp/approvals" "$_w3r_stem" \
                >"$_w3r_ctl/approve.log" 2>&1 || _w3r_staged=""
        fi
        if [ -z "$_w3r_staged" ]; then
            sed -n '1,3p' "$_w3r_ctl/approve.log" >&2
            gap "W3: the §W3 row check's approved-row control not run (the staging was refused)"
        else
            cp "$_w3r_staged" "$_w3r_ctl/$_w3r_stem.stmts"
            _w3r_saved_appr="$_w3_tab_appr"
            _w3r_saved_root="$_appr_root"
            _w3_tab_appr="$_w3_tab_appr $_w3r_stem"
            _appr_root="$_w3r_ctl"
            _w3r_ok="$(_w3_row_bad "$_w3r_stem" "${_w3r_row##*=}")"
            rm -f "$_w3r_ctl/$_w3r_stem.stmts"
            _w3r_missing="$(_w3_row_bad "$_w3r_stem" "${_w3r_row##*=}")"
            # The stale-state half is the edit an owner makes by mistake: the
            # copy is committed, the cell still says pending. Approving every
            # §W3 artifact makes the real cell say approved, so the probe *is*
            # that mistake — the stem is taken out of the approved set for this
            # one call instead of being assumed absent from it.
            _w3r_stale_appr=""
            for _w3r_tok in $_w3r_saved_appr; do
                [ "$_w3r_tok" = "$_w3r_stem" ] || _w3r_stale_appr="$_w3r_stale_appr $_w3r_tok"
            done
            _w3_tab_appr="$_w3r_stale_appr"
            cp "$_w3r_staged" "$_w3r_ctl/$_w3r_stem.stmts"
            _w3r_stale="$(_w3_row_bad "$_w3r_stem" "${_w3r_row##*=}")"
            _w3_tab_appr="$_w3r_saved_appr"
            _appr_root="$_w3r_saved_root"
            if [ -z "$_w3r_ok" ]; then
                check "W3: an approved §W3 row passes when the approved copy holds what it says" true
            else
                echo "  [detail] approved-row probe:$_w3r_ok" >&2
                check "W3: an approved §W3 row passes when the approved copy holds what it says" false
            fi
            if printf '%s' "$_w3r_missing" | grep -q 'does not exist' \
                    && printf '%s' "$_w3r_stale" | grep -q 'flip this row'; then
                check "W3: a §W3 row that disagrees with mm0/approved/ is refused" true
            else
                echo "  [detail] missing-approval probe:'$_w3r_missing' stale-state probe:'$_w3r_stale'" >&2
                check "W3: a §W3 row that disagrees with mm0/approved/ is refused" false
            fi
        fi
    fi
    # … and the `statements-sha256` column. Staging is what produces that digest,
    # so a quoted one is either compared with a staging or it is a copied hex
    # string nobody can check — the exact kind of cell this table's `stmts`
    # column already taught us to measure. The staging goes to the gate's own
    # scratch directory, never `mm0/approved/`, because approval is an owner
    # commit and a check that writes it would be approving on its own.
    _w3_dig_rows="$(awk -F'|' '
        /^[ \t]*\|[ \t]*`mm0\/[A-Za-z0-9_]+\.mm0`[ \t]*\|/ {
            path = $2; cell = $7
            gsub(/^[ \t]+|[ \t]+$/, "", path)
            gsub(/^[ \t]+|[ \t]+$/, "", cell)
            sub(/^`mm0\//, "", path); sub(/\.mm0`$/, "", path)
            gsub(/`/, "", cell)
            if (cell ~ /^[0-9a-f]+$/) print path "\t" cell
        }' "$_plan_file")"
    _w3_dig_bad=""
    _w3_dig_n=0
    _w3_dig_appr_n=0
    mkdir -p "$_cert_tmp/approvals"
    while IFS="$(printf '\t')" read -r _g_stem _g_cell; do
        [ -n "$_g_stem" ] || continue
        _w3_dig_n=$((_w3_dig_n + 1))
        # An approved row quotes the digest of the bytes an owner committed, so
        # that is the file it is compared with; a pending row quotes a staging.
        case " $_w3_tab_appr " in
            *" $_g_stem "*)
                _w3_dig_appr_n=$((_w3_dig_appr_n + 1))
                _g_actual="$(sed -n 's/^-- statements-sha256: //p' \
                    "$_appr_root/$_g_stem.stmts" 2>/dev/null)"
                if [ -z "$_g_actual" ]; then
                    _w3_dig_bad="$_w3_dig_bad $_g_stem(approved row, but no approved copy to read)"
                    continue
                fi
                ;;
            *)
                rm -f "$_cert_tmp/approvals/$_g_stem.stmts"
                python3 "$repo_root/scripts/mm0-comparator" approve \
                    --approved-root "$_cert_tmp/approvals" "$_g_stem" \
                    >"$_cert_tmp/approvals/$_g_stem.log" 2>&1 || {
                    _w3_dig_bad="$_w3_dig_bad $_g_stem(staging refused)"
                    continue
                }
                _g_actual="$(sed -n 's/^-- statements-sha256: //p' \
                    "$_cert_tmp/approvals/$_g_stem.stmts" 2>/dev/null)"
                ;;
        esac
        if [ "$_g_actual" != "$_g_cell" ]; then
            _w3_dig_bad="$_w3_dig_bad $_g_stem(table says '$(printf '%s' "$_g_cell" | cut -c1-12)…', the file says '$(printf '%s' "$_g_actual" | cut -c1-12)…')"
        fi
    done <<EOF
$_w3_dig_rows
EOF
    if ! command -v python3 >/dev/null 2>&1; then
        gap "W3: the §W3 statements-sha256 column not compared (no python3 here)"
    elif [ "$_w3_dig_n" -eq 0 ]; then
        check "W3: the §W3 statements-sha256 column not compared (no table row quotes one)" false
    elif [ -z "$_w3_dig_bad" ]; then
        check "W3: the plan's §W3 digest column matches the file it describes ($_w3_dig_n row(s), $_w3_dig_appr_n approved)" true
    else
        echo "  [detail] §W3 digests:${_w3_dig_bad}" >&2
        check "W3: the plan's §W3 digest column matches the file it describes" false
    fi
    # … and the column's control, because "the digest is what pins the bytes" is
    # a claim about a comparison that must actually refuse: alter one statement
    # in a staged copy and `check` must refuse it; alter only the quoted digest
    # and it must refuse that too, which is the shape a stale cell in this table
    # has. Both controls are staged into scratch roots; nothing here is written.
    _w3_ctl="$_cert_tmp/approve-control"
    rm -rf "$_w3_ctl"
    mkdir -p "$_w3_ctl/clean" "$_w3_ctl/stmt" "$_w3_ctl/digest"
    if ! python3 "$repo_root/scripts/mm0-comparator" approve \
            --approved-root "$_w3_ctl/clean" store_projection_toy \
            >"$_w3_ctl/approve.log" 2>&1; then
        sed -n '1,3p' "$_w3_ctl/approve.log" >&2
        gap "W3: the digest column's control not run (the toy staging was refused)"
    else
        cp "$_w3_ctl/clean/store_projection_toy.stmts" "$_w3_ctl/stmt/"
        cp "$_w3_ctl/clean/store_projection_toy.stmts" "$_w3_ctl/digest/"
        python3 - "$_w3_ctl/stmt/store_projection_toy.stmts" <<'PYMUT'
import sys
p = sys.argv[1]
lines = open(p).read().split("\n")
for i, line in enumerate(lines):
    if line.startswith(("axiom ", "theorem ", "def ", "term ")):
        lines[i] = line[:-1] + "x" if line.endswith(";") else line + "x"
        print(f"mutated line {i + 1}")
        break
else:
    raise SystemExit("no statement line found to mutate")
open(p, "w").write("\n".join(lines))
PYMUT
        python3 - "$_w3_ctl/digest/store_projection_toy.stmts" <<'PYMUT'
import re
import sys
p = sys.argv[1]
text = open(p).read()
digest = re.search(r"^-- statements-sha256: ([0-9a-f]+)$", text, re.M).group(1)
text = text.replace(digest, digest[:-1] + ("0" if digest[-1] != "0" else "1"))
open(p, "w").write(text)
PYMUT
        _ctl_clean=0
        python3 "$repo_root/scripts/mm0-comparator" check \
            --approved-root "$_w3_ctl/clean" store_projection_toy \
            >"$_w3_ctl/clean.log" 2>&1 || _ctl_clean=$?
        _ctl_stmt=0
        python3 "$repo_root/scripts/mm0-comparator" check \
            --approved-root "$_w3_ctl/stmt" store_projection_toy \
            >"$_w3_ctl/stmt.log" 2>&1 || _ctl_stmt=$?
        _ctl_dig=0
        python3 "$repo_root/scripts/mm0-comparator" check \
            --approved-root "$_w3_ctl/digest" store_projection_toy \
            >"$_w3_ctl/digest.log" 2>&1 || _ctl_dig=$?
        if [ "$_ctl_clean" -eq 0 ] && [ "$_ctl_stmt" -ne 0 ] \
                && grep -q 'statements differ from the approved file' "$_w3_ctl/stmt.log"; then
            echo "  [detail] one altered statement: check refused it" \
                 "(unmodified staging: exit 0)" >&2
            check "W3: one altered statement makes the comparator refuse the approved copy" true
        else
            tail -3 "$_w3_ctl/stmt.log" >&2
            echo "  [detail] clean exit=$_ctl_clean mutated exit=$_ctl_stmt" >&2
            check "W3: one altered statement makes the comparator refuse the approved copy" false
        fi
        if [ "$_ctl_dig" -ne 0 ] \
                && grep -q 'does not hash it' "$_w3_ctl/digest.log"; then
            check "W3: a quoted statements-sha256 that does not hash the statements is refused" true
        else
            tail -3 "$_w3_ctl/digest.log" >&2
            check "W3: a quoted statements-sha256 that does not hash the statements is refused" false
        fi
    fi
    # … and the §W9.3 composition table, which says what each approval *is*
    # (sorts, terms, defs, axioms, theorems, closure digest) rather than only how
    # many statements it holds. Every one of those is countable from the staging
    # the section quotes, so it is counted: a cell that says "65 axioms" is
    # compared with the `axiom ` lines the comparator wrote, and "= N
    # declarations" with their sum. Without this the composition is prose — the
    # stmts column could match while a cell still said the toy proves 28
    # theorems and 20 axioms of a file that now proves 27.
    #
    # The row describes an *approval*, so once `mm0/approved/<stem>.stmts`
    # exists the counts come from that file — the bytes an owner committed — not
    # from a staging that merely hashes the same today. The root is overridable
    # so the control below can point at a mutated approval; it is the same
    # `--approved-root` the comparator already takes, and it grants nothing.
    _w93_rows="$(awk -F'|' '
        /^[ \t]*\|[ \t]*`[a-z0-9_]+`[ \t]*\|[ \t]*[0-9]+[ \t]*\|/ {
            art = $2; n = $3; comp = $4; clo = $5
            gsub(/[ \t`]/, "", art); gsub(/\*/, "", comp); gsub(/`/, "", comp)
            gsub(/[ \t]/, "", n); gsub(/[ \t`]/, "", clo)
            gsub(/[ \t]+/, " ", comp); sub(/^ /, "", comp); sub(/ $/, "", comp)
            print art "\t" n "\t" comp "\t" clo
        }' "$_plan_file")"
    if ! command -v python3 >/dev/null 2>&1; then
        gap "W9.3: the composition table not compared (no python3 here)"
    elif [ -z "$_w93_rows" ]; then
        gap "W9.3: the composition table not compared (no row carries a count)"
    else
        _w93_num() { printf '%s' "$1" | grep -oE "(^|[^0-9a-zA-Z])[0-9]+ $2" \
            | head -1 | grep -oE '[0-9]+' || true; }
        # What one canonical file holds, in the order the column names it. One
        # function, so a row and the control below are counted the same way — a
        # control counted by different code would prove nothing about the row.
        _w93_fields() {  # file -> sorts terms defs axioms theorems numerals delims
            printf '%s %s %s %s %s %s %s' \
                "$(grep -cE '^(provable )?sort ' "$1" || true)" \
                "$(grep -cE '^term ' "$1" || true)" \
                "$(grep -cE '^def ' "$1" || true)" \
                "$(grep -cE '^axiom ' "$1" || true)" \
                "$(grep -cE '^theorem ' "$1" || true)" \
                "$(grep -cE '^prefix ' "$1" || true)" \
                "$(grep -cE '^delimiter ' "$1" || true)"
        }
        # Every complaint one row makes against one file, as `artifact(what)`
        # fragments; the empty string means the row describes the file.
        _w93_row_bad() {  # artifact, stmts cell, composition cell, file, source word
            local art="$1" n="$2" comp="$3" file="$4" src="$5"
            local bad="" stmts sorts terms defs ax th pre del dsum claimed
            stmts="$(grep -cE '^(provable sort|sort|delimiter|prefix|term|def|axiom|theorem) ' "$file" || true)"
            [ "$stmts" = "$n" ] || bad="$bad $art(stmts cell $n, $src $stmts)"
            set -- $(_w93_fields "$file")
            sorts="$1"; terms="$2"; defs="$3"; ax="$4"; th="$5"; pre="$6"; del="$7"
            # The "= N declarations" total counts every `sort` line, `Prop`
            # included (isa: 6 + 70 + 1 + 65 + 26 = 168).
            dsum=$((sorts + terms + defs + ax + th))
            # "5 sorts + `Prop`" is six `sort` lines: the cell names the
            # library's own sort separately, so the sorts comparison adds it back.
            case "$comp" in
                *Prop*) sorts=$((sorts - 1)) ;;
            esac
            # Each field is its own literal rather than `(says %s %s, %s %s)`
            # with the field's name read from a loop variable: written this way
            # the emitted message's field word sits inside one contiguous string
            # in this file, so a recorded probe skeleton can require it next to
            # the `says` frame instead of merely somewhere in the script. The
            # source word (`staging` / `approved`) is still interpolated, because
            # a row can legitimately be counted from either file: a literal would
            # need one format per field *and* file (fourteen hand-written
            # strings), since a single format used for both necessarily carries
            # the variable again. The check below covers the field words, which is
            # the half that can be literal without that duplication.
            claimed="$(_w93_num "$comp" 'sorts?')"
            [ -z "$claimed" ] || [ "$claimed" = "$sorts" ] \
                || bad="$bad $art(says $claimed sorts, $src $sorts)"
            claimed="$(_w93_num "$comp" 'terms?')"
            [ -z "$claimed" ] || [ "$claimed" = "$terms" ] \
                || bad="$bad $art(says $claimed terms, $src $terms)"
            claimed="$(_w93_num "$comp" 'defs?')"
            [ -z "$claimed" ] || [ "$claimed" = "$defs" ] \
                || bad="$bad $art(says $claimed defs, $src $defs)"
            claimed="$(_w93_num "$comp" 'axioms?')"
            [ -z "$claimed" ] || [ "$claimed" = "$ax" ] \
                || bad="$bad $art(says $claimed axioms, $src $ax)"
            claimed="$(_w93_num "$comp" 'theorems?')"
            [ -z "$claimed" ] || [ "$claimed" = "$th" ] \
                || bad="$bad $art(says $claimed theorems, $src $th)"
            claimed="$(_w93_num "$comp" 'numerals?(-notation)?')"
            [ -z "$claimed" ] || [ "$claimed" = "$pre" ] \
                || bad="$bad $art(says $claimed numerals, $src $pre)"
            claimed="$(_w93_num "$comp" 'delimiter')"
            [ -z "$claimed" ] || [ "$claimed" = "$del" ] \
                || bad="$bad $art(says $claimed delimiter, $src $del)"
            claimed="$(_w93_num "$comp" 'declarations')"
            if [ -n "$claimed" ] && [ "$claimed" != "$dsum" ]; then
                bad="$bad $art(declarations $claimed, $src $dsum)"
            fi
            printf '%s' "$bad"
        }
        _w93_cnt_bad=""; _w93_clo_bad=""; _w93_n=0; _w93_appr_n=0
        while IFS="$(printf '\t')" read -r _c_art _c_n _c_comp _c_clo; do
            [ -n "$_c_art" ] || continue
            _w93_n=$((_w93_n + 1))
            _c_staged="$_cert_tmp/approvals/$_c_art.stmts"
            if [ ! -f "$_c_staged" ]; then
                python3 "$repo_root/scripts/mm0-comparator" approve \
                    --approved-root "$_cert_tmp/approvals" "$_c_art" \
                    >"$_cert_tmp/approvals/$_c_art.log" 2>&1 || {
                    _w93_cnt_bad="$_w93_cnt_bad $_c_art(staging refused)"
                    _w93_clo_bad="$_w93_clo_bad $_c_art(not compared: staging refused)"
                    continue
                }
            fi
            _c_file="$_c_staged"
            _c_src="staging"
            if [ -f "$_appr_root/$_c_art.stmts" ]; then
                _c_file="$_appr_root/$_c_art.stmts"
                _c_src="approved"
                _w93_appr_n=$((_w93_appr_n + 1))
                # The staging is how the artifact reads today; if it no longer
                # matches what was approved, the row must say so rather than
                # quietly describe one of the two.
                cmp -s "$_c_staged" "$_c_file" \
                    || _w93_cnt_bad="$_w93_cnt_bad $_c_art(staged bytes differ from the approved copy)"
            fi
            _w93_cnt_bad="$_w93_cnt_bad$(_w93_row_bad "$_c_art" "$_c_n" "$_c_comp" "$_c_file" "$_c_src")"
            _c_actual_clo="$(sed -n 's/^-- closure-sha256: //p' "$_c_file")"
            [ "$_c_actual_clo" = "$_c_clo" ] \
                || _w93_clo_bad="$_w93_clo_bad $_c_art(says '$(printf '%s' "$_c_clo" | cut -c1-12)…', $_c_src '$(printf '%s' "$_c_actual_clo" | cut -c1-12)…')"
        done <<EOF
$_w93_rows
EOF
        if [ -z "$_w93_cnt_bad" ]; then
            check "W9.3: the composition table's counts match the files it records ($_w93_n row(s), $_w93_appr_n from mm0/approved/)" true
        else
            echo "  [detail] §W9.3 composition:${_w93_cnt_bad}" >&2
            check "W9.3: the composition table's counts match the files it records" false
        fi
        if [ -z "$_w93_clo_bad" ]; then
            check "W9.3: the composition table's closure digests match the files it records ($_w93_n row(s), $_w93_appr_n from mm0/approved/)" true
        else
            echo "  [detail] §W9.3 closure:${_w93_clo_bad}" >&2
            check "W9.3: the composition table's closure digests match the files it records" false
        fi
        # The per-field comparisons above are unrolled, so a *new* field added to
        # a cell would go unchecked — the cell would name it and nothing would
        # count it. Every counted word a cell names must therefore still have its
        # own literal here. The words come from the cells (`2 sorts`, `1 def`,
        # `24 numeral-notation lines`, backticks stripped first), mapped to the
        # spellings this script compares (`def` -> `defs`, `numeral…` ->
        # `numerals`). A cell that starts naming an uncounted word fails here,
        # which is the signal to add the comparison or stop claiming the word.
        _w93_word_bad=""; _w93_word_n=0
        _w93_words="$(printf '%s\n' "$_w93_rows" | cut -f3 \
            | tr -d '`' \
            | grep -oE '[0-9]+ [a-z][a-z-]*' | awk '{print $2}' \
            | sed -E 's/^numeral.*/numerals/; s/^def$/defs/' | sort -u)"
        while IFS= read -r _w93_word; do
            [ -n "$_w93_word" ] || continue
            _w93_word_n=$((_w93_word_n + 1))
            # `(says $claimed axioms, …)` for the counted fields and
            # `(declarations $claimed, …)` for the sum; both are literal here.
            grep -qF "(says \$claimed $_w93_word," "$repo_root/scripts/verify-invariants" \
                || grep -qF "($_w93_word \$claimed," "$repo_root/scripts/verify-invariants" \
                || _w93_word_bad="$_w93_word_bad $_w93_word(no literal comparison)"
        done <<EOF
$_w93_words
EOF
        if [ -z "$_w93_word_bad" ]; then
            check "W9.3: every field word a composition cell names has a literal comparison ($_w93_word_n word(s))" true
        else
            echo "  [detail] §W9.3 fields:${_w93_word_bad}" >&2
            check "W9.3: every field word a composition cell names has a literal comparison" false
        fi
        # Control: an approved copy is preferred exactly when one exists, so a
        # mutated approval has to fail the counts — otherwise "counted from
        # mm0/approved/" would be a comparison nobody has seen refuse. The
        # scratch approval is the toy staging with its first axiom deleted; no
        # real approved file is read into it and none is written.
        _ctl_appr="$_cert_tmp/approved-control"
        rm -rf "$_ctl_appr"; mkdir -p "$_ctl_appr"
        _ctl_row="$(printf '%s\n' "$_w93_rows" \
            | awk -F'\t' '$1=="store_projection_toy"{print $2 "\t" $3; exit}')"
        _ctl_toy="$_cert_tmp/approvals/store_projection_toy.stmts"
        if [ ! -f "$_ctl_toy" ]; then
            python3 "$repo_root/scripts/mm0-comparator" approve \
                --approved-root "$_cert_tmp/approvals" store_projection_toy \
                >"$_ctl_appr/approve.log" 2>&1 || _ctl_toy=""
        fi
        if [ -z "$_ctl_row" ]; then
            gap "W9.3: the composition check's approval control not run (no store_projection_toy row)"
        elif [ ! -f "$_ctl_toy" ]; then
            sed -n '1,3p' "$_ctl_appr/approve.log" >&2
            gap "W9.3: the composition check's approval control not run (the toy staging was refused)"
        else
            cp "$_ctl_toy" "$_ctl_appr/store_projection_toy.stmts"
            python3 - "$_ctl_appr/store_projection_toy.stmts" <<'PYDROP'
import sys
p = sys.argv[1]
lines = open(p).read().split("\n")
for i, line in enumerate(lines):
    if line.startswith("axiom "):
        del lines[i]
        print(f"dropped line {i + 1}")
        break
else:
    raise SystemExit("no axiom line to drop")
open(p, "w").write("\n".join(lines))
PYDROP
            _ctl_n="$(printf '%s' "$_ctl_row" | cut -f1)"
            _ctl_comp="$(printf '%s' "$_ctl_row" | cut -f2)"
            _ctl_bad="$(_w93_row_bad store_projection_toy "$_ctl_n" "$_ctl_comp" \
                "$_ctl_appr/store_projection_toy.stmts" "approved")"
            if [ -n "$_ctl_bad" ] && printf '%s' "$_ctl_bad" | grep -q 'axioms'; then
                echo "  [detail] one axiom dropped from the approval:$_ctl_bad" >&2
                check "W9.3: an approved copy that drops an axiom fails the composition counts" true
            else
                echo "  [detail] counting a mutated approval reported '$_ctl_bad'" >&2
                check "W9.3: an approved copy that drops an axiom fails the composition counts" false
            fi
        fi
    fi
    # … and the emitter column has to name something real. The `isa` row claims
    # `scripts/isa-encdec check` is "registered in EMITTERS", so that command must
    # exist, be executable, and be the script+mode the comparator actually
    # registers for the stem; the three rows that say "none" must be genuinely
    # unowned, or a reader is told nothing keeps an artifact fresh when a check
    # would in fact run. Without this the column is prose — rename the script, or
    # register an emitter for a stem the table says has none, and the `stmts`
    # comparison stays green while the table misdescribes what owns the file.
    _w3_reg="$(cd "$repo_root" && python3 scripts/mm0-comparator emitters 2>/dev/null)"
    _w3_emit_rows="$(awk -F'|' '
        /^[ \t]*\|[ \t]*`mm0\/[A-Za-z0-9_]+\.mm0`[ \t]*\|/ {
            path = $2; cell = $5
            gsub(/^[ \t]+|[ \t]+$/, "", path)
            gsub(/^[ \t]+|[ \t]+$/, "", cell)
            sub(/^`mm0\//, "", path); sub(/\.mm0`$/, "", path)
            print path "\t" cell
        }' "$_plan_file")"
    _w3_emit_bad=""
    _w3_emit_rows_n=0
    while IFS="$(printf '\t')" read -r _e_stem _e_cell; do
        [ -n "$_e_stem" ] || continue
        _w3_emit_rows_n=$((_w3_emit_rows_n + 1))
        _e_reg="$(printf '%s\n' "$_w3_reg" | awk -F'\t' -v s="$_e_stem" '$1==s{print $2" "$3}')"
        case "$_e_cell" in
            none*)
                if [ -n "$_e_reg" ]; then
                    _w3_emit_bad="$_w3_emit_bad $_e_stem(says none, but EMITTERS registers '$_e_reg')"
                fi
                ;;
            '`'*'`'*)
                _e_cmd="$(printf '%s' "$_e_cell" | sed -n 's/^`\([^`]*\)`.*/\1/p')"
                _e_script="${_e_cmd%% *}"
                _e_mode=""
                case "$_e_cmd" in
                    *' '*) _e_mode="${_e_cmd#* }" ;;
                esac
                if [ -z "$_e_cmd" ] || [ -z "$_e_script" ]; then
                    _w3_emit_bad="$_w3_emit_bad $_e_stem(emitter cell has an empty command)"
                elif [ ! -f "$repo_root/$_e_script" ]; then
                    _w3_emit_bad="$_w3_emit_bad $_e_stem(names '$_e_script', which does not exist)"
                elif [ ! -x "$repo_root/$_e_script" ]; then
                    _w3_emit_bad="$_w3_emit_bad $_e_stem(names '$_e_script', which is not executable)"
                elif [ "$_e_reg" != "$_e_script $_e_mode" ]; then
                    _w3_emit_bad="$_w3_emit_bad $_e_stem(cell says '$_e_cmd', EMITTERS says '${_e_reg:-nothing}')"
                fi
                ;;
            *)
                _w3_emit_bad="$_w3_emit_bad $_e_stem(emitter cell names no command and does not say none: '$(printf '%s' "$_e_cell" | cut -c1-40)')"
                ;;
        esac
    done <<EOF
$_w3_emit_rows
EOF
    if [ -z "$_w3_reg" ]; then
        gap "W3: the plan's §W3 emitter column not compared (the comparator printed no registry)"
    elif [ "$_w3_emit_rows_n" -eq 0 ]; then
        check "W3: the plan's §W3 emitter column not compared (no table row carries one)" false
    elif [ -z "$_w3_emit_bad" ]; then
        check "W3: every §W3 emitter cell names a real command ($_w3_emit_rows_n row(s))" true
    else
        echo "  [detail] §W3 emitter column:${_w3_emit_bad}" >&2
        check "W3: every §W3 emitter cell names a real command" false
    fi
    # A row's every other column is a comparison *with* the artifact it names, so
    # a row for a path the tree does not hold used to surface as a complaint about
    # a count or a digest — true, but not the finding. This asks the table's own
    # question: does the file a row points at exist? It reads every table in the
    # plan, not only §W3's, and skips glob-shaped cells (`mm0/approved/*.stmts` is
    # a pattern, not a path) so the answer stays about concrete files.
    _tbl_rows=0
    _tbl_missing=""
    while IFS= read -r _tbl_path; do
        [ -n "$_tbl_path" ] || continue
        _tbl_rows=$((_tbl_rows + 1))
        [ -e "$repo_root/$_tbl_path" ] \
            || _tbl_missing="$_tbl_missing $_tbl_path(absent)"
    done <<EOF
$(awk -F'|' '
        /^[ \t]*\|[ \t]*`[A-Za-z0-9_./-]+`[ \t]*\|/ {
            p = $2
            gsub(/^[ \t]+|[ \t]+$/, "", p)
            gsub(/`/, "", p)
            if (p ~ /^(mm0|docs|scripts|lib|examples|test|bin|safestos|standard|editor|umbrella|corpus|refi)\/[A-Za-z0-9_.\/-]+\.(mm0|mm1|md|rs|ml|mli|sh|py|aui|aum|toml|json|tbl|tsv|log)$/) print p
        }' "$_plan_file" | sort -u)
EOF
    if [ "$_tbl_rows" -eq 0 ]; then
        gap "Plan: the plan's table rows name files the tree holds (no path-shaped row found)"
    elif [ -z "$_tbl_missing" ]; then
        check "Plan: every file a plan table row names exists on disk ($_tbl_rows row(s))" true
    else
        echo "  [detail] table rows naming absent files:${_tbl_missing}" >&2
        check "Plan: every file a plan table row names exists on disk" false
    fi
    # … and for an *approved* row the emitter cell is not merely a description. The
    # `stmts` and digest columns read the copy an owner committed, so on their own
    # they would keep passing after the emitter was retired or its output changed:
    # the approved file is a fixed artifact and nothing would re-derive it. So each
    # approved row is approved again into a scratch root — which runs its emitter
    # (`emitter_check`: a `none` row regenerates from the artifact itself) — and the
    # result must be byte-identical to the committed copy. That is what says the
    # command in the row still owns the statements the gate is enforcing.
    # The cell this table carries for one artifact, as the emitter column read it.
    _w3_cell_of() {
        printf '%s\n' "$_w3_emit_rows" | awk -F'\t' -v s="$1" '$1==s{print $2; exit}'
    }
    # Why one approved row's emitter does not own its copy, or nothing when it does.
    # Two things are asked: the row's cell still names the command the registry holds
    # for that artifact — a retired emitter would otherwise only stop `approve` from
    # *running* anything, leaving it regenerating from the artifact and comparing
    # equal — and approving the artifact again reproduces the committed copy byte
    # for byte. The registry is the caller's `_w3_reg`, so the control below can
    # hand it a retired one without touching the repository.
    _w3_emit_reason() {  # stem, cell, approved root, scratch root
        local _r_stem="$1" _r_cell="$2" _r_appr="$3" _r_scratch="$4" _r_cmd _r_reg
        case "$_r_cell" in
            '`'*'`'*)
                _r_cmd="$(printf '%s' "$_r_cell" | sed -n 's/^`\([^`]*\)`.*/\1/p')"
                _r_reg="$(printf '%s\n' "$_w3_reg" | awk -F'\t' -v s="$_r_stem" '$1==s{print $2" "$3}')"
                if [ "$_r_cmd" != "$_r_reg" ]; then
                    printf '%s' "$_r_stem(the row says '$_r_cmd', the registry says '${_r_reg:-nothing}' for it)"
                    return 0
                fi
                ;;
        esac
        if [ ! -f "$_r_appr/$_r_stem.stmts" ]; then
            printf '%s' "$_r_stem(no approved copy for its emitter to reproduce)"
            return 0
        fi
        mkdir -p "$_r_scratch"
        if ! ( cd "$repo_root" && python3 scripts/mm0-comparator approve \
                --approved-root "$_r_scratch" "$_r_stem" ) \
                >"$_r_scratch/$_r_stem.log" 2>&1; then
            printf '%s' "$_r_stem(its emitter no longer produces it: $(sed -n '1p' "$_r_scratch/$_r_stem.log" | cut -c1-80))"
            return 0
        fi
        cmp -s "$_r_appr/$_r_stem.stmts" "$_r_scratch/$_r_stem.stmts" \
            || printf '%s' "$_r_stem(the emitter produces today's statements, $_r_appr/$_r_stem.stmts holds the approved ones)"
    }
    _w3_appr_emit_bad=""
    _w3_appr_emit_n=0
    if [ -n "$_w3_tab_appr" ]; then
        if command -v python3 >/dev/null 2>&1; then
            _w3_emit_tmp="$_cert_tmp/w3-emitter"
            for _a_stem in $_w3_tab_appr; do
                _w3_appr_emit_n=$((_w3_appr_emit_n + 1))
                # Only a real reason is appended: the accumulation always adds a
                # space, so a row that reproduces its copy would otherwise read as
                # a failure with no message at all.
                _w3_r="$(_w3_emit_reason "$_a_stem" "$(_w3_cell_of "$_a_stem")" \
                    "$_appr_root" "$_w3_emit_tmp")"
                [ -z "$_w3_r" ] || _w3_appr_emit_bad="$_w3_appr_emit_bad $_w3_r"
            done
        fi
    fi
    if [ -n "$_w3_tab_appr" ] && ! command -v python3 >/dev/null 2>&1; then
        gap "W3: an approved §W3 row's emitter not re-run (no python3 for the comparator)"
    elif [ -z "$_w3_appr_emit_bad" ]; then
        check "W3: every approved §W3 row's emitter still produces its approved copy ($_w3_appr_emit_n row(s))" true
    else
        echo "  [detail] §W3 approved emitters:${_w3_appr_emit_bad}" >&2
        check "W3: every approved §W3 row's emitter still produces its approved copy" false
    fi
    # … with the negative control that makes that line more than a claim: the same
    # function, handed a registry with `isa` retired — what unregistering its emitter
    # produces — and the row that names `` `scripts/isa-encdec check` ``, must report
    # the retirement for that row, while the real registry over an identical copy must
    # report nothing. The copy is a fresh staging of `isa`, so the registry is the only
    # difference between the two runs and the positive half proves the function is not
    # just always complaining.
    _w3_emit_ctl="$_cert_tmp/w3-emitter-ctl"
    if command -v python3 >/dev/null 2>&1 \
            && ( cd "$repo_root" && python3 scripts/mm0-comparator approve \
                    --approved-root "$_w3_emit_ctl" isa ) >"$_w3_emit_ctl.log" 2>&1; then
        _w3_ctl_cell="$(_w3_cell_of isa)"
        _w3_ctl_held="$(_w3_emit_reason isa "$_w3_ctl_cell" "$_w3_emit_ctl" "$_w3_emit_ctl/fresh")"
        _w3_reg_keep="$_w3_reg"
        _w3_reg="$(printf '%s\n' "$_w3_reg" | awk -F'\t' '$1!="isa"')"
        _w3_ctl_retired="$(_w3_emit_reason isa "$_w3_ctl_cell" "$_w3_emit_ctl" "$_w3_emit_ctl/retired")"
        _w3_reg="$_w3_reg_keep"
        if [ -z "$_w3_ctl_held" ] && printf '%s' "$_w3_ctl_retired" | grep -q 'registry says' \
                && printf '%s' "$_w3_ctl_retired" | grep -q '^isa('; then
            check "W3: an approved §W3 row whose emitter left the registry is refused" true
        else
            echo "  [detail] retired-emitter control: registered='${_w3_ctl_held:-held}', retired='${_w3_ctl_retired:-held}'" >&2
            check "W3: an approved §W3 row whose emitter left the registry is refused" false
        fi
    else
        gap "W3: the retired-emitter control not run (isa did not stage here)"
    fi
    # The two probes behind those lines are also recorded as data, so a reader can
    # re-read the message each perturbation produces without performing it twice.
    # Evidence citing a check that no longer exists is worse than none, so the rows
    # are re-read on every run: each `gate_line` must still be text this script
    # emits, and each artifact must still be a §W3 row. The perturbations themselves
    # are deliberately not re-run — appending to `mm0/isa.mm1` or editing `EMITTERS`
    # is a measurement, not a routine check.
    _w3_probe_file="$repo_root/docs/data/w3/probes.tsv"
    _w3_probe_bad=""
    _w3_probe_n=0
    if [ -f "$_w3_probe_file" ]; then
        while IFS="$(printf '\t')" read -r _p_name _p_art _p_pert _p_line _p_expect \
                _p_date _p_exit _p_total; do
            case "$_p_name" in ''|probe) continue ;; esac
            _w3_probe_n=$((_w3_probe_n + 1))
            # An artifact is a §W3 row, or — for the controls behind the checks the
            # census classifies `copy` outside §W3 — a model file the gate reads:
            # `mm0/<name>.mm0`, or the Liquid golden under `lib/liquid/`. Naming the
            # file the perturbation moved is the point; the allowance is a name that
            # exists in the tree, not free text.
            case " $_w3_tab_pending $_w3_tab_appr " in
                *" $_p_art "*) ;;
                *)
                    if [ -f "$repo_root/mm0/$_p_art.mm0" ] \
                            || [ -f "$repo_root/lib/liquid/$_p_art.ml" ]; then
                        :
                    else
                        _w3_probe_bad="$_w3_probe_bad $_p_name(artifact '$_p_art' is neither a §W3 row nor a file the gate reads)"
                    fi
                    ;;
            esac
            grep -qF "$_p_line" "$repo_root/scripts/verify-invariants" \
                || _w3_probe_bad="$_w3_probe_bad $_p_name(gate line '$_p_line' is not in the gate)"
            [ -n "$_p_date" ] \
                || _w3_probe_bad="$_w3_probe_bad $_p_name(no measurement date)"
            # … and the recorded message must still be one this script can produce.
            # It is written with `…` wherever the gate interpolates a stem, a command
            # or a count, and every literal chunk between the ellipses must still
            # appear in the source: nothing else can check a message whose variable
            # parts differ per artifact, and a renamed or reworded message is exactly
            # what makes a recorded measurement misleading. Chunks under four
            # characters are ignored, so the check cannot be satisfied by `the`.
            _p_chunks="$(printf '%s' "$_p_expect" | sed 's/…/\n/g' | awk 'length($0) >= 4')"
            _p_chunk_bad=""
            if [ -z "$_p_chunks" ]; then
                _p_chunk_bad="$_p_name(expected message has no literal text to check)"
            else
                while IFS= read -r _p_chunk; do
                    grep -qF "$_p_chunk" "$repo_root/scripts/verify-invariants" && continue
                    _p_chunk_bad="$_p_name(expected message chunk '$(printf '%s' "$_p_chunk" | cut -c1-60)' is not in the gate)"
                    break
                done <<EOF
$_p_chunks
EOF
            fi
            [ -z "$_p_chunk_bad" ] || _w3_probe_bad="$_w3_probe_bad $_p_chunk_bad"
            # The exit status and the total a gate run ended with are recorded where
            # the perturbation *was* a gate run, and `-` where the probe is exercised
            # in-gate instead. Both are re-read for shape — a refusal exits non-zero,
            # and a total is `<n> passed, <n> explained gap(s), <n> failed` — because
            # a row claiming exit 0 for a perturbation would be evidence of nothing
            # being caught, and a `-` in one column with a number in the other is a
            # row nobody can reproduce.
            case "$_p_exit" in
                -)
                    [ "$_p_total" = "-" ] \
                        || _w3_probe_bad="$_w3_probe_bad $_p_name(records a total without an exit status)"
                    ;;
                ''|*[!0-9]*)
                    _w3_probe_bad="$_w3_probe_bad $_p_name(gate exit '$_p_exit' is not a number or -)"
                    ;;
                *)
                    [ "$_p_exit" -ne 0 ] \
                        || _w3_probe_bad="$_w3_probe_bad $_p_name(records exit 0, so the perturbation caught nothing)"
                    printf '%s' "$_p_total" \
                        | grep -qE '^[0-9]+ passed, [0-9]+ explained gap\(s\), [0-9]+ failed$' \
                        || _w3_probe_bad="$_w3_probe_bad $_p_name(total '$_p_total' is not a gate summary)"
                    ;;
            esac
        done <"$_w3_probe_file"
    fi
    if [ ! -f "$_w3_probe_file" ]; then
        gap "W3: recorded probe evidence not re-read (docs/data/w3/probes.tsv is absent)"
    elif [ -z "$_w3_probe_bad" ]; then
        check "W3: the recorded probe evidence still names live gate lines ($_w3_probe_n row(s))" true
    else
        echo "  [detail] §W3 probe evidence:${_w3_probe_bad}" >&2
        check "W3: the recorded probe evidence still names live gate lines" false
    fi
    # A control is an experiment, and its result is only re-readable if the run
    # that produced it was kept. `docs/data/gate/README.md` is where those runs
    # are kept — one row per transcript, its `command` column naming the control.
    # So every drift control the plan names must have such a row. The suite's
    # cases are separate experiments (one drifts the Liquid golden, another the
    # certificate's citation digest), so a case the plan names by name needs a
    # row of its own; `all` and flags (`--list`, `-j`) are not cases. The row only
    # has to *name* the control: whether the file it links still resolves is
    # `scripts/check-links`'s question, because asking it here would stop a
    # control from recording the transcript this check demands. Executability is
    # checked: a plan naming a control that is gone, or is not runnable, is
    # evidence pointing at nothing.
    _w3_ctl_table="$repo_root/docs/data/gate/README.md"
    _w3_ctl_bad=""
    _w3_ctl_n=0
    _w3_ctl_inv="$( {
        grep -oE 'scripts/[A-Za-z0-9_.-]*drift-control[A-Za-z0-9_.-]*' "$_plan_file"
        grep -oE 'scripts/w3-drift-controls [a-z][a-z0-9-]*' "$_plan_file" \
            | grep -v ' all$'
    } | sort -u)"
    while IFS= read -r _c_inv; do
        case "$_c_inv" in '') continue ;; esac
        _w3_ctl_n=$((_w3_ctl_n + 1))
        _c_path="${_c_inv%% *}"
        if [ ! -f "$repo_root/$_c_path" ] || [ ! -x "$repo_root/$_c_path" ]; then
            _w3_ctl_bad="$_w3_ctl_bad $_c_inv(no such executable control)"
        fi
        if [ ! -f "$_w3_ctl_table" ] || ! grep -qF "$_c_inv" "$_w3_ctl_table"; then
            _w3_ctl_bad="$_w3_ctl_bad $_c_inv(no recorded transcript row)"
        fi
    done <<EOF
$_w3_ctl_inv
EOF
    if [ ! -f "$_w3_ctl_table" ]; then
        gap "W3: the plan's drift controls not checked against the transcripts (docs/data/gate/README.md is absent)"
    elif [ -z "$_w3_ctl_bad" ]; then
        check "W3: every drift control the plan names has a recorded transcript ($_w3_ctl_n invocation(s))" true
    else
        echo "  [detail] §W3 drift controls:${_w3_ctl_bad}" >&2
        check "W3: every drift control the plan names has a recorded transcript" false
    fi
    # … and the state column has to say *why* the artifact is still unapproved,
    # not merely that it is. A bare `[gap]` is a status: it tells a reader the
    # gate is red without saying whether anyone is working on it, whether
    # something is blocked, or whether it is an owner decision waiting to be
    # taken. In this repository the answer is always the same — an approval is an
    # owner commit into `mm0/approved/` and nothing here may self-approve, so the
    # row waits on a person — and the cell must say exactly that, with any
    # artifact-specific reason after `; `. Anything else (`pending`, `TBD`, a bare
    # `[gap]`, `blocked on X`) is rot: it either names no reason or names one that
    # the approval rule does not allow.
    _w3_state_rows="$(awk -F'|' '
        /^[ \t]*\|[ \t]*`mm0\/[A-Za-z0-9_]+\.mm0`[ \t]*\|/ {
            path = $2; cell = $6
            gsub(/^[ \t]+|[ \t]+$/, "", path)
            gsub(/^[ \t]+|[ \t]+$/, "", cell)
            sub(/^`mm0\//, "", path); sub(/\.mm0`$/, "", path)
            print path "\t" cell
        }' "$_plan_file")"
    _w3_state_bad=""
    _w3_state_rows_n=0
    while IFS="$(printf '\t')" read -r _s_stem _s_cell; do
        [ -n "$_s_stem" ] || continue
        _w3_state_rows_n=$((_w3_state_rows_n + 1))
        case "$_s_cell" in
            "$_w3_state_prefix"|"$_w3_state_appr") ;;
            "$_w3_state_prefix;"*|"$_w3_state_appr;"*)
                _s_tail="$(printf '%s' "${_s_cell:${#_w3_state_prefix}+1}" \
                    | sed 's/^[ \t]*//;s/[ \t]*$//')"
                [ -n "$_s_tail" ] \
                    || _w3_state_bad="$_w3_state_bad $_s_stem(says the reason is empty: '$_s_cell')"
                ;;
            *)
                _s_why="$(printf '%s' "$_s_cell" | cut -c1-48)"
                _s_loose_gap='`[gap]`'; _s_bare_gap='[gap]'; _s_loose_pass='`[pass]`'
                case "$_s_cell" in
                    "$_s_loose_gap"*|"$_s_bare_gap"*)
                        _w3_state_bad="$_w3_state_bad $_s_stem(state names a reason the approval rule does not allow: '$_s_why')" ;;
                    "$_s_loose_pass"*)
                        _w3_state_bad="$_w3_state_bad $_s_stem(says approved without naming mm0/approved/: '$_s_why')" ;;
                    *)
                        _w3_state_bad="$_w3_state_bad $_s_stem(state carries neither the gate's [gap] nor its [pass] marker: '$_s_why')" ;;
                esac
                ;;
        esac
    done <<EOF
$_w3_state_rows
EOF
    if [ "$_w3_state_rows_n" -eq 0 ]; then
        check "W3: the plan's §W3 state column not compared (no table row carries one)" false
    elif [ -z "$_w3_state_bad" ]; then
        check "W3: every §W3 state cell says whether the row is approved or still waiting on the owner ($_w3_state_rows_n row(s))" true
    else
        echo "  [detail] §W3 state column:${_w3_state_bad}" >&2
        check "W3: every §W3 state cell says whether the row is approved or still waiting on the owner" false
    fi
    # … and the staging script's own contract, because it is the only way an
    # owner gets a diff to approve. A name that is not an artifact must be a
    # usage error (64) rather than the comparator's "refused" line, which is the
    # message for a genuinely stale artifact; the pending artifacts must stage
    # cleanly (exit 0, one heading each); and a copy byte-identical to the
    # approved one must be refused as "nothing to approve" — an empty diff under
    # a `== <artifact>` heading reads like a successful approval of nothing. The
    # approved root used by the last case is a scratch directory.
    if [ ! -f "$repo_root/scripts/stage-approvals" ]; then
        gap "W3: scripts/stage-approvals absent — the approval diff is not gated"
    elif ! command -v python3 >/dev/null 2>&1; then
        gap "W3: stage-approvals not exercised (no python3 here)"
    else
        _sa="$_cert_tmp/stage-approvals"
        rm -rf "$_sa"; mkdir -p "$_sa"
        _sa_unknown=0
        bash "$repo_root/scripts/stage-approvals" no_such_artifact \
            --root "$_sa/unknown" >"$_sa/unknown.log" 2>&1 || _sa_unknown=$?
        if [ "$_sa_unknown" -eq 64 ] && grep -q 'no such artifact' "$_sa/unknown.log" \
                && grep -q 'nothing staged' "$_sa/unknown.log"; then
            check "W3: stage-approvals answers an unknown artifact name with exit 64" true
        else
            tail -3 "$_sa/unknown.log" >&2
            echo "  [detail] unknown name: exit=$_sa_unknown (want 64)" >&2
            check "W3: stage-approvals answers an unknown artifact name with exit 64" false
        fi
        # Which artifact is pending is not a list in the script: the no-argument
        # run stages an artifact only when `--approved-root` has no copy of it, so
        # the headings must be exactly §W3's pending rows and never one of its
        # approved ones. That is what makes an approval one edit — the row's state
        # cell — with this check deriving the rest instead of a second array
        # somebody has to shorten by hand.
        _sa_pending="${_w3_tab_pending# }"
        _sa_pending_n="$(printf '%s' "$_sa_pending" | wc -w)"
        _sa_names="$(sed -n 's/^artifacts_all=(\(.*\))$/\1/p' "$repo_root/scripts/stage-approvals")"
        _sa_rows_n="$(printf '%s ' "$_w3_tab_pending" "$_w3_tab_appr" | wc -w)"
        _sa_names_bad=""
        for _sa_name in $_sa_names; do
            case " $_w3_tab_pending $_w3_tab_appr " in
                *" $_sa_name "*) ;;
                *) _sa_names_bad="$_sa_names_bad $_sa_name(not a §W3 row)" ;;
            esac
        done
        for _sa_name in $_w3_tab_pending $_w3_tab_appr; do
            case " $_sa_names " in
                *" $_sa_name "*) ;;
                *) _sa_names_bad="$_sa_names_bad $_sa_name(the §W3 row is not in the script's artifact list)" ;;
            esac
        done
        if [ "$_sa_rows_n" -gt 0 ] && [ -z "$_sa_names_bad" ]; then
            check "W3: stage-approvals' artifact list is the §W3 table's rows ($_sa_rows_n name(s))" true
        elif [ "$_sa_rows_n" -eq 0 ]; then
            check "W3: stage-approvals' artifact list not compared (no §W3 row carries a state)" false
        else
            echo "  [detail] artifact lists:${_sa_names_bad}" >&2
            check "W3: stage-approvals' artifact list is the §W3 table's rows" false
        fi
        # The script is pointed at the same approved root the table's rows were
        # read from, so the two sides of this comparison are always looking at
        # the same notion of "approved" — including under the override.
        _sa_all=0
        bash "$repo_root/scripts/stage-approvals" --stat-only \
            --root "$_sa/all" --approved-root "$_appr_root" \
            >"$_sa/all.log" 2>&1 || _sa_all=$?
        _sa_missing=""
        for _sa_name in $_sa_pending; do
            grep -q "^== $_sa_name\$" "$_sa/all.log" || _sa_missing="$_sa_missing $_sa_name"
        done
        for _sa_name in $_w3_tab_appr; do
            grep -q "^== $_sa_name\$" "$_sa/all.log" && _sa_missing="$_sa_missing $_sa_name(staged, but §W3 says approved)"
        done
        _sa_ok=false
        if [ "$_sa_all" -eq 0 ] && [ -z "$_sa_missing" ]; then
            if [ "$_sa_pending_n" -gt 0 ]; then
                grep -q "^stage-approvals: $_sa_pending_n staged, 0 refused, 0 nothing to approve" "$_sa/all.log" \
                    && _sa_ok=true
            else
                grep -q 'nothing pending' "$_sa/all.log" && _sa_ok=true
            fi
        fi
        if [ "$_sa_ok" = true ]; then
            check "W3: stage-approvals stages exactly §W3's $_sa_pending_n pending row(s) (exit 0)" true
        else
            tail -3 "$_sa/all.log" >&2
            echo "  [detail] pending stage: exit=$_sa_all, headings wrong:${_sa_missing:- none}" >&2
            check "W3: stage-approvals stages exactly §W3's pending rows (exit 0)" false
        fi
        # The derivation itself: with a scratch approved root holding one of the
        # pending artifacts, the no-argument run must stage the others and report
        # the one as approved. That is the mechanism that lets an approval be a
        # single row edit instead of a row edit plus an array edit.
        _sa_first="${_sa_pending%% *}"
        # The three controls below need one staging to copy into a scratch
        # approved root. Their subject is the *script*, not the owner's pending
        # list, so a fully approved §W3 table must not turn them into gaps: with
        # nothing pending, one artifact is staged against an empty approved root
        # (a first approval, by construction) and that copy drives the controls.
        if [ -z "$_sa_first" ] && [ -n "$_sa_names" ]; then
            _sa_first="${_sa_names%% *}"
            mkdir -p "$_sa/empty"
            bash "$repo_root/scripts/stage-approvals" "$_sa_first" --stat-only \
                --root "$_sa/all" --approved-root "$_sa/empty" \
                >"$_sa/first.log" 2>&1 || _sa_first=""
        fi
        mkdir -p "$_sa/appr1"
        if [ -n "$_sa_first" ] && cp "$_sa/all/$_sa_first.stmts" "$_sa/appr1/" 2>/dev/null; then
            _sa_one=0
            bash "$repo_root/scripts/stage-approvals" --stat-only \
                --root "$_sa/one" --approved-root "$_sa/appr1" \
                >"$_sa/one.log" 2>&1 || _sa_one=$?
            # How many headings are correct depends on what appr1 holds: every
            # artifact of the script's list without a copy there.
            _sa_want=0
            for _sa_name in $_sa_names; do
                [ -f "$_sa/appr1/$_sa_name.stmts" ] || _sa_want=$((_sa_want + 1))
            done
            if [ "$_sa_one" -eq 0 ] \
                    && ! grep -q "^== $_sa_first\$" "$_sa/one.log" \
                    && [ "$(grep -c '^== ' "$_sa/one.log" || true)" -eq "$_sa_want" ] \
                    && grep -q ', 1 already approved;' "$_sa/one.log"; then
                check "W3: stage-approvals stops staging an artifact once its approved copy exists" true
            else
                tail -3 "$_sa/one.log" >&2
                echo "  [detail] derived pending: exit=$_sa_one, headings $(grep -c '^== ' "$_sa/one.log" || true) (want $_sa_want)" >&2
                check "W3: stage-approvals stops staging an artifact once its approved copy exists" false
            fi
        else
            gap "W3: the derived-pending control not run (no $_sa_first staging to copy)"
        fi
        # … and naming an approved artifact by hand is refused before anything is
        # staged, however its bytes compare: what would print is a re-approval,
        # and an owner who half-remembered the state would read it as a first
        # approval. The copy here is deliberately *not* byte-identical, so the
        # refusal cannot be the byte-identity check in disguise.
        mkdir -p "$_sa/appr2"
        if [ -n "$_sa_first" ] && cp "$_sa/all/$_sa_first.stmts" "$_sa/appr2/" 2>/dev/null \
                && sed -i '1s/$/ /' "$_sa/appr2/$_sa_first.stmts"; then
            _sa_appr_named=0
            bash "$repo_root/scripts/stage-approvals" "$_sa_first" --stat-only \
                --root "$_sa/appr-named" --approved-root "$_sa/appr2" \
                >"$_sa/appr-named.log" 2>&1 || _sa_appr_named=$?
            if [ "$_sa_appr_named" -eq 1 ] \
                    && grep -q "is approved — pass --reapprove" "$_sa/appr-named.log" \
                    && ! grep -q 'statement(s), staged at' "$_sa/appr-named.log"; then
                check "W3: stage-approvals refuses a named artifact that is already approved" true
            else
                tail -3 "$_sa/appr-named.log" >&2
                echo "  [detail] named approved: exit=$_sa_appr_named (want 1), staged=$(grep -c 'statement(s), staged at' "$_sa/appr-named.log" || true)" >&2
                check "W3: stage-approvals refuses a named artifact that is already approved" false
            fi
        else
            gap "W3: the named-approved control not run (no $_sa_first staging to copy)"
        fi
        mkdir -p "$_sa/appr"
        if cp "$_sa/all/$_sa_first.stmts" "$_sa/appr/" 2>/dev/null; then
            _sa_noop=0
            bash "$repo_root/scripts/stage-approvals" "$_sa_first" --stat-only --reapprove \
                --root "$_sa/noop" --approved-root "$_sa/appr" \
                >"$_sa/noop.log" 2>&1 || _sa_noop=$?
            if [ "$_sa_noop" -eq 1 ] && grep -q 'nothing to approve' "$_sa/noop.log"; then
                check "W3: stage-approvals refuses an artifact that equals its approved copy" true
            else
                cat "$_sa/noop.log" >&2
                echo "  [detail] no-op staging: exit=$_sa_noop (want 1)" >&2
                check "W3: stage-approvals refuses an artifact that equals its approved copy" false
            fi
        else
            gap "W3: the no-op staging control not run (no $_sa_first staging to copy)"
        fi
    fi
    check_py "W3: comparator self-test (all three negative controls refuse)" \
        python3 "$repo_root/scripts/mm0-comparator" selftest
else
    gap "W3: scripts/mm0-comparator absent — approved statements are not gated"
fi

# --- logos: the CNL → DeltaNet → MM0 math fragment (unfer/docs/LOGOS_MM0.md) ---
#
# A sentence of the math fragment is compiled by unfer/logos's own pipeline
# (CNL → CoreIR → DeltaNet net), encoded as an MM0 theorem whose bridge axioms
# name the net's agents, and answered by mm0's verdict: proved `teq L R` is yes,
# `teq L R ⟹ tfals` is no, no certificate is "do not know". The gate owns the
# end-to-end chain *and* its anchor — a tampered certificate must be rejected,
# or "verified" means nothing.
if [ -f "$repo_root/scripts/logos2mm0" ] && [ -f "$repo_root/../unfer/logos/mm0/claims.txt" ]; then
    # `scripts/logos2mm0` is a sub-gate, and its own `[gap]` lines must not be
    # laundered into this gate's `[pass]`: it exits 0 for "gapped" (no cargo, no
    # mm0 toolchain, no dk fixtures) as well as for green, and 2 for "cannot
    # check here" (the emitter cannot be *built* in a shell whose cargo has no
    # working linker — the `lean` shell on 2026-11-21 is one). Each of those is
    # a fact about this shell, not about the fragment, so it is a gap; only a run
    # that gapped nothing and failed nothing is a pass.
    _logos_rc=0
    _logos_log="$(mktemp)"
    bash "$repo_root/scripts/logos2mm0" >"$_logos_log" 2>&1 || _logos_rc=$?
    cat "$_logos_log"
    _logos_gaps="$(sed -n 's/^\[gap\]  *//p' "$_logos_log" | paste -sd'; ' -)"
    if [ "$_logos_rc" -eq 2 ]; then
        gap "logos mm0: the fragment gate could not run here (the emitter cannot be built in this shell)"
    elif [ "$_logos_rc" -ne 0 ]; then
        check "logos mm0: CNL → DeltaNet → MM0 corpus verifies (and its anchor fires)" false
    elif [ -n "$_logos_gaps" ]; then
        gap "logos mm0: the fragment gate could not run in full here ($_logos_gaps)"
    else
        check "logos mm0: CNL → DeltaNet → MM0 corpus verifies (and its anchor fires)" true
    fi
    rm -f "$_logos_log"
else
    gap "logos mm0: sibling unfer repo absent at ../unfer — skipping the fragment gate"
fi

# --- memsafe: the linearity ledger + its MM0 certificates (docs/memsafe.md) ---
#
# The chain this gate owns, once per source: a fixture .aum is compiled with
# `--emit-linearity-ledger` into a pinned ledger, and scripts/ledger2mm0 turns
# that ledger into mm0/<stem>.{mm0,mm1} over docs/memsafe.mm0. Two sources,
# because neither reaches the other's shapes (docs/memsafe.md §3.2):
#
#   linearity_certificate        every *event* (acquire/consume/reacquire/
#                                borrow/unborrow/reborrow/drop)
#   linearity_certificate_spans  reborrow chains across frames, group borrows,
#                                mutable vs free spans
#
# Three distinct failure modes, three checks:
#
#   * the ledger drifting from the fixture or from the checker (regenerating
#     needs the compiler binary, so it is a gap when dune has not run);
#   * the certificate drifting from the ledger or the theory (`check`, needs
#     only python3);
#   * a certificate that would verify *anything* — the mutation anchors:
#     `selftest` (no toolchain) makes the emitter's audit refuse a trace whose
#     resource is never released, and `verify` additionally requires mm0-rs to
#     reject a proof paired with a mutated timeline. A certificate that
#     survives its own mutation is a tautology, not a check.
#
# `stem:ledger-stem:certificates` — the count mirrors scripts/ledger2mm0's
# BUDGETS, deliberately in two places: the emitter refuses to *generate* when
# they disagree with its own count, and this gate refuses to *ship* an artifact
# whose trust-split line disagrees with this table.
MEMSAFE_SOURCES="linearity_certificate:linearity_ledger:17 linearity_certificate_spans:linearity_ledger_spans:19"

memsafe_present=1
for src in $MEMSAFE_SOURCES; do
    stem="${src%%:*}"
    rest="${src#*:}"
    ledger_stem="${rest%%:*}"
    for f in "$repo_root/mm0/fixtures/${ledger_stem}.aum" \
             "$repo_root/mm0/ledgers/${ledger_stem}.json" \
             "$repo_root/mm0/${stem}.mm0" "$repo_root/mm0/${stem}.mm1"; do
        [ -f "$f" ] || memsafe_present=0
    done
done
if [ "$memsafe_present" = 1 ]; then
    check "memsafe: theory, emitter, both fixtures, ledgers and certificates present" true
else
    echo "  [detail] a memsafe fixture/ledger/certificate file is missing" >&2
    check "memsafe: theory, emitter, both fixtures, ledgers and certificates present" false
fi
check "memsafe: certificate + ledger emitter present and executable" \
    test -x "$repo_root/scripts/ledger2mm0"
check_py "memsafe: certificates in sync with the pinned ledgers and theory" \
    python3 "$repo_root/scripts/ledger2mm0" check
# The trust split of a memsafe certificate is 100% derived: every theorem is a
# run_cons chain, so `grounded` must be 0 and `structural` must equal the
# certificate count. If a line ever reads otherwise, the emitter stopped
# deriving and started asserting.
for src in $MEMSAFE_SOURCES; do
    stem="${src%%:*}"
    count="${src##*:}"
    if grep -q -- "-- trust-split: structural=$count grounded=0 certificates=$count" \
        "$repo_root/mm0/${stem}.mm0"; then
        check "memsafe: $stem pins its trust split ($count derived / 0 grounded)" true
    else
        echo "  [detail] expected: -- trust-split: structural=$count grounded=0 certificates=$count" >&2
        sed -n '/-- trust-split/p' "$repo_root/mm0/${stem}.mm0" >&2 || true
        check "memsafe: $stem pins its trust split ($count derived / 0 grounded)" false
    fi
done
# A rule no timeline exercises is a rule this certificate set does not test.
# The theory declares the automaton; the artifacts list the edges they fired;
# every declared edge must appear across them, so adding a transition without
# a fixture that reaches it fails here rather than passing silently.
exercised=""
for stem in linearity_certificate linearity_certificate_spans; do
    line="$(sed -n 's/^-- transitions exercised: //p' "$_mm0/${stem}.mm0")"
    exercised="$exercised,$line"
done
missing_edges=""
for edge in $(sed -n 's/^axiom \(t_[a-z_]*\).*/\1/p' "$repo_root/docs/memsafe.mm0"); do
    case ",$exercised," in
        *",$edge,"*) ;;
        *) missing_edges="$missing_edges $edge" ;;
    esac
done
if [ -n "$missing_edges" ]; then
    echo "  [detail] neither fixture reaches:$missing_edges" >&2
    check "memsafe: fixtures exercise every automaton edge" false
else
    check "memsafe: fixtures exercise every automaton edge" true
fi
check_py "memsafe: emitter self-test (audit refuses an unreleased resource)" \
    python3 "$repo_root/scripts/ledger2mm0" selftest

# Regenerate each ledger from its fixture. This is the only check that can
# notice the *checker* changing what it records: `check` compares artifacts to
# the pinned ledger, so a checker that quietly stops recording a consumption
# would still produce a consistent (and weaker) certificate. Needs the
# compiler binary and its bridge .so, hence the gap when dune has not run.
ledger_drift() {
    local fixture="$1"
    local pinned="$2"
    local tmp
    tmp="$(mktemp -d)"
    if ! ( cd "$tmp" && LD_LIBRARY_PATH="$_bridge_dir:$repo_root" \
             "$repo_root/_build/default/bin/austral.exe" compile \
             "$fixture" \
             --target-type=c --no-entrypoint \
             --output="$tmp/out.c" \
             --emit-linearity-ledger="$tmp/ledger.json" ) >"$tmp/log" 2>&1; then
        echo "  [detail] compiling $(basename "$fixture") failed:" >&2
        head -8 "$tmp/log" >&2
        rm -rf "$tmp"
        return 1
    fi
    if [ ! -f "$tmp/ledger.json" ]; then
        echo "  [detail] the compiler produced no ledger for $(basename "$fixture")" >&2
        rm -rf "$tmp"
        return 1
    fi
    if ! diff -u "$pinned" "$tmp/ledger.json" >"$tmp/diff"; then
        echo "  [detail] the pinned ledger drifted from the fixture:" >&2
        head -24 "$tmp/diff" >&2
        rm -rf "$tmp"
        return 1
    fi
    rm -rf "$tmp"
    return 0
}
if [ -x "$repo_root/_build/default/bin/austral.exe" ]; then
    for src in $MEMSAFE_SOURCES; do
        stem="${src%%:*}"
        rest="${src#*:}"
        ledger_stem="${rest%%:*}"
        check "memsafe: $ledger_stem in sync with its fixture and the checker" \
            ledger_drift "$repo_root/mm0/fixtures/${ledger_stem}.aum" \
                         "$repo_root/mm0/ledgers/${ledger_stem}.json"
    done
else
    gap "memsafe: pinned ledgers in sync with the fixtures (austral.exe not built; run dune build)"
fi

if command -v mm0-rs >/dev/null 2>&1 && command -v mm0-c >/dev/null 2>&1; then
    check_py "memsafe: mm0-rs + mm0-c verify both certificates, and reject mutated ones" \
        python3 "$repo_root/scripts/ledger2mm0" verify
else
    gap "memsafe: mm0 toolchain absent (mm0-rs/mm0-c not on PATH; see docs/memsafe.md §6)"
fi

# --- service isolation: the three-service certificate (docs/service_isolation.mm0) ---
#
# Same root of trust as memsafe, different subject: svcmux's cross-checked
# measurements (verifieduniquealiases/scripts/e2e-three-svcs.sh writes
# mm0/service_pins.json) become one `isolated` theorem per ordered pair,
# derived by iso_intro over the pinned facts. The invariants this gate owns:
#
#   * the artifacts are in sync with the pins and the theory (`check`);
#   * the trust split is structural-only — a `grounded=` line other than 0
#     means the emitter stopped deriving separations and started asserting
#     them, which is the exact failure the certificate exists to catch;
#   * the emitter's own audit refuses a pair measured equal on any axis
#     (`selftest`, no toolchain);
#   * mm0-rs + mm0-c accept the proofs and refuse a proof mutated to cite
#     the wrong axis's pinned constant (`verify`, needs the toolchain).
iso_files="$repo_root/mm0/service_pins.json $repo_root/docs/service_isolation.mm0 $repo_root/mm0/service_isolation_certificate.mm0 $repo_root/mm0/service_isolation_certificate.mm1"
iso_present=1
for f in $iso_files; do
    [ -f "$f" ] || iso_present=0
done
if [ "$iso_present" = 1 ]; then
    check "service-isolation: pins, theory and both certificate halves present" true
else
    echo "  [detail] missing one of: $iso_files" >&2
    check "service-isolation: pins, theory and both certificate halves present" false
fi
check "service-isolation: emitter present and executable" \
    test -x "$repo_root/scripts/service_iso2mm0"
check_py "service-isolation: certificate in sync with the pinned measurements and theory" \
    python3 "$repo_root/scripts/service_iso2mm0" check
iso_line="$(sed -n 's/^-- trust-split: //p' "$repo_root/mm0/service_isolation_certificate.mm0")"
iso_struct="$(sed -n 's/^structural=\([0-9]*\).*/\1/p' <<<"$iso_line")"
iso_ground="$(sed -n 's/.*grounded=\([0-9]*\).*/\1/p' <<<"$iso_line")"
iso_certs="$(sed -n 's/.*certificates=\([0-9]*\).*/\1/p' <<<"$iso_line")"
if [ -n "$iso_struct" ] && [ "$iso_ground" = 0 ] && [ "$iso_struct" = "$iso_certs" ]; then
    check "service-isolation: trust split is structural-only ($iso_struct derived / 0 grounded)" true
else
    echo "  [detail] trust-split line: $iso_line (want grounded=0, structural=certificates)" >&2
    check "service-isolation: trust split is structural-only ($iso_struct derived / 0 grounded)" false
fi
check_py "service-isolation: emitter self-test (an equal pair is refused, never axiomatized)" \
    python3 "$repo_root/scripts/service_iso2mm0" selftest
if command -v mm0-rs >/dev/null 2>&1 && command -v mm0-c >/dev/null 2>&1; then
    check_py "service-isolation: mm0-rs + mm0-c verify the theorems, and reject a mutated proof" \
        python3 "$repo_root/scripts/service_iso2mm0" verify
else
    gap "service-isolation: mm0 toolchain absent (mm0-rs/mm0-c not on PATH; see docs/service_isolation.mm0)"
fi


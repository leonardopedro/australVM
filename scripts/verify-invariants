# --- Liquid: the emitted .mlw goldens must parse under a real Why3 ---
#
# This gate exists because of a concrete failure, not as a precaution. The
# goldens under lib/liquid/golden/ pinned three separate constructs that are not
# valid Why3 at all:
#
#   * `assumes a_x: P` inside a `goal` -- a program construct, illegal there;
#   * `forall (x: int) (y: int).` -- Why3 wants `forall x: int, y: int.`;
#   * a newline between `goal g:` and its term.
#
# All three make Why3 exit 1, which LiquidWhy3.prove reads as "the prover
# refused", so every contract with a precondition produced a *false rejection*.
# None of it was visible, because with no engine installed every .mlw took the
# structured-skip path and a malformed emitter is indistinguishable from an
# unproved one. Pinning the text in a golden is not enough: a golden faithfully
# records whatever the emitter produced, including nonsense.
#
# So the goldens are now required to *parse*. Note this checks syntax and
# provability only -- it does not claim the emitted obligations are complete.
#
# `--type-only` is the gate that matters and the one that always runs: it needs
# no prover, and it catches what a syntax check cannot. A TRL contract using
# `==`, `&&`, `||`, `!=` or `!` used to reach the `.mlw` untranslated, which
# Why3 parses (`==` lexes as an infix symbol) and then rejects as "unbound
# function or predicate symbol '(==)'". With no prover configured, `why3 prove
# -P alt-ergo` reports "No prover ... corresponds" and exits before reaching
# that error, so the older check was blind to exactly this class. See
# `LiquidConstraints.why3_ops`.
if command -v why3 >/dev/null 2>&1; then
    for mlw in "$repo_root"/lib/liquid/golden/*.mlw; do
        [ -e "$mlw" ] || continue
        name="$(basename "$mlw")"
        out="$(why3 prove --type-only "$mlw" 2>&1)"
        if [ $? -eq 0 ]; then
            check "Liquid golden $name type-checks under Why3" true
        else
            echo "  [detail] $name does not type-check under Why3:" >&2
            printf '%s\n' "$out" | head -3 >&2
            check "Liquid golden $name type-checks under Why3" false
        fi
    done
    for mlw in "$repo_root"/lib/liquid/golden/*.mlw; do
        [ -e "$mlw" ] || continue
        name="$(basename "$mlw")"
        # Exit 0 = all goals proved, 1 = unproved goals, 2 = unknown. Anything
        # else -- and specifically a parse failure -- is the real signal here.
        out="$(why3 prove -P alt-ergo "$mlw" 2>&1)"
        # `check` owns the pass/fail bookkeeping; reporting the offending line
        # here keeps the diagnostic useful without double-counting the failure.
        if printf '%s' "$out" | grep -q "syntax error"; then
            echo "  [detail] $name does not parse under Why3:" >&2
            printf '%s\n' "$out" | grep "syntax error" | head -2 >&2
            check "Liquid golden $name parses under Why3" false
        else
            check "Liquid golden $name parses under Why3" true
        fi
    done
else
    gap "Liquid golden Why3 parse check (why3 not on PATH)"
fi

# --- Liquid: the fold golden must *prove*, not just parse ---
#
# vc-fold-premises.mlw is the one golden with no honest refutation in it:
# every §5.9 goal (result/init/step, at the direct and the local-bound call
# site) and §5.10's return for `step` is satisfiable by the fixture, so
# "all Valid under a real prover" is a claim the file can actually keep. A
# regression that overstates a premise -- or drops the body equation that
# makes the return-family goals statable -- turns Valid into Invalid here,
# where the parse gate would still pass: an unprovable goal parses fine.
#
# z3 rather than alt-ergo: alt-ergo still fails to build on this host (the
# `as`/ocamlopt failure recorded in docs/cas.md §2.2), while z3 is a cache
# fetch. `why3 config detect` records its absolute path, so the prover needs
# no PATH entry -- only to be registered in ~/.why3.conf, and an
# unregistered prover is a gap, not a failure.
fold_golden="$repo_root/lib/liquid/golden/vc-fold-premises.mlw"
if command -v why3 >/dev/null 2>&1 && [ -f "$fold_golden" ]; then
    out="$(why3 prove -P z3 "$fold_golden" 2>&1)"
    rc=$?
    if printf '%s' "$out" | grep -qE "No prover|cannot find|No such file|not found"; then
        gap "Liquid golden vc-fold-premises.mlw full z3 validity (z3 not configured for why3)"
    elif [ "$rc" -eq 0 ]; then
        check "Liquid golden vc-fold-premises.mlw proves in full under z3" true
    else
        echo "  [detail] vc-fold-premises.mlw did not prove under z3:" >&2
        printf '%s\n' "$out" | grep -E "Goal|Invalid|Unknown|Error" | head -6 >&2
        check "Liquid golden vc-fold-premises.mlw proves in full under z3" false
    fi
else
    gap "Liquid golden vc-fold-premises.mlw full z3 validity (why3 not on PATH)"
fi

# --- Liquid: the total-subset library must still extract, unchanged ---
#
# Stronger than the parse check above. Extraction proves three things at once:
# the source is inside the fragment the driver can extract, the driver still
# matches the engine (a Why3 upgrade that renames a theory breaks extraction
# before it breaks parsing), and the pinned OCaml has not drifted from the
# source it was generated from.
#
# The golden is the extracted OCaml, and it is checked in deliberately rather
# than generated at build time: Cycle B wants the extracted module compiled into
# the checker, so dune needs a real file, and a checked-in file needs a gate to
# stop it drifting. This gate is that gate.
if command -v why3 >/dev/null 2>&1; then
    mlw="$repo_root/lib/liquid/subset/liquid_measure.mlw"
    golden="$repo_root/lib/liquid/LiquidMeasure.ml"
    tmp="$(mktemp -d)"
    if why3 extract -D "$repo_root/lib/why3_plugin/unfer_ocaml.drv" "$mlw" -o "$tmp/out.ml" >"$tmp/log" 2>&1; then
        check "Liquid subset library extracts with the existing driver" true
        if diff -u "$golden" "$tmp/out.ml" >"$tmp/diff" 2>&1; then
            check "Liquid subset extraction matches its pinned golden" true
        else
            echo "  [detail] extraction drifted from the pinned golden:" >&2
            head -20 "$tmp/diff" >&2
            check "Liquid subset extraction matches its pinned golden" false
        fi
    else
        echo "  [detail] extraction failed:" >&2
        head -5 "$tmp/log" >&2
        check "Liquid subset library extracts with the existing driver" false
        check "Liquid subset extraction matches its pinned golden" false
    fi
    rm -rf "$tmp"
else
    gap "Liquid subset extraction check (why3 not on PATH)"
fi

# --- Liquid Cycle B: the production wiring for the extracted pass ---
#
# LiquidSubsetTest registers the pass itself, because Vm_plugin.boot does not run
# inside a test binary. So the *production* wiring -- that boot registers the
# tenant under a name distinct from `liquid` -- is checked here instead. Cheap,
# and it catches the plausible mistake of adding the pass and forgetting to
# register it, which nothing else would notice.
check "L10 Cycle B: liquid_measure tenant registered in Vm_plugin.boot" \
    grep -q 'register_typed ~name:"liquid_measure" LiquidSubset.check' "$repo_root/lib/Vm_plugin.ml"

check "L10 Cycle B: liquid_measure is a distinct tenant from liquid" \
    bash -c "! grep -q 'register_typed ~name:\"liquid\" LiquidSubset' '$repo_root/lib/Vm_plugin.ml'"

check "L10 Cycle B: LiquidMeasure is the extracted module, listed in dune" \
    grep -q 'LiquidMeasure' "$repo_root/lib/liquid/dune"

# --- H12: agent notes (four implemented categories, one per non-trivial PR) ---
check "H12: notes implemented dir has the four categories" \
    test -d "$repo_root/.agents/notes/implemented/architecture" \
    && test -d "$repo_root/.agents/notes/implemented/feature" \
    && test -d "$repo_root/.agents/notes/implemented/testing" \
    && test -d "$repo_root/.agents/notes/implemented/process"

echo
echo "verify-invariants: $PASSED passed, $GAPS explained gap(s), $FAILED failed"
if [ "$FAILED" -gt 0 ]; then
    exit 1
fi
exit 0
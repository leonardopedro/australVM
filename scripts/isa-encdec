#!/usr/bin/env python3
"""isa-encdec — generate (and check) the ISA model's encdec table and proofs.

`mm0/isa.mm0` used to state the byte round trip as one axiom over uninterpreted
`enc`/`dec`. That is not provable, and it was not a statement about anything:
MM0 has no pattern matching, so a codec can only be *stated* finitely. This
script writes that finite statement for the 23 opcodes `ISA_REGISTRY` declares,
and with it the proof of `decode (encode i) = i` for each instruction:

    term ins_add: Ins;                                    -- the instruction
    axiom enc_add: $ beq (ienc ins_add) n5 $;              -- its byte (0x05)
    axiom dec_add: $ ieq (idec n5) ins_add $;              -- and back
    theorem encdec_add: $ ieq (idec (ienc ins_add)) ins_add $;

The theorem follows from the two equations by congruence and transitivity, so it
is proved rather than assumed (`scripts/verify-invariants` re-checks it with
mm0-rs + mm0-c every run). What is now trusted is the *table* — 23 lines saying
"this instruction is this byte" — and that table is not a memory: it is the same
table `safestos/cranelift/src/isa.rs` holds (`scripts/isa-census` compares it to
the JIT's decoder) and `lib/Cps_codec.ml` holds (`test/CpsCodecTest.ml` compares
it to the artifact). Three checked copies, no fourth uncheckable one.

`mm0/isa.mm1` is the proof file for the same specification: MM0 splits the
`.mm0` (what is claimed, read by mm0-c) from the proofs (read by mm0-rs), and a
theorem in the proof file is spelled `pub theorem ... = '(proof)`. The `.mm1` is
derived from the `.mm0` here, so the two cannot drift.

Usage:
    scripts/isa-encdec            # check the committed artifacts are up to date
    scripts/isa-encdec --write    # rewrite mm0/isa.mm0 and mm0/isa.mm1
Exit: 0 current/proved, 1 stale or malformed, 2 cannot run.
"""

import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
REGISTRY = ROOT / "safestos" / "cranelift" / "src" / "isa.rs"
ISA_MM0 = ROOT / "mm0" / "isa.mm0"
ISA_MM1 = ROOT / "mm0" / "isa.mm1"

BEGIN = "-- BEGIN GENERATED encdec (scripts/isa-encdec --write)"
END = "-- END GENERATED encdec"

OP = re.compile(r"opcode:\s*0x([0-9A-Fa-f]{2})\s*,\s*name:\s*\"([a-z_]+)\"")
NUMERAL = re.compile(r"^term\s+n(\d+):\s*nat;", re.MULTILINE)
THEOREM = re.compile(r"^theorem\s+(encdec_[a-z_]+):\s*(\$.*\$)\s*;$", re.MULTILINE)


def registry():
    """The opcode table, from the Rust registry (the JIT-side source of truth)."""
    text = REGISTRY.read_text()
    ops = [(int(b, 16), name) for b, name in OP.findall(text)]
    if not ops:
        raise SystemExit("isa-encdec: no (opcode, name) pairs in ISA_REGISTRY")
    if len(ops) != len({b for b, _ in ops}) or len(ops) != len({n for _, n in ops}):
        raise SystemExit("isa-encdec: ISA_REGISTRY repeats an opcode or a name")
    return sorted(ops)


# The theorems that are not table instances: one proof term each. A theorem in
# `isa.mm0` that is in neither this table nor the table-derived set is an error,
# never a silent `sorry` — a certificate must not assert what it has not proved.
#
# A `.mm0` statement with premises is written here as `$ A $ > $ B $ > $ C $`
# (MM0 has no named hypothesis binders), but the proof file can name them, and
# this script does: the statement is split on `$ > $` and the premises become
# binders `h1 .. hn`. That is what lets the proofs be plain terms — no lambda
# syntax is involved, and the `.mm1` statement is *derived* from the `.mm0` one,
# so the two cannot say different things. mm0-c independently re-checks the
# compiled result against `isa.mm0` either way.
STEP_PROOFS = {
    # Both sides compute `radd (reg s a) (reg s b)` into `dst`; symmetry and
    # transitivity of `req` close it. `h1..h3` (linear/in_bounds) are unused.
    #
    # Term arguments are *inferred* in proof position — writing
    # `(run_add_def s dst a b)` here is read as applying the theorem to a proof
    # named `s` and fails with "too many arguments" (measured). So the terms
    # stay bare and unification recovers them from the goal.
    "add_refines": "req_trans run_add_def (req_symm ir_add_sem)",
    "mul_refines": "req_trans run_mul_def (req_symm ir_mul_sem)",
    "sub_refines": "req_trans run_sub_def (req_symm ir_sub_sem)",
}


def _split_head(text):
    """Split `theorem ... (binders): formula` at the colon outside parens."""
    depth = 0
    for i, ch in enumerate(text):
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
        elif ch == ":" and depth == 0:
            return text[:i], text[i + 1:]
    raise SystemExit("isa-encdec: a theorem statement has no `:` before its formula")


def _norm(text):
    return " ".join(text.split())


def step_theorem(stmt, term):
    """`theorem` statement + proof term -> a `pub theorem` line with named hyps."""
    head, formula = _split_head(stmt)
    m = re.match(r"^theorem\s+([A-Za-z0-9_]+)(.*)$", head, re.S)
    if not m:
        raise SystemExit(f"isa-encdec: cannot parse theorem head {head!r}")
    name, binders = m.group(1), _norm(m.group(2))
    # The statement is `$ A $ > $ B $ > $ C $`: the separator swallows the two
    # `$` delimiters it sits between, so each piece is re-wrapped as a formula.
    parts = [p.strip("$").strip() for p in _norm(formula).split("$ > $")]
    if len(parts) == 1:
        return f"pub theorem {name} {binders}: {parts[0]} = '({term});"
    hyps = " ".join(f"(h{i + 1}: $ {p} $)" for i, p in enumerate(parts[:-1]))
    concl = f"$ {parts[-1]} $"
    return f"pub theorem {name} {binders} {hyps}: {concl} = '({term});"


def proof(name):
    if name in STEP_PROOFS:
        return STEP_PROOFS[name]
    return f"ieq_trans (beq_cong_dec enc_{name}) dec_{name}"


def block(ops, declared_numerals):
    """The generated section of the `.mm0` specification."""
    out = [BEGIN, ""]
    missing = sorted({byte for byte, _ in ops} - declared_numerals)
    if missing:
        out.append("-- Opcode bytes used by the table below (0x.. to decimal).")
        for byte in missing:
            out.append(f"term n{byte}: nat; prefix n{byte}: ${byte}$ prec max;")
        out.append("")
    out.append("-- The instruction set, one constant per opcode.")
    for _, name in ops:
        out.append(f"term ins_{name}: Ins;")
    out.append("")
    out.append("-- The table: instruction -> byte (`enc`) and byte -> instruction")
    out.append("-- (`dec`), then the round trip proved from the two, per instruction.")
    for byte, name in ops:
        out.append(f"axiom enc_{name}: $ beq (ienc ins_{name}) n{byte} $;")
        out.append(f"axiom dec_{name}: $ ieq (idec n{byte}) ins_{name} $;")
        out.append(
            f"theorem encdec_{name}: $ ieq (idec (ienc ins_{name})) ins_{name} $;"
        )
    out += ["", END]
    return "\n".join(out)


def splice(mm0_text, generated):
    start = mm0_text.find(BEGIN)
    end = mm0_text.find(END)
    if start < 0 or end < 0 or end < start:
        raise SystemExit(f"isa-encdec: {ISA_MM0} has no generated-section markers")
    end += len(END)
    return mm0_text[:start] + generated + mm0_text[end:]


def proof_file(mm0_text):
    """`isa.mm1` = the same specification, with a proof clause per theorem.

    Statements can span lines (the refinements do), so this scans per theorem
    rather than per line: a `theorem name:` opens a statement that ends at the
    first line ending in `;`. Any theorem name without a proof term is fatal.
    """
    lines = mm0_text.splitlines()
    out = []
    n = 0
    i = 0
    while i < len(lines):
        line = lines[i]
        m = re.match(r"^theorem\s+([A-Za-z0-9_]+)\b", line)
        if not m:
            out.append(line)
            i += 1
            continue
        name = m.group(1)
        chunk = [line]
        while not chunk[-1].rstrip().endswith(";"):
            i += 1
            if i >= len(lines):
                raise SystemExit(f"isa-encdec: theorem {name} never ends with `;`")
            chunk.append(lines[i])
        stmt = "\n".join(chunk).rstrip()[:-1]  # drop the terminating `;`
        if name.startswith("encdec_"):
            term = proof(name[len("encdec_"):])
            # No premises: the statement text is copied verbatim, with the
            # visibility marker added, so it cannot drift from the `.mm0`.
            out.append(re.sub(r"^theorem\b", "pub theorem", stmt) + f" = '({term});")
        elif name in STEP_PROOFS:
            out.append(step_theorem(stmt, STEP_PROOFS[name]))
        else:
            raise SystemExit(
                f"isa-encdec: theorem {name} has no proof term — add one to "
                "STEP_PROOFS rather than emitting an unproved theorem"
            )
        n += 1
        i += 1

    if n == 0:
        raise SystemExit("isa-encdec: the specification has no theorems")
    header = (
        "-- isa.mm1 — the proof file for mm0/isa.mm0 (generated by\n"
        "-- scripts/isa-encdec --write; do not edit).\n"
        "--\n"
        "-- MM0 splits the specification (`.mm0`, read by mm0-c, the root of\n"
        "-- trust) from the proofs (this file, read by mm0-rs). Every theorem\n"
        "-- below is `pub` because a theorem with an explicit proof is what the\n"
        f"-- proof file contributes: {n} theorem(s) — the encdec instances\n"
        "-- (discharged by the table's two equations plus `ieq_trans`/\n"
        "-- `beq_cong_dec`) and the step refinements.\n\n"
    )
    return header + "\n".join(out)


def main(argv):
    write = "--write" in argv[1:]
    ops = registry()
    current = ISA_MM0.read_text()
    # Numerals declared by hand (outside the generated region) must not be
    # re-declared; scanning the whole file would make `--write` non-idempotent,
    # because its own output declares the ones it needs.
    outside = current
    if BEGIN in outside and END in outside:
        head, rest = outside.split(BEGIN, 1)
        outside = head + rest.split(END, 1)[1]
    declared = {int(n) for n in NUMERAL.findall(outside)}
    want_mm0 = splice(current, block(ops, declared))
    want_mm1 = proof_file(want_mm0)

    if write:
        ISA_MM0.write_text(want_mm0)
        ISA_MM1.write_text(want_mm1)
        print(f"isa-encdec: wrote {len(ops)} table entries and {len(ops)} proofs")
        return 0

    problems = []
    if current != want_mm0:
        problems.append(f"{ISA_MM0} is stale — run scripts/isa-encdec --write")
    if not ISA_MM1.is_file():
        problems.append(f"{ISA_MM1} is missing — run scripts/isa-encdec --write")
    elif ISA_MM1.read_text() != want_mm1:
        problems.append(f"{ISA_MM1} is stale — run scripts/isa-encdec --write")

    proved = len(THEOREM.findall(want_mm0))
    if proved != len(ops):
        problems.append(f"{proved} proved instance(s) for {len(ops)} table entries")
    for name in STEP_PROOFS:
        if not re.search(rf"^theorem\s+{name}\b", want_mm0, re.MULTILINE):
            problems.append(f"step theorem {name} is missing from {ISA_MM0.name}")
        if re.search(rf"^axiom\s+{name}\b", want_mm0, re.MULTILINE):
            problems.append(
                f"{name} is an axiom again — it was proved, so an axiom there "
                "would be the assumption coming back"
            )

    if problems:
        for p in problems:
            print(f"isa-encdec: FAIL {p}", file=sys.stderr)
        return 1
    print(
        f"isa-encdec: {len(ops)}/{len(ops)} encdec instances proved from the table, "
        f"{len(STEP_PROOFS)} step refinement(s) proved; "
        "mm0/isa.mm0 and mm0/isa.mm1 are current"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

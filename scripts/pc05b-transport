#!/usr/bin/env python3
"""PC05b checks: transport the clamp bound through the reflected WGSL edge.

`mm0/proof_chain/clamp_transport.mm0` is generated here from the committed
`clamp_wgsl.mm0` (PC05a). It is the *transport* fragment, not a second
reflection: it consumes `wgsl_clamp` and PC05a's theorem, and applies PC03's
`transfer_through_eq` twice — once to take the shader bound out of PC05a, once
to move it from the shader's value to the value the device returns. The nested
proof term is the dependency record: without `wgsl_inherits_source_bound` the
transport does not check, which control `drop-import` measures.

The four residual premises are a register in the artifact header:

    -- premise: wrapper = wrapper_admits; the wrapper admits the invocation
    -- premise: extents = extent_guard; the runtime extent premise
    -- premise: bindings = binding_index; the binding/index correspondence
    -- premise: native = native_agrees; the device returns the shader's value

`native` is consumed by the proof; the other three gate PC06's bundle claim and
are recorded here rather than assumed. The *strict profile* is a structural
check on that register: every premise must be registered exactly once, must map
to the declared term, must appear in `transported_bound`'s statement, and must
stay **open** (no theorem of this artifact concludes it). Removing a premise
row, removing the premise from the statement, or changing the proof subject is
refused — the artifact cannot shrink its obligations while still reading check.

No declaration here is an axiom, and no Why3 arithmetic goal corresponds to
these premises (the GPU chain has no Why3 artifact), so nothing is left green
on a prover assertion: the clamp bound is MM0-discharged by PC02/PC05a.

Exit 0 = checked, 1 = a check or a control failed, 3 = replay skipped because
`mm0-rs`/`mm0-c` are absent (a gap, never a pass).
"""

from __future__ import annotations

import hashlib
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CHAIN = ROOT / "mm0/proof_chain"
WORD_MM0, WORD_MM1 = CHAIN / "word.mm0", CHAIN / "word.mm1"
SOURCE_MM0, SOURCE_MM1 = CHAIN / "clamp_source.mm0", CHAIN / "clamp_source.mm1"
EDGE_MM0, EDGE_MM1 = CHAIN / "clamp_wgsl.mm0", CHAIN / "clamp_wgsl.mm1"
REL_MM0, REL_MM1 = CHAIN / "relation.mm0", CHAIN / "relation.mm1"
ART_MM0, ART_MM1 = CHAIN / "clamp_transport.mm0", CHAIN / "clamp_transport.mm1"

# name -> (declared term, what the premise is). The artifact's `-- premise:`
# rows must name exactly these, in this order.
PREMISES = {
    "wrapper": ("wrapper_admits", "the wrapper admits the invocation (roles, guard, freshness)"),
    "extents": ("extent_guard", "the runtime extent premise (i <= arrayLength(&input0))"),
    "bindings": ("binding_index", "the binding/index correspondence (input0[i] -> output0[i])"),
    "native": ("native_agrees", "the device returns the value the shader computes"),
}
CONSUMED = ("native",)


def fail(name: str, detail: str = "") -> None:
    print(f"[FAIL] PC05b: {name}{': ' + detail if detail else ''}")


def run(cmd: list[str], stdin=None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, stdin=stdin, capture_output=True, text=True)


def edge_evidence(edge_text: str) -> dict[str, str]:
    """The facts the transport inherits from the committed edge artifact."""
    facts: dict[str, str] = {}
    for key in ("wgsl_sha256", "ir_sha256"):
        match = re.search(rf"^-- {key}=([0-9a-f]{{64}})$", edge_text, re.M)
        if not match:
            raise SystemExit(f"[FAIL] PC05b: clamp_wgsl.mm0 records no {key}")
        facts[key] = match.group(1)
    match = re.search(r"^-- reflect-wgsl: (.*)$", edge_text, re.M)
    if not match:
        raise SystemExit("[FAIL] PC05b: clamp_wgsl.mm0 records no -- reflect-wgsl: line")
    facts["reflect"] = match.group(1).strip()
    literal = re.search(r"\bliteral=(\d+)\b", facts["reflect"])
    if not literal:
        raise SystemExit("[FAIL] PC05b: the reflected edge records no literal")
    facts["bound"] = f"u{literal.group(1)}"
    return facts


def render(facts: dict[str, str], edge_sha256: str) -> tuple[str, str]:
    """The transport fragment and its proofs, as text."""
    premise_rows = "\n".join(
        f"-- premise: {name} = {term}; {text}" for name, (term, text) in PREMISES.items()
    )
    consumed = ", ".join(f"`{name}`" for name in CONSUMED)
    bound = facts["bound"]
    decls = (
        "-- clamp_transport.mm0 — PC05b transport of the clamp bound through the\n"
        "-- reflected WGSL edge (generated by `scripts/pc05b-transport --write`).\n"
        "--\n"
        "-- transport-from: mm0/proof_chain/clamp_wgsl.mm0\n"
        f"-- edge_sha256={edge_sha256}\n"
        f"-- wgsl_sha256={facts['wgsl_sha256']}\n"
        f"-- ir_sha256={facts['ir_sha256']}\n"
        f"-- reflect-wgsl: {facts['reflect']}\n"
        "-- subject: wgsl_clamp\n"
        f"-- bound: {bound}\n"
        "--\n"
        f"{premise_rows}\n"
        "--\n"
        "-- The register is a *record* with a strict profile, not a pretended proof:\n"
        f"-- the transport proof consumes {consumed} only. `wrapper`, `extents` and\n"
        "-- `bindings` are stated here and consumed by PC06's bundle claim; this\n"
        "-- artifact fixes where they are stated, and the profile refuses an artifact\n"
        "-- that shrinks the register or drops a premise from the statement.\n"
        "--\n"
        "-- No Why3 arithmetic goal corresponds to these premises (the GPU chain has no\n"
        "-- Why3 artifact), so nothing here is left green on a prover assertion: the\n"
        "-- bound is MM0-discharged by PC02 and PC05a. No declaration below is an axiom.\n"
        "--\n"
        "-- layer: PC05b obligation discharge\n"
        "-- status: theory fragment — assembled after word.mm0, clamp_source.mm0,\n"
        "--   clamp_wgsl.mm0 and relation.mm0 by `scripts/pc05b-transport`.\n"
        "--\n"
        "-- WHY THIS IS NOT A SECOND REFLECTION. `wgsl_clamp` is PC05a's, and its bound\n"
        "-- is PC05a's theorem. What is new is the edge: the target word is the shader's\n"
        "-- value, and the device's word is that target. Both steps are PC03's\n"
        "-- `transfer_through_eq`, so a changed lower shader changes the edge evidence\n"
        "-- (the digests above and `clamp_wgsl.mm0`) and leaves this statement alone.\n"
        "\n"
        "-- ── The edge and the residual premises ──────────────────────────────\n"
        "-- The target word is the shader's value for the invocation's parameter.\n"
        "def wgsl_edge (x y: u32): Prop = $ ueq (wgsl_clamp x) y $;\n"
        "\n"
        "-- The wrapper premise is uninterpreted on purpose: this fragment proves\n"
        "-- nothing about the wrapper, and an uninterpreted term cannot be conjured\n"
        "-- into a proof.\n"
        "term wrapper_admits (i: u32): Prop;\n"
        "\n"
        "-- The runtime extent premise and the binding/index correspondence are the\n"
        "-- equations PC06 will consume; `native_agrees` is the device-level edge.\n"
        "def extent_guard (i len: u32): Prop = $ ule i len $;\n"
        "def binding_index (i j: u32): Prop = $ ueq i j $;\n"
        "def native_agrees (y n: u32): Prop = $ ueq y n $;\n"
        "\n"
        "-- ── The transported bound ──────────────────────────────────────────\n"
        "-- Shader level: PC05a's bound, taken along the reflected edge.\n"
        "theorem shader_edge_bound (x y: u32)\n"
        f"    (edge: $ wgsl_edge x y $): $ ule y {bound} $;\n"
        "\n"
        "-- Device level: the same bound at the value the device returns. All four\n"
        "-- premises are in the signature; `native` is what the proof consumes.\n"
        "theorem transported_bound (x i j y len n: u32)\n"
        "    (edge: $ wgsl_edge x y $)\n"
        "    (hw: $ wrapper_admits i $)\n"
        "    (he: $ extent_guard i len $)\n"
        "    (hb: $ binding_index i j $)\n"
        f"    (hn: $ native_agrees y n $): $ ule n {bound} $;\n"
    )
    proofs = (
        "-- clamp_transport.mm1 — proofs for clamp_transport.mm0 (PC05b).\n"
        "--\n"
        "-- Two applications of PC03's `transfer_through_eq`, the first over PC05a's\n"
        "-- `wgsl_inherits_source_bound`: the dependency on the earlier theorem is the\n"
        "-- nested proof term, not a comment. Dropping that theorem's proof refuses\n"
        "-- this file (`scripts/pc05b-transport`, control `drop-import`).\n"
        "def wgsl_edge (x y: u32): Prop = $ ueq (wgsl_clamp x) y $;\n"
        "term wrapper_admits (i: u32): Prop;\n"
        "def extent_guard (i len: u32): Prop = $ ule i len $;\n"
        "def binding_index (i j: u32): Prop = $ ueq i j $;\n"
        "def native_agrees (y n: u32): Prop = $ ueq y n $;\n"
        "pub theorem shader_edge_bound (x y: u32)\n"
        f"    (edge: $ wgsl_edge x y $): $ ule y {bound} $\n"
        "  = '(transfer_through_eq wgsl_inherits_source_bound edge);\n"
        "pub theorem transported_bound (x i j y len n: u32)\n"
        "    (edge: $ wgsl_edge x y $)\n"
        "    (hw: $ wrapper_admits i $)\n"
        "    (he: $ extent_guard i len $)\n"
        "    (hb: $ binding_index i j $)\n"
        f"    (hn: $ native_agrees y n $): $ ule n {bound} $\n"
        "  = '(transfer_through_eq (transfer_through_eq wgsl_inherits_source_bound edge) hn);\n"
    )
    return decls, proofs


def theorem_bodies(text: str) -> dict[str, tuple[str, str]]:
    """name -> (signature, conclusion) for each `theorem` statement."""
    out: dict[str, tuple[str, str]] = {}
    # The signature starts at the parameter list: a `:` inside it (`x i: u32`)
    # is not the statement's colon, so the pattern closes on `):`.
    for match in re.finditer(r"^theorem (\w+)\s*(\(.*?\)):(.*?);", text, re.M | re.S):
        name, signature, body = match.group(1), match.group(2), match.group(3)
        parts = re.findall(r"\$([^$]*)\$", body)
        out[name] = (signature, parts[-1].strip() if parts else "")
    return out


EXPECTED_SUBJECT = "wgsl_clamp"


def profile(mm0: str, facts: dict[str, str]) -> list[str]:
    """The strict profile: the premise register and the proof subject."""
    problems: list[str] = []

    if re.search(r"^\s*axiom\s", mm0, re.M):
        problems.append("the artifact declares an axiom")

    # The subject and the bound are pins, not prose: the proof is about PC05a's
    # shader value at the bound the reflected edge records, so an artifact that
    # drifts onto another term or another literal is refused here.
    subject = re.search(r"^-- subject: (\w+)$", mm0, re.M)
    if not subject:
        problems.append("the artifact records no `-- subject:`")
    elif subject.group(1) != EXPECTED_SUBJECT:
        problems.append(
            f"the recorded subject is {subject.group(1)!r}, expected {EXPECTED_SUBJECT!r}"
        )
    edge = re.search(r"^def wgsl_edge \(.*?= (.*?);", mm0, re.M | re.S)
    if not edge:
        problems.append("the artifact defines no `wgsl_edge`")
    elif EXPECTED_SUBJECT not in edge.group(1):
        problems.append(f"`wgsl_edge` does not mention the subject {EXPECTED_SUBJECT!r}")
    bound = re.search(r"^-- bound: (\w+)$", mm0, re.M)
    if not bound:
        problems.append("the artifact records no `-- bound:`")
    elif bound.group(1) != facts["bound"]:
        problems.append(
            f"the recorded bound is {bound.group(1)!r}, the edge's is {facts['bound']!r}"
        )

    rows = re.findall(r"^-- premise: (\w+) = (\w+)(?:; (.*))?$", mm0, re.M)
    names = [row[0] for row in rows]
    if names != list(PREMISES):
        problems.append(f"the premise register is {names}, expected {list(PREMISES)}")
    for name, term, text in rows:
        expected = PREMISES.get(name)
        if expected is None:
            problems.append(f"unregistered premise {name!r}")
            continue
        if term != expected[0]:
            problems.append(f"premise {name!r} names {term!r}, expected {expected[0]!r}")
        if not (text or "").strip():
            problems.append(f"premise {name!r} carries no description")

    theorems = theorem_bodies(mm0)
    if "transported_bound" not in theorems:
        problems.append("the artifact states no `transported_bound`")
        return problems
    signature, _ = theorems["transported_bound"]
    for name, (term, _text) in PREMISES.items():
        if term not in signature:
            problems.append(f"premise {name!r} is not a hypothesis of `transported_bound`")
        # Every premise must stay open: no theorem of this artifact concludes it.
        for theorem, (_sig, conclusion) in theorems.items():
            if conclusion.startswith(term):
                problems.append(
                    f"premise {name!r} is concluded by `{theorem}` instead of staying open"
                )
    if len(theorems) != 2:
        problems.append(
            f"the artifact states {len(theorems)} theorem(s), expected 2 "
            "(shader_edge_bound, transported_bound)"
        )
    return problems


def assemble(tmp: Path, edge_mm0: str, edge_mm1: str, art_mm0: str, art_mm1: str,
             drop_import: bool = False) -> tuple[Path, Path]:
    spec = tmp / "all.mm0"
    proof = tmp / "all.mm1"
    spec.write_text(
        WORD_MM0.read_text() + SOURCE_MM0.read_text() + edge_mm0
        + REL_MM0.read_text() + art_mm0
    )
    edge_proofs = edge_mm1
    if drop_import:
        # PC05a's bound theorem loses its proof: the transport's nested
        # application must then fail, which is what makes the dependency real.
        edge_proofs = re.sub(
            r"pub theorem wgsl_inherits_source_bound.*?;\n", "", edge_mm1, flags=re.S
        )
        if edge_proofs == edge_mm1:
            raise SystemExit("[FAIL] PC05b: control 'drop-import' did not apply")
    proof.write_text(
        WORD_MM1.read_text() + SOURCE_MM1.read_text() + edge_proofs
        + REL_MM1.read_text() + art_mm1
    )
    return spec, proof


def replay(tmp: Path, spec: Path, proof: Path, mmb_name: str) -> tuple[int, str]:
    mmb = tmp / mmb_name
    compiled = run(["mm0-rs", "compile", str(proof), str(mmb)])
    if compiled.returncode != 0:
        return 1, (compiled.stdout or compiled.stderr)
    checked = run(["mm0-c", str(mmb)], stdin=spec.open())
    if checked.returncode != 0:
        return 1, (checked.stdout or checked.stderr)
    return 0, ""


def statements(text: str) -> str:
    """The artifact without its comment lines."""
    return "\n".join(line for line in text.splitlines() if not line.startswith("--"))


def main() -> int:
    write = "--write" in sys.argv[1:]
    failures = 0

    edge_mm0 = EDGE_MM0.read_text()
    edge_mm1 = EDGE_MM1.read_text()
    facts = edge_evidence(edge_mm0)
    edge_sha256 = hashlib.sha256(EDGE_MM0.read_bytes()).hexdigest()
    mm0, mm1 = render(facts, edge_sha256)

    if write:
        ART_MM0.write_text(mm0)
        ART_MM1.write_text(mm1)
        print(f"  [detail] wrote {ART_MM0.relative_to(ROOT)} and {ART_MM1.relative_to(ROOT)}")
        return 0

    # 1. The committed artifact is the current emission from the edge it names.
    for path, expected in ((ART_MM0, mm0), (ART_MM1, mm1)):
        if not path.exists():
            fail(f"{path.relative_to(ROOT)} is committed")
            failures += 1
        elif path.read_text() != expected:
            fail(
                f"{path.relative_to(ROOT)} is the current emission",
                "regenerate with `scripts/pc05b-transport --write`",
            )
            failures += 1
    if failures:
        return 1
    committed_mm0 = ART_MM0.read_text()
    committed_mm1 = ART_MM1.read_text()
    recorded = re.search(r"^-- edge_sha256=([0-9a-f]{64})$", committed_mm0, re.M)
    if recorded and recorded.group(1) != edge_sha256:
        fail(
            "the transport names the edge artifact it was emitted from",
            "clamp_wgsl.mm0 changed: the transport needs new edge evidence",
        )
        failures += 1
    print("  [detail] clamp_transport.mm0 re-emits byte-identically from clamp_wgsl.mm0")

    # 2. The strict profile, structurally, without needing the toolchain.
    for problem in profile(committed_mm0, facts):
        fail("strict profile", problem)
        failures += 1
    if not failures:
        print(
            "  [detail] strict profile: "
            + ", ".join(f"{n}={t}" for n, (t, _) in PREMISES.items())
            + f"; consumed: {', '.join(CONSUMED)}"
        )

    # 3. A changed lower shader needs new edge evidence and leaves the
    # statement alone. The edge's digests and reflect line are what change; the
    # theorem statements must be byte-identical.
    changed = edge_mm0.replace("workgroup=64", "workgroup=32")
    changed = re.sub(
        r"^-- wgsl_sha256=[0-9a-f]{64}$", "-- wgsl_sha256=" + "0" * 64, changed, flags=re.M
    )
    if changed == edge_mm0:
        fail("control 'changed shader' applies", "no workgroup/digest line to change")
        failures += 1
    else:
        new_mm0, _new_mm1 = render(
            edge_evidence(changed), hashlib.sha256(changed.encode()).hexdigest()
        )
        if new_mm0 == committed_mm0:
            fail("a changed lower shader requires new edge evidence")
            failures += 1
        elif statements(new_mm0) != statements(committed_mm0):
            fail(
                "a changed lower shader leaves the transported statement stable",
                "only the recorded edge evidence may move",
            )
            failures += 1
        else:
            print(
                "  [detail] a changed shader moves the edge evidence "
                "(edge_sha256/wgsl_sha256) and leaves the theorem statements stable"
            )

    # 4. Refusals the strict profile owns (no toolchain needed).
    structural = [
        ("a removed premise row is refused",
         re.sub(r"^-- premise: extents = .*$", "", committed_mm0, count=1, flags=re.M)),
        ("a re-labelled premise is refused",
         committed_mm0.replace("-- premise: native = native_agrees",
                               "-- premise: native = wrapper_admits", 1)),
        ("an axiom is refused",
         committed_mm0.replace(
             "def wgsl_edge",
             "axiom pc05b_shortcut (x: u32): $ ule x u100 $;\ndef wgsl_edge", 1)),
        ("a premise dropped from the statement is refused",
         committed_mm0.replace("    (he: $ extent_guard i len $)\n", "", 1)),
        ("a changed proof subject is refused",
         committed_mm0.replace("$ ueq (wgsl_clamp x) y $", "$ ueq (ujoin x u100) y $", 1)),
        ("a changed recorded bound is refused",
         committed_mm0.replace("-- bound: u100", "-- bound: u101", 1)),
        ("a premise concluded by a theorem is refused",
         committed_mm0.replace(
             "theorem shader_edge_bound",
             "theorem extents_are_free (i len: u32): $ extent_guard i len $;\n"
             "theorem shader_edge_bound", 1)),
        ("a third theorem is refused",
         committed_mm0.replace(
             "theorem shader_edge_bound",
             "theorem extra_claim (x: u32): $ ule x u100 $;\n"
             "theorem shader_edge_bound", 1)),
    ]
    for name, mutated in structural:
        if mutated == committed_mm0:
            fail(f"control {name!r} applies", "the mutation changed nothing")
            failures += 1
        elif profile(mutated, facts):
            print(f"  [detail] {name}")
        else:
            fail(name)
            failures += 1

    # 5. Replay, and the proofs the replay owns.
    if not (shutil.which("mm0-rs") and shutil.which("mm0-c")):
        print(
            "[gap] PC05b: clamp_transport.mm0 not replayed (no mm0-rs/mm0-c on PATH; "
            "`nix build .#mm0` and put its bin/ on PATH)"
        )
        return 3 if failures == 0 else 1

    with tempfile.TemporaryDirectory(prefix="pc05b-") as tmp_name:
        tmp = Path(tmp_name)
        spec, proof = assemble(tmp, edge_mm0, edge_mm1, committed_mm0, committed_mm1)
        status, message = replay(tmp, spec, proof, "all.mmb")
        if status:
            print(message, file=sys.stderr)
            fail("word+clamp_source+clamp_wgsl+relation+clamp_transport check")
            return 1
        print("  [detail] the assembled chain accepts the transported bound")

        proof_controls = [
            ("dropping PC05a's bound proof refuses the transport",
             committed_mm0, committed_mm1, True),
            # A different *operator*, not `ir_clamp`: the two clamp definitions
            # are definitionally equal, so a subject mutation onto one of them
            # would legitimately still check.
            ("changing the proof subject refuses the transport",
             committed_mm0.replace("$ ueq (wgsl_clamp x) y $", "$ ueq (ujoin x u100) y $", 1),
             committed_mm1.replace("$ ueq (wgsl_clamp x) y $", "$ ueq (ujoin x u100) y $", 1),
             False),
            ("dropping the consumed premise from the statement refuses the transport",
             committed_mm0.replace("    (hn: $ native_agrees y n $)", "", 1),
             committed_mm1, False),
            ("dropping the consumed premise from the proof refuses the transport",
             committed_mm0.replace("    (hn: $ native_agrees y n $)", "", 1),
             committed_mm1.replace("    (hn: $ native_agrees y n $)", "", 1)
             .replace("(transfer_through_eq wgsl_inherits_source_bound edge) hn",
                      "(transfer_through_eq wgsl_inherits_source_bound edge)"), False),
        ]
        for name, art_mm0, art_mm1, drop_import in proof_controls:
            if (not drop_import) and art_mm0 == committed_mm0 and art_mm1 == committed_mm1:
                fail(f"control {name!r} applies", "the mutation changed nothing")
                failures += 1
                continue
            control_dir = tmp / re.sub(r"[^a-z0-9]+", "-", name.lower())[:48]
            control_dir.mkdir()
            control_spec, control_proof = assemble(
                control_dir, edge_mm0, edge_mm1, art_mm0, art_mm1,
                drop_import=drop_import,
            )
            status, message = replay(control_dir, control_spec, control_proof, "c.mmb")
            if status == 0:
                fail(name, "the mutated chain still checks")
                failures += 1
            else:
                print(f"  [detail] {name}")

    if failures:
        fail(f"transport of the clamp bound through the reflected edge ({failures} failure(s))")
        return 1
    print("[pass] PC05b transport of the clamp bound through the reflected edge")
    return 0


if __name__ == "__main__":
    sys.exit(main())

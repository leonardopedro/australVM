#!/usr/bin/env bash
# avm-test-census — the avm-pkg CI step's test census, as a unit that can be
# tested instead of only being read.
#
# The step runs `cargo test --workspace` under `tee`, and the log of a failed
# step needs admin rights to read, so the per-binary split is reported as
# annotations, which the run page shows on its own: one line per test binary
# (name + passed/failed/ignored) plus, on failure, the tail of the log. This
# script is that half of the step, so the failure path (`::error`, not
# `::notice`; the census lines; the annotated tail) has a fixture in the repo
# and runs in the same job that depends on it — the step calls `selftest` first.
#
# Usage:   avm-test-census [--status N] LOGFILE     report on LOGFILE, exit N
#          avm-test-census selftest                 exercise both paths here
#
# The status argument is cargo's exit status, passed by the caller so this
# script never runs cargo: the census is a pure function of (log, status).
set -uo pipefail

SELF=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")

# The census itself. Cargo colours its output on the runner even through a pipe,
# so the escape sequences are stripped before the `Running`/`Doc-tests` prefixes
# are matched: with them in place every line was attributed to an empty binary
# name (observed on 3b47bfdc). Empty doc-test runs are skipped, both for noise
# and because GitHub shows at most ten annotations per step.
census() {  # LOGFILE OUTFILE
    awk '
      {
        line = $0
        gsub(/\033\[[0-9;]*m/, "", line)
        if (line ~ /^[[:space:]]*Running /) {
          if (match(line, /\(([^)]*)\)/)) {
            bin = substr(line, RSTART + 1, RLENGTH - 2)
            sub(/.*\//, "", bin)
            sub(/-[0-9a-f]+$/, "", bin)
          } else {
            split(line, f, /[[:space:]]+/)
            bin = f[3]; sub(/.*\//, "", bin); sub(/\..*/, "", bin)
          }
        } else if (line ~ /^[[:space:]]*Doc-tests /) {
          sub(/^[[:space:]]*Doc-tests[[:space:]]+/, "", line)
          bin = "doc-tests " line
        } else if (line ~ /^test result:/) {
          sub(/; finished in .*/, "", line)
          if (bin ~ /^doc-tests / && line ~ / 0 passed; 0 failed/) next
          printf "%s: %s\n", bin, line
        }
      }
    ' "$1" > "$2"
    if [ ! -s "$2" ]; then
        printf '%s\n' \
            "[avm-pkg] no test binary reported a result: the workspace did not compile" > "$2"
    fi
}

report() {  # STATUS LOGFILE
    local status=$1 log=$2 out level
    out=$(mktemp) || exit 2
    census "$log" "$out"
    if [ "$status" -eq 0 ]; then level=notice; else level=error; fi
    while IFS= read -r line; do
        printf '::%s title=avm-pkg test census::%s\n' "$level" "$line"
    done < "$out"
    if [ "$status" -ne 0 ]; then
        tail -20 "$log" | while IFS= read -r line; do
            printf '::error title=avm-pkg test output::%s\n' "$line"
        done
    fi
    rm -f "$out"
}

# ── selftest ────────────────────────────────────────────────────────────────
# Three fixtures and four assertions per path. The green case is not decoration:
# it is what fails if the level switch ever sticks on `error`, and the coloured
# `Running` line is what fails if the SGR strip is dropped.
selftest() {
    local tmp failed=0
    tmp=$(mktemp -d) || { echo "selftest: no temporary directory" >&2; exit 2; }
    # The trap outlives this function (it fires at EXIT), so it may not name a
    # `local`.
    SELFTEST_TMP=$tmp
    trap 'rm -rf "$SELFTEST_TMP"' EXIT

    say() { printf '  %s\n' "$*"; }
    bad() { printf 'selftest: FAIL %s\n' "$*" >&2; failed=1; }
    has() { # label file needle
        grep -qF -- "$3" "$2" || bad "$1: missing line '$3'"
    }
    has_not() { # label file needle
        ! grep -qF -- "$3" "$2" || bad "$1: unexpected line '$3'"
    }
    same_rc() { # label expected file
        [ "$(cat "$2.rc")" = "$1" ] || bad "$3: exit $(cat "$2.rc"), expected $1"
    }

    # A green run: a coloured `Running` line plus an empty doc-test run, which
    # must be skipped rather than reported.
    {
        printf '%s\n' '   Compiling avm-cas v0.1.0 (/w/safestos/pkg/avm-cas)'
        printf '   \033[0;32m     Running\033[0m unittests src/lib.rs (/w/safestos/pkg/target/debug/deps/avm_cas-9f8e7d6c5b4a)\n'
        printf '%s\n' 'test result: ok. 31 passed; 0 failed; 6 ignored; 0 measured; 0 filtered out; finished in 0.02s'
        printf '%s\n' '   Doc-tests avm_cas'
        printf '%s\n' 'test result: ok. 0 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.00s'
    } > "$tmp/green.log"
    bash "$SELF" --status 0 "$tmp/green.log" > "$tmp/green.out" 2>&1
    echo $? > "$tmp/green.out.rc"
    same_rc 0 "$tmp/green.out" "green path"
    has "green path" "$tmp/green.out" \
        '::notice title=avm-pkg test census::avm_cas: test result: ok. 31 passed; 0 failed; 6 ignored'
    has_not "green path" "$tmp/green.out" 'doc-tests avm_cas:'
    has_not "green path" "$tmp/green.out" '::error'

    # A red run: the census line is an `error`, and the failure tail rides along
    # as its own annotations — that tail is the whole reason the step exists.
    {
        printf '%s\n' '   Compiling avm-pkg v0.1.0 (/w/safestos/pkg/avm-pkg)'
        printf '%s\n' '     Running unittests src/lib.rs (/w/safestos/pkg/target/debug/deps/avm_pkg-0a1b2c3d4e5f)'
        printf '%s\n' 'test result: FAILED. 22 passed; 1 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.11s'
        printf '%s\n' 'failures:'
        printf '%s\n' '    eval::tests::rejects_a_bad_digest'
        printf '%s\n' 'error: test failed, to rerun pass `--lib`'
    } > "$tmp/red.log"
    bash "$SELF" --status 101 "$tmp/red.log" > "$tmp/red.out" 2>&1
    echo $? > "$tmp/red.out.rc"
    same_rc 101 "$tmp/red.out" "red path"
    has "red path" "$tmp/red.out" \
        '::error title=avm-pkg test census::avm_pkg: test result: FAILED. 22 passed; 1 failed'
    has "red path" "$tmp/red.out" \
        '::error title=avm-pkg test output::error: test failed, to rerun pass `--lib`'
    has "red path" "$tmp/red.out" \
        '::error title=avm-pkg test output::    eval::tests::rejects_a_bad_digest'
    has_not "red path" "$tmp/red.out" '::notice'

    # A compile failure leaves no `test result:` line at all. The step must say
    # that, not print nothing and leave the reader with an empty step.
    {
        printf '%s\n' '   Compiling avm-vmm v0.1.0 (/w/safestos/pkg/avm-vmm)'
        printf '%s\n' 'error[E0432]: unresolved import `crate::missing`'
        printf '%s\n' 'error: could not compile `avm-vmm` (lib) due to 1 previous error'
    } > "$tmp/broken.log"
    bash "$SELF" --status 101 "$tmp/broken.log" > "$tmp/broken.out" 2>&1
    echo $? > "$tmp/broken.out.rc"
    same_rc 101 "$tmp/broken.out" "compile-failure path"
    has "compile-failure path" "$tmp/broken.out" \
        '::error title=avm-pkg test census::[avm-pkg] no test binary reported a result: the workspace did not compile'
    has "compile-failure path" "$tmp/broken.out" \
        '::error title=avm-pkg test output::error[E0432]: unresolved import `crate::missing`'

    # An unknown argument is a usage error, never a silent census of nothing.
    bash "$SELF" --bogus "$tmp/green.log" > "$tmp/usage.out" 2>&1
    echo $? > "$tmp/usage.out.rc"
    same_rc 2 "$tmp/usage.out" "usage path"

    if [ "$failed" -eq 0 ]; then
        say "selftest: green, red, compile-failure and usage paths all hold"
        return 0
    fi
    return 1
}

usage() {
    printf 'usage: %s [--status N] LOGFILE\n       %s selftest\n' "$(basename "$SELF")" "$(basename "$SELF")" >&2
    exit 2
}

main() {
    case "${1:-}" in
        selftest) [ $# -eq 1 ] || usage; selftest; exit $? ;;
        -h | --help) usage ;;
    esac
    local status=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --status)
                [ $# -ge 2 ] || usage
                case "$2" in '' | *[!0-9]*) usage ;; esac
                status=$2
                shift 2
                ;;
            --status=*)
                case "${1#--status=}" in '' | *[!0-9]*) usage ;; esac
                status=${1#--status=}
                shift
                ;;
            -*) usage ;;
            *) break ;;
        esac
    done
    [ $# -eq 1 ] || usage
    [ -f "$1" ] || { printf '%s: no such log: %s\n' "$(basename "$SELF")" "$1" >&2; exit 2; }
    report "$status" "$1"
    exit "$status"
}

main "$@"

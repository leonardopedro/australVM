#!/usr/bin/env bash
# w93-certification-drift-control — does the *whole gate* fail when
# `mm0/clif.mm0`'s certificate line disagrees with `mm0/approved/`?
#
# `W9.3: certification state matches mm0/approved/` is the check that keeps the
# refinement honest about whether the obligation is proved or merely stated: with
# no `mm0/approved/isa.stmts` it requires the line `-- certificate: [gap]`, and
# once an approval exists it requires the certificate to name it instead of the
# gap. Both branches have only been read, never seen refuse. The first one is
# cheap to measure and load-bearing — an artifact that quietly claims a
# certificate it does not have is exactly the drift this check exists for — so:
#
#   1. copy `mm0/clif.mm0` and rewrite the `-- certificate: [gap] …` line so it
#      claims `mm0/approved/isa.stmts`, leaving every other line (vocabulary,
#      citations, forms) alone. This script refuses to run if that approval
#      exists, because then the opposite branch is the one under test;
#   2. run `scripts/verify-invariants` with `AUSTRALVM_CLIF` pointing at the copy,
#      which moves only the checks that read that file — the corpus
#      re-derivation, which compares generated bytes with the committed path,
#      keeps reading the real one — and require exit 1;
#   3. require `[FAIL] W9.3: certification state matches mm0/approved/` and the
#      detail `no isa approval, yet clif.mm0 does not say [gap]`;
#   4. require the same run to still pass the other two checks that read the copy
#      (`clif_step` vocabulary, the pinned citations) and §W3's emitter and the
#      §W9.3 composition counts. One claim drifted, one failure.
#
# Nothing is written into the repository: the copy lives in a scratch directory
# and `mm0/approved/` is only read. This script cannot approve anything.
#
# Usage: scripts/w93-certification-drift-control   (under `nix develop`: the gate
#                                                  needs python3)
# Exit: 0 the control holds, 1 it does not, 2 could not run.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLIF="$ROOT/mm0/clif.mm0"
GATE="$ROOT/scripts/verify-invariants"
APPROVAL="$ROOT/mm0/approved/isa.stmts"

say()  { printf '%s\n' "$*"; }
fail() { printf 'w93-certification-drift-control: FAIL %s\n' "$*" >&2; }

command -v python3 >/dev/null 2>&1 || {
    say "w93-certification-drift-control: [gap] python3 not on PATH — run this under 'nix develop'"
    exit 2
}
[ -f "$CLIF" ] || { fail "no mm0/clif.mm0 at $CLIF"; exit 2; }
[ -f "$GATE" ] || { fail "no gate at $GATE"; exit 2; }
if [ -e "$APPROVAL" ]; then
    fail "mm0/approved/isa.stmts exists, so the [gap] branch is not the state under test"
    exit 2
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT INT TERM
perturbed="$work/clif.mm0"

# ── 1. the perturbation: one claim, one line ───────────────────────────────
python3 - "$CLIF" "$perturbed" <<'PY' || exit 2
import pathlib, sys
src, dst = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
lines = src.read_text().splitlines(keepends=True)
hits = 0
for i, line in enumerate(lines):
    if line.startswith("-- certificate: [gap]"):
        lines[i] = ("-- certificate: mm0/approved/isa.stmts — claimed by a control, "
                    "not by the owner\n")
        hits += 1
if hits != 1:
    raise SystemExit(f"expected exactly one '[gap]' certificate line, found {hits}")
dst.write_text("".join(lines))
PY
grep -qF -- '-- certificate: mm0/approved/isa.stmts' "$perturbed" \
    || { fail "the copy does not carry the claimed certificate"; exit 2; }
if grep -q '^-- certificate: \[gap\]' "$perturbed"; then
    fail "the copy still says [gap]"
    exit 2
fi
grep -qF -- '-- cites: mm0/slot_layout.mm0' "$perturbed" \
    || { fail "the copy lost its citations"; exit 2; }
say "perturbed: clif.mm0's certificate line claims mm0/approved/isa.stmts (citations kept)"

# ── 2. the whole gate, pointed at the copy ─────────────────────────────────
rc=0
( cd "$ROOT" && AUSTRALVM_CLIF="$perturbed" bash scripts/verify-invariants ) \
    >"$work/gate.log" 2>&1 || rc=$?
say "gate:      exit $rc"
tail -1 "$work/gate.log"

if [ "$rc" -eq 0 ]; then
    fail "the gate accepted a certificate claim with no approval behind it"
    exit 1
fi

# ── 3. it failed for the right reason ──────────────────────────────────────
line='[FAIL] W9.3: certification state matches mm0/approved/'
if ! grep -qF "$line" "$work/gate.log"; then
    fail "no '$line' in the run"
    exit 1
fi
detail='no isa approval, yet clif.mm0 does not say [gap]'
if ! grep -qF "$detail" "$work/gate.log"; then
    fail "the run does not say '$detail'"
    exit 1
fi
say "detail:    $detail"

# ── 4. everything else still passes ────────────────────────────────────────
missing=""
while IFS= read -r want; do
    grep -qF "$want" "$work/gate.log" || missing="$missing
  $want"
done <<'WANT'
[pass] W9.3: clif_step is vocabulary — declared, stated, never axiomatized
[pass] W9.3: the refinement's citations still match their artifacts (5 pinned)
[pass] W9.3: the composition table's counts match the files it records (4 row(s), 0 from mm0/approved/)
[pass] W3: every §W3 emitter cell names a real command
WANT
if [ -n "$missing" ]; then
    fail "the perturbation took other lines with it:$missing"
    exit 1
fi
say "control:   holds — one uncertified claim, the certification [FAIL], every other clif/§W3 line unchanged"
exit 0

#!/usr/bin/env python3
"""Run the typing-derivation pipeline over every chapter export, and re-check it.

A chapter export contains its *dependencies* as well as the declarations it
introduces, and those dependencies carry their own namespaces (`AbsoluteValue.abs`
appears in dozens of exports). A per-chapter total is therefore not a census: it
double-counts library declarations. This sweep records one row per
**declaration**, and de-duplicates by name, so the summary describes a population
of distinct proofs rather than of repetitions.

For each export it emits up to `--limit` declarations, verifies each with
`mm0-rs` + `mm0-c` (through `lean-proof-scan`), and then re-derives every artifact
that passed with `lean-typing-check` — the independent check that the derivation
follows the theory's rules.

`--own` aims the sample at the chapter's own declarations. Without it the
sample is drawn from the export's whole scope, which is its dependency closure:
measured over 686 sampled rows, not one was a declaration the exporting chapter
states (`mm0/statements/<stem>.roots`). Those declarations are what the chapter
contributed, so a census of them is the census that means anything.

Usage:
  lean-typing-sweep <export-dir> <out.tsv> [--limit N] [--max-mb M] [--chapters N]
                    [--own] [--roots-dir DIR[:DIR…]]

`--check-max-mb` skips the *self-check* of an artifact larger than that (the
emitter's proof term for one declaration measured 157 MB and took the checker
minutes and 7.7 GB); such a row is reported as over the cap, not as agreement.

`--roots-dir` adds a second place to look for a roots file — the 55 exports
whose statement set was deferred have none under `mm0/statements`, and a roots
file regenerated by `scripts/lean-module-decls.lean` is as authoritative as the
one a conversion writes.

`--max-mb` skips exports larger than M megabytes, `--chapters` bounds the run; the
summary always states how many exports were covered and skipped. `--work-dir`
moves the per-declaration artifacts off `/tmp` (a 16 GB tmpfs here) onto a disk
with room; `--resume` skips exports already recorded in the output TSV.
"""
from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

AVM = Path(__file__).resolve().parent.parent
SCAN = AVM / "scripts" / "lean-proof-scan"
CHECK = AVM / "scripts" / "lean-typing-check"
ROOTS = AVM / "mm0" / "statements"
# Work directories live wherever `--work-dir` says: the emitter's artifacts for
# one declaration reached 427 MB, three of those plus two `full.mm*` copies fill
# a 16 GB `/tmp` tmpfs, and the resulting `[Errno 122] Disk quota exceeded`
# looks like a pipeline failure when it is only where the files were put.
WORK_DIR: str | None = None
SCAN_TIMEOUT = int(os.environ.get("SWEEP_SCAN_TIMEOUT", "600"))

#   pass  ✓ AbsoluteValue.abs [def] rules=52 assumptions=36
PASS = re.compile(r"^\s+pass\s+✓\s+(\S+)\s+\[(\w+)\]\s+rules=(\d+)\s+assumptions=(\d+)")
#   mm0-rs ✗ AbsoluteValue.add_le: ...
FAIL = re.compile(r"^\s+(emit|mm0-rs|mm0-c)\s+✗\s+(\S+):\s*(.*)$")
#   emit  ⏱ Some.decl: over 240 s
CAPPED = re.compile(r"^\s+(emit|mm0-rs|mm0-c)\s+⏱\s+(\S+):\s*(.*)$")
CLOSURES = re.compile(r"verified closures\s*:\s*(\d+)/(\d+)")
#   rules shared with MM0: 210/210 rule application(s) (100.0%)
SHARED = re.compile(r"rules shared with MM0:\s*(\d+)/(\d+)")


def run(cmd, **kw):
    env = dict(os.environ)
    env["PATH"] = f"{os.path.expanduser('~/.local/bin')}:{env.get('PATH', '')}"
    return subprocess.run(cmd, capture_output=True, text=True, env=env, **kw)


def arg(argv, flag, default):
    for a in argv:
        if a == flag and argv.index(a) + 1 < len(argv):
            return int(argv[argv.index(a) + 1])
        if a.startswith(flag + "="):
            return int(a.split("=", 1)[1])
    return default


def declared_in(art: Path) -> str | None:
    """The declaration an artifact was emitted for, from its own header.

    Matching an artifact back to its declaration by directory name is a guess
    (the emitter sanitises names, so `Nat.sub_eq_iff_eq_add'` and
    `Nat.sub_eq_iff_eq_add` collide); the header says it outright.
    """
    with art.open("r", errors="replace") as fh:
        for line in fh:
            if line.startswith("-- Declaration"):
                m = re.search(r":\s*(.+?)\s*\[\w+\]\s*$", line.strip())
                return m.group(1) if m else None
            if not line.startswith("--"):
                return None
    return None


def one(export: Path, limit: int, only: Path | None,
        check_max_mb: int) -> list[dict]:
    """Per-declaration rows for one export."""
    out = Path(tempfile.mkdtemp(prefix="sweep-", dir=WORK_DIR))
    rows: list[dict] = []
    budget = False
    try:
        extra = [f"--only={only}"] if only is not None else []
        # An export whose declarations produce proof terms too large to emit or
        # elaborate can spend the emitter's 900 s and the elaborator's 600 s per
        # declaration; a 329-export sweep cannot afford that everywhere, so the
        # whole export gets a budget and reports what it managed inside it.
        try:
            s = run([str(SCAN), str(export), "", str(out), f"--limit={limit}",
                     "--stride"] + extra, timeout=SCAN_TIMEOUT)
        except subprocess.TimeoutExpired as e:
            # The scan is killed mid-export, but what it already printed stays
            # valid: those declarations were emitted, elaborated and accepted
            # by `mm0-c` before the clock ran out. Keep them, and mark the
            # export as budget-exceeded rather than pretending it was covered.
            budget = True
            text = (e.stdout or "") + (e.stderr or "")
            if not isinstance(text, str):
                text = text.decode("utf-8", "replace")
            print(f"  scan  ⏱ {export.stem}: over {SCAN_TIMEOUT} s", flush=True)
        else:
            budget = False
            text = s.stdout + s.stderr
        passed: dict[str, dict] = {}
        for line in text.splitlines():
            if m := PASS.match(line):
                rows.append({"chapter": export.stem, "decl": m.group(1),
                             "kind": m.group(2), "status": "closed",
                             "rules": int(m.group(3)),
                             "assumptions": int(m.group(4)),
                             "selfcheck": "", "shared": "", "nodes": "",
                             "detail": ""})
                passed[m.group(1)] = rows[-1]
            elif m := FAIL.match(line):
                rows.append({"chapter": export.stem, "decl": m.group(2),
                             "kind": "", "status": m.group(1),
                             "rules": 0, "assumptions": 0,
                             "selfcheck": "", "shared": "", "nodes": "",
                             "detail": m.group(3)[:160]})
            elif m := CAPPED.match(line):
                # A declaration that ran into its own time cap prints `⏱`, not
                # `✗`; without this branch it left no row at all and its export
                # looked empty instead of capped.
                rows.append({"chapter": export.stem, "decl": m.group(2),
                             "kind": "", "status": m.group(1),
                             "rules": 0, "assumptions": 0,
                             "selfcheck": "", "shared": "", "nodes": "",
                             "detail": m.group(3)[:160]})
        if budget and not rows:
            rows.append({"chapter": export.stem, "decl": f"<{export.stem} scan>",
                         "kind": "", "status": "timeout", "rules": 0,
                         "assumptions": 0, "selfcheck": "", "shared": "",
                         "nodes": "", "detail": f"no verdict within {SCAN_TIMEOUT} s"})
        # Re-derive each artifact the checkers accepted, rule by rule.
        for sub in sorted(p for p in out.iterdir() if p.is_dir()):
            art = next((p for p in sub.glob("*.mm1")
                        if not p.name.startswith("full")), None)
            if art is None:
                continue
            # A 157 MB proof term takes the checker minutes and gigabytes; the
            # cap keeps one pathological declaration from owning the run, and
            # the verdict it could not give is reported as its own class.
            # The header names the declaration the artifact was *emitted for*,
            # which is not always the one the scan asked for: a name the export
            # aliases (`zsmul_zero`) emits under its target
            # (`SubNegMonoid.zsmul_zero'._autoParam`). The scan's own directory
            # name is the request, so it is the fallback key.
            owner = declared_in(art)
            def match(r: dict, owner=owner, key=sub.name) -> bool:
                if owner is not None and r["decl"] == owner:
                    return True
                return re.sub(r"[^A-Za-z0-9_]", "_", r["decl"]).strip("_") == key
            if art.stat().st_size > check_max_mb * 1024 * 1024:
                for row in rows:
                    if match(row):
                        row["selfcheck"] = "over cap"
                        row["detail"] = f"artifact {art.stat().st_size >> 20} MB"
                        break
                continue
            c = run([str(CHECK), str(art)], timeout=300)
            if c.returncode == 124:
                for row in rows:
                    if match(row):
                        row["selfcheck"] = "timeout"
                        break
                continue
            verdict = "re-derived" if c.returncode == 0 else "disagreed"
            shared = SHARED.search(c.stdout + c.stderr)
            detail = ""
            if c.returncode != 0:
                for line in (c.stdout + c.stderr).splitlines():
                    if line.strip().startswith("class"):
                        detail = line.split(None, 1)[1].strip()
                        break
            for row in rows:
                if match(row):
                    row["selfcheck"] = verdict
                    if shared:
                        row["shared"], row["nodes"] = shared.group(1), shared.group(2)
                    if detail:
                        row["detail"] = detail
                    break
        return rows
    finally:
        shutil.rmtree(out, ignore_errors=True)


def main() -> int:
    argv = sys.argv[1:]
    if len(argv) < 2:
        print(__doc__.strip().splitlines()[0])
        return 2
    export_dir, out_tsv = Path(argv[0]), Path(argv[1])
    limit = arg(argv, "--limit", 4)
    max_mb = arg(argv, "--max-mb", 60)
    chapters = arg(argv, "--chapters", 0) or None
    own = "--own" in argv
    resume = "--resume" in argv
    global WORK_DIR
    for i, a in enumerate(argv):
        if a == "--work-dir" and i + 1 < len(argv):
            WORK_DIR = argv[i + 1]
        elif a.startswith("--work-dir="):
            WORK_DIR = a.split("=", 1)[1]
    if WORK_DIR:
        Path(WORK_DIR).mkdir(parents=True, exist_ok=True)
    check_max_mb = arg(argv, "--check-max-mb", 32)
    no_roots: list[str] = []
    roots_dirs = [ROOTS]
    for i, a in enumerate(argv):
        if a == "--roots-dir" and i + 1 < len(argv):
            roots_dirs += [Path(d) for d in argv[i + 1].split(os.pathsep)]
        elif a.startswith("--roots-dir="):
            roots_dirs += [Path(d) for d in a.split("=", 1)[1].split(os.pathsep)]

    exports = sorted(export_dir.glob("*.ndjson"), key=lambda p: p.stat().st_size)
    skipped = [p for p in exports if p.stat().st_size > max_mb * 1024 * 1024]
    exports = [p for p in exports if p.stat().st_size <= max_mb * 1024 * 1024]
    if chapters:
        exports = exports[:chapters]

    # `--resume` keeps the exports a previous run finished: a corpus sweep is
    # hours long, and losing it to an OOM at 57/329 wastes work that is already
    # on disk. The TSV is rewritten, so finished rows are carried over
    # verbatim before the loop continues past the chapters they cover.
    all_rows: list[dict] = []
    done: set[str] = set()
    if resume and out_tsv.exists() and out_tsv.stat().st_size:
        cols = None
        for line in out_tsv.read_text().splitlines():
            cells = line.split("\t")
            if cols is None:
                cols = cells
                continue
            row: dict = dict(zip(cols, cells))
            for k in ("rules", "assumptions"):
                try:
                    row[k] = int(row.get(k) or 0)
                except ValueError:
                    row[k] = 0
            all_rows.append(row)
            done.add(row["chapter"])
        print(f"resuming: {len(done)} export(s) already in {out_tsv}", flush=True)
    with out_tsv.open("w") as fh:
        fh.write("chapter\tdecl\town\tkind\tstatus\trules\tassumptions\t"
                 "selfcheck\tshared\tnodes\tdetail\n")
        for r in all_rows:
            fh.write("\t".join(str(r.get(k, "")) for k in (
                "chapter", "decl", "own", "kind", "status", "rules",
                "assumptions", "selfcheck", "shared", "nodes",
                "detail")) + "\n")
        fh.flush()
        for i, export in enumerate(exports, 1):
            if export.stem in done:
                print(f"[{i}/{len(exports)}] {export.stem}: resumed", flush=True)
                continue
            roots = next((d / f"{export.stem}.roots" for d in roots_dirs
                          if (d / f"{export.stem}.roots").exists()), None)
            only = None
            if own:
                # No roots recorded means no way to tell the chapter's own
                # declarations from the closure it merely imports; say so
                # rather than sampling the closure and calling it the chapter.
                if roots is None:
                    no_roots.append(export.stem)
                    print(f"[{i}/{len(exports)}] {export.stem}: no roots recorded",
                          flush=True)
                    continue
                only = roots
            rows = one(export, limit, only, check_max_mb)
            # Provenance is recorded for every row, aimed or not: a row is the
            # chapter's own declaration iff the chapter's roots name it, and
            # without a roots file there is nothing to compare against.
            ownset = ({l.strip() for l in roots.read_text().splitlines() if l.strip()}
                      if roots is not None else None)
            for r in rows:
                r["own"] = ("own" if r["decl"] in ownset else "dep") \
                    if ownset is not None else "unknown"
            all_rows.extend(rows)
            for r in rows:
                fh.write("\t".join(str(r[k]) for k in (
                    "chapter", "decl", "own", "kind", "status", "rules",
                    "assumptions", "selfcheck", "shared", "nodes",
                    "detail")) + "\n")
            fh.flush()
            closed = sum(1 for r in rows if r["status"] == "closed")
            print(f"[{i}/{len(exports)}] {export.stem}: {closed}/{len(rows)} closed",
                  flush=True)

    # De-duplicate: the same library declaration arrives through many exports.
    uniq: dict[str, dict] = {}
    for r in all_rows:
        uniq.setdefault(r["decl"], r)
    distinct = list(uniq.values())
    closed = [r for r in distinct if r["status"] == "closed"]
    rederived = [r for r in closed if r["selfcheck"] == "re-derived"]
    disagreed = [r for r in closed if r["selfcheck"] == "disagreed"]
    over_cap = [r for r in closed if r["selfcheck"] == "over cap"]
    timed_out = [r for r in closed if r["selfcheck"] == "timeout"]
    unrechecked = [r for r in closed if r["selfcheck"] == ""]

    print()
    print(f"exports            : {len(exports)} covered, {len(skipped)} skipped "
          f"(larger than {max_mb} MB)")
    if own:
        print(f"sample             : the chapter's own declarations (roots)"
              f", {len(no_roots)} export(s) had none recorded")
        measured = {r["chapter"] for r in all_rows}
        gap = [e.stem for e in exports if e.stem not in measured]
        if gap:
            print(f"coverage gap       : {len(gap)} export(s) had no testable own"
                  f" declaration — the recorded roots names are absent from the"
                  f" export, so nothing was aimed at: " + ", ".join(gap[:4])
                  + (" …" if len(gap) > 4 else ""))
    print(f"declarations seen  : {len(all_rows)} ({len(distinct)} distinct)")
    if any(r["own"] != "unknown" for r in all_rows):
        o = sum(1 for r in distinct if r["own"] == "own")
        d = sum(1 for r in distinct if r["own"] == "dep")
        print(f"provenance         : {o} the chapter's own declaration(s), "
              f"{d} from its dependency closure")
    print(f"closed by mm0      : {len(closed)}/{len(distinct)} distinct")
    print(f"rules / assumptions: {sum(r['rules'] for r in closed)} / "
          f"{sum(r['assumptions'] for r in closed)}")
    print(f"re-derived         : {len(rederived)} "
          f"({len(disagreed)} disagreed, {len(over_cap)} over the "
          f"{check_max_mb} MB self-check cap, {len(timed_out)} timed out, "
          f"{len(unrechecked)} unmatched)")
    shared_rules = [int(r["shared"]) for r in closed if r["shared"]]
    node_rules = [int(r["nodes"]) for r in closed if r["nodes"]]
    if node_rules:
        print(f"rules shared with MM0: {sum(shared_rules)}/{sum(node_rules)} "
              f"rule application(s) in the proof terms the check re-derived")
    by_status: dict[str, int] = {}
    for r in distinct:
        if r["status"] != "closed":
            by_status[r["status"]] = by_status.get(r["status"], 0) + 1
    if by_status:
        print("non-closures by stage:")
        for k, n in sorted(by_status.items(), key=lambda kv: -kv[1]):
            print(f"  {n:5d}  {k}")
    classes: dict[str, int] = {}
    for r in disagreed:
        if r["detail"]:
            classes[r["detail"]] = classes.get(r["detail"], 0) + 1
    if classes:
        print("self-check disagreement classes:")
        for k, n in sorted(classes.items(), key=lambda kv: -kv[1])[:10]:
            print(f"  {n:5d}  {k}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

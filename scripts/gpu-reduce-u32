#!/usr/bin/env python3
"""G22a: the C oracle for `map-sum-u32`.

The reduction's definition lives in two places and this script compares them:

  1. an Austral fixture (`examples/gpu/reduce/Reduce.aui/.aum`) compiled for the
     ordinary C target — `mapper` is the scalar function the reduction applies,
     `sum` is an independent serial fold with modular add, and `main` prints one
     sum per size; and
  2. the pinned table `examples/gpu/reduce/expected.tsv`, whose values this
     script can regenerate from a Python serial sum over the documented
     generator (`--write`).

The tiled schedule is not re-implemented here: the Rust crate's
`safestos/gpu/src/reduce.rs` tests compare the same pinned table against both
its serial oracle and its 64-wide pass schedule, and `test/GpuReduceTest.ml`
checks the pass counts. Agreeing with the table is therefore agreeing with the
other two implementations bit for bit.

Usage:
  scripts/gpu-reduce-u32            # compile the C oracle and compare
  scripts/gpu-reduce-u32 --write    # regenerate expected.tsv from the Python sum

Exit codes: 0 agree, 1 disagreement or build failure, 2 the compiler/gcc is
missing.
"""

import argparse
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
FIXTURE = ROOT / "examples/gpu/reduce"
TABLE = FIXTURE / "expected.tsv"
SIZES = [0, 1, 63, 64, 65, 4095, 4096, 4097, 1048576]

MASK = 0xFFFFFFFF


def value(i):
    return (i * 2654435761 + 12345) & MASK


def mapper(x):
    return (x * 3 + 1) & MASK


def serial_sum(n):
    total = 0
    for i in range(n):
        total = (total + mapper(value(i))) & MASK
    return total


def table_text():
    lines = [
        "# G22a map-sum-u32 C oracle. Generated by scripts/gpu-reduce-u32 --write.",
        "# mapper: f(x) = 3x + 1 (mod 2^32), so f(0) = 1, not the identity.",
        "# value(i) = i * 2654435761 + 12345 (mod 2^32).",
        "# columns: size, wrapping sum of f(value(i)) for 0 <= i < size.",
        "# 0 and 1 are hand-checkable: 0 and 3*12345 + 1 = 37036.",
    ]
    for n in SIZES:
        lines.append(f"{n}\t{serial_sum(n)}")
    return "\n".join(lines) + "\n"


def read_table():
    rows = []
    for line in TABLE.read_text().splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        size, expected = line.split("\t")
        rows.append((int(size), int(expected)))
    return rows


def run(cmd, cwd=None):
    return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--write", action="store_true")
    ap.add_argument("--compiler", default=str(ROOT / "_build/default/bin/austral.exe"))
    args = ap.parse_args()

    if args.write:
        TABLE.write_text(table_text())
        print(f"[pass] G22a wrote {TABLE.relative_to(ROOT)} ({len(SIZES)} rows)")
        return 0

    compiler = Path(args.compiler)
    if not compiler.exists():
        print(f"[fail] G22a compiler not built: {compiler}")
        return 2
    if shutil.which("cc") is None:
        print("[fail] G22a no C compiler on PATH")
        return 2
    if not TABLE.exists():
        print(f"[fail] G22a oracle table missing: {TABLE.relative_to(ROOT)}")
        return 1
    rows = read_table()
    if [n for n, _ in rows] != SIZES:
        print(f"[fail] G22a oracle table sizes are {[n for n, _ in rows]}, expected {SIZES}")
        return 1

    with tempfile.TemporaryDirectory(prefix="avm-g22a-") as td:
        tmp = Path(td)
        c_path = tmp / "Reduce.c"
        exe = tmp / "Reduce"
        env = dict(os.environ)
        env["LD_LIBRARY_PATH"] = os.pathsep.join(
            [str(ROOT), str(ROOT / "safestos/cranelift/target/release")]
            + ([env["LD_LIBRARY_PATH"]] if env.get("LD_LIBRARY_PATH") else [])
        )
        proc = run(
            [
                str(compiler),
                "compile",
                f"{FIXTURE/'Reduce.aui'},{FIXTURE/'Reduce.aum'}",
                "--target-type=c",
                "--entrypoint=Reduce:main",
                f"--output={c_path}",
                "--error-format=json",
            ],
            cwd=ROOT,
        )
        if proc.returncode != 0:
            print(f"[fail] G22a C compilation failed:\n{proc.stdout}{proc.stderr}")
            return 1
        proc = run(["cc", "-O0", "-fwrapv", "-x", "c", str(c_path), "-lm", "-o", str(exe)])
        if proc.returncode != 0:
            print(f"[fail] G22a cc failed:\n{proc.stdout}{proc.stderr}")
            return 1
        proc = run([str(exe)])
        if proc.returncode != 0:
            print(f"[fail] G22a C oracle exited {proc.returncode}:\n{proc.stderr}")
            return 1
        try:
            values = [int(v) for v in proc.stdout.split()]
        except ValueError:
            print(f"[fail] G22a C oracle printed non-integers: {proc.stdout!r}")
            return 1
        if len(values) != len(rows):
            print(f"[fail] G22a C oracle printed {len(values)} value(s), the table has {len(rows)}")
            return 1
        mismatched = [
            (size, got, expected)
            for (size, expected), got in zip(rows, values)
            if got != expected
        ]
        if mismatched:
            for size, got, expected in mismatched:
                print(f"[fail] G22a size {size}: C oracle {got}, table {expected}")
            return 1

    print(
        f"[pass] G22a C oracle: {len(rows)} sizes ({', '.join(str(n) for n in SIZES)}) "
        "agree bit-for-bit with the pinned serial sum"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""PC04 checks: the committed source→KernelIR reflection artifact.

`mm0/proof_chain/clamp_source.mm0` is generated by `bin/gpu_proof` from the
actual `examples/gpu/pointwise` fixture and its actual KernelIR. This script
re-checks the committed artifact without needing dune:

  * assembles `word.mm0` + `clamp_source.mm0` (and the proofs) and runs
    mm0-rs/mm0-c;
  * pins the artifact's recorded `source_sha256` to the current fixture bytes,
    so a changed fixture without regenerated reflection is refused;
  * reads the `-- reflect:` line and compares its comparison direction and
    literal with the fixture source text — a finite structural control, not the
    reflection proof;
  * replaces `umeet` with `ujoin` in a copy of the artifact and requires mm0-c
    to refuse: the bound is tied to the actual comparison, not to a digest.

The OCaml test `test/GpuProofInterfaceTest.ml` performs the real reflection
(typed AST + IR) and requires the committed files to be byte-identical with a
fresh emission. Exit 3 (gap) when mm0-rs/mm0-c are absent.
"""

from __future__ import annotations

import hashlib
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
WORD_MM0 = ROOT / "mm0/proof_chain/word.mm0"
WORD_MM1 = ROOT / "mm0/proof_chain/word.mm1"
ART_MM0 = ROOT / "mm0/proof_chain/clamp_source.mm0"
ART_MM1 = ROOT / "mm0/proof_chain/clamp_source.mm1"
AUX = ROOT / "examples/gpu/pointwise/Pointwise.aui"
AUM = ROOT / "examples/gpu/pointwise/Pointwise.aum"


def fail(name: str, detail: str = "") -> bool:
    print(f"[FAIL] {name}{': ' + detail if detail else ''}")
    return False


def run(cmd: list[str], stdin=None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, stdin=stdin, capture_output=True, text=True)


def main() -> int:
    if not (shutil.which("mm0-rs") and shutil.which("mm0-c")):
        print("[gap] PC04: clamp_source.mm0 not re-checked (no mm0 toolchain)")
        return 3

    ok = True
    mm0 = ART_MM0.read_text()
    mm1 = ART_MM1.read_text()

    # The artifact records the two semantic objects; no axiom may appear and
    # the shared word theory may not be redeclared.
    for forbidden in ("provable sort", "delimiter", "sort u32", "sort Mem", "axiom "):
        if forbidden in mm0:
            ok = fail("PC04 artifact declares only the reflected fragment",
                      f"found `{forbidden}`")

    # The source digest pins the artifact to the current fixture bytes.
    digest = hashlib.sha256(AUX.read_bytes() + AUM.read_bytes()).hexdigest()
    recorded = re.search(r"^-- source_sha256=([0-9a-f]{64})$", mm0, re.M)
    if not recorded:
        ok = fail("PC04 artifact records a source digest")
    elif recorded.group(1) != digest:
        ok = fail(
            "PC04 artifact was generated from this fixture",
            "source_sha256 is stale; regenerate with bin/gpu_proof",
        )

    # Finite structural control: the recorded reflection must agree with the
    # source text. This is not the reflection proof (that is the trusted edge
    # recorded in docs/proof/SOURCE_IR.md).
    source = AUM.read_text()
    clamp = re.search(
        r"function clamp\s*\(x: Nat32\): Nat32 is\s*"
        r"if x > 100 then\s*return 100;\s*else\s*return x;\s*end if;\s*end;",
        source,
    )
    if not clamp:
        ok = fail("PC04 fixture still contains the reflected clamp body")
    reflect = re.search(r"^-- reflect: (.*)$", mm0, re.M)
    if not reflect:
        ok = fail("PC04 artifact records a `-- reflect:` line")
    else:
        fields = dict(
            item.split("=", 1) for item in reflect.group(1).split(" ") if "=" in item
        )
        if fields.get("comparison") != "GreaterThan":
            ok = fail("PC04 reflected comparison follows the fixture",
                      f"records {fields.get('comparison')!r}")
        if fields.get("literal") != "100" or fields.get("operator") != "umeet":
            ok = fail("PC04 reflected literal/operator follow the fixture",
                      f"records literal={fields.get('literal')!r} "
                      f"operator={fields.get('operator')!r}")
        if fields.get("param") != "x:0":
            ok = fail("PC04 parameter mapping is the resolved source parameter",
                      f"records {fields.get('param')!r}")

    with tempfile.TemporaryDirectory(prefix="pc04-") as tmp:
        tmp_path = Path(tmp)
        spec = tmp_path / "all.mm0"
        proof = tmp_path / "all.mm1"
        mmb = tmp_path / "all.mmb"
        spec.write_text(WORD_MM0.read_text() + mm0)
        proof.write_text(WORD_MM1.read_text() + mm1)
        compiled = run(["mm0-rs", "compile", str(proof), str(mmb)])
        if compiled.returncode != 0:
            print(compiled.stderr or compiled.stdout, file=sys.stderr)
            ok = fail("PC04: clamp_source.mm1 compiles")
        elif "sorry" in compiled.stdout or "sorry" in compiled.stderr:
            ok = fail("PC04: clamp_source.mm1 contains no sorry")
        else:
            shape = [l for l in compiled.stdout.splitlines()
                     if re.search(r"\d+ sorts, \d+ term/def, \d+ ax/thm", l)]
            if shape:
                print(f"  [detail] {shape[-1]} — PC04 assembled word+clamp_source")
            checked = run(["mm0-c", str(mmb)], stdin=spec.open())
            if checked.returncode != 0:
                print(checked.stdout or checked.stderr, file=sys.stderr)
                ok = fail("PC04: the assembled specification accepts the reflected bound")
            else:
                # The reversed operator must not check against the same proof.
                # mm0-c does not re-verify `def` bodies, so the control mutates
                # the proof file (which is where the emitted `umeet_lb_r`
                # application lives) and requires mm0-rs to refuse. The OCaml
                # test shows the actual reversed source emits `ujoin`; together
                # they pin the proof to the source's comparison.
                bad_proof = tmp_path / "bad.mm1"
                bad_proof.write_text(proof.read_text().replace(
                    "umeet x u100", "ujoin x u100", 1))
                bad = run(["mm0-rs", "compile", str(bad_proof),
                           str(tmp_path / "bad.mmb")])
                if bad.returncode == 0:
                    ok = fail("PC04: a reversed reflected operator is refused")
                else:
                    print("  [detail] PC04 reversed operator (umeet→ujoin) is refused")

    if ok:
        print("[pass] PC04 source→KernelIR reflection of the real clamp fixture")
        return 0
    print("[FAIL] PC04 source→KernelIR reflection of the real clamp fixture")
    return 1


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""ci-logs — read a GitHub Actions job's log directly, without admin rights.

The Actions web log of a job needs repository admin access, which is how a
failed step ends up described by its exit code alone. The REST API hands the
same log to anyone holding a token, so this script is the way in:

    export GH_TOKEN=...            # or GITHUB_TOKEN
    scripts/ci-logs                # latest run on the current branch; prints
                                   # its jobs and the log of each failed one
    scripts/ci-logs --list         # recent runs, no logs
    scripts/ci-logs --run 12345    # one run
    scripts/ci-logs --run 12345 --job avm-pkg
    scripts/ci-logs --branch master --latest

The token is read from `GH_TOKEN`, then `GITHUB_TOKEN`, and never written
anywhere or printed. It needs `actions:read` on this repository (a fine-grained
PAT scoped to `leonardopedro/australVM` is enough; a classic token needs
`repo`). An unauthenticated call is not a fallback — GitHub allows 60 API
requests an hour without a token, which is how the 403 rate-limit wall in this
repo's history appeared.

The repository is `origin`'s, unless `--repo OWNER/NAME` says otherwise.

Exit: 0 the log(s) were read, 1 the API refused or the request failed,
2 cannot run (no token / no python / no repository), 64 bad usage.
"""

import argparse
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request

API = "https://api.github.com"


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """The log endpoint answers 302 to a signed storage URL.

    urllib would follow it and forward the `Authorization` header, which the
    storage host rejects; the signed URL carries its own credentials, so the
    redirect is followed by hand, without them.
    """

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def die(code, msg):
    print(msg, file=sys.stderr)
    sys.exit(code)


def origin_repo():
    try:
        out = subprocess.run(
            ["git", "remote", "get-url", "origin"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return None
    for prefix in ("https://github.com/", "http://github.com/", "git@github.com:"):
        if out.startswith(prefix):
            return out[len(prefix):].removesuffix(".git").strip("/")
    return None


def current_branch():
    try:
        return subprocess.run(
            ["git", "rev-parse", "--abbrev-ref", "HEAD"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return None


def request(url, token, accept="application/vnd.github+json"):
    req = urllib.request.Request(
        url,
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": accept,
            "X-GitHub-Api-Version": "2022-11-28",
            "User-Agent": "australvm-ci-logs",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            return resp.read()
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", "replace").strip()
        try:
            body = json.loads(body).get("message", body)
        except ValueError:
            pass
        hint = ""
        if e.code == 403 and "rate limit" in body.lower():
            hint = " (this is the unauthenticated limit; is the token exported?)"
        elif e.code in (401, 403):
            hint = " (does the token have actions:read on this repository?)"
        die(1, f"ci-logs: {url} -> HTTP {e.code}: {body}{hint}")
    except urllib.error.URLError as e:
        die(1, f"ci-logs: {url} -> {e.reason}")


def get_json(url, token):
    return json.loads(request(url, token).decode("utf-8"))


def write_out(data):
    """Log bytes, with or without a `buffer` on stdout."""
    out = getattr(sys.stdout, "buffer", None)
    if out is None:
        sys.stdout.write(data.decode("utf-8", "replace"))
        return
    out.write(data)
    out.flush()


def fail_only(job):
    return job.get("conclusion") not in (None, "success", "skipped", "neutral")


def print_run(run):
    print(
        f"run {run['id']}  {run['name']}  {run['event']}  "
        f"{run['head_sha'][:12]}  {run['status']}/{run.get('conclusion')}  "
        f"{run['head_branch']}  {run['created_at']}"
    )


def jobs_of(repo, run_id, token):
    jobs, page = [], 1
    while True:
        data = get_json(
            f"{API}/repos/{repo}/actions/runs/{run_id}/jobs"
            f"?per_page=100&page={page}",
            token,
        )
        batch = data.get("jobs", [])
        jobs.extend(batch)
        if len(jobs) >= data.get("total_count", 0) or not batch:
            return jobs
        page += 1


def print_jobs(jobs, token, repo, show_logs, only_job):
    selected = [j for j in jobs if only_job is None or only_job in j["name"]]
    if not selected:
        die(1, f"ci-logs: no job of that run matches {only_job!r}")
    for job in selected:
        state = job.get("conclusion") or job.get("status")
        print(f"\n=== job {job['id']}  {job['name']}  [{state}]")
        for step in job.get("steps", []):
            print(f"      {step.get('conclusion') or step.get('status'):>10}  "
                  f"{step['name']}")
        if not show_logs:
            continue
        if only_job is None and not fail_only(job):
            continue
        print(f"--- log {job['id']} {job['name']}")
        # 302 to a signed URL; ask for it without following the redirect.
        opener = urllib.request.build_opener(NoRedirect)
        req = urllib.request.Request(
            f"{API}/repos/{repo}/actions/jobs/{job['id']}/logs",
            headers={
                "Authorization": f"Bearer {token}",
                "Accept": "application/vnd.github+json",
                "X-GitHub-Api-Version": "2022-11-28",
                "User-Agent": "australvm-ci-logs",
            },
        )
        try:
            with opener.open(req, timeout=60) as resp:
                write_out(resp.read())
        except urllib.error.HTTPError as e:
            location = e.headers.get("Location")
            if e.code in (301, 302, 303, 307) and location:
                with urllib.request.urlopen(location, timeout=120) as resp:
                    write_out(resp.read())
            else:
                die(1, f"ci-logs: job {job['id']} log -> HTTP {e.code}")
        except urllib.error.URLError as e:
            die(1, f"ci-logs: job {job['id']} log -> {e.reason}")


def main():
    parser = argparse.ArgumentParser(
        prog="ci-logs",
        description="Read GitHub Actions job logs with a token from the environment.",
    )
    parser.add_argument("--repo", help="OWNER/NAME (default: origin's repository)")
    parser.add_argument("--branch", help="branch for the run lookup (default: current)")
    parser.add_argument("--run", type=int, help="run id (default: latest on the branch)")
    parser.add_argument("--job", help="only jobs whose name contains this text")
    parser.add_argument("--limit", type=int, default=10, help="runs to list (default 10)")
    parser.add_argument("--list", action="store_true", help="list runs and stop")
    parser.add_argument("--latest", action="store_true",
                        help="with --branch: newest run of that branch")
    parser.add_argument("--no-logs", action="store_true",
                        help="print the job/step table without fetching logs")
    args = parser.parse_args()

    token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
    if not token:
        die(
            2,
            "ci-logs: no token. Export GH_TOKEN (or GITHUB_TOKEN) with "
            "actions:read on this repository; it is read from the environment "
            "only and never written or printed.",
        )
    repo = args.repo or origin_repo()
    if not repo or "/" not in repo:
        die(2, "ci-logs: no repository. Pass --repo OWNER/NAME.")

    run_id = args.run
    if run_id is None:
        branch = args.branch or current_branch()
        query = f"{API}/repos/{repo}/actions/runs?per_page={max(1, args.limit)}"
        if branch:
            query += f"&branch={urllib.request.quote(branch)}"
        runs = get_json(query, token).get("workflow_runs", [])
        if not runs:
            die(1, f"ci-logs: no runs for {repo}" + (f" on {branch}" if branch else ""))
        if args.list or not args.latest:
            for run in runs:
                print_run(run)
            if args.list:
                return 0
            run_id = runs[0]["id"]
        else:
            run_id = runs[0]["id"]

    run = get_json(f"{API}/repos/{repo}/actions/runs/{run_id}", token)
    print_run(run)
    print_jobs(jobs_of(repo, run_id, token), token, repo,
               not args.no_logs, args.job)
    return 0


if __name__ == "__main__":
    sys.exit(main())

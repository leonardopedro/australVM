#!/usr/bin/env python3
"""Ask the JIT bridge for the sha256 of a CPS file — the code fingerprint, checked.

`au2mm0` records `code: cps = <sha256>` using Python's `hashlib`. That is a
record, not a check: it hashes a file the emitter itself just wrote, so the only
thing it can catch is a file changing on disk afterwards, and it says nothing
about whether the number describes the bytes the runtime would execute.

This script hashes through `libaustral_cranelift_bridge.so`'s
`austral_cps_fingerprint` — the crate that compiles and runs those bytes. When
the gate compares the certificate's line against this number, agreement is a
statement about the *runtime's* view of the code; a disagreement between the two
independent implementations (Rust `sha2` vs Python `hashlib`) is a real
disagreement that neither side can paper over.

`--object` hashes the *machine code* instead: the bridge compiles the CPS into
its `AVCE` capture and the digest is taken over that. It is host-native, so the
second field names the architecture (`<hex> arch=<aarch64|x86_64|…>`) and the
certificate records both — a digest that only re-derives on one architecture is
said to be so rather than presented as portable.

Usage:
    scripts/cps-fingerprint <cps-file>        # prints hex sha256, exit 0
    scripts/cps-fingerprint --object <cps>    # prints "<hex> arch=<arch>"
    scripts/cps-fingerprint --selftest        # checks the primitive both ways

Exit: 0 ok, 1 the bridge disagrees with hashlib, 2 could not run (no .so).
"""

import ctypes
import hashlib
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
CANDIDATES = [
    ROOT / "libaustral_cranelift_bridge.so",
    ROOT / "safestos" / "cranelift" / "target" / "release" / "libaustral_cranelift_bridge.so",
]


def load():
    for cand in CANDIDATES:
        if not cand.is_file():
            continue
        try:
            lib = ctypes.CDLL(str(cand))
        except OSError:
            continue
        fn = lib.austral_cps_fingerprint
        fn.restype = ctypes.c_void_p
        fn.argtypes = [ctypes.c_char_p, ctypes.c_size_t]
        obj = getattr(lib, "austral_object_fingerprint", None)
        if obj is not None:
            obj.restype = ctypes.c_void_p
            obj.argtypes = [ctypes.c_char_p, ctypes.c_size_t]
        arch = getattr(lib, "austral_object_arch", None)
        if arch is not None:
            arch.restype = ctypes.c_void_p
            arch.argtypes = []
        free = lib.cranelift_free_string
        free.restype = None
        free.argtypes = [ctypes.c_void_p]
        return cand, fn, free, obj, arch
    return None, None, None, None, None


def fingerprint(fn, free, data: bytes) -> str:
    ptr = fn(data, len(data))
    if not ptr:
        raise RuntimeError("bridge refused the buffer")
    try:
        return ctypes.string_at(ptr).decode("ascii")
    finally:
        free(ptr)


def object_fingerprint(fn, free, arch, data: bytes):
    """The AVCE capture digest, or None when the module does not compile."""
    ptr = fn(data, len(data))
    if not ptr:
        return None
    try:
        digest = ctypes.string_at(ptr).decode("ascii")
    finally:
        free(ptr)
    aptr = arch() if arch is not None else None
    if aptr:
        try:
            name = ctypes.string_at(aptr).decode("ascii")
        finally:
            free(aptr)
    else:
        name = "unknown"
    return digest, name


def main(argv):
    path, fn, free, objfn, archfn = load()
    if fn is None:
        print(
            "cps-fingerprint: [gap] no bridge cdylib found "
            f"(looked in {', '.join(str(c) for c in CANDIDATES)}); "
            "run `make bridge`",
            file=sys.stderr,
        )
        return 2

    if len(argv) == 2 and argv[1] == "--selftest":
        bad = 0
        for label, blob in [
            ("empty", b""),
            ("cps-header", b"\x00\x01AUS\x00"),
            ("flipped", b"\x00\x01AUS\x01"),
        ]:
            got = fingerprint(fn, free, blob)
            want = hashlib.sha256(blob).hexdigest()
            ok = got == want
            bad += 0 if ok else 1
            print(f"{'ok  ' if ok else 'DIFF'} {label:12} {got}")
        if bad == 0:
            a = fingerprint(fn, free, b"cps")
            b = fingerprint(fn, free, b"cpT")
            if a == b:
                print("FAIL the primitive is constant: a one-byte change was invisible")
                return 1
            print("ok   one flipped byte changes the digest")
        print(f"bridge: {path}")
        return 0 if bad == 0 else 1

    want_object = len(argv) == 3 and argv[1] == "--object"
    if len(argv) != 2 and not want_object:
        print(__doc__.strip().splitlines()[-2], file=sys.stderr)
        return 2
    target = pathlib.Path(argv[2] if want_object else argv[1])
    if not target.is_file():
        print(f"cps-fingerprint: no such file: {target}", file=sys.stderr)
        return 2
    blob = target.read_bytes()
    if want_object:
        if objfn is None:
            print("cps-fingerprint: [gap] this bridge predates "
                  "austral_object_fingerprint — run `make bridge`", file=sys.stderr)
            return 2
        got = object_fingerprint(objfn, free, archfn, blob)
        if got is None:
            print(f"cps-fingerprint: {target}: the module does not compile, "
                  "so there is no object to fingerprint", file=sys.stderr)
            return 2
        print(f"{got[0]} arch={got[1]}")
        return 0
    print(fingerprint(fn, free, blob))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

#!/usr/bin/env bash
# cps-corpus — compile every example that has a CPS path into the directory
# given as $1, and print one `.cps` path per line on stdout.
#
# Exists because "the emitted subset" is a claim about the emitter, not about
# one kernel: flux1d reads 8 of the 23 opcodes, so a flux1d-only measurement
# never sees `cmp_lt`, let alone `while`/`store`. Two tools measure that subset
# (`scripts/isa-census` at the opcode layer, `scripts/clif2mm0` at the CLIF
# layer) and they must measure the *same* modules, or their two "subsets" can
# disagree while each check is green. So the list lives here once.
#
# Exit: 0 on success, 2 with a `[gap]` line on stderr if the corpus could not be
# built (no toolchain, or an example that no longer compiles). Nothing here
# executes a module: both compiles go to C (`--target-type=c`), which needs
# neither a C compiler nor a host linker, and the measurements read the CPS.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEST="${1:-}"
if [ -z "$DEST" ]; then
    echo "cps-corpus: usage: scripts/cps-corpus <dest-dir>" >&2
    exit 2
fi
mkdir -p "$DEST"

if [ -n "${AUSTRAL_BIN:-}" ]; then
    austral="$AUSTRAL_BIN"
else
    austral="$ROOT/austral"
fi
# A developer tree has the bridge at the repo root; a clean `make bridge` (and
# CI) leaves it only under target/release.
bridge="$ROOT/libaustral_cranelift_bridge.so"
[ -f "$bridge" ] || bridge="$ROOT/safestos/cranelift/target/release/libaustral_cranelift_bridge.so"
if [ ! -x "$austral" ] || [ ! -f "$bridge" ]; then
    echo "cps-corpus: [gap] no ./austral or bridge .so — cannot build the corpus" >&2
    exit 2
fi

# The corpus is compiled with `--target-type=c`: the measurement reads the CPS
# file, not the executable, and the C target needs neither a C compiler nor a
# host linker. That matters for the kernel entry — `uk_version` and its
# neighbours are registered in the JIT, not exported by the bridge `.so` unless
# built with `unfer-kernel`, so linking an exe for it fails on symbols the
# measurement never touches.
#
# `--allow-all` because these tools measure emitted bytes: a kernel call would
# otherwise be refused by the default-deny engine before it could be counted.
# The grant question belongs to `modhost`, and nothing here is executed.
#
# dir:module[:sources] — the directory is relative to the repo root and the
# module name is the declared one, not the directory name, which is why both
# are written down instead of derived. `sources` defaults to the directory's
# `.aui` (if any) plus its first `.aum`.
entries=(
    "examples/verified-kernel/flux1d:Flux1d"
    "examples/fib:Example.Fibonacci"
    "examples/union:Example.Union"
    "examples/record:Example.Record"
    "examples/generic-union:Example.GenericUnion"
    "examples/named-argument:Example.NamedArgument"
    "examples/identity:Example.Identity"
    "examples/kernel:TestKernel:UnferKernel.aui,UnferKernel.aum TestKernel.aum"
    "examples/memory-ops:Example.MemoryOps"
    # W9.2 coverage entries: these three are in the corpus for the opcodes only
    # *they* emit, not for what they compute. `control-flow` is the deliberate
    # one (`while`, `cmp_gt`/`cmp_lte`/`cmp_gte`/`cmp_neq`, `or`, `not`, and the
    # `for`-loop `add`); `generic-record` and `ffi` are the two remaining
    # examples that compile on the CPS path and they contribute `string_lit`.
    "examples/control-flow:Example.ControlFlow"
    "examples/generic-record:Example.GenericRecord"
    "examples/ffi:Example.FFI"
    # U15b/U15c: the two-payload unions. They are here for the call path the
    # checked wrappers add — a call to `<symbol>__checked`, a `match` on its
    # tag, and the `<symbol>__free` release the U15c cleanup emits — not for
    # their arithmetic. Both modules live under `umbrella/modules/` because
    # their providers are the `rs_*` fixtures the umbrella tests build.
    # `@cps` because the checked call is JIT-only: the C backend refuses the
    # generated adapter symbol, and this corpus only measures CPS bytes.
    "umbrella/modules:EitherImport@cps:EitherImport.aum"
    "umbrella/modules:ResultImport@cps:ResultImport.aum"
)

for entry in "${entries[@]}"; do
    dir="${entry%%:*}"
    rest="${entry#*:}"
    mod="${rest%%:*}"
    # `module@cps` marks an entry whose CPS is measurable but whose C backend
    # path is not (the checked-adapter call has no C rendering).
    cps_only=0
    if [[ "$mod" == *@cps ]]; then
        mod="${mod%@cps}"
        cps_only=1
    fi
    if [ "$rest" = "$mod" ]; then
        # A module with an interface is one comma pair; a body-only module
        # (`memory-ops`) is just the `.aum`, so the `.aui` probe may fail.
        aui=$(cd "$ROOT/$dir" && ls *.aui 2>/dev/null | head -1)
        aum=$(cd "$ROOT/$dir" && ls *.aum | head -1)
        if [ -n "$aui" ]; then srcs=("$aui,$aum"); else srcs=("$aum"); fi
    else
        read -r -a srcs <<< "${rest#*:}"
    fi
    # The module's own name is the output stem: the directory basename is not
    # unique once two fixtures share `umbrella/modules`.
    name="${mod##*.}"
    emit_args=(--emit-cps="$DEST/$name.cps")
    target="c"
    if [ "$cps_only" -eq 1 ]; then
        # `--emit-cps-only` pairs with the `tc` target: the `c` target always
        # expects `--output`, and the CPS-only path takes no `--entrypoint`.
        emit_args+=(--emit-cps-only)
        target="tc"
        entry_args=()
    else
        emit_args+=(--output="$DEST/$name.c")
        entry_args=(--entrypoint="$mod:main")
    fi
    if ! ( cd "$ROOT/$dir" \
        && LD_LIBRARY_PATH="$(dirname "$bridge"):$ROOT" "$austral" compile "${srcs[@]}" \
            "${entry_args[@]}" --use-cps-jit --allow-all \
            --target-type="$target" "${emit_args[@]}" ) \
            >"$DEST/$name.log" 2>&1; then
        echo "cps-corpus: [gap] $dir did not compile — corpus incomplete" >&2
        tail -3 "$DEST/$name.log" >&2
        exit 2
    fi
    # `--emit-cps-only` reports `Generated N functions`; a full C compile
    # reports `N functions compiled`.
    if ! grep -Eq '([1-9][0-9]* functions compiled|Generated [1-9][0-9]* functions)' "$DEST/$name.log"; then
        echo "cps-corpus: [gap] $dir compiled no function — nothing to measure" >&2
        exit 2
    fi
    echo "$DEST/$name.cps"
done

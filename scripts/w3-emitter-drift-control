#!/usr/bin/env bash
# w3-emitter-drift-control — does the *whole gate* fail when a §W3 row's
# `emitter that owns it` cell names a command the registry does not hold for that
# artifact?
#
# The in-gate control (`W3: an approved §W3 row whose emitter left the registry is
# refused`) calls the per-row function twice and checks what it returns. That says
# the function decides correctly; it does not say the gate's output changes. So
# this script performs the experiment end to end, the way `obj-drift-control` does
# for the W5 object digest:
#
#   1. copy the plan and rewrite the `isa` row's emitter cell to name
#      `scripts/toy-witness check` — an existing, executable command that
#      `mm0-comparator emitters` does not hold for `isa` (the registry still names
#      `scripts/isa-encdec check`), which is exactly what a retirement that left
#      the cell behind looks like from the table's side;
#   2. run `scripts/verify-invariants` against that copy through `AUSTRALVM_PLAN`
#      and require exit 1;
#   3. require the run to carry `[FAIL] W3: every §W3 emitter cell names a real
#      command` and the `[detail]` line naming `isa` with both commands — a gate
#      that failed for some unrelated reason must not count as this control
#      holding;
#   4. require the same run to still report the §W3 pass lines that do not read
#      this row, so the perturbation is isolated to the cell: the fail is the
#      table's claim, not a broken tree. The in-gate retired-emitter control is
#      not in that list but in the expected-fail set — it re-reads the same cell,
#      so a drifted plan fails it too, which is the gate telling the same truth
#      twice. Measured: exactly those three lines turn red, nothing else.
#
# The repository is never edited — the perturbed plan lives in a scratch directory
# and `mm0/approved/` is only read. Nothing here can approve an artifact.
#
# Usage: scripts/w3-emitter-drift-control   (run under `nix develop`: the gate
#                                           needs python3 for the comparator)
# Exit: 0 the control holds, 1 it does not, 2 could not run.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PLAN="$ROOT/PLAN_sota_kernel_verification.md"
GATE="$ROOT/scripts/verify-invariants"

say()  { printf '%s\n' "$*"; }
fail() { printf 'w3-emitter-drift-control: FAIL %s\n' "$*" >&2; }

command -v python3 >/dev/null 2>&1 || {
    say "w3-emitter-drift-control: [gap] python3 not on PATH — run this under 'nix develop'"
    exit 2
}
[ -f "$PLAN" ] || { fail "no plan at $PLAN"; exit 2; }
[ -f "$GATE" ] || { fail "no gate at $GATE"; exit 2; }

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT INT TERM
perturbed="$work/PLAN.md"

# ── 1. the perturbation: one cell, one row ─────────────────────────────────
python3 - "$PLAN" "$perturbed" <<'PY' || exit 2
import pathlib, sys
src, dst = (pathlib.Path(p) for p in sys.argv[1:3])
rows = src.read_text().splitlines(keepends=True)
hits = 0
STATE_CELLS = ("`[gap]`, awaiting owner commit",
              "`[pass]`, approved in `mm0/approved/`")
for i, line in enumerate(rows):
    if not line.lstrip().startswith("| `mm0/isa.mm0`"):
        continue
    # Only the §W3 row: it is the one carrying a state cell. Other tables quote the
    # same artifact path and have no emitter column at all.
    if not any(cell in line for cell in STATE_CELLS):
        continue
    cells = line.split("|")
    # | path | holds out | stmts | emitter | state | digest |
    cells[4] = " `scripts/toy-witness check` "
    rows[i] = "|".join(cells)
    hits += 1
if hits != 1:
    raise SystemExit(f"expected one `mm0/isa.mm0` row, found {hits}")
dst.write_text("".join(rows))
PY
grep -q '| `mm0/isa.mm0` |.*| `scripts/toy-witness check` |' "$perturbed" || {
    fail "the copy does not carry the drifted cell"
    exit 2
}
say "perturbed: isa's emitter cell now says \`scripts/toy-witness check\`"
say "registry:  $(cd "$ROOT" && python3 scripts/mm0-comparator emitters 2>/dev/null \
    | awk -F'\t' '$1=="isa"{print $2" "$3}')"

# ── 2. the whole gate, pointed at the copy ─────────────────────────────────
rc=0
( cd "$ROOT" && AUSTRALVM_PLAN="$perturbed" bash scripts/verify-invariants ) \
    >"$work/gate.log" 2>&1 || rc=$?
say "gate:      exit $rc"
tail -1 "$work/gate.log"

if [ "$rc" -eq 0 ]; then
    fail "the gate accepted a §W3 row naming an unregistered command"
    exit 1
fi

# ── 3. it failed for the right reason ──────────────────────────────────────
line='[FAIL] W3: every §W3 emitter cell names a real command'
if ! grep -qF "$line" "$work/gate.log"; then
    fail "no '$line' in the run"
    exit 1
fi
if ! grep -F '§W3 emitter column:' "$work/gate.log" \
        | grep -qF "isa(cell says 'scripts/toy-witness check', EMITTERS says 'scripts/isa-encdec check')"; then
    grep -F '§W3 emitter column:' "$work/gate.log" | sed 's/^/  /' >&2
    fail "the detail does not name isa with both commands"
    exit 1
fi
say "detail:    isa(cell says 'scripts/toy-witness check', EMITTERS says 'scripts/isa-encdec check')"

# ── 4. everything else in §W3 still passes, and one derived line moved ─────
missing=""
while IFS= read -r want; do
    grep -qF "$want" "$work/gate.log" || missing="$missing
  $want"
done <<'WANT'
[pass] W3: the plan's §W3 stmts column matches what each artifact holds
[pass] W3: every pending §W3 row's artifact re-derives into a staging
[pass] W3: stage-approvals' artifact list is the §W3 table's rows
WANT
if [ -n "$missing" ]; then
    fail "the perturbation took other §W3 lines with it:$missing"
    exit 1
fi
# isa is an approved row, so the same cell is what the approved-emitter check
# reads: the drift must move that line too, and only it. Before the approvals
# landed every §W3 row was pending and this line was in the list above.
grep -qF '[FAIL] W3: every approved §W3 row'"'"'s emitter still produces its approved copy' \
    "$work/gate.log" || {
    fail "the drifted emitter did not move the approved-emitter line"
    exit 1
}
grep -qF "isa(the row says 'scripts/toy-witness check', the registry says 'scripts/isa-encdec check' for it)" \
    "$work/gate.log" || {
    fail "the approved-emitter detail does not name isa with both commands"
    exit 1
}
grep '^\[FAIL\] ' "$work/gate.log" | sed 's/^\[FAIL\] //' > "$work/fails.txt"
cat > "$work/expected.txt" <<'EXPECTED'
W3: every §W3 emitter cell names a real command
W3: every approved §W3 row's emitter still produces its approved copy
W3: an approved §W3 row whose emitter left the registry is refused
EXPECTED
if ! diff -u "$work/expected.txt" "$work/fails.txt" > "$work/fails.diff"; then
    sed 's/^/  /' "$work/fails.diff" >&2
    fail "the run did not fail exactly the checks the cell feeds"
    exit 1
fi
say "control:   holds — one drifted cell, the emitter [FAIL] and isa's approved copy with it,"
say "           every independent §W3 line unchanged"
exit 0

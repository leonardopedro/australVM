#!/usr/bin/env bash
# lean-corpus-mm0 — convert the Lean modules of a project into MM0 *statements*.
#
#   Lean module ──lean4export──▶ NDJSON (declarations only, narrowed)
#               ──lean2mm0-stmts──▶ <Mod>.{mm0,mm1}   (cic.mm0 embedded)
#               ──mm0-rs compile──▶ <Mod>.mmb
#               ──mm0-c───────────▶ exit 0 = the encoding is well-formed
#
# What "converted to mm0" means here, stated plainly: the *structure* of every
# declaration (its type, encoded in cic.mm0's term language) becomes an MM0
# axiom. mm0-rs checks the encoding elaborates against the embedded theory and
# mm0-c re-checks the compiled result. Neither checks the STATEMENT's truth —
# that is the Lean kernel's verdict, re-checked by nanoda on the same export.
# Proving those statements in MM0 needs certificates (`scripts/lean2mm0`), which
# is a different, per-theorem job.
#
# Usage:
#   scripts/lean-corpus-mm0                    # every top-level *.lean module
#   scripts/lean-corpus-mm0 GapCertificate …   # only the named modules
#   LEAN_PROJECT=/path/to/proj scripts/lean-corpus-mm0 Journal
#
# Env:
#   LEAN_PROJECT        Lean project to export (default ../timepiece)
#   LEAN_EXPORTER       lean4export binary (default: ../lean4export build, /tmp fallback)
#   CORPUS_OUT          output root (default australVM/mm0)
#   BUILD_TIMEOUT       per-module elaboration budget, seconds (default 900)
#
# Memory: this script deliberately never runs `lake build <module>`. Lake
# resolves that against the whole `BookProof` library (8,144 planned artifacts
# for a five-declaration chapter) and compiles whatever is stale with one job
# per core, so a stale cluster becomes a dozen concurrent Mathlib environments —
# an OOM kill waiting to happen. It elaborates exactly one file instead, and
# scripts/lean-corpus-sweep runs the modules serially, each in its own capped
# cgroup.
#   SKIP_BUILD=1        do not run `lake build` (olean must already exist)
#   NANODA_MAX_BYTES    export-size budget for the kernel re-check, bytes
#                       (default 268435456, 0 = no budget)
#   NANODA_TRUSTED      manifest of names a full run already verified; those
#                       declarations are skipped, not re-checked. Create it with
#                       scripts/lean-corpus-trust. Setting it also lifts the
#                       default budget (the closure check is what it priced).
#
# Exit codes: 0 all modules converted and mm0-c verified, 1 any failure,
#             2 unusable environment (missing tool / project).
set -uo pipefail

AVM=$(cd "$(dirname "$0")/.." && pwd)
WS=$(cd "$AVM/.." && pwd)
PROJ=${LEAN_PROJECT:-$WS/timepiece}
# lean4export must be built against the project's own Lean version, and it used
# to default to a /tmp build — which a reboot or a tidy-up silently removes,
# turning every module into an "exporter died" failure. Prefer a durable build
# in the workspace and keep /tmp only as a bring-up fallback.
EXPORTER=${LEAN_EXPORTER:-}
if [[ -z $EXPORTER ]]; then
  for cand in "$WS/lean4export" /tmp/lean4export /tmp/l4e428; do
    if [[ -x $cand/.lake/build/bin/lean4export ]]; then
      EXPORTER=$cand/.lake/build/bin/lean4export
      break
    fi
  done
  EXPORTER=${EXPORTER:-$WS/lean4export/.lake/build/bin/lean4export}
fi
OUT=${CORPUS_OUT:-$AVM/mm0}
BUILD_TIMEOUT=${BUILD_TIMEOUT:-900}
# Statements are published up to this size; larger ones are kept on disk only.
# Enforced below by scripts/corpus-size-gate, at the point where they are
# written (see "Size gate" near the end of the module loop).
STMT_LIMIT=${CORPUS_STATEMENT_LIMIT:-5242880}
DECLS_LEAN=$AVM/scripts/lean-module-decls.lean

die() { printf '\033[0;31m[FATAL]\033[0m %s\n' "$*" >&2; exit 2; }
info() { printf '\033[0;32m[INFO]\033[0m %s\n' "$*"; }
warn() { printf '\033[0;33m[WARN]\033[0m %s\n' "$*"; }
err() { printf '\033[0;31m[FAIL]\033[0m %s\n' "$*"; }

[[ -d $PROJ ]] || die "Lean project not found: $PROJ"
[[ -x $EXPORTER ]] || die "lean4export not found: $EXPORTER
  build it against the project's toolchain, e.g.
    git clone https://github.com/leanprover/lean4export /tmp/lean4export
    cd /tmp/lean4export && cp $PROJ/lean-toolchain . && rm -rf .lake && lake build"
command -v lake >/dev/null || die "lake not on PATH"
command -v mm0-rs >/dev/null || die "mm0-rs not on PATH"
command -v mm0-c >/dev/null || die "mm0-c not on PATH (the root of trust)"
PY=$(command -v python3) || die "python3 not on PATH (nix shell nixpkgs#python3)"

# The nanoda leg (unfer/prob_kernel). Its verdict is what makes the statements
# mean anything: mm0-c checks that the ENCODING is well-formed, nanoda checks
# that the export really is a Lean kernel derivation. Build it once with
#   (cd ../unfer && cargo build -q -p prob_kernel --example verify_export)
NANODA=${NANODA_VERIFY:-}
if [[ -z $NANODA ]]; then
    for cand in "$WS/unfer/target/debug/examples/verify_export" \
                "$WS/unfer/target/release/examples/verify_export"; do
        [[ -x $cand ]] && NANODA=$cand && break
    done
fi
if [[ -z $NANODA || ! -x $NANODA ]]; then
    if [[ ${SKIP_NANODA:-0} == 1 ]]; then
        warn "no verify_export binary and SKIP_NANODA=1 — exports are NOT re-checked by nanoda"
    else
        die "nanoda checker not found (build ../unfer with: cargo build -p prob_kernel --example verify_export)
  or set NANODA_VERIFY=/path/to/verify_export, or SKIP_NANODA=1 to convert without the kernel re-check"
    fi
else
    info "nanoda : $NANODA"
fi

mkdir -p "$OUT/exports" "$OUT/statements"
export RUSTUP_TOOLCHAIN=${RUSTUP_TOOLCHAIN:-}

# Default corpus: the project's top-level modules. `lean-module-decls.lean`
# decides which declarations belong to each one, so namespaces never matter.
if (($#)); then
    MODULES=("$@")
else
    mapfile -t MODULES < <(cd "$PROJ" && ls -1 *.lean 2>/dev/null | sed 's/\.lean$//' | sort)
fi
((${#MODULES[@]})) || die "no Lean modules found in $PROJ"

declare -a OK=() BAD=() SKIP=() GAPPED=() LARGE=()
for mod in "${MODULES[@]}"; do
    echo
    info "== $mod"
    # --- olean: check this module's own, elaborate only if it is stale --------
    # Not `lake build "$mod"`: Lake resolves a module target against the whole
    # library and plans every artifact of it (measured here: 8,144 jobs for
    # `BookProof.ChapterErrorNorms`, which has five declarations), then compiles
    # the stale ones with Lake's job pool — one process per core, each of them a
    # whole Mathlib environment. That fan-out is what filled the machine and got
    # the sweep OOM-killed; capping a module in a cgroup (see
    # scripts/lean-corpus-sweep) bounds one chapter, but nothing makes twelve
    # concurrent chapters cheap.
    # The olean is what the export actually needs, so: use it if it is current,
    # otherwise elaborate that ONE file into the scratch dir.
    LEAN_PATH_EXTRA=
    if [[ ${SKIP_BUILD:-0} != 1 ]]; then
        olean=$PROJ/.lake/build/lib/lean/${mod//.//}.olean
        # The module name is dotted; the source path is not. For
        # `BookProof/ChapterCarlemanSimplex/Part4.lean` the module is
        # `BookProof.ChapterCarlemanSimplex.Part4`, so `$mod.lean` names a file
        # that does not exist — which made a stale olean look current and made
        # elaboration fail with "no such file or directory".
        src=${mod//.//}.lean
        if [[ -f $olean && ! $PROJ/$src -nt $olean ]]; then
            : # current — the `lake build` this replaces was a 3 s no-op walk
        else
            scratch=$OUT/olean/${mod//.//}.olean
            mkdir -p "$(dirname "$scratch")"
            if ! (cd "$PROJ" && timeout "$BUILD_TIMEOUT" lake env lean \
                    -o "$scratch" "$src" >/tmp/lean-corpus-build.log 2>&1); then
                if grep -qiE 'failed to read file|unknown module|unknown package' \
                        /tmp/lean-corpus-build.log; then
                    err "$mod: cannot elaborate — an import has no olean, so the project is not built"
                    tail -2 /tmp/lean-corpus-build.log | sed 's/^/    /'
                    BAD+=("$mod (imports unbuilt)")
                elif grep -qi 'error' /tmp/lean-corpus-build.log; then
                    err "$mod: does not elaborate — skipped"
                    tail -3 /tmp/lean-corpus-build.log | sed 's/^/    /'
                    BAD+=("$mod (elaborate)")
                else
                    warn "$mod: does not elaborate and reports no error (script or sample) — skipped"
                    tail -2 /tmp/lean-corpus-build.log | sed 's/^/    /'
                    SKIP+=("$mod")
                fi
                continue
            fi
            LEAN_PATH_EXTRA=$OUT/olean
            info "$mod: olean was stale — elaborated into $scratch"
        fi
    fi

    # `lake env` supplies LEAN_PATH itself; only a leaf module needs the scratch
    # olean dir prepended, and an unset LEAN_PATH must not trip `set -u`.
    lp="${LEAN_PATH_EXTRA:+$LEAN_PATH_EXTRA:}${LEAN_PATH:-}"
    decls=$(cd "$PROJ" && LEAN_PATH="$lp" \
        timeout 300 lake env lean --run "$DECLS_LEAN" "$mod" 2>/tmp/lean-corpus-decls.log)
    if [[ -z $decls ]]; then
        warn "$mod: exports no declarations of its own — skipped"
        tail -2 /tmp/lean-corpus-decls.log | sed 's/^/    /'
        SKIP+=("$mod")
        continue
    fi
    n_decls=$(printf '%s\n' "$decls" | wc -l)

    # Narrowed export: without the `--` list, a Mathlib project exports the whole
    # environment (~50k decls / 300 MB) and lean2mm0-stmts refuses it.
    ndjson=$OUT/exports/$mod.ndjson
    if ! (cd "$PROJ" && LEAN_PATH="$lp" \
            timeout 900 lake env "$EXPORTER" "$mod" -- $decls \
            >"$ndjson" 2>/tmp/lean-corpus-export.log); then
        err "$mod: lean4export failed"
        tail -3 /tmp/lean-corpus-export.log | sed 's/^/    /'
        BAD+=("$mod (export)")
        continue
    fi

    # nanoda re-checks the export in an independent kernel BEFORE anything is
    # encoded: an export the Lean kernel would reject must never reach MM0.
    #
    # BUDGET, not a verdict. The `--` list narrows the ROOTS, not the payload:
    # lean4export writes each named declaration's transitive dependency closure
    # (measured on BookProof.ChapterA4: 24 own decls → 54,053 decls / 369 MB;
    # a single Mathlib lemma alone → 6,760 decls / 29 MB). nanoda must re-check
    # that whole closure, so a Mathlib-importing module costs minutes and
    # multi-GB RSS apiece — which is what caused the OOM on a 14 GB host.
    # Above the budget this is reported as a GAP: statements are still emitted,
    # but they are NOT kernel-backed and the summary says so. Raise
    # NANODA_MAX_BYTES deliberately, one module at a time, on a host that can
    # pay for it. NANODA_MAX_BYTES=0 disables the budget entirely.
    nanoda_budget=${NANODA_MAX_BYTES:-268435456}
    nanoda_args=("$ndjson")
    # The shared Mathlib closure is byte-identical from module to module, so a
    # trusted-name manifest (scripts/lean-corpus-trust) lets nanoda skip the
    # re-check while keeping those declarations in the environment. The budget
    # is a proxy for work that is then no longer done, so unless the caller set
    # NANODA_MAX_BYTES explicitly it stops applying — a 369 MiB chapter whose
    # closure is trusted costs its own 24 declarations, not the 54,053 again.
    if [[ -n ${NANODA_TRUSTED:-} ]]; then
        nanoda_args+=(--trusted "$NANODA_TRUSTED")
        [[ -z ${NANODA_MAX_BYTES:-} ]] && nanoda_budget=0
    fi
    # nanoda takes the byte limit as an argument and treats 0 as "use the
    # default", so a disabled budget must still pass a number it can accept.
    nanoda_limit=$nanoda_budget
    (( nanoda_limit > 0 )) || nanoda_limit=8589934592
    nanoda_args+=("$nanoda_limit")
    gapped=0
    if [[ -n $NANODA && -x $NANODA ]]; then
        size=$(stat -c%s "$ndjson")
        if (( nanoda_budget > 0 && size > nanoda_budget )); then
            gapped=1
            warn "$mod: export is $((size / 1048576)) MiB > nanoda budget $((nanoda_budget / 1048576)) MiB — GAP, statements are not kernel-backed (raise NANODA_MAX_BYTES; measured cost: a 369 MiB chapter export = 399 s, 836 MiB peak RSS; or check the closure once with scripts/lean-corpus-trust and set NANODA_TRUSTED)"
            GAPPED+=("$mod")
        elif ! "$NANODA" "${nanoda_args[@]}" >/tmp/lean-corpus-nanoda.log 2>&1; then
            err "$mod: nanoda REJECTED the export"
            tail -2 /tmp/lean-corpus-nanoda.log | sed 's/^/    /'
            BAD+=("$mod (nanoda)")
            continue
        fi
        # Say what the kernel actually checked: with a trusted base it examines
        # only the module's own declarations, and a log that reports a bare
        # "verified" would overstate that.
        info "nanoda  : $(grep -m1 '^nanoda: verified' /tmp/lean-corpus-nanoda.log \
            | sed -e 's/^nanoda: verified [^ ]* //' -e 's/^nanoda: /nanoda: /')"
    fi

    # Only the module's OWN declarations become statements: the export also
    # carries their dependency closure (nanoda's re-check material), and
    # restating Mathlib as MM0 axioms would be noise, not evidence.
    roots=$(mktemp)
    printf '%s\n' "$decls" >"$roots"
    if ! "$PY" "$AVM/scripts/lean2mm0-stmts" emit "$ndjson" "$mod" \
            --out "$OUT/statements" --only "$roots" 2>/tmp/lean-corpus-emit.log; then
        rm -f "$roots"
        err "$mod: lean2mm0-stmts failed"
        tail -3 /tmp/lean-corpus-emit.log | sed 's/^/    /'
        BAD+=("$mod (emit)")
        continue
    fi

    if ! mm0-rs compile "$OUT/statements/$mod.mm0" "$OUT/statements/$mod.mmb" >/tmp/lean-corpus-mm0rs.log 2>&1; then
        err "$mod: mm0-rs rejected the encoding"
        grep -m3 -A3 '^error' /tmp/lean-corpus-mm0rs.log | sed 's/^/    /'
        BAD+=("$mod (elab)")
        continue
    fi

    # mm0-c is the point of the exercise: it re-checks the compiled file
    # independently of the elaborator that produced it.
    if ! mm0-c "$OUT/statements/$mod.mmb" <"$OUT/statements/$mod.mm0" >/dev/null 2>/tmp/lean-corpus-mm0c.log; then
        err "$mod: mm0-c refused the file"
        tail -3 /tmp/lean-corpus-mm0c.log | sed 's/^/    /'
        BAD+=("$mod (mm0-c)")
        continue
    fi

    rm -f "$roots"

    # --- Size gate ---------------------------------------------------------
    # The statement limit is enforced HERE, where the artefact is written, not
    # by auditing `git add` afterwards. Oversized statements are not a failure —
    # they are converted and mm0-c re-checked like any other — but they cannot
    # be published: GitHub rejects anything past 100 MB (GH001) and a single
    # Mathlib-importing chapter reaches 900 MB. The gate leaves them on disk and
    # adds their paths to the managed block of .gitignore (plus size + SHA-256
    # to mm0/statements/LARGE.tsv), so no later `git add -A` can stage them. A
    # rerun that shrinks a statement back under the limit un-ignores it again.
    gated_n=0
    gated_mb=0
    gate_out=$("$AVM/scripts/corpus-size-gate" --limit "$STMT_LIMIT" \
        --manifest "$OUT/statements/LARGE.tsv" \
        "$OUT/statements/$mod.mm0" "$OUT/statements/$mod.mm1" \
        "$OUT/statements/$mod.roots" 2>/tmp/lean-corpus-gate.log)
    gate_rc=$?
    if (( gate_rc == 3 )); then
        gated_n=$(printf '%s\n' "$gate_out" | grep -c .)
        gated_mb=$(printf '%s\n' "$gate_out" | awk -F'\t' '{ s += $1 } END { printf "%d", s / 1048576 }')
        LARGE+=("$mod")
        warn "$mod: $gated_n artifact(s) exceed $((STMT_LIMIT / 1048576)) MB — kept on disk, out of the index"
    elif (( gate_rc == 2 )); then
        # A gate that cannot run must not silently publish a 900 MB statement:
        # that is the failure this exists to prevent.
        err "$mod: size gate failed (see /tmp/lean-corpus-gate.log)"
        BAD+=("$mod (gate)")
        continue
    fi

    # mm0-c accepted the encoding either way; say which verdict the STATEMENTS
    # have. Only a nanoda-accepted export makes them kernel-backed, so a gapped
    # module is never counted as converted+verified.
    gate_note=
    (( gated_n )) && gate_note=", $gated_n kept out of git (${gated_mb} MB)"
    if (( gapped )); then
        printf '    %s decls → %s lines, mm0-c OK (statements NOT kernel-backed)%s\n' \
            "$n_decls" "$(wc -l <"$OUT/statements/$mod.mm0")" "$gate_note"
    else
        printf '    %s decls → %s lines, mm0-c OK%s\n' \
            "$n_decls" "$(wc -l <"$OUT/statements/$mod.mm0")" "$gate_note"
        OK+=("$mod")
    fi
done

echo
echo "=================================================================="
printf 'converted+verified %d · gapped %d · out of git %d · failed %d · skipped %d\n' \
    "${#OK[@]}" "${#GAPPED[@]}" "${#LARGE[@]}" "${#BAD[@]}" "${#SKIP[@]}"
[[ ${#OK[@]}     -gt 0 ]] && printf '  OK      : %s\n' "${OK[*]}"
[[ ${#GAPPED[@]} -gt 0 ]] && printf '  GAP     : %s (statements emitted, NOT kernel-backed)\n' "${GAPPED[*]}"
[[ ${#LARGE[@]}  -gt 0 ]] && printf '  >5 MB   : %s (on disk and hashed in mm0/statements/LARGE.tsv, not staged)\n' "${LARGE[*]}"
[[ ${#SKIP[@]}    -gt 0 ]] && printf '  skipped : %s\n' "${SKIP[*]}"
[[ ${#BAD[@]}     -gt 0 ]] && printf '  FAILED  : %s\n' "${BAD[*]}"
echo "=================================================================="
((${#BAD[@]} == 0))

#!/usr/bin/env bash
# isa-census — which CPS instructions do the emitted modules use, and does
# mm0/isa.mm0 declare exactly what the decoder accepts?
#
# The measurement is taken from the bridge itself: `isa_census` compiles the
# given CPS module(s) through `cps::compile_cps_to_clif` (the same parser the JIT
# uses, with a capture module so nothing executes), records every opcode the
# decoder consumed, and diffs three sets — decoder (`ISA_REGISTRY`), artifact
# (`mm0/isa.mm0`'s `-- op` table) and measured.
#
# Usage: scripts/isa-census [--corpus] <module.cps>...
#        scripts/isa-census --corpus        # the example corpus, compiled here
# Exit:  0 covered and consistent, 1 uncovered/inconsistent, 2 could not run.
#
# `--corpus` exists because one module does not measure "the emitted subset":
# flux1d reads 8 of the 23 opcodes, so a flux1d-only census never sees `cmp_lt`,
# let alone `while`/`store`. The corpus below is every example whose CPS path
# compiles at least one function; each is compiled with `--emit-cps` into a
# scratch directory and the union is censused. The list itself is
# `scripts/cps-corpus`, shared with `scripts/clif2mm0` so that the two layers
# measure the same modules. Modules the JIT cannot compile
# today (`hello-world`, `memory`: the `__embed` string path) are excluded.
#
# The union is *checked*, not merely printed: the opcodes left unexercised must
# be exactly UNREACHABLE below, so "20 of 23" is a measurement with a reason
# rather than a shortfall. An opcode that starts being emitted (a lowering gain)
# fails this gate until the pin shrinks — which is the point, because a stale
# `unreachable` list is how a model quietly stops covering the emitter.
#
# `examples/kernel` is in the corpus because a module that calls the kernel is
# not just another example: `uk_version` is an `app` (0x04) whose callee is an
# imported symbol, and whether the emitter encodes it like any other call is a
# measurement, not an assumption. `examples/memory-ops` is there for the other
# half of the table: it stores through a write reference and reads it back, so
# 0x20 `deref` and 0x30 `store` are measured instead of merely declared. (It is
# also the example that exposed both memory paths as broken: the store was
# lowered to an assignment to a never-read variable, and the load to an
# `__deref` call.) It is the only entry with an explicit source
# list (`dir:module:sources`) because it needs `UnferKernel` linked in ahead of
# the demo; the others are single-module directories.
#
# Both compiles and the census pass `--allow-all`: this script measures emitted
# bytes, and a kernel call would otherwise be refused by the default-deny engine
# before it could be counted. Nothing is executed here — the census compiles
# into a capture module — and the grant question belongs to `modhost`.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN="$ROOT/safestos/cranelift/target/release/isa_census"

if [ ! -x "$BIN" ]; then
    echo "isa-census: [gap] $BIN not built — run 'make bridge'" >&2
    exit 2
fi

corpus=0
args=()
for a in "$@"; do
    case "$a" in
        --corpus) corpus=1 ;;
        *) args+=("$a") ;;
    esac
done

# With one argument, check the module against the committed model: an
# uncovered opcode must fail the default invocation, not only the gate's.
if [ "${#args[@]}" -eq 1 ] && [ -f "$ROOT/mm0/isa.mm0" ]; then
    exec "$BIN" --isa "$ROOT/mm0/isa.mm0" "${args[0]}"
fi

# The opcodes the current lowering cannot emit from any source program, with
# the evidence for each (measured 2026-11-14, at 20 of 23 covered):
#
#   sub, mul  `lib/Compiler_cps.ml` constructs no `Sub`/`Mul`: `a - b` and
#             `a * b` in Austral source lower to `app` calls of
#             `Austral.Pervasive::trappingSubtract`/`trappingMultiply` (visible
#             in any corpus `.cps`), so the opcodes are decodable IR, not
#             emitted IR.
#   match     `Mt.MCase` lowers to a chain of `CmpEq` + `If` over the tag slot
#             (`Compiler_cps.ml`, the `MCase` arm), never to `Match`.
#
# They stay declared in `mm0/isa.mm0` because the *decoder* accepts them and the
# model describes the decoder; this list states what the *emitter* lacks.
UNREACHABLE_OPCODES="sub mul match"

if [ "$corpus" -eq 1 ]; then
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    # The corpus itself lives in `scripts/cps-corpus`, shared with
    # `scripts/clif2mm0`: the opcode layer and the CLIF layer must measure the
    # same modules, or their two "emitted subsets" can disagree while each
    # check passes. That helper owns the compile flags and the entry list.
    # Through a file, not a process substitution: `mapfile < <(...)` reports
    # only its own status, so a corpus helper that exited 2 after printing some
    # paths would be censused as if it had succeeded.
    if ! "$ROOT/scripts/cps-corpus" "$tmp" > "$tmp/corpus.list"; then
        exit 2
    fi
    mapfile -t cps_files < "$tmp/corpus.list"
    if [ "${#cps_files[@]}" -eq 0 ]; then
        echo "isa-census: [gap] the corpus compiled no module" >&2
        exit 2
    fi
    # Not `exec`: the report has to be inspected before this script's own
    # verdict is known. Capture, print verbatim, keep the binary's status.
    report="$("$BIN" --isa "$ROOT/mm0/isa.mm0" --allow-all "${cps_files[@]}")"
    status=$?
    printf '%s\n' "$report"
    [ "$status" -eq 0 ] || exit "$status"

    # The unexercised set, from the binary's own line. Empty when the corpus
    # reaches everything, which is then compared against the pin like any other
    # mismatch — an empty-but-undeclared coverage is still a change to record.
    uncovered="$(printf '%s\n' "$report" \
        | sed -n 's/.*declared but not used here[^:]*: //p' \
        | tr ',' '\n' \
        | sed 's/^ *0x[0-9a-f][0-9a-f]* */ /; s/^ *//; s/ *$//' \
        | grep -v '^$' \
        | sort -u)"
    expected="$(printf '%s\n' $UNREACHABLE_OPCODES | sort -u)"
    if [ "$uncovered" != "$expected" ]; then
        echo "isa-census: FAIL the unexercised opcode set is not the pinned one" >&2
        echo "  pinned unreachable: $(printf '%s ' $expected)" >&2
        echo "  actually uncovered:  $(printf '%s ' $uncovered)" >&2
        if [ -n "$uncovered" ]; then
            for op in $uncovered; do
                printf '%s\n' "$expected" | grep -qx "$op" \
                    || echo "  $op is uncovered and not declared unreachable:" \
                            "measure a program that emits it, or say why in UNREACHABLE_OPCODES" >&2
            done
        fi
        for op in $expected; do
            printf '%s\n' "$uncovered" | grep -qx "$op" \
                || echo "  $op is in the unreachable pin but the corpus now emits it:" \
                        "shrink UNREACHABLE_OPCODES to $(printf '%s ' $(printf '%s\n' "$uncovered"))" >&2
        done
        exit 1
    fi
    exit 0
fi

exec "$BIN" --isa "$ROOT/mm0/isa.mm0" ${args[@]+"${args[@]}"}

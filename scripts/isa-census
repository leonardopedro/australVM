#!/usr/bin/env bash
# isa-census — which CPS instructions do the emitted modules use, and does
# mm0/isa.mm0 declare exactly what the decoder accepts?
#
# The measurement is taken from the bridge itself: `isa_census` compiles the
# given CPS module(s) through `cps::compile_cps_to_clif` (the same parser the JIT
# uses, with a capture module so nothing executes), records every opcode the
# decoder consumed, and diffs three sets — decoder (`ISA_REGISTRY`), artifact
# (`mm0/isa.mm0`'s `-- op` table) and measured.
#
# Usage: scripts/isa-census [--corpus] <module.cps>...
#        scripts/isa-census --corpus        # the example corpus, compiled here
# Exit:  0 covered and consistent, 1 uncovered/inconsistent, 2 could not run.
#
# `--corpus` exists because one module does not measure "the emitted subset":
# flux1d reads 8 of the 23 opcodes, so a flux1d-only census never sees `cmp_lt`,
# let alone `while`/`store`. The corpus below is every example whose CPS path
# compiles at least one function; each is compiled with `--emit-cps` into a
# scratch directory and the union is censused. Modules the JIT cannot compile
# today (`hello-world`, `memory`: the `__embed` string path) are excluded, and
# the union line reports how many opcodes the corpus still never exercises
# rather than implying the subset is fully exercised.
#
# `examples/kernel` is in the corpus because a module that calls the kernel is
# not just another example: `uk_version` is an `app` (0x04) whose callee is an
# imported symbol, and whether the emitter encodes it like any other call is a
# measurement, not an assumption. `examples/memory-ops` is there for the other
# half of the table: it stores through a write reference and reads it back, so
# 0x20 `deref` and 0x30 `store` are measured instead of merely declared. (It is
# also the example that exposed both memory paths as broken: the store was
# lowered to an assignment to a never-read variable, and the load to an
# `__deref` call.) It is the only entry with an explicit source
# list (`dir:module:sources`) because it needs `UnferKernel` linked in ahead of
# the demo; the others are single-module directories.
#
# Both compiles and the census pass `--allow-all`: this script measures emitted
# bytes, and a kernel call would otherwise be refused by the default-deny engine
# before it could be counted. Nothing is executed here — the census compiles
# into a capture module — and the grant question belongs to `modhost`.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN="$ROOT/safestos/cranelift/target/release/isa_census"

if [ ! -x "$BIN" ]; then
    echo "isa-census: [gap] $BIN not built — run 'make bridge'" >&2
    exit 2
fi

corpus=0
args=()
for a in "$@"; do
    case "$a" in
        --corpus) corpus=1 ;;
        *) args+=("$a") ;;
    esac
done

# With one argument, check the module against the committed model: an
# uncovered opcode must fail the default invocation, not only the gate's.
if [ "${#args[@]}" -eq 1 ] && [ -f "$ROOT/mm0/isa.mm0" ]; then
    exec "$BIN" --isa "$ROOT/mm0/isa.mm0" "${args[0]}"
fi

if [ "$corpus" -eq 1 ]; then
    if [ -n "${AUSTRAL_BIN:-}" ]; then
        austral="$AUSTRAL_BIN"
    else
        austral="$ROOT/austral"
    fi
    if [ ! -x "$austral" ] || [ ! -f "$ROOT/libaustral_cranelift_bridge.so" ]; then
        echo "isa-census: [gap] no ./austral or bridge .so — cannot build the corpus" >&2
        exit 2
    fi
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    # The corpus is compiled with `--target-type=c`: the census reads the CPS
    # file, not the executable, and the C target needs neither a C compiler nor
    # a host linker. That matters for the kernel entry — `uk_version` and its
    # neighbours are registered in the JIT, not exported by the bridge `.so`
    # unless built with `unfer-kernel`, so linking an exe for it fails on
    # symbols the census never touches.
    #
    # dir:module[:sources] — the module name is the declared one, not the
    # directory name, which is why it is written down instead of derived.
    entries=(
        "verified-kernel/flux1d:Flux1d"
        "fib:Example.Fibonacci"
        "union:Example.Union"
        "record:Example.Record"
        "generic-union:Example.GenericUnion"
        "named-argument:Example.NamedArgument"
        "identity:Example.Identity"
        "kernel:TestKernel:UnferKernel.aui,UnferKernel.aum TestKernel.aum"
        "memory-ops:Example.MemoryOps"
    )
    cps_files=()
    for entry in "${entries[@]}"; do
        dir="${entry%%:*}"
        rest="${entry#*:}"
        mod="${rest%%:*}"
        if [ "$rest" = "$mod" ]; then
            # A module with an interface is one comma pair; a body-only module
            # (`memory-ops`) is just the `.aum`, so the `.aui` probe may fail.
            aui=$(cd "$ROOT/examples/$dir" && ls *.aui 2>/dev/null | head -1)
            aum=$(cd "$ROOT/examples/$dir" && ls *.aum | head -1)
            if [ -n "$aui" ]; then srcs=("$aui,$aum"); else srcs=("$aum"); fi
        else
            read -r -a srcs <<< "${rest#*:}"
        fi
        name="$(basename "$dir")"
        if ! ( cd "$ROOT/examples/$dir" \
            && LD_LIBRARY_PATH="$ROOT" "$austral" compile "${srcs[@]}" \
                --entrypoint="$mod:main" --use-cps-jit --allow-all \
                --target-type=c \
                --emit-cps="$tmp/$name.cps" --output="$tmp/$name.c" ) \
                >"$tmp/$name.log" 2>&1; then
            echo "isa-census: [gap] examples/$dir did not compile — corpus incomplete" >&2
            tail -3 "$tmp/$name.log" >&2
            exit 2
        fi
        if ! grep -q '[1-9][0-9]* functions compiled' "$tmp/$name.log"; then
            echo "isa-census: [gap] examples/$dir compiled no function — nothing to measure" >&2
            exit 2
        fi
        cps_files+=("$tmp/$name.cps")
    done
    exec "$BIN" --isa "$ROOT/mm0/isa.mm0" --allow-all "${cps_files[@]}"
fi

exec "$BIN" --isa "$ROOT/mm0/isa.mm0" ${args[@]+"${args[@]}"}

#!/usr/bin/env python3
"""isa-hypotheses — every gap in mm0/isa.mm0 must be cited and pinned.

W8's design says the ISA model fills in the gaps of the AustralVM proofs and
that each gap is a *named hypothesis with a citation*. A comment saying so is
not a check, so this script is the check:

* every `-- cites: <path> sha256=<hex>` line must name a file that exists and
  whose digest still equals the pin (as in W7's citations);
* every `-- gap-hypothesis: <name> — <...>` line must mention `cite=` and must
  reference an artifact listed in the `cites:` block — a hypothesis citing
  something the file never pins is uncited in the only sense that matters;
* every `axiom` in the file must be either covered by a gap-hypothesis line or
  be a congruence/step axiom from the declared list (the theory itself is the
  trusted definition; the point is that nothing *extra* sneaks in silently).

A pinned digest proves the cited file did not drift. It does not prove the file
*says anything about the hypothesis* — and for `bounds_from_layout` it does not:
`layout_certificate.mm0` is the encoding of CPS terms, with no slots, blocks or
`in_bounds` in it. So each hypothesis is also classified by content: a
hypothesis is `content-checked` only when every symbol its statement uses is
declared by at least one cited artifact. That is a necessary condition, not a
sufficient one (a declaration proves the vocabulary exists, not the claim), so
the count of unchecked ones is pinned in `mm0/isa.mm0` as
`-- unchecked-citations: N` and the gate fails if measurement and pin disagree —
an unchecked citation can be declared, but not added silently.

Usage: scripts/isa-hypotheses [<isa.mm0>]
Exit: 0 all cited and pinned, 1 a citation is missing/stale/unaccounted, 2 cannot run.
"""

import hashlib
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
DEFAULT_ISA = ROOT / "mm0" / "isa.mm0"

CITE = re.compile(r"^--\s*cites:\s*(\S+)\s+sha256=([0-9a-f]{64})\s*$")
GAP = re.compile(r"^--\s*gap-hypothesis:\s*([A-Za-z0-9_]+)\s*[—-]\s*(.*)$")
AXIOM = re.compile(r"^\s*axiom\s+([A-Za-z0-9_]+)")
DECL = re.compile(r"^\s*(?:term|sort)\s+([A-Za-z0-9_]+)")
UNCHECKED_PIN = re.compile(r"^--\s*unchecked-citations:\s*(\d+)\s*$", re.MULTILINE)
# Tokens that are not model vocabulary: keywords, sorts of the metalanguage and
# the numeral constants the generated table declares.
NOT_VOCAB = {"axiom", "theorem", "term", "sort", "Prop", "nat"}

# The theory's own definitions: congruence and step rules. They are trusted by
# being read, not by being cited to an artifact, and that list is fixed here so
# a new axiom cannot appear without a decision.
THEORY_AXIOMS = {
    "req_refl",
    "req_symm",
    "req_trans",
    "radd_comm",
    "radd_assoc",
    "rmul_assoc",
    "rmul_distrib",
    "reg_setreg_same",
    "reg_setreg_other",
    "run_add_def",
    "run_sub_def",
    "run_mul_def",
    "run_move_def",
    "ir_add_sem",
    "ir_mul_sem",
    "ir_sub_sem",
    # The encdec section: byte equality's one congruence and transitivity.
    # `encdec` is no longer an axiom — it is 23 theorems proved from the table
    # below (see scripts/isa-encdec), so removing it here is what keeps a
    # regression from quietly turning it back into an assumption.
    "ieq_trans",
    "beq_cong_dec",
}

# The table those theorems rest on: `enc_<op>` / `dec_<op>`, generated from
# `ISA_REGISTRY`. Trusted as data, checked by scripts/isa-census against the
# JIT's decoder and by test/CpsCodecTest.ml against lib/Cps_codec.ml.
TABLE_AXIOM = re.compile(r"^(enc|dec)_[a-z_]+$")


def main(argv):
    path = pathlib.Path(argv[1]) if len(argv) > 1 else DEFAULT_ISA
    if not path.is_file():
        print(f"isa-hypotheses: no such file: {path}", file=sys.stderr)
        return 2
    text = path.read_text()
    problems = []

    cites = {}
    for line in text.splitlines():
        m = CITE.match(line.strip())
        if m:
            cites[m.group(1)] = m.group(2)

    if not cites:
        problems.append("no `-- cites:` lines: the layer-1 hypotheses are unpinned")

    for name, want in cites.items():
        target = (ROOT / name) if not name.startswith("/") else pathlib.Path(name)
        if not target.is_file():
            problems.append(f"cites {name}: file is gone")
            continue
        got = hashlib.sha256(target.read_bytes()).hexdigest()
        if got != want:
            problems.append(
                f"cites {name}: pinned {want[:12]}… does not match the artifact {got[:12]}…"
            )

    gaps = {}
    for line in text.splitlines():
        m = GAP.match(line.strip())
        if m:
            gaps[m.group(1)] = m.group(2).strip()

    for name, body in gaps.items():
        if "cite=" not in body:
            problems.append(f"gap-hypothesis {name}: no `cite=` — uncited hypothesis")
        cited = [c for c in cites if pathlib.Path(c).name.split(".")[0] in body]
        # `cite=` may name a pinned artifact by basename (linearity_certificate,
        # layout_certificate, …) or the census. A mention that matches nothing
        # pinned is the failure the plan's "refuses an uncited one" means.
        if "cite=" in body and not cited and "isa-census" not in body:
            problems.append(
                f"gap-hypothesis {name}: cites nothing pinned in this file — {body!r}"
            )

    axioms = set()
    for line in text.splitlines():
        m = AXIOM.match(line)
        if m:
            axioms.add(m.group(1))

    # ── content, not just provenance ────────────────────────────────────────
    # What can the cited artifacts actually say? A hypothesis is content-checked
    # when every term/sort its statement mentions is declared by one of them.
    cited_vocab = set()
    for name in cites:
        target = (ROOT / name) if not name.startswith("/") else pathlib.Path(name)
        if target.is_file():
            cited_vocab |= set(re.findall(DECL.pattern, target.read_text(), re.MULTILINE))

    def statement_symbols(ax):
        """Identifiers in `ax`'s statement that the model declares itself."""
        lines = text.splitlines()
        out = []
        for i, line in enumerate(lines):
            if re.match(rf"^\s*(axiom|theorem|def)\s+{re.escape(ax)}\b", line):
                chunk = [line]
                j = i
                while not chunk[-1].rstrip().endswith(";") and j + 1 < len(lines):
                    j += 1
                    chunk.append(lines[j])
                out = re.findall(r"[A-Za-z_][A-Za-z0-9_]*", " ".join(chunk))
                break
        return [s for s in out if s in model_vocab and s not in NOT_VOCAB]

    # `DECL` is anchored, and this runs over the whole file rather than a line.
    model_vocab = set(re.findall(DECL.pattern, text, re.MULTILINE))
    unchecked = []
    for name in sorted(gaps):
        if name not in axioms:
            continue  # proved, not assumed: nothing to discharge
        missing = [s for s in statement_symbols(name) if s not in cited_vocab]
        if missing:
            unchecked.append((name, missing))

    pin = UNCHECKED_PIN.search(text)
    declared_unchecked = int(pin.group(1)) if pin else None
    if declared_unchecked is None:
        problems.append(
            "no `-- unchecked-citations: N` line — the uncovered citations must "
            "be counted, not merely possible"
        )
    elif declared_unchecked != len(unchecked):
        problems.append(
            f"unchecked-citations pin says {declared_unchecked}, measured "
            f"{len(unchecked)} ({', '.join(n for n, _ in unchecked) or 'none'})"
        )

    for ax in sorted(axioms - THEORY_AXIOMS):
        if ax not in gaps and not TABLE_AXIOM.match(ax):
            problems.append(
                f"axiom {ax}: neither a theory axiom, a table line, nor a "
                "named gap-hypothesis"
            )
    for ax in sorted(gaps):
        if ax not in axioms and ax not in ("bounds_from_layout", "encdec"):
            problems.append(f"gap-hypothesis {ax}: names no axiom in the file")

    if problems:
        for p in problems:
            print(f"isa-hypotheses: FAIL {p}", file=sys.stderr)
        return 1

    checked = len([n for n in gaps if n in axioms]) - len(unchecked)
    detail = ""
    for name, missing in unchecked:
        detail += (
            f" — {name}: no cited artifact declares {', '.join(missing)}"
        )
    print(
        f"isa-hypotheses: {len(cites)} pinned citation(s), "
        f"{len(gaps)} cited hypothesis/hypotheses ({checked} content-checked, "
        f"{len(unchecked)} unchecked{detail}), {len(axioms)} axiom(s) accounted for"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

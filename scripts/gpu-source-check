#!/usr/bin/env python3
"""G08: differential corpus over the same authored source, three ways.

For every corpus row this script compares

  1. the ordinary C backend, running an Austral CPU driver built from the
     fixture module (`--target-type=exe`),
  2. the GPU bundle generated from the same source (`--target-type=wgsl`) and
     evaluated by the Rust reference evaluator (`avm-gpu reference`), and
  3. the committed expected value in `examples/gpu/pointwise/corpus.tsv`.

The expected column is an independent hand computation in Python `u32`
arithmetic (`& 0xffffffff`); nothing here compiles the Austral source into it.
The corpus is regenerated bit-for-bit by `--write-corpus` from the recorded
seed, so a hand edit to the expected column is visible as a diff.

Mutation controls (each must be detected):
  * subtract with the operands swapped,
  * minimum with its comparison reversed,
  * polynomial with its helper call elided (the "silently dropped helper"
    shape at the source level),
and one compiler refusal (a `while` loop).

Usage:
  scripts/gpu-source-check [--write-corpus]
  scripts/gpu-source-check --compiler _build/default/bin/austral.exe \
                           --checker safestos/gpu/target/debug/avm-gpu
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
FIXTURE = ROOT / "examples/gpu/pointwise"
CORPUS = FIXTURE / "corpus.tsv"
SEED = 20261118

# Deterministic corpus shape, recorded in the corpus header.
ENTRIES = {
    "identity": 1,
    "clamp": 1,
    "invert": 1,
    "twice": 1,
    "addConstant": 1,
    "minimum": 2,
    "difference": 2,
    "add": 2,
    "multiply": 2,
    "bitAnd": 2,
    "bitOr": 2,
    "bitXor": 2,
    "mask": 2,
    "polynomial": 2,
}

BOUNDARY = [0, 1, 2147483647, 2147483648, 4294967294, 4294967295]
PAIRS = [
    (0, 1),
    (1, 0),
    (2147483647, 2147483648),
    (2147483648, 2147483647),
    (4294967294, 4294967295),
    (4294967295, 4294967294),
    (0, 4294967295),
    (4294967295, 0),
]

U32 = 0xFFFFFFFF


def u32(v):
    return v & U32


def expected(entry, x, y):
    """Hand-computed u32 semantics of the authored fixture body."""
    if entry == "identity":
        return u32(x)
    if entry == "clamp":
        return u32(100 if x > 100 else x)
    if entry == "invert":
        return u32(~x)
    if entry == "twice":
        return u32(x + x)
    if entry == "addConstant":
        return u32(x + 2147483648)
    if entry == "minimum":
        return u32(x if x < y else y)
    if entry == "difference":
        return u32(x - y)
    if entry == "add":
        return u32(x + y)
    if entry == "multiply":
        return u32(x * y)
    if entry == "bitAnd":
        return u32(x & y)
    if entry == "bitOr":
        return u32(x | y)
    if entry == "bitXor":
        return u32(x ^ y)
    if entry == "mask":
        return u32((x | y) & ~y & U32)
    if entry == "polynomial":
        return u32(u32(x + x) * y)
    raise SystemExit(f"unknown corpus entry {entry}")


def lcg_next(state):
    return (state * 1664525 + 1013904223) & U32


def build_rows():
    rows = []
    for name, arity in ENTRIES.items():
        if arity == 1:
            for x in BOUNDARY:
                rows.append((name, x, None, expected(name, x, 0)))
        else:
            for x, y in PAIRS:
                rows.append((name, x, y, expected(name, x, y)))
    # Fixed-seed random rows over every binary entry.
    state = SEED
    for name, arity in ENTRIES.items():
        if arity != 2:
            continue
        for _ in range(6):
            state = lcg_next(state)
            x = state
            state = lcg_next(state)
            y = state
            rows.append((name, x, y, expected(name, x, y)))
    return rows


CORPUS_HEADER = f"""# G08 source/C/IR differential corpus. Generated by scripts/gpu-source-check --write-corpus.
# seed={SEED} generator=lcg(state*1664525+1013904223 mod 2^32, initial state={SEED})
# columns: entry x y expected; '-' marks an absent operand.
# boundary values: 0 1 2147483647 2147483648 4294967294 4294967295
"""


def corpus_text(rows):
    out = [CORPUS_HEADER]
    for entry, x, y, exp in rows:
        ys = "-" if y is None else str(y)
        out.append(f"{entry}\t{x}\t{ys}\t{exp}\n")
    return "".join(out)


def read_corpus():
    rows = []
    for line in CORPUS.read_text().splitlines():
        if not line or line.startswith("#"):
            continue
        entry, x, y, exp = line.split("\t")
        rows.append((entry, int(x), None if y == "-" else int(y), int(exp)))
    return rows


def env_with_bridge():
    env = dict(os.environ)
    bridge = ROOT / "safestos/cranelift/target/release"
    env["LD_LIBRARY_PATH"] = f"{ROOT}:{bridge}:" + env.get("LD_LIBRARY_PATH", "")
    return env


def driver_source(rows):
    imported = sorted({r[0] for r in rows})
    lines = ["import Pointwise ("]
    lines += [f"    {name}," for name in imported]
    lines[-1] = lines[-1].rstrip(",") + "\n);\n"
    lines += ["", "module body GpuCpuDriver is", "    function main(): ExitCode is"]
    for entry, x, y, _ in rows:
        args = f"{x}, {y}" if y is not None else f"{x}"
        lines.append(f"        printLn({entry}({args}));")
    lines += ["        return ExitSuccess();", "    end;", "end module body.", ""]
    return "\n".join(lines)


def run(cmd, env, cwd=None):
    return subprocess.run(cmd, env=env, cwd=cwd, capture_output=True, text=True)


def compile_c_driver(compiler, sources, rows, tmp):
    driver = tmp / "GpuCpuDriver.aum"
    driver.write_text(driver_source(rows))
    exe = tmp / "driver"
    modules = ",".join(str(s) for s in sources)
    proc = run(
        [
            str(compiler),
            "compile",
            modules,
            str(driver),
            "--target-type=exe",
            "--entrypoint=GpuCpuDriver:main",
            f"--output={exe}",
        ],
        env_with_bridge(),
    )
    return proc, exe


def c_values(proc, exe):
    if proc.returncode != 0:
        raise RuntimeError(f"C driver compilation failed:\n{proc.stderr or proc.stdout}")
    out = run([str(exe)], env_with_bridge())
    if out.returncode != 0:
        raise RuntimeError(f"C driver failed (exit {out.returncode}):\n{out.stderr}")
    return [int(v) for v in out.stdout.split()]


def gpu_values(compiler, checker, sources, entry, rows, tmp):
    bundle = tmp / f"{entry}.avkg"
    shutil.rmtree(bundle, ignore_errors=True)
    env = env_with_bridge()
    env["AUSTRAL_GPU_CHECKER"] = str(checker)
    proc = run(
        [
            str(compiler),
            "compile",
            ",".join(str(s) for s in sources),
            "--target-type=wgsl",
            f"--entrypoint=Pointwise:{entry}",
            f"--output={bundle}",
        ],
        env,
    )
    if proc.returncode != 0:
        raise RuntimeError(
            f"GPU compile for {entry} failed:\n{proc.stderr or proc.stdout}"
        )
    selected = [r for r in rows if r[0] == entry]
    arity = ENTRIES[entry]
    inputs = [[r[1] for r in selected]]
    if arity == 2:
        inputs.append([r[2] for r in selected])
    inp = tmp / f"{entry}.inputs.json"
    inp.write_text(json.dumps({"inputs": inputs}))
    ref = run([str(checker), "reference", str(bundle), "--inputs", str(inp)], env)
    if ref.returncode != 0:
        raise RuntimeError(f"reference evaluator failed for {entry}:\n{ref.stderr}")
    return json.loads(ref.stdout)["output"]


def compile_refusal(compiler, tmp):
    """A `while` loop in the entry must be refused by the GPU subset."""
    aui = (FIXTURE / "Pointwise.aui").read_text()
    aum = (FIXTURE / "Pointwise.aum").read_text()
    aum = aum.replace(
        "        if x > 100 then\n            return 100;",
        "        while x > 100 do\n            x := modularSubtract(x, 1);\n        end while;\n        if x > 100 then\n            return 100;",
    )
    p_aui = tmp / "Refused.aui"
    p_aum = tmp / "Refused.aum"
    p_aui.write_text(aui.replace("module Pointwise", "module Refused"))
    p_aum.write_text(aum.replace("module body Pointwise", "module body Refused"))
    env = env_with_bridge()
    env["AUSTRAL_GPU_CHECKER"] = str(env.get("AUSTRAL_GPU_CHECKER", "avm-gpu"))
    proc = run(
        [
            str(compiler),
            "compile",
            f"{p_aui},{p_aum}",
            "--target-type=wgsl",
            "--entrypoint=Refused:clamp",
            f"--output={tmp/'refused.avkg'}",
        ],
        env,
    )
    return proc


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--write-corpus", action="store_true")
    ap.add_argument("--compiler", default=str(ROOT / "_build/default/bin/austral.exe"))
    ap.add_argument("--checker", default=str(ROOT / "safestos/gpu/target/debug/avm-gpu"))
    args = ap.parse_args()

    rows = build_rows()
    if args.write_corpus:
        CORPUS.write_text(corpus_text(rows))
        print(f"[pass] G08 wrote {CORPUS.relative_to(ROOT)} ({len(rows)} cases)")
        return 0

    failures = []
    if not CORPUS.exists():
        print(f"[fail] G08 corpus missing: {CORPUS.relative_to(ROOT)}")
        return 1
    committed = read_corpus()
    if committed != rows:
        failures.append("corpus.tsv differs from the recorded generator output")

    compiler = Path(args.compiler)
    checker = Path(args.checker)
    if not compiler.exists():
        print(f"[fail] G08 compiler not built: {compiler}")
        return 1
    if not checker.exists():
        print(f"[fail] G08 checker not built: {checker}")
        return 1

    sources = [FIXTURE / "Pointwise.aui", FIXTURE / "Pointwise.aum"]
    with tempfile.TemporaryDirectory(prefix="avm-g08-") as td:
        tmp = Path(td)
        try:
            proc, exe = compile_c_driver(compiler, sources, committed, tmp)
            cvals = c_values(proc, exe)
        except RuntimeError as e:
            print(f"[fail] G08 {e}")
            return 1
        expected_vals = [r[3] for r in committed]
        if cvals != expected_vals:
            bad = [
                (i, r[0], cvals[i] if i < len(cvals) else "missing", r[3])
                for i, r in enumerate(committed)
                if i >= len(cvals) or cvals[i] != r[3]
            ]
            failures.append(f"C backend disagrees with expected at {len(bad)} row(s): {bad[:4]}")

        total_ref = 0
        for entry in ENTRIES:
            try:
                vals = gpu_values(compiler, checker, sources, entry, committed, tmp)
            except RuntimeError as e:
                failures.append(str(e))
                continue
            exp = [r[3] for r in committed if r[0] == entry]
            total_ref += len(exp)
            if vals != exp:
                bad = [
                    (i, entry, vals[i] if i < len(vals) else "missing", e)
                    for i, e in enumerate(exp)
                    if i >= len(vals) or vals[i] != e
                ]
                failures.append(f"reference evaluator disagrees at {entry}: {bad[:4]}")

        controls = [
            ("subtraction operands swapped", "modularSubtract(x, y)", "modularSubtract(y, x)", {"difference"}),
            ("comparison reversed", "if x < y then", "if x > y then", {"minimum"}),
            ("helper call elided", "modularMultiply(twice(x), y)", "modularMultiply(x, y)", {"polynomial"}),
        ]
        for label, old, new, affected in controls:
            aui = (FIXTURE / "Pointwise.aui").read_text()
            aum = (FIXTURE / "Pointwise.aum").read_text()
            if old not in aum:
                failures.append(f"control {label}: pattern not found, mutation did not apply")
                continue
            mutated_aum = aum.replace(old, new, 1)
            if mutated_aum == aum:
                failures.append(f"control {label}: mutation changed nothing")
                continue
            mut = tmp / ("mut-" + label.replace(" ", "-"))
            mut.mkdir()
            p_aui = mut / "Pointwise.aui"
            p_aum = mut / "Pointwise.aum"
            p_aui.write_text(aui)
            p_aum.write_text(mutated_aum)
            mut_sources = [p_aui, p_aum]
            try:
                proc, exe = compile_c_driver(compiler, mut_sources, committed, mut)
                vals = c_values(proc, exe)
            except RuntimeError as e:
                failures.append(f"control {label}: {e}")
                continue
            if vals == expected_vals:
                failures.append(f"control {label}: corpus did not detect the mutation")
                continue
            if not any(
                committed[i][0] in affected and vals[i] != committed[i][3]
                for i in range(min(len(vals), len(committed)))
            ):
                failures.append(f"control {label}: wrong rows changed")
                continue
            print(f"[pass] G08 mutation detected: {label}")
        refused = compile_refusal(compiler, tmp)
        if refused.returncode == 0:
            failures.append("control unsupported while loop: compiler accepted it")
        else:
            print("[pass] G08 mutation refused: while loop")

    if failures:
        for f in failures:
            print(f"[fail] G08 {f}")
        return 1
    print(
        f"[pass] G08 source/C/IR agree: {len(committed)} cases over {len(ENTRIES)} entries "
        f"(reference rows {total_ref}, seed {SEED})"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""PC08: captured native fragments, decoded and pinned — the edges, stated.

What this does, and what it deliberately does not
-------------------------------------------------
`capture` compiles a committed fixture on the CPS path, hands the CPS to the
bridge's own `cps2cell` (the same `compile_cps_to_clif` the JIT runs), and
records in `mm0/proof_chain/native/<fragment>.capture` the *machine code that
was actually emitted*: architecture, the CPS bytes it came from, each defined
function's text, its relocation records and its imports. `check` re-decodes
those bytes with a table of the instruction forms that fragment really contains
and refuses anything the table does not cover — an unknown byte is an explicit
open edge, never a skipped instruction.

Two fragments are captured, and the difference between them is the point:

  `add`    (`NativeFragment.aum`) — `Int64` addition is a *call* to the
           imported `trappingAdd`, so the captured code is the SysV shim around
           one external call. The captured arithmetic is outside the fragment.
  `arith`  (`ArithFragment.aum`) — `Int64` subtraction and multiplication are
           *inlined* by `Compiler_cps.trapping_arith_op` into the bridge's
           `sub`/`mul` opcodes, so the captured code carries the ALU instruction
           (`sub r12, rsi`, `imul rsi`), the overflow flag (`seto`) and a trap
           branch that falls back to `trappingSubtract`/`trappingMultiply`.

Then it holds each stated MM0 edge (`mm0/proof_chain/native_<fragment>.mm0`) to
its capture: the artifact is *generated* from the capture, so a changed
immediate, a moved relocation, a different arch or a different CPS input is a
byte disagreement with the committed artifact.

What is not here: a proof. There is no x86_64 instruction model in this repo
(the RV64 conversions are RV64, and `docs/PROOF_CHAIN.md` records that they
cannot certify AArch64/x86_64 output), so each simulation obligation is *stated
and cited* with `-- certificate: [gap]` and no `axiom`/`theorem`. `mm0-rs`
accepting a file means "the obligation is well-formed", not "it holds". That is
`PLAN_proof_chain.md` PC08's own fallback: "an unavailable decoder/model
produces an explicit open edge, not a successful native profile."

`MODEL_SOURCES` is the hinge that keeps that honest: it names the places a
reviewed x86_64 instruction semantics *would* appear (an `$X86_MODEL` pin, a
converted artifact under `mm0/statements/`). While none exists the edge is a
`[gap]`; the moment one does, `check` fails and demands the edge be proved
instead of stated. A model cannot arrive and leave this artifact green.

Exit: 0 the captures, decodes, statements and replays agree (with each open
edge reported as a `[gap]`); 1 a disagreement; 3 a capture could not be
re-derived here (no `austral`/`cps2cell`), also a `[gap]` and not a pass.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

CLIF = ROOT / "mm0/clif.mm0"
ISA = ROOT / "mm0/isa.mm0"

#: The cited arithmetic model (Intel SDM sections in its header) and its proof
#: of the fragment's inline core. Pinned into every stated edge, so a model that
#: changes is a stale citation rather than a silent change of meaning.
MODEL = ROOT / "mm0/proof_chain/native/X86Arith.lean"

#: Instruction forms that compute or flag a *value*: these need the model. A
#: frame adjustment (`sub rsp, 0x10`) is not one — it moves the stack pointer,
#: not the kernel's arithmetic.
ALU_FORMS = {"sub", "add", "imul", "mul", "seto"}

#: Places a *reviewed x86_64 instruction semantics* would appear. While none of
#: them resolves, PC08's host edges are `[gap]`s by construction; if one does,
#: `check` fails, because a stated edge with a model beside it is no longer the
#: honest artifact — it has to be proved. (Checked by `model_sources()`.)
MODEL_SOURCES = [
    ("$X86_MODEL", "an x86_64 model pinned by the environment, as the RV64 "
     "conversions are pinned by `$RISCV_MODEL`"),
    ("mm0/statements/x86_instructions.mm0", "a converted x86_64 instruction "
     "artifact beside the RV64 ones"),
]


@dataclass
class Fragment:
    """One captured host fragment: where it comes from, what it asserts."""

    key: str                       # also the capture/statement stem
    source: str                    # fixture file under examples/native-fragment
    module: str
    subject: str                   # the function the stated edge is about
    #: what the edge is *intended* to mean, in the artifact's own prose
    claim: str
    #: the CPS arith term the fragment's body names
    arith_term: str
    #: one sentence on where the arithmetic lives (inline vs imported call)
    arith_note: str
    #: x86_64 forms this fragment may contain: (bytes, mnemonic, imm width)
    forms: list[tuple[bytes, str, int]] = field(default_factory=list)

    @property
    def capture_path(self) -> Path:
        return ROOT / f"mm0/proof_chain/native/{self.key}.capture"

    @property
    def statement_path(self) -> Path:
        return ROOT / f"mm0/proof_chain/native_{self.key}.mm0"


# ── the fragments ────────────────────────────────────────────────────────────

#: `add`: the arithmetic is an imported call, so this fragment's machine code is
#: the shim and the claim ends at the external boundary.
ADD = Fragment(
    key="add",
    source="NativeFragment.aum",
    module="NativeFragment",
    subject="add",
    claim=("the captured instructions, executed from the SysV entry state with "
           "the two 64-bit arguments, return the value `add`'s CPS body "
           "computes"),
    arith_term="trapping_add",
    arith_note=("`Int64` addition stays a call to the imported `trappingAdd`, so "
                "this fragment's edge ends at that external call"),
    forms=[
        (b"\x55", "push rbp", 0),
        (b"\x48\x89\xe5", "mov rbp, rsp", 0),
        (b"\x48\x89\xec", "mov rsp, rbp", 0),
        (b"\x49\xb8", "movabs r8, imm64", 8),
        (b"\x41\xff\xd0", "call r8", 0),
        (b"\x5d", "pop rbp", 0),
        (b"\xc3", "ret", 0),
        (b"\xbf", "mov edi, imm32", 4),
        (b"\xbe", "mov esi, imm32", 4),
        (b"\xe8", "call rel32", 4),
        (b"\x48\xbe", "movabs rsi, imm64", 8),
        (b"\xff\xd6", "call rsi", 0),
        (b"\x48\xc7\x00", "mov qword [rax], imm32", 4),
    ],
)

#: `arith`: subtraction and multiplication are inlined opcodes, so the machine
#: code contains the ALU operation and its overflow trap — the shape a future
#: instruction semantics could actually be written against.
ARITH = Fragment(
    key="arith",
    source="ArithFragment.aum",
    module="ArithFragment",
    subject="sub",
    claim=("the captured instructions, executed from the SysV entry state with "
           "the two 64-bit arguments, return the difference the `sub` opcode "
           "computes, and trap where it traps"),
    arith_term="sub_arith",
    arith_note=("`Int64` subtraction and multiplication are inlined by "
                "`trapping_arith_op` into the `sub`/`mul` opcodes, so the "
                "arithmetic is inside this fragment and only the overflow trap "
                "falls back to `trappingSubtract`"),
    forms=[
        (b"\x55", "push rbp", 0),
        (b"\x48\x89\xe5", "mov rbp, rsp", 0),
        (b"\x48\x83\xec\x10", "sub rsp, 0x10", 0),
        (b"\x4c\x89\x24\x24", "mov [rsp], r12", 0),
        (b"\x4c\x8b\x24\x24", "mov r12, [rsp]", 0),
        (b"\x48\x83\xc4\x10", "add rsp, 0x10", 0),
        (b"\x49\x89\xfc", "mov r12, rdi", 0),
        (b"\x4c\x2b\xe6", "sub r12, rsi", 0),
        (b"\x48\x89\xf8", "mov rax, rdi", 0),
        (b"\x48\xf7\xee", "imul rsi", 0),
        (b"\x49\x89\xc4", "mov r12, rax", 0),
        (b"\x4c\x89\xe0", "mov rax, r12", 0),
        (b"\x41\x0f\x90\xc0", "seto r8b", 0),
        (b"\x45\x84\xc0", "test r8b, r8b", 0),
        (b"\x0f\x85", "jne rel32", 4),
        (b"\xe9", "jmp rel32", 4),
        (b"\x49\xb9", "movabs r9, imm64", 8),
        (b"\x41\xff\xd1", "call r9", 0),
        (b"\x48\x89\xec", "mov rsp, rbp", 0),
        (b"\x5d", "pop rbp", 0),
        (b"\xc3", "ret", 0),
        # the caller `main` of this fixture
        (b"\xbf", "mov edi, imm32", 4),
        (b"\xbe", "mov esi, imm32", 4),
        (b"\xe8", "call rel32", 4),
        (b"\x48\x89\xc7", "mov rdi, rax", 0),
        (b"\x49\xb8", "movabs r8, imm64", 8),
        (b"\x41\xff\xd0", "call r8", 0),
        (b"\x48\xc7\x00", "mov qword [rax], imm32", 4),
    ],
)

FRAGMENTS: list[Fragment] = [ADD, ARITH]

RELOC_WIDTHS = {"Abs8": 8, "X86CallPCRel4": 4}


def fail(message: str, detail: str = "") -> None:
    print(f"[FAIL] PC08: {message}" + (f": {detail}" if detail else ""))


def gap(message: str) -> None:
    print(f"[gap] PC08: {message}")


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


# ── decoding ──────────────────────────────────────────────────────────────────


class DecodeError(Exception):
    pass


def decode(code: bytes, relocs: list[dict],
           forms: list[tuple[bytes, str, int]]) -> list[dict]:
    """Decode `code` into the table's forms, refusing any byte it cannot name.

    A relocation's patch site must land exactly on an instruction boundary that
    carries an immediate of the recorded kind — a reloc that points inside an
    instruction, or one whose width disagrees with its kind, is an error, not a
    footnote. The decoded operand of a relocated immediate is the symbol, which
    is what makes "the call target changed" a decode-level difference.
    """
    sites = {r["offset"]: r for r in relocs}
    out: list[dict] = []
    pc = 0
    while pc < len(code):
        for form, mnemonic, width in forms:
            if code.startswith(form, pc) and \
                    (width == 0 or pc + len(form) + width <= len(code)):
                start = pc
                pc += len(form)
                operand = ""
                reloc = sites.get(pc) if width else None
                imm_at = pc if width else -1
                if width:
                    raw = code[pc:pc + width]
                    pc += width
                    if reloc is not None:
                        want = RELOC_WIDTHS.get(reloc["kind"])
                        if want != width:
                            raise DecodeError(
                                f"reloc {reloc['kind']} at {pc - width} needs "
                                f"{want} byte(s), the instruction carries {width}")
                        operand = "@" + reloc["symbol"]
                    else:
                        value = int.from_bytes(raw, "little")
                        operand = f"0x{value:x}"
                elif pc in sites:
                    raise DecodeError(
                        f"reloc at {pc} is not at an immediate of any instruction")
                out.append({"offset": start, "bytes": code[start:pc].hex(),
                            "form": mnemonic + (f" {operand}" if operand else ""),
                            "reloc": reloc["symbol"] if reloc else "",
                            "imm_at": imm_at})
                break
        else:
            raise DecodeError(
                f"byte 0x{code[pc]:02x} at offset {pc} is not a form in the "
                f"table (the fragment's decoder does not cover it)")
    covered = {i["imm_at"] for i in out if i["imm_at"] >= 0}
    leftover = [o for o in sites if o not in covered]
    if leftover:
        raise DecodeError(f"reloc offset(s) {leftover} match no instruction")
    return out


# ── the AVCE container ────────────────────────────────────────────────────────


class Reader:
    def __init__(self, data: bytes):
        self.data, self.at = data, 0

    def take(self, n: int) -> bytes:
        if self.at + n > len(self.data):
            raise DecodeError("AVCE container is truncated")
        chunk = self.data[self.at:self.at + n]
        self.at += n
        return chunk

    def u16(self) -> int:
        return struct.unpack("<H", self.take(2))[0]

    def u32(self) -> int:
        return struct.unpack("<I", self.take(4))[0]

    def u64(self) -> int:
        return struct.unpack("<Q", self.take(8))[0]

    def i64(self) -> int:
        return struct.unpack("<q", self.take(8))[0]

    def blob(self) -> bytes:
        return self.take(self.u32())


def parse_avce(data: bytes) -> dict:
    r = Reader(data)
    if r.u32() != 0x4156_4345:
        raise DecodeError("not an AVCE capture")
    if r.u16() != 1:
        raise DecodeError("unsupported AVCE version")
    arch = r.blob().decode()
    functions = []
    for _ in range(r.u32()):
        name = r.blob().decode()
        body = r.blob()
        relocs = []
        for _ in range(r.u32()):
            relocs.append({"offset": r.u64(), "addend": r.i64(),
                           "kind": r.blob().decode(),
                           "symbol": r.blob().decode()})
        functions.append({"name": name, "bytes": body.hex(), "relocs": relocs})
    imports = [r.blob().decode() for _ in range(r.u32())]
    return {"arch": arch, "functions": functions, "imports": imports}


# ── capture file <-> rendered MM0 ────────────────────────────────────────────


def capture_bytes(frag: Fragment, capture: dict) -> bytes:
    """The capture as committed text. Rendering is deterministic on purpose:
    `check` compares this text byte-for-byte with the file on disk."""
    lines = [
        f"# native/{frag.key}.capture — PC08's captured host fragment (generated).",
        "#",
        "# Written by `scripts/native-edge capture`; every run of",
        "# `scripts/native-edge` re-decodes the recorded bytes and refuses a file",
        "# that disagrees, so this is evidence, not a hint. Nothing here is",
        "# executed: the bytes are the ones the bridge compiled, read back through",
        "# the same `CaptureModule` the JIT path uses (`cps2cell`).",
        "[meta]",
        f'arch = "{capture["arch"]}"',
        f'source = "examples/native-fragment/{frag.source}"',
        f'module = "{frag.module}"',
        f'subject = "{frag.subject}"',
        f'cps_sha256 = "{capture["cps_sha256"]}"',
        f'avce_sha256 = "{capture["avce_sha256"]}"',
        f'clif = {json.dumps(capture["clif"])}',
    ]
    for name in capture["imports"]:
        lines += ["[[import]]", f'name = "{name}"']
    for fn in capture["functions"]:
        lines += [
            "[[function]]",
            f'name = "{fn["name"]}"',
            f'bytes = "{fn["bytes"]}"',
        ]
        for r in fn["relocs"]:
            lines += [
                "[[function.reloc]]",
                f'offset = {r["offset"]}',
                f'addend = {r["addend"]}',
                f'kind = "{r["kind"]}"',
                f'symbol = "{r["symbol"]}"',
            ]
        for insn in fn["insns"]:
            lines += [
                "[[function.insn]]",
                f'offset = {insn["offset"]}',
                f'bytes = "{insn["bytes"]}"',
                f'form = "{insn["form"]}"',
            ]
    return ("\n".join(lines) + "\n").encode()


def read_capture_toml(text: str) -> dict:
    import tomllib

    data = tomllib.loads(text)
    meta = data["meta"]
    functions = []
    for fn in data.get("function", []):
        functions.append({
            "name": fn["name"],
            "bytes": fn["bytes"],
            "relocs": [{"offset": r["offset"], "addend": r["addend"],
                        "kind": r["kind"], "symbol": r["symbol"]}
                       for r in fn.get("reloc", [])],
            "insns": [{"offset": i["offset"], "bytes": i["bytes"],
                       "form": i["form"]} for i in fn.get("insn", [])],
        })
    return {"arch": meta["arch"], "source": meta["source"],
            "module": meta["module"], "subject": meta["subject"],
            "cps_sha256": meta["cps_sha256"],
            "avce_sha256": meta["avce_sha256"],
            "clif": meta["clif"],
            "imports": [i["name"] for i in data.get("import", [])],
            "functions": functions}


def model_forms(model: Path) -> set[str]:
    """The instruction forms the Lean model declares it covers."""
    if not model.exists():
        return set()
    text = model.read_text()
    m = re.search(r"def MODELED : List String := \[(.*?)\]", text, re.S)
    if not m:
        return set()
    return set(re.findall(r'"([^"]+)"', m.group(1)))


def lean_binary() -> str | None:
    for candidate in (os.environ.get("LEAN_BIN"), shutil.which("lean")):
        if candidate and Path(candidate).exists():
            return candidate
    # the flake's lean store path, so a bare `lean`-less shell can still check
    # the model without entering a devshell that builds the Sail models
    for store in sorted(Path("/nix/store").glob("*lean4-4.30.0")):
        binary = store / "bin/lean"
        if binary.exists():
            return str(binary)
    return None


def render_mm0(frag: Fragment, capture: dict, digests: dict) -> bytes:
    """The stated edge, generated from the capture so it cannot drift from it."""
    subject = next(f for f in capture["functions"] if f["name"] == frag.subject)
    other = [f for f in capture["functions"] if f["name"] != frag.subject]
    modeled = model_forms(MODEL)
    unmodelled = sorted(
        {insn["form"].split(" ")[0] for insn in subject["insns"]
         if insn["form"].split(" ")[0] in ALU_FORMS
         and insn["form"].split(" ")[0] not in modeled}
        | {insn["form"].split(" ")[0] for insn in subject["insns"]
           if insn["form"].split(" ")[0] not in ALU_FORMS})
    lines = [
        f"-- native_{frag.key}.mm0 — PC08's host fragment: the edge, stated and pinned.",
        "--",
        "-- GENERATED by `scripts/native-edge capture` from",
        f"-- `mm0/proof_chain/native/{frag.key}.capture`. Do not edit by hand: every",
        "-- run of `scripts/native-edge` re-decodes the capture and compares this",
        "-- file byte-for-byte, so a hand edit is a `[FAIL]`, not a new claim.",
        "--",
        "-- TARGET CUT. The fragment is one bounded scalar function of the",
        f"-- committed module `examples/native-fragment/{frag.source}`:",
        "--",
        f"--     source        {frag.module}.{frag.subject} (Int64, Int64) -> Int64",
        f"--     CPS           opcodes of `isa.mm0` ({len(capture['clif'])} CLIF form(s))",
        f"--     CLIF          {capture['clif'][0] if capture['clif'] else 'unrecorded'}",
        f"--     host          {capture['arch']}, {len(subject['bytes']) // 2} bytes,",
        f"--                   {len(subject['relocs'])} relocation(s)",
        "--",
        "-- The host edge is the only layer this file states, and it is the layer",
        "-- with no complete model: the arithmetic core and the SysV frame's",
        "-- discipline are specified and proved in",
        "-- `mm0/proof_chain/native/X86Arith.lean` — including the stack-pointer",
        "-- discipline and the `call`/`ret` wiring — but nothing here models the",
        "-- stack's byte contents or the trap callee's body, and the repository's only",
        "-- converted instruction models are RV64 — `docs/PROOF_CHAIN.md` records",
        "-- that they cannot certify this target. So the simulation obligation is",
        "-- stated, cited and left open.",
        "--",
        f"-- {frag.arith_note}.",
        "--",
        f"-- The decoded subject fragment ({len(subject['insns'])} instruction(s)):",
    ]
    for insn in subject["insns"]:
        lines.append(f"-- insn {insn['offset']:>3}  {insn['bytes']:<22} {insn['form']}")
    for fn in other:
        lines.append(f"--")
        lines.append(f"-- The caller `{fn['name']}` ({len(fn['insns'])} instruction(s)), "
                     "recorded because the immediates and")
        lines.append("-- the intra-capture call live there:")
        for insn in fn["insns"]:
            lines.append(f"-- insn {insn['offset']:>3}  {insn['bytes']:<22} {insn['form']}")
    lines += [
        "--",
        "-- Relocations, exactly where the container records them:",
    ]
    for fn in capture["functions"]:
        for r in fn["relocs"]:
            lines.append(
                f"-- reloc {fn['name']}+{r['offset']} {r['kind']} "
                f"addend={r['addend']} -> {r['symbol']}")
    lines += [
        "--",
        "-- Imports are the external boundary this fragment calls into:",
    ]
    for name in capture["imports"]:
        lines.append(f"-- import {name}")
    lines += [
        "--",
        "-- WHAT IS CLAIMED. In the vocabulary below, "
        f"`native_{frag.subject}_edge x y` is",
        "-- intended to mean",
        "--",
        f"--     value (x86_{frag.subject} (entry x y)) = {frag.arith_term} x y",
        "--",
        f"-- i.e. {frag.claim}.",
        "-- The equality is *not* stated: MM0 has no built-in equality",
        "-- and importing one would claim a theory this artifact has not earned.",
        "-- The relation is named; what it means is the sentence above, where a",
        "-- reviewer can disagree with it.",
        "--",
        "-- WHAT IS NOT CLAIMED. No instruction semantics is defined here, so",
        "-- nothing says the claim holds: the terms are uninterpreted, there is no",
        "-- `axiom` and no `theorem`, and `scripts/verify-invariants` refuses",
        "-- either in this file. `mm0-rs` accepting it means the obligation is",
        "-- well-formed. Discharging it needs an x86_64 model plus a simulation",
        "-- between machine states and the CPS fragment's states — neither exists.",
        "--",
        "-- Citations are by content: the shape layer, the opcode layer and the",
        "-- capture this file was generated from. A stale digest means the",
        "-- comment describes files that have changed, and the gate fails.",
        f"-- cites: mm0/proof_chain/native/{frag.key}.capture sha256={digests['capture']}",
        f"-- cites: mm0/clif.mm0 sha256={digests['clif']}",
        f"-- cites: mm0/isa.mm0 sha256={digests['isa']}",
        "--",
        "-- MODEL. The arithmetic core is specified and *proved* in",
        f"-- `mm0/proof_chain/native/X86Arith.lean` (sha256={digests['model']}),",
        "-- which cites the Intel SDM for `SUB`, `IMUL` and `SETO` and proves, on a",
        "-- toy machine state: the inline value for in-range arguments, the clear",
        "-- overflow flag in range, the out-of-range case reaching the trap, the",
        "-- `imul` truncation, the frame's stack addresses and the `call`/`ret`",
        "-- wiring (the trap callee is a parameter, not invented). It does not",
        "-- model the stack's byte contents or `trappingSubtract` — which is",
        "-- exactly why the edge above stays open.",
        "--",
        "-- Instruction form(s) not covered by the arithmetic model (the frame",
        "-- discipline — push/pop/mov/ret — is modelled abstractly in `Frame`,",
        "-- and the trap call is deliberately outside the fragment): "
        + ", ".join(unmodelled) + ".",
        f"-- model: mm0/proof_chain/native/X86Arith.lean sha256={digests['model']}",
        "--",
        "-- certificate: [gap] — stated, cited, unproved. The arithmetic core,",
        "-- stack addresses and the `call`/`ret` wiring are modelled in",
        "-- `X86Arith.lean`, but the stack's byte contents and the trap callee's",
        "-- body are not, so this edge is open; `scripts/native-edge` reports it as",
        "-- a `[gap]`, fails if another",
        "-- model appears (`MODEL_SOURCES`), and pins the decoded bytes, relocations",
        "-- and declination so it cannot silently change.",
        "--",
        "-- theory: self-declared vocabulary (see `mm0/store_projection.mm0`).",
        "sort St;                        -- machine state (registers + stack), uninterpreted",
        "sort Val;                       -- 64-bit values and addresses, uninterpreted",
        "provable sort Prop;",
        "",
        "-- The entry state: the SysV convention puts the two arguments in rdi/rsi,",
        "-- and `ret` leaves the result in rax. Both are *named*, not modelled.",
        "term entry (x y: Val): St;",
        "-- The decoded instructions of the subject fragment, as one step function.",
        f"term x86_{frag.subject} (s: St): St;",
        "-- What the fragment's code leaves in the return register.",
        "term value (s: St): Val;",
        f"-- The CPS body's arithmetic: {frag.arith_note.split(',')[0]}.",
        f"term {frag.arith_term} (x y: Val): Val;",
        "",
        "-- The obligation itself: uninterpreted for the reason above — naming the",
        "-- claim is this layer's job; deciding it is the model's, and there is no",
        "-- x86_64 model here.",
        f"term native_{frag.subject}_edge (x y: Val): Prop;",
    ]
    return ("\n".join(lines) + "\n").encode()


# ── capture from sources ─────────────────────────────────────────────────────


def toolchain() -> tuple[str, str] | None:
    # The tree's own compiler first: a developer host can have an older
    # `austral` earlier on PATH (measured — `/usr/local/bin/austral` from another
    # checkout compiles this fixture to nothing), and a capture taken with a
    # different compiler than the tree's is not this tree's fragment.
    austral = os.environ.get("AUSTRAL_BIN") or str(ROOT / "austral")
    if not Path(austral).exists():
        austral = shutil.which("austral") or austral
    cell = str(ROOT / "safestos/cranelift/target/release/cps2cell")
    if not Path(cell).exists():
        cell = shutil.which("cps2cell") or cell
    if not (Path(austral).exists() and Path(cell).exists()):
        return None
    return str(austral), str(cell)


def build_capture(frag: Fragment, work: Path, clif_dump: bool) -> dict:
    tools = toolchain()
    if tools is None:
        raise DecodeError("no `austral`/`cps2cell` — the capture cannot be "
                          "re-derived here")
    austral, cell = tools
    # A developer tree keeps the `.so` at the root, a clean `make bridge` leaves
    # it only under `target/release`; both are on the loader path because the
    # compiler binary and the loader disagree about which copy they want.
    bridge_dir = ROOT / "safestos/cranelift/target/release"
    env = dict(os.environ)
    env["LD_LIBRARY_PATH"] = f"{ROOT}:{bridge_dir}:" + env.get("LD_LIBRARY_PATH", "")
    cps = work / f"{frag.key}.cps"
    run = subprocess.run(
        [austral, "compile", frag.source, f"--entrypoint={frag.module}:main",
         "--use-cps-jit", "--allow-all", "--target-type=c",
         f"--emit-cps={cps}", f"--output={work / 'native.c'}"],
        cwd=ROOT / "examples/native-fragment", env=env,
        capture_output=True, text=True)
    if not cps.exists():
        raise DecodeError("the fixture did not compile to CPS: " +
                          (run.stderr or run.stdout).strip().splitlines()[-1])
    avce_path = work / f"{frag.key}.avce"
    made = subprocess.run([cell, str(cps), str(avce_path)],
                          capture_output=True, text=True)
    if made.returncode != 0:
        raise DecodeError("cps2cell refused the CPS: " + made.stderr.strip())
    parsed = parse_avce(avce_path.read_bytes())
    for fn in parsed["functions"]:
        fn["insns"] = decode(bytes.fromhex(fn["bytes"]), fn["relocs"], frag.forms)
    parsed["cps_sha256"] = sha256(cps.read_bytes())
    parsed["avce_sha256"] = sha256(avce_path.read_bytes())
    parsed["clif"] = []
    if clif_dump:
        dumper = shutil.which("clif_dump") or \
            str(ROOT / "safestos/cranelift/target/release/clif_dump")
        if Path(dumper).exists():
            dumped = subprocess.run([dumper, str(cps)], capture_output=True,
                                    text=True)
            # `clif_dump` prints a function's instruction forms *before* its
            # `func <name> <count>` line, so the shape is buffered and flushed
            # when the name arrives.
            pending: list[str] = []
            for line in dumped.stdout.splitlines():
                if line.startswith("inst "):
                    pending.append(line)
                    continue
                m = re.match(r"^func (\S+) (\d+)$", line)
                if m and m.group(1) == frag.subject:
                    parsed["clif"] = list(pending)
                if m:
                    pending = []
    return parsed


# ── check ────────────────────────────────────────────────────────────────────


def model_sources() -> list[tuple[str, str]]:
    """The reviewed x86_64 model sources that would close this edge, resolved."""
    found = []
    env = os.environ.get("X86_MODEL")
    if env:
        found.append((env, MODEL_SOURCES[0][1]))
    path = ROOT / MODEL_SOURCES[1][0]
    if path.exists():
        found.append((str(path), MODEL_SOURCES[1][1]))
    return found


def check(frag: Fragment, work: Path,
          capture_path=None, mm0_path=None, model_path=None) -> int:
    ok = True
    capture_path = capture_path or frag.capture_path
    mm0_path = mm0_path or frag.statement_path
    model = Path(model_path) if model_path else MODEL
    try:
        capture = read_capture_toml(capture_path.read_text())
    except Exception as exc:  # noqa: BLE001 - any parse error is the finding
        fail("the capture parses", f"{capture_path}: {exc}")
        return 1

    if capture["arch"] != "x86_64":
        fail("the capture is a native x86_64 fragment",
             f"arch is {capture['arch']!r}")
        ok = False
    if capture["subject"] != frag.subject or \
            frag.subject not in [f["name"] for f in capture["functions"]]:
        fail("the capture holds the declared subject function",
             f"subject {capture['subject']!r}, functions "
             f"{[f['name'] for f in capture['functions']]}")
        ok = False

    # (1) decode the recorded bytes again; the recorded rows are not trusted.
    for fn in capture["functions"]:
        try:
            insns = decode(bytes.fromhex(fn["bytes"]), fn["relocs"], frag.forms)
        except DecodeError as exc:
            fail("every recorded byte is a form in the table",
                 f"{fn['name']}: {exc}")
            ok = False
            continue
        recorded = [{"offset": i["offset"], "bytes": i["bytes"],
                     "form": i["form"]} for i in fn["insns"]]
        fresh = [{k: i[k] for k in ("offset", "bytes", "form")} for i in insns]
        if fresh != recorded:
            fail("the recorded instructions match a fresh decode", fn["name"])
            ok = False

    # (2) the stated edge is exactly what this capture generates.
    digests = {"capture": sha256(capture_path.read_bytes())}
    for key, path in (("clif", CLIF), ("isa", ISA), ("model", MODEL)):
        digests[key] = sha256(path.read_bytes()) if path.exists() else "absent"
    want = render_mm0(frag, capture, digests)
    have = mm0_path.read_bytes() if mm0_path.exists() else b""
    if want != have:
        first = next((i for i, (a, b) in enumerate(zip(want, have)) if a != b),
                     min(len(want), len(have)))
        fail("the stated edge is generated from the capture",
             f"{mm0_path} differs at byte {first}")
        ok = False
    text = have.decode("utf-8", "replace")
    for banned in ("axiom", "theorem"):
        if re.search(rf"^\s*{banned}\b", text, re.M):
            fail("the edge states no axiom and no theorem",
                 f"the file declares a {banned}")
            ok = False
    if "-- certificate: [gap]" not in text:
        fail("the edge is marked [gap], not a certificate")
        ok = False

    # (3) the cited model: pinned, covering every ALU form in the capture, and —
    # when this host has Lean — rechecked rather than trusted.
    pin = re.search(r"^-- model: (\S+) sha256=([0-9a-f]{64})$", text, re.M)
    if not pin:
        fail("the edge pins the cited instruction model")
        ok = False
    elif not model.exists():
        fail("the cited instruction model exists", pin.group(1))
        ok = False
    elif sha256(model.read_bytes()) != pin.group(2):
        fail("the cited instruction model is the one the edge was generated from",
             f"{pin.group(1)} has changed since the edge was written")
        ok = False
    else:
        subject = next((f for f in capture["functions"]
                        if f["name"] == frag.subject), None)
        needed = set()
        for insn in (subject["insns"] if subject else []):
            parts = insn["form"].split(" ")
            mnemonic = parts[0]
            target = parts[1].rstrip(",") if len(parts) > 1 else ""
            # a frame adjustment moves the stack pointer, not the kernel value
            if mnemonic in ALU_FORMS and target not in ("rsp", "rbp"):
                needed.add(mnemonic)
        missing = sorted(needed - model_forms(model))
        if missing:
            fail("every ALU form in the capture has a semantics in the model",
                 f"{', '.join(missing)} has no definition in the cited model")
            ok = False
        lean = lean_binary()
        if lean is None:
            gap("the instruction model was not rechecked here (no lean); its pin "
                "is checked, its proofs are not")
        else:
            run = subprocess.run([lean, str(model)], capture_output=True, text=True)
            combined = run.stdout + run.stderr
            if run.returncode != 0 or "error:" in combined:
                fail("the cited instruction model still checks",
                     combined.strip().splitlines()[-1] if combined.strip()
                     else "lean failed")
                ok = False
            else:
                body = model.read_text()
                # code only: the header discusses `sorry`/`axiom` on purpose
                code = re.sub(r"/-.*?-/" , "", body, flags=re.S)
                code = re.sub(r"--[^\n]*", "", code)
                if re.search(r"\b(sorry|admit|axiom)\b", code):
                    fail("the cited instruction model assumes nothing",
                         "it contains sorry/admit/axiom")
                    ok = False
                listed = set(re.findall(r"theorem ([A-Za-z0-9_]+)", code))
                declared = re.findall(r'"([A-Za-z0-9_]+)"',
                                      body.split("def THEOREMS")[-1].split("]")[0])
                stale = sorted(set(declared) - listed)
                if stale:
                    fail("every theorem the model declares exists in it",
                         f"missing {stale}")
                    ok = False
                print(f"  [detail] PC08 model: {model.name} rechecked by lean "
                      f"({len(declared)} theorem(s)); covers "
                      f"{', '.join(sorted(model_forms(model)))}")

    # (4) re-derive from the sources when this host can; otherwise a gap.
    tools = toolchain()
    if tools is None:
        gap("the capture was not re-derived here (no `austral`/`cps2cell`); "
                  "the recorded bytes are decoded and pinned, not regenerated")
    else:
        try:
            fresh_capture = build_capture(frag, work, clif_dump=True)
        except DecodeError as exc:
            fail("the fixture still captures", str(exc))
            ok = False
        else:
            if capture_bytes(frag, fresh_capture) != capture_path.read_bytes():
                fail("the capture re-derives byte-identically from the fixture")
                ok = False
            if capture["cps_sha256"] == fresh_capture["cps_sha256"] and \
                    capture["avce_sha256"] != fresh_capture["avce_sha256"]:
                fail("the same CPS produces the same capture",
                     "cps_sha256 agrees but avce_sha256 does not")
                ok = False

    # (4) replay the stated edge: well-formedness only, never a proof.
    if not (shutil.which("mm0-rs") and shutil.which("mm0-c")):
        gap(f"native_{frag.key}.mm0 not replayed (no mm0-rs/mm0-c on PATH)")
    else:
        mmb = work / f"native_{frag.key}.mmb"
        compiled = subprocess.run(["mm0-rs", "compile", str(mm0_path), str(mmb)],
                                  capture_output=True, text=True)
        if compiled.returncode != 0:
            fail(f"native_{frag.key}.mm0 compiles",
                 (compiled.stderr or compiled.stdout).strip()[:400])
            ok = False
        else:
            checked = subprocess.run(["mm0-c", str(mmb)],
                                     input=have, capture_output=True)
            if checked.returncode != 0:
                fail("mm0-c accepts the stated edge",
                     checked.stderr.decode(errors="replace").strip()[-400:])
                ok = False

    # (5) the open edge is only honest while no reviewed model exists.
    models = model_sources()
    if models:
        fail("no reviewed x86_64 model is available, so the edge may be "
                   "stated rather than proved",
             "a model source now resolves: " +
             ", ".join(path for path, _ in models) +
             " — this edge has to be proved now, not stated")
        ok = False

    subject = next((f for f in capture["functions"] if f["name"] == frag.subject), None)
    if subject is not None:
        print(f"  [detail] PC08 fragment: {frag.key} ({frag.subject}) — "
              f"{len(subject['bytes']) // 2} byte(s), "
              f"{len(subject['insns'])} instruction(s), "
              f"{len(subject['relocs'])} relocation(s), arch {capture['arch']}")
        print(f"  [detail] PC08 imports: {', '.join(capture['imports'])}")
        # the arithmetic itself, not the stack adjustment: an ALU op on a
        # computed register rather than on `rsp`/`rbp`.
        inline = [i["form"] for i in subject["insns"]
                  if i["form"].split(" ")[0] in ("sub", "imul", "add", "mul")
                  and i["form"].split(" ")[1].rstrip(",") not in ("rsp", "rbp")]
        if inline:
            print(f"  [detail] PC08 inlined arithmetic: {', '.join(inline)}")
    if ok:
        alu = sorted({i["form"].split(" ")[0] for i in subject["insns"]
                      if i["form"].split(" ")[0] in ALU_FORMS
                      and i["form"].split(" ")[1].rstrip(",") not in ("rsp", "rbp")})
        if alu:
            gap("the arithmetic core of the `" + frag.key + "` fragment ("
                + ", ".join(alu) + ") and its stack-pointer/`call`/`ret` "
                "discipline are modelled and proved, but its stack bytes and "
                "the trap callee's body are not, so the fragment's edge stays "
                "open")
        else:
            gap("the `" + frag.key + "` fragment's arithmetic is external and "
                "its ABI/call edge is unmodelled, so its edge is stated and "
                "pinned, not proved")
        print(f"[pass] PC08: the captured `{frag.key}` fragment decodes, "
              "re-derives and is pinned by its stated edge")
        return 0
    return 1


# ── controls ─────────────────────────────────────────────────────────────────


def selftest(frag: Fragment, work: Path,
             capture_path=None, mm0_path=None) -> int:
    ok = True
    capture_path = capture_path or frag.capture_path
    mm0_path = mm0_path or frag.statement_path
    capture_text = capture_path.read_text()
    mm0_text = mm0_path.read_text()

    model: Path | None = None

    def run(capture: str, stated: str, label: str, needle: str,
            model_file: Path | None = None) -> None:
        nonlocal ok
        model = model_file
        base = work / f"control-{frag.key}"
        base.mkdir(exist_ok=True)
        cap = base / f"{frag.key}.capture"
        art = base / f"native_{frag.key}.mm0"
        cap.write_text(capture)
        art.write_text(stated)
        out = subprocess.run([sys.executable, __file__, "check",
                              "--fragment", frag.key,
                              "--capture", str(cap), "--mm0", str(art)]
                             + (["--model", str(model)] if model else []),
                             capture_output=True, text=True)
        combined = out.stdout + out.stderr
        if out.returncode != 1 or needle not in combined:
            ok = False
            fail(f"control: {label} is refused",
                 f"exit {out.returncode}, output {combined.strip()[:300]!r}")
        else:
            print(f"  [pass] PC08 control refused ({frag.key}): {label}")

    subject = next(f for f in read_capture_toml(capture_text)["functions"]
                   if f["name"] == frag.subject)
    first_dir = next((i["form"].split(" ")[0] for i in subject["insns"]), "")
    # the operand whose mutation must be caught: whichever immediate the caller
    # passes first, or the first ALU operand of an inlined fragment.
    imm = re.search(r'form = "(mov \w+, imm32 0x[0-9a-f]+)"', capture_text)
    alu = next((i for i in subject["insns"]
                if i["form"].split(" ")[0] in ("sub", "imul", "add", "mul")), None)

    # 1. a changed immediate: an argument stops being what the caller passes.
    if imm:
        changed = imm.group(1).rsplit("0x", 1)[0] + "0x5"
        run(capture_text.replace(imm.group(1), changed, 1), mm0_text,
            "a changed argument immediate", "match a fresh decode")

    # 2. a changed relocation target.
    target = next((r["symbol"] for f in read_capture_toml(capture_text)["functions"]
                   for r in f["relocs"]), None)
    if target:
        run(capture_text.replace(f'symbol = "{target}"', 'symbol = "main"', 1),
            mm0_text, "a changed relocation target", "match a fresh decode")

    # 3. a flipped instruction byte with the recording left alone.
    run(re.sub(r'bytes = "([0-9a-f]{2})', lambda m: 'bytes = "%02x' %
               (int(m.group(1), 16) ^ 0x02), capture_text, count=1),
        mm0_text, "a flipped instruction byte", "is not a form in the table")

    # 4. a truncated body: the last instruction is cut off.
    run(re.sub(r'bytes = "([0-9a-f]{2,})"',
               lambda m: f'bytes = "{m.group(1)[:-2]}"', capture_text, count=1),
        mm0_text, "a truncated function body", "match a fresh decode")

    # 5. a different arch claimed for the same bytes.
    run(capture_text.replace('arch = "x86_64"', 'arch = "aarch64"', 1),
        mm0_text, "a different target architecture", "native x86_64 fragment")

    # 6. the stated edge edited away from what the capture generates.
    run(capture_text,
        mm0_text.replace(f"x86_{frag.subject}", "x86_other", 1),
        "a hand-edited statement", "generated from the capture")

    # 7. the edge re-labelled as a certificate.
    run(capture_text,
        mm0_text.replace("-- certificate: [gap]", "-- certificate: [pass]", 1),
        "an edge relabelled as a certificate", "marked [gap]")

    # 8. an axiom added to the edge (it would be an unearned semantics).
    run(capture_text,
        mm0_text + f"\naxiom native_{frag.subject}_holds (x y: Val): "
        f"$ native_{frag.subject}_edge x y $;\n",
        "an axiom added to the edge", "no axiom and no theorem")

    # 9. a model appearing: the stated edge must stop being acceptable.
    model_dir = work / f"model-{frag.key}"
    model_dir.mkdir(exist_ok=True)
    fake = model_dir / "x86_instructions.mm0"
    fake.write_text("-- a reviewed model appeared\n")
    env = dict(os.environ, X86_MODEL=str(fake))
    out = subprocess.run([sys.executable, __file__, "check",
                          "--fragment", frag.key],
                         capture_output=True, text=True, env=env)
    combined = out.stdout + out.stderr
    if out.returncode != 1 or "has to be proved now" not in combined:
        ok = False
        fail("control: a reviewed x86_64 model is refused",
             f"exit {out.returncode}, output {combined.strip()[:300]!r}")
    else:
        print(f"  [pass] PC08 control refused ({frag.key}): "
              "a reviewed x86_64 model appearing")

    # 10. the cited model's bytes changed: the pin in the edge is stale.
    stale_model = work / f"model-{frag.key}-stale.lean"
    stale_model.write_text(MODEL.read_text() + "\n-- an edit\n")
    run(capture_text, mm0_text, "a changed cited model",
        "is the one the edge was generated from", model_file=stale_model)

    # 11. coverage is a positive fact, not only a refusal: the model must
    #     declare every ALU form both captures execute (the same rule `check`
    #     enforces; stated here so a shrinking model is visible in the selftest).
    modeled = model_forms(MODEL)
    for other in FRAGMENTS:
        capture_other = read_capture_toml(other.capture_path.read_text())
        subject_other = next((f for f in capture_other["functions"]
                              if f["name"] == other.subject), None)
        for insn in (subject_other["insns"] if subject_other else []):
            parts = insn["form"].split(" ")
            if parts[0] in ALU_FORMS and len(parts) > 1 and \
                    parts[1].rstrip(",") not in ("rsp", "rbp") \
                    and parts[0] not in modeled:
                ok = False
                fail("control: every captured ALU form is modelled",
                     f"{other.key}: {parts[0]} is not in the cited model")

    if ok:
        print(f"[pass] PC08 selftest ({frag.key}): 10 controls behave")
        return 0
    return 1


# ── main ─────────────────────────────────────────────────────────────────────


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("mode", nargs="?", default="check",
                    choices=["check", "capture", "selftest"])
    ap.add_argument("--fragment", choices=[f.key for f in FRAGMENTS],
                    help="default: every fragment")
    ap.add_argument("--capture", help="override the capture path (controls)")
    ap.add_argument("--mm0", help="override the statement path (controls)")
    ap.add_argument("--model", help="override the cited model (controls)")
    args = ap.parse_args()

    selected = [f for f in FRAGMENTS
                if args.fragment is None or f.key == args.fragment]
    if args.capture or args.mm0:
        if len(selected) != 1:
            print("[FAIL] PC08: --capture/--mm0 name one fragment")
            return 1
        selected = [selected[0]]

    status = 0
    with tempfile.TemporaryDirectory(prefix="pc08-") as tmp:
        work = Path(tmp)
        for frag in selected:
            cap = Path(args.capture) if args.capture else frag.capture_path
            art = Path(args.mm0) if args.mm0 else frag.statement_path
            if args.mode == "capture":
                try:
                    capture = build_capture(frag, work, clif_dump=True)
                except DecodeError as exc:
                    gap(f"the capture was not rebuilt: {exc}")
                    status = status or 3
                    continue
                cap.write_bytes(capture_bytes(frag, capture))
                digests = {"capture": sha256(cap.read_bytes())}
                for key, path in (("clif", CLIF), ("isa", ISA), ("model", MODEL)):
                    digests[key] = sha256(path.read_bytes()) \
                        if path.exists() else "absent"
                art.write_bytes(render_mm0(frag, capture, digests))
                print(f"  [detail] PC08 capture: wrote "
                      f"{cap.relative_to(ROOT)} and {art.relative_to(ROOT)}")
                continue
            if args.mode == "selftest":
                status = status or selftest(frag, work, cap, art)
                continue
            status = status or check(frag, work, cap, art, args.model)
    return status


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""Scan a Lean export: emit a typing derivation per declaration, verify it, report.

For every declaration of one module that carries a value (a theorem's proof term
or a definition's body) this runs `scripts/lean-typing-proof --spine`, assembles
the artifact against `docs/cic.mm0` + `docs/cic_typing.mm0`, and asks both
checkers (`mm0-rs compile` for elaboration and `sorry`, `mm0-c` for the kernel)
whether the derivation closes. What is reported is therefore *verified* closures,
not emitted files.

A declaration that the deriver cannot express is recorded with the reason it
gave and the class of that reason, so the histogram is the worklist: each class
is a rule the theory or the emitter does not have yet.

What a verified declaration leaves behind is a statement that is proved — the
derivation itself is megabytes that say exactly that, so it is discarded. The
statement and the verdict go into a ledger (`<work-dir>.memo`, or `--memo=DIR`),
and a declaration whose statement is already in it is not emitted or checked
again: a sweep that was interrupted, a subset scan followed by a superset one,
or a re-export of the same module resumes instead of restarting.

The ledger has two keys, and the cheap one is tried first. A row is filed under
the export that produced it, so re-scanning that export is a table lookup. It is
also filed under the sha256 of its statement's bytes — the goal band, which is
the whole of what was proved — so a *different* export that states the same
construction is a hit too, once this scan has asked the emitter what that
export states (`lean-typing-proof --digest`, which stops before the walk).
Statements are byte-identical or they are not reused; nothing is guessed from
the declaration's name.

`--adopt=DIR` seeds the ledger from a completed scan's artifacts instead of a
verdict: every `full.mm0`/`full.mm1` pair under DIR is re-checked by both
checkers, and the ones that still close are registered. The proofs are then
their own evidence only once, so they are discarded like a fresh sweep's.

Usage: lean-proof-scan <export.ndjson> <module-prefix> <work-dir> [--defer-subst]
       [--memo=DIR | --no-memo] [--keep-proofs] [--adopt=DIR]
       [--audit-statements] [--rekey]

Exit status is 0 when the scan itself ran (whatever it found), 1 when nothing
in scope could be verified.
"""
from __future__ import annotations

import collections
import hashlib
import importlib.machinery
import importlib.util
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

AVM = Path(__file__).resolve().parent.parent
EMITTER = AVM / "scripts" / "lean-typing-proof"
LEAN2MM0 = AVM / "scripts" / "lean2mm0"
THEORIES = [AVM / "docs" / "cic.mm0", AVM / "docs" / "cic_typing.mm0"]

loader = importlib.machinery.SourceFileLoader("lean2mm0", str(LEAN2MM0))
spec = importlib.util.spec_from_loader("lean2mm0", loader)
l2m = importlib.util.module_from_spec(spec)
sys.modules["lean2mm0"] = l2m
loader.exec_module(l2m)


def theory_text() -> str:
    """The two theories as one self-contained prefix (`cic_typing` imports `cic`)."""
    parts = []
    for p in THEORIES:
        for line in p.read_text().splitlines():
            if line.startswith("import"):
                continue
            parts.append(line)
    return "\n".join(parts) + "\n"


def last_meaningful(text: str) -> str:
    for line in reversed(text.strip().splitlines()):
        if line.strip():
            return line.strip()
    return "(no output)"


def tail_text(path: Path, limit: int = 8192) -> str:
    """The last `limit` bytes of a log, decoded — never the whole file."""
    try:
        size = path.stat().st_size
        with open(path, "rb") as fh:
            if size > limit:
                fh.seek(size - limit)
            return fh.read().decode("utf-8", "replace")
    except OSError:
        return ""


# A rejected derivation is dumped in full, so the reader walks the stream and
# stops at the verdict instead of holding the dump. `fail()` prints, in order,
# `stmt: <offset>`, the command dump, a blank line, the verdict, and only then
# the input echo. Only a URef dump can be large (it prints the whole expression
# being unified on one line); 256 MiB of it is far past anything measured, and
# the cap keeps a pathological one from stalling the sweep.
MM0_C_READ_CAP = 1 << 28


def mm0_c_verdict(err: Path, cap: int = MM0_C_READ_CAP) -> str:
    """The line `mm0-c` printed as its decision, not what it dumped with it.

    Two layouts, both measured from `verifier.c::fail()`:

      stmt: <offset>\ncmd: <dump>\n[ucmd: <dump>\n]\n<verdict>\n\n<input echo>

    or the verdict on its own when the checker failed before it had a statement
    (`at %lX: 'thm' uses sorry`, `error: some theorems used sorry`, a parser
    failure). In the first, the verdict is the line after the dump's blank line;
    the dump is one line per command and a `URef` line is the expression being
    unified, which on `.declQuotPB_at` alone ran past 8 KiB, so the boundary has
    to be found in the stream rather than in a fixed-size prefix. Nothing after
    the verdict is read: that is the echo, up to 4.5 GB on
    `.TgtNodePres.kit._proof_1`.
    """
    try:
        fh = open(err, "rb")
    except OSError:
        return ""
    with fh:
        buf = fh.read(1 << 16)
        if not buf.startswith(b"stmt: "):
            return buf.split(b"\n", 1)[0].decode("utf-8", "replace").strip()
        read = len(buf)
        while True:
            cut = buf.find(b"\n\n")
            if cut >= 0:
                rest = buf[cut + 2:].split(b"\n", 1)[0]
                if not rest and read < cap:
                    rest = fh.readline().split(b"\n", 1)[0]
                return rest.decode("utf-8", "replace").strip()
            if read >= cap:
                return ""
            chunk = fh.read(1 << 20)
            if not chunk:
                return ""
            read += len(chunk)
            # A `\n\n` may straddle the chunk boundary; one byte carries it.
            buf = buf[-1:] + chunk


def mm0_c_reason(err: Path, out: Path) -> str:
    """What `mm0-c` decided, not the derivation it printed with the decision.

    On rejection the checker prints its verdict and then the statement it
    rejected, so neither end of its stderr is the verdict in general: it opens
    with `stmt: <offset>` and closes with a fragment of the dump (measured:
    `.declQuotPB_at` reported as `ucc (tsucc …`).
    """
    verdict = mm0_c_verdict(err)
    if verdict:
        return verdict
    # Died before printing one (a signal, an empty stream). Its stdout is empty
    # in every rejection measured, so the fallback says what it can and does not
    # quote a dump fragment as if it were the checker's decision.
    return last_meaningful(tail_text(out))

def classify(reason: str) -> str:
    """One bucket per kind of missing support, keyed on the deriver's own words."""
    for pat, label in (
        (r"no exported type for constant", "constant type missing from export"),
        (r"the function's type is not a Π", "applied non-function (type-level application)"),
        (r"unhandled expression", "expression form outside the fragment"),
        (r"bvar .* not bound", "index escape (substitution bug, not a class)"),
        (r"binder mismatch", "value/type λ-spine mismatch"),
        (r"lambda against a non-Π", "λ checked against a non-Π type"),
        (r"failed to unify", "MM0 elaboration rejected the derivation"),
        (r"uses sorry|contains sorry", "outstanding obligation became sorry"),
        # `mm0-c`'s heap is a fixed buffer, not the machine's memory: a
        # derivation it rejects this way is a size its verifier cannot hold, and
        # it dumps the derivation (gigabytes) before exiting.
        (r"heap overflow", "over the checker's own heap"),
        (r"MemoryError|memory", "out of memory"),
    ):
        if re.search(pat, reason, re.I):
            return label
    return "other"


# Overridable for the same reason the `mm0-rs` budgets below are: a retry pass
# asks whether a declaration is *large* or merely over the budget the first pass
# gave it, and only a re-run at a different bound answers that.
EMIT_TIMEOUT = int(os.environ.get("SCAN_EMIT_TIMEOUT", "240"))
EMIT_MEM_GB = int(os.environ.get("SCAN_EMIT_MEM_GB", "8"))
# Both bounds are *budgets*, not properties of the derivation, and both are
# overridable so a row can be re-measured instead of only classified: a proof
# term of 10^6 nodes is not rejected by either checker, it outlasts the budget
# (measured: a 102 MB / 37 441-rule artifact needs 819 s of `mm0-rs` and 0.8 s
# of `mm0-c`, the latter being where the verdict actually comes from).
MM0_RS_TIMEOUT = int(os.environ.get("SCAN_MM0_RS_TIMEOUT", "240"))
# `mm0-rs` on a 10^5-rule term reached 13 GB before the timeout; left alone it
# takes the machine's memory with it, so the child is bounded on its own. A
# capped allocation fails inside the child instead of OOM-killing the sweep.
MM0_RS_MEM_GB = int(os.environ.get("SCAN_MM0_RS_MEM_GB", "10"))
# `mm0-c` had no time budget because it never needed one: it re-checks a compiled
# derivation in under a second. But it also dumps the whole derivation to stderr
# when it rejects one (`heap overflow` on `.TgtNodePres.kit._proof_1` produced
# more than 3.9 GB in ten minutes), so a rejected giant can run for as long as
# its trace takes to write. Budget it, and overridable like the others.
MM0_C_TIMEOUT = int(os.environ.get("SCAN_MM0_C_TIMEOUT", "900"))


# ── the ledger of proved statements ──────────────────────────────────────────
#
# An entry is written only after `mm0-rs` and `mm0-c` have both accepted the
# derivation. It carries two keys: the export that produced it (`Export.sha256`,
# declaration name, kind) and the sha256 of the statement it proved. The first
# is free to look up and answers "was this exact sweep already done"; the second
# is what survives a re-export, where every export sha changes and nothing about
# the theorem does.
#
# The statement's digest is taken over the goal band alone — `theorem thm_X: $
# tty ctx value type $` — not over the whole retained file, whose header names
# the source export and counts the rules of the derivation that is being
# discarded. Two things that state the same thing hash the same; two things that
# were merely proved the same way do not.
LEDGER_COLUMNS = ("export", "theory", "mode", "declaration", "kind", "rules",
                  "assumptions", "statement_bytes", "statement_sha256",
                  "derivation_sha256", "derivation_bytes", "verified_at")
GOAL_MARK = "-- ── the derivation ──\n"
# The same marker in a retained statement: `statement_of_text` relabels it, and
# the band below it is byte-for-byte the one `GOAL_MARK` introduces.
STATED_MARK = "-- ── the statement, proved\n"


def slug(nm: str) -> str:
    return re.sub(r"[^A-Za-z0-9_.]", "_", nm).strip("_")


def ledger_read(root: Path) -> dict[tuple[str, str, str, str], dict[str, str]]:
    """The last entry per (export, theory, mode, declaration).

    A row shorter than the header is padded rather than dropped: the column set
    is an interface to scans that are already running, and a row written by an
    older one still knows its keys.
    """
    index = root / "index.tsv"
    out: dict[tuple[str, str, str, str], dict[str, str]] = {}
    if not index.exists():
        return out
    for line in index.read_text().splitlines():
        if not line or line.startswith("#"):
            continue
        fields = line.split("\t")
        if not fields[0]:
            continue
        row = dict(zip(LEDGER_COLUMNS, fields))
        for col in LEDGER_COLUMNS:
            row.setdefault(col, "")
        out[(row["export"], row["theory"], row["mode"],
             row["declaration"])] = row
    return out


def statement_digest(text: str) -> str:
    """sha256 of the goal band: the statement, and nothing that describes its
    derivation.

    `lean-typing-proof --digest` hashes the same bytes from the export side, so a
    scan can ask "does this export state what that ledger row proved" without
    keeping the row's proof, and without trusting a name.
    """
    i = text.index(GOAL_MARK) + len(GOAL_MARK)
    return hashlib.sha256(text[i:].encode()).hexdigest()


def statement_of_text(text: str) -> str:
    """A verified `.mm0` minus its assumptions: the statement and its setting.

    The emitter writes the artifact in four bands — theory prefix, header,
    payload numerals, assumptions, then the goal. The goal is `tty …` at the
    declaration's own type, and the assumptions are the leaf typings the
    derivation consumed: they are not part of what was proved, and keeping them
    would keep most of the proof's working set. Whatever the statement's text
    refers to (the numerals MM0 will not read inside `$…$`) sits above the
    assumptions and stays.
    """
    head = text[:text.index("-- ── assumptions ──")]
    goal = text[text.index(GOAL_MARK[:-1]):]
    state = ("-- State         : PROVED — `mm0-rs compile` and `mm0-c` accepted "
             "the derivation of this\n"
             "--                 statement; the derivation itself was discarded "
             "after verification\n"
             "--                 (its sha256 and size are in the ledger's "
             "index.tsv).\n"
             "-- As an `.mm0` file this is a bare statement, and `mm0-rs` will "
             "report it as\n"
             "-- `sorry`: the proof is not here, and nothing in MM0 lets one "
             "file cite\n"
             "-- another's proof. The ledger is what says this statement was "
             "derived.\n")
    goal = goal.replace(GOAL_MARK[:-1], STATED_MARK[:-1], 1)
    return head + state + goal


def ledger_append(root: Path, full0_text: str, export_tag: str, theory_sha: str,
                  mode: str, name: str, kind: str, rules: int, axs: int,
                  deriv_sha: str, deriv_bytes: int) -> Path:
    """Register one verified statement and keep the statement itself.

    The retained file is content-addressed (`stmt/<digest>/`): the same statement
    proved for two exports is one file, and a row's statement is findable from
    the row without a second column saying where it went.
    """
    # The digest is taken before the retained copy is written: the retained
    # copy relabels the derivation marker, and the digest has to agree with
    # what `lean-typing-proof --digest` computes from a fresh export.
    digest = statement_digest(full0_text)
    text = statement_of_text(full0_text)
    dest = root / "stmt" / digest[:12]
    dest.mkdir(parents=True, exist_ok=True)
    path = dest / (slug(name) + ".mm0")
    path.write_text(text)
    index = root / "index.tsv"
    fresh = not index.exists()
    with index.open("a") as fh:
        if fresh:
            fh.write("# " + "\t".join(LEDGER_COLUMNS) + "\n")
        fh.write("\t".join(str(v) for v in (
            export_tag, theory_sha, mode, name, kind, rules, axs,
            path.stat().st_size, digest, deriv_sha, deriv_bytes,
            time.strftime("%Y-%m-%dT%H:%M:%S"))) + "\n")
    return path


def ledger_rekey(root: Path) -> int:
    """Recompute every row's statement key from the statement it retained.

    The first content-keyed ledger hashed the *retained file* — header, payload
    constants, assumptions and the state prose — instead of its goal band, so no
    `--digest` could ever reproduce its key. The statement is still on disk, and
    `STATED_MARK` names the band, so the key can be recomputed without
    re-verifying anything: what the row proved does not change, only the way it
    is identified. The band is also written under its own digest, which is where
    a content-addressed ledger expects to find it; the old copy stays, since a
    row that still names the old directory is not one this pass created.
    """
    index = root / "index.tsv"
    if not index.exists():
        raise SystemExit(f"--rekey: no ledger at {index}")
    out: list[str] = []
    rows = changed = missing = 0
    for line in index.read_text().splitlines():
        if not line or line.startswith("#"):
            out.append(line)
            continue
        fields = line.split("\t")
        row = dict(zip(LEDGER_COLUMNS, fields))
        for col in LEDGER_COLUMNS:
            row.setdefault(col, "")
        rows += 1
        name = slug(row["declaration"]) + ".mm0"
        # Three layouts are searched: a row may name its export whole, name its
        # export's prefix (the first content ledger's directories), or name the
        # digest it was written under.
        src = next((p for p in (root / "stmt" / row["export"] / name,
                                root / "stmt" / row["export"][:12] / name,
                                root / "stmt" / row["statement_sha256"][:12] / name)
                    if p.exists()), None)
        if src is None:
            missing += 1
            out.append(line)
            continue
        text = src.read_text()
        if STATED_MARK not in text:
            missing += 1
            out.append(line)
            continue
        digest = hashlib.sha256(text.split(STATED_MARK, 1)[1].encode()).hexdigest()
        if digest != row["statement_sha256"]:
            row["statement_sha256"] = digest
            changed += 1
            dest = root / "stmt" / digest[:12] / name
            if not dest.exists():
                dest.parent.mkdir(parents=True, exist_ok=True)
                dest.write_text(text)
        out.append("\t".join(row[col] for col in LEDGER_COLUMNS))
    tmp = index.with_suffix(".tsv.tmp")
    tmp.write_text("\n".join(out) + "\n")
    tmp.replace(index)
    print(f"rekey  : {rows} row(s), {changed} statement key(s) recomputed,"
          f" {missing} without a retained statement")
    return 0


def reread_ok(full0: Path, full1: Path, mmb: Path) -> str | None:
    """Both checkers, again, on an artifact pair; `None` when it still closes.

    A claim of "verified" that cannot be reproduced from the bytes is not one,
    so adoption re-runs the same two commands a fresh sweep does rather than
    trusting a file's presence.
    """
    try:
        c = run(["mm0-rs", "compile", str(full1), str(mmb)],
                timeout=MM0_RS_TIMEOUT, preexec_fn=cap_mem(MM0_RS_MEM_GB))
    except subprocess.TimeoutExpired:
        return f"mm0-rs: over {MM0_RS_TIMEOUT} s"
    if c.returncode == -6 or "memory allocation" in (c.stdout + c.stderr):
        return f"mm0-rs: over {MM0_RS_MEM_GB} GiB"
    if c.returncode != 0 or "sorry" in (c.stdout + c.stderr):
        return "mm0-rs: " + last_meaningful(c.stdout + c.stderr)
    with full0.open() as fh:
        k = run(["mm0-c", str(mmb)], stdin=fh)
    mmb.unlink(missing_ok=True)
    if k.returncode != 0:
        return "mm0-c: " + last_meaningful(k.stdout + k.stderr)
    return None


def discard_proofs(d: Path) -> None:
    """Remove a declaration's derivation and the emitter's copies of it.

    `full.mm0` stays: it is the statement the ledger says was proved. Named
    generously on purpose — a directory holding someone else's `.mm1` is not
    touched, because the names are the emitter's own.
    """
    for p in (d / "full.mm1", d / "full.mmb", d / "full.mmb.tmp"):
        p.unlink(missing_ok=True)
    for p in d.glob("*_typing.mm1"):
        p.unlink(missing_ok=True)
    for p in d.glob("*_obligations.jsonl"):
        p.unlink(missing_ok=True)


def adopt(root: Path, memo_root: Path, prefix_text: str, theory_sha: str,
          mode_tag: str, keep_proofs: bool,
          known: dict[tuple[str, str, str, str], dict[str, str]]) -> None:
    """Seed the ledger from a completed scan's artifacts, re-checking each one.

    What a scan leaves is `full.mm0` (statement) and, when it was asked to keep
    them, `full.mm1` (statement plus derivation). A ledger is worth more than
    the directory: it is what a later export gets to reuse. So the pairs are
    re-checked here, registered under the statement digest with `-` as their
    export (no export claims them — they may predate this one), and then the
    derivations are discarded exactly as a fresh pass discards its own.

    A directory whose proofs were already discarded has nothing to re-check and
    is reported as such: a ledger cannot be rebuilt from statements alone, which
    is why the statements it holds claim a verification rather than perform one.
    """
    pairs = sorted(root.glob("*/full.mm0"))
    have = {r["statement_sha256"] for r in known.values()
            if r["theory"] == theory_sha and r["statement_sha256"]}
    registered = already = 0
    reasons: collections.Counter[str] = collections.Counter()
    t0 = time.time()
    for full0 in pairs:
        text = full0.read_text()
        m = re.search(r"^-- Declaration\s*: (\S+) \[(\w+)\]", text, re.M)
        if m is None:
            reasons["no `-- Declaration` header"] += 1
            continue
        name, kind = m.group(1), m.group(2)
        short = name.split(".")[-1]
        if not text.startswith(prefix_text):
            reasons["theory prefix is not docs/cic*.mm0"] += 1
            print(f"  adopt ✗ {short}: theory prefix is not docs/cic*.mm0")
            continue
        full1 = full0.with_name("full.mm1")
        if not full1.exists():
            reasons["no .mm1: its proof was discarded already"] += 1
            continue
        why = reread_ok(full0, full1, full0.with_name("full.mmb"))
        digest = statement_digest(text)
        if why is not None:
            reasons[classify(why)] += 1
            print(f"  adopt ✗ {short}: {why[:110]}")
            continue
        rules = int(re.search(r"^-- Rules applied : (\d+)", text, re.M).group(1))
        axs = int(re.search(r"^-- Assumptions   : (\d+)", text, re.M).group(1))
        if digest in have:
            already += 1
            if not keep_proofs:
                discard_proofs(full0.parent)
            continue
        ledger_append(memo_root, text, "-", theory_sha, mode_tag, name, kind,
                      rules, axs,
                      hashlib.sha256(full1.read_bytes()).hexdigest(),
                      full1.stat().st_size)
        have.add(digest)
        registered += 1
        print(f"  adopt ✓ {short} [{kind}] rules={rules} assumptions={axs}"
              f" (re-checked)")
        if not keep_proofs:
            discard_proofs(full0.parent)
    print(f"adopt  : {registered} registered, {already} already in the ledger,"
          f" {sum(reasons.values())} skipped of {len(pairs)} artifact(s)"
          f" in {time.time() - t0:.1f} s")
    for label, n in reasons.most_common():
        print(f"  {n:3d}  {label}")
    print()


def digest_of(name: str, export_path: Path, out: Path) -> str | None:
    """The statement digest of one declaration, from the export alone.

    One `--digest` run costs what asking the export a question costs — the
    index and the encodes — and not what proving the answer costs. `None` when
    that run did not finish: the caller then emits as usual and the sweep's own
    budgets report the declaration.
    """
    out.mkdir(parents=True, exist_ok=True)
    try:
        r = run([str(EMITTER), str(export_path), name, str(out), "--spine",
                 "--digest"], timeout=EMIT_TIMEOUT, preexec_fn=cap_mem(EMIT_MEM_GB))
    except subprocess.TimeoutExpired:
        return None
    if r.returncode != 0:
        return None
    m = re.search(r"^digest\s*: ([0-9a-f]{64})$", r.stdout, re.M)
    return m.group(1) if m else None


def audit_statements(scope, export_path: Path, work: Path, ledger, theory_sha: str,
                     prefix: str) -> int:
    """The re-export question over a whole scope, without emitting or checking.

    For every declaration it asks the emitter what *this* export states
    (`--digest`, which stops before the walk) and looks that sha256 up in the
    ledger's statement index. A hit is what a re-export would use to carry a
    verdict over instead of re-proving it; a miss is either a statement the
    ledger has not proved or one it proved as different bytes, and those are
    reported apart. Neither checker runs, so a declaration costs the export
    index and nothing else — measured 9.5 s / 487 MB, which is why the scope is
    walked by several at a time (`SCAN_AUDIT_JOBS`, default 4).
    """
    from concurrent.futures import ThreadPoolExecutor
    jobs = max(1, int(os.environ.get("SCAN_AUDIT_JOBS", "4")))
    index: dict[str, list[dict[str, str]]] = collections.defaultdict(list)
    own: dict[str, list[dict[str, str]]] = collections.defaultdict(list)
    for r in ledger.values():
        if r["theory"] != theory_sha:
            continue
        own[r["declaration"]].append(r)
        if r["statement_sha256"]:
            index[r["statement_sha256"]].append(r)

    def one(item):
        nm, _kind = item
        return digest_of(nm, export_path, work / slug(nm))

    verdicts: collections.Counter = collections.Counter()
    rows = ["declaration\tdigest\tverdict\tmatch"]
    print(f"audit  : {len(scope)} declarations, {jobs} at a time, "
          f"{len(index)} statement key(s) in the ledger", flush=True)
    with ThreadPoolExecutor(jobs) as pool:
        for (nm, kind), dg in zip(scope, pool.map(one, scope)):
            short = nm[len(prefix):] if nm.startswith(prefix) else nm
            hit = dg and [r for r in index[dg] if r["kind"] == kind]
            if dg is None:
                verdict, match = "digest unavailable", ""
            elif hit:
                m = hit[0]
                verdict = "same statement"
                match = f"{m['declaration']} of export {m['export'][:12]}"
                verdicts["own row" if m["declaration"] == nm
                        else "another declaration"] += 1
                print(f"  audit ✓ {short} [{kind}] same statement as {match}",
                      flush=True)
            elif any(r["statement_sha256"] for r in own.get(nm, ())):
                verdict, match = "statement differs", ""
            else:
                verdict, match = "no ledger row", ""
            verdicts[verdict] += 1
            rows.append(f"{nm}\t{dg or ''}\t{verdict}\t{match}")
    tsv = work / "statements.tsv"
    tsv.write_text("\n".join(rows) + "\n")
    total = len(scope)
    same = verdicts["same statement"]
    print()
    print(f"audited           : {total}")
    print(f"same statement    : {same}/{total} "
          f"({verdicts['own row']} under the declaration's own name, "
          f"{verdicts['another declaration']} under another)")
    print(f"statement differs : {verdicts['statement differs']}")
    print(f"no ledger row     : {verdicts['no ledger row']}")
    print(f"digest unavailable: {verdicts['digest unavailable']}")
    print(f"per-declaration   : {tsv}")
    return same


def cap_mem(gb: int):
    """A `preexec_fn` bounding a child's address space."""
    def apply() -> None:
        import resource
        lim = gb * 1024 ** 3
        resource.setrlimit(resource.RLIMIT_AS, (lim, lim))
    return apply


def run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    env = dict(os.environ)
    env["PATH"] = str(Path.home() / ".local" / "bin") + os.pathsep + env.get("PATH", "")
    if "stdout" in kw or "stderr" in kw:
        # The caller spills the child's output to files; `capture_output` and an
        # explicit stream are mutually exclusive in `subprocess.run`.
        return subprocess.run(cmd, text=True, env=env, **kw)
    return subprocess.run(cmd, capture_output=True, text=True, env=env, **kw)


def main() -> int:
    argv = [a for a in sys.argv[1:] if not a.startswith("--")]
    defer = "--defer-subst" in sys.argv
    # A module's declarations often live in a shared namespace (a `namespace`
    # block), so the prefix is the namespace, not the file stem; `--limit` keeps
    # a namespace-wide scan to a bounded proof of concept.
    limit = 0
    # The ledger of proved statements survives the work directory on purpose:
    # the work directory is what a scan rebuilds, and re-verifying what was
    # already verified is the cost the ledger exists to remove.
    keep_proofs = "--keep-proofs" in sys.argv
    # `--only=FILE`: restrict the scope to names listed one per line. A chapter
    # export carries its whole dependency closure, in which the chapter's own
    # declarations are a few dozen out of tens of thousands, so a sample drawn
    # from the export at large is a sample of Mathlib — the roots file that
    # records what the chapter itself states is the only way to aim at it.
    only: set[str] | None = None
    memo_arg: str | None = None
    adopt_arg: str | None = None
    for a in sys.argv[1:]:
        if a.startswith("--memo="):
            memo_arg = a.split("=", 1)[1]
        elif a.startswith("--limit="):
            limit = int(a.split("=", 1)[1])
        elif a.startswith("--only="):
            only = {l.strip() for l in
                    Path(a.split("=", 1)[1]).read_text().splitlines() if l.strip()}
        elif a.startswith("--adopt="):
            adopt_arg = a.split("=", 1)[1]
    if "--rekey" in sys.argv:
        # A ledger repair, not a scan: it needs the ledger and nothing else, and
        # scans the export only if a row's statement is missing from disk.
        if memo_arg is None:
            raise SystemExit("--rekey needs --memo=DIR: it repairs a ledger")
        return ledger_rekey(Path(memo_arg))
    export_path, prefix, work = Path(argv[0]), argv[1], Path(argv[2])
    extra = ["--spine"] + (["--defer-subst"] if defer else [])
    ledger: dict[tuple[str, str], dict[str, str]] | None
    if memo_arg == "off" or "--no-memo" in sys.argv:
        ledger = None
        memo_root: Path | None = None
    else:
        memo_root = Path(memo_arg) if memo_arg else work.with_name(work.name + ".memo")
        ledger = None  # filled once the export has an identity


    # Lazy: the scan only needs the declaration table, and materialising every
    # expression of a 460 MB export cost 7 GB before the first declaration was
    # emitted — the memory the emitter was blamed for.
    ex = l2m.Export(export_path, lazy=True)
    # The verdict is about the statement *in this theory*, so the theory's own
    # bytes and the derivation mode are part of an entry's identity: editing
    # `docs/cic*.mm0` or asking for `--defer-subst` must not inherit a proof
    # that was checked against something else.
    prefix_text = theory_text()
    theory_sha = hashlib.sha256(prefix_text.encode()).hexdigest()
    mode_tag = "spine" + ("+defer" if defer else "")
    if memo_root is not None:
        ledger = ledger_read(memo_root)
        here = sum(1 for (s, t, m, _n) in ledger
                   if s == ex.sha256 and t == theory_sha and m == mode_tag)
        print(f"ledger : {memo_root} ({here} of its {len(ledger)} entries are "
              f"this export + theory + mode)")
    elif adopt_arg is not None:
        raise SystemExit("--adopt needs a ledger to seed: drop --no-memo")
    # `--adopt=DIR`: a completed scan's artifacts become ledger rows. Runs
    # before the scope is scanned, so the declarations just adopted are hits.
    if adopt_arg is not None and memo_root is not None and ledger is not None:
        print(f"adopt  : re-checking the artifacts under {adopt_arg}")
        adopt(Path(adopt_arg), memo_root, prefix_text, theory_sha, mode_tag,
              keep_proofs, ledger)
        ledger = ledger_read(memo_root)
    scope = [
        (nm, kind)
        for nm, (kind, rec, _i) in ex.decls.items()
        if "value" in rec and nm.startswith(prefix)
        and (only is None or nm in only)
    ]
    scope.sort()
    if limit and len(scope) > limit:
        if "--stride" in sys.argv:
            # A sample spread over the whole scope, not its first `limit` entries:
            # an export lists its *dependencies* first and alphabetically, so
            # `scope[:limit]` samples the same library definitions in every
            # chapter and says nothing about the chapter's own proofs.
            step = (len(scope) - 1) / (limit - 1) if limit > 1 else 0
            scope = [scope[round(i * step)] for i in range(limit)]
        else:
            scope = scope[:limit]
    print(f"export : {export_path.name}")
    print(f"scope  : {len(scope)} declarations under {prefix}")
    print(f"mode   : spine derivation{', substitution deferred' if defer else ''}")
    print()

    if work.exists():
        shutil.rmtree(work)
    work.mkdir(parents=True)

    # `--audit-statements`: answer the re-export question over the whole scope
    # and stop. It writes the digests it read to `<work>/statements.tsv` and
    # runs no checker, so it never appends to the ledger.
    if "--audit-statements" in sys.argv:
        if ledger is None:
            raise SystemExit("--audit-statements needs a ledger: drop --no-memo")
        audit_statements(scope, export_path, work, ledger, theory_sha, prefix)
        return 0

    closed: list[tuple[str, str, int, int]] = []
    failed: list[tuple[str, str]] = []
    remembered = 0
    by_statement = 0
    t0 = time.time()

    # The statement-digest index over this theory, and the declarations it could
    # answer for. `--digest` costs an export index per call, so it is only spent
    # on a declaration some ledger row already knows: a plain re-run of one
    # export never pays for it, a re-export pays for it once per declaration and
    # gets the verification for free when the statement is the same bytes.
    content = {r["statement_sha256"]: r for r in (ledger or {}).values()
               if r["theory"] == theory_sha and r["statement_sha256"]}
    known_names = {n for (_e, t, _m, n) in (ledger or {})
                   if t == theory_sha and n.startswith(prefix)}

    for nm, kind in scope:
        short = nm[len(prefix):] if nm.startswith(prefix) else nm
        # Already proved, for exactly this export: the statement is in the
        # ledger, and the derivation that got it there is gone. Nothing is
        # emitted and neither checker runs.
        row = ledger.get((ex.sha256, theory_sha, mode_tag, nm)) if ledger else None
        if row is not None and row["kind"] == kind:
            remembered += 1
            closed.append((short, kind, int(row["rules"]), int(row["assumptions"])))
            print(f"  memo  ✓ {short} [{kind}] rules={row['rules']} "
                  f"assumptions={row['assumptions']} "
                  f"(proved {row['verified_at']})")
            continue
        out = work / re.sub(r"[^A-Za-z0-9_]", "_", short).strip("_")
        # Not this export, but the same declaration name was proved somewhere:
        # ask the emitter what *this* export states and look that up. The
        # emitter prints the digest of exactly the band the ledger keys on.
        if content and nm in known_names:
            dg = digest_of(nm, export_path, out)
            crow = content.get(dg) if dg else None
            if crow is not None and crow["kind"] == kind:
                by_statement += 1
                remembered += 1
                closed.append((short, kind, int(crow["rules"]),
                               int(crow["assumptions"])))
                print(f"  memo  ✓ {short} [{kind}] rules={crow['rules']} "
                      f"assumptions={crow['assumptions']} "
                      f"(same statement as {crow['declaration']} of export "
                      f"{crow['export'][:12]})")
                continue
        # The emitter holds the whole derivation in memory, and on the largest
        # chapters that is tens of GB (`ChapterEsaClosureCore` reached 11.9 GB
        # on one declaration). Bound it like `mm0-rs` and say which bound was
        # hit, instead of letting it OOM the machine.
        try:
            r = run([str(EMITTER), str(export_path), nm, str(out)] + extra,
                    timeout=EMIT_TIMEOUT, preexec_fn=cap_mem(EMIT_MEM_GB))
        except subprocess.TimeoutExpired:
            failed.append((short, f"emit: over {EMIT_TIMEOUT} s"))
            print(f"  emit  ⏱ {short}: over {EMIT_TIMEOUT} s")
            continue
        if r.returncode != 0:
            if r.returncode == -6 or "MemoryError" in (r.stdout + r.stderr):
                failed.append((short, f"emit: over {EMIT_MEM_GB} GiB"))
                print(f"  emit  ✗ {short}: over {EMIT_MEM_GB} GiB")
            else:
                failed.append((short, last_meaningful(r.stdout + r.stderr)))
                print(f"  emit  ✗ {short}: {failed[-1][1][:110]}")
            continue
        # The artifact's path is what the emitter says it wrote, not a guess:
        # the stem is the declaration's last name component plus `_typing`.
        wrote = re.search(r"wrote\s*:\s*(\S+)\.mm0", r.stdout)
        if wrote is None:
            failed.append((short, "emitter succeeded without naming its artifact"))
            continue
        stem = Path(wrote.group(1))
        full0 = out / "full.mm0"
        full1 = out / "full.mm1"
        full0.write_text(prefix_text + stem.with_suffix(".mm0").read_text())
        full1.write_text(prefix_text + stem.with_suffix(".mm1").read_text())
        # `mm0-rs` is superlinear in proof size: a 10^5-rule term took >12
        # minutes and 13 GB without finishing. Bound it, and report the bound
        # as its own outcome rather than as a verdict on the derivation.
        try:
            c = run(["mm0-rs", "compile", str(full1), str(out / "full.mmb")],
                    timeout=MM0_RS_TIMEOUT, preexec_fn=cap_mem(MM0_RS_MEM_GB))
        except subprocess.TimeoutExpired:
            failed.append((short, f"mm0-rs: over {MM0_RS_TIMEOUT} s"))
            print(f"  mm0-rs ⏱ {short}: over {MM0_RS_TIMEOUT} s")
            continue
        if c.returncode == -6 or "memory allocation" in (c.stdout + c.stderr):
            failed.append((short, f"mm0-rs: over {MM0_RS_MEM_GB} GiB"))
            print(f"  mm0-rs ✗ {short}: over {MM0_RS_MEM_GB} GiB")
            continue
        if c.returncode != 0 or "sorry" in (c.stdout + c.stderr):
            failed.append((short, "mm0-rs: " + last_meaningful(c.stdout + c.stderr)))
            print(f"  mm0-rs ✗ {short}: {failed[-1][1][:110]}")
            continue
        # `mm0-c`'s output is spilled to files, not captured: on rejection it
        # prints the derivation it rejected, and that is tens of megabytes in
        # the ordinary case and gigabytes on the largest chapters. Holding it in
        # this process is what OOM-killed the namespace sweep twice, at 22 GB,
        # with nothing else running on the host.
        log0, log1 = out / "mm0-c.out", out / "mm0-c.err"
        try:
            try:
                with open(full0) as fh0, open(log0, "w") as fo, open(log1, "w") as fe:
                    k = run(["mm0-c", str(out / "full.mmb")], stdin=fh0,
                            stdout=fo, stderr=fe, timeout=MM0_C_TIMEOUT)
            finally:
                # The transcript is evidence only until the reason is read out
                # of it; the dump itself is not worth the disk (4.5 GB on the
                # one measured so far).
                reason = mm0_c_reason(log1, log0) if log1.exists() else "(no output)"
                log0.unlink(missing_ok=True)
                log1.unlink(missing_ok=True)
        except subprocess.TimeoutExpired:
            failed.append((short, f"mm0-c: over {MM0_C_TIMEOUT} s"))
            print(f"  mm0-c ⏱ {short}: over {MM0_C_TIMEOUT} s")
            continue
        if k.returncode != 0:
            failed.append((short, "mm0-c: " + reason))
            print(f"  mm0-c ✗ {short}: {failed[-1][1][:110]}")
            continue
        head = stem.with_suffix(".mm0").read_text()
        rules = int(re.search(r"Rules applied : (\d+)", head).group(1))
        axs = int(re.search(r"Assumptions   : (\d+)", head).group(1))
        closed.append((short, kind, rules, axs))
        discarded = ""
        if ledger is not None and memo_root is not None:
            # The statement and its verdict outlive the proof; the proof does
            # not. `--keep-proofs` is for reading a derivation afterwards, not
            # for the sweep.
            ledger_append(memo_root, full0.read_text(), ex.sha256, theory_sha,
                          mode_tag, nm, kind, rules, axs,
                          hashlib.sha256(full1.read_bytes()).hexdigest(),
                          full1.stat().st_size)
            if not keep_proofs:
                # Both copies of the derivation go: the emitter's own `.mm1`
                # and the assembled one, its binary, and the conversion
                # obligations that existed to build it. What stays is
                # `full.mm0`, the statement as `mm0-c` read it.
                discard_proofs(out)
                stem.with_suffix(".mm0").unlink(missing_ok=True)
                discarded = ", proof discarded"
        print(f"  pass  ✓ {short} [{kind}] rules={rules} assumptions={axs}{discarded}")

    print()
    print(f"verified closures : {len(closed)}/{len(scope)}")
    if remembered:
        print(f"memo hits         : {remembered} (not emitted, not re-checked:"
              f" {remembered - by_statement} for this export, {by_statement} "
              f"where only the statement was the same bytes)")
    if closed:
        tot_r = sum(c[2] for c in closed)
        tot_a = sum(c[3] for c in closed)
        print(f"rules applied     : {tot_r} · assumptions: {tot_a} "
              f"({tot_a / len(closed):.1f} per declaration)")
    if failed:
        hist = collections.Counter(classify(reason) for _n, reason in failed)
        print("failure classes   :")
        for label, n in hist.most_common():
            print(f"  {n:3d}  {label}")
        print("reasons (first of each class):")
        seen = set()
        for short, reason in failed:
            lab = classify(reason)
            if lab in seen:
                continue
            seen.add(lab)
            print(f"  [{lab}] {short}: {reason[:160]}")
    print(f"elapsed           : {time.time() - t0:.1f} s")
    return 0 if closed else 1


if __name__ == "__main__":
    sys.exit(main())

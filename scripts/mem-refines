#!/usr/bin/env bash
# mem-refines — are the JIT's `load`/`store` the model's `execute_LOAD`/
# `execute_STORE`?
#
# Short answer, measured here rather than argued in prose: **no**, for both, and
# the refutation is a shape mismatch, not a missing proof. (The projection that
# does survive is stated in `mm0/store_projection.mm0`.)
#
#   emitted (mm0/clif.mm0)          model (LeanRV64D.InstsEnd, pinned source)
#   load__i64__r_i64                 execute_LOAD  (imm)(rs1)(rd)(is_unsigned)
#     (address) -> value                            (width) : SailM Result
#     1 operand, 1 result              5 arguments, returns a value
#     no width, no fault channel        assert width <= xlen_bytes
#                                       vmem_read rs1 offset width (Load Data)
#                                       writes rd = extend_value ...
#                                       -> RETIRE_SUCCESS | .Err e
#
#   store__i64_i64__r_none           execute_STORE (imm)(rs2)(rs1)(width)
#     (address, value) -> ()                        : SailM Result
#     2 operands, 0 results            4 arguments, returns a value
#     raw linear pointer               reads the register file + translates
#                                      vmem_write ... (Store Data)
#                                      -> RETIRE_SUCCESS | .Err e
#
# A term of the first shape cannot *be* the second in either case: different
# number of arguments, and one side returns a value (possibly a fault) the other
# does not have. So "the JIT's memory op lowers to execute_LOAD/execute_STORE"
# is refuted as stated. What survives is the weaker, provable-later statement:
# for an aligned access to a valid linear address, the emitted instruction
# describes the same state change as the model's function after the register
# plumbing, the immediate addition and the (never-taken) fault branch are
# projected away — stated with citations in `mm0/store_projection.mm0`.
#
# This script is the check behind the first sentence, and it is deliberately
# narrow: it reads the *committed artifacts* (so it cannot drift from what the
# repo ships) and the *pinned model source* (so no signature is retyped here).
# Exit 0 when every pair is refuted, 1 when any pair's shapes agree (which would
# mean the JIT grew a width parameter and a fault channel — a change somebody
# should notice and re-argue), 2 when the evidence is unavailable.
#
# Usage:
#   scripts/mem-refines [--quiet]
#
# Env:
#   RISCV_MEMORY_SRC  root of the pinned sail-riscv-lean checkout
#                     (default: `nix eval --raw .#sail-riscv-lean.src`)
set -uo pipefail

AVM=$(cd "$(dirname "$0")/.." && pwd)
CLIF=$AVM/mm0/clif.mm0
MEM=$AVM/mm0/statements/rv64_memory.mm0
QUIET=0
[[ ${1:-} == --quiet ]] && QUIET=1

say() { ((QUIET)) || printf '%s\n' "$*"; }
err() { printf '\033[0;31m[FAIL]\033[0m %s\n' "$*" >&2; }

[[ -f $CLIF ]] || { err "missing $CLIF (run scripts/clif2mm0 --write)"; exit 2; }
[[ -f $MEM ]] || { err "missing $MEM (run scripts/rv64-model-mm0)"; exit 2; }

SRC=${RISCV_MEMORY_SRC:-}
if [[ -z $SRC ]]; then
    # `git+file:` addresses the flake without copying the worktree into the
    # store (AGENTS.md): a plain path here copies the multi-GB build trees
    # first, which is slow enough to look like a missing model — the gate then
    # reported `[gap] memory correspondence not measured` on a tree where the
    # script succeeds when run on its own (measured 2026-11-23).
    SRC=$(nix eval --raw "git+file://$AVM#sail-riscv-lean.src" 2>/dev/null || true)
fi
INSTS=${SRC:+$SRC/LeanRV64D/InstsEnd.lean}
if [[ -z $INSTS || ! -f $INSTS ]]; then
    err "pinned model source not available (set RISCV_MEMORY_SRC, or nix)"
    exit 2
fi

# `<emitted prefix> <model name> <artifact declaration>` triples, one per memory
# opcode the decoder accepts. Adding an opcode without adding it here is caught
# by the "# pairs" line below being what the gate expects.
PAIRS=(
    "load  execute_LOAD  decl_LeanRV64D_Functions_execute_LOAD"
    "store execute_STORE decl_LeanRV64D_Functions_execute_STORE"
)

AGREED=""
REFUTED=""
for pair in "${PAIRS[@]}"; do
    read -r kw model decl <<< "$pair"

    # ── emitted side: the CLIF forms, from the measured model ──────────────
    # `term load__i64__r_i64 (a: val): op;   -- 113 use(s), 1 operand(s), 1 result(s)`
    mapfile -t EMITTED < <(grep -E "^term ${kw}__" "$CLIF")
    if [[ ${#EMITTED[@]} -eq 0 ]]; then
        err "no $kw form in $CLIF — the CLIF model is stale"
        exit 2
    fi

    # ── model side: the declaration must be in the artifact … ──────────────
    grep -q "^axiom $decl:" "$MEM" || {
        err "rv64_memory.mm0 has no $model declaration"
        exit 2
    }

    # … and its signature comes from the pinned source, not from this script.
    SIG_LINE=$(grep -n "^def $model " "$INSTS" | head -1)
    [[ -n $SIG_LINE ]] || { err "no $model in $INSTS"; exit 2; }
    LINENO_MODEL=${SIG_LINE%%:*}
    SIG=${SIG_LINE#*:}
    # Argument binders are `(name : type)`; names include digits (`rs1`, `rs2`),
    # so the class must too — with `[a-z_]*` the count was 2 and the verdict read
    # "2 vs 2", i.e. a parsing bug dressed as evidence.
    NARGS=$(printf '%s' "$SIG" | grep -o '([A-Za-z0-9_]* :' | wc -l)
    RET=$(printf '%s' "$SIG" | sed 's/.*) : //; s/ := do$//; s/ *$//')
    WIDTH_ASSERT=$(awk -v n="$LINENO_MODEL" 'NR > n && NR < n + 6 && /assert/ {print; exit}' "$INSTS")
    MEM_ACCESS=$(awk -v n="$LINENO_MODEL" 'NR > n && NR < n + 8 && /vmem_(read|write)/ {print; exit}' "$INSTS")

    # Operand/result counts are in the measured comment, not in the name.
    OPNDS=$(printf '%s\n' "${EMITTED[0]}" | sed -n 's/.*, \([0-9]\+\) operand(s).*/\1/p')
    RESULT=$(printf '%s\n' "${EMITTED[0]}" | sed -n 's/.*operand(s), \([0-9]\+\) result(s).*/\1/p')
    : "${OPNDS:=?}" "${RESULT:=?}"

    say "$kw:"
    for line in "${EMITTED[@]}"; do
        say "  emitted: ${line%%   --*}"
        say "           ${line##*-- }"
    done
    say "  model  : $model (InstsEnd.lean:$LINENO_MODEL)"
    say "           $NARGS argument(s) : $RET"
    [[ -n $WIDTH_ASSERT ]] && say "           ${WIDTH_ASSERT#"${WIDTH_ASSERT%%[![:space:]]*}"}"
    [[ -n $MEM_ACCESS ]] && say "           ${MEM_ACCESS#"${MEM_ACCESS%%[![:space:]]*}"}"
    say ""

    # Same shape ⇒ the strong claim would become arguable (not proved).
    MODEL_RETURNS=1  # SailM ExecutionResult — a value, possibly a fault
    if [[ $NARGS -eq $OPNDS && $MODEL_RETURNS -eq $RESULT ]]; then
        AGREED="$AGREED $kw"
    else
        REFUTED="$REFUTED $kw"
    fi
done

say "verdict:"
if [[ -n $AGREED ]]; then
    err "shapes now agree for:$AGREED — re-argue the correspondence instead of asserting it"
    exit 1
fi
say "  REFUTED as stated:$REFUTED"
((QUIET)) || cat <<'EOF'
  One side takes (address[, value]) and returns nothing (store) or a value
  (load); the model takes the architectural operands (imm, rs1/rs2, rd, width,
  and `is_unsigned` for load) from the register file, translates the address,
  asserts width <= xlen_bytes and may return an E_* fault. A fault channel and
  a width parameter the emitted instruction does not carry are not encodings of
  the same operation, so "the JIT's memory op lowers to execute_LOAD/
  execute_STORE" is false as stated.

  What remains true and is stated (not proved) in mm0/store_projection.mm0 is
  the projection: with the register read, the immediate addition and the
  never-taken fault branch projected away, the model's 8-byte aligned access
  describes the same state change as the emitted load.i64/store.i64. Nothing in
  this repo proves that; this script only refutes the stronger claim, using the
  committed artifacts and the pinned source rather than a retyped signature.
EOF
exit 0

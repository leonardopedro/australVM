#!/usr/bin/env python3
"""liquid-split-mm0 — generate (and check) the split law's MM0 artifact.

`PLAN_liquid_types.md` L11d asks for one reviewed split law kept as a held-out
statement: extent conservation plus disjoint writes under the guarded split
precondition, bound to the elaborated model, function and numeric profile. The
Why3 half of that card checks the *implementation* obligations; this artifact is
the MM0 profile's half — the exact statement and its residual premises, as an
MM0 proof application that `mm0-c` re-checks from the specification.

WHAT IS STATED. A buffer `b` split at an index `k`, guarded by `ok_split b k`
(the numeric profile's `0 <= k <= len b`, named rather than restated), yields
`left b k` and `right b k`; the law says their extents sum to `len b`, that the
two halves are disjoint, that an index inside a half is an index inside the
buffer, and that a write into one half does not disturb a read from the other.

WHAT IS PROVED. Ten theorems, each an instance or a composition of the premises:

  split_extent_conserved             the guarded split conserves the extent
  split_halves_disjoint              the halves' writes cannot alias
  split_left_index_is_buffer_index   in-bounds in a half ⇒ in-bounds in `b`
  split_write_left_keeps_right       a write to the left is invisible on the right
  split_write_right_keeps_left       … and the mirror image
  split_write_visible_in_half        a write is visible where it wrote
  split_one_write_per_half           the two halves' writes commute: a program
                                     may use one half without disturbing the other
  split_parts_are_nonnegative        an extent is not negative
  split_left_fits_the_whole          the left extent is within the sum
  split_conservation_pins_the_bound  … and within `len b` by conservation

WHAT IS ASSUMED. MM0 has no arithmetic, so `Idx` and `plus`/`le`/`ieq` are
uninterpreted and the split's own laws (`split_conserves`, `split_disjoint`,
`split_parts_in`) are axioms: they are the residual premises the guarded split
precondition supplies. What the theorems add is the *composition* — that those
premises are enough for a program to read one half after writing the other,
which is the shape the implementation obligations have to instantiate.

WHAT IS NOT PROVED. That the Austral split function conserves extents, that the
elaborated model's `k` really satisfies `ok_split`, or that the residual
premises hold of any concrete buffer. Those are L11d's Why3 obligations and the
statement comparator's job, and this file does not stand in for either: the
axioms are quoted here so a reviewer can disagree with the premises themselves.

This pilot needed no change to the existing W3 counts (`PLAN_liquid_types.md`
L11d): it adds a row of its own, `mm0/liquid_split.mm0` in §W3, and leaves the
other artifacts' statement counts alone.

Usage:
    scripts/liquid-split-mm0            # check the committed pair is current
    scripts/liquid-split-mm0 check      # same (the name mm0-comparator EMITTERS uses)
    scripts/liquid-split-mm0 --write    # rewrite mm0/liquid_split.{mm0,mm1}
Exit: 0 current/proved, 1 stale or malformed, 2 cannot run.
"""

import pathlib
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
MM0 = ROOT / "mm0" / "liquid_split.mm0"
MM1 = ROOT / "mm0" / "liquid_split.mm1"

# Every theorem's proof term, by name. A theorem in the specification that has no
# entry here is an error, never a silent `sorry`: the pair must not claim what it
# has not proved. The proofs are short because the law is stated so that each
# goal is one premise, or two premises composed by `veq_trans`.
PROOFS = {
    "split_extent_conserved": "split_conserves (h)",
    "split_halves_disjoint": "split_disjoint (h)",
    "split_left_index_is_buffer_index": "split_parts_in (h) (j)",
    "split_write_left_keeps_right": "rd_wr_disjoint (split_disjoint (h))",
    "split_write_right_keeps_left":
        "rd_wr_disjoint (disj_sym (split_disjoint (h)))",
    "split_write_visible_in_half": "rd_wr_same",
    "split_one_write_per_half":
        "veq_trans (rd_wr_disjoint (split_disjoint (h))) (rd_wr_same)",
    "split_parts_are_nonnegative": "le_zero",
    "split_left_fits_the_whole": "le_plus_left",
    "split_conservation_pins_the_bound": "le_sum_bound (split_conserves (h))",
}

# The axiom set, by name. Listed here so `check` can say which premise a missing
# axiom would have removed, and so the count is a fact rather than a grep.
AXIOMS = [
    "veq_trans", "le_zero", "le_plus_left", "le_sum_bound",
    "split_conserves", "split_disjoint", "split_parts_in", "disj_sym",
    "rd_wr_same", "rd_wr_disjoint",
]

SPEC = r"""-- liquid_split.mm0 — the split law L11d stages, stated for the MM0 profile.
--
-- GENERATED by `scripts/liquid-split-mm0 --write`; edit the script, not this
-- file. The proof file `liquid_split.mm1` is derived from this text, so the
-- statements and the proofs cannot drift apart.
--
-- WHAT IS STATED. A buffer `b` split at an index `k`, guarded by `ok_split b k`
-- — the numeric profile's `0 <= k <= len b`, named rather than restated here —
-- yields `left b k` and `right b k`. The law says that the two extents sum to
-- `len b`, that the halves are disjoint, that an index inside a half is an index
-- inside `b`, and that a write into one half does not disturb a read from the
-- other. The last of those is the one a split buffer program actually relies on.
--
-- WHAT IS PROVED (10 theorems, 0 sorry):
--
--   split_extent_conserved             the guarded split conserves the extent
--   split_halves_disjoint              the halves' writes cannot alias
--   split_left_index_is_buffer_index   in-bounds in a half ⇒ in-bounds in `b`
--   split_write_left_keeps_right       a write to the left is invisible on the right
--   split_write_right_keeps_left       … and the mirror image
--   split_write_visible_in_half        a write is visible where it wrote
--   split_one_write_per_half           the halves' writes commute (two writes,
--                                      one read, no interference)
--   split_parts_are_nonnegative        an extent is not negative
--   split_left_fits_the_whole          the left extent is within the sum
--   split_conservation_pins_the_bound  … and within `len b` by conservation
--
-- WHAT IS ASSUMED, AND WHY. MM0 has no arithmetic: `Idx` is an uninterpreted
-- sort, `plus`, `le` and `ieq` are uninterpreted terms, and the split's own laws
-- are axioms. Those three — conservation, disjointness, and an in-half index
-- being a buffer index — are exactly the residual premises the guarded split
-- precondition supplies, so what the theorems add is the *composition*: that
-- those premises suffice for a program to write one half and read the other.
-- A reviewer who disagrees with a premise can point at the one axiom and not at
-- a derivation.
--
-- WHAT IS *NOT* PROVED. That the Austral split function conserves extents, that
-- the elaborated model's index satisfies `ok_split`, or that the residual
-- premises hold of any concrete buffer. Those are L11d's Why3 obligations and
-- the statement comparator's subject; this artifact is the exact statement
-- those obligations instantiate, and it is a statement of record, not a
-- certificate about the implementation.
--
-- `veq_trans` is the only bridge between value equalities, so a composition
-- proof reads as a chain of reads; the two numeric laws (`le_zero`,
-- `le_plus_left`) and their bound (`le_sum_bound`) are what let the extent
-- figures be compared at all without an arithmetic theory.

-- theory: self-declared vocabulary — the sorts and terms below are this
-- artifact's whole theory; it imports no rule from `cic.mm0` or `isa.mm0`, so
-- there is no `used=` coverage list to state. What the split law rests on is
-- the axioms in the next section, each named as a residual premise.

provable sort Prop;
delimiter $ ( ) $;

-- ── The profile's vocabulary ─────────────────────────────────────────────
-- `Idx` is the numeric profile's extent/index domain (the Int64 lengths of the
-- Austral side), `Buf` a buffer, `St` a machine state, `Val` a stored value.
-- None is given a structure: the law below is about extents and interference,
-- not about how a buffer or a state is laid out.
sort Idx;
sort Buf;
sort St;
sort Val;

term zero: Idx;
term plus (x y: Idx): Idx;
term len (b: Buf): Idx;
-- The split, and its guard. `take`/`drop` are the two halves; `ok_split` is the
-- precondition the law is guarded by, named so that the theorem statements carry
-- it as a hypothesis instead of restating a numeric comparison in each one.
term take (b: Buf) (k: Idx): Buf;
term drop (b: Buf) (k: Idx): Buf;
term ok_split (b: Buf) (k: Idx): Prop;
term disjoint (b c: Buf): Prop;
term inb (b: Buf) (i: Idx): Prop;
-- Writing a value into a buffer at an index (`wr`), and reading one back (`rd`).
term wr (s: St) (b: Buf) (i: Idx) (v: Val): St;
term rd (s: St) (b: Buf) (i: Idx): Val;
-- Extent equality and order, and value equality. Uninterpreted: the three
-- numeric axioms below are the whole arithmetic this artifact uses.
term ieq (x y: Idx): Prop;
term veq (x y: Val): Prop;
term le (x y: Idx): Prop;

-- The two halves of a split are named here because every theorem below is
-- stated in those names: a reader should be able to see "left" and "right" in
-- the goal without translating back to `take`/`drop` first.
def left (b: Buf) (k: Idx): Buf = $ take b k $;
def right (b: Buf) (k: Idx): Buf = $ drop b k $;

-- ── The residual premises ────────────────────────────────────────────────
-- Value equality composes; the split's conservation and disjointness are
-- assumed *of the guarded split*, which is what makes them premises rather than
-- theorems. Everything the law claims about interference is derived from these.
axiom veq_trans (x y z: Val) (h1: $ veq x y $) (h2: $ veq y z $): $ veq x z $;
-- The numeric profile: an extent is non-negative, and a sum is at least its
-- left part. `le_sum_bound` turns a conserved sum into a bound on the whole —
-- the step that makes `split_conservation_pins_the_bound` a theorem about `b`
-- rather than about `plus`.
axiom le_zero (x: Idx): $ le zero x $;
axiom le_plus_left (x y: Idx): $ le x (plus x y) $;
axiom le_sum_bound (x y z: Idx) (h: $ ieq (plus x y) z $): $ le x z $;
-- Extent conservation: the guarded split's two extents add up to the buffer's.
axiom split_conserves (b: Buf) (k: Idx) (h: $ ok_split b k $):
  $ ieq (plus (len (take b k)) (len (drop b k))) (len b) $;
-- Disjointness: the halves' writes cannot alias, which is the premise every
-- interference theorem below consumes.
axiom split_disjoint (b: Buf) (k: Idx) (h: $ ok_split b k $):
  $ disjoint (take b k) (drop b k) $;
-- An index inside a half is an index inside the buffer the half came from.
axiom split_parts_in (b: Buf) (k: Idx) (i: Idx) (h: $ ok_split b k $)
  (j: $ inb (take b k) i $): $ inb b i $;
axiom disj_sym (b c: Buf) (h: $ disjoint b c $): $ disjoint c b $;
-- The two write/read laws the composition rests on: a write is visible where it
-- wrote, and a write into a buffer disjoint from the one being read is not
-- visible at all.
axiom rd_wr_same (s: St) (b: Buf) (i: Idx) (v: Val):
  $ veq (rd (wr s b i v) b i) v $;
axiom rd_wr_disjoint (s: St) (b c: Buf) (i j: Idx) (v: Val)
  (h: $ disjoint b c $):
  $ veq (rd (wr s b i v) c j) (rd s c j) $;

-- ── The law ──────────────────────────────────────────────────────────────
-- Conservation, restated over `left`/`right`: the definitions unfold, so this is
-- the statement a reader of the split law looks for.
theorem split_extent_conserved (b: Buf) (k: Idx) (h: $ ok_split b k $):
  $ ieq (plus (len (left b k)) (len (right b k))) (len b) $;
-- Disjointness under the same guard, in the same names.
theorem split_halves_disjoint (b: Buf) (k: Idx) (h: $ ok_split b k $):
  $ disjoint (left b k) (right b k) $;
theorem split_left_index_is_buffer_index (b: Buf) (k: Idx) (i: Idx)
  (h: $ ok_split b k $) (j: $ inb (left b k) i $): $ inb b i $;
-- Interference: writing into the left half leaves a read of the right half
-- exactly as it was. This is the property that makes a split usable — the two
-- halves may be handed to different code without synchronisation — and its
-- mirror image below.
theorem split_write_left_keeps_right (s: St) (b: Buf) (k: Idx) (i j: Idx) (v: Val)
  (h: $ ok_split b k $):
  $ veq (rd (wr s (left b k) i v) (right b k) j) (rd s (right b k) j) $;
theorem split_write_right_keeps_left (s: St) (b: Buf) (k: Idx) (i j: Idx) (v: Val)
  (h: $ ok_split b k $):
  $ veq (rd (wr s (right b k) i v) (left b k) j) (rd s (left b k) j) $;
-- Visibility inside a half, with no guard: a write is visible where it wrote.
theorem split_write_visible_in_half (s: St) (b: Buf) (k: Idx) (i: Idx) (v: Val):
  $ veq (rd (wr s (left b k) i v) (left b k) i) v $;
-- The composition: write the right half, write the left half, then read the
-- right half back — the value the first write left is still there. Neither write
-- saw the other, which is the whole reason the split exists.
theorem split_one_write_per_half (s: St) (b: Buf) (k: Idx) (i j: Idx)
  (va vb: Val) (h: $ ok_split b k $):
  $ veq (rd (wr (wr s (right b k) j vb) (left b k) i va) (right b k) j) vb $;
-- The numeric-profile side of the same law: both extents are non-negative, the
-- left one is within the sum, and conservation turns that into a bound by the
-- buffer's own extent.
theorem split_parts_are_nonnegative (b: Buf) (k: Idx):
  $ le zero (len (left b k)) $;
theorem split_left_fits_the_whole (b: Buf) (k: Idx):
  $ le (len (left b k)) (plus (len (left b k)) (len (right b k))) $;
theorem split_conservation_pins_the_bound (b: Buf) (k: Idx) (h: $ ok_split b k $):
  $ le (len (left b k)) (len b) $;
"""


def mm1_text(mm0_text: str) -> str:
    """The proof file: the same declarations, each theorem carrying its proof.

    Statements can span lines, so this scans per theorem rather than per line.
    A theorem with no entry in PROOFS is fatal — emitting it without one would
    make `mm0-rs` print a `sorry` warning and `mm0-c` refuse the file, which is
    the correct outcome, but the reason would be this script's silence.
    """
    header = (
        "-- liquid_split.mm1 — the proof file for mm0/liquid_split.mm0.\n"
        "--\n"
        "-- GENERATED by `scripts/liquid-split-mm0 --write`; edit the script, not\n"
        "-- this file. `mm0-c` checks these proofs against the specification on\n"
        "-- every run that compiles them, so the statement and its proof cannot\n"
        "-- disagree. Proof arguments are hypotheses and term arguments are\n"
        "-- inferred in proof position, which is why the proofs are one premise or\n"
        f"-- two composed by `veq_trans`: {len(PROOFS)} theorem(s), no `sorry`.\n"
        "--\n"
        "-- Keep this file's declarations in the same order as the `.mm0`: mm0-c\n"
        "-- matches them in order, and a swap surfaces as an unrelated unify\n"
        "-- failure elsewhere.\n\n"
    )
    lines = mm0_text.splitlines()
    out, n, i = [], 0, 0
    while i < len(lines):
        m = re.match(r"^theorem\s+([A-Za-z0-9_]+)\b", lines[i])
        if not m:
            out.append(lines[i])
            i += 1
            continue
        name = m.group(1)
        chunk = [lines[i]]
        while not chunk[-1].rstrip().endswith(";"):
            i += 1
            if i >= len(lines):
                raise SystemExit(f"liquid-split-mm0: theorem {name} never ends with `;`")
            chunk.append(lines[i])
        stmt = "\n".join(chunk).rstrip()[:-1]  # drop the terminating `;`
        if name not in PROOFS:
            raise SystemExit(
                f"liquid-split-mm0: theorem {name} has no proof term — add one to "
                "PROOFS rather than emitting an unproved theorem"
            )
        out.append(re.sub(r"^theorem\b", "pub theorem", stmt)
                   + f" = '({PROOFS[name]});")
        n += 1
        i += 1
    if n != len(PROOFS):
        raise SystemExit(
            f"liquid-split-mm0: {n} theorem(s) in the specification, "
            f"{len(PROOFS)} proof term(s) — one of them is orphaned"
        )
    return header + "\n".join(out) + "\n"


def toolchain(mm0_text: str, mm1_text_: str) -> str:
    """Compile the pair and re-check it with `mm0-c`, when the tools are here.

    `mm0-rs` warnings are refusals: a `sorry` is a theorem that is not proved,
    which is exactly what this artifact must not contain. Absent tooling is
    reported, not treated as a pass — the caller prints this line either way.
    """
    for tool in ("mm0-rs", "mm0-c"):
        if shutil.which(tool) is None:
            return f"[gap] {tool} not on PATH — the pair was not compiled here"
    with tempfile.TemporaryDirectory() as td:
        tmp = pathlib.Path(td)
        (tmp / "liquid_split.mm1").write_text(mm1_text_)
        (tmp / "liquid_split.mm0").write_text(mm0_text)
        v = subprocess.run(["mm0-rs", "compile", str(tmp / "liquid_split.mm1"),
                            str(tmp / "liquid_split.mmb")],
                           capture_output=True, text=True)
        if v.returncode != 0 or "warning:" in (v.stderr + v.stdout):
            return ("[FAIL] mm0-rs compile refused the pair:\n"
                    + (v.stderr + v.stdout).strip()[:500])
        with open(tmp / "liquid_split.mm0") as spec:
            c = subprocess.run(["mm0-c", str(tmp / "liquid_split.mmb")],
                               stdin=spec, capture_output=True, text=True)
        if c.returncode != 0:
            return ("[FAIL] mm0-c refused the pair:\n"
                    + (c.stderr + c.stdout).strip()[:500])
    return "[ok] mm0-rs compiled and mm0-c accepted the pair"


def main(argv):
    write = "--write" in argv[1:]
    want_mm0, want_mm1 = SPEC, mm1_text(SPEC)
    problems = []

    # Structural invariants first: they are what make the file a *statement of
    # record* rather than a re-run of the same text. A theorem that turned into
    # an axiom would report a law as an assumption, so it is refused by name.
    for name in PROOFS:
        if not re.search(rf"^theorem\s+{name}\b", want_mm0, re.MULTILINE):
            problems.append(f"theorem {name} is missing from the specification")
        if re.search(rf"^axiom\s+{name}\b", want_mm0, re.MULTILINE):
            problems.append(f"{name} is an axiom again — it was proved")
    for name in AXIOMS:
        if not re.search(rf"^axiom\s+{name}\b", want_mm0, re.MULTILINE):
            problems.append(f"axiom {name} is missing (a premise was dropped)")
    if "ok_split" not in re.search(
            r"^axiom split_conserves[^\n]*", want_mm0, re.MULTILINE).group(0):
        problems.append("split_conserves is no longer guarded by ok_split")
    got_axioms = re.findall(r"^axiom\s+([A-Za-z0-9_]+)\b", want_mm0, re.MULTILINE)
    if got_axioms != AXIOMS:
        problems.append(f"axiom set is {got_axioms}, expected {AXIOMS}")

    if problems:
        for p in problems:
            print(f"liquid-split-mm0: FAIL {p}", file=sys.stderr)
        return 1

    if write:
        MM0.write_text(want_mm0)
        MM1.write_text(want_mm1)
        print(f"liquid-split-mm0: wrote mm0/liquid_split.{{mm0,mm1}} — "
              f"{len(AXIOMS)} axiom(s), {len(PROOFS)} proved theorem(s)")
        print(toolchain(want_mm0, want_mm1))
        return 0

    for path, want in ((MM0, want_mm0), (MM1, want_mm1)):
        if not path.is_file():
            print(f"liquid-split-mm0: FAIL {path.name} is missing — run "
                  "scripts/liquid-split-mm0 --write", file=sys.stderr)
            return 1
        if path.read_text() != want:
            print(f"liquid-split-mm0: FAIL {path.name} is stale — run "
                  "scripts/liquid-split-mm0 --write", file=sys.stderr)
            return 1

    verdict = toolchain(want_mm0, want_mm1)
    print(verdict)
    if verdict.startswith("[FAIL]"):
        return 1
    print(f"liquid-split-mm0: current — {len(AXIOMS)} residual premise(s), "
          f"{len(PROOFS)} proved theorem(s)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

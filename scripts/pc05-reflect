#!/usr/bin/env python3
"""PC05a checks: the committed parsed-WGSL reflection of the real clamp.

`mm0/proof_chain/clamp_wgsl.mm0` is generated by `avm-gpu reflect-wgsl` from the
bundle `austral compile --target-type=wgsl --entrypoint=Pointwise:clamp`
publishes for `examples/gpu/pointwise`, i.e. from the *parsed* Naga module the
runtime validates — not from a retyped model of the sample.

This script re-derives that, without needing dune for the reflection itself:

  * compiles the fixture to a fresh bundle and emits the artifact into a
    temporary directory, requiring it to be byte-identical to the committed
    copies (a generator change that is not re-recorded fails here);
  * runs `avm-gpu check-reflect` against the committed artifact, which
    re-parses the shader and compares the recorded reflection lines and
    `wgsl_clamp` definition — the digests are not what decides;
  * mutates the *parsed shader* three ways (reversed comparator, changed
    literal, changed storage role), recomputes `wgsl_sha256` in the bundle so
    it still loads, and requires a refusal for each: a digest that matches the
    text it was computed from cannot make a wrong correspondence pass;
  * assembles `word.mm0` + `clamp_source.mm0` + `clamp_wgsl.mm0` with its
    proofs and replays them under `mm0-rs`/`mm0-c`, then requires `mm0-rs` to
    refuse a `umeet`→`ujoin` copy of the proof. Missing MM0 tooling is a `gap`
    (exit 3), never a pass.

Usage:
  scripts/pc05-reflect [--compiler PATH] [--checker PATH]
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
FIXTURE = ROOT / "examples/gpu/pointwise"
ENTRY = "Pointwise:clamp"
COMMITTED = ROOT / "mm0/proof_chain/clamp_wgsl.mm0"
COMMITTED_PROOF = ROOT / "mm0/proof_chain/clamp_wgsl.mm1"
WORD_MM0 = ROOT / "mm0/proof_chain/word.mm0"
WORD_MM1 = ROOT / "mm0/proof_chain/word.mm1"
SOURCE_MM0 = ROOT / "mm0/proof_chain/clamp_source.mm0"
SOURCE_MM1 = ROOT / "mm0/proof_chain/clamp_source.mm1"
DEFAULT_COMPILER = ROOT / "_build/default/bin/austral.exe"
DEFAULT_CHECKER = ROOT / "safestos/gpu/target/debug/avm-gpu"


def fail(name: str, detail: str = "") -> None:
    print(f"[FAIL] {name}{': ' + detail if detail else ''}")


def run(cmd: list[str], stdin=None, env=None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, stdin=stdin, capture_output=True, text=True, env=env)


def env_with_bridge(checker: Path) -> dict:
    env = os.environ.copy()
    bridge = ROOT / "safestos/cranelift/target/release"
    env["LD_LIBRARY_PATH"] = f"{ROOT}:{bridge}:" + env.get("LD_LIBRARY_PATH", "")
    env["AUSTRAL_GPU_CHECKER"] = str(checker)
    return env


def compile_bundle(compiler: Path, checker: Path, out: Path) -> tuple[bool, str]:
    env = env_with_bridge(checker)
    proc = run(
        [
            str(compiler),
            "compile",
            f"{FIXTURE / 'Pointwise.aui'},{FIXTURE / 'Pointwise.aum'}",
            "--target-type=wgsl",
            f"--entrypoint={ENTRY}",
            f"--output={out}",
        ],
        env=env,
    )
    if proc.returncode != 0:
        return False, (proc.stderr or proc.stdout).strip()
    return True, ""


def mutate(bundle: Path, name: str, edits: list[tuple[str, str]]) -> tuple[bool, str]:
    """Apply text edits to kernel.wgsl and recompute the bundle's digest.

    The digest is recomputed *before* the check, so a refusal has to come from
    the reflection (or the wrapper audit), never from a stale hash.
    """
    wgsl_path = bundle / "kernel.wgsl"
    manifest_path = bundle / "kernel.json"
    original = wgsl_path.read_text()
    text = original
    for old, new in edits:
        if old not in text:
            return False, f"mutation {name!r} did not apply ({old!r} not found)"
        text = text.replace(old, new, 1)
    if text == original:
        return False, f"mutation {name!r} changed nothing"
    wgsl_path.write_text(text)
    manifest = json.loads(manifest_path.read_text())
    manifest["wgsl_sha256"] = hashlib.sha256(text.encode()).hexdigest()
    manifest_path.write_text(json.dumps(manifest, indent=2) + "\n")
    return True, text


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--compiler", default=str(DEFAULT_COMPILER))
    parser.add_argument("--checker", default=str(DEFAULT_CHECKER))
    args = parser.parse_args()
    compiler = Path(args.compiler)
    checker = Path(args.checker)
    if not compiler.exists():
        print(f"[gap] PC05a: no compiler at {compiler} (dune build bin/)")
        return 3
    if not checker.exists():
        print(f"[gap] PC05a: no checker at {checker} (cargo build --bin avm-gpu)")
        return 3

    failures = 0
    with tempfile.TemporaryDirectory(prefix="pc05-") as tmp:
        tmp_path = Path(tmp)
        bundle = tmp_path / "clamp.avkg"
        ok, detail = compile_bundle(compiler, checker, bundle)
        if not ok:
            fail("PC05a: the fixture compiles to a WGSL bundle", detail)
            return 1

        # 1. The committed artifact is what this bundle emits now.
        emitted = tmp_path / "emitted"
        proc = run([str(checker), "reflect-wgsl", str(bundle), "--out", str(emitted)])
        if proc.returncode != 0:
            fail("PC05a: the bundle's parsed shader reflects", (proc.stderr or proc.stdout).strip())
            return 1
        for emitted_path, committed in [
            (emitted / "clamp_wgsl.mm0", COMMITTED),
            (emitted / "clamp_wgsl.mm1", COMMITTED_PROOF),
        ]:
            if not committed.exists():
                fail(f"PC05a: {committed.relative_to(ROOT)} is committed")
                failures += 1
            elif emitted_path.read_text() != committed.read_text():
                fail(
                    f"PC05a: {committed.relative_to(ROOT)} is the current emission",
                    "regenerate with `avm-gpu reflect-wgsl <bundle> --out mm0/proof_chain`",
                )
                failures += 1
            else:
                print(f"  [detail] {committed.relative_to(ROOT)} re-emits byte-identically")

        # 2. Re-reflection of the committed artifact against the same bundle.
        proc = run([str(checker), "check-reflect", str(bundle), "--artifact", str(COMMITTED)])
        if proc.returncode != 0:
            fail("PC05a: the committed artifact records the fresh reflection",
                 (proc.stderr or proc.stdout).strip())
            failures += 1
        else:
            reflected = json.loads(proc.stdout).get("reflect", "")
            print(f"  [detail] re-reflected: {reflected}")

        # 3. Mutations of the parsed shader, each with its digest recomputed.
        controls = [
            ("reversed comparator", [("(p0 > 100u)", "(p0 < 100u)")]),
            ("changed literal", [("(p0 > 100u)", "(p0 > 101u)"), ("return 100u;", "return 101u;")]),
            ("changed storage role", [("var<storage, read> input0", "var<storage, read_write> input0")]),
        ]
        for name, edits in controls:
            mutated = tmp_path / f"mutated-{name.replace(' ', '-')}.avkg"
            shutil.copytree(bundle, mutated)
            applied, detail = mutate(mutated, name, edits)
            if not applied:
                fail(f"PC05a: control {name!r} applies", detail)
                failures += 1
                continue
            checked = run([str(checker), "check-reflect", str(mutated), "--artifact", str(COMMITTED)])
            emitted = run([str(checker), "reflect-wgsl", str(mutated), "--out", str(tmp_path / "m")])
            if checked.returncode == 0:
                fail(f"PC05a: {name} is refused against the committed artifact")
                failures += 1
            elif emitted.returncode == 0:
                fail(f"PC05a: {name} is refused by the reflection itself",
                     "the reflector accepted a shader it does not admit")
                failures += 1
            else:
                message = (checked.stderr or checked.stdout).strip().splitlines()
                first = message[0] if message else ""
                print(f"  [detail] {name} refused: {first[:140]}")

    # 4. MM0 replay of the assembled chain.
    if not (shutil.which("mm0-rs") and shutil.which("mm0-c")):
        print(
            "[gap] PC05a: clamp_wgsl.mm0 not replayed (no mm0-rs/mm0-c on PATH; "
            "`nix build .#mm0` and put its bin/ on PATH)"
        )
        return 3 if failures == 0 else 1
    with tempfile.TemporaryDirectory(prefix="pc05-mm0-") as tmp:
        tmp_path = Path(tmp)
        spec = tmp_path / "all.mm0"
        proof = tmp_path / "all.mm1"
        mmb = tmp_path / "all.mmb"
        spec.write_text(
            WORD_MM0.read_text() + SOURCE_MM0.read_text() + COMMITTED.read_text()
        )
        proof.write_text(
            WORD_MM1.read_text() + SOURCE_MM1.read_text() + COMMITTED_PROOF.read_text()
        )
        compiled = run(["mm0-rs", "compile", str(proof), str(mmb)])
        if compiled.returncode != 0:
            print(compiled.stderr or compiled.stdout, file=sys.stderr)
            fail("PC05a: clamp_wgsl.mm1 compiles against word+clamp_source")
            failures += 1
        else:
            checked = run(["mm0-c", str(mmb)], stdin=spec.open())
            if checked.returncode != 0:
                print(checked.stdout or checked.stderr, file=sys.stderr)
                fail("PC05a: the assembled specification accepts the reflected witness")
                failures += 1
            else:
                print("  [detail] word+clamp_source+clamp_wgsl assembled and accepted")
                bad = tmp_path / "bad.mm1"
                bad.write_text(
                    proof.read_text().replace("umeet x u100", "ujoin x u100", 1)
                )
                refused = run(["mm0-rs", "compile", str(bad), str(tmp_path / "bad.mmb")])
                if refused.returncode == 0:
                    fail("PC05a: a reversed reflected operator is refused")
                    failures += 1
                else:
                    print("  [detail] a reflected ujoin does not check the umeet proof")

    if failures:
        print(f"[FAIL] PC05a parsed-WGSL reflection of the real clamp ({failures} failure(s))")
        return 1
    print("[pass] PC05a parsed-WGSL reflection of the real clamp")
    return 0


if __name__ == "__main__":
    sys.exit(main())

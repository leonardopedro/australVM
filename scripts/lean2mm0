        "ndjson": FIXTURES / "quasi_rh_certificate.ndjson",
        "lean": WS / "timepiece" / "QuasiRiemannCertificate.lean",
        "decl": "riemannZeta_ne_zero_of_seven_eighths_lt_re",
    },
]

# The imported theory: untracked toolchain state like set.mm itself
# (provisioned by mm0-from-mm, docs/lean4mm0.md §11 — set.mmu is 548 MB and
# cannot be committed), and the import strings the two streams carry.
METAMATH = OUT_DIR / "metamath"

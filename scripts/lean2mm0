# ── the trust split, pinned ──────────────────────────────────────────────
#
# Per certificate: how many definitions are structurally checked by mm0-c
# (`teq_app` congruence over a net spine mm0-c re-checks) and how many the
# emitter evaluated (a grounded body's proof is the tautology `teq ttrue
# ttrue`). The counts are *budgets*, not statistics: generation fails when the
# grounded set widens or the certificate set changes without this table being
# edited in the same commit. A silent widening is the one failure mode that a
# proof-checking pipeline cannot see — the .mmb would still verify.
#
# Widening is allowed; claiming it is not is the bug. Edit this table.
BUDGETS: dict[str, dict[str, int]] = {
    "gap_certificate":    {"structural": 9, "grounded": 0, "certificates": 9},
    "layout_certificate": {"structural": 3, "grounded": 5, "certificates": 8},
    "quasi_rh_certificate": {"structural": 9, "grounded": 0, "certificates": 9},
    # A statement artifact has no Bool-rfl certificates: `statements` counts
    # the *asserted* axioms (truth = the proof of record in the header), and
    # structural/grounded stay 0 because there is no computed body to split.
    # Same pinned-contract rule: widening needs this line edited in the same
    # commit.
    "quasi_rh_7_8": {"structural": 0, "grounded": 0, "statements": 1},
}


def out_paths(stem: str) -> tuple[Path, Path]:
    return OUT_DIR / f"{stem}.mm0", OUT_DIR / f"{stem}.mm1"


def trust_split_line(stem: str, structural: int, grounded: int,
                     certificates: int) -> str:
    """The machine-readable trust split, read by scripts/verify-invariants."""
    return (f"-- trust-split: structural={structural} grounded={grounded} "
            f"certificates={certificates}")


# The agent signature of docs/cic.mm0, in declaration order. Which of these a
# generated file actually uses is *reported in the artifact* (§9.4): a reader
# must be able to tell a checked rule from a reserved one, and prose goes stale
# the moment the encoder changes.
SIGNATURE_TERMS = [
    "tvar", "tapp", "tabs", "tint", "tf64", "ttrue", "tfalse", "tcon",
    "tnil", "tcons", "tfold", "tdup", "tera", "tprim", "tentity",
    "tsubst", "teval",
]


def coverage_line(body: str) -> str:
    """Which signature terms the generated declarations mention.

    `body` must be the generated part only — the `.mm0` embeds `cic.mm0`
    verbatim for audit, so scanning the whole file would report every
    declaration as used.
    """
    used = [t for t in SIGNATURE_TERMS if re.search(rf"\b{t}\b", body)]
    unused = [t for t in SIGNATURE_TERMS if t not in used]
    return (f"-- theory coverage: used={','.join(used) or '-'} "
            f"unused={','.join(unused) or '-'}")

# prim_tag bytes from unfer/logos/src/deltanet/unf.rs (load-bearing: renaming
# a variant must not silently re-tag; this table mirrors that mapping).
PRIM_TAG = {
    "add": 0x00, "sub": 0x01, "mul": 0x02, "eq": 0x03,
    "gt": 0x04, "lt": 0x05, "and": 0x0D, "or": 0x0E, "not": 0x0F,
}
# tentity symbol table of the emitted file (the agent signature has no
# integer-division primitive; division is a symbol-level function).
ENTITY_SYM = {"idiv": 0}


class TranspileError(Exception):
    """Any loud failure: unknown construct, value disagreement, drift."""


# ── NDJSON loading (three namespaces: in=name, il=level, ie=expr) ────────

@dataclass(frozen=True)
class CtorInfo:
    """A constructor of an exported inductive (from an `inductive` block)."""
    induct: int           # name-table id of the inductive type
    cidx: int             # constructor index (minor-premise position)
    num_params: int
    num_fields: int
    type_eid: int         # the ctor's full type (forallE chain)


@dataclass(frozen=True)
class RecInfo:
    """A recursor of an exported inductive (`List.rec`, `Option.rec`, …)."""
    num_params: int
    num_motives: int
    num_minors: int
    num_indices: int
    ctor_names: tuple     # canon ctor names, positionally = cidx


class Export:
    def __init__(self, path: Path):
        self.names: dict[int, str] = {}
        self.levels: dict[int, dict] = {}
        self.exprs: dict[int, dict] = {}
        self.decls: dict[str, tuple[str, dict, int]] = {}
        self.ctors: dict[str, CtorInfo] = {}
        self.recs: dict[str, RecInfo] = {}
        self.inductive_names: set[str] = set()
        self._spine_cache: dict[int, tuple] = {}
        self._pending_inductives: list[dict] = []
        self.sha256 = hashlib.sha256(path.read_bytes()).hexdigest()
        for i, line in enumerate(path.read_text().splitlines()):
            if not line.strip():
                continue
            d = json.loads(line)
            if "in" in d:
                if "str" in d:
                    s = d["str"]
                    pre = s.get("pre", 0)
                    self.names[d["in"]] = (self.names.get(pre, "") if pre else "") + s["str"]
                else:
                    n = d["num"]
                    pre = n.get("pre", 0)
                    self.names[d["in"]] = (self.names.get(pre, "") if pre else "") + str(n["i"])
            if "il" in d:
                self.levels[d["il"]] = d
            if "ie" in d:
                self.exprs[d["ie"]] = d
            for k in ("axiom", "thm", "def", "inductive", "ctor", "opaque"):
                if k in d and isinstance(d[k], dict) and "name" in d[k]:
                    nm = self.names.get(d[k]["name"], f"?{d[k]['name']}")
                    self.decls[nm] = (k, d[k], i)
            if "inductive" in d:
                # name ids inside may not be in the table yet (the format
                # emits names lazily); register after the full parse.
                self._pending_inductives.append(d["inductive"])
        for ind in self._pending_inductives:
            self._register_inductive(ind)
        self._pending_inductives = []

    def _register_inductive(self, ind: dict) -> None:
        """Register constructors and recursors of one exported inductive.

        Constructor/recursor names resolve through the name table like every
        other declaration; the evaluator dispatches on them generically, so a
        source file's own inductives (OuterState here) work with no
        per-source code.
        """
        types = ind.get("types", [])
        if not types:
            return
        for t in types:
            # type names in value position are type arguments: never evaluated
            self.inductive_names.add(Export.canon(self.name(t["name"])))
        for c in ind.get("ctors", []):
            nm = Export.canon(self.name(c["name"]))
            self.ctors[nm] = CtorInfo(
                induct=types[0]["name"], cidx=c["cidx"],
                num_params=c["numParams"], num_fields=c["numFields"],
                type_eid=c["type"])
        # canon ctor names indexed by cidx — minor premises are positional.
        by_cidx = [None] * len(ind.get("ctors", []))
        for c in ind.get("ctors", []):
            by_cidx[c["cidx"]] = Export.canon(self.name(c["name"]))
        for r in ind.get("recs", []):
            nm = Export.canon(self.name(r["name"]))
            self.recs[nm] = RecInfo(
                num_params=r["numParams"], num_motives=r["numMotives"],
                num_minors=r["numMinors"], num_indices=r["numIndices"],
                ctor_names=tuple(by_cidx))

    def name(self, i: int) -> str:
        return self.names.get(i, f"?{i}")

    @staticmethod
    def canon(n: str) -> str:
        return n.replace(".", "")

    def spine(self, eid: int) -> tuple[int, list[int]]:
        """Decompose an application into (head_expr_id, [arg_expr_ids]).
        Cached: the export's exprs are immutable, and the evaluator walks
        the same spines millions of times (list-heavy certificates)."""
        hit = self._spine_cache.get(eid)
        if hit is not None:
            return hit[0], list(hit[1])
        args: list[int] = []
        cur = eid
        while True:
            e = self.exprs.get(cur)
            if e is None:
                raise TranspileError(f"dangling expr {cur}")
            if "app" in e:
                args.append(e["app"]["arg"])
                cur = e["app"]["fn"]
            else:
                args.reverse()   # outermost-first walk → application order
                self._spine_cache[eid] = (cur, tuple(args))
                return cur, args

    def pp(self, eid: int, depth: int = 0) -> str:
        if depth > 40:
            return "…"
        e = self.exprs.get(eid)
        if e is None:
            return f"?{eid}"
        if "bvar" in e:
            return f"#{e['bvar']}"
        if "const" in e:
            return self.name(e["const"]["name"])
        if "app" in e:
            head, args = self.spine(eid)
            return "(" + " ".join([self.pp(head, depth + 1)]
                                  + [self.pp(a, depth + 1) for a in args]) + ")"
        if "natVal" in e:
            return f"({e['natVal']})"
        if "lam" in e:
            return "(λ …)"
        if "forallE" in e:
            return "(∀ …)"
        if "letE" in e:
            return "(let …)"
        if "sort" in e:
            return "Sort"
        if "mdata" in e:
            return self.pp(e["mdata"]["expr"], depth + 1)
        return str(e)


# ── evaluator (values of the ground fragment) ────────────────────────────

class VI:
    __slots__ = ("n",)

    def __init__(self, n: int):
        self.n = n

    def __repr__(self):
        return f"{self.n}"


class VB:
    __slots__ = ("b",)

    def __init__(self, b: bool):
        self.b = b

    def __repr__(self):
        return f"{self.b}"


class VClos:
    __slots__ = ("body", "env")

    def __init__(self, body: int, env):
        self.body = body
        self.env = env

    def __repr__(self):
        return "<closure>"


class VCon:
    """An applied constructor of an exported inductive (List.nil/cons,
    OuterState.s*, Option.none/some, Prod.mk, …).

    Interned on (canon-name, field values): structurally equal values are the
    *same object*, so `veq` is identity, shared list suffixes are shared
    objects, and cache keys below are exact without a deep hash. Parameters
    (type arguments) are dropped — value equality never depends on them.
    """

    __slots__ = ("name", "fields", "interned")

    def __init__(self, name: str, fields: tuple):
        self.name = name
        self.fields = fields
        self.interned = False

    def __repr__(self):
        if not self.fields:
            return self.name
        return f"{self.name}({', '.join(map(repr, self.fields))})"


_VI_CACHE: dict[int, VI] = {}
_VB_CACHE: dict[bool, VB] = {}
_VCON_CACHE: dict[tuple, VCon] = {}


def vi(n: int) -> VI:
    v = _VI_CACHE.get(n)
    if v is None:
        v = _VI_CACHE[n] = VI(n)
    return v


def vb(b: bool) -> VB:
    v = _VB_CACHE.get(b)
    if v is None:
        v = _VB_CACHE[b] = VB(b)
    return v


def _internable(v) -> bool:
    """Cheap, deep-safe test: only scalars and interned constructors may be
    cache keys — a fresh value may hold closures (brecOn's `below` packing),
    and pinning those in a global cache would retain whole env chains."""
    return (isinstance(v, (VI, VB))
            or (isinstance(v, VCon) and v.interned))


def vcon(name: str, fields: tuple) -> VCon:
    """Intern a constructor application on (name, field identities): equal
    values become the *same object*, shared list suffixes stay shared, and
    cache keys are exact without a deep hash. Values holding fresh closures
    (instance/proof-level packing) are never interned and never compared for
    value equality (BEqbeq skips its instance argument), so they take the
    structural path and stay collectable."""
    if not all(_internable(f) for f in fields):
        return VCon(name, fields)
    key = (name,) + tuple(id(f) for f in fields)
    v = _VCON_CACHE.get(key)
    if v is None:
        v = _VCON_CACHE[key] = VCon(name, fields)
        v.interned = True
    return v


class VDumT:
    def __repr__(self):
        return "·"


VDUM = VDumT()


class VThunk:
    """A deferred recursive-call result (a recursor IH).

    The Lean kernel reduces only what a term actually demands: a minor
    premise that ignores its IH never forces the sub-walk. Computing IHs
    eagerly would re-walk the whole tail per element (quadratic scans);
    this keeps the kernel's demand-driven reduction exactly — a thunk is
    forced only at a real observation point (application head, arithmetic,
    equality, projection, final grounding), and a short-circuiting `or`/`and`
    that never looks at its right operand never runs it.
    """

    __slots__ = ("fn", "_val")

    def __init__(self, fn):
        self.fn = fn            # None once forced
        self._val = None

    def force(self):
        if self.fn is not None:
            self._val = self.fn()
            self.fn = None
        return self._val

    def __repr__(self):
        return f"<thunk{'>' if self.fn is None else '…>'}"


def force(v):
    return v.force() if isinstance(v, VThunk) else v

TYPE_CONSTS = {"Nat", "Bool", "Unit", "PUnit", "PProd", "Decidable", "Prop"}


def as_int(v, ctx: str) -> int:
    v = force(v)
    if isinstance(v, VI):
        return v.n
    raise TranspileError(f"{ctx}: expected a natural, got {v!r}")


def as_bool(v, ctx: str) -> bool:
    v = force(v)
    if isinstance(v, VB):
        return v.b
    raise TranspileError(f"{ctx}: expected a Bool, got {v!r}")


def veq(a, b) -> bool:
    # Interning makes equal scalars/constructors the same object, so identity
    # is structural equality. The structural fallback for VCon only fires for
    # distinct-but-shaped objects, which interning normally prevents (it
    # matters for fields holding fresh closures: instances are never
    # compared for value equality — BEqbeq skips its instance argument).
    a, b = force(a), force(b)
    if a is b:
        return True
    if isinstance(a, VI) and isinstance(b, VI):
        return a.n == b.n
    if isinstance(a, VB) and isinstance(b, VB):
        return a.b == b.b
    if isinstance(a, VCon) and isinstance(b, VCon):
        return (a.name == b.name and len(a.fields) == len(b.fields)
                and all(veq(x, y) for x, y in zip(a.fields, b.fields)))
    return False


class Evaluator:
    """Normalizing evaluator for the export's ground fragment.

    Only value positions are evaluated: type/instance/proof arguments of the
    primitive table are never touched, so proof closures (Falseelim paths in
    unreachable branches, decidability evidence) cannot run.  Everything
    else unfolds through the export's own `def` values — including the
    Nat.rec/brecOn machinery behind `pow10` — so results are the same
    ground values the Lean kernel reduced (the export's `Eq.refl` proofs).
    """

    def __init__(self, ex: Export):
        self.ex = ex
        self.defs: dict[str, int] = {}
        for nm, (kind, rec, _) in ex.decls.items():
            if kind == "def":
                self.defs[Export.canon(nm)] = rec["value"]
        # exact-key memos: dict keys hold the env/values by reference, and
        # every value class hashes by identity, so a hit is the same term in
        # the same environment — no approximation anywhere.
        self._memo: dict = {}            # (eid, env-tuple) -> value
        self._umemo: dict = {}           # (def, arg-values) -> value
        self._recfields: dict = {}       # (induct, cidx) -> rec-field idxs

    def val(self, eid: int, env, ctx: str = ""):
        key = (eid, tuple(env))
        hit = self._memo.get(key)
        if hit is not None:
            return hit
        try:
            v = self.eval(eid, env)
        except TranspileError:
            raise
        except RecursionError as e:
            raise TranspileError(f"evaluator depth exceeded {ctx} @ expr {eid}") from e
        v = force(v)
        self._memo[key] = v
        return v

    def apply(self, f, arg, ctx: str):
        f = force(f)
        if isinstance(f, VClos):
            return self.eval(f.body, [arg] + f.env)
        raise TranspileError(f"{ctx}: applying non-function {f!r}")

    def eval(self, eid: int, env):
        ex = self.ex
        e = ex.exprs.get(eid)
        if e is None:
            raise TranspileError(f"dangling expr {eid}")
        if "bvar" in e:
            i = e["bvar"]
            if i >= len(env):
                raise TranspileError(f"unbound bvar {i} (env {len(env)}) @ {eid}")
            return env[i]
        if "natVal" in e:
            return VI(int(e["natVal"]))
        if "sort" in e or "forallE" in e:
            return VDUM
        if "lam" in e:
            return VClos(e["lam"]["body"], env)
        if "mdata" in e:
            return self.eval(e["mdata"]["expr"], env)
        if "letE" in e:
            v = self.eval(e["letE"]["value"], env)
            return self.eval(e["letE"]["body"], [v] + env)
        if "proj" in e:
            v = force(self.eval(e["proj"]["struct"], env))
            idx = e["proj"]["idx"]
            if isinstance(v, VCon) and 0 <= idx < len(v.fields):
                return v.fields[idx]
            raise TranspileError(f"proj {idx} of {v!r} @ {eid}")
        head, args = ex.spine(eid)
        he = ex.exprs.get(head)
        if he is not None and "const" in he:
            return self.const_app(ex.name(he["const"]["name"]), args, env, eid)
        v = self.eval(head, env)
        for a in args:
            v = self.apply(v, self.eval(a, env), f"app @ {eid}")
        return v

    def const_app(self, raw: str, args: list[int], env, eid: int):
        ex, C = self.ex, Export.canon(raw)
        ev = lambda a: self.eval(a, env)

        # -- primitive table: value positions only -----------------------
        if C in ("HAddhAdd", "HSubhSub", "HMulhMul", "HDivhDiv", "HModhMod"):
            a = as_int(ev(args[-2]), raw)
            b = as_int(ev(args[-1]), raw)
            if C == "HAddhAdd":
                return VI(a + b)
            if C == "HSubhSub":
                return VI(max(a - b, 0))          # Nat.sub, floor at 0
            if C == "HMulhMul":
                return VI(a * b)
            if C == "HDivhDiv":
                return VI(a // b if b else 0)     # Nat.div: x / 0 = 0
            return VI(a % b if b else a)          # Nat.mod: x % 0 = x
        if C == "BEqbeq":
            return VB(veq(ev(args[-2]), ev(args[-1])))
        if C == "OfNatofNat":
            v = force(ev(args[1] if len(args) == 3 else args[-2]))
            if not isinstance(v, VI):
                raise TranspileError(f"OfNat of {v!r} @ {eid}")
            return v
        if C == "LTlt":
            return VB(as_int(ev(args[-2]), "LTlt") < as_int(ev(args[-1]), "LTlt"))
        if C == "LEle":
            return VB(as_int(ev(args[-2]), "LEle") <= as_int(ev(args[-1]), "LEle"))
        if C == "Eq":
            return VB(veq(ev(args[-2]), ev(args[-1])))
        if C == "Not":
            return VB(not self.bool_prop(args[-1], env))
        if C == "Booland":
            return VB(as_bool(ev(args[-2]), "Booland")
                      and as_bool(ev(args[-1]), "Booland"))
        if C == "Boolor":
            return VB(as_bool(ev(args[-2]), "Boolor")
                      or as_bool(ev(args[-1]), "Boolor"))
        if C == "Boolnot":
            return VB(not as_bool(ev(args[-1]), "Boolnot"))
        if C == "Decidabledecide":
            return VB(self.bool_prop(args[0], env))
        if C == "dite":
            # @dite: (α) (c) (h : Decidable c) (t) (e) — the condition is the
            # *proposition* arg[1]; the instance h is never evaluated.
            if len(args) < 5:
                raise TranspileError(f"partial dite ({len(args)} args) @ {eid}")
            cond = self.bool_prop(args[1], env)
            out = self.apply(ev(args[3] if cond else args[4]), VDUM, "dite")
            for a in args[5:]:
                out = self.apply(out, ev(a), "dite result")
            return out
        if C == "NatcasesOn":
            n = as_int(ev(args[-3]), "NatcasesOn")
            if n == 0:
                return ev(args[-2])
            return self.apply(ev(args[-1]), VI(n - 1), "NatcasesOn")
        if C == "Natrec":
            n = as_int(ev(args[-1]), "Natrec")
            z, s = args[-3], args[-2]
            out = ev(z)
            for k in range(n):
                out = self.apply(self.apply(ev(s), VI(k), "Natrec s"), out, "Natrec s ih")
            return out
        if C == "Boolrec":
            # @Bool.rec: (motive) (false-case) (true-case) (t) — nullary
            # constructors, so the minors are values, not functions.
            t = force(ev(args[-1]))
            if not isinstance(t, VB):
                raise TranspileError(f"Boolrec scrutinee is {t!r} @ {eid}")
            return ev(args[-3] if not t.b else args[-2])
        if C == "Natzero":
            return VI(0)
        if C == "Natsucc":
            return VI(as_int(ev(args[0]), "Natsucc") + 1)
        if C == "Booltrue":
            return VB(True)
        if C == "Boolfalse":
            return VB(False)
        if C in TYPE_CONSTS or C in ex.inductive_names:
            return VDUM                                # type head: skip args
        if C in ("Falseelim", "absurd"):
            raise TranspileError(f"reached an impossible branch ({raw}) @ {eid}")

        # -- constructors of the export's inductives (params, then fields;
        # interned, so value equality is identity) -----------------------
        if C in ex.ctors:
            ci = ex.ctors[C]
            arity = ci.num_params + ci.num_fields
            if len(args) != arity:
                raise TranspileError(
                    f"constructor {raw} applied to {len(args)} args, expected "
                    f"{arity} @ {eid}")
            return vcon(C, tuple(ev(a) for a in args[ci.num_params:]))

        # -- generic structural recursors (`@I.rec`: params motive minors…
        # [indices] scrut — the layout the export's own recs declare) -----
        if C in ex.recs:
            ri = ex.recs[C]
            need = (ri.num_params + ri.num_motives + ri.num_minors
                    + ri.num_indices + 1)
            if len(args) < need:
                raise TranspileError(
                    f"partial recursor {raw} ({len(args)}/{need}) @ {eid}")
            lo = ri.num_params + ri.num_motives
            minors = args[lo:lo + ri.num_minors]
            scrut = ev(args[lo + ri.num_minors + ri.num_indices])
            out = self.rec_on(C, minors, env, scrut, eid)
            for a in args[need:]:
                out = self.apply(out, ev(a), f"{raw} result")
            return out

        # -- plain def unfolding ------------------------------------------
        if C in self.defs:
            vals = tuple(ev(a) for a in args)   # evaluated once; memo key
            hit = self._umemo.get((C, vals))
            if hit is not None:
                return hit
            f = self.eval(self.defs[C], [])
            for v in vals:
                f = self.apply(f, v, f"unfold {raw}")
            # memoize scalar results only: keys and values with closures
            # (fresh per step in the brecOn machinery) must stay collectable
            if all(_internable(v) for v in vals) and _internable(f):
                self._umemo[(C, vals)] = f
            return f

        raise TranspileError(f"unknown constant {raw!r} (value position) @ {eid}: "
                             f"{self.ex.pp(eid)}")

    def rec_on(self, C: str, minors: list[int], env, scrut, eid: int):
        """One step of a generic structural recursor: dispatch on the
        scrutinee's constructor, apply the minor premise to the fields, then
        to the IH of each recursive field (Lean's minor-premise layout).

        IHs are passed as lazy thunks — the kernel doesn't reduce an IH its
        minor premise never demands, and that demand (not the walk) is what
        makes scans like `memNat` linear when they short-circuit."""
        ex = self.ex
        scrut = force(scrut)
        if not isinstance(scrut, VCon):
            raise TranspileError(f"{C}: scrutinee is {scrut!r} @ {eid}: "
                                 f"{ex.pp(eid)}")
        ci = ex.ctors.get(scrut.name)
        if ci is None:
            raise TranspileError(f"{C}: {scrut.name} is not a constructor")
        if ci.cidx >= len(minors):
            raise TranspileError(f"{C}: no minor premise {ci.cidx} for "
                                 f"{scrut.name}")
        out = self.eval(minors[ci.cidx], env)
        for f in scrut.fields:
            out = self.apply(out, f, f"{C} {scrut.name} minor")
        for k in self.rec_fields(ci):
            fld = scrut.fields[k]
            out = self.apply(
                out,
                VThunk(lambda fld=fld: self.rec_on(C, minors, env, fld, eid)),
                f"{C} {scrut.name} ih")
        return out

    def rec_fields(self, ci) -> tuple:
        """Field indices of `ci` whose declared type is the inductive itself
        (the recursive fields — each gets an IH in the minor premise)."""
        ex = self.ex
        key = (ci.induct, ci.cidx)
        got = self._recfields.get(key)
        if got is not None:
            return got
        induct = Export.canon(ex.name(ci.induct))
        doms: list[int] = []
        cur = ci.type_eid
        for _ in range(ci.num_params + ci.num_fields):
            e = ex.exprs.get(cur)
            while e is not None and "mdata" in e:
                cur = e["mdata"]["expr"]
                e = ex.exprs.get(cur)
            if e is None or "forallE" not in e:
                break
            doms.append(e["forallE"]["type"])
            cur = e["forallE"]["body"]
        out: list[int] = []
        for k in range(ci.num_fields):
            j = ci.num_params + k
            if j >= len(doms):
                break
            d = doms[j]
            while "mdata" in (ex.exprs.get(d) or {}):
                d = ex.exprs[d]["mdata"]["expr"]
            head, _ = ex.spine(d)
            he = ex.exprs.get(head)
            if he is not None and "const" in he and \
                    Export.canon(ex.name(he["const"]["name"])) == induct:
                out.append(k)
        self._recfields[key] = tuple(out)
        return tuple(out)

    def bool_prop(self, eid: int, env) -> bool:
        """Evaluate a Prop to its truth value (decide/dite conditions only)."""
        ex, C = self.ex, Export.canon
        e = ex.exprs.get(eid)
        if e is None:
            raise TranspileError(f"dangling prop {eid}")
        if "mdata" in e:
            return self.bool_prop(e["mdata"]["expr"], env)
        head, args = ex.spine(eid)
        he = ex.exprs.get(head)
        if he is None or "const" not in he:
            raise TranspileError(f"non-const proposition head: {ex.pp(eid)}")
        n = C(ex.name(he["const"]["name"]))
        ev = lambda a: self.eval(a, env)
        if n == "LTlt":
            return as_int(ev(args[-2]), "LTlt") < as_int(ev(args[-1]), "LTlt")
        if n == "LEle":
            return as_int(ev(args[-2]), "LEle") <= as_int(ev(args[-1]), "LEle")
        if n == "Eq":
            return veq(ev(args[-2]), ev(args[-1]))
        if n == "Not":
            return not self.bool_prop(args[-1], env)
        raise TranspileError(f"unsupported proposition {n!r}: {ex.pp(eid)}")


# ── net encoding (the agent signature of docs/cic.mm0) ──────────────────

@dataclass
class Lit:
    kind: str            # 'i' (tint) | 'b' (ttrue/tfalse)
    val: object

    def mm0(self, num) -> str:
        # A bare numeral denotes `nat` (prefix n<n>: <n>); in Term position
        # (a `tapp` argument) an int literal must be the agent `tint n`.
        # Op/sym arguments of tprim/tentity stay bare -- those are nat.
        if self.kind == "i":
            return f"(tint {num(self.val)})"
        return "ttrue" if self.val else "tfalse"


@dataclass
class Bin:
    op: str              # add/sub/mul/eq/lt/and/or
    a: "Node"            # children may be redexes: the proof lifts them to
    b: "Node"            # their literals by congruence before grounding
    val: object
    via: str             # 'prim_eval' | 'direct'


@dataclass
class Un:
    op: str              # 'not'
    a: "Node"
    val: object
    via: str = "direct"


@dataclass
class Div:
    a: "Node"
    b: "Node"
    val: object
    via: str = "direct"


Node = Lit | Bin | Un | Div


def _flip_node(node: Node) -> Node:
    """A copy of `node` whose *value* is wrong but whose shape is unchanged.

    Only the self-test calls this. It must be the narrowest possible lie: the
    encoder's own reduction is untouched (`teq_refl` still holds for the
    literals), so the only thing that can notice is the evaluator-vs-net
    cross-check in `generate_source`.
    """
    if isinstance(node, Lit):
        if node.kind == "b":
            return Lit("b", not node.val)
        return Lit("b", False)
    if isinstance(node, Bin):
        return Bin(node.op, node.a, node.b, not node.val, node.via)
    if isinstance(node, Un):
        return Un(node.op, node.a, not node.val, node.via)
    return Div(node.a, node.b, node.val + 1, node.via)

INT_OPS = {"add", "sub", "mul", "eq", "lt"}     # int args, prim_eval route
BOOL_OPS = {"and", "or"}                        # bool args, direct grounding


def term_of(node: Node, num) -> str:
    """The cic.mm0 encoding of a node (math-string body, no $)."""
    if isinstance(node, Lit):
        return node.mm0(num)
    if isinstance(node, (Bin, Div)):
        if isinstance(node, Div):
            head = f"(tentity {num(ENTITY_SYM['idiv'])})"
        else:
            head = f"(tprim {num(PRIM_TAG[node.op])})"
        inner = f"(tapp {head} {term_of(node.a, num)})"
        return f"(tapp {inner} {term_of(node.b, num)})"
    if isinstance(node, Un):
        return f"(tapp (tprim {num(PRIM_TAG['not'])}) {term_of(node.a, num)})"
    raise AssertionError(type(node))


def lit_val(v) -> tuple[str, object]:
    v = force(v)
    if isinstance(v, VI):
        return "i", v.n
    if isinstance(v, VB):
        return "b", v.b
    raise TranspileError(f"cannot ground value {v!r}")


class Encoder:
    """Structural encoding of a closed ground expression.

    Primitive applications (per the lowering table below) become net nodes;
    everything else — Lean-level recursion (`pow10`'s brecOn machinery),
    constants, wrappers — is *evaluated* to a literal, because the agent
    signature has no agent for Lean recursion: the emitter grounds it,
    exactly as cic.mm0 prescribes for `teval`.
    """

    PRIMS = {"HAddhAdd": "add", "HSubhSub": "sub", "HMulhMul": "mul",
             "HDivhDiv": "idiv", "BEqbeq": "eq", "Booland": "and",
             "Boolor": "or"}

    def __init__(self, ex: Export, ev: Evaluator):
        self.ex = ex
        self.ev = ev

    @staticmethod
    def val_env(env) -> list:
        """The evaluator's view of an encode-env: entries carry values."""
        return [e[2] for e in env]

    def enc(self, eid: int, env) -> Node:
        ex = self.ex
        e = ex.exprs.get(eid)
        if e is None:
            raise TranspileError(f"dangling expr {eid}")
        if "bvar" in e:
            i = e["bvar"]
            if i >= len(env):
                raise TranspileError(f"enc: unbound bvar {i} @ {eid}")
            eid2, env2, _v = env[i]
            return self.enc(eid2, env2)
        if "mdata" in e:
            return self.enc(e["mdata"]["expr"], env)
        head, args = ex.spine(eid)
        he = ex.exprs.get(head)
        if he is not None and "const" in he:
            n = Export.canon(ex.name(he["const"]["name"]))
            try:
                node = self.const_node(n, args, env, eid)
            except TranspileError:
                # Structure failed (list-valued operand, partial def, type
                # shape): fall through to whole-expression evaluation —
                # still cross-checked below, never silently wrong.
                node = None
            if node is not None:
                return node
        # not structurally encodable: evaluate to a literal (or fail loudly)
        v = self.ev.val(eid, self.val_env(env), "encode fallback")
        kind, val = lit_val(v)
        return Lit(kind, val)

    def const_node(self, C: str, args: list[int], env, eid: int) -> Node | None:
        if C == "OfNatofNat":
            v = self.ev.val(args[1] if len(args) == 3 else args[-2],
                            self.val_env(env), "OfNat")
            kind, val = lit_val(v)
            return Lit(kind, val)
        if C in ("Booltrue", "Boolfalse"):
            return Lit("b", C == "Booltrue")
        if C == "Natzero":
            return Lit("i", 0)
        if C == "Natsucc":
            v = self.ev.val(eid, self.val_env(env), "succ")
            _, val = lit_val(v)
            return Lit("i", val)
        if C == "HDivhDiv":
            # no int64 division prim exists in the agent signature
            # (austral_codegen: `/` is always F64); Nat.div is grounded as a
            # symbol-level application — see ENTITY_SYM in the emitted file.
            a = self.enc(args[-2], env)
            b = self.enc(args[-1], env)
            for side, child in (("lhs", a), ("rhs", b)):
                if type(child.val) is not int:
                    raise TranspileError(
                        f"idiv {side} reduces to {child.val!r}: {self.ex.pp(eid)}")
            return Div(a, b, a.val // b.val if b.val else 0)
        if C in self.PRIMS:
            op = self.PRIMS[C]
            a = self.enc(args[-2], env)
            b = self.enc(args[-1], env)
            return self.bin(op, a, b, eid)
        if C == "Decidabledecide":
            return self.decide_node(args[0], env, eid)
        if C in ("Boolnot",):
            a = self.enc(args[-1], env)
            if not isinstance(a, Lit) or a.kind != "b":
                raise TranspileError(f"encoding not of {a!r} @ {eid}")
            return Un("not", a, not a.b)
        # def unfolding keeps the structure
        if C in self.ev.defs:
            return self.enc_closure(C, args, env, eid)
        return None

    def enc_closure(self, C: str, args: list[int], env, eid: int) -> Node:
        """Unfold `C` and apply it to argument *expressions*, then encode."""
        ex = self.ex
        cur_body = self.ev.defs[C]
        cur_env: list = list(env)
        pending = list(args)
        while pending:
            b = ex.exprs.get(cur_body)
            if b is None:
                raise TranspileError(f"{C}: dangling def value")
            if "mdata" in b:
                cur_body = b["mdata"]["expr"]
                continue
            if "lam" in b:
                a = pending.pop(0)
                v = self.ev.val(a, self.val_env(env), f"{C} arg")
                cur_env = [(a, env, v)] + cur_env
                cur_body = b["lam"]["body"]
                continue
            if "forallE" in b:
                cur_body = b["forallE"]["body"]
                continue  # type-level binder: free, consumes no argument
            # head is not a lambda: evaluate-and-apply semantics, literal out
            v = self.ev.val(cur_body, self.val_env(cur_env), f"unfold {C}")
            for a in pending:
                v = self.ev.apply(v, self.ev.val(a, self.val_env(env), f"{C} arg"), C)
            kind, val = lit_val(v)
            return Lit(kind, val)
        return self.enc(cur_body, cur_env)

    def decide_node(self, prop_eid: int, env, eid: int) -> Node:
        ex = self.ex
        head, args = ex.spine(prop_eid)
        he = ex.exprs.get(head)
        if he is None or "const" not in he:
            raise TranspileError(f"decide of non-const prop: {ex.pp(prop_eid)}")
        n = Export.canon(ex.name(he["const"]["name"]))
        if n == "LTlt":
            return self.bin("lt", self.enc(args[-2], env), self.enc(args[-1], env), eid)
        if n == "LEle":
            # documented kernel-subset lowering (deltanet_plugin.ml):
            # a <= b  ⇝  not (b < a)
            inner = self.bin("lt", self.enc(args[-1], env), self.enc(args[-2], env), eid)
            if type(inner.val) is not bool:
                raise TranspileError(f"le lowering produced {inner.val!r}")
            return Un("not", inner, not inner.val)
        if n == "Eq":
            return self.bin("eq", self.enc(args[-2], env), self.enc(args[-1], env), eid)
        raise TranspileError(f"unsupported decide prop {n}: {ex.pp(prop_eid)}")

    def bin(self, op: str, a: Node, b: Node, eid: int) -> Node:
        # `val`s are raw python values (int/bool) after lit_val normalization;
        # `type(...) is` keeps bools out of the int family (bool <: int).
        want = bool if op in BOOL_OPS else int
        for side, child in (("lhs", a), ("rhs", b)):
            if type(child.val) is not want:
                raise TranspileError(
                    f"prim {op}: {side} reduces to {child.val!r}, expected "
                    f"{want.__name__}: {self.ex.pp(eid)}")
        if op in INT_OPS:
            x, y = a.val, b.val
            if op == "add":
                v = x + y
            elif op == "sub":
                v = max(x - y, 0)
            elif op == "mul":
                v = x * y
            elif op == "eq":
                v = x == y
            else:
                v = x < y
            return Bin(op, a, b, v, "prim_eval")
        if op == "and":
            return Bin(op, a, b, a.val and b.val, "direct")
        if op == "or":
            return Bin(op, a, b, a.val or b.val, "direct")
        raise TranspileError(f"unknown prim {op}")


# ── proof construction + ground-instance registry ───────────────────────

@dataclass
class Registry:
    numerals: set = field(default_factory=set)
    bridges: dict = field(default_factory=dict)     # (op,a,b) -> ("i"|"b", result)
    directs: dict = field(default_factory=dict)     # name -> statement

    def num(self, n) -> str:
        n = int(n)
        if n < 0:
            raise TranspileError(f"negative numeral {n} (ground values must be "
                                 "non-negative naturals)")
        if n > 2**63 - 1:
            raise TranspileError(f"numeral {n} exceeds Int64 range")
        self.numerals.add(n)
        return str(n)


def bridge_name(op: str, a, b) -> str:
    return f"teval_ground_{op}_{a}_{b}"


def ensure_direct(reg: Registry, name: str, stmt: str) -> None:
    if name in reg.directs and reg.directs[name] != stmt:
        raise TranspileError(f"axiom {name} redefined with a different statement")
    reg.directs[name] = stmt


def build_proof(node: Node, reg: Registry) -> str:
    """An mm1 verbatim term proving `teq <node> <lit(node.val)>`."""
    if isinstance(node, Lit):
        return "teq_refl"
    if isinstance(node, Bin):
        inner = f"(teq_app teq_refl {build_proof(node.a, reg)})"
        outer = f"(teq_app {inner} {build_proof(node.b, reg)})"
        if node.via == "prim_eval":
            # route through cic.mm0's schema, then ground the teval instance:
            #   teq redex (tint (teval op a b))   [prim_eval]
            #   teq (tint (teval op a b)) lit     [bridge]
            key = (node.op, node.a.val, node.b.val)
            if key not in reg.bridges:
                # node.val is a raw python value (post lit_val normalization)
                rkind = "b" if type(node.val) is bool else "i"
                rval = node.val
                if node.op in ("eq", "lt") and rkind != "b":
                    raise TranspileError(f"{node.op} must ground to a Bool")
                if node.op in ("add", "sub", "mul") and rkind != "i":
                    raise TranspileError(f"{node.op} must ground to a nat")
                reg.bridges[key] = (rkind, rval)
            step = f"(teq_trans prim_eval {bridge_name(node.op, node.a.val, node.b.val)})"
        else:
            x, y, v = node.a.val, node.b.val, node.val
            name = f"ground_{node.op}_{int(x)}_{int(y)}"
            stmt = (f"teq (tapp (tapp (tprim {reg.num(PRIM_TAG[node.op])}) "
                    f"{'ttrue' if x else 'tfalse'}) {'ttrue' if y else 'tfalse'}) "
                    f"{'ttrue' if v else 'tfalse'}")
            ensure_direct(reg, name, stmt)
            step = name
        return f"(teq_trans {outer} {step})"
    if isinstance(node, Un):
        lift = f"(teq_app teq_refl {build_proof(node.a, reg)})"
        x = node.a.val
        if type(x) is not bool:
            raise TranspileError(f"not of {x!r}")
        name = f"ground_not_{int(x)}"
        stmt = (f"teq (tapp (tprim {reg.num(PRIM_TAG['not'])}) "
                f"{'ttrue' if x else 'tfalse'}) {'ttrue' if node.val else 'tfalse'}")
        ensure_direct(reg, name, stmt)
        return f"(teq_trans {lift} {name})"
    if isinstance(node, Div):
        inner = f"(teq_app teq_refl {build_proof(node.a, reg)})"
        outer = f"(teq_app {inner} {build_proof(node.b, reg)})"
        a, b, v = node.a.val, node.b.val, node.val
        name = f"ground_idiv_{a}_{b}"
        stmt = (f"teq (tapp (tapp (tentity {reg.num(ENTITY_SYM['idiv'])}) "
                f"(tint {reg.num(a)})) (tint {reg.num(b)})) (tint {reg.num(v)})")
        ensure_direct(reg, name, stmt)
        return f"(teq_trans {outer} {name})"
    raise AssertionError(type(node))


# ── emission ─────────────────────────────────────────────────────────────

def generate_source(src: dict, tamper: str | None = None) -> tuple[str, str]:
    """Emit one certificate stream, or raise TranspileError.

    `tamper` exists for the self-test (§9.3 of docs/lean4mm0.md): "kernel"
    flips the Lean-side evaluation result, "net" flips the encoded node's
    value. Both must be caught by the two anchors below — that is the claim
    the trust story rests on, and this parameter is how it is exercised.
    """
    stem = src["stem"]
    ndjson, lean_src, expected = src["ndjson"], src["lean"], src["thms"]
    if not ndjson.exists():
        raise TranspileError(f"fixture missing: {ndjson}")
    if not CIC.exists():
        raise TranspileError(f"theory missing: {CIC}")
    ex = Export(ndjson)
    ev = Evaluator(ex)
    enc = Encoder(ex, ev)

    # select the certificates: theorems whose statement is `lhs = true`
    thms: list[tuple[str, int]] = []
    for nm, (kind, rec, _line) in ex.decls.items():
        if kind != "thm" or not nm.endswith("_verified"):
            continue
        head, args = ex.spine(rec["type"])
        he = ex.exprs.get(head)
        if he is None or "const" not in he or \
                Export.canon(ex.name(he["const"]["name"])) != "Eq":
            raise TranspileError(f"{nm}: statement is not an Eq: {ex.pp(rec['type'])}")
        if len(args) != 3:
            raise TranspileError(f"{nm}: Eq spine has {len(args)} args")
        _, lhs, rhs = args
        rhe = ex.exprs.get(rhs)
        if rhe is None or "const" not in rhe or \
                Export.canon(ex.name(rhe["const"]["name"])) != "Booltrue":
            raise TranspileError(f"{nm}: RHS is not `true`: {ex.pp(rhs)}")
        thms.append((nm, lhs))
    found = [n for n, _ in thms]
    if found != expected:
        raise TranspileError(f"{stem}: certificate set drifted:\n"
                             f"  expected {expected}\n"
                             f"  found    {found}")

    # encode every certificate; cross-check evaluator vs net reduction
    reg = Registry()
    encoded: list[tuple[str, str, Node, str]] = []   # (thm, defname, node, proof)
    for thm, lhs in thms:
        v = ev.val(lhs, [], f"{thm} lhs")
        if tamper == "kernel":
            v = vb(not v.b) if isinstance(v, VB) else v
        if not (isinstance(v, VB) and v.b):
            raise TranspileError(f"{thm}: Lean-side evaluation is {v!r}, not `true` "
                                 "(the evaluator disagrees with the kernel's rfl)")
        head, args = ex.spine(lhs)
        he = ex.exprs.get(head)
        if he is not None and "const" in he and not args:
            defname = ex.name(he["const"]["name"])
        else:
            defname = f"{thm}_body"
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", defname):
            raise TranspileError(f"{thm}: def name {defname!r} is not a legal MM0 ident")
        node = enc.enc(lhs, [])
        if tamper == "net":
            node = _flip_node(node)
        nv = node.val
        if not (isinstance(nv, bool) and nv):
            raise TranspileError(f"{thm}: net reduction is {nv!r}, not `true` "
                                 "(encoding disagrees with the evaluator)")
        proof = build_proof(node, reg)
        encoded.append((thm, defname, node, proof))

    defnames = [d for _, d, _, _ in encoded]
    if len(set(defnames)) != len(defnames):
        raise TranspileError(f"duplicate def names: {defnames}")

    # the trust split, reported in the header and tagged per def below
    n_struct = sum(1 for _, _, node, _ in encoded if not isinstance(node, Lit))
    n_ground = len(encoded) - n_struct
    budget = BUDGETS.get(stem)
    if budget is None:
        raise TranspileError(
            f"{stem}: no trust-split budget in BUDGETS — add one (the split is "
            "a pinned contract, not a statistic)")
    actual = {"structural": n_struct, "grounded": n_ground,
              "certificates": len(encoded)}
    if actual != budget:
        raise TranspileError(
            f"{stem}: trust split widened/drifted: {actual} != pinned {budget}. "
            "Movement toward `grounded` means mm0-c checks less of this "
            "certificate; if that is intended, edit BUDGETS in the same commit "
            "and say why in the artifact header.")

    # ---- content groups (numerals are collected as math strings are built,
    # so the numeral block is rendered strictly LAST, before assembly) ----
    cic_lines = CIC.read_text().rstrip("\n").split("\n")

    header = [
        f"-- {stem}.{{mm0,mm1}} — GENERATED by australVM/scripts/lean2mm0.",
        "-- DO NOT EDIT: run `scripts/lean2mm0` to regenerate;",
        "-- `scripts/lean2mm0 check` gates drift, `scripts/lean2mm0 verify`",
        "-- runs the mm0-rs elaborator and the mm0-c root of trust.",
        "--",
        f"-- Source of record : {lean_src.relative_to(WS)}",
        f"-- Kernel export    : {ndjson.relative_to(WS)}",
        f"--   sha256 {ex.sha256}  (lean4export 3.1.0, re-verified by nanoda",
        "--   in unfer's prob_kernel suite)",
        f"-- Target theory    : {CIC.relative_to(WS)} (embedded verbatim below)",
        "--",
        "-- Each `<x>_checked : Term` is the agent-signature encoding of the Lean",
        "-- def's unfolded body (tint / tprim at unf.rs prim_tag bytes / ttrue /",
        "-- tfalse / tentity). Each `<x>_verified` reduces that encoding to ttrue",
        "-- by congruence + prim_eval + grounded instances; mm0-c checks every",
        "-- step against docs/cic.mm0.",
        "--",
        trust_split_line(stem, n_struct, n_ground, len(encoded)),
        "--",
        "-- Trust split (tagged on each def below — structural vs grounded):",
        f"--   {n_struct} structural: the net spine is checked by mm0-c step by step",
        "--     (congruence teq_app, prim_eval bridges, grounded instances); its",
        "--     literal leaves — e.g. a List.length the kernel reduced — were",
        "--     evaluated by the emitter and cross-checked against the net's",
        "--     own reduction before emission.",
        f"--   {n_ground} grounded: the body is ttrue because the def is pure",
        "--     recursion, which the signature cannot encode (no recursion agent);",
        "--     the emitter evaluated it. The anchor is nanoda's kernel-verified rfl",
        "--     plus the emitter's two independent paths (evaluator vs net), not a",
        "--     structural proof — mm0-c verifies only the resulting tautology.",
        "",
    ]

    def_lines: list[str] = []
    for thm, defname, node, _ in encoded:
        def_lines.append(f"-- {thm}: Lean def `{defname}`, reduced to true by kernel rfl.")
        if isinstance(node, Lit):
            def_lines.append("--   grounded: body evaluated to its literal (trust split above).")
        else:
            def_lines.append("--   structural: net spine checked by mm0-c (trust split above).")
        def_lines.append(f"def {defname}: Term = $ {term_of(node, reg.num)} $;")
        def_lines.append("")

    bridge_lines: list[str] = [
        "-- Ground evaluation of int64 redexes, via cic.mm0's prim_eval schema:",
        "--   prim_eval gives  teq redex (tint (teval op a b)); the bridge below",
        "--   grounds the uninterpreted `teval` at this instance (cic.mm0:",
        '--   "the emitter grounds each prim_tag byte"). Each is a trivially',
        "-- checkable decimal fact — the auditing stance of the spec file.",
    ]
    for (op, a, b), (kind, r) in sorted(reg.bridges.items(),
                                         key=lambda kv: (kv[0][0], kv[0][1], kv[0][2])):
        tag = reg.num(PRIM_TAG[op])
        if kind == "i":
            rhs = f"(tint {reg.num(r)})"
        else:
            rhs = "ttrue" if r else "tfalse"
        stmt = f"teq (tint (teval {tag} {reg.num(a)} {reg.num(b)})) {rhs}"
        bridge_lines.append(f"axiom {bridge_name(op, a, b)}: $ {stmt} $;")
    bridge_lines.append("")

    direct_lines: list[str] = [
        "-- Directly grounded redexes: bool-valued prims (cic.mm0's prim_eval",
        "-- codomain is tint), the unary not, and integer division — the agent",
        "-- signature has no div primitive (austral_codegen: `/` is always F64),",
        "-- so Nat.div is a symbol-level application; its symbol table:",
        f"--   tentity {ENTITY_SYM['idiv']} = idiv (integer division)",
    ]
    for name, stmt in sorted(reg.directs.items()):
        direct_lines.append(f"axiom {name}: $ {stmt} $;")
    direct_lines.append("")

    thm_spec: list[str] = []
    thm_mm1: list[str] = []
    for thm, defname, _node, proof in encoded:
        stmt = f"teq {defname} ttrue"
        wrapped = proof if proof.startswith("(") else f"({proof})"
        thm_spec.append(f"theorem {thm}: $ {stmt} $;")
        thm_mm1.append(f"pub theorem {thm}: $ {stmt} $ = '{wrapped};")

    numeral_lines = [
        "-- Ground numerals: declared once, written as decimal tokens so the",
        "-- emitted arithmetic reads exactly like the certificate:",
        "--   teq (tint (teval 1 19875 555)) (tint 19320)   -- 19875 - 555",
    ]
    for n in sorted(reg.numerals):
        numeral_lines.append(f"term n{n}: nat; prefix n{n}: ${n}$ prec max;")
    numeral_lines.append("")

    # ---- assemble: identical streams except `pub ` and the proof tail ----
    pairs: list[tuple[str, str]] = []

    def add(spec: str, mm1: str | None = None):
        pairs.append((spec, spec if mm1 is None else mm1))

    for line in cic_lines:
        add(line)
    add("")
    # Coverage is computed here rather than with the rest of the header because
    # it scans the rendered declarations, which only exist by now.
    coverage = coverage_line(
        "\n".join(def_lines + bridge_lines + direct_lines + thm_spec))
    for line in header[:-1]:
        add(line)
    add(coverage)
    add("")
    for line in numeral_lines:
        add(line)
    for line in def_lines:
        add(line)
    for line in bridge_lines:
        add(line)
    for line in direct_lines:
        add(line)
    for s, m in zip(thm_spec, thm_mm1):
        add(s, m)
    add("")

    mm0_lines = [p for p, _ in pairs]
    mm1_lines = [m for _, m in pairs]

    # self-check 1: the two files differ ONLY in `pub ` and the proof tail
    stripped = [re.sub(r"^pub ", "", m) for m in mm1_lines]
    stripped = [re.sub(r" = '[\s\S]*;$", ";", s) for s in stripped]
    if len(mm0_lines) != len(stripped):
        raise TranspileError("spec/proof line counts differ")
    for i, (a_, b_) in enumerate(zip(mm0_lines, stripped), 1):
        if a_ != b_:
            raise TranspileError(f"spec/proof divergence at line {i}:\n"
                                 f"  mm0: {a_}\n  mm1: {b_}")

    # self-check 2: every proof reference is declared somewhere in the file
    declared = set()
    for line in mm1_lines:
        m = re.match(r"(?:pub )?(?:theorem|axiom|def|term) ([A-Za-z_][A-Za-z0-9_]*)", line)
        if m:
            declared.add(m.group(1))
    ref_re = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
    for line in mm1_lines:
        if " = '" not in line:
            continue
        proof = line.split("= '", 1)[1]
        for t in ref_re.findall(proof):
            if t in ("teq_trans", "teq_app", "teq_refl", "prim_eval"):
                continue
            if t not in declared:
                raise TranspileError(f"proof references undeclared {t!r}: "
                                     f"{line[:120]}")

    mm0 = "\n".join(header_prepend(header, cic_lines, mm0_lines)) + "\n"
    mm1 = "\n".join(header_prepend(header, cic_lines, mm1_lines)) + "\n"
    return mm0, mm1


# ── statement-of-record emission (the set.mm import layer) ──────────────
#
# generate_source above proves closed Bool reductions over cic.mm0; this
# block carries the *statement* of the quasi-Riemann result into the imported
# set.mm theory as an axiom. Three anchors, in increasing order of what they
# can see:
#
#   1. shape — the export's value must be exactly
#        ∀ s : Complex, (boundScaled < complexReScaled s) →
#                       (riemannZeta s ≠ complexZero)
#      with every atom resolved by name (Complex, LT.lt, Ne, …), so a fixture
#      whose statement changed is refused instead of reinterpreted;
#   2. bound — boundScaled/denom are *evaluated* from the pinned export
#      (8750/10000) and cross-multiplied against 7/8 (8·8750 = 7·10000):
#      the emitted `( 7 / 8 )` is the Lean def's own value, not a comment;
#   3. theory — the label contract (SETMM_LABELS) is grounded against
#      metamath/set.mm0 by `verify` (existence + sort), then mm0-c checks
#      the axiom over the joined spec, re-verifying every imported proof.
#
# `tamper` exists for selftest: "shape" mis-expects the hypothesis head,
# "bound" mis-expects the seven-eighths numerator. Both must be refused.

def _strip_mdata(ex: Export, eid: int) -> int:
    while True:
        e = ex.exprs.get(eid)
        if e is None:
            raise TranspileError(f"dangling expr {eid}")
        if "mdata" not in e:
            return eid
        eid = e["mdata"]["expr"]


def _expect_const(ex: Export, eid: int, want: str, what: str) -> None:
    e = ex.exprs.get(eid) or {}
    if "const" not in e:
        raise TranspileError(
            f"structure mismatch: {what} is not a constant: {ex.pp(eid)}")
    got = Export.canon(ex.name(e["const"]["name"]))
    if got != want:
        raise TranspileError(
            f"structure mismatch: {what} is {got}, expected {want}")


def _expect_bvar(ex: Export, eid: int, idx: int, what: str) -> None:
    e = ex.exprs.get(eid) or {}
    if e.get("bvar") != idx:
        raise TranspileError(
            f"structure mismatch: {what} is not bound variable #{idx}")


def check_statement_shape(ex: Export, decl: str, hyp_head: str = "LTlt") -> None:
    """Anchor 1 — the export must be exactly the statement of record."""
    kind, rec, _line = ex.decls.get(decl, (None, None, None))
    if kind is None:
        raise TranspileError(f"statement decl missing from export: {decl}")
    if kind != "def":
        raise TranspileError(
            f"structure mismatch: {decl} is a {kind}, expected a def")
    t = _strip_mdata(ex, rec["type"])
    te = ex.exprs[t]
    if te.get("sort") != 0:
        raise TranspileError(
            f"structure mismatch: {decl} is not a Prop (Sort 0): {ex.pp(t)}")
    v = _strip_mdata(ex, rec["value"])
    ve = ex.exprs[v]
    if "forallE" not in ve:
        raise TranspileError(f"structure mismatch: body is not a ∀: {ex.pp(v)}")
    outer = ve["forallE"]
    _expect_const(ex, _strip_mdata(ex, outer["type"]), "Complex",
                  "the quantifier domain")
    inner_e = _strip_mdata(ex, outer["body"])
    inner_n = ex.exprs.get(inner_e) or {}
    if "forallE" not in inner_n:
        raise TranspileError(
            f"structure mismatch: the hypothesis binder is missing: "
            f"{ex.pp(inner_e)}")
    inner = inner_n["forallE"]
    # hypothesis: hyp_head … boundScaled (complexReScaled #0)
    head, args = ex.spine(_strip_mdata(ex, inner["type"]))
    he = ex.exprs.get(head) or {}
    if "const" not in he:
        raise TranspileError(
            f"structure mismatch: hypothesis head is not a constant: "
            f"{ex.pp(head)}")
    got = Export.canon(ex.name(he["const"]["name"]))
    if got != hyp_head:
        raise TranspileError(
            f"structure mismatch: hypothesis head is {got}, expected {hyp_head}")
    if len(args) < 2:
        raise TranspileError(
            f"structure mismatch: {hyp_head} has {len(args)} args, expected ≥ 2")
    lhs, rhs = args[-2], args[-1]
    _expect_const(ex, _strip_mdata(ex, lhs), "boundScaled", "the bound (lhs)")
    rh, rargs = ex.spine(_strip_mdata(ex, rhs))
    _expect_const(ex, rh, "complexReScaled", "the scaled real part (rhs)")
    if len(rargs) != 1:
        raise TranspileError(
            f"structure mismatch: complexReScaled has {len(rargs)} args, "
            "expected 1")
    _expect_bvar(ex, rargs[0], 0, "the real-part argument")
    # conclusion: Ne … (riemannZeta #1) complexZero
    ch, cargs = ex.spine(_strip_mdata(ex, inner["body"]))
    _expect_const(ex, ch, "Ne", "the conclusion (≠)")
    if len(cargs) < 2:
        raise TranspileError(
            f"structure mismatch: Ne has {len(cargs)} args, expected ≥ 2")
    lh, largs = ex.spine(_strip_mdata(ex, cargs[-2]))
    _expect_const(ex, lh, "riemannZeta", "the zeta application (lhs)")
    if len(largs) != 1:
        raise TranspileError(
            f"structure mismatch: riemannZeta has {len(largs)} args, expected 1")
    _expect_bvar(ex, largs[0], 1, "the zeta argument")
    _expect_const(ex, _strip_mdata(ex, cargs[-1]), "complexZero",
                  "the zero constant (rhs)")


def ground_bound(ex: Export, ev: Evaluator,
                 tamper: str | None = None) -> tuple[int, int]:
    """Anchor 2 — the emitted ( 7 / 8 ) is the Lean bound's evaluated value.

    Returns the numerator/denominator to emit. All four bound defs are
    evaluated from the export (never read from source text), then tied to
    seven-eighths by cross-multiplication on the common denominator — the
    same identity `bound_is_seven_eighths_verified` closes kernel-side.
    """
    def ev_nat(decl_name: str) -> int:
        if decl_name not in ex.decls:
            raise TranspileError(f"statement fixture lacks {decl_name}")
        return as_int(ev.val(ex.decls[decl_name][1]["value"], [], decl_name),
                      decl_name)
    bs, dn = ev_nat("boundScaled"), ev_nat("denom")
    mant, exp = ev_nat("boundMantissa"), ev_nat("boundExp")
    if bs != mant:
        raise TranspileError(
            f"seven-eighths decimal read disagrees with the computation: "
            f"boundMantissa={mant}, boundScaled={bs}")
    if dn != 10 ** exp:
        raise TranspileError(
            f"seven-eighths denominator disagrees with the decimal read: "
            f"denom={dn}, 10^{exp}={10 ** exp}")
    num = 6 if tamper == "bound" else 7
    den = 8
    if den * bs != num * dn:
        raise TranspileError(
            f"seven-eighths identity failed: {den}×{bs} != {num}×{dn} "
            "(the emitted fraction is not the Lean bound)")
    return num, den


def statement_coverage_line(math: str) -> str:
    """Which pinned set.mm labels the emitted math names (§9.4 discipline:
    generated from the same pass that renders the axiom, not prose)."""
    used = [l for l in SETMM_LABELS if re.search(rf"\b{re.escape(l)}\b", math)]
    unused = [l for l in SETMM_LABELS if l not in used]
    return (f"-- theory coverage: used={','.join(used) or '-'} "
            f"unused={','.join(unused) or '-'}")


def generate_statement(src: dict, tamper: str | None = None) -> tuple[str, str]:
    """Emit one statement artifact over the imported set.mm theory, or raise.

    The two streams are line-identical except for the import line (the spec
    reads set.mm0, the proof file reads set.mmu) — self-checked below.
    """
    stem, ndjson, lean_src = src["stem"], src["ndjson"], src["lean"]
    decl_name = src["decl"]
    if not ndjson.exists():
        raise TranspileError(f"fixture missing: {ndjson}")
    ex = Export(ndjson)
    ev = Evaluator(ex)

    # anchors 1 and 2 (block comment above)
    num, den = ground_bound(ex, ev, tamper)
    check_statement_shape(ex, decl_name,
                          hyp_head="LEle" if tamper == "shape" else "LTlt")

    budget = BUDGETS.get(stem)
    actual = {"structural": 0, "grounded": 0, "statements": 1}
    if budget is None:
        raise TranspileError(
            f"{stem}: no trust-split budget in BUDGETS — add one (the split is "
            "a pinned contract, not a statistic)")
    if actual != budget:
        raise TranspileError(
            f"{stem}: trust split widened/drifted: {actual} != pinned {budget}. "
            "Edit BUDGETS in the same commit and say why in the artifact "
            "header.")

    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", decl_name):
        raise TranspileError(
            f"{stem}: axiom name {decl_name!r} is not a legal MM0 ident")

    # the axiom, in set.mm's own notation. Argument order follows MM0's
    # parameter (= set.mm $f) order, not the surface text: wbr(A,B,R) is
    # `A R B`, cfv(point, F) is `( F ` point )`, co(a,b,F) is `( a F b )`.
    math = (f"$ wcel s cc $ > $ wbr (co c{num} cdiv c{den}) "
            f"(cfv s cre) clt $ > $ wne (cfv s czeta) cc0 $")
    for tok in re.findall(r"[A-Za-z_][A-Za-z0-9_]*", math):
        if tok != "s" and tok not in SETMM_LABELS:
            raise TranspileError(
                f"{stem}: axiom names {tok!r}, which is not a pinned set.mm "
                "label (SETMM_LABELS)")
    coverage = statement_coverage_line(math)

    header = [
        f"-- {stem}.{{mm0,mm1}} — GENERATED by australVM/scripts/lean2mm0.",
        "-- DO NOT EDIT: run `scripts/lean2mm0` to regenerate;",
        "-- `scripts/lean2mm0 check` gates drift, `scripts/lean2mm0 verify`",
        "-- runs the mm0-rs elaborator and the mm0-c root of trust.",
        "--",
        f"-- Source of record : {lean_src.relative_to(WS)}",
        f"--   ({decl_name} — the quasi-Riemann statement of record,",
        "--   restated over opaque stand-ins; asserted here, not proved here)",
        "-- Proof of record  : math/lean/ComparatorChallenges/",
        "--   QuasiRiemannHypothesis.lean (the challenge stub) and",
        "--   math/lean/OAI/NumberTheory/DirichletL/Nonvanishing.lean (the",
        "--   Mathlib DirichletL development — the analytic proof, beyond this",
        "--   pipeline's ground-Bool scope, docs/lean4mm0.md §9.2)",
        f"-- Kernel export    : {ndjson.relative_to(WS)}",
        f"--   sha256 {ex.sha256}  (lean4export 3.1.0, re-verified by nanoda",
        "--   in unfer's prob_kernel suite)",
        f"-- Target theory    : {SPEC_IMPORT} (imported, NOT embedded) +",
        f"--   {PROOF_IMPORT} — set.mm's own proofs, re-verified",
        "--   by mm0-c against the joined spec on every verify.",
        "--   Provisioning: docs/lean4mm0.md §11 (untracked toolchain state).",
        "--",
        "-- Lean → set.mm mapping, each side anchored:",
        "--   ∀ s : Complex       ↦  axiom binder (s: class) + s e. CC",
        f"--   boundScaled < _     ↦  ( {num} / {den} ) < ( Re ` s )",
        f"--     boundScaled = {num}·10⁴/{den} is evaluated from the pinned export",
        f"--     and cross-multiplied against {num}/{den} (8·8750 = 7·10000) — the",
        "--     numeral above is the Lean def's value, not a comment. The",
        "--     stand-in's scaled-natural hypothesis is read as the real",
        "--     inequality it states (QuasiRiemannCertificate.lean's mapping",
        "--     note).",
        "--   complexReScaled s   ↦  ( Re ` s )   [set.mm `Re` is ℜ — df-re]",
        "--   riemannZeta s       ↦  ( ζ ` s )    [set.mm df-zeta]",
        "--   complexZero         ↦  0",
        "--   ≠                   ↦  =/=",
        "-- The label contract (existence + sort) is grounded against",
        f"-- {SPEC_IMPORT} by `verify` when the theory is provisioned.",
        "--",
        "-- trust-split: structural=0 grounded=0 statements=1",
        "--",
        "-- Trust split: nothing in this file is a Bool-rfl certificate;",
        "-- `statements=1` is one asserted axiom whose truth is the proof of",
        "-- record above. What mm0-c checks is everything else: the statement's",
        "-- well-formedness against set.mm's grammar, and — via the import —",
        "-- every imported set.mm theorem against the joined spec.",
        coverage,
        "-- theory source: mm0/metamath/set.mm0",
        "",
    ]

    pairs: list[tuple[str, str]] = []

    def add(m0: str, m1: str | None = None):
        pairs.append((m0, m0 if m1 is None else m1))

    for line in header:
        add(line)
    import_idx = len(pairs)
    add(f'import "{SPEC_IMPORT}";', f'import "{PROOF_IMPORT}";')
    add("delimiter $ ( $ $ ) $;")
    add(f"axiom {decl_name} (s: class):")
    add(f"  {math};")

    mm0_lines = [a for a, _ in pairs]
    mm1_lines = [b for _, b in pairs]
    diff = [i for i, (a, b) in enumerate(zip(mm0_lines, mm1_lines)) if a != b]
    if len(mm0_lines) != len(mm1_lines) or diff != [import_idx]:
        raise TranspileError(
            f"{stem}: spec/proof divergence outside the import line: {diff}")
    return "\n".join(mm0_lines) + "\n", "\n".join(mm1_lines) + "\n"


def generate() -> list[tuple[str, str, str]]:
    """Generate every configured source: [(stem, mm0, mm1), …]."""
    return ([(src["stem"], *generate_source(src)) for src in SOURCES]
            + [(src["stem"], *generate_statement(src)) for src in STATEMENTS])


def header_prepend(header, cic_lines, lines) -> list[str]:
    """No-op kept for symmetry: header and cic are already inside `lines`."""
    del header, cic_lines
    return lines


# ── modes ────────────────────────────────────────────────────────────────

def write(results: list[tuple[str, str, str]]) -> None:
    OUT_DIR.mkdir(parents=True, exist_ok=True)
    for stem, mm0, mm1 in results:
        out0, out1 = out_paths(stem)
        out0.write_text(mm0)
        out1.write_text(mm1)
        print(f"lean2mm0: wrote {out0.relative_to(WS)} ({len(mm0.splitlines())} lines)")
        print(f"lean2mm0: wrote {out1.relative_to(WS)} ({len(mm1.splitlines())} lines)")


def check_drift(results: list[tuple[str, str, str]]) -> None:
    for stem, mm0, mm1 in results:
        for path, fresh in zip(out_paths(stem), (mm0, mm1)):
            if not path.exists():
                raise TranspileError(f"{path.relative_to(WS)} missing — run scripts/lean2mm0")
            if path.read_text() != fresh:
                raise TranspileError(f"{path.relative_to(WS)} is out of date — "
                                     "run scripts/lean2mm0 and commit the result")
    print("lean2mm0 check: OK — generated MM0/MM1 in sync with the pinned exports")


def selftest() -> None:
    """Exercise both trust anchors by mutation (docs/lean4mm0.md §9.3).

    The certificate that a `grounded` definition is honest rests on two paths
    agreeing: the Lean-side evaluator, and the net encoding's own reduction.
    A cross-check that never fires is indistinguishable from one that cannot,
    so each path is tampered with in turn and the emitter must refuse. The
    unmutated run is asserted clean in the same pass, and against the
    committed artifacts, so the mutation is applied to input the emitter has
    already been shown to accept.
    """
    clean = generate()
    check_drift(clean)
    print("lean2mm0 selftest: unmutated generation is clean and matches the "
          "committed artifacts")
    expect = {
        "kernel": "Lean-side evaluation is",
        "net": "net reduction is",
    }
    for tamper, needle in expect.items():
        for src in SOURCES:
            try:
                generate_source(src, tamper=tamper)
            except TranspileError as e:
                if needle not in str(e):
                    raise TranspileError(
                        f"selftest[{tamper}]/{src['stem']}: refused for the "
                        f"wrong reason: {e}") from e
                print(f"lean2mm0 selftest: {tamper!r} tamper refused "
                      f"({src['stem']}) — {str(e).splitlines()[0][:96]}")
            else:
                raise TranspileError(
                    f"selftest[{tamper}]/{src['stem']}: the emitter accepted a "
                    "tampered certificate — the anchor it rests on is not "
                    "firing")
    expect_stmt = {
        "bound": "seven-eighths",
        "shape": "structure",
    }
    for tamper, needle in expect_stmt.items():
        for src in STATEMENTS:
            try:
                generate_statement(src, tamper=tamper)
            except TranspileError as e:
                if needle not in str(e):
                    raise TranspileError(
                        f"selftest[{tamper}]/{src['stem']}: refused for the "
                        f"wrong reason: {e}") from e
                print(f"lean2mm0 selftest: {tamper!r} tamper refused "
                      f"({src['stem']}) — {str(e).splitlines()[0][:96]}")
            else:
                raise TranspileError(
                    f"selftest[{tamper}]/{src['stem']}: the emitter accepted a "
                    "tampered statement — the anchor it rests on is not firing")
    print("lean2mm0 selftest: OK — all four anchors refuse tampered input "
          "(kernel rfl, evaluator vs net, statement shape, seven-eighths bound)")


def statement_stems() -> set[str]:
    return {s["stem"] for s in STATEMENTS}


def ground_setmm_labels() -> None:
    """Anchor 3 — the pinned label contract against metamath/set.mm0."""
    declared: dict[str, str] = {}
    with SET_MM0.open(encoding="utf-8", errors="replace") as f:
        for line in f:
            # `term NAME: sort;` or `term NAME (params): sort;` — the
            # param list is greedy to its single closing paren, which keeps
            # the sort after `): ` out of the group.
            m = re.match(r"^\s*term (\w+)(?: \(.*\))?: (\w+);$",
                         line.rstrip("\n"))
            if m:
                declared[m.group(1)] = m.group(2)
    for label, sort in SETMM_LABELS.items():
        if label not in declared:
            raise TranspileError(
                f"set.mm0 does not declare {label!r} — the statement's label "
                "contract has drifted from the imported theory")
        if declared[label] != sort:
            raise TranspileError(
                f"set.mm0 declares {label!r} as {declared[label]}, the "
                f"contract expects {sort}")
    print(f"lean2mm0 verify: label contract grounded — all "
          f"{len(SETMM_LABELS)} set.mm0 labels exist with the expected sorts")


def verify_statement(stem: str, mm0: str, mm1: str) -> None:
    """compile → join → mm0-c for a statement artifact that imports set.mm.

    Same three gates as the certificate path, but the streams are files
    under a tempdir whose `metamath/` symlink lets `import` resolve, and
    mm0-c is fed the *joined* spec (set.mm0 inlined) so the root of trust
    re-verifies every imported set.mm proof alongside the new axiom.
    """
    with tempfile.TemporaryDirectory(prefix="lean2mm0.stmt.") as td:
        t = Path(td)
        (t / f"{stem}.mm0").write_text(mm0)
        (t / f"{stem}.mm1").write_text(mm1)
        (t / "metamath").symlink_to(METAMATH, target_is_directory=True)
        c = subprocess.run(["mm0-rs", "compile", str(t / f"{stem}.mm1"),
                            str(t / f"{stem}.mmb")],
                           capture_output=True, text=True)
        out = c.stdout + c.stderr
        if c.returncode != 0 or "warning" in out.lower():
            sys.stderr.write(out)
            raise TranspileError(
                f"mm0-rs compile failed for {stem} (or emitted warnings — "
                "a warning is a proof hole here)")
        tail = [l for l in out.splitlines()
                if l and not l.startswith(("elab ", "elabbed"))]
        print(f"lean2mm0 verify: mm0-rs compile OK ({stem}) — "
              f"{tail[-1] if tail else 'ok'}")
        j = subprocess.run(["mm0-rs", "join", str(t / f"{stem}.mm0")],
                           capture_output=True, text=True)
        if j.returncode != 0 or not j.stdout:
            sys.stderr.write(j.stdout + j.stderr)
            raise TranspileError(
                f"mm0-rs join failed for {stem} (import resolution)")
        v = subprocess.run(["mm0-c", str(t / f"{stem}.mmb")],
                           input=j.stdout, capture_output=True, text=True)
        if v.returncode != 0:
            sys.stderr.write(v.stdout + v.stderr)
            raise TranspileError(f"mm0-c rejected {stem} (rc={v.returncode})")
        print(f"lean2mm0 verify: mm0-c OK ({stem}) — the root of trust accepts "
              "the axiom and every imported set.mm proof")


def verify(results: list[tuple[str, str, str]]) -> None:
    for tool in ("mm0-rs", "mm0-c"):
        if not shutil.which(tool):
            print(f"lean2mm0 verify: {tool} not on PATH (toolchain not provisioned; "
                  "see docs/lean4mm0.md §5 for the build steps)", file=sys.stderr)
            raise SystemExit(2)
    check_drift(results)
    selftest()
    stems = statement_stems()
    stmt = [r for r in results if r[0] in stems]
    if stmt:
        missing = [p for p in (SET_MM0, SET_MMU) if not p.exists()]
        if missing:
            # The imported theory is untracked toolchain state (set.mmu is
            # 548 MB — it cannot be committed). Its absence must not fail a
            # gate that cannot see it, and must never look like a pass
            # either: it prints the gap *and* the provision commands, the
            # same idiom scripts/verify-invariants uses for a missing
            # toolchain.
            rel = ", ".join(str(p.relative_to(WS)) for p in missing)
            print(f"lean2mm0 verify: [gap] statement stems NOT verified — {rel} "
                  "absent (untracked toolchain state, not committed)")
            print("  provision: mm0-from-mm from-mm mm0/metamath/set.mm "
                  "-o mm0/metamath/set.mm0 mm0/metamath/set.mmu")
            print("  then:      sed -i 's/^(pub //' mm0/metamath/set.mmu")
        else:
            ground_setmm_labels()
            for stem, mm0, mm1 in stmt:
                verify_statement(stem, mm0, mm1)
    for stem, mm0, mm1 in results:
        if stem in stems:
            continue
        with tempfile.TemporaryDirectory(prefix="lean2mm0.") as td:
            t = Path(td)
            (t / f"{stem}.mm0").write_text(mm0)
            (t / f"{stem}.mm1").write_text(mm1)
            c = subprocess.run(["mm0-rs", "compile", str(t / f"{stem}.mm1"),
                                str(t / f"{stem}.mmb")],
                               capture_output=True, text=True)
            out = c.stdout + c.stderr
            if c.returncode != 0 or "warning" in out.lower():
                sys.stderr.write(out)
                raise TranspileError(
                    f"mm0-rs compile failed for {stem} (or emitted warnings — "
                    "a warning is a proof hole here)")
            print(f"lean2mm0 verify: mm0-rs compile OK ({stem}) — "
                  f"{[l for l in out.splitlines() if l and not l.startswith(('elab ', 'elabbed'))][-1]}")
            v = subprocess.run(["mm0-c", str(t / f"{stem}.mmb")],
                               input=mm0, capture_output=True, text=True)
            if v.returncode != 0:
                sys.stderr.write(v.stdout + v.stderr)
                raise TranspileError(f"mm0-c rejected {stem} (rc={v.returncode})")
            print(f"lean2mm0 verify: mm0-c OK ({stem}) — the root of trust accepts the proofs")


def main(argv: list[str]) -> int:
    # The evaluator recurses once per constructor (Layout's grid image is a
    # 1024-element list): deepen Python's limit before generating.
    sys.setrecursionlimit(max(sys.getrecursionlimit(), 200_000))
    mode = argv[1] if len(argv) > 1 else "generate"
    mode = mode.lstrip("-")
    if mode not in ("generate", "check", "verify", "selftest"):
        print(__doc__, file=sys.stderr)
        return 1
    try:
        if mode == "selftest":
            selftest()
            return 0
        results = generate()
        if mode == "generate":
            write(results)
        elif mode == "check":
            check_drift(results)
        else:
            verify(results)
    except TranspileError as e:
        print(f"lean2mm0: ERROR: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

SET_MMU = METAMATH / "set.mmu"
SPEC_IMPORT = "metamath/set.mm0"
PROOF_IMPORT = "metamath/set.mmu"

# The set.mm labels a statement artifact may name, with the sort set.mm
# declares them at — a pinned contract with the imported theory. `verify`
# grounds every entry against metamath/set.mm0 (existence + sort) when the
# theory is provisioned; if the contract is wrong the compile fails anyway,
# but this says *which* label drifted. (0's label is cc0, not c0 — c0 is the
# empty set.) The binder `s` and the `>` hypothesis separator are grammar,
# not labels.
SETMM_LABELS: dict[str, str] = {

# One entry per *statement* artifact — the statement-of-record layer over
# set.mm (docs/lean4mm0.md §11). Unlike SOURCES (certificates over cic.mm0,
# theory embedded verbatim), the emitted decl is the quasi-Riemann statement
# itself: one axiom whose math lives in set.mm's own notation, over a theory
# that comes in through `import` — spec side metamath/set.mm0, proof side
# metamath/set.mmu (mm0-rs reads imported proofs from an imported .mm1/.mmu,
# never from a spec — that is why the two files import different things).
# Nothing here is proven by this pipeline: the truth of the statement is the
# proof of record cited in the artifact header; what mm0-c checks is the
# axiom's well-formedness and every imported set.mm proof.
STATEMENTS: list[dict] = [
    {

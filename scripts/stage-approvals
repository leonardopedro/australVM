#!/usr/bin/env bash
# Stage the pending statement approvals *outside* the repository and print the
# diff an owner would be committing.
#
# An approval is an owner commit that touches only `mm0/approved/`; nothing here
# may write that directory, and `mm0-comparator approve` knows how to write
# somewhere else (`--approved-root`). So the whole content of "approving" is the
# diff, and the diff is what this prints: for each artifact, the canonical
# `.stmts` file that would land, with its closure and statement digests, as
# `git diff --no-index` output against nothing (a first approval) or against the
# currently approved copy (a re-approval, where the diff is the change an owner
# has to read).
#
#   scripts/stage-approvals                 # the four pending artifacts
#   scripts/stage-approvals isa slot_layout # named artifacts (stem or path)
#   scripts/stage-approvals --stat-only     # just the sizes
#   scripts/stage-approvals --root DIR      # where to stage (default: $TMPDIR)
#   scripts/stage-approvals --approved-root DIR
#                                           # approved copies to diff against
#                                           # (default: mm0/approved, read-only)
#
# Exit status: 0 printed, 2 cannot run here (no python3 for the comparator),
# 1 the comparator refused an artifact or an artifact has nothing to approve,
# 64 a usage error (an unknown artifact name, a bad --root). A name that is not
# `mm0/<stem>.mm0` is refused before anything is staged: it used to reach the
# comparator, which answered "refused <name>" — the message for a real refusal,
# so a typo read like a stale artifact. An artifact whose staged copy is
# byte-identical to the approved one is "nothing to approve": the diff would be
# empty, and an empty diff printed under a `== <artifact>` heading reads like a
# successful approval of nothing. Nothing in the repository is modified; the
# staged copies live under the scratch root and are meant to be thrown away.

set -uo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
repo_root="$(cd "$here/.." && pwd)"
comparator="$here/mm0-comparator"

pending=(isa slot_layout store_projection store_projection_toy)

root="${TMPDIR:-/tmp}/australvm-approve-staging"
approved_root="$repo_root/mm0/approved"
stat_only=false
artifacts=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        --root) shift; root="${1:-}"; [ -n "$root" ] || { echo "stage-approvals: --root needs a directory" >&2; exit 64; } ;;
        --approved-root) shift; approved_root="${1:-}"; [ -n "$approved_root" ] || { echo "stage-approvals: --approved-root needs a directory" >&2; exit 64; } ;;
        --stat-only) stat_only=true ;;
        -h|--help) sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) echo "stage-approvals: unknown option $1" >&2; exit 64 ;;
        *) artifacts+=("$1") ;;
    esac
    shift
done
[ "${#artifacts[@]}" -gt 0 ] || artifacts=("${pending[@]}")

# Accept a path as well as a stem (`mm0/isa.mm0` and `isa` are the same
# artifact): the comparator keys on the stem, and a mistyped path used to reach
# it as a relative path under the scratch root and fail with `No such file or
# directory` — a refusal that reads like a stale artifact rather than a typo.
for _i in "${!artifacts[@]}"; do
    _a="${artifacts[$_i]}"
    _a="${_a#./}"
    _a="${_a#mm0/}"
    _a="${_a%.mm0}"
    case "$_a" in
        */*|"") echo "stage-approvals: not an artifact: '${artifacts[$_i]}' (want a stem or mm0/<stem>.mm0)" >&2; exit 64 ;;
    esac
    if [ ! -f "$repo_root/mm0/$_a.mm0" ]; then
        echo "stage-approvals: no such artifact: '$_a' — mm0/$_a.mm0 does not exist." >&2
        echo "stage-approvals: known artifacts: $(cd "$repo_root/mm0" && ls *.mm0 2>/dev/null | sed 's/\.mm0$//' | tr '\n' ' ')" >&2
        echo "stage-approvals: nothing staged (a name the comparator would have refused is a usage error, not a refusal)" >&2
        exit 64
    fi
    artifacts[$_i]="$_a"
done

if ! command -v python3 >/dev/null 2>&1; then
    echo "stage-approvals: python3 not on PATH — cannot run the comparator here" >&2
    exit 2
fi

mkdir -p "$root" || exit 1
staged=0
failed=0
unchanged=0
for artifact in "${artifacts[@]}"; do
    echo "== $artifact"
    if ! python3 "$comparator" approve --approved-root "$root" "$artifact" >"$root/$artifact.log" 2>&1; then
        sed -n '1,5p' "$root/$artifact.log" >&2
        echo "stage-approvals: the comparator refused $artifact" >&2
        failed=$((failed + 1))
        continue
    fi
    file="$root/$artifact.stmts"
    approved="$approved_root/$artifact.stmts"
    if [ -f "$approved" ] && cmp -s "$approved" "$file"; then
        unchanged=$((unchanged + 1))
        echo "   nothing to approve: byte-identical to $approved"
        continue
    fi
    staged=$((staged + 1))
    stmts="$(grep -cE '^(provable sort|sort|delimiter|prefix|term|def|axiom|theorem) ' "$file" || true)"
    echo "   $stmts statement(s), staged at $file"
    sed -n 's/^-- \(closure-sha256\|statements-sha256\): /   \1: /p' "$file"

    if [ "$stat_only" = true ]; then
        if [ -f "$approved" ]; then
            git diff --no-index --stat -- "$approved" "$file" 2>&1 | tail -1
        else
            echo "   $(grep -c . "$file") line(s) would be added (no approved copy to diff against)"
        fi
        continue
    fi

    if [ -f "$approved" ]; then
        git --no-pager diff --no-index --no-color -- "$approved" "$file" || true
    else
        git --no-pager diff --no-index --no-color -- /dev/null "$file" || true
    fi
done

echo
echo "stage-approvals: $staged staged, $failed refused, $unchanged nothing to approve; scratch root $root"
echo "stage-approvals: $approved_root was not touched — the diff above is the decision"
if [ "$failed" -eq 0 ] && [ "$unchanged" -eq 0 ]; then
    exit 0
fi
[ "$unchanged" -eq 0 ] || echo "stage-approvals: an unchanged artifact is already approved as it stands; run again after changing it" >&2
exit 1

#!/usr/bin/env python3
"""PC09: the declared MLIR stage boundary, pinned and stale-evidence-refusing.

What exists, and what this can honestly be
------------------------------------------
`PLAN_proof_chain.md` PC09 asks for captured pre/post IR for every selected pass
of `Austral → KernelIR → MLIR → device IR`, with dialect semantics, legalizations,
canonicalization and target options in the subject identity, and a refusal of
stale evidence when a comparison predicate or a pass option changes.

The emitter exists (`G20a`: `lib/gpu/Gpu_mlir.ml`), and `G19a` pinned a real
MLIR toolchain round trip (`scripts/gpu/mlir-probe`, LLVM 19.1.7) that verifies
and lowers the emitted `clamp.mlir` to `sm_70` PTX. What is still absent is MLIR
*semantics*: no pass-local relation is stated or proved, so the MLIR side is
captured and exercised, not certified. The artifact is therefore a *boundary
record*, not a certificate:

  `mm0/proof_chain/mlir/stage.toml` names the subject (the `clamp` KernelIR that
  PC04 reflects and PC07 composes), pins the options that belong to the subject
  identity, and declares every pass of the intended route with either a measured
  pre/post pair (`captured`) or an explicit `uncaptured` state and why.

`check` re-derives the identity from the artifact the rest of the chain already
trusts: the `-- reflect:` line and `-- ir_sha256=` in
`mm0/proof_chain/clamp_source.mm0`. The record must agree with that file, must
list exactly the route's passes (`DECLARED_PASSES` — the single source of truth,
so an uncaptured optimization cannot disappear by editing the record), and must
match the pinned options (`DECLARED_OPTIONS`). A `captured` row is only accepted
when its pre/post files exist under `mm0/proof_chain/mlir/ir/` and hash to the
recorded digests; a forged `captured` row fails. When `G19a`'s toolchain record
is present, the captured module must also be the file that record verified and
lowered.

Nothing here is a proof, and the modes say so: `capture is not preservation`
stays a `[gap]` while any pass is captured, and every uncaptured pass is counted
in a second one. The record exists so the gap is *specific and enforced*, not
prose — the rows that must become `captured` are named and counted.

Exit: 0 the record is current and the gap is reported; 1 stale or invalid
evidence; 3 not checkable here (missing python3 is handled by the caller).
"""

from __future__ import annotations

import argparse
import hashlib
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
RECORD = ROOT / "mm0/proof_chain/mlir/stage.toml"
TOOLCHAIN = ROOT / "mm0/proof_chain/mlir/toolchain.toml"
SOURCE_ARTIFACT = ROOT / "mm0/proof_chain/clamp_source.mm0"
CAPTURE_DIR = ROOT / "mm0/proof_chain/mlir/ir"
CLAIMS = ROOT / "mm0/mlir_pass.mm0"

#: One stated obligation per captured boundary: the pass name and the record's
#: own two file names. `claims` requires these to agree with `stage.toml` in
#: both directions, so a capture without a statement (or a statement without a
#: capture) is a finding. The endpoints' digests are carried by the `-- cites:`
#: lines, which must be the current content of the files they name.
OBLIGATION = "-- obligation: "

#: Every pass of the declared route, in order. This is the single source of
#: truth: a record that omits one, renames one, or adds one fails, which is how
#: an uncaptured optimization cannot fall out of the chain by editing the record.
#: The pinned pipeline's own passes, in the order it runs them, up to (not
#: including) `convert-gpu-to-nvvm`. The capture reads them as one *segment*:
#: its endpoints are bytes the pipeline really had, its interior is not
#: individually pinned, and the record says so.
NVVM_SEGMENT_PASSES = [
    "convert-nvgpu-to-nvvm",
    "gpu-kernel-outlining",
    "convert-vector-to-scf",
    "convert-scf-to-cf",
    "convert-nvvm-to-llvm",
    "convert-func-to-llvm",
    "expand-strided-metadata",
    "nvvm-attach-target",
    "lower-affine",
    "convert-arith-to-llvm",
    "convert-index-to-llvm",
    "canonicalize",
    "cse",
    "strip-debuginfo",
]

#: The passes after `convert-gpu-to-nvvm`, left uncaptured on purpose: the PTX
#: they produce is pinned by G19a, but capturing them would make the route
#: all-captured, and an all-captured route is a failure here — capture is not
#: preservation, so a chain with no open edge would be claiming more than it
#: has.
NVVM_TAIL_PASSES = [
    "canonicalize",
    "cse",
    "reconcile-unrealized-casts",
    "gpu-to-llvm",
    "gpu-module-to-binary",
]

DECLARED_PASSES = [
    "kernelir-to-mlir",
    "mlir-canonicalize",
    "mlir-lower-to-nvvm-input",
    "convert-gpu-to-nvvm",
    "nvvm-to-ptx",
]

#: The target options that are part of the subject identity (PC09's "dialect
#: semantics, legalizations, canonicalization and target options"). Pinned here
#: for the same reason as the passes: the record may not quietly restate them.
DECLARED_OPTIONS = {
    "numeric_profile": "u32-modular-v1",
    "extents": "static",
    "fast_math": "forbidden",
    "fusion": "forbidden",
    "shared_memory": "forbidden",
    "target": "mlir-gpu-dialect (no native lowering declared)",
}


def fail(message: str, detail: str = "") -> None:
    print(f"[FAIL] PC09: {message}" + (f": {detail}" if detail else ""))
    exit_code[0] = 1


def gap(message: str) -> None:
    print(f"[gap] PC09: {message}")


exit_code = [0]


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def source_identity(artifact: Path) -> dict:
    """The pre-MLIR identity, read from the artifact the chain already trusts."""
    text = artifact.read_text()
    reflect = re.search(r"^-- reflect: (.+)$", text, re.M)
    digest = re.search(r"^-- ir_sha256=([0-9a-f]{64})$", text, re.M)
    if not reflect or not digest:
        raise ValueError(f"{artifact} carries no reflect line / ir_sha256")
    fields = dict(part.split("=", 1) for part in reflect.group(1).split(" "))
    return {"fields": fields, "ir_sha256": digest.group(1)}


def read_record(path: Path) -> dict:
    import tomllib

    data = tomllib.loads(path.read_text())
    return {
        "subject": data["subject"],
        "passes": data.get("pass", []),
        "options": data.get("option", []),
    }


def check(record_path: Path, artifact: Path) -> int:
    try:
        record = read_record(record_path)
    except Exception as exc:  # noqa: BLE001 - any parse error is the finding
        fail("the stage record parses", f"{record_path}: {exc}")
        return exit_code[0]
    try:
        ident = source_identity(artifact)
    except Exception as exc:  # noqa: BLE001
        fail("the pre-MLIR identity is readable", str(exc))
        return exit_code[0]

    subject = record["subject"]

    # (1) the subject is the KernelIR the chain already pins, not a restatement.
    if subject.get("kernel_ir_sha256") != ident["ir_sha256"]:
        fail("the record pins the KernelIR that PC04 reflects",
             f"record says {subject.get('kernel_ir_sha256')!r}, "
             f"{artifact.name} says {ident['ir_sha256']!r}")
    if subject.get("comparison") != ident["fields"].get("comparison"):
        fail("the record's comparison predicate is the reflected one",
             f"record says {subject.get('comparison')!r}, the reflection says "
             f"{ident['fields'].get('comparison')!r}")
    if subject.get("entry") != ident["fields"].get("entry"):
        fail("the record's entry is the reflected one",
             f"record {subject.get('entry')!r} vs "
             f"{ident['fields'].get('entry')!r}")

    # (2) the options are exactly the declared identity inputs.
    options = {}
    for row in record["options"]:
        if set(row) != {"name", "value"}:
            fail("every option row is (name, value)", f"{row}")
            continue
        if row["name"] in options:
            fail("no option is declared twice", row["name"])
        options[row["name"]] = row["value"]
    for name, value in DECLARED_OPTIONS.items():
        if options.get(name) != value:
            fail("the record declares the pinned target options",
                 f"{name}: record {options.get(name)!r}, pinned {value!r}")
    for name in options:
        if name not in DECLARED_OPTIONS:
            fail("the record declares no unknown option", name)

    # (3) every declared pass is present once, and its state is honest.
    declared = [p["name"] for p in record["passes"]]
    if declared != DECLARED_PASSES:
        fail("the record lists exactly the declared route",
             f"record {declared}, declared {DECLARED_PASSES}")
    captured = 0
    seen = set()
    for row in record["passes"]:
        name = row.get("name")
        if name in seen:
            fail("no pass is declared twice", str(name))
        seen.add(name)
        state = row.get("state")
        if state == "captured":
            captured += 1
            sides = (("pre", "the input the pass consumed"),
                     ("post", "the IR the pass emitted"))
            for side, what in sides:
                digest = str(row.get(side + "_sha256", ""))
                if not re.fullmatch(r"[0-9a-f]{64}", digest):
                    fail("a captured pass records both sides' digests",
                         f"{name}: {side}_sha256 is not a sha256")
                if not row.get(side + "_file"):
                    fail("a captured pass names both IR files",
                         f"{name}: {side}_file is missing — {what} must be "
                         "a file this tree can re-read")
                path = CAPTURE_DIR / str(row[side + "_file"])
                if not path.exists():
                    fail("a captured pass's IR files exist",
                         f"{name}: {path.relative_to(ROOT)} is missing — {what} "
                         "is not capturable without the artifact")
                elif sha256(path.read_bytes()) != digest:
                    fail("a captured pass's IR hashes to its recorded digest",
                         f"{name}: {path.relative_to(ROOT)} does not hash to "
                         f"its {side}_sha256")
        elif state == "uncaptured":
            if not row.get("detail"):
                fail("an uncaptured pass says what is missing", str(name))
        else:
            fail("a pass is either captured or explicitly uncaptured",
                 f"{name}: state {state!r}")
    if subject.get("captured_passes") != captured:
        fail("the subject's captured count matches its pass rows",
             f"says {subject.get('captured_passes')!r}, found {captured}")

    # (3b) a captured pass starts from its predecessor's output: the digest
    # chain is what keeps two blocks that each hash correctly from describing
    # different routes. An uncaptured pass breaks the chain (its output is not
    # in hand), so chaining resumes only across adjacent captured rows.
    prev = None
    for row in record["passes"]:
        if row.get("state") != "captured":
            prev = None
            continue
        if prev is not None and (row.get("pre_file") != prev.get("post_file")
                                 or row.get("pre_sha256") != prev.get("post_sha256")):
            fail("a captured pass consumes its predecessor's output",
                 f"{row['name']} does not start from {prev['name']}'s post IR")
        prev = row

    # (4) the captured post artifact is the one G19a verified and lowered. The
    #     toolchain record is G19a's; this is the link between the two cards, so
    #     "captured" here means the bytes a pinned toolchain accepted, not just
    #     bytes on disk.
    if TOOLCHAIN.exists():
        import tomllib

        tool = tomllib.loads(TOOLCHAIN.read_text())
        subjects = {row["stem"]: row for row in tool.get("subject", [])}
        row = subjects.get("clamp")
        if row is None:
            gap("the toolchain record does not cover the clamp module")
        else:
            post = CAPTURE_DIR / "clamp.mlir"
            if post.exists() and row.get("source_sha256") != sha256(post.read_bytes()):
                fail("the verified/lowered module is the captured one",
                     "stage.toml's clamp.mlir is not the file G19a recorded")
            ptx = ROOT / row.get("ptx", "")
            if not ptx.exists():
                fail("the recorded PTX still exists", row.get("ptx", ""))
            elif sha256(ptx.read_bytes()) != row.get("ptx_sha256"):
                fail("the recorded PTX hashes to its digest", row.get("ptx", ""))
            else:
                print(f"  [detail] PC09 toolchain: clamp.mlir is the module G19a "
                      f"verified and lowered to {row.get('ptx_target')} "
                      f"({row.get('params')} param(s))")
    else:
        gap("no G19a toolchain record: the captured module is not attested as "
            "verified or lowered by a pinned toolchain")

    uncaptured = len(DECLARED_PASSES) - captured
    print(f"  [detail] PC09 stage: kernelir {ident['ir_sha256'][:12]}…, "
          f"{len(DECLARED_PASSES)} declared pass(es), {captured} captured, "
          f"{uncaptured} uncaptured")
    for row in record["passes"]:
        print(f"  [detail] PC09 pass {row['name']}: {row.get('state')}")
    if captured:
        gap(f"{captured} pass(es) captured, but capture is not preservation: "
            "no MLIR semantics is available, so no pass-local relation is "
            "proved and the chain is cut after the captured IR")
    if uncaptured:
        gap("the route is declared and pinned, so the uncaptured passes are "
            "listed rather than assumed; the edge to a device IR is open")
    else:
        fail("an all-captured record still needs its pass proofs",
             "capture is not a preservation proof (see PC09's acceptance)")
    print("[pass] PC09: the declared MLIR stage boundary is current and its "
          "uncaptured passes are counted")
    return exit_code[0]


def parse_claims(path: Path):
    """The obligations and citations an MM0 claims artifact declares."""
    obligations = []
    cites = []
    for lineno, line in enumerate(path.read_text().splitlines(), 1):
        if line.startswith(OBLIGATION):
            row = {"line": lineno}
            for field in line[len(OBLIGATION):].split():
                if "=" not in field:
                    row["name"] = field
                else:
                    key, value = field.split("=", 1)
                    row[key] = value
            obligations.append(row)
        elif line.startswith("-- cites: "):
            m = re.fullmatch(r"-- cites: (\S+) sha256=([0-9a-f]{64})", line)
            if not m:
                raise ValueError(f"{path.name}:{lineno}: malformed citation {line!r}")
            cites.append((m.group(1), m.group(2)))
    return obligations, cites


def claims(claims_path: Path, record_path: Path) -> int:
    """PC09's boundary obligations: stated once per capture, and current.

    This decides nothing about MLIR semantics — it decides that the statements
    exist and are about the bytes the record now holds. It refuses:
      * an obligation with missing fields or a duplicate name;
      * an obligation whose pass the record does not capture, and a captured
        pass with no obligation;
      * an obligation whose endpoints are not that pass's recorded files;
      * a citation whose digest is not the file's current content, and a
        boundary endpoint the artifact never cites;
      * an `axiom` or a `theorem` in the artifact (a stated claim is not an
        admitted one), and a missing `-- certificate: [gap]` marker.
    """
    try:
        obligations, cites = parse_claims(claims_path)
    except Exception as exc:  # noqa: BLE001 - any parse error is the finding
        fail("the claims artifact parses", f"{claims_path.name}: {exc}")
        return exit_code[0]
    try:
        record = read_record(record_path)
    except Exception as exc:  # noqa: BLE001
        fail("the stage record parses for the claim check", f"{record_path}: {exc}")
        return exit_code[0]

    text = claims_path.read_text()
    for lineno, line in enumerate(text.splitlines(), 1):
        if line.startswith(("axiom ", "theorem ")):
            fail("the claims artifact admits nothing",
                 f"{claims_path.name}:{lineno}: {line.split()[0]} — a stated "
                 "obligation is not an admitted one")
    if "-- certificate: [gap]" not in text:
        fail("the claims artifact says its certificate is a gap")

    captured = {row["name"]: row for row in record["passes"]
                if row.get("state") == "captured"}
    stated = {}
    for row in obligations:
        name = row.get("name")
        if not name or "pre" not in row or "post" not in row:
            fail("an obligation names its pass and both endpoints",
                 f"{claims_path.name}:{row['line']}")
            continue
        if name in stated:
            fail("no pass is stated twice", name)
        stated[name] = row

    for name in stated:
        if name not in captured:
            fail("every stated obligation is about a captured pass",
                 f"{name} is not captured in {record_path.name}")
    for name, row in captured.items():
        if name not in stated:
            fail("every captured pass has a stated obligation",
                 f"{name} is captured but not stated in {claims_path.name}")
        else:
            for side in ("pre", "post"):
                if stated[name].get(side) != row.get(side + "_file"):
                    fail("an obligation's endpoint is the record's file",
                         f"{name}: {side} {stated[name].get(side)!r} vs "
                         f"record {row.get(side + '_file')!r}")

    cited = {}
    for rel, digest in cites:
        path = ROOT / rel
        if not path.exists():
            fail("a cited file exists", rel)
            continue
        if sha256(path.read_bytes()) != digest:
            fail("a cited file hashes to its digest", rel)
        cited[rel] = digest
    wanted = {str(record_path.relative_to(ROOT))}
    for row in captured.values():
        for side in ("pre", "post"):
            wanted.add(str((CAPTURE_DIR / str(row.get(side + "_file")))
                           .relative_to(ROOT)))
    for rel in sorted(wanted - set(cited)):
        fail("every boundary endpoint is cited", rel)

    print(f"  [detail] PC09 claims: {len(stated)} obligation(s) over "
          f"{len(captured)} captured pass(es), {len(cited)} citation(s) current")
    for row in obligations:
        print(f"  [detail] PC09 obligation {row.get('name')}: "
              f"{row.get('pre')} → {row.get('post')}")
    if stated:
        gap(f"{len(stated)} pass-boundary obligation(s) stated and cited, none "
            "proved: no MLIR dialect semantics exists in this repository")
    print("[pass] PC09: every captured boundary has a stated obligation and no "
          "obligation outlives its capture")
    return exit_code[0]


def mlir_opt() -> str | None:
    """The `mlir-opt` the G19a record (or PATH) names, if this host has one."""
    import shutil
    import tomllib

    if TOOLCHAIN.exists():
        tool = tomllib.loads(TOOLCHAIN.read_text())
        for row in tool.get("tool", []):
            if row.get("name") == "mlir-opt" and Path(row.get("path", "")).exists():
                return row["path"]
    return shutil.which("mlir-opt")


def capture_canonicalize(record_path: Path) -> int:
    """Run the pinned canonicalizer on the captured module and record both sides.

    The pre side is the `kernelir-to-mlir` post artifact (the record's digest
    must still name it), the post side is `mlir-opt --canonicalize` output.
    Both are pinned, so `check` re-reads exactly the bytes the pass claims.
    This is capture, not preservation: no MLIR semantics exists here.
    """
    tool = mlir_opt()
    if tool is None:
        gap("the canonicalize pass was not captured: no mlir-opt on this host")
        return 3
    record = read_record(record_path)
    first = next((p for p in record["passes"]
                  if p.get("name") == "kernelir-to-mlir"), None)
    if first is None or first.get("state") != "captured":
        fail("the canonicalize pass starts from a captured kernelir-to-mlir")
        return exit_code[0]
    pre_path = CAPTURE_DIR / str(first.get("post_file", ""))
    if not pre_path.exists() or sha256(pre_path.read_bytes()) != first.get("post_sha256"):
        fail("the kernelir-to-mlir post artifact is the one the record pins",
             str(pre_path))
        return exit_code[0]
    run = subprocess.run([tool, "--canonicalize", str(pre_path)],
                         capture_output=True, text=True)
    if run.returncode != 0:
        fail("mlir-opt --canonicalize accepts the captured module",
             (run.stderr or run.stdout).strip()[:300])
        return exit_code[0]
    post_path = CAPTURE_DIR / "clamp.canonical.mlir"
    post_path.write_text(run.stdout)
    pre_sha = first["post_sha256"]
    post_sha = sha256(post_path.read_bytes())

    text = record_path.read_text()
    block = re.compile(r'\[\[pass\]\]\nname = "mlir-canonicalize"\n'
                       r'(?:[a-z0-9_]+ = .*\n)+', re.M)
    replacement = (
        '[[pass]]\nname = "mlir-canonicalize"\n'
        'state = "captured"\n'
        f'pre_file = "{first["post_file"]}"\npre_sha256 = "{pre_sha}"\n'
        f'post_file = "clamp.canonical.mlir"\npost_sha256 = "{post_sha}"\n'
        'detail = "mlir-opt --canonicalize of the captured module: '
        'captured byte-for-byte, not proved (no MLIR semantics)"\n')
    if not block.search(text):
        fail("the record has an mlir-canonicalize pass row to update")
        return exit_code[0]
    text = block.sub(replacement, text, count=1)
    states = re.findall(r'^state = "(\w+)"$', text, re.M)
    text = re.sub(r'captured_passes = \d+',
                  f'captured_passes = {states.count("captured")}', text, count=1)
    record_path.write_text(text)
    print(f"  [detail] PC09 capture: wrote {post_path.relative_to(ROOT)} "
          f"({len(run.stdout.splitlines())} line(s)) with "
          f"{Path(tool).name}")
    return exit_code[0]


# ── capture-nvvm ───────────────────────────────────────────────────────────


def unescape_assembly(text: str) -> bytes:
    """MLIR prints a `gpu.object` assembly as a quoted string with `\\NN`."""
    out = bytearray()
    i = 0
    while i < len(text):
        if text[i] == "\\" and i + 2 < len(text):
            code = int(text[i + 1:i + 3], 16)
            if code:
                out.append(code)
            i += 3
        else:
            out.append(ord(text[i]))
            i += 1
    return bytes(out)


def captured_row(name: str, pre_file: str, pre_sha: str,
                 post_file: str, post_sha: str, detail: str) -> str:
    return (f'[[pass]]\nname = "{name}"\nstate = "captured"\n'
            f'pre_file = "{pre_file}"\npre_sha256 = "{pre_sha}"\n'
            f'post_file = "{post_file}"\npost_sha256 = "{post_sha}"\n'
            f'detail = "{detail}"\n')


def capture_nvvm(record_path: Path) -> int:
    """Capture `convert-gpu-to-nvvm`'s real pre/post from the pinned pipeline.

    The pair comes from `--mlir-print-ir-before/after=convert-gpu-to-nvvm` in
    one run of the *pinned* pipeline on the captured canonical module, so both
    sides are bytes the pipeline itself had, not a re-derivation. The run's
    `gpu.object` assembly must unescape to the PTX G19a recorded for this
    module, which is what makes this pair that lowering rather than a similarly
    shaped one.

    The passes before this one are captured as a single segment row: its post
    is exactly this pair's pre, so the digest chain is intact, and the row names
    the passes it contains so the interior is visible rather than implied.
    """
    import tomllib

    tool = mlir_opt()
    if tool is None:
        gap("convert-gpu-to-nvvm was not captured: no mlir-opt on this host")
        return 3
    if not TOOLCHAIN.exists():
        gap("convert-gpu-to-nvvm was not captured: no G19a toolchain record")
        return 3
    toolchain = tomllib.loads(TOOLCHAIN.read_text())
    pipeline = toolchain.get("pipeline", {}).get("command")
    if not pipeline:
        fail("the toolchain record names the lowering pipeline")
        return exit_code[0]
    subjects = {row.get("stem"): row for row in toolchain.get("subject", [])}
    recorded = subjects.get("clamp")
    if not recorded:
        fail("the toolchain record covers the clamp module")
        return exit_code[0]
    source = CAPTURE_DIR / "clamp.mlir"
    if not source.exists():
        fail("the captured canonical module exists", str(source))
        return exit_code[0]
    run = subprocess.run(
        [tool, pipeline,
         "--mlir-print-ir-before=convert-gpu-to-nvvm",
         "--mlir-print-ir-after=convert-gpu-to-nvvm",
         str(source)],
        capture_output=True, text=True)
    if run.returncode != 0:
        fail("the pinned pipeline accepts the captured module",
             (run.stderr or run.stdout).strip()[:300])
        return exit_code[0]
    header = re.compile(r'^// -----// IR Dump (Before|After) .*?//----- //\n',
                        re.M)
    parts = header.split(run.stderr)
    labels = parts[1::2]
    bodies = parts[2::2]
    if labels != ["Before", "After"]:
        fail("the pipeline prints exactly one before/after pair for "
             "convert-gpu-to-nvvm",
             f"found dumps {labels}")
        return exit_code[0]
    before, after = bodies[0], bodies[1]
    if not before.strip() or not after.strip():
        fail("both sides of the captured pair carry a module")
        return exit_code[0]
    if "gpu.module" not in before or "gpu.func" not in before:
        fail("the captured pre side still has the gpu module and its kernel",
             before.strip().splitlines()[0][:120] if before.strip() else "empty")
        return exit_code[0]
    if "nvvm.kernel" in before or "llvm.func" in before:
        fail("the captured pre side is before the NVVM conversion, not after it")
        return exit_code[0]

    # The run must be *this* lowering: its embedded PTX is G19a's PTX.
    out = run.stdout
    at = out.rfind('assembly = "')
    if at < 0:
        fail("the pipeline run carries a gpu.object assembly")
        return exit_code[0]
    start = at + len('assembly = "')
    end = out.find('"', start)
    ptx = unescape_assembly(out[start:end])
    ptx_sha = sha256(ptx)
    if ptx_sha != recorded.get("ptx_sha256"):
        fail("the captured run lowered to the PTX G19a recorded",
             f"run hashed {ptx_sha[:12]}…, G19a records "
             f"{str(recorded.get('ptx_sha256'))[:12]}…")
        return exit_code[0]

    CAPTURE_DIR.mkdir(parents=True, exist_ok=True)
    pre_path = CAPTURE_DIR / "clamp.pre-nvvm.mlir"
    post_path = CAPTURE_DIR / "clamp.post-nvvm.mlir"
    pre_path.write_text(before)
    post_path.write_text(after)
    pre_sha = sha256(before.encode())
    post_sha = sha256(after.encode())

    # The two earlier rows stay as they are; the route after them is rewritten
    # from the bytes just captured, so a stale row cannot survive a capture.
    text = record_path.read_text()
    prefix = text.split("[[pass]]", 1)[0]
    rows = re.findall(r'\[\[pass\]\]\n(?:[a-z0-9_]+ = .*\n)+', text)[:2]
    if len(rows) != 2:
        fail("the record still has its two earlier pass rows")
        return exit_code[0]
    second_post = re.search(r'post_file = "([^"]+)"\npost_sha256 = "([0-9a-f]{64})"',
                            rows[1])
    if not second_post:
        fail("the canonicalize row records both sides")
        return exit_code[0]
    segment = captured_row(
        "mlir-lower-to-nvvm-input", second_post.group(1), second_post.group(2),
        "clamp.pre-nvvm.mlir", pre_sha,
        "the pinned pipeline's passes before `convert-gpu-to-nvvm` ("
        + ", ".join(NVVM_SEGMENT_PASSES)
        + "), captured as one segment: its endpoints are real pipeline bytes, "
        "its interior is not individually pinned, and it is not proved")
    convert = captured_row(
        "convert-gpu-to-nvvm", "clamp.pre-nvvm.mlir", pre_sha,
        "clamp.post-nvvm.mlir", post_sha,
        "the pinned pipeline's own pre/post at this pass, read from its "
        "before/after dumps; the run's gpu.object assembly unescapes to the "
        "PTX G19a recorded, so this is that lowering; captured, not proved")
    tail_detail = (", ".join(NVVM_TAIL_PASSES)
                   + " follow; G19a pins the PTX they produce, but these "
                     "passes are not captured and no pass-local relation is "
                     "proved for them or for the pair above")
    tail = (f'[[pass]]\nname = "nvvm-to-ptx"\nstate = "uncaptured"\n'
            f'detail = "{tail_detail}"\n')
    captured = 4
    body = "\n".join([r.rstrip("\n") for r in rows] + [segment, convert, tail])
    prefix = re.sub(r'captured_passes = \d+', f'captured_passes = {captured}',
                    prefix, count=1)
    record_path.write_text(prefix + body + "\n")
    print(f"  [detail] PC09 capture: wrote {pre_path.relative_to(ROOT)} "
          f"({len(before.splitlines())} line(s)) and "
          f"{post_path.relative_to(ROOT)} ({len(after.splitlines())} line(s)); "
          f"the run's PTX is the recorded one")
    return exit_code[0]


# ── capture ──────────────────────────────────────────────────────────────────


FIXTURE = ("examples/gpu/pointwise/Pointwise.aui",
           "examples/gpu/pointwise/Pointwise.aum")


def gpu_binary() -> str:
    import os

    return os.environ.get("GPU_PROOF_BIN") or str(
        ROOT / "_build/default/bin/gpu_proof.exe")


def capture(record_path: Path, extent: int) -> int:
    """Emit the pre/post IR of one pass and record their digests.

    The pre side is the canonical KernelIR text (`dump-ir`), the post side is
    the module `Gpu_mlir.render` produces (`dump-mlir`). Both are written under
    `mm0/proof_chain/mlir/ir/` and pinned in the record, so `check` re-reads
    exactly the bytes the pass record claims. Capture is not preservation: the
    record says so in the row's own `detail`.
    """
    import os
    import subprocess

    binary = gpu_binary()
    if not Path(binary).exists():
        gap(f"the pass was not captured: {binary} is not built "
            "(dune build bin/gpu_proof.exe)")
        return 3
    env = dict(os.environ)
    env["LD_LIBRARY_PATH"] = str(ROOT) + ":" + env.get("LD_LIBRARY_PATH", "")
    aui, aum = (str(ROOT / p) for p in FIXTURE)
    entry = read_record(record_path)["subject"]["entry"]
    pre = subprocess.run([binary, "dump-ir", aui, aum, entry],
                         capture_output=True, text=True, env=env)
    post = subprocess.run([binary, "dump-mlir", aui, aum, entry,
                           "--extent", str(extent)],
                          capture_output=True, text=True, env=env)
    for name, run in (("dump-ir", pre), ("dump-mlir", post)):
        if run.returncode != 0:
            fail(f"{name} failed", (run.stderr or run.stdout).strip()[:300])
            return exit_code[0]
    CAPTURE_DIR.mkdir(parents=True, exist_ok=True)
    pre_path = CAPTURE_DIR / "clamp.kernelir"
    post_path = CAPTURE_DIR / "clamp.mlir"
    pre_path.write_text(pre.stdout)
    post_path.write_text(post.stdout)
    pre_sha, post_sha = (sha256(p.read_bytes()) for p in (pre_path, post_path))

    text = record_path.read_text()
    block = re.compile(
        r'\[\[pass\]\]\nname = "kernelir-to-mlir"\n'
        r'(?:[a-z0-9_]+ = .*\n)+', re.M)
    replacement = (
        '[[pass]]\nname = "kernelir-to-mlir"\n'
        'state = "captured"\n'
        f'pre_file = "clamp.kernelir"\npre_sha256 = "{pre_sha}"\n'
        f'post_file = "clamp.mlir"\npost_sha256 = "{post_sha}"\n'
        'detail = "Gpu_mlir.render ~extent:65 of the reflected KernelIR: '
        'captured byte-for-byte, not proved (no MLIR semantics)"\n')
    if not block.search(text):
        fail("the record has a kernelir-to-mlir pass row to update")
        return exit_code[0]
    text = block.sub(replacement, text, count=1)
    total = len(DECLARED_PASSES)
    text = re.sub(r'captured_passes = \d+', f'captured_passes = {total}',
                  text, count=1)
    # `captured_passes` in the record means "of the declared route": with the
    # emitter in place that is one, not every pass — recompute from the rows.
    states = re.findall(r'^state = "(\w+)"$', text, re.M)
    text = re.sub(r'captured_passes = \d+',
                  f'captured_passes = {states.count("captured")}', text, count=1)
    record_path.write_text(text)
    print(f"  [detail] PC09 capture: wrote {pre_path.relative_to(ROOT)} "
          f"({len(pre.stdout.splitlines())} line(s)) and "
          f"{post_path.relative_to(ROOT)} ({len(post.stdout.splitlines())} line(s))")
    return exit_code[0]


# ── controls ─────────────────────────────────────────────────────────────────


def selftest(record_path: Path, work: Path) -> int:
    """Each control mutates one evidence cell and requires a refusal."""
    record_text = record_path.read_text()
    artifact_text = SOURCE_ARTIFACT.read_text()

    def run(record: str, artifact: str, label: str, needle: str) -> None:
        base = work / "control"
        base.mkdir(exist_ok=True)
        rec = base / "stage.toml"
        art = base / "clamp_source.mm0"
        rec.write_text(record)
        art.write_text(artifact)
        out = subprocess.run([sys.executable, __file__, "check",
                              "--record", str(rec), "--artifact", str(art)],
                             capture_output=True, text=True)
        combined = out.stdout + out.stderr
        if out.returncode != 1 or needle not in combined:
            fail(f"control: {label} is refused",
                 f"exit {out.returncode}, output {combined.strip()[:300]!r}")
        else:
            print(f"  [pass] PC09 control refused: {label}")

    # 1. a changed comparison predicate in the KernelIR the chain reflects.
    run(record_text,
        artifact_text.replace("comparison=GreaterThan", "comparison=LessThan", 1),
        "a changed comparison predicate", "comparison predicate is the reflected one")

    # 2. a changed pass option.
    run(record_text.replace('value = "forbidden"', 'value = "allowed"', 1),
        artifact_text, "a changed pass option", "pinned target options")

    # 3. an uncaptured pass dropped from the route.
    run(re.sub(r'\[\[pass\]\]\nname = "mlir-canonicalize".*?\n\n',
               "", record_text, count=1, flags=re.S),
        artifact_text, "an uncaptured pass dropped", "exactly the declared route")

    # 4. a captured pass whose post artifact is not there to hash.
    forged = re.sub(
        r'(name = "mlir-canonicalize"\n(?:[a-z0-9_]+ = .*\n)*?post_file = )'
        r'"[^"]*"\n(post_sha256 = )"[0-9a-f]{64}"\n',
        r'\1"forged.mlir"\n\2"' + "0" * 64 + '"\n',
        record_text, count=1)
    run(forged, artifact_text, "a forged captured pass", "is missing")

    # 5. a stale KernelIR digest in the record.
    run(re.sub(r'kernel_ir_sha256 = "[0-9a-f]{64}"',
               'kernel_ir_sha256 = "' + "1" * 64 + '"', record_text, count=1),
        artifact_text, "a stale KernelIR digest", "pins the KernelIR that PC04 reflects")

    controls = 5

    # 6. the record's captured count restated (the real value is derived from
    #    the pass rows, so any other number must be refused).
    count = len(re.findall(r'^state = "captured"$', record_text, re.M))
    run(re.sub(r'captured_passes = \d+',
               f'captured_passes = {count + 1}', record_text, count=1),
        artifact_text, "a restated captured count", "captured count matches")
    controls += 1

    # 7. a captured pass that does not start from its predecessor's output:
    #    both sides hash correctly, but they describe different bytes, so the
    #    digest chain must refuse it. Only meaningful once the second pass is
    #    captured; the row carries both sides then.
    if re.search(r'name = "mlir-canonicalize"\nstate = "captured"', record_text):
        first_pre = re.search(
            r'name = "kernelir-to-mlir"\n(?:[a-z0-9_]+ = .*\n)*?'
            r'pre_sha256 = "([0-9a-f]{64})"', record_text)
        unchained = re.sub(
            r'(name = "mlir-canonicalize"\n(?:[a-z0-9_]+ = .*\n)*?)'
            r'pre_file = "[^"]*"\npre_sha256 = "[0-9a-f]{64}"\n',
            r'\1pre_file = "clamp.kernelir"\npre_sha256 = "'
            + first_pre.group(1) + '"\n', record_text, count=1)
        run(unchained, artifact_text,
            "a captured pass not chained to its predecessor",
            "consumes its predecessor's output")
        controls += 1

    if exit_code[0] == 0:
        print(f"[pass] PC09 selftest: {controls} controls behave")
    return exit_code[0]


def claims_selftest(claims_path: Path, record_path: Path, work: Path) -> int:
    """The claims artifact's controls: each mutation of one statement must fail."""
    controls = 0
    claims_text = claims_path.read_text()
    record_text = record_path.read_text()

    def run(claims_mutated: str, label: str, needle: str) -> None:
        nonlocal controls
        base = work / "claims-control"
        base.mkdir(exist_ok=True)
        rec = base / "stage.toml"
        art = base / "mlir_pass.mm0"
        rec.write_text(record_text)
        art.write_text(claims_mutated)
        out = subprocess.run([sys.executable, __file__, "claims",
                              "--claims", str(art), "--record", str(rec)],
                             capture_output=True, text=True)
        combined = out.stdout + out.stderr
        if out.returncode != 1 or needle not in combined:
            fail(f"claims control: {label} is refused",
                 f"exit {out.returncode}, output {combined.strip()[:300]!r}")
        else:
            print(f"  [pass] PC09 claims control refused: {label}")
        controls += 1

    # 1. an obligation whose post endpoint is not the recorded file.
    run(claims_text.replace("pre=clamp.mlir post=clamp.canonical.mlir",
                            "pre=clamp.mlir post=clamp.mlir", 1),
        "an obligation pointing at the wrong endpoint",
        "endpoint is the record's file")

    # 2. a captured pass whose obligation was deleted.
    run(re.sub(r"^-- obligation: mlir-canonicalize .*\n", "", claims_text,
               count=1, flags=re.M),
        "a capture with no stated obligation",
        "captured but not stated")

    # 3. an obligation for a pass the record leaves uncaptured.
    run(claims_text.rstrip("\n")
        + "\n-- obligation: nvvm-to-ptx pre=clamp.post-nvvm.mlir post=clamp.ptx\n",
        "an obligation with no capture", "is not captured")

    # 4. a stale citation digest (the claim would describe other bytes).
    run(re.sub(r"(-- cites: mm0/proof_chain/mlir/ir/clamp\.mlir sha256=)[0-9a-f]{64}",
               r"\g<1>" + "2" * 64, claims_text, count=1),
        "a stale citation", "hashes to its digest")

    # 5. an artifact that admits its own claim as an axiom.
    run(claims_text.rstrip("\n")
        + "\naxiom kernelir_to_mlir_holds: $ kernelir_to_mlir_preserves a b $;\n",
        "an admitted claim", "admits nothing")

    print(f"[pass] PC09 claims control: {controls} control(s) behave")
    return exit_code[0]


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("mode", nargs="?", default="check",
                    choices=["check", "selftest", "capture",
                             "capture-canonicalize", "capture-nvvm", "claims"])
    ap.add_argument("--record", default=str(RECORD))
    ap.add_argument("--artifact", default=str(SOURCE_ARTIFACT))
    ap.add_argument("--claims", default=str(CLAIMS))
    ap.add_argument("--extent", type=int, default=65)
    args = ap.parse_args()
    with tempfile.TemporaryDirectory(prefix="pc09-") as tmp:
        if args.mode == "selftest":
            rc = selftest(Path(args.record), Path(tmp))
            if rc == 0:
                rc = claims_selftest(Path(args.claims), Path(args.record), Path(tmp))
            return rc
        if args.mode == "claims":
            return claims(Path(args.claims), Path(args.record))
        if args.mode == "capture":
            return capture(Path(args.record), args.extent)
        if args.mode == "capture-canonicalize":
            return capture_canonicalize(Path(args.record))
        if args.mode == "capture-nvvm":
            return capture_nvvm(Path(args.record))
        return check(Path(args.record), Path(args.artifact))


if __name__ == "__main__":
    sys.exit(main())

-- distributed.mm0 — the D20 finite request-lifecycle theory.
--
-- The certificate is about one finite trace, not all runs. A trace is a word
-- over the bounded event alphabet below; a proof is one `run_cons` per event,
-- so mm0-c re-checks each transition instead of trusting the emitter.
--
-- The state carries the request identity (request id, payload digest, epoch).
-- A matching response is an event with the same three values, and the
-- durability boundary is a state transition: accept/reject are only reachable
-- from `st_durable`, never directly from `st_pending`. The theory therefore
-- rejects:
--
--   * a response with a changed request id, payload digest or epoch;
--   * a response before the persistence boundary;
--   * an event order that never reaches the response state;
--   * a trace that ends with an unreleased receipt.
--
-- This is a finite trace certificate (D20), not an all-run safety proof. The
-- consensus engine and the D17 authority remain assumptions outside this file.

provable sort Prop;

sort nat;                       -- request id, payload digest, epoch
sort St;                        -- lifecycle state
sort Ev;                        -- one request event
sort L;                         -- a finite trace

delimiter $ ( ) $;

-- ── States ───────────────────────────────────────────────────────────────

term st_idle: St;
term st_pending (request: nat) (digest: nat) (epoch: nat): St;
term st_durable (request: nat) (digest: nat) (epoch: nat): St;
term st_applied (request: nat) (digest: nat) (epoch: nat): St;
term st_rejected (request: nat) (digest: nat) (epoch: nat): St;

-- ── Events ───────────────────────────────────────────────────────────────

term e_open (request: nat) (digest: nat) (epoch: nat): Ev;
term e_submit: Ev;
term e_persist: Ev;
term e_accept (request: nat) (digest: nat) (epoch: nat): Ev;
term e_reject (request: nat) (digest: nat) (epoch: nat): Ev;
term e_release: Ev;

-- ── The transition relation ──────────────────────────────────────────────
-- One axiom per edge. There is deliberately no `st_pending -> e_accept` or
-- `st_pending -> e_reject`: a response before persistence has no rule.

term trans (s: St) (e: Ev) (s2: St): Prop;

axiom t_open (request digest epoch: nat):
  $ trans st_idle (e_open request digest epoch) (st_pending request digest epoch) $;

axiom t_submit (request digest epoch: nat):
  $ trans (st_pending request digest epoch) e_submit (st_pending request digest epoch) $;

axiom t_persist (request digest epoch: nat):
  $ trans (st_pending request digest epoch) e_persist (st_durable request digest epoch) $;

axiom t_accept (request digest epoch: nat):
  $ trans (st_durable request digest epoch) (e_accept request digest epoch)
      (st_applied request digest epoch) $;

axiom t_reject (request digest epoch: nat):
  $ trans (st_durable request digest epoch) (e_reject request digest epoch)
      (st_rejected request digest epoch) $;

axiom t_release_applied (request digest epoch: nat):
  $ trans (st_applied request digest epoch) e_release st_idle $;

axiom t_release_rejected (request digest epoch: nat):
  $ trans (st_rejected request digest epoch) e_release st_idle $;

-- ── Traces and runs ──────────────────────────────────────────────────────

term tl_nil: L;
term tl_cons (e: Ev) (l: L): L;

term run (l: L) (s: St) (s2: St): Prop;

axiom run_nil (s: St): $ run tl_nil s s $;

axiom run_cons (e: Ev) (l: L) (s: St) (s2: St) (s3: St):
  $ trans s e s2 $ > $ run l s2 s3 $ > $ run (tl_cons e l) s s3 $;

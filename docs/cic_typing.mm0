-- cic_typing.mm0 — the typing and conversion extension of docs/cic.mm0.
--
-- cic.mm0 gives the *term language* of the pipeline (the deltanet agent
-- signature) and judgmental equality `teq`. It has no typing judgment, so a
-- statement emitted for it can record what a declaration *is*, never that a
-- proof term *has* the declared type. This file adds exactly that judgment and
-- the rules a Lean-to-MM0 proof translator needs to build derivations with it.
--
-- Scope, stated rather than implied:
--
--  * This is the first-order, untyped spine of the λΠ fragment: `tpi` (a
--    binder), `tabs`, `tapp`, a context spine of types, and conversion. It is
--    *not* a CIC checker: universes are not stratified, inductive families and
--    recursors have no eliminators, and `tdefeq` is a relation supplied by
--    premises, not decided here.
--  * `tdefeq` is a *definition*: it is `teq` of cic.mm0, so it is never
--    decided here — the decision procedure in this project is the deltanet
--    reducer, and two types are convertible when their nets are isomorphic
--    (`valid_iso` in cic.mm0). `tdefeq_iso` is the bridge to that certificate,
--    and it is a theorem rather than an axiom (it *is* `net_isomorphism_step`).
--    A translator therefore discharges conversion by *emitting a witness*, not
--    by trusting a solver. Likewise `tctx_deq` is `teq` on the context spine.
--
-- Five axioms are the imported `teq` rules at these definitions and are gone:
-- `tdefeq_refl`, `tdefeq_symm`, `tdefeq_trans`, `tdefeq_iso`, `tctx_deq_nil`
-- are `teq_refl`, `teq_symm`, `teq_trans`, `net_isomorphism_step`, and
-- `teq_refl tnil`. The trusted base of this file is therefore 10 axioms, not
-- 15, and the comments at each definition record what the identification
-- costs. They are eliminations rather than theorems because this toolchain
-- refuses a proof obligation headed by a `def` (see “Conversion of types”).
--  * Every rule states its premises with `>` (hypothesis binders). MM0 has no
--    internal modus ponens, so a `->`-inside-formula axiom could never be
--    applied — see the phase-D note in cic.mm0.
--
-- Constants have no typing rule here on purpose. A constant's type is an
-- assumption of each artifact (it is a Mathlib lemma), so the *generated* file
-- carries one `axiom` per constant it uses, in plain sight; a rule here would
-- hide that count behind a schema.
--
-- Validate with (imports are concatenated, as the toolchain requires):
--   mm0-rs join docs/cic_typing.mm0 out.mm0 && mm0-rs compile out.mm0 out.mmb
--   mm0-c out.mmb < out.mm0

import "cic.mm0";

-- ── Terms the typing judgment speaks about ───────────────────────────────

term tpi (a b: Term): Term;        -- Π a b: `b` is the codomain in the context
                                   -- extended by `a` (binder = `tvar 0`)
term tsort (s: nat): Term;         -- a universe as a *term*, so types live in
                                   -- `Term` and one encoding serves both sides
term tsucc (n: nat): nat;          -- context shifting in `ty_varS`
term tzero: nat;                   -- the head index 0 as a declared constant:
                                   -- this toolchain rejects numeral literals
                                   -- inside `$…$`, so `0` cannot be written
                                   -- directly (`(tvar 0)` is a parse error).

-- ── The judgment ─────────────────────────────────────────────────────────

-- `tty c t a`: in context `c` (a `tcons` spine, innermost first), term `t`
-- has type `a`.
term tty (c t a: Term): Prop;

-- `tdefeq a b`: the types `a` and `b` are convertible.
--
-- It is a *definition*, not a declared relation: conversion here is the net
-- equality `teq` of cic.mm0, which is what the deltanet reducer decides (via
-- `valid_iso` for the certificate path). Defining it makes the three
-- reflexivity/symmetry/transitivity rules and the witness bridge theorems
-- instead of axioms — four axioms leave the trusted base — and every existing
-- use site elaborates unchanged, since a `def` is transparent.
--
-- The cost, stated: `tdefeq` used to be a relation the theory could be *wider*
-- than `teq` on. It is now exactly `teq`, so a derivation that needed a
-- conversion `teq` cannot supply must go through `tdefeq_iso` and a witness,
-- which is the only route the translator ever used.
def tdefeq (a b: Term): Prop = $ teq a b $;

-- ── Context ──────────────────────────────────────────────────────────────

-- The head of the context types `tvar 0`; this is the only rule that *reads*
-- a context entry, so a derivation can only use a variable it bound.
axiom ty_var0 (a c: Term): $ tty (tcons a c) (tvar tzero) a $;

-- Weakening under a binder: shifting the index by one, one binder at a time.
axiom ty_varS (a b c: Term) (i: nat):
  $ tty c (tvar i) a $ > $ tty (tcons b c) (tvar (tsucc i)) a $;

-- ── The λΠ fragment ──────────────────────────────────────────────────────

axiom ty_pi (c a b: Term) (s: nat):
  $ tty c a (tsort s) $ > $ tty (tcons a c) b (tsort s) $ >
  $ tty c (tpi a b) (tsort s) $;

axiom ty_abs (c body a b: Term):
  $ tty (tcons a c) body b $ > $ tty c (tabs body) (tpi a b) $;

-- Application. The codomain of the function is a *type in the extended
-- context*, so applying it must substitute the argument; `r` names the result
-- and the premise says the substituted form converts to it. Naming `r`
-- explicitly is what lets a generated derivation state the exact type it
-- needs, instead of silently relying on the elaborator's conversion.
axiom ty_app (c f x a b r: Term):
  $ tty c f (tpi a b) $ > $ tty c x a $ > $ tdefeq (tsubst b x) r $ >
  $ tty c (tapp f x) r $;

-- ── Conversion of types ──────────────────────────────────────────────────

-- The three laws are the `teq` congruence axioms of cic.mm0 at the alias —
-- literally the same statements — so they are not restated here: `teq_refl`,
-- `teq_symm` and `teq_trans` are the rules, and a consumer that would have
-- named `tdefeq_refl` names `teq_refl` instead.
--
-- They cannot be *theorems* in this toolchain, which is worth stating because
-- it looks like a bookkeeping choice and is not: `mm0-c` accepts a `def` of
-- the provable sort in an axiom's conclusion and in a hypothesis (both
-- measured, exit 0), but a proof obligation headed by a `def` is rejected
-- (`expecting a theorem`), and `mm0-rs` silently downgrades it to `sorry`
-- (warning `theorem … contains sorry`, then `mm0-c`: `some theorems used
-- sorry`, exit 3). So the five axioms below are *eliminated* at the alias,
-- not proved: eliminating them is the strongest form the toolchain allows.

-- Conversion is used on terms, not just on their types: a term of a
-- convertible type is a term of the other type.
axiom ty_deq (c t a b: Term):
  $ tty c t a $ > $ tdefeq a b $ > $ tty c t b $;

-- The bridge to the project's actual decision procedure: a witnessed net
-- isomorphism is a conversion. `cert` is the π packaged by
-- `deltanet::unf::isomorphism_witness`; the kernel-side check of the pairing
-- is `IsomorphismWitness::verifies`, so MM0 records the entailment and the
-- certificate does the deciding.
-- Under the alias this is exactly `net_isomorphism_step` of cic.mm0, so it is
-- not restated: the bridge to the certificate is that one rule, named there.

-- ── Substitution certificates (external deltanet check) ────────────────────
--
-- `ty_app` needs `tdefeq (tsubst b x) r`, but `tsubst` is a term constructor:
-- MM0 cannot reduce it. The theory already routes conversions through
-- `tdefeq_iso`/`valid_iso`, and this is the certificate a translator names for
-- one: the two terms and the kernel's isomorphism witness digest `w`
-- (`IsomorphismWitness` of the redex's net against its reduct's net, as
-- returned by `uk_austral_defeq`).
--
-- The deciding is external by construction — MM0 has no net semantics — so the
-- entailment is recorded here and the *translator* is what refuses to emit an
-- instance whose witness the kernel did not return. `scripts/lean-net-cert`
-- drives that check; `scripts/lean-typing-proof --dump-obligations` writes the
-- pairs it consumes.
term tcert (b a r w: Term): Term;

axiom tcert_witness (b a r w: Term):
  $ valid_iso (tsubst b a) r (tcert b a r w) $;

-- ── Projections ───────────────────────────────────────────────────────────
--
-- A projection has no typing rule in the λΠ core: its type is a *field* of the
-- structure it reads, so the fragment needs the field relation as data. `tfield
-- A i F` says "index i of structure type A has type F"; the translator emits
-- one instance per field of each structure it sees, taken from the inductive's
-- constructor type, so the fact is checked against the declaration rather than
-- assumed per use site.
term tproj (s: Term) (i: nat): Term;
term tfield (s: Term) (i: nat) (f: Term): Prop;

axiom ty_proj (c s a f: Term) (i: nat):
  $ tty c s a $ > $ tfield a i f $ > $ tty c (tproj s i) f $;

-- ── Context conversion ────────────────────────────────────────────────────
--
-- Contexts are syntactic here (`tcons`-chains), and `ty_var0`/`ty_varS` read
-- entries verbatim, so a derivation whose context entry is a *reference* to a
-- Π cannot be used where the Π itself is required. Definitionally equal
-- contexts are interchangeable in the calculus. The relation is defined as
-- `teq` on the spine, like `tdefeq`, so the empty case is a theorem; the cons
-- rule stays an axiom, because congruence of `teq` under `tcons` is content
-- (`teq_app` gives it for `tapp`, and nothing gives it for a list spine).
--
-- The cost is the same shape as `tdefeq`'s and sharper: aliasing to `teq`
-- makes `ty_ctx` demand equality of the whole spine rather than entrywise
-- conversion, so a context that differs only in a convertible entry no longer
-- transfers. No emitted derivation uses `ty_ctx`, and the entrywise version is
-- recoverable as a definition over an entry relation whenever a row needs it.
def tctx_deq (c d: Term): Prop = $ teq c d $;

-- The empty case is `teq_refl tnil`, so it is not an axiom either.

axiom tctx_deq_cons (a b c d: Term):
  $ tdefeq a b $ > $ tctx_deq c d $ > $ tctx_deq (tcons a c) (tcons b d) $;

axiom ty_ctx (c d t a: Term):
  $ tctx_deq c d $ > $ tty d t a $ > $ tty c t a $;

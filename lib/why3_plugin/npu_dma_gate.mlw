(*
  Generated by the unfer probability kernel — uk_whyml_emit (S36).
  program:     NPU DMA gate (GPU.md)
  module:      NpuDmaGate
  entrypoint:  dma_verdict
  property:    dma_ok buf bytes = true  <->  buf.offset + bytes <= MAX_NPU_SRAM
               (an async DMA load never overflows the NPU SRAM; the
               hardware invariant from GPU.md).
  proof goals: 2 (dma_ok postcondition + gate_verdict postcondition)

  Verify and extract with the Why3 toolchain (see `unfer_ocaml.drv` in this
  directory — the stock `ocaml64` driver maps Why3 int to Zarith Z.t, which
  would pull the zarith library into the compiler plugin; `unfer_ocaml.drv`
  maps int to native OCaml int, matching the plugin contract):
    why3 prove -P alt-ergo npu_dma_gate.mlw
    why3 extract -D unfer_ocaml.drv npu_dma_gate.mlw -o npu_dma_gate.ml
  The extracted OCaml module satisfies the postcondition below
  (Why3 extraction is semantics-preserving).
*)

module NpuDmaGate
  use int.Int

  (* Hardware constant: NPU SRAM capacity in bytes (256 KiB). *)
  val constant MAX_NPU_SRAM : int = 262144

  (* A linear NPU memory buffer: the transfer region is
     [offset, offset + bytes). The buffer is a Linear Resource — the
     runtime handoff borrows it, it is never copied. *)
  type npu_buffer = { size: int; offset: int }

  (* Soundness + completeness of the physical-safety check: the async
     DMA load is safe iff the transfer stays inside the SRAM. *)
  let dma_ok (buf: npu_buffer) (bytes: int) : bool
    requires { 0 <= buf.offset /\ 0 <= bytes }
    ensures { result = True <-> buf.offset + bytes <= MAX_NPU_SRAM }
  = buf.offset + bytes <= MAX_NPU_SRAM

  (* The compiler-pass entrypoint: 0 = allow, 1 = reject. The
     compiler loads the extracted OCaml and refuses any module whose
     declared DMA transfer would overflow the NPU SRAM. *)
  let dma_verdict (offset: int) (bytes: int) : int
    requires { 0 <= offset /\ 0 <= bytes }
    ensures { result = 0 <-> offset + bytes <= MAX_NPU_SRAM }
  = if offset + bytes <= MAX_NPU_SRAM then 0 else 1
end

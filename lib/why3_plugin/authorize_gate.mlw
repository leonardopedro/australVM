(*
  Generated by the unfer probability kernel — uk_whyml_emit (S36).
  module:      AuthorizeGate
  entrypoint:  gate_verdict
  grants:      uk_version, uk_evolve, uk_model_create
  required:    uk_version, uk_evolve
  property:    authorize grants required = true  <->  required ⊆ grants
               (the kernel's S21 GrantSet::is_subset_of semantics: a
               caller can never exercise a symbol it is not granted).
  proof goals: 5 (2 subset lemmas + mem postcondition + 2 postconditions)

  Verify and extract with the Why3 toolchain (see `unfer_ocaml.drv` in this
  directory — the stock `ocaml64` driver maps Why3 int to Zarith Z.t, which
  would pull the zarith library into the compiler plugin; `unfer_ocaml.drv`
  maps int to native OCaml int, matching the plugin contract):
    why3 prove -P alt-ergo authorize_gate.mlw
    why3 extract -D unfer_ocaml.drv authorize_gate.mlw -o authorize_gate.ml
  The extracted OCaml module satisfies the postcondition below
  (Why3 extraction is semantics-preserving).
*)

module AuthorizeGate
  use bool.Bool
  use int.Int
  use list.List
  use list.Length
  use list.Mem

  (* A grant set is a list of kernel symbol ids. *)
  predicate is_subset (a b: list int) = forall x. Mem.mem x a -> Mem.mem x b

  (* Program-level list membership: `Mem.mem` is a logical predicate and
     cannot appear in program code, so we mirror it with a recursive
     function whose postcondition links the two (Why3 1.8). *)
  let rec mem (x: int) (l: list int) : bool
    variant { l }
    ensures { result = True <-> Mem.mem x l }
  = match l with
    | Nil -> False
    | Cons y r -> if x = y then True else mem x r
    end

  (* The capability lattice: subset is reflexive and transitive — there is
     no escalation path (A ⊆ B ∧ B ⊆ C ⇒ A ⊆ C). *)
  lemma subset_reflexive: forall a. is_subset a a
  lemma subset_transitive: forall a b c. is_subset a b /\ is_subset b c -> is_subset a c

  (* Soundness + completeness of the authorization gate: it returns True
     exactly when every required symbol is granted. *)
  let rec authorize (grants required: list int) : bool
    variant { length required }
    ensures { result = True <-> is_subset required grants }
  = match required with
    | Nil -> True
    | Cons x rest -> if mem x grants then authorize grants rest else False
    end

  (* The compiler-pass entrypoint: 0 = allow, 1 = reject.
     The compiler loads the extracted OCaml and refuses a module whose
     imported uk_* symbols are not covered by its grant set. *)
  let gate_verdict (grants required: list int) : int
    ensures { result = 0 <-> is_subset required grants }
  = if authorize grants required then 0 else 1

  (* Kernel-call externals (the "calling the probability kernel from WhyML"
     direction): declare with `val`, and the extracted OCaml binds them at
     link time to the unfer C ABI (the CamlCompiler_stubs shim). *)
  (* val uk_evolve : int -> int -> int *)
end
